+class MacOptionMenu(tk.Label):
+    """Themebares Mac-Auswahlfeld; Windows behält sein bisheriges OptionMenu.
+
+    Aqua zeichnet Menubutton-Flächen unabhängig von deren Hintergrundfarbe.
+    Label und Listbox respektieren die App-Farben. Das Menü bleibt der gemeinsame
+    Auswahlvertrag für StringVar, Farbinformationen und Aufrufer.
+    """
+
+    def __init__(self, parent, app, variable, options):
+        super().__init__(parent, textvariable=variable, takefocus=True, cursor="hand2")
+        self.app, self.variable, self.options = app, variable, list(options)
+        self._popup = None
+        self._previous_grab = None
+        self._focus_job = None
+        self._search_text, self._search_time = "", 0
+        self.menu = tk.Menu(self, tearoff=False)
+        for value in self.options:
+            self.menu.add_command(label=value, command=lambda value=value: variable.set(value))
+        self.arrow = tk.Label(self, text=app.ICONS["dropdown_closed"], bg=app.theme["input"], fg=app.theme["muted"],
+                              font=app_font(11), cursor="hand2", padx=5)
+        self.arrow.place(relx=1, rely=0.5, anchor="e")
+        self.arrow.bind("<Button-1>", self._toggle_popup)
+        self.bind("<Button-1>", self._toggle_popup)
+        for key in ("<space>", "<Return>", "<Down>", "<Up>"):
+            self.bind(key, self._open_popup)
+        self.bind("<FocusIn>", lambda e: self._paint_focus(True))
+        self.bind("<FocusOut>", lambda e: self._paint_focus(False))
+        self.bind("<Destroy>", self._on_destroy, add="+")
+        self.bind("<Unmap>", lambda e: self._close_popup(restore_focus=False), add="+")
+
+    def __getitem__(self, key):
+        return self.menu if key == "menu" else super().__getitem__(key)
+
+    def _paint_focus(self, focused):
+        self.master.master.configure(bg=self.app.theme["selection" if focused else "input_border"])
+
+    def _toggle_popup(self, _event=None):
+        if self._popup is None:
+            return self._open_popup()
+        self._close_popup()
+        return "break"
+
+    def _open_popup(self, _event=None):
+        if self._popup is not None or self.cget("state") == "disabled" or not self.options:
+            return "break"
+        self.focus_set()
+        self._previous_grab = self.grab_current()
+        theme = self.app.theme
+        popup = self._popup = tk.Toplevel(self)
+        popup.withdraw()
+        popup.overrideredirect(True)
+        popup.configure(bg=theme["input_border"])
+        surface = tk.Frame(popup, bg=theme["card"])
+        surface.pack(fill="both", expand=True, padx=1, pady=1)
+        font = tkfont.Font(font=self.cget("font"))
+        rows = max(1, min(9, len(self.options), (self.winfo_screenheight() - 40) // (font.metrics("linespace") + 4)))
+        choices = self._choices = tk.Listbox(
+            surface, height=rows, font=self.cget("font"), bg=theme["card"], fg=theme["text"],
+            selectbackground=theme["selection"], selectforeground=theme["selection_text"],
+            bd=0, highlightthickness=0, relief="flat", activestyle="none", exportselection=False,
+            selectmode="browse", takefocus=True,
+        )
+        scrollbar = ThemedAutoScrollbar(surface, theme["card"], theme["card"],
+                                       theme["input_border"], theme["muted"])
+        scrollbar.pack(side="right", fill="y")
+        scrollbar.set_command(choices.yview)
+        choices.configure(yscrollcommand=scrollbar.set)
+        choices.pack(fill="both", expand=True, padx=6, pady=6)
+        for index, value in enumerate(self.options):
+            choices.insert("end", value)
+            color = self.menu.entrycget(index, "foreground") or theme["text"]
+            choices.itemconfigure(index, foreground=color)
+        index = self.options.index(self.variable.get()) if self.variable.get() in self.options else 0
+        self._highlight(index)
+        choices.bind("<ButtonRelease-1>", self._choose_mouse)
+        for sequence, delta in (("<Up>", -1), ("<Down>", 1)):
+            choices.bind(sequence, lambda e, delta=delta: self._move(delta))
+        choices.bind("<Home>", lambda e: self._highlight(0))
+        choices.bind("<End>", lambda e: self._highlight(len(self.options) - 1))
+        for sequence in ("<Return>", "<KP_Enter>", "<space>"):
+            choices.bind(sequence, self._commit)
+        choices.bind("<KeyPress>", self._type_ahead, add="+")
+        popup.bind("<Escape>", self._cancel)
+        popup.bind("<Tab>", lambda e: self._tab(False))
+        popup.bind("<Shift-Tab>", lambda e: self._tab(True))
+        popup.bind("<ISO_Left_Tab>", lambda e: self._tab(True))
+        popup.bind("<ButtonPress-1>", self._outside_click, add="+")
+        popup.bind("<FocusOut>", self._check_focus, add="+")
+        self.app.bind_mousewheel(choices)
+        popup.update_idletasks()
+        screen_w, screen_h = self.winfo_screenwidth(), self.winfo_screenheight()
+        owner = self.winfo_toplevel()
+        left, top = min(0, owner.winfo_rootx()), min(0, owner.winfo_rooty())
+        right = max(screen_w, owner.winfo_rootx() + owner.winfo_width())
+        bottom = max(screen_h, owner.winfo_rooty() + owner.winfo_height())
+        width = min(screen_w - 20, max(self.master.winfo_width(), max(font.measure(v) for v in self.options) + 40))
+        height = min(screen_h - 20, popup.winfo_reqheight())
+        x = max(left + 10, min(self.master.winfo_rootx(), right - width - 10))
+        y = self.master.winfo_rooty() + self.master.winfo_height() + 2
+        if y + height > bottom - 10:
+            y = self.master.winfo_rooty() - height - 2
+        y = max(top + 10, min(y, bottom - height - 10))
+        popup.geometry(f"{width}x{height}+{x}+{y}")
+        popup.deiconify()
+        popup.grab_set()
+        choices.focus_set()
+        self.arrow.configure(text=self.app.ICONS["dropdown_open"])
+        self._search_text, self._search_time = "", 0
+        return "break"
+
+    def _highlight(self, index):
+        self._choices.selection_clear(0, "end")
+        self._choices.selection_set(index)
+        self._choices.activate(index)
+        self._choices.see(index)
+        return "break"
+
+    def _move(self, delta):
+        selected = self._choices.curselection()
+        index = selected[0] if selected else 0
+        return self._highlight(max(0, min(len(self.options) - 1, index + delta)))
+
+    def _type_ahead(self, event):
+        if event.char and event.char.isprintable() and not event.char.isspace():
+            now = time.monotonic()
+            self._search_text = (self._search_text if now - self._search_time < 1 else "") + event.char.casefold()
+            self._search_time = now
+            for index, value in enumerate(self.options):
+                if value.casefold().startswith(self._search_text):
+                    return self._highlight(index)
+
+    def _choose_mouse(self, event):
+        index = self._choices.nearest(event.y)
+        box = self._choices.bbox(index)
+        if box and 0 <= event.x < self._choices.winfo_width() and box[1] <= event.y < box[1] + box[3]:
+            self._highlight(index)
+            return self._commit()
+        return "break"
+
+    def _commit(self, _event=None):
+        selected = self._choices.curselection()
+        index = selected[0] if selected else None
+        # Erst den modalen Eltern-Grab zurückgeben: StringVar-Beobachter können
+        # unmittelbar einen weiteren Dialog (z. B. Wiederholung) öffnen.
+        self._close_popup()
+        if index is not None and self.winfo_exists():
+            self.menu.invoke(index)
+        return "break"
+
+    def _cancel(self, _event=None):
+        self._close_popup()
+        return "break"
+
+    def _tab(self, backwards):
+        target = self.tk_focusPrev() if backwards else self.tk_focusNext()
+        self._close_popup()
+        if target is not None:
+            target.focus_set()
+        return "break"
+
+    def _outside_click(self, event):
+        popup = self._popup
+        if popup is not None and not (
+            popup.winfo_rootx() <= event.x_root < popup.winfo_rootx() + popup.winfo_width()
+            and popup.winfo_rooty() <= event.y_root < popup.winfo_rooty() + popup.winfo_height()
+        ):
+            return self._cancel()
+
+    def _check_focus(self, _event=None):
+        popup = self._popup
+        def check():
+            self._focus_job = None
+            if self._popup is popup and popup is not None:
+                focused = popup.focus_get()
+                if focused is None or focused.winfo_toplevel() is not popup:
+                    self._close_popup(restore_focus=False)
+        if popup is not None:
+            if self._focus_job is not None:
+                popup.after_cancel(self._focus_job)
+            self._focus_job = popup.after_idle(check)
+
+    def _close_popup(self, restore_focus=True):
+        popup, self._popup = self._popup, None
+        if popup is None:
+            return
+        previous, self._previous_grab = self._previous_grab, None
+        try:
+            if self._focus_job is not None:
+                popup.after_cancel(self._focus_job)
+                self._focus_job = None
+            popup.grab_release()
+            popup.destroy()
+        except tk.TclError:
+            pass
+        # Bei Zerstörung des Elternfelds kann Tk das Popup schon entfernt haben.
+        # Der weiterhin bestehende Aufrufer benötigt seinen Grab trotzdem zurück.
+        try:
+            if previous is not None and previous.winfo_exists():
+                previous.grab_set()
+        except tk.TclError:
+            pass
+        try:
+            if self.winfo_exists():
+                self.arrow.configure(text=self.app.ICONS["dropdown_closed"])
+                if restore_focus:
+                    self.focus_set()
+        except tk.TclError:
+            pass
+
+    def destroy(self):
+        self._close_popup(restore_focus=False)
+        super().destroy()
+
+    def _on_destroy(self, event):
+        if event.widget is self:
+            self._close_popup(restore_focus=False)
 
 
