-/* Function to assign childId's dynamically. */
+/* Widget identities survive layout changes and are never reused. */
+static void ChildIdDestroyed(void *clientData, XEvent *eventPtr)
+{
+    if (eventPtr->type != DestroyNotify) return;
+    ChildIdLifetime *lifetime = (ChildIdLifetime *)clientData;
+    TkGlobalLock();
+    Tcl_HashEntry *top = toplevelChildTables
+	    ? Tcl_FindHashEntry(toplevelChildTables, lifetime->toplevel) : NULL;
+    if (top) {
+	Tcl_HashTable *table = (Tcl_HashTable *)Tcl_GetHashValue(top);
+	Tcl_HashEntry *entry = Tcl_FindHashEntry(table, lifetime->win);
+	if (entry) Tcl_DeleteHashEntry(entry);
+    }
+    TkGlobalUnlock();
+    Tcl_Free(lifetime);
+}
