+/* Explicit focus notification for Tk focus changes in custom controls. */
+static int EmitFocusChanged(TCL_UNUSED(void *), Tcl_Interp *ip,
+        Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    if (objc != 2) {
+        Tcl_WrongNumArgs(ip, 1, objv, "window");
+        return TCL_ERROR;
+    }
+    Tk_Window win = Tk_NameToWindow(ip, Tcl_GetString(objv[1]), Tk_MainWindow(ip));
+    if (!win) {
+        return TCL_ERROR;
+    }
+    TkAccessibilityElement *element = TkAccessibility_GetElementForWindow(win);
+    if (!element) {
+        Tcl_SetObjResult(ip, Tcl_NewStringObj("no accessibility element for window", -1));
+        return TCL_ERROR;
+    }
+    NSAccessibilityPostNotification(element, NSAccessibilityFocusedUIElementChangedNotification);
+    return TCL_OK;
+}
