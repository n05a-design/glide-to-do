  * Event proc which calls the ActionEventProc procedure.
  */
 
-static int ActionEventProc(
-    TCL_UNUSED(Tcl_Event *), /* ev */
-    TCL_UNUSED(int)) /* flags */
-{
-    TkMainInfo *info = TkGetMainInfoList();
-    Tcl_GlobalEval(info->interp, callback_command);
+static void ReleaseActionEvent(AccessibilityActionEvent *event)
+{
+    Tcl_DecrRefCount(event->command);
+    Tcl_DecrRefCount(event->path);
+    Tcl_Release(event->interp);
+}
+
+static int DeleteActionEvent(Tcl_Event *event, void *clientData)
+{
+    if (event->proc == ActionEventProc &&
+            ((AccessibilityActionEvent *)event)->interp == clientData) {
+        ReleaseActionEvent((AccessibilityActionEvent *)event);
+        return 1;
+    }
+    return 0;
+}
+
+static void DeleteInterpreterActions(TCL_UNUSED(void *), Tcl_Interp *interp)
+{
+    Tcl_DeleteEvents(DeleteActionEvent, interp);
+}
+
+static int ActionEventProc(Tcl_Event *ev, TCL_UNUSED(int))
+{
+    AccessibilityActionEvent *event = (AccessibilityActionEvent *)ev;
+    Tcl_Interp *interp = event->interp;
+    if (!Tcl_InterpDeleted(interp) && Tk_MainWindow(interp)) {
+        Tcl_InterpState saved = Tcl_SaveInterpState(interp, TCL_OK);
+        Tk_Window win = Tk_NameToWindow(interp, Tcl_GetString(event->path), Tk_MainWindow(interp));
+        TkAccessibilityElement *element = win ? TkAccessibility_GetElementForWindow(win) : nil;
+        Tcl_HashEntry *hPtr = win ? Tcl_FindHashEntry(TkAccessibilityObject, win) : NULL;
+        Tcl_HashTable *attributes = hPtr ? (Tcl_HashTable *)Tcl_GetHashValue(hPtr) : NULL;
+        hPtr = attributes ? Tcl_FindHashEntry(attributes, "action") : NULL;
+        /* Never invoke a destroyed, disabled, hidden or replaced target. */
+        if (element && [element isAccessibilityEnabled] && hPtr &&
+                strcmp(Tcl_GetString((Tcl_Obj *)Tcl_GetHashValue(hPtr)),
+                    Tcl_GetString(event->command)) == 0) {
+            int code = Tcl_EvalObjEx(interp, event->command, TCL_EVAL_GLOBAL);
+            if (code != TCL_OK && !Tcl_InterpDeleted(interp)) {
+                Tcl_BackgroundException(interp, code);
+            }
+        }
+        Tcl_RestoreInterpState(interp, saved);
+    }
+    ReleaseActionEvent(event);
     return 1;
 }
 
