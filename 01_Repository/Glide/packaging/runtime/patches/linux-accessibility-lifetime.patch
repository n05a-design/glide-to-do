-
-    tk_atk_accessible_finalize(obj);
+    if (!acc->tkwin) return;
+    Tk_Window win = acc->tkwin;
+    /* External AT-SPI references can outlive the widget. Invalidate first;
+     * only GObject may finalize after the final reference is released. */
+    acc->tkwin = NULL;
+    acc->interp = NULL;
+    acc->is_focused = false;
+    atk_object_notify_state_change(ATK_OBJECT(acc), ATK_STATE_DEFUNCT, TRUE);
+    UnregisterAtkObjectForTkWindow(win);
+    g_object_unref(acc); /* Release the widget's initial reference. */
 }
 
 
