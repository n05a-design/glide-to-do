        "light_hover": "#D8E9FE",
        "dark_canvas": "#111113",
        "dark_card": "#1C1C1E",
        "dark_field": "#2C2C2E",
        "dark_border": "#3A3A3C",
        "dark_muted": "#A1A1A6",
        "dark_placeholder": "#6F6F75",
        "dark_purple": "#BF5AF2",
