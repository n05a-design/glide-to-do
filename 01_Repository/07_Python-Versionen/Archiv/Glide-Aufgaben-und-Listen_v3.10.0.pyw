class TemplateDraft(ListApp):
    """Isolierter Vorlagenentwurf mit denselben Detailmasken wie echte Listen.

    Kein ListApp-Start, keine Timer, kein Speichern im Nutzdatenordner. Labels,
    Struktur und Anhänge gehören bis zum Übernehmen ausschließlich dem Entwurf.
    """

    def __init__(self, app, template):
        self.root = app.root
        self.theme = dict(app.theme)
        self.theme_name = app.theme_name
        self.settings = copy.deepcopy(app.settings)
        self.theme_widgets, self.rounded_containers = [], []
        self._after_ids = set()
        self.record = copy.deepcopy(template)
        self.result = None
        self.dialog = None
        self._temporary = tempfile.TemporaryDirectory(prefix="glide-template-edit-")
        self._draft_dir = self._temporary.name
        self._owner = app
        try:
            if "payload" in template:
                referenced = app.validate_template_payload(template)
                payload = copy.deepcopy(template["payload"])
                self.labels = copy.deepcopy(payload.get("labels", []))
                self.folders = payload.get("folders", [])
                self.lists = payload.get("lists", [])
                for storage in referenced:
                    encoded = template["files"][storage]
                    storage = self.validate_attachment_storage(storage)
                    path = os.path.join(self._draft_dir, storage)
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "wb") as file:
                        file.write(base64.b64decode(encoded, validate=True))
            else:
                self.labels = copy.deepcopy(app.labels)
                self.folders, self.lists = [], []
                if template["kind"] == "folder":
                    folder = self.new_folder_object(template["title"])
                    self.folders.append(folder)
                    self.lists = [self.new_list_object(text, [], folder_id=folder["id"])
                                  for text in template.get("items", [])]
                else:
                    self.lists.append(self.new_list_object(template["title"],
                        [self.new_item(text) for text in template.get("items", [])]))
            self.ensure_system_labels()
            roots = ([folder for folder in self.folders if not folder.get("parent_id")]
                     if template["kind"] == "folder" else self.lists)
            if len(roots) != 1:
                raise ValueError("Die Vorlage muss genau eine Stammliste oder einen Stammordner enthalten.")
            self.holder = roots[0]
            self.holder.update({key: copy.deepcopy(template.get(key))
                                for key in ("title", "note", "color", "labels")})
            self.holder.setdefault("attachments", [])
            self.trash = []
            self.active_list_id = None
            self.active_folder_id = None
            self.items = []
        except Exception:
            self._temporary.cleanup()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *_exc):
        if self.dialog is not None and self.dialog.winfo_exists():
            self.dialog.destroy()
        for callback in self._after_ids:
            try:
                self.root.after_cancel(callback)
            except tk.TclError:
                pass
        self._temporary.cleanup()

    def snapshot_undo(self):
        pass

    def save_items(self, *args, **kwargs):
        return True

    def refresh_tree(self, *args, **kwargs):
        pass

    def sync_current_list_reference(self):
        pass

    def resolve_attachment_path(self, attachment):
        try:
            return os.path.join(self._draft_dir, self.validate_attachment_storage(attachment.get("storage")))
        except (ValueError, AttributeError):
            return None

    def store_attachment(self, source_path):
        if not os.path.isfile(source_path) or os.path.getsize(source_path) > self.MAX_BACKUP_ATTACHMENT_BYTES:
            raise OSError("Die Datei fehlt oder überschreitet die erlaubte Anhangsgröße.")
        identity = uuid.uuid4().hex
        name = os.path.basename(source_path)
        storage = "attachments/" + self.safe_attachment_filename(name, identity)
        target = os.path.join(self._draft_dir, storage)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(source_path, target)
        return {"id": identity, "name": name, "storage": storage,
                "size": os.path.getsize(target), "mime": mimetypes.guess_type(name)[0] or "application/octet-stream",
                "added_at": datetime.now().isoformat(timespec="seconds")}

    def export_record(self):
        is_folder = self.record["kind"] == "folder"
        payload = self.partial_backup_payload(
            [] if is_folder else [self.holder["id"]], [self.holder["id"]] if is_folder else [])
        files = {}
        for storage in self.validate_backup_schema(payload, portable=True):
            with open(os.path.join(self._draft_dir, storage), "rb") as file:
                files[storage] = base64.b64encode(file.read(self.MAX_BACKUP_ATTACHMENT_BYTES + 1)).decode("ascii")
        record = copy.deepcopy(self.record)
        record.update({key: copy.deepcopy(self.holder.get(key)) for key in ("title", "note", "color", "labels")})
        record.update(items=[], payload=payload, files=files)
        self.validate_template_payload(record)
        return record

    def edit(self):
        dialog = self.dialog = tk.Toplevel(self.root)
        dialog.title("Vorlage bearbeiten")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.minsize(800, 640)
        footer = tk.Frame(dialog, bg=self.theme["bg"])
        footer.pack(side="bottom", fill="x", padx=24, pady=16)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=24, pady=(20, 0))
        tk.Label(body, text="Vorlage bearbeiten", font=app_font(16, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        tk.Label(body, text="Details am ausgewählten Eintrag bearbeiten. Übernehmen ändert nur die Vorlage.",
                 font=app_font(10), bg=self.theme["bg"], fg=self.theme["muted"]).pack(anchor="w", pady=(5, 14))
        self._make_field_label(body, "Titel der Vorlage").pack(anchor="w")
        self.title_var = tk.StringVar(value=self.holder["title"])
        title_border, title_field = self._make_field(body)
        title_border.pack(fill="x", pady=(4, 10))
        title_field.pack(fill="x", padx=self.FIELD_BORDER_WIDTH, pady=self.FIELD_BORDER_WIDTH)
        title = tk.Entry(title_field, textvariable=self.title_var, font=app_font(12), relief="flat",
                         bd=0, highlightthickness=0,
                         bg=self.theme["input"], fg=self.theme["text"], insertbackground=self.theme["text"],
                         selectbackground=self.theme["selection"], selectforeground=self.theme["selection_text"])
        title.pack(fill="x", padx=self.FIELD_PAD_X, pady=self.FIELD_PAD_Y)
        self.summary_var = tk.StringVar()
        summary = tk.Label(body, textvariable=self.summary_var, justify="left", anchor="w", font=app_font(10),
                           bg=self.theme["bg"], fg=self.theme["muted"])
        summary.pack(fill="x", pady=(0, 8))
        summary.bind("<Configure>", lambda e: summary.configure(wraplength=max(100, e.width)))
        actions = ButtonFlow(body, bg=self.theme["bg"])
        actions.pack(fill="x", pady=(0, 10))
        for text, command, color, width in (
            ("Vorlagendetails", self.edit_holder, "accent", 154),
            ("+ Punkt", lambda: self.add_node("item"), "confirm", 96),
            ("+ Unterpunkt", lambda: self.add_node("child"), "confirm", 132),
            ("+ Liste", lambda: self.add_node("list"), "accent", 96),
            ("+ Ordner", lambda: self.add_node("folder"), "import", 106),
        ):
            if self.record["kind"] == "list" and text in ("+ Liste", "+ Ordner"):
                continue
            actions.add(self._make_dialog_button(actions, text, command, color, width=width, height=36))
        self.editor_card = self.make_rounded_container(body, padding=14, register=False)
        self.editor_card.pack(fill="both", expand=True)
        area = self.editor_card.inner
        self.structure_var = tk.StringVar()
        tk.Label(area, textvariable=self.structure_var, font=self.group_row_font(),
                 bg=self.theme["card"], fg=self.theme["text"], anchor="w").pack(fill="x", pady=(2, 10))
        tree_area = tk.Frame(area, bg=self.theme["card"])
        tree_area.pack(fill="both", expand=True)
        # App.Treeview liefert die bestehenden Listenfarben und Auswahlzustände.
        # Nur die Zeilenhöhe wird für die einfache Vorlagenzeile festgelegt.
        style = ttk.Style(dialog)
        style.configure("Template.App.Treeview", font=self.tree_font(),
                        rowheight=max(36, tkfont.Font(font=self.tree_font()).metrics("linespace") + 12))
        self.editor_tree = ttk.Treeview(
            tree_area, columns=("kind", "labels", "due"), displaycolumns=("kind", "due", "labels"),
            show="tree", style="Template.App.Treeview", selectmode="browse", height=10, takefocus=True,
        )
        self.editor_tree.column("#0", width=420, minwidth=160, stretch=True)
        for key in ("kind", "labels", "due"):
            self.editor_tree.column(key, minwidth=0, stretch=False, anchor="w")
        for tag, font in (("container", self.group_row_font()), ("group", self.group_row_font()),
                          ("heading", self.heading_row_font())):
            self.editor_tree.tag_configure(tag, font=font)
        for key in ("text", "ui_accent", "import", *self.LIST_COLOR_KEYS):
            self.editor_tree.tag_configure("color_" + key, foreground=self.theme[key])
        self.editor_tree.tag_configure("hover", background=self.theme["hover"])
        scroll = self.editor_scrollbar = ThemedAutoScrollbar(
            tree_area, self.theme["card"], self.theme["card"], self.theme["input_border"], self.theme["muted"])
        scroll.pack(side="right", fill="y")
        scroll.set_command(self.editor_tree.yview)
        self.editor_tree.configure(yscrollcommand=scroll.set)
        self.editor_tree.pack(fill="both", expand=True, padx=(0, 4))
        self.editor_tree.bind("<Configure>", self.resize_editor_columns)
        self.bind_mousewheel(self.editor_tree)
        self.bind_hover_highlight(self.editor_tree)
        self.editor_tree.bind("<Double-Button-1>", self.edit_from_pointer)
        self.editor_tree.bind("<Return>", lambda e: self.edit_selected())
        self.editor_tree.bind("<F2>", lambda e: self.edit_selected())
        commands = ButtonFlow(area, bg=self.theme["card"])
        commands.pack(side="bottom", fill="x", pady=(12, 0), before=tree_area)
        for text, command, color, width in (
            ("Bearbeiten", self.edit_selected, "accent", 120),
            ("Nach oben", lambda: self.move_selected(-1), "muted", 116),
            ("Nach unten", lambda: self.move_selected(1), "muted", 122),
            ("Entfernen", self.remove_selected, "delete", 112),
        ):
            commands.add(self._make_dialog_button(commands, text, command, color, width=width, height=36))
        self.relative_var = tk.BooleanVar(value=bool(self.record.get("schedule_anchor")))
        self.relative_anchor = self.record.get("schedule_anchor") or date.today().isoformat()
        relative = tk.Checkbutton(footer, text="Termine relativ zum Einsatzdatum", variable=self.relative_var,
            bg=self.theme["bg"], fg=self.theme["text"], selectcolor=self.theme["input"],
            activebackground=self.theme["bg"], activeforeground=self.theme["text"], font=app_font(9))
        relative.pack(side="left")
        self.add_tooltip(relative, f"Bezugsdatum: {self.relative_anchor}. Beim Verwenden werden Fälligkeiten und Wiederholungsgrenzen um denselben Tagesabstand verschoben.")
        self._make_dialog_button(footer, "Übernehmen", self.submit, "confirm", width=140).pack(side="right")
        self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=8)
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        dialog.bind("<Control-Return>", lambda e: self.submit())
        if IS_MACOS:
            dialog.bind("<Command-Return>", lambda e: self.submit())
        self.render_editor()
        self._center_dialog(dialog, min_width=1050, min_height=780)
        self._schedule_windows_chrome_theme(dialog)
        title.focus_set()
        # Der Aufrufer führt den Hauptdialog; Unterdialoge nutzen run_modal.
        self._owner.run_modal(dialog)
        return self.result

    def render_editor(self, selected=None):
        tree = self.editor_tree
        selected = selected or (tree.selection()[0] if tree.selection() else self.holder["id"])
        expanded = {key: tree.item(key, "open") for key in getattr(self, "nodes", {}) if tree.exists(key)}
        tree.delete(*tree.get_children())
        self.nodes = {}
        def insert(kind, obj, parent="", siblings=None):
            identity = obj["id"]
            self.nodes[identity] = (kind, obj, siblings)
            label_names = ", ".join((self.get_label(value) or {}).get("name", "") for value in obj.get("labels", []))
            due = self.format_due_full(obj.get("due"), obj.get("due_time"))
            art = self.ITEM_KIND_NAMES[self.item_kind(obj)] if kind == "item" else "Liste" if kind == "list" else "Ordner"
            text = " ".join(str(obj.get("text" if kind == "item" else "title") or "").split())
            if kind == "item":
                item_kind = self.item_kind(obj)
                prefix = self.ICONS["group"] if item_kind == self.ITEM_KIND_GROUP else ""
                color = obj.get("color") or "text"
                tags = (item_kind, "color_" + color)
            else:
                prefix = self.ICONS[kind]
                color = obj.get("color") or ("import" if kind == "folder" else "ui_accent")
                tags = ("container", "color_" + color)
            tree.insert(parent, "end", iid=identity, text=f"{prefix}  {text}" if prefix else text,
                        values=(art, label_names, due), open=expanded.get(identity, True), tags=tags)
            if kind == "folder":
                for child in self.get_child_folders(identity):
                    insert("folder", child, identity, self.folders)
                for child in self.get_folder_lists(identity):
                    insert("list", child, identity, self.lists)
            else:
                children = obj.get("items" if kind == "list" else "children", [])
                for child in children:
                    insert("item", child, identity, children)
        insert(self.record["kind"], self.holder)
        if tree.exists(selected):
            tree.selection_set(selected)
            tree.focus(selected)
            tree.see(selected)
        labels = ", ".join((self.get_label(value) or {}).get("name", "") for value in self.holder.get("labels", [])) or "Keine Labels"
        color = next((name for name, key in self.LIST_COLOR_CHOICES if key == self.holder.get("color")), "Keine Farbe")
        note = " ".join(str(self.holder.get("note") or "Keine Beschreibung").split())
        self.summary_var.set(f"{color} · {labels} · {len(self.holder.get('attachments', []))} Anhänge\n{note[:180]}")
        counts = [f"{sum(kind == key for kind, _obj, _siblings in self.nodes.values())} {name}"
                  for key, name in (("folder", "Ordner"), ("list", "Listen"), ("item", "Punkte"))]
        self.structure_var.set("Aufbau der Vorlage · " + " · ".join(counts))
        self.resize_editor_columns()

    def resize_editor_columns(self, _event=None):
        tree = self.editor_tree
        width = tree.winfo_width()
        if width < 100:
            return
        font = tkfont.Font(font=self.tree_font())
        due_values = [tree.set(key, "due") for key in getattr(self, "nodes", {})]
        due_width = max((font.measure(value) + 20 for value in due_values if value), default=0)
        has_labels = any(tree.set(key, "labels") for key in getattr(self, "nodes", {}))
        tree.column("kind", width=font.measure("Long-Task") + 24 if width >= 900 else 0)
        tree.column("due", width=due_width)
        tree.column("labels", width=max(120, min(220, int(width * .23))) if has_labels else 0)

    def edit_from_pointer(self, event):
        tree = self.editor_tree
        identity = tree.identify_row(event.y)
        if identity and "indicator" not in tree.identify_element(event.x, event.y):
            tree.selection_set(identity)
            tree.focus(identity)
            return self.edit_selected()

    def selection(self):
        selected = self.editor_tree.selection()
        return self.nodes.get(selected[0]) if selected else None

    def edit_holder(self):
        self.holder["title"] = self.title_var.get().strip() or self.holder["title"]
        self.edit_object(self.record["kind"], self.holder)
        self.title_var.set(self.holder["title"])

    def edit_object(self, kind, obj):
        if kind == "item":
            details = self.themed_item_details_dialog(obj)
            if details:
                self.apply_item_details(obj, details)
        else:
            details = self.themed_page_details_dialog("Vorlagendetails" if obj is self.holder else "Listendetails" if kind == "list" else "Ordnerdetails",
                obj.get("title"), obj.get("note"), page=obj)
            if details:
                obj.update(details)
        self.render_editor(obj["id"])

    def edit_selected(self):
        selection = self.selection()
        if selection:
            kind, obj, _siblings = selection
            if obj is self.holder:
                self.edit_holder()
            else:
                self.edit_object(kind, obj)
        return "break"

    def add_node(self, kind):
        selected = self.selection()
        if selected is None:
            return
        selected_kind, obj, siblings = selected
        if kind in ("list", "folder"):
            parent_id = obj["id"] if selected_kind == "folder" else obj.get("folder_id")
            if selected_kind == "item":
                current = self.editor_tree.parent(obj["id"])
                while current and self.nodes[current][0] == "item":
                    current = self.editor_tree.parent(current)
                parent_id = self.nodes[current][1].get("folder_id") if current else self.holder["id"]
            if kind == "folder" and self.folder_depth(parent_id) + 1 >= self.MAX_FOLDER_DEPTH:
                self.show_warning("Ordner", "Die maximale Ordnertiefe ist erreicht.", parent=self.dialog)
                return
            new = self.new_list_object("Neue Liste", [], folder_id=parent_id) if kind == "list" else self.new_folder_object("Neuer Ordner", parent_id=parent_id)
            details = self.themed_page_details_dialog("Neue Liste" if kind == "list" else "Neuer Ordner", new["title"], "", page=new)
            if not details:
                return
            new.update(details)
            (self.lists if kind == "list" else self.folders).append(new)
        else:
            if selected_kind == "folder":
                self.show_info("Punkt hinzufügen", "Wähle zuerst eine Liste oder lege eine Liste im Ordner an.", parent=self.dialog)
                return
            target = obj["items"] if selected_kind == "list" else obj.setdefault("children", []) if kind == "child" else siblings
            if target is None:
                return
            depth = 0
            parent = obj["id"] if kind == "child" and selected_kind == "item" else self.editor_tree.parent(obj["id"]) if selected_kind == "item" else ""
            while parent and self.nodes[parent][0] == "item":
                depth += 1
                parent = self.editor_tree.parent(parent)
            if depth > self.MAX_ITEM_DEPTH:
                self.show_warning("Unterpunkt", "Die maximale Punkttiefe ist erreicht.", parent=self.dialog)
                return
            details = self.new_item_dialog(title="Neuer Vorlagenpunkt")
            if not details:
                return
            new = self.build_item_from_dialog(details)
            target.append(new)
        self.render_editor(new["id"])

    def move_selected(self, direction):
        selection = self.selection()
        if not selection or selection[2] is None:
            return
        kind, obj, siblings = selection
        parent_key = "parent_id" if kind == "folder" else "folder_id"
        peers = [value for value in siblings if kind == "item" or value.get(parent_key) == obj.get(parent_key)]
        index = peers.index(obj) + direction
        if 0 <= index < len(peers):
            first, second = siblings.index(obj), siblings.index(peers[index])
            siblings[first], siblings[second] = siblings[second], siblings[first]
            self.render_editor(obj["id"])

    def remove_selected(self):
        selection = self.selection()
        if not selection or selection[1] is self.holder:
            return
        kind, obj, siblings = selection
        if not self.ask_yes_no("Eintrag entfernen", "Diesen Eintrag einschließlich seiner Unterpunkte aus der Vorlage entfernen?", parent=self.dialog):
            return
        if kind == "folder":
            identities = {value["id"] for value in self.iter_folder_subtree(obj["id"])}
            self.folders[:] = [value for value in self.folders if value["id"] not in identities]
            self.lists[:] = [value for value in self.lists if value.get("folder_id") not in identities]
        else:
            siblings.remove(obj)
        self.render_editor(self.holder["id"])

    def submit(self):
        title = self.title_var.get().strip()
        if not title:
            self.show_warning("Vorlage", "Bitte einen Titel eingeben.", parent=self.dialog)
            return "break"
        self.holder["title"] = title[:120]
        if self.relative_var.get():
            self.record["schedule_anchor"] = self.relative_anchor
        else:
            self.record.pop("schedule_anchor", None)
        try:
            self.result = self.export_record()
        except (OSError, ValueError) as exc:
            self.show_error("Vorlage übernehmen", str(exc), parent=self.dialog)
            return "break"
        self.dialog.destroy()
        return "break"


