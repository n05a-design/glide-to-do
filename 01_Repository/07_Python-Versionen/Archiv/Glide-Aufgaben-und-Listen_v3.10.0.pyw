        "dark_orange": "#FF9F0A",
        "dark_cyan": "#40C8E0",
        "dark_calendar_hover": "#5AA2F0",
        "dark_hover": "#243A55",
    }

    THEMES = {
        "light": {
            "bg": PALETTE["off_white"],
            "card": PALETTE["white"],
            "input": PALETTE["white"],
            "input_border": PALETTE["light_border"],
            "text": PALETTE["navy"],
            "muted": PALETTE["gray"],
            "placeholder": PALETTE["light_placeholder"],
            "accent": PALETTE["purple"],
