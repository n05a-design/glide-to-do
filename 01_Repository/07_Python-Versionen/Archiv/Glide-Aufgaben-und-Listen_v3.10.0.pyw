    def bind_mousewheel(self, widget, target=None):
        """Tk 8-Mausrad und Tk 9-Trackpad; Bindungen bleiben am jeweiligen Widget."""
        target = target if target is not None else widget
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.bind_optional(widget, sequence, lambda event: self._on_mousewheel(event, target))
        self.bind_optional(widget, "<TouchpadScroll>",
                           lambda event: self._on_mousewheel(event, target, precise=True))

    def _on_mousewheel(self, event, widget, precise=False):
        try:
            if precise:
                # Tk 9 kodiert X/Y als zwei vorzeichenbehaftete 16-Bit-Werte.
                packed = int(getattr(event, "delta", 0))
                vertical = packed & 0xffff
                if vertical >= 0x8000:
                    vertical -= 0x10000
                if not vertical:
                    return "break"
                if isinstance(widget, tk.Canvas):
                    region = widget.bbox("all")
                    if region:
                        height = max(widget.winfo_height(), region[3] - region[1])
                        first, last = widget.yview()
                        if last - first < ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
                            widget.yview_moveto(first - vertical / max(1, height))
                    return "break"
                # Native Text-/Treeview-Widgets scrollen in Zeilen. Kleine
                # Trackpad-Deltas sammeln, statt jede Geste zu vervielfachen.
                remainder = getattr(widget, "_glide_wheel_remainder", 0) - vertical
                steps = int(remainder / 16)
                widget._glide_wheel_remainder = remainder - steps * 16
            elif getattr(event, "num", None) in (4, 5):
                steps = -1 if event.num == 4 else 1
            else:
                delta = getattr(event, "delta", 0)
                if not delta:
                    return "break"
                # Tk 9 liefert auch auf dem Mac normierte 120er-Mausraddeltas;
                # Tk 8 kann dort kleine, bereits zeilenbezogene Werte liefern.
                steps = -int(delta / 120) if abs(delta) >= 120 or not IS_MACOS else -int(delta)
                if not steps:
                    steps = -1 if delta > 0 else 1
            first, last = widget.yview()
            if steps and last - first < ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
                if isinstance(widget, tk.Canvas) and int(float(widget.cget("yscrollincrement"))) == 1:
                    steps *= 24
                widget.yview_scroll(steps, "units")
        except (tk.TclError, ValueError, TypeError):
            pass
        return "break"

    @staticmethod
    def accel(*keys):
        """Plattformgerechte Beschriftung eines Tastenkürzels.

        Unter macOS heißt der Modifikator Cmd; „Strg+E“ wäre dort schlicht falsch.
        """
        modifier = "Cmd" if IS_MACOS else "Strg"
        return "+".join([modifier] + [str(key) for key in keys])

    def _apply_sidebar_visibility(self):
        visible = self.settings.get("sidebar_visible", True)
        if visible:
            self.sidebar_shell.pack(side="left", fill="y", padx=(0, 18), pady=(0, 14), before=self.content_frame)
        else:
            self.sidebar_shell.pack_forget()
        if visible:
            self.sidebar_toggle_button.set_active(None)
        else:
            self.sidebar_toggle_button.set_active(self.theme["selection"], self.theme["selection_text"])

    def toggle_sidebar(self):
        old = self.settings.get("sidebar_visible", True)
        self.settings["sidebar_visible"] = not old
        if not self.save_settings(show_error=True):
            self.settings["sidebar_visible"] = old
            return "break"
        if old:
            self.tree.focus_set()
        self._apply_sidebar_visibility()
        return "break"

    def app_action_entries(self):
        """Menübaum einmal auslesen; App und Systemmenü führen dieselben Befehle aus."""
        entries = []
        def visit(menu, path):
            for index in range((menu.index("end") if menu.index("end") is not None else -1) + 1):
                kind = menu.type(index)
                if kind == "cascade":
                    child = menu.nametowidget(menu.entrycget(index, "menu"))
                    visit(child, path + [menu.entrycget(index, "label")])
                elif kind == "command":
                    entries.append({"category": path[0], "path": " › ".join(path),
                                    "label": menu.entrycget(index, "label"),
                                    "shortcut": menu.entrycget(index, "accelerator"),
                                    "menu": menu, "index": index})
        for title, menu in self.action_menus:
            visit(menu, [title])
        return entries

    def invoke_app_action(self, action, previous_focus=None):
        if previous_focus is not None and previous_focus.winfo_exists():
            previous_focus.focus_set()
            virtual = {"Kopieren": "<<Copy>>", "Einfügen": "<<Paste>>", "Rückgängig": "<<Undo>>", "Alle auswählen": "<<SelectAll>>"}
            if isinstance(previous_focus, (tk.Entry, tk.Text, ttk.Entry)) and action["label"] in virtual:
                previous_focus.event_generate(virtual[action["label"]])
                return
        action["menu"].invoke(action["index"])

    def show_actions_dialog(self):
        previous_focus = getattr(self, "_actions_source_focus", None) or self.current_focus_widget()
        self._actions_source_focus = None
        dialog = tk.Toplevel(self.root)
        dialog.title("Aktionen")
        dialog.transient(self.root)
        dialog.configure(bg=self.theme["bg"])
        dialog.minsize(640, 440)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=24, pady=20)
        tk.Label(body, text="Alle App-Aktionen", bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(16, "bold"), anchor="w").pack(fill="x", pady=(0, 12))
        search = tk.StringVar()
        entry = tk.Entry(body, textvariable=search, name="action_search", bg=self.theme["input"],
                         fg=self.theme["text"], insertbackground=self.theme["text"], font=app_font(12),
                         relief="flat", bd=0, highlightthickness=1,
                         highlightbackground=self.theme["input_border"], highlightcolor=self.theme["ui_accent"])
        self._make_field_label(body, "Aktion suchen · z. B. Backup, Kopieren oder Sortieren").pack(anchor="w", pady=(0, 5))
        entry.pack(fill="x", ipady=8, pady=(0, 12))
        category = tk.StringVar(value="Alle Bereiche")
        category_frame, _ = self._make_option_menu(body, category, ["Alle Bereiche", "Datei", "Bearbeiten", "Ansicht", "Hilfe"])
        category_frame.pack(fill="x", pady=(0, 12))
        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(side="bottom", fill="x", pady=(14, 0))
        surface = tk.Frame(body, bg=self.theme["card"])
        surface.pack(fill="both", expand=True)
        tree = ttk.Treeview(surface, name="actions_tree", columns=("category", "key"), show="tree", selectmode="browse",
                            style="Dialog.Treeview", height=10)
        tree.column("#0", width=340, minwidth=220)
        tree.column("category", width=180, minwidth=100)
        tree.column("key", width=90, minwidth=70, stretch=False)
        scroll = ThemedAutoScrollbar(surface, self.theme["card"], self.theme["card"],
                                     self.theme["input_border"], self.theme["muted"])
        scroll.pack(side="right", fill="y")
        scroll.set_command(tree.yview)
        tree.configure(yscrollcommand=scroll.set)
        tree.pack(fill="both", expand=True)
        self.bind_mousewheel(tree)
        entries = self.app_action_entries()
        chosen = []
        def refresh(*_args):
            tree.delete(*tree.get_children())
            terms = search.get().casefold().split()
            for index, action in enumerate(entries):
                if category.get() != "Alle Bereiche" and action["category"] != category.get():
                    continue
                haystack = (action["path"] + " " + action["label"]).casefold()
                if all(term in haystack for term in terms):
                    tree.insert("", "end", iid=str(index), text=action["label"], values=(action["path"], action["shortcut"]))
            rows = tree.get_children()
            if rows:
                tree.selection_set(rows[0])
                tree.focus(rows[0])
        def submit(_event=None):
            selected = tree.selection()
            if selected:
                chosen.append(entries[int(selected[0])])
                dialog.destroy()
            return "break"
        search.trace_add("write", refresh)
        category.trace_add("write", refresh)
        self._make_dialog_button(footer, "Ausführen", submit, "confirm").pack(side="right")
        self._make_dialog_button(footer, "Schließen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        tree.bind("<Double-Button-1>", submit)
        tree.bind("<Return>", submit)
        entry.bind("<Return>", submit)
        entry.bind("<Down>", lambda e: tree.focus_set() or "break")
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        refresh()
        self._center_dialog(dialog, min_width=840, min_height=650)
        self._schedule_windows_chrome_theme(dialog)
        entry.focus_set()
        self.run_modal(dialog)
        if chosen:
            self.invoke_app_action(chosen[0], previous_focus)

