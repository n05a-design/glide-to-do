+            planned_date = None
+        elif not isinstance(planned_date, str) or cls.normalize_due(planned_date) != planned_date:
+            raise ValueError("Der Bearbeitungstag muss ein gültiges Datum im Format JJJJ-MM-TT sein.")
+        if estimated_minutes in (None, ""):
+            estimated_minutes = None
+        elif type(estimated_minutes) is not int or not 1 <= estimated_minutes <= cls.MAX_ESTIMATED_MINUTES:
+            raise ValueError(f"Der geschätzte Aufwand muss zwischen 1 und {cls.MAX_ESTIMATED_MINUTES} ganzen Minuten liegen.")
+        return {"planned_date": planned_date, "estimated_minutes": estimated_minutes}
