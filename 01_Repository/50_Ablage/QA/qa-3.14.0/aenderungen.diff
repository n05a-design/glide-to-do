+        with self.item_change(item_ids) as change:
+            for item_id in item_ids:
+                found = self.find_item(item_id)
+                if not found or not self.is_schedulable_item(found[0]):
+                    continue
+                for key, value in changes.items():
+                    if found[0].get(key) != value:
+                        found[0][key] = value
+                        change.mark()
