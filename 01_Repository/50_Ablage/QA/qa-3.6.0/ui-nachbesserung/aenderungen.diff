+        def schedule(_event=None):
+            hide()
+            state["after"] = widget.after(500, show)
+        for event in ("<Enter>", "<FocusIn>"):
+            widget.bind(event, schedule, add="+")
+        for event in ("<Leave>", "<FocusOut>", "<ButtonPress-1>", "<Destroy>"):
