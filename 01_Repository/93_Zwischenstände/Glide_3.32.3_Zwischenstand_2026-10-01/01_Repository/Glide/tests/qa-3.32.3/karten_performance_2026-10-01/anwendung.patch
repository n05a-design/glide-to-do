+    def library_card_preview(self, kind, entry, preview_rows):
+        """Frische Anzeigedaten; nur Widgets werden zwischen Aufrufen erhalten."""
+        if kind == "folder":
+            nested = {folder["id"] for folder in self.iter_folder_subtree(entry["id"])}
+            lists = [value for value in self.lists if value.get("folder_id") in nested]
+            items = [item for value in lists for item in value.get("items", [])]
+            children = [("folder", value) for value in self.get_child_folders(entry["id"])]
+            children += [("list", value) for value in self.get_folder_lists(entry["id"])]
+            previews = [(self.ICONS[child_kind], " ".join(str(value.get("title") or "").split()), "")
+                        for child_kind, value in children[:preview_rows]]
+            remaining = max(0, len(children) - len(previews))
+            summary = f"{len(lists)} Listen · {len(nested) - 1} Unterordner"
+        elif self.is_drawing_list(entry):
+            items, previews, remaining = [], [], 0
+            summary = self.drawing_summary(entry)
+        else:
+            items = entry.get("items", [])
+            tasks = [item for item in self.walk_items(items) if self.is_schedulable_item(item)]
+            pending = [item for item in tasks if not item.get("done")]
+            pending.sort(key=lambda item: (item.get("due") or "9999", -item.get("importance", 0)))
+            previews = []
+            for item in pending[:preview_rows]:
+                title_line = str(item.get("text") or "").splitlines()[0]
+                due = self.format_due_display(item.get("due")) if item.get("due") else ""
+                previews.append((self.ICONS["priority_high"] if item.get("importance", 0) >= 2 else self.ICONS["task_open"],
+                                 title_line, due))
+            remaining, summary = max(0, len(pending) - len(previews)), ""
+        return previews, remaining, summary, self.compute_stats(items)
+
