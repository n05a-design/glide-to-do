# Zeilenenden für die ganze Ablage (W03, 08.10.2026). Bis dahin regelte nur
# 01_Repository/Glide/.gitattributes sie; Dateien aus der Windows-Arbeitskopie
# kamen deshalb außerhalb des Quellbaums mit CRLF ins Repository (3.33.8).
# Die Regeln in 01_Repository/Glide/.gitattributes gelten dort zusätzlich.
* text=auto
*.py text eol=lf
*.pyw text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Freigegebene Markenmaster und SVG-Ableitungen bytegleich halten.
20_Grafik_Master/01_Logo/svg/*.svg -text
20_Grafik_Master/03_Fav-Icon/favicon.svg -text
07_Python-Versionen/resources/logo/*.svg -text
*.canvas text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.heic binary
*.webp binary
*.pdf binary
*.docx binary
*.zip binary
*.af binary
*.afdesign binary
*.ttf binary
*.otf binary
# Glide-Daten tragen Prüfsummen (Showcase-Manifest, Fixtures): Bytes bleiben,
# wie sie erzeugt wurden – auch eine Vorlagendatei mit CRLF.
*.glidebackup -text
*.glidetemplates -text
*.glideapp -text
*.glidepage -text
*.glideexchange -text
# Mitgelieferte Drittdateien unverändert, auch in 07_Python-Versionen: Ihr
# SHA-256 wird gegen src/glide, das Bundle und die Herkunftsangaben geprüft.
**/vendor/** -text
**/resources/fonts/** -text
# Original-OFL-Dateien behalten Zeilenenden und Lizenz-Leerzeichen.
**/resources/fonts/OFL-*.txt -text whitespace=-blank-at-eol,cr-at-eol
01_Repository/Glide/packaging/paket/lizenzen/macos/*-OFL.txt -text whitespace=-blank-at-eol,cr-at-eol
# Originale Schrift-Master samt Lizenz-/Liesmichtexten unverändert erhalten.
20_Grafik_Master/07_Fonts/** -text whitespace=-blank-at-eol,cr-at-eol

# Paketartefakte und native Bibliotheken bytegleich behandeln.
*.tar.gz binary
*.dll binary
*.pyd binary
*.so binary
*.dylib binary
*.exe binary
*.woff2 binary
*.tiff binary
