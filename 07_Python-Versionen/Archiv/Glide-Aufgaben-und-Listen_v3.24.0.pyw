        self.editor_tree.column("#0", width=420, minwidth=160, stretch=True)
        for key in ("kind", "labels", "due"):
            self.editor_tree.column(key, minwidth=0, stretch=False, anchor="w")
        for tag, font in (("container", self.group_row_font()), ("group", self.group_row_font()),
