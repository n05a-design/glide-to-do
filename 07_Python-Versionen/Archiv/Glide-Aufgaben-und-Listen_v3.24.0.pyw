            height=38,
            radius=16,
            bg_key="card",
            font=app_font(8, "bold"),
        )
        self.import_list_button.grid(row=0, column=0, columnspan=2, sticky="ew", pady=(0, 8))

        self.add_folder_button = self.make_button(
            sidebar_actions,
            text="+ Neuer Ordner",
            command=self.create_new_folder,
            color_key="accent",
            width=150,
            height=38,
            radius=16,
            bg_key="card",
            font=app_font(8, "bold"),
        )
