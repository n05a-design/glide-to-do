    def today_plan_ids(self, day=None):
        """IDs der Aufgaben, die auf dem betrachteten Tag eingeplant sind.

        Seit 3.22 liest die Auswahl das Feld `planned_date` am Punkt. Der
        frühere Eintrag in den Einstellungen ist entfallen; er verfiel um
        Mitternacht und stand in keinem Backup.
        """
        return [entry[4].get("id") for entry in self.plan_day_entries(apply_filters=False, day=day)]

    def today_plan_entries(self, apply_filters=True, day=None):
        """Die eingeplanten Aufgaben als Referenzen auf die Quellobjekte."""
        return self.plan_day_entries(apply_filters=apply_filters, day=day)

    def count_today_plan(self):
        return self.count_plan_day()

    def set_today_view(self, refresh=True):
        """Öffnet „Mein Tag“ beim heutigen Tag."""
        return self.set_plan_day_view(refresh=refresh, day=date.today().isoformat())

    def plan_inbox_items(self, apply_filters=True):
        """Offene Aufgaben des Eingangs ohne Bearbeitungstag.

        Punkt 1 (3.22.0): Neu erfasste Aufgaben landen im Eingang und tragen
        noch keinen Tag. Damit sie nicht unbemerkt liegen bleiben, stehen sie
        als eigener Block in „Mein Tag“ und lassen sich von dort mit einem
        Befehl auf den gezeigten Tag setzen.
        """
        inbox = next((entry for entry in self.lists if self.is_inbox_list(entry)), None)
        if not isinstance(inbox, dict):
            return []
        query = self.current_search_query() if apply_filters else ""
        treffer = []
        for item in self.walk_items(inbox.get("items", [])):
            if not self.is_schedulable_item(item) or item.get("done"):
                continue
            if self.normalize_due(item.get("planned_date")):
                continue
            if apply_filters and (
                not self.item_text_matches_query(item, query)
                or not self.item_matches_status_filter(item)
            ):
                continue
            treffer.append((inbox, item))
        return treffer

    def update_today_plan(self, item_ids, add=None, day=None):
        """Trägt den Bearbeitungstag ein oder nimmt ihn weg.

        Der Tag ist der gerade betrachtete; außerhalb der Ansicht ist es heute.
        Fälligkeit, Wiederholung und Erinnerung bleiben unberührt – geplant
        wird, wann gearbeitet wird, nicht wann etwas fällig ist.
        """
        ziel = self.normalize_due(day) or (
            self.plan_day() if self.view_mode == self.PLAN_DAY_VIEW else date.today().isoformat())
        candidates = []
        for item_id in item_ids or ():
            found = self.find_item_in_lists(item_id)
            if found and self.is_schedulable_item(found[0]) and item_id not in candidates:
                candidates.append(item_id)
        if not candidates:
            return "break"
        geplant = {item_id for item_id in candidates
                   if self.normalize_due(self.find_item_in_lists(item_id)[0].get("planned_date")) == ziel}
        if add is None:
            add = len(geplant) < len(candidates)
        wert = ziel if add else None
        betroffen = [item_id for item_id in candidates
                     if (item_id in geplant) != bool(add)]
        if not betroffen:
            return "break"
        with self.item_change(betroffen, restore=False, update_sidebar=True) as change:
            for item_id in betroffen:
                found = self.find_item_in_lists(item_id)
                if found:
                    found[0]["planned_date"] = wert
            change.mark()
        return "break"

    def clear_today_plan(self, day=None):
        """Nimmt allen Aufgaben des betrachteten Tages den Bearbeitungstag."""
        betroffen = self.today_plan_ids(day=day)
        if not betroffen:
            return "break"
        with self.item_change(betroffen, restore=False, update_sidebar=True) as change:
            for item_id in betroffen:
                found = self.find_item_in_lists(item_id)
                if found:
                    found[0]["planned_date"] = None
            change.mark()
        return "break"

    def migrate_today_plan_setting(self):
        """Überträgt eine noch gültige 3.21-Tagesauswahl auf den Bearbeitungstag.

        Läuft genau einmal. Ohne sie verlöre eine am selben Tag zusammengestellte
        Auswahl beim Versionswechsel ihren Inhalt – sichtbar für die Person,
        die Glide gerade benutzt hat.
        """
        if self.settings.get("today_plan_migrated"):
            return False
        plan = self.settings.get("today_plan")
        heute = date.today().isoformat()
        ids = plan.get("item_ids") if isinstance(plan, dict) and plan.get("date") == heute else []
        uebernommen = 0
        for item_id in ids if isinstance(ids, list) else []:
            found = self.find_item_in_lists(item_id)
            if found and self.is_schedulable_item(found[0]) and not found[0].get("planned_date"):
                found[0]["planned_date"] = heute
                uebernommen += 1
        self.settings["today_plan_migrated"] = True
        self.settings.pop("today_plan", None)
        self.save_settings()
        if uebernommen:
            self.save_items(show_error=False, record_activity=False)
        return bool(uebernommen)

    def plan_day(self):
        """Der gerade betrachtete Planungstag; ohne Auswahl ist es heute."""
        value = self.normalize_due(getattr(self, "plan_day_value", None))
        return value or date.today().isoformat()

    def plan_day_entries(self, apply_filters=True, day=None):
        """Aufgaben mit Bearbeitungstag am gewählten Tag als Referenzen.

        Maßgeblich ist `planned_date`, nicht die Fälligkeit. Sortiert wird nach
        Wichtigkeit, dann Fälligkeit, dann Titel – die Reihenfolge der
        Übersichten bleibt dieselbe Tupelform wie bei „In Bearbeitung“.
        """
        target = self.normalize_due(day) or self.plan_day()
        return self.render_cached(
            ("plan_day", target, bool(apply_filters),
             self.current_search_query() if apply_filters else "",
             self.get_filter_mode() if apply_filters and hasattr(self, "hide_done_var") else ""),
            lambda: self._collect_plan_day_entries(apply_filters, target),
        )

    def _collect_plan_day_entries(self, apply_filters, target):
        query = self.current_search_query() if apply_filters else ""
        results = []
        for list_index, entry in enumerate(self.lists):
            for item_index, item in enumerate(self.walk_items(entry.get("items", []))):
                if not self.is_schedulable_item(item):
                    continue
                if self.normalize_due(item.get("planned_date")) != target:
                    continue
                if apply_filters and (
                    not self.item_text_matches_query(item, query)
                    or not self.item_matches_status_filter(item)
                ):
                    continue
                results.append((self.normalize_due(item.get("due")) or "9999-12-31",
                                list_index, item_index, entry, item))
        results.sort(key=lambda value: (
            -self.clamp_importance(value[4].get("importance", 0)),
            value[0],
            str(value[4].get("text") or "").lower(),
        ))
        return results

    def count_plan_day(self):
        return len(self.plan_day_entries(apply_filters=False))

    def plan_day_items(self, apply_filters=False, day=None):
        """Nur die Punktobjekte des Planungstags – Grundlage jeder Summe."""
        return [entry[4] for entry in self.plan_day_entries(apply_filters=apply_filters, day=day)]

    def format_plan_day(self, day=None):
        """Wochentag und Datum des Planungstags, mit Hinweis auf heute."""
        target = self.normalize_due(day) or self.plan_day()
        try:
            parsed = date.fromisoformat(target)
        except ValueError:
            return target
        text = f"{self.WEEKDAY_NAMES[parsed.weekday()]}, {parsed.strftime('%d.%m.%Y')}"
        if target == date.today().isoformat():
            text += " · heute"
        return text

    def set_plan_day_view(self, refresh=True, day=None):
        """Öffnet die Tagesplanung; ohne Angabe beim heutigen Tag."""
        self.plan_day_value = self.normalize_due(day) or date.today().isoformat()
        self._activate_system_view(self.PLAN_DAY_VIEW, refresh=refresh)

    def shift_plan_day(self, delta):
        """Schaltet die Tagesplanung um ganze Tage weiter oder zurück."""
        try:
            parsed = date.fromisoformat(self.plan_day())
        except ValueError:
            parsed = date.today()
        self.plan_day_value = (parsed + timedelta(days=int(delta))).isoformat()
        if self.view_mode != self.PLAN_DAY_VIEW:
            return self.set_plan_day_view(day=self.plan_day_value) or "break"
        self.update_window_title()
        self.update_header_title()
        self.update_sidebar_list()
        self.refresh_tree()
        return "break"

    def plan_day_backward(self, event=None):
        return self.shift_plan_day(-1)

    def plan_day_forward(self, event=None):
        return self.shift_plan_day(1)

    def set_in_progress_view(self, refresh=True):
