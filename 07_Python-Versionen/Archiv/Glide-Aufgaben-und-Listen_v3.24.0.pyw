        footer = tk.Frame(dialog, bg=self.theme["bg"])
        footer.pack(side="bottom", fill="x", padx=24, pady=16)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=24, pady=(20, 0))
