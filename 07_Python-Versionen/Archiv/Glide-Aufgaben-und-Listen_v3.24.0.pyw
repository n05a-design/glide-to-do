            dialog.bind(sequence, lambda _event, amount=amount, unit=unit: canvas.yview_scroll(amount, unit))
        dialog.bind("<Home>", lambda _event: canvas.yview_moveto(0))
        dialog.bind("<End>", lambda _event: canvas.yview_moveto(1))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.bind("<Return>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=820, min_height=650)
        self._schedule_windows_chrome_theme(dialog)
        close_button.focus_set()
        self.run_modal(dialog)
        try:
            if previous_focus is not None and previous_focus.winfo_exists():
                previous_focus.focus_set()
        except tk.TclError:
            pass


class TemplateDraft(ListApp):
    """Isolierter Vorlagenentwurf mit denselben Detailmasken wie echte Listen.

    Kein ListApp-Start, keine Timer, kein Speichern im Nutzdatenordner. Labels,
    Struktur und Anhänge gehören bis zum Übernehmen ausschließlich dem Entwurf.
    """

    def __init__(self, app, template):
        self.root = app.root
        self.theme = dict(app.theme)
        self.theme_name = app.theme_name
        self.settings = copy.deepcopy(app.settings)
        self.theme_widgets, self.rounded_containers = [], []
        self._after_ids = set()
        self.record = copy.deepcopy(template)
        self.result = None
        self.dialog = None
        self._temporary = tempfile.TemporaryDirectory(prefix="glide-template-edit-")
        self._draft_dir = self._temporary.name
        self._owner = app
        try:
            if "payload" in template:
                referenced = app.validate_template_payload(template)
                payload = copy.deepcopy(template["payload"])
                self.labels = copy.deepcopy(payload.get("labels", []))
                self.folders = payload.get("folders", [])
                self.lists = payload.get("lists", [])
                for storage in referenced:
                    encoded = template["files"][storage]
                    storage = self.validate_attachment_storage(storage)
                    path = os.path.join(self._draft_dir, storage)
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "wb") as file:
                        file.write(base64.b64decode(encoded, validate=True))
            else:
                self.labels = copy.deepcopy(app.labels)
                self.folders, self.lists = [], []
                if template["kind"] == "folder":
                    folder = self.new_folder_object(template["title"])
                    self.folders.append(folder)
                    self.lists = [self.new_list_object(text, [], folder_id=folder["id"])
                                  for text in template.get("items", [])]
                else:
                    self.lists.append(self.new_list_object(template["title"],
                        [self.new_item(text) for text in template.get("items", [])]))
            self.ensure_system_labels()
            roots = ([folder for folder in self.folders if not folder.get("parent_id")]
                     if template["kind"] == "folder" else self.lists)
            if len(roots) != 1:
                raise ValueError("Die Vorlage muss genau eine Stammliste oder einen Stammordner enthalten.")
            self.holder = roots[0]
            self.holder.update({key: copy.deepcopy(template.get(key))
                                for key in ("title", "note", "color", "labels")})
            self.holder.setdefault("attachments", [])
            self.trash = []
            self.active_list_id = None
            self.active_folder_id = None
            self.items = []
        except Exception:
            self._temporary.cleanup()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *_exc):
        if self.dialog is not None and self.dialog.winfo_exists():
            self.dialog.destroy()
        for callback in self._after_ids:
            try:
                self.root.after_cancel(callback)
            except tk.TclError:
                pass
        self._temporary.cleanup()

    def snapshot_undo(self):
        pass

    def save_items(self, *args, **kwargs):
        return True

    def refresh_tree(self, *args, **kwargs):
        pass

    def sync_current_list_reference(self):
        pass

    def resolve_attachment_path(self, attachment):
        try:
            return os.path.join(self._draft_dir, self.validate_attachment_storage(attachment.get("storage")))
        except (ValueError, AttributeError):
            return None

    def store_attachment(self, source_path):
        if not os.path.isfile(source_path) or os.path.getsize(source_path) > self.MAX_BACKUP_ATTACHMENT_BYTES:
            raise OSError("Die Datei fehlt oder überschreitet die erlaubte Anhangsgröße.")
        identity = uuid.uuid4().hex
        name = os.path.basename(source_path)
        storage = "attachments/" + self.safe_attachment_filename(name, identity)
        target = os.path.join(self._draft_dir, storage)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(source_path, target)
        return {"id": identity, "name": name, "storage": storage,
                "size": os.path.getsize(target), "mime": mimetypes.guess_type(name)[0] or "application/octet-stream",
                "added_at": datetime.now().isoformat(timespec="seconds")}

    def export_record(self):
        is_folder = self.record["kind"] == "folder"
        payload = self.partial_backup_payload(
            [] if is_folder else [self.holder["id"]], [self.holder["id"]] if is_folder else [])
        files = {}
        for storage in self.validate_backup_schema(payload, portable=True):
            with open(os.path.join(self._draft_dir, storage), "rb") as file:
                files[storage] = base64.b64encode(file.read(self.MAX_BACKUP_ATTACHMENT_BYTES + 1)).decode("ascii")
        record = copy.deepcopy(self.record)
        record.update({key: copy.deepcopy(self.holder.get(key)) for key in ("title", "note", "color", "labels")})
        record.update(items=[], payload=payload, files=files)
        self.validate_template_payload(record)
        return record

