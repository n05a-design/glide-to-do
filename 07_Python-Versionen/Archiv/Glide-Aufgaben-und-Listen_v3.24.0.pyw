        self._center_dialog(dialog, min_width=1050, min_height=780)
        self._schedule_windows_chrome_theme(dialog)
        title.focus_set()
        # Der Aufrufer führt den Hauptdialog; Unterdialoge nutzen run_modal.
        self._owner.run_modal(dialog)
