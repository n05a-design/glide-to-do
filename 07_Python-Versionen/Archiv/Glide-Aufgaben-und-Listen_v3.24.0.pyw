            ("+ Liste", lambda: self.add_node("list"), "accent", 96),
            ("+ Ordner", lambda: self.add_node("folder"), "import", 106),
        ):
            if self.record["kind"] == "list" and text in ("+ Liste", "+ Ordner"):
