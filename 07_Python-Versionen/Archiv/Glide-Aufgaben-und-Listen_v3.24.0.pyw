            tk.Label(
                table, text=section, bg=self.theme["bg"], fg=self.theme["accent"],
                font=app_font(11, "bold"), anchor="w",
            ).grid(row=row, column=0, columnspan=2, sticky="ew", pady=(14 if row > 1 else 0, 8))
