        def kachel_calendar(parent):
            """Punkt 19 (3.24.0): Die Kalendervorschau in drei Darstellungen.

            Alle drei lesen dieselben Felder – Fälligkeit und Bearbeitungstag
            offener Punkte. Sie unterscheiden sich in der Reichweite, nicht im
            Bestand: Monat, laufende Woche oder die nächsten Termine.
            """
            modus = self.home_calendar_mode()
            titel = dict(self.HOME_CALENDAR_CHOICES).get(modus, "Kalendervorschau")
            tile = card(parent, f"{self.ICONS['calendar']}  Kalender \u00b7 {titel}")
            zaehler = self.home_calendar_days()
            heute = date.today()
            if modus == "next":
                termine = self.home_next_events(self.home_row_limit() + 1)
                if not termine:
                    label(tile, "Kein offener Punkt trägt einen Termin in der Zukunft.", color="muted")
                for tag, uhrzeit, quelle, item in termine:
                    beschriftung = self.format_due_full(tag, uhrzeit or None)
                    action(tile, f"{beschriftung}  \u00b7  {self.item_display_text(item).splitlines()[0]}",
                           lambda lid=quelle["id"], iid=item["id"]: self.open_task_in_source_list(lid, iid),
                           list_color(quelle))
            elif modus == "week":
                erster = heute - timedelta(days=(heute.weekday() if self.settings.get("week_start") != "sunday"
                                                 else (heute.weekday() + 1) % 7))
                for schritt in range(7):
                    tag = erster + timedelta(days=schritt)
                    anzahl = zaehler.get(tag.isoformat(), 0)
                    zeile = tk.Frame(tile, bg=theme["card"])
                    zeile.pack(fill="x", pady=2)
                    self._bind_home_wheel(zeile)
                    ist_heute = tag == heute
                    tk.Label(zeile, text=f"{self.WEEKDAY_NAMES[tag.weekday()]} {tag.strftime('%d.%m.')}",
                             bg=theme["card"], fg=theme["text"] if ist_heute else theme["muted"],
                             font=app_font(9, "bold") if ist_heute else app_font(9),
                             anchor="w").pack(side="left")
                    tk.Label(zeile, text=str(anzahl) if anzahl else "–", bg=theme["card"],
                             fg=theme["ui_accent"] if anzahl else theme["muted"],
                             font=app_font(9, "bold"), anchor="e").pack(side="right")
            else:
                raster = tk.Frame(tile, bg=theme["card"])
                raster.pack(fill="x", pady=(0, 6))
                self._bind_home_wheel(raster)
                sonntag_zuerst = self.settings.get("week_start") == "sunday"
                namen = ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"] if sonntag_zuerst else [
                    "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
                for spalte, name in enumerate(namen):
                    raster.columnconfigure(spalte, weight=1, uniform="homecal")
                    kopf = tk.Label(raster, text=name, bg=theme["card"], fg=theme["muted"],
                                    font=app_font(8, "bold"))
                    kopf.grid(row=0, column=spalte, sticky="ew", pady=(0, 2))
                    self._bind_home_wheel(kopf)
                erster_im_monat = heute.replace(day=1)
                versatz = (erster_im_monat.weekday() + 1) % 7 if sonntag_zuerst else erster_im_monat.weekday()
                tage_im_monat = calendar.monthrange(heute.year, heute.month)[1]
                for position in range(versatz + tage_im_monat):
                    zeile_nr, spalte = divmod(position, 7)
                    if position < versatz:
                        continue
                    tag = erster_im_monat + timedelta(days=position - versatz)
                    anzahl = zaehler.get(tag.isoformat(), 0)
                    ist_heute = tag == heute
                    if ist_heute:
                        grund, schrift = theme["ui_accent"], theme["selection_text"]
                    elif anzahl:
                        grund, schrift = theme["input"], theme["text"]
                    else:
                        grund, schrift = theme["card"], theme["muted"]
                    zelle = tk.Label(raster, text=f"{tag.day}" + (f"\u00b7{anzahl}" if anzahl and not ist_heute else ""),
                                     bg=grund, fg=schrift,
                                     font=app_font(8, "bold") if (ist_heute or anzahl) else app_font(8))
                    zelle.grid(row=zeile_nr + 1, column=spalte, sticky="ew", padx=1, pady=1, ipady=2)
                    self._bind_home_wheel(zelle)
                    if anzahl:
                        self.add_tooltip(zelle, f"{tag.strftime('%d.%m.%Y')}: {anzahl} offene(r) Punkt(e)")
                label(tile, f"{sum(zaehler.get((heute.replace(day=1) + timedelta(days=schritt)).isoformat(), 0) for schritt in range(tage_im_monat))} "
                            "offene Punkte mit Termin in diesem Monat", color="muted")
            action(tile, f"{self.ICONS['calendar']}  Kalender öffnen", self.open_calendar_view, "import")

        def kachel_overdue(parent):
            eintraege, gesamt = self.home_overdue_entries(self.home_row_limit())
            tile = card(parent, f"{self.ICONS['overdue']}  Verspätet")
            if not gesamt:
                label(tile, "Nichts überfällig – alle Fälligkeiten liegen in der Zukunft.", color="muted")
                return
            label(tile, f"{gesamt} offene(r) Punkt(e) mit vergangener Fälligkeit", color="muted")
            for faellig, quelle, item in eintraege:
                action(tile, f"{self.format_due_column(faellig, item.get('due_time'))}  \u00b7  "
                             f"{self.item_display_text(item).splitlines()[0]}",
                       lambda lid=quelle["id"], iid=item["id"]: self.open_task_in_source_list(lid, iid),
                       "overdue")
            if gesamt > len(eintraege):
                label(tile, f"… und {gesamt - len(eintraege)} weitere", color="muted")
            action(tile, f"{self.ICONS['overdue']}  Verspätet öffnen", self.set_overdue_view, "overdue")

        def kachel_progress(parent):
            """Fortschritt als Balken: heute gegen das Ziel, Woche gegen sich selbst."""
            tile = card(parent, "Fortschritt")
            ziel = self.daily_goal()
            geschafft = self.completions_today()
            if ziel:
                label(tile, f"Heute: {geschafft} von {ziel} erledigt", 11, True,
                      "confirm" if geschafft >= ziel else "text", pady=(0, 4))
                ProgressBar(tile, value=geschafft, maximum=ziel, bg_color=theme["card"],
                            track_color=theme["input"],
                            fill_color=theme["confirm"] if geschafft >= ziel else theme["ui_accent"],
                            ).pack(fill="x", pady=(0, 10))
            else:
                label(tile, f"Heute erledigt: {geschafft}", 11, True, pady=(0, 8))
            verlauf = self.completion_chart()
            woche = verlauf[-7:]
            summe = sum(anzahl for _tag, anzahl in woche)
            bestwert = max([anzahl for _tag, anzahl in woche] + [1])
            label(tile, f"Diese sieben Tage: {summe} erledigt \u00b7 bester Tag {bestwert}", color="muted")
            planung = self.planning_summary(self.plan_day_items(day=date.today().isoformat()))
            kapazitaet = planung.get("capacity") or 0
            if kapazitaet:
                belegt = min(planung.get("minutes", 0), kapazitaet)
                label(tile, "Tageskapazität", 10, True, "muted", pady=(8, 3))
                ProgressBar(tile, value=belegt, maximum=kapazitaet, bg_color=theme["card"],
                            track_color=theme["input"], fill_color=theme["flag"]).pack(fill="x", pady=(0, 4))
                label(tile, self.format_planning_summary(planung) or "", color="muted")

        def kachel_boards(parent):
            """Welche Pinnwände etwas tragen – und der Weg auf die globale."""
            tile = card(parent, "Pinnwände")
            boards = self.settings.get("pinboards", {})
            boards = boards if isinstance(boards, dict) else {}
            werkstatt = getattr(self, "workspace", None)
            global_scope = werkstatt.GLOBAL_SCOPE if werkstatt is not None else "global"
            eintraege = []
            for bereich, board in boards.items():
                karten = len(board.get("cards", []) or [])
                if not karten:
                    continue
                if bereich == global_scope:
                    eintraege.append((self.GLOBAL_BOARD_TITLE, karten, None, None))
                    continue
                art, _, kennung = bereich.partition(":")
                if art == "list":
                    quelle = next((entry for entry in self.lists if entry.get("id") == kennung), None)
                    if quelle is not None:
                        eintraege.append((self.list_path_title(quelle), karten, "list", kennung))
                elif art == "folder":
                    ordner = self.get_folder(kennung)
                    if ordner is not None:
                        eintraege.append((str(ordner.get("title") or "Ordner"), karten, "folder", kennung))
            eintraege.sort(key=lambda wert: -wert[1])
            if not eintraege:
                label(tile, "Noch keine Pinnwand mit Karten. Die globale Fläche ist ein guter Anfang.",
                      color="muted")
            for titel, karten, art, kennung in eintraege[:self.home_row_limit()]:
                if art is None:
                    action(tile, f"{titel}  \u00b7  {karten} Karten", self.open_global_board, "confirm")
                elif art == "list":
                    action(tile, f"{titel}  \u00b7  {karten} Karten",
                           lambda lid=kennung: self.set_active_list(lid), "accent")
                else:
                    action(tile, f"{titel}  \u00b7  {karten} Karten",
                           lambda fid=kennung: self.set_active_folder(fid), "import")
            action(tile, "Globale Pinnwand öffnen", self.open_global_board, "confirm")

        def kachel_stats(parent):
            stats = card(parent, "Dein aktueller Bestand")
            kennzahlen = tk.Frame(stats, bg=theme["card"])
            kennzahlen.pack(fill="x", pady=(0, 6))
            self._bind_home_wheel(kennzahlen)
            for index, (text, farbe) in enumerate((
                (f"{summary['done']} erledigt", "confirm"),
                (f"{summary['open']} offen", "flag"),
                (f"{summary['lists']} Listen", "clear"),
            )):
                if index:
                    trenner = tk.Label(kennzahlen, text="·", bg=theme["card"], fg=theme["muted"],
                                       font=app_font(12))
                    trenner.pack(side="left", padx=8)
                    self._bind_home_wheel(trenner)
                zahl = tk.Label(kennzahlen, text=text, bg=theme["card"], fg=theme[farbe],
                                font=app_font(12, "bold"))
                zahl.pack(side="left")
                self._bind_home_wheel(zahl)
            label(stats, f"{summary['due_today']} heute fällig  ·  {summary['overdue']} überfällig", color="muted")
            heute_geplant = self.planning_summary(self.plan_day_items(day=date.today().isoformat()))
            if heute_geplant["items"]:
                planungstext = self.format_planning_summary(heute_geplant)
                label(stats, f"Heute geplant: {heute_geplant['items']} Aufgabe(n)"
                      + (f"  ·  {planungstext}" if planungstext else ""), color="muted")
            bestand_zeile = flow(stats, pady=(4, 8))
            action(bestand_zeile, f"{self.ICONS['in_progress']}  In Bearbeitung öffnen",
                   self.set_in_progress_view, "due_action", side="left")
            if heute_geplant["items"]:
                action(bestand_zeile, f"{self.ICONS['today']}  Mein Tag öffnen",
                       self.set_today_view, "ui_accent", side="left")
            if summary["overdue"]:
                action(bestand_zeile, f"{self.ICONS['overdue']}  Verspätet öffnen",
                       self.set_overdue_view, "overdue", side="left")
            label(stats, f"Erledigt in den letzten {self.COMPLETION_CHART_DAYS} Tagen",
                  10, True, pady=(6, 6))
            CompletionChart(
                stats, self.completion_chart(), bg_color=theme["card"],
                bar_color=theme["ui_accent"], track_color=theme["input"],
                text_color=theme["muted"], today_color=theme["confirm"],
            ).pack(fill="x", pady=(0, 8))
            if self.settings.get("show_yearly_stats", True):
                label(stats, "Jahresanzeige · Aufgaben bearbeitet", 10, True, pady=(8, 4))
                yearly_history = self.yearly_activity_history()
                heatmap = YearHeatmap(
                    stats, yearly_history, bg_color=theme["card"],
                    empty_color=theme["input"], accent_color=theme["ui_accent"],
                    text_color=theme["muted"],
                )
                heatmap.pack(fill="x", pady=(0, 4))
                self.add_tooltip(heatmap, lambda: heatmap.hover_text_at(
                    heatmap.winfo_pointerx()-heatmap.winfo_rootx(),
                    heatmap.winfo_pointery()-heatmap.winfo_rooty()))
                year_stats = YearHeatmap.statistics(yearly_history)
                label(stats, f"{year_stats['active_days']} aktive Tage  ·  {year_stats['total']} Bearbeitungen  ·  "
                      f"bester Tag {year_stats['best_day']}  ·  Serie {year_stats['streak']}",
                      9, color="muted", pady=(0, 6))
            label(stats, "Der Bestand zählt vorhandene Aufgaben. Erfasste Tageswerte bleiben auch nach dem Löschen erhalten. "
                  "Gruppen und Überschriften zählen nicht mit.", 9, color="muted")

        bauer = {"clock": kachel_clock, "welcome": kachel_welcome, "today": kachel_today,
                 "focus": kachel_focus, "week": kachel_week,
                 "labels": kachel_labels, "recent": kachel_recent, "templates": kachel_templates,
                 "impulse": kachel_impulse, "calendar": kachel_calendar, "overdue": kachel_overdue,
                 "progress": kachel_progress, "boards": kachel_boards, "stats": kachel_stats}
        gewichte = {key: gewicht for key, _t, gewicht, _b, _s in self.HOME_TILE_DEFINITIONS}
        breite_kacheln = {key for key, _t, _g, breit, _s in self.HOME_TILE_DEFINITIONS if breit}
        sichtbar = [key for key in self.home_tile_order() if self.home_tile_visible(key)]
        spalten_zahl = self.home_column_count()

        kopfbereich = tk.Frame(self.home_content, bg=theme["bg"])
        kopfbereich.pack(fill="x")
        self._bind_home_wheel(kopfbereich)
        for key in [k for k in sichtbar if k in breite_kacheln]:
            bauer[key](kopfbereich)

        raster = tk.Frame(self.home_content, bg=theme["bg"])
        raster.pack(fill="both", expand=True)
        self._bind_home_wheel(raster)
        spalten = []
        for index in range(spalten_zahl):
            spalte = tk.Frame(raster, bg=theme["bg"])
            spalte.grid(row=0, column=index, sticky="new",
                        padx=(0 if index == 0 else self.HOME_CARD_GAP, 0))
            raster.columnconfigure(index, weight=1, uniform="home_columns")
            spalten.append([spalte, 0])
            self._bind_home_wheel(spalte)
        # Greedy: Jede Kachel kommt in die bislang kürzeste Spalte. Ohne diese
        # Verteilung stünde die hohe Bestandskachel allein und ließe neben sich
        # eine leere Spalte stehen.
        for key in [k for k in sichtbar if k not in breite_kacheln]:
            ziel = min(spalten, key=lambda eintrag: eintrag[1])
            bauer[key](ziel[0])
            ziel[1] += gewichte.get(key, 2)
        if not sichtbar:
            leer = self.make_rounded_container(
                raster, fill_key="card", outline_key="line", radius=self.HOME_CARD_RADIUS,
                inner_pad_x=self.HOME_CARD_PAD_X, inner_pad_y=self.HOME_CARD_PAD_Y,
                auto_height=True, register=False)
            leer.grid(row=0, column=0, sticky="new")
            label(leer.inner, "Alle Kacheln sind ausgeblendet.", 12, True)
            action(leer.inner, "Startseite einrichten …", self.show_home_tiles_dialog, "accent")

        for widget in (self.home_canvas, self.home_content):
            self._bind_home_wheel(widget)
        self.home_content.update_idletasks()
        self.home_canvas.yview_moveto(scroll_position)

    def refresh_template_page(self):
        """Linksbündige Spalten und feste Aktionen außerhalb des Scrollbereichs."""
        if not hasattr(self, "home_content"):
            return
        scroll_position = self.home_canvas.yview()[0] if getattr(self, "_home_rendered_view", None) == self.TEMPLATE_VIEW else 0
        self._home_rendered_view = self.TEMPLATE_VIEW
        self._set_stats_text(f"{len(self.templates)} Vorlagen")
        for widget in self.home_content.winfo_children():
            widget.destroy()
        theme = self.theme
        for widget in (self.home_frame, self.home_canvas, self.home_content):
            widget.configure(bg=theme["bg"])
        self.home_scrollbar.set_theme(theme["bg"], theme["bg"], theme["input_border"], theme["muted"])
        editing = bool(getattr(self, "_templates_editing", False))
        self.template_rows = []
        self.template_cards = []
        title_font = tkfont.Font(root=self.root, font=app_font(11, "bold"))
        # Gemeinsame Namensspalte nach Textmaß statt 40 % der Fensterbreite.
        title_width = min(230, max((title_font.measure(t.get("title", "Vorlage"))
                                   for t in self.templates), default=100) + 8)
        for template in getattr(self, "templates", []):
            surface = self.make_rounded_container(
                self.home_content, radius=self.HOME_CARD_RADIUS, inner_pad_x=10,
                inner_pad_y=6, auto_height=True, register=False,
            )
            surface.pack(fill="x", pady=(0, 8))
            self.template_cards.append(surface)
            card = surface.inner
            card.columnconfigure(1, minsize=title_width + 12)
            card.columnconfigure(2, weight=1)
            symbol = self.ICONS["folder" if template.get("kind") == "folder" else "list"]
            kind = tk.Label(card, text=symbol, bg=theme["card"], fg=theme["muted"], font=app_font(13))
            kind.grid(row=0, column=0, padx=(0, 4), pady=6, sticky="n")
            self.add_tooltip(kind, "Ordner" if template.get("kind") == "folder" else "Liste")
            title = tk.Label(card, text=template.get("title", "Vorlage"), bg=theme["card"],
                             fg=theme["text"], font=app_font(11, "bold"), anchor="w", justify="left")
            title.grid(row=0, column=1, sticky="new", padx=6, pady=8)
            note = tk.Label(card, text=template.get("note", ""), bg=theme["card"], fg=theme["muted"],
                            font=app_font(9), anchor="w", justify="left")
            note.grid(row=0, column=2, sticky="new", padx=(6, 12), pady=8)
            actions = tk.Frame(card, bg=theme["card"])
            actions.grid(row=0, column=3, sticky="e", pady=8)
            if editing:
                for icon, label, command, color in (
                    ("trash", "Vorlage löschen", self.delete_template, "delete"),
                    ("edit", "Vorlage bearbeiten", self.edit_template, "accent"),
                ):
                    button = self._make_dialog_button(actions, self.ICONS[icon],
                                lambda value=template["id"], fn=command: fn(value), color, width=38, height=38)
                    button.pack(side="left", padx=(0, 4))
                    self.add_tooltip(button, label)
            use = self._make_dialog_button(actions, "Verwenden",
                        lambda value=template["id"]: self.create_list_from_template(value), "confirm", width=118, height=38)
            use.pack(side="left")

            def layout(event, panel=card, heading=title, description=note, buttons=actions):
                width = panel.winfo_width()
                compact = width < 730
                if compact:
                    panel.columnconfigure(2, weight=0)
                    panel.columnconfigure(1, weight=1, minsize=0)
                    description.grid_configure(row=1, column=1, columnspan=3, padx=(6, 0), pady=(4, 4))
                else:
                    panel.columnconfigure(1, weight=0, minsize=title_width + 12)
                    panel.columnconfigure(2, weight=1)
                    description.grid_configure(row=0, column=2, columnspan=1, padx=(6, 12), pady=8)
                text_space = max(75, width - buttons.winfo_reqwidth() - 50)
                heading.configure(wraplength=text_space if compact else title_width)
                description.configure(wraplength=max(100, width - 50 if compact else
                                                       text_space - title_width - 30))
            card.bind("<Configure>", layout, add="+")
            self.template_rows.append((card, title, note, actions))
            for widget in (surface, card, title, note, kind):
                self._bind_home_wheel(widget)
        if not self.templates:
            tk.Label(self.home_content, text="Noch keine Vorlagen. Unten kannst du Vorlagen hinzufügen.",
                     bg=theme["bg"], fg=theme["muted"], anchor="w").pack(fill="x", pady=20)
        self.refresh_template_actions()
        self.home_content.update_idletasks()
        self._layout_home_canvas()
        self.home_canvas.yview_moveto(scroll_position)

    def library_entries(self):
        """Alle normalen Listen und Ordner in der Reihenfolge der Seitenleiste."""
        entries = [("list", entry) for entry in self.lists
                   if not entry.get("folder_id") and not self.is_inbox_list(entry)]

        def visit(parent_id):
            for folder in self.get_child_folders(parent_id):
                entries.append(("folder", folder))
                visit(folder["id"])
                entries.extend(("list", entry) for entry in self.get_folder_lists(folder["id"])
                               if not self.is_inbox_list(entry))

        visit(None)
        return entries

    def refresh_library_page(self):
        """Inhaltshohe Kacheln in unabhängig gestapelten, responsiven Spalten."""
        scroll_position = self.home_canvas.yview()[0] if getattr(self, "_home_rendered_view", None) == self.LIBRARY_VIEW else 0
        self._home_rendered_view = self.LIBRARY_VIEW
        for widget in self.home_content.winfo_children():
            widget.destroy()
        theme = self.theme
        for widget in (self.home_frame, self.home_canvas, self.home_content):
            widget.configure(bg=theme["bg"])
        self.home_scrollbar.set_theme(theme["bg"], theme["bg"], theme["input_border"], theme["muted"])
        entries = self.library_entries()
        list_count = sum(kind == "list" for kind, _entry in entries)
        self._set_stats_text(f"{list_count} Listen · {len(entries) - list_count} Ordner")
        grid = tk.Frame(self.home_content, bg=theme["bg"])
        grid.pack(fill="x")
        card_gap = 12
        card_padding = 16
        column_frames = [tk.Frame(grid, bg=theme["bg"]) for _ in range(3)]
        self.library_cards = []
        self.library_open_buttons = {}
        button_font = tkfont.Font(root=self.root, font=app_font(10, "bold"))

        def reveal_focused_button(event):
            canvas = self.home_canvas
            target = event.widget
            top = target.winfo_rooty() - canvas.winfo_rooty()
            bottom = top + target.winfo_height()
            viewport_height = canvas.winfo_height()
            offset = top - card_padding if top < card_padding else (
                bottom - viewport_height + card_padding if bottom > viewport_height - card_padding else 0)
            if offset:
                height = max(viewport_height, self.home_content.winfo_reqheight())
                canvas.yview_moveto(max(0, canvas.canvasy(0) + offset) / max(1, height))

        for kind, entry in entries:
            color = entry.get("color") or ("import" if kind == "folder" else "ui_accent")
            surface = self.make_rounded_container(grid, radius=self.HOME_CARD_RADIUS,
                width=1, inner_pad_x=card_padding, inner_pad_y=card_padding,
                auto_height=True, register=False)
            panel = surface.inner
            self.library_cards.append(surface)

            def label(text, size=10, bold=False, foreground="muted", pady=(0, 4)):
                widget = tk.Label(panel, text=text, anchor="w", justify="left",
                    bg=theme["card"], fg=theme[foreground], font=app_font(size, "bold" if bold else "normal"))
                widget.pack(fill="x", pady=pady)
                widget.bind("<Configure>", lambda event, target=widget: target.configure(wraplength=max(80, event.width - 4)))
                return widget

            label(f"{self.ICONS[kind]}  {entry.get('title') or ('Ordner' if kind == 'folder' else 'Liste')}",
                  11, True, color)
            parent_id = entry.get("parent_id" if kind == "folder" else "folder_id")
            if parent_id:
                label(" › ".join(self.folder_path_titles(parent_id)), 9)
            if kind == "folder":
                nested = {folder["id"] for folder in self.iter_folder_subtree(entry["id"])}
                lists = [value for value in self.lists if value.get("folder_id") in nested]
                items = [item for value in lists for item in value.get("items", [])]
                children = [("folder", value) for value in self.get_child_folders(entry["id"])]
                children += [("list", value) for value in self.get_folder_lists(entry["id"])]
                previews = [(self.ICONS[child_kind], " ".join(str(value.get("title") or "").split()), "")
                            for child_kind, value in children[:3]]
                remaining = max(0, len(children) - len(previews))
                summary = f"{len(lists)} Listen · {len(nested) - 1} Unterordner"
                command = lambda value=entry["id"]: self.set_active_folder(value)
            else:
                items = entry.get("items", [])
                tasks = [item for item in self.walk_items(items) if self.is_schedulable_item(item)]
                pending = [item for item in tasks if not item.get("done")]
                pending.sort(key=lambda item: (item.get("due") or "9999", -item.get("importance", 0)))
                previews = []
                for item in pending[:3]:
                    title_line = str(item.get("text") or "").splitlines()[0]
                    due = self.format_due_display(item.get("due")) if item.get("due") else ""
                    previews.append((self.ICONS["priority_high"] if item.get("importance", 0) >= 2 else self.ICONS["task_open"],
                                     title_line, due))
                remaining = max(0, len(pending) - len(previews))
                summary = ""
                command = lambda value=entry["id"]: self.set_active_list(value)
            total, done, _overdue = self.compute_stats(items)
            if summary:
                label(summary, 9)
            label(f"{total - done} offen   ·   {done} erledigt" + (f"   ·   {_overdue} überfällig" if _overdue else ""),
                  9, foreground="delete" if _overdue else "muted")
            progress = tk.Canvas(panel, height=4, bg=theme["line"], highlightthickness=0)
            progress.pack(fill="x", pady=(3, 10))
            def draw_progress(event, bar=progress, ratio=done / total if total else 0):
                bar.delete("all")
                if ratio:
                    bar.create_rectangle(0, 0, event.width * ratio, 4, fill=theme["confirm"], outline="")
            progress.bind("<Configure>", draw_progress)
            note = " ".join(str(entry.get("note") or "").split())
            if note:
                label(note[:100] + ("…" if len(note) > 100 else ""), 9)
            assigned = [(self.get_label(value) or {}).get("name", "") for value in entry.get("labels", [])]
            if assigned:
                label(" · ".join(assigned[:3]) + (f" +{len(assigned)-3}" if len(assigned) > 3 else ""),
                      8, foreground=color, pady=(0, 8))
            label("ENTHALTEN" if kind == "folder" else "NÄCHSTE AUFGABEN", 8, True, "muted", pady=(7, 5))
            if not previews:
                label("Noch keine Inhalte." if not total else "Alle Aufgaben erledigt.", 9, foreground="text")
            for marker, text, due in previews:
                text = " ".join(text.split())
                short = text[:76] + ("…" if len(text) > 76 else "")
                preview_row = label(f"{marker}  {short}" + (f"  ·  {due}" if due else ""),
                                    9, foreground="text", pady=(0, 6))
                self.add_tooltip(preview_row, text)
            if remaining:
                label(f"+ {remaining} weitere " + ("Einträge" if kind == "folder" else "offene Aufgaben"), 8)
            actions = ButtonFlow(panel, bg=theme["card"], gap=8)
            actions.pack(fill="x", pady=(8, 0))
            open_text = "Ordner öffnen" if kind == "folder" else "Liste öffnen"
            edit_text = "Ordner bearbeiten" if kind == "folder" else "Liste bearbeiten"
            button = self._make_dialog_button(actions, open_text, command, color,
                width=max(142, button_font.measure(open_text) + 28), height=34)
            actions.add(button)
            edit = self._make_dialog_button(actions, edit_text,
                lambda value=entry["id"], is_folder=kind == "folder":
                    self.edit_folder_details(value) if is_folder else self.edit_list_details(value),
                "accent", width=max(142, button_font.measure(edit_text) + 28), height=34)
            actions.add(edit)

            def layout_actions(event=None, flow=actions):
                flow.reflow(event)
                last_row = max(int(control.grid_info()["row"]) for control, _key in flow.entries)
                for control, _key in flow.entries:
                    row = int(control.grid_info()["row"])
                    # Den Rand übernimmt die Kachel; nur zwischen Buttonzeilen
                    # braucht es einen zusätzlichen Abstand.
                    control.grid_configure(pady=(0, 8 if row < last_row else 0))

            actions.bind("<Configure>", layout_actions)
            layout_actions()
            for control in (button, edit):
                control.bind("<FocusIn>", reveal_focused_button, add="+")
            self.library_open_buttons[(kind, entry["id"])] = button
            # Die ganze Vorschau öffnet den Inhalt; der explizite Button ist
            # zusätzlich per Tab und Enter erreichbar.
            for widget in (surface, panel, *panel.winfo_children()):
                self._bind_home_wheel(widget)
                if widget is not actions:
                    widget.configure(cursor="hand2")
                    widget.bind("<Button-1>", lambda _event, open_page=command: open_page())

        current_columns = None

        def layout(_event=None):
            nonlocal current_columns
            columns = max(1, min(3, (grid.winfo_width() + card_gap) // 352))
            if columns == current_columns:
                return
            current_columns = columns
            # Separate Abstandsspalten halten alle Karten gleich breit. Jeder
            # Stapel folgt seiner eigenen Inhaltshöhe, ohne gemeinsame Rasterzeilen.
            for position in range(5):
                active = position < columns * 2 - 1
                is_gap = position % 2 == 1
                grid.columnconfigure(position, weight=1 if active and not is_gap else 0,
                    minsize=card_gap if active and is_gap else 0,
                    uniform="library" if active and not is_gap else "")
            for column, frame in enumerate(column_frames):
                if column < columns:
                    frame.grid(row=0, column=column * 2, sticky="new")
                else:
                    frame.grid_remove()
            for surface in self.library_cards:
                surface.pack_forget()
            for index, surface in enumerate(self.library_cards):
                # Die zyklische Zuordnung bewahrt die Seitenleistenreihenfolge
                # und vermeidet Umsortieren bei nachträglichem Textumbruch.
                surface.pack(in_=column_frames[index % columns], fill="x",
                    pady=(0, card_gap if index + columns < len(self.library_cards) else 0))

        grid.bind("<Configure>", layout)
        layout()
        if not entries:
            grid.pack_forget()
            empty_hint = tk.Label(self.home_content, text="Noch keine Listen oder Ordner. Lege unten deine erste Liste an.",
                     bg=theme["bg"], fg=theme["muted"], anchor="w", justify="left",
                     wraplength=380)
            empty_hint.pack(fill="x", pady=16)
            empty_hint.bind("<Configure>", lambda event: empty_hint.configure(wraplength=max(1, event.width)))
            self._bind_home_wheel(empty_hint)
        self.refresh_page_actions((
            ("Neue Liste", self.create_new_list, "accent", 148),
            ("Neuer Ordner", self.create_new_folder, "import", 166),
            # Punkt 12 (3.24.0): Von hier aus ist die globale Pinnwand am
            # nächsten – die Übersicht zeigt denselben Bestand als Kacheln,
            # die Pinnwand zeigt ihn als frei anzuordnende Fläche.
            ("Globale Pinnwand", self.open_global_board, "confirm", 190),
            ("Liste importieren", self.import_txt_as_new_lists, "import", 222),
            ("Listen/Ordner hinzufügen …", self.import_partial_backup, "clear", 252),
        ))
        self._bind_home_wheel(grid)
        self._bind_home_wheel(self.home_canvas)
        self.home_content.update_idletasks()
        self._layout_home_canvas()
        self.home_canvas.yview_moveto(scroll_position)

    def refresh_template_actions(self):
        editing = bool(getattr(self, "_templates_editing", False))
        specs = (
            ("Vorlagen speichern" if editing else "Bearbeiten", self.toggle_template_editing, "accent", 186 if editing else 128),
            ("Vorlagen exportieren …", self.export_templates_file, "export", 222),
            ("Vorlagen hinzufügen …", self.import_templates_file, "import", 222),
            ("Listen/Ordner hinzufügen …", self.import_partial_backup, "clear", 252),
        )
        self.refresh_page_actions(specs)

    def refresh_page_actions(self, specs):
        """Zwei Aktionspaare auf denselben Zwischenflächen wie in den Listen."""
        for widget in self.template_actions.winfo_children():
            widget.destroy()
        self.template_actions.configure(bg=self.theme["bg"])
        self.template_action_groups = []
        for pair in (specs[:2], specs[2:]):
            required = sum(spec[3] for spec in pair) + 5
            group = self.make_rounded_container(
                self.template_actions, radius=16, padding=7, width=required + 14,
                auto_height=True, register=False,
            )
            buttons = [self._make_dialog_button(group.inner, text, command, color, width=width, height=38)
                       for text, command, color, width in pair]

            def layout_pair(width, panel=group.inner, pair_buttons=buttons, needed=required):
                stacked = width < needed
                panel.columnconfigure(0, weight=1)
                panel.columnconfigure(1, weight=0 if stacked else 1)
                for index, button in enumerate(pair_buttons):
                    button.grid(row=index if stacked else 0, column=0 if stacked else index,
                                sticky="ew", padx=(0, 5) if not stacked and index == 0 else 0,
                                pady=(0, 6) if stacked and index == 0 else 0)

            group.inner.bind("<Configure>", lambda event, arrange=layout_pair, panel=group.inner: arrange(panel.winfo_width()), add="+")
            layout_pair(required)
            self.template_action_groups.append(group)

        required_width = sum(int(group.cget("width")) for group in self.template_action_groups) + 12

        def layout_groups(width):
            stacked = width < required_width
            self.template_actions.columnconfigure(0, weight=1)
            self.template_actions.columnconfigure(1, weight=0 if stacked else 1)
            for index, group in enumerate(self.template_action_groups):
                group.grid(row=index if stacked else 0, column=0 if stacked else index,
                           sticky="ew", padx=(0, 12) if not stacked and index == 0 else 0,
                           pady=(0, 8) if stacked and index == 0 else 0)

        self.template_actions.bind("<Configure>", lambda event: layout_groups(self.template_actions.winfo_width()))
        layout_groups(self.template_actions.winfo_width())

    def add_tooltip(self, widget, text):
        """Erklärt kompakte Textsymbole auch beim Tastaturfokus."""
        state = {"after": None, "window": None, "text": ""}
        def hide(_event=None):
            if state["after"] is not None:
                widget.after_cancel(state["after"])
                state["after"] = None
            if state["window"] is not None:
                state["window"].destroy()
                state["window"] = None
        def show():
            state["after"] = None
            value = text() if callable(text) else text
            if not value:
                return
            state["text"] = value
            tip = tk.Toplevel(widget)
            state["window"] = tip
            tip.overrideredirect(True)
            tk.Label(tip, text=value, bg=self.theme["card"], fg=self.theme["text"],
                     relief="solid", bd=1, padx=8, pady=5, font=app_font(9)).pack()
            tip.update_idletasks()
            x = widget.winfo_pointerx()+14 if callable(text) else widget.winfo_rootx()
            y = widget.winfo_pointery()+18 if callable(text) else widget.winfo_rooty()+widget.winfo_height()+3
            tip.geometry(f"+{min(x, widget.winfo_screenwidth()-tip.winfo_reqwidth()-8)}+{min(y, widget.winfo_screenheight()-tip.winfo_reqheight()-8)}")
        def schedule(_event=None):
            hide()
            state["after"] = widget.after(500, show)
        for event in ("<Enter>", "<FocusIn>"):
            widget.bind(event, schedule, add="+")
        if callable(text):
            widget.bind("<Motion>", lambda _event: schedule() if text() != state["text"] else None, add="+")
        for event in ("<Leave>", "<FocusOut>", "<ButtonPress-1>", "<Destroy>"):
            widget.bind(event, hide, add="+")

    def toggle_template_editing(self):
        if getattr(self, "_templates_editing", False):
            if not self.save_templates():
                self.show_error("Vorlagen speichern", "Die Vorlagen konnten nicht gespeichert werden.")
                return
            self._templates_editing = False
        else:
            self._templates_before_edit = copy.deepcopy(self.templates)
            self._templates_editing = True
        self.refresh_tree()

    def edit_template(self, template_id):
        if not getattr(self, "_templates_editing", False):
            return
        template = self.template_by_id(template_id)
        if not template:
            return
        try:
            with TemplateDraft(self, template) as draft:
                updated = draft.edit()
            if updated is not None:
                index = self.templates.index(template)
                self.templates[index] = updated
                self.refresh_tree()
        except (OSError, ValueError, TypeError, KeyError) as exc:
            self.show_error("Vorlage bearbeiten", str(exc))

    def delete_template(self, template_id):
        if not getattr(self, "_templates_editing", False):
            return
        if self.ask_yes_no("Vorlage löschen", "Diese Vorlage wirklich löschen?"):
            self.templates = [item for item in self.templates if item["id"] != template_id]
            self.refresh_tree()

    def capture_template(self, list_id=None, folder_id=None):
        holder = self.get_folder(folder_id) if folder_id else next(
            (entry for entry in self.lists if entry["id"] == list_id), None)
        if holder is None:
            return None
        payload = self.partial_backup_payload([list_id] if list_id else [], [folder_id] if folder_id else [])
        files = {}
        for storage, path in self.collect_attachment_sources(payload["lists"], folders=payload.get("folders")).items():
            with open(path, "rb") as file:
                raw = file.read(self.MAX_BACKUP_ATTACHMENT_BYTES + 1)
            if len(raw) > self.MAX_BACKUP_ATTACHMENT_BYTES:
                raise ValueError("Ein Anhang ist für die Vorlage zu groß.")
            files[storage] = base64.b64encode(raw).decode("ascii")
        template = {"id": uuid.uuid4().hex, "kind": "folder" if folder_id else "list",
                    "title": holder.get("title") or "Vorlage", "note": holder.get("note") or "",
                    "color": holder.get("color"), "labels": list(holder.get("labels", [])),
                    "items": [], "payload": payload, "files": files}
        self.templates.append(template)
        if not getattr(self, "_templates_editing", False) and not self.save_templates():
            self.templates.remove(template)
            raise OSError("Die Vorlage konnte nicht gespeichert werden.")
        return template

    def template_from_current_list(self):
        return self.capture_template(list_id=self.active_list_id)

    def save_list_as_template(self, list_id=None):
        try:
            template = self.capture_template(list_id=list_id or self.active_list_id)
            if template:
                self.show_info("Vorlage gespeichert", f"„{template['title']}“ steht jetzt unter Vorlagen bereit.")
            return template
        except (OSError, ValueError) as exc:
            self.show_error("Vorlage", str(exc))

    def save_folder_as_template(self, folder_id):
        try:
            template = self.capture_template(folder_id=folder_id)
            if template:
                self.show_info("Vorlage gespeichert", f"„{template['title']}“ steht jetzt unter Vorlagen bereit.")
            return template
        except (OSError, ValueError) as exc:
