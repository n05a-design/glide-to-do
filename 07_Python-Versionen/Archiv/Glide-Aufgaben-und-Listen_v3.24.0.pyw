    # ------------------------------------------------------------------
    # Punkte 28 bis 31 (3.23.0): Was bei schmalem Fenster zuerst weicht.
    #
    # Die Regel stand schon fest: Essentielles bleibt, Sekundäres geht zuerst.
    # Bis 3.22 war sie nirgends umgesetzt – stattdessen schrumpfte der Titel
    # als Einziges, weil er als Letztes um den Platz bat. Am schmalen Rand
    # stand deshalb ein „…“ neben vier vollständig beschrifteten Knöpfen.
    #
    # Drei Stufen, an der Breite des Kopfbereichs gemessen. Die Schwellen sind
    # keine Gerätebreiten, sondern die Summe dessen, was in der jeweiligen
    # Stufe nebeneinanderpassen muss.
    HEADER_DENSITY_FULL = 1120      # alles mit Beschriftung
    HEADER_DENSITY_COMPACT = 900    # Benachrichtigungen nur als Zahl
    # Darunter: Drucken und Einstellungen wandern ins Überlaufmenü.
    # Gemessen wird die Breite der Aktionsreihe selbst, nicht die des
    # Fensters: Sie steht rechts neben der Seitenleiste und ist deshalb je
    # nach deren Zustand unterschiedlich breit. Drei Paare brauchen rund
    # 3 × 220 Pixel plus zweimal 12 Pixel Abstand; darunter beginnen die
    # Beschriftungen zu drängen.
    ACTION_DENSITY_MIN_WIDTH = 700

    def header_density(self, width=None):
        """Welche Stufe der Kopfzeile zur aktuellen Breite passt."""
        if width is None:
            kopf = getattr(self, "header_frame", None)
            width = kopf.winfo_width() if kopf is not None else 0
        if width <= 1:
            return "full"
        if width >= self.HEADER_DENSITY_FULL:
            return "full"
        if width >= self.HEADER_DENSITY_COMPACT:
            return "compact"
        return "minimal"

    def sync_header_density(self, event=None):
        """Blendet sekundäre Bedienelemente nach der verfügbaren Breite aus."""
        if not hasattr(self, "header_controls"):
            return
        stufe = self.header_density(event.width if event is not None else None)
        if stufe == getattr(self, "_header_density", None):
            return
        self._header_density = stufe
        # Die Zahl offener Hinweise ist die eigentliche Information; das Wort
        # „Benachrichtigungen“ ist nur ihre Überschrift.
        self.apply_reminder_badge()
        # Punkt 3 (3.24.0): Das Zahnrad ist die äußerste Schaltfläche der
        # Kopfzeile und steht damit auf derselben rechten Flucht wie
        # „Hinzufügen" und „Anzeige" darunter – also ohne rechten Abstand.
        # Bis 3.23 packte diese Stelle es mit `padx=(0, 8)` neu, sobald die
        # Dichtestufe einmal wechselte; danach stand es acht Pixel vor der
        # Flucht, ohne dass am Aufbau etwas zu sehen gewesen wäre.
        for widget, sichtbar, rand in (
            (getattr(self, "print_button", None), stufe != "minimal", (0, 8)),
            (getattr(self, "settings_button", None), stufe != "minimal", (0, 0)),
        ):
            if widget is None:
                continue
            try:
                if sichtbar:
                    widget.pack(side="right", padx=rand)
                else:
                    widget.pack_forget()
            except tk.TclError:
                pass
        ueberlauf = getattr(self, "header_overflow_button", None)
        if ueberlauf is not None:
            try:
                if stufe == "minimal":
                    # Im Minimalzustand steht der Überlauf ganz außen und
                    # übernimmt deshalb die rechte Flucht des Zahnrads.
                    ueberlauf.pack(side="right", padx=(0, 0))
                else:
                    ueberlauf.pack_forget()
            except tk.TclError:
                pass
        self.sync_action_density()
        self.update_header_title()

    def show_header_overflow_menu(self, event=None):
        """Die bei schmalem Fenster ausgeblendeten Aktionen als Menü."""
        menu = self._new_themed_popup_menu()
        menu.add_command(label="Drucken und PDF …", command=self.show_print_dialog)
        menu.add_command(label="Einstellungen …", command=self.show_settings_dialog)
        menu.add_separator()
        menu.add_command(label="Liste leeren", command=self.clear_list)
        menu.add_command(label="Löschen", command=self.delete_item)
        menu.add_command(label="Bearbeiten", command=self.edit_item)
        menu.add_command(label="Rückgängig", command=self.undo_last_change)
        menu.add_separator()
        menu.add_command(label="Alle Aktionen durchsuchen …", command=self.show_actions_dialog)
        knopf = getattr(self, "header_overflow_button", None)
        try:
            if knopf is not None and knopf.winfo_ismapped():
                menu.tk_popup(knopf.winfo_rootx(), knopf.winfo_rooty() + knopf.winfo_height())
            else:
                menu.tk_popup(self.root.winfo_pointerx(), self.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def sync_action_density(self, event=None):
        """Punkt 29: Sekundäre Aktionspaare weichen zuerst.

        „Liste leeren", „Löschen", „Bearbeiten" und „Rückgängig" sind die vier
        Schaltflächen, die der Alltag am seltensten braucht und die alle vier
        über Kontextmenü, Menüleiste und Tastenkürzel erreichbar bleiben. Sie
        geben ihren Platz an die Paare ab, die keinen zweiten Weg haben.
        """
        rahmen = getattr(self, "button_frame", None)
        zusatz = getattr(self, "utility_frame", None)
        if rahmen is None or zusatz is None:
            return
        try:
            breite = rahmen.winfo_width()
        except tk.TclError:
            return
        if breite <= 1:
            return
        schmal = breite < self.ACTION_DENSITY_MIN_WIDTH
        if schmal == getattr(self, "_action_density_narrow", None):
            return
        self._action_density_narrow = schmal
        for gruppe, spalte, eltern in ((getattr(self, "_group_cleardel", None), 0, rahmen),
                                       (getattr(self, "_group_edit", None), 0, zusatz)):
            if gruppe is None:
                continue
            try:
                if schmal:
                    gruppe.grid_remove()
                else:
                    gruppe.grid()
            except tk.TclError:
                pass
        # Die verbleibenden Paare teilen sich den frei gewordenen Platz.
        for eltern in (rahmen, zusatz):
            try:
                eltern.columnconfigure(0, weight=0 if schmal else 1)
            except tk.TclError:
                pass

    def update_header_title(self, event=None):
        """Zeigt den Seitentitel und kürzt ihn nur, wenn der Platz nicht reicht.

        Gespeicherter Titel, Fenstertitel und alle Exporte bleiben vollständig.
        """
        label = getattr(self, "title_label", None)
        header = getattr(self, "header_frame", None)
        if label is None or header is None:
            return
        full_title = self.get_display_title()
        try:
            available = header.winfo_width()
            if available <= 1:
                label.configure(text=full_title)
                return
            for widget, gap in (
                (getattr(self, "header_meta", None), 16),
                (getattr(self, "header_controls", None), 12),
            ):
                if widget is not None:
                    available -= widget.winfo_reqwidth() + gap
            available = max(self.HEADER_TITLE_MIN_WIDTH, available)
            font = getattr(self, "_header_title_measure_font", None)
            if font is None:
                font = tkfont.Font(root=self.root, font=label.cget("font"))
                self._header_title_measure_font = font
            text = full_title
            if font.measure(text) > available:
                ellipsis = "…"
                while text and font.measure(text + ellipsis) > available:
                    text = text[:-1]
                text = (text.rstrip() + ellipsis) if text else ellipsis
            if label.cget("text") != text:
                label.configure(text=text)
        except tk.TclError:
            pass

    def apply_theme(self):
        self.theme = self.active_theme()
        self.root.configure(bg=self.theme["bg"])

        for widget, bg_key, fg_key in self.theme_widgets:
            try:
                config = {"bg": self.theme[bg_key]}
                if fg_key is not None:
                    config["fg"] = self.theme[fg_key]
                widget.configure(**config)
            except tk.TclError:
                pass

        self.entry.configure(
            bg=self.theme["input"],
            fg=self.theme["placeholder"] if getattr(self, "entry_placeholder_active", False) else self.theme["text"],
            insertbackground=self.theme["text"],
            highlightthickness=0,
            highlightbackground=self.theme["input"],
            highlightcolor=self.theme["input"],
            relief="flat",
            bd=0,
            borderwidth=0,
        )
        if hasattr(self, "search_entry"):
            self.search_entry.configure(
                bg=self.theme["input"],
                fg=self.theme["placeholder"] if getattr(self, "search_placeholder_active", False) else self.theme["text"],
                insertbackground=self.theme["text"],
                highlightthickness=0,
                highlightbackground=self.theme["input"],
                highlightcolor=self.theme["input"],
                relief="flat",
                bd=0,
                borderwidth=0,
            )
        check = getattr(self, "hide_done_check", None)
        if check is not None:
            check.configure(
                bg=self.theme["input"],
                fg=self.theme["text"],
                activebackground=self.theme["input"],
                activeforeground=self.theme["text"],
                selectcolor=self.theme["input"],
            )
        if hasattr(self, "scrollbar"):
            self.scrollbar.set_theme(
                bg_color=self.theme["card"],
                track_color=self.theme["card"],
                thumb_color=self.theme["input_border"],
                active_thumb_color=self.theme["muted"],
            )
        if hasattr(self, "sidebar_listbox"):
            for style_name, surface_key in (("Sidebar.Treeview", "card"), ("System.Treeview", "card")):
                self.style.configure(
                    style_name,
                    background=self.theme[surface_key],
                    fieldbackground=self.theme[surface_key],
                    foreground=self.theme["text"],
                    borderwidth=0,
