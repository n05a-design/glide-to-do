    def open_inbox_list(self, event=None):
        """Öffnet den Eingang als Liste.

        Punkt 1 (3.24.0): Der Eingang steht seit 3.24 nicht mehr in der
        Seitenleiste. Damit er trotzdem ein Ziel bleibt, das man benennen und
