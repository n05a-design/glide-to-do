    def render_editor(self, selected=None):
        tree = self.editor_tree
        selected = selected or (tree.selection()[0] if tree.selection() else self.holder["id"])
        expanded = {key: tree.item(key, "open") for key in getattr(self, "nodes", {}) if tree.exists(key)}
        tree.delete(*tree.get_children())
        self.nodes = {}
        def insert(kind, obj, parent="", siblings=None):
            identity = obj["id"]
            self.nodes[identity] = (kind, obj, siblings)
            label_names = ", ".join((self.get_label(value) or {}).get("name", "") for value in obj.get("labels", []))
            due = self.format_due_full(obj.get("due"), obj.get("due_time"))
            art = self.ITEM_KIND_NAMES[self.item_kind(obj)] if kind == "item" else "Liste" if kind == "list" else "Ordner"
            text = " ".join(str(obj.get("text" if kind == "item" else "title") or "").split())
            if kind == "item":
                item_kind = self.item_kind(obj)
                prefix = self.ICONS["group"] if item_kind == self.ITEM_KIND_GROUP else ""
                color = obj.get("color") or "text"
                tags = (item_kind, "color_" + color)
            else:
                prefix = self.ICONS[kind]
                color = obj.get("color") or ("import" if kind == "folder" else "ui_accent")
                tags = ("container", "color_" + color)
            tree.insert(parent, "end", iid=identity, text=f"{prefix}  {text}" if prefix else text,
                        values=(art, label_names, due), open=expanded.get(identity, True), tags=tags)
            if kind == "folder":
                for child in self.get_child_folders(identity):
                    insert("folder", child, identity, self.folders)
                for child in self.get_folder_lists(identity):
                    insert("list", child, identity, self.lists)
            else:
                children = obj.get("items" if kind == "list" else "children", [])
                for child in children:
                    insert("item", child, identity, children)
        insert(self.record["kind"], self.holder)
        if tree.exists(selected):
            tree.selection_set(selected)
            tree.focus(selected)
            tree.see(selected)
        labels = ", ".join((self.get_label(value) or {}).get("name", "") for value in self.holder.get("labels", [])) or "Keine Labels"
        color = next((name for name, key in self.LIST_COLOR_CHOICES if key == self.holder.get("color")), "Keine Farbe")
        note = " ".join(str(self.holder.get("note") or "Keine Beschreibung").split())
        self.summary_var.set(f"{color} · {labels} · {len(self.holder.get('attachments', []))} Anhänge\n{note[:180]}")
        counts = [f"{sum(kind == key for kind, _obj, _siblings in self.nodes.values())} {name}"
                  for key, name in (("folder", "Ordner"), ("list", "Listen"), ("item", "Punkte"))]
        self.structure_var.set("Aufbau der Vorlage · " + " · ".join(counts))
        self.resize_editor_columns()

    def resize_editor_columns(self, _event=None):
        tree = self.editor_tree
        width = tree.winfo_width()
        if width < 100:
            return
        font = tkfont.Font(font=self.tree_font())
        due_values = [tree.set(key, "due") for key in getattr(self, "nodes", {})]
        due_width = max((font.measure(value) + 20 for value in due_values if value), default=0)
        has_labels = any(tree.set(key, "labels") for key in getattr(self, "nodes", {}))
        tree.column("kind", width=font.measure("Long-Task") + 24 if width >= 900 else 0)
        tree.column("due", width=due_width)
        tree.column("labels", width=max(120, min(220, int(width * .23))) if has_labels else 0)

    def edit_from_pointer(self, event):
        tree = self.editor_tree
        identity = tree.identify_row(event.y)
        if identity and "indicator" not in tree.identify_element(event.x, event.y):
            tree.selection_set(identity)
            tree.focus(identity)
            return self.edit_selected()

    def selection(self):
        selected = self.editor_tree.selection()
        return self.nodes.get(selected[0]) if selected else None

    def edit_holder(self):
        self.holder["title"] = self.title_var.get().strip() or self.holder["title"]
        self.edit_object(self.record["kind"], self.holder)
        self.title_var.set(self.holder["title"])

    def edit_object(self, kind, obj):
        if kind == "item":
            details = self.themed_item_details_dialog(obj)
            if details:
                self.apply_item_details(obj, details)
        else:
            details = self.themed_page_details_dialog("Vorlagendetails" if obj is self.holder else "Listendetails" if kind == "list" else "Ordnerdetails",
                obj.get("title"), obj.get("note"), page=obj)
            if details:
                obj.update(details)
        self.render_editor(obj["id"])

    def edit_selected(self):
        selection = self.selection()
        if selection:
            kind, obj, _siblings = selection
            if obj is self.holder:
                self.edit_holder()
            else:
                self.edit_object(kind, obj)
        return "break"

    def add_node(self, kind):
        selected = self.selection()
        if selected is None:
            return
        selected_kind, obj, siblings = selected
        if kind in ("list", "folder"):
            parent_id = obj["id"] if selected_kind == "folder" else obj.get("folder_id")
            if selected_kind == "item":
                current = self.editor_tree.parent(obj["id"])
                while current and self.nodes[current][0] == "item":
                    current = self.editor_tree.parent(current)
                parent_id = self.nodes[current][1].get("folder_id") if current else self.holder["id"]
            if kind == "folder" and self.folder_depth(parent_id) + 1 >= self.MAX_FOLDER_DEPTH:
                self.show_warning("Ordner", "Die maximale Ordnertiefe ist erreicht.", parent=self.dialog)
                return
            new = self.new_list_object("Neue Liste", [], folder_id=parent_id) if kind == "list" else self.new_folder_object("Neuer Ordner", parent_id=parent_id)
            details = self.themed_page_details_dialog("Neue Liste" if kind == "list" else "Neuer Ordner", new["title"], "", page=new)
            if not details:
                return
            new.update(details)
            (self.lists if kind == "list" else self.folders).append(new)
        else:
            if selected_kind == "folder":
                self.show_info("Punkt hinzufügen", "Wähle zuerst eine Liste oder lege eine Liste im Ordner an.", parent=self.dialog)
                return
            target = obj["items"] if selected_kind == "list" else obj.setdefault("children", []) if kind == "child" else siblings
            if target is None:
                return
            depth = 0
            parent = obj["id"] if kind == "child" and selected_kind == "item" else self.editor_tree.parent(obj["id"]) if selected_kind == "item" else ""
            while parent and self.nodes[parent][0] == "item":
                depth += 1
                parent = self.editor_tree.parent(parent)
            if depth > self.MAX_ITEM_DEPTH:
                self.show_warning("Unterpunkt", "Die maximale Punkttiefe ist erreicht.", parent=self.dialog)
                return
            details = self.new_item_dialog(title="Neuer Vorlagenpunkt")
            if not details:
                return
            new = self.build_item_from_dialog(details)
            target.append(new)
        self.render_editor(new["id"])

    def move_selected(self, direction):
        selection = self.selection()
        if not selection or selection[2] is None:
            return
        kind, obj, siblings = selection
        parent_key = "parent_id" if kind == "folder" else "folder_id"
        peers = [value for value in siblings if kind == "item" or value.get(parent_key) == obj.get(parent_key)]
        index = peers.index(obj) + direction
        if 0 <= index < len(peers):
            first, second = siblings.index(obj), siblings.index(peers[index])
            siblings[first], siblings[second] = siblings[second], siblings[first]
            self.render_editor(obj["id"])

    def remove_selected(self):
        selection = self.selection()
        if not selection or selection[1] is self.holder:
            return
        kind, obj, siblings = selection
        if not self.ask_yes_no("Eintrag entfernen", "Diesen Eintrag einschließlich seiner Unterpunkte aus der Vorlage entfernen?", parent=self.dialog):
            return
        if kind == "folder":
            identities = {value["id"] for value in self.iter_folder_subtree(obj["id"])}
            self.folders[:] = [value for value in self.folders if value["id"] not in identities]
            self.lists[:] = [value for value in self.lists if value.get("folder_id") not in identities]
        else:
            siblings.remove(obj)
        self.render_editor(self.holder["id"])

    def submit(self):
        title = self.title_var.get().strip()
        if not title:
            self.show_warning("Vorlage", "Bitte einen Titel eingeben.", parent=self.dialog)
            return "break"
        self.holder["title"] = title[:120]
        if self.relative_var.get():
            self.record["schedule_anchor"] = self.relative_anchor
        else:
            self.record.pop("schedule_anchor", None)
        try:
            self.result = self.export_record()
        except (OSError, ValueError) as exc:
            self.show_error("Vorlage übernehmen", str(exc), parent=self.dialog)
            return "break"
        self.dialog.destroy()
        return "break"


