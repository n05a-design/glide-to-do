    # Referenz ------------------------------------------------------------------
    def drawing_load_reference(self, editor):
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        path = filedialog.askopenfilename(
            parent=self.root, title="Referenzbild wählen",
            filetypes=[("Bilder", glide_image_preview.FILE_PATTERN), ("Alle Dateien", "*.*")])
        if not path:
            return
        try:
            # Seit 29.09.2026 auch JPEG, SVG und weitere Formate (R10): Glide
            # wandelt sie zuerst in ein PNG und arbeitet dann wie bisher.
            path = self.reference_png_path(path)
            source = self.read_reference_png(path)
        except (OSError, tk.TclError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("PNG-Referenz", f"Das Bild kann nicht verwendet werden:\n{exc}")
            return
        choice = self.drawing_reference_frame_dialog(source, os.path.basename(path), None,
                                                     replaces_existing=any(editor.model.cells),
                                                     size=editor.model.width)
        if choice is None:
            return
        try:
            stored = self.store_attachment(path)
        except OSError as exc:
            self.show_error("PNG-Referenz", f"Das Bild konnte nicht als Anhang gespeichert werden:\n{exc}")
            return
        stored["mime"] = "image/png"
        self._apply_reference_choice(editor, entry, choice, stored)

    def drawing_reframe_reference(self, editor, trace=False):
        entry = self.drawing_entry(editor)
        reference = entry.get("drawing_reference") if entry else None
        if not isinstance(reference, dict):
            return
        attachment = next((item for item in entry.get("attachments", [])
                           if item.get("id") == reference.get("attachment_id")), None)
        path = self.resolve_attachment_path(attachment) if attachment else None
        try:
            if not path or not os.path.isfile(path):
                raise OSError("Die Referenzdatei fehlt auf diesem Gerät. Bitte die Referenz neu laden.")
            source = self.read_reference_png(path)
        except (OSError, tk.TclError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("PNG-Referenz", str(exc))
            return
        choice = self.drawing_reference_frame_dialog(source, attachment.get("name", "PNG"), reference,
                                                     replaces_existing=any(editor.model.cells),
                                                     start_trace=trace, size=editor.model.width)
        if choice is not None:
            self._apply_reference_choice(editor, entry, choice, None)

    def _apply_reference_choice(self, editor, entry, choice, new_attachment):
        previous_document = copy.deepcopy(entry.get("drawing"))
        old_reference = entry.get("drawing_reference") if isinstance(entry.get("drawing_reference"), dict) else None

        def mutate():
            attachment_id = old_reference.get("attachment_id") if old_reference else None
            if new_attachment is not None:
                if old_reference:
                    # Die alte Referenz verlässt die Seite; die Datei bleibt bis
                    # zu einem Rückgängig unangetastet.
                    entry["attachments"] = [item for item in entry.get("attachments", [])
                                            if item.get("id") != attachment_id]
                entry.setdefault("attachments", []).append(new_attachment)
                attachment_id = new_attachment["id"]
            entry["drawing_reference"] = self.normalize_drawing_reference(
                dict(choice["frame"], attachment_id=attachment_id), entry.get("attachments"))
            if choice.get("trace_model") is not None:
                entry["drawing"] = choice["trace_model"].to_document()
            return True

        if not self.apply_drawing_change(entry, mutate):
            return
        editor = self.current_drawing_editor() or editor
        if choice.get("trace_model") is not None:
            editor.trace_backup = previous_document
            editor.reference_visible = False
            editor.remember_view()
            editor.render_full()
            editor.update_status("Nachgezeichnet · Vorher-Stand: „Mehr“ → „Nachzeichnung zurücksetzen“ "
                                 "oder Rückgängig")
        else:
            editor.reference_visible = True
            editor.render_full()
            editor.update_status("Referenz geladen · die Zeichnung ist unverändert")

    def drawing_remove_reference(self, editor):
        entry = self.drawing_entry(editor)
        reference = entry.get("drawing_reference") if entry else None
        if not isinstance(reference, dict):
            return

        def mutate():
            entry["attachments"] = [item for item in entry.get("attachments", [])
                                    if item.get("id") != reference.get("attachment_id")]
            entry["drawing_reference"] = None
            return True

        if self.apply_drawing_change(entry, mutate):
            current = self.current_drawing_editor()
            if current is not None:
                current.update_status("Referenz entfernt · die Zeichnung ist unverändert")

    def drawing_reset_trace(self, editor):
        entry = self.drawing_entry(editor)
        backup = editor.trace_backup
        if entry is None or backup is None:
            return
        if not self.ask_yes_no("Nachzeichnung zurücksetzen",
                               "Die Zeichnung erhält wieder ihren Stand vor der Nachzeichnung. "
                               "Spätere Striche gehen dabei verloren. Fortfahren?"):
            return

        def mutate():
            entry["drawing"] = self.normalize_drawing_document(backup, entry.get("title", ""))
            return True

        if self.apply_drawing_change(entry, mutate):
            current = self.current_drawing_editor()
            if current is not None:
                current.trace_backup = None
                current.remember_view()
                current.update_status("Stand vor der Nachzeichnung wiederhergestellt")

    def drawing_clear(self, editor):
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        if not self.ask_yes_no("Zeichnung leeren",
                               "Alle Zellen werden weiß. Rückgängig stellt den vorherigen Stand wieder her."):
            return

        def mutate():
            size = glide_drawing.DrawingModel.from_document(entry.get("drawing")).width
            blank = glide_drawing.DrawingModel.blank(size).to_document()
            if entry.get("drawing") == blank:
                return False
            entry["drawing"] = blank
            return True

        self.apply_drawing_change(entry, mutate)

    # Austausch -----------------------------------------------------------------
    def read_drawing_file(self, path):
        """JSON oder Glide-SVG lesen; liefert (Modell, Warnungen)."""
        with open(path, "rb") as source:
            content = source.read(glide_drawing.MAX_SVG_BYTES + 1)
        if path.lower().endswith(".svg"):
            imported = glide_drawing.import_glide_svg(content)
            return imported.model, list(imported.warnings)
        if len(content) > glide_drawing.MAX_JSON_BYTES:
            raise glide_drawing.DrawingFormatError("Zeichnungsdaten überschreiten 512 KiB")
        return glide_drawing.DrawingModel.from_json(content), []

    def drawing_export(self, editor, fmt):
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        editor.flush()
        title = str(entry.get("title") or "Zeichnung")
        stem = re.sub(r"[^\w .()-]+", "_", title, flags=re.UNICODE).strip(" .")[:80] or "Zeichnung"
        extension = ".svg" if fmt == "svg" else ".json"
        path = filedialog.asksaveasfilename(
            parent=self.root, title="Glide-SVG exportieren" if fmt == "svg" else "Zeichnung als JSON exportieren",
            defaultextension=extension, initialfile=stem + extension,
            filetypes=[("SVG", "*.svg")] if fmt == "svg" else [("JSON", "*.json")])
        if not path:
            return
        model = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
        text = model.to_svg(title) if fmt == "svg" else model.to_json() + "\n"
        try:
            self.write_text_atomic(path, text)
        except (OSError, ValueError) as exc:
            self.show_error("Zeichnung exportieren", str(exc))
            return
        editor.update_status(f"Exportiert: {os.path.basename(path)}")

    def write_text_atomic(self, path, text):
        """Exporttext atomar schreiben; Nutzdatendateien sind als Ziel ausgeschlossen."""
        target = os.path.abspath(path)
        self.validate_backup_target(target)
        directory = os.path.dirname(target)
        os.makedirs(directory, exist_ok=True)
        handle, temporary = tempfile.mkstemp(prefix=".glide-export-", suffix=".tmp", dir=directory)
        try:
            with os.fdopen(handle, "w", encoding="utf-8", newline="\n") as file:
                file.write(text)
                file.flush()
                os.fsync(file.fileno())
            os.replace(temporary, target)
            temporary = None
        finally:
            if temporary:
                try:
                    os.remove(temporary)
                except OSError:
                    pass
        return target

    def ask_drawing_file(self, title):
        return filedialog.askopenfilename(
            parent=self.root, title=title,
            filetypes=[("Glide-Zeichnung", "*.svg *.json"), ("SVG", "*.svg"), ("JSON", "*.json")])

    def drawing_import_replace(self, editor):
        """Datei wählen, Vorschau zeigen, dann neu anlegen oder diese Zeichnung ersetzen."""
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        path = self.ask_drawing_file("Zeichnung importieren")
        if not path:
            return
        try:
            model, warnings = self.read_drawing_file(path)
        except (OSError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("Zeichnung importieren", f"Die Datei wurde nicht übernommen; der Bestand "
                                                      f"ist unverändert.\n\n{exc}")
            return
        choice = self.drawing_import_preview_dialog(model, os.path.basename(path), warnings, allow_replace=True,
                                                    current_title=str(entry.get("title", "Zeichnung")))
        if choice == "new":
            title = os.path.splitext(os.path.basename(path))[0].replace("_", " ").strip()[:80] or "Zeichnung"
            self.create_drawing_from_model(model, title, entry.get("folder_id"))
            return
        if choice != "replace":
            return

        def mutate():
            entry["drawing"] = model.to_document()
            return True

        self.apply_drawing_change(entry, mutate)

    def import_drawing_as_new(self, event=None):
        """Standardweg: Eine Datei wird nach Vorschau als neue Zeichnungsseite angelegt."""
        self.flush_rich_note()
        path = self.ask_drawing_file("Zeichnung importieren")
        if not path:
            return "break"
        try:
            model, warnings = self.read_drawing_file(path)
        except (OSError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("Zeichnung importieren", f"Die Datei wurde nicht übernommen; der Bestand "
                                                      f"ist unverändert.\n\n{exc}")
            return "break"
        if self.drawing_import_preview_dialog(model, os.path.basename(path), warnings) != "new":
            return "break"
        title = os.path.splitext(os.path.basename(path))[0].replace("_", " ").strip()[:80] or "Zeichnung"
        if self.view_mode == "folder" and self.get_folder(self.active_folder_id):
            folder_id = self.active_folder_id
        else:
            current = self.current_list() if self.view_mode == "list" else None
            folder_id = current.get("folder_id") if current else None
        self.create_drawing_from_model(model, title, folder_id)
        return "break"

    # Dialoge -------------------------------------------------------------------
    def _drawing_dialog(self, title, parent=None):
        dialog = tk.Toplevel(parent or self.root)
        dialog.title(title)
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(parent or self.root)
        dialog.resizable(False, False)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(body, text=title, bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(15, "bold"), anchor="w").pack(anchor="w", pady=(0, 6))
        return dialog, body

    def _drawing_scale(self, parent, label, variable, start, end, unit, command):
        row = tk.Frame(parent, bg=self.theme["bg"])
        row.pack(fill="x", pady=(4, 0))
        tk.Label(row, text=label, width=11, anchor="w", bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(10)).pack(side="left")
        scale = tk.Scale(row, from_=start, to=end, resolution=1, orient="horizontal", showvalue=False,
                         length=300, variable=variable, command=lambda _value: command(),
                         bg=self.theme["selection"], fg=self.theme["text"],
                         troughcolor=self.theme["input_border"], width=12, sliderlength=22,
                         highlightthickness=0, bd=0, sliderrelief="flat",
                         activebackground=self.theme["selection"])
        scale.pack(side="left", fill="x", expand=True)
        value_label = tk.Label(row, width=10, anchor="e", bg=self.theme["bg"], fg=self.theme["muted"],
                               font=app_font(10))
        value_label.pack(side="left")

        def show(*_args):
            try:
                value_label.configure(text=f"{float(variable.get()):.0f}{unit}")
            except (tk.TclError, ValueError):
                pass
        variable.trace_add("write", show)
        show()
        return scale

    def drawing_reference_frame_dialog(self, source, name, frame, replaces_existing=False, start_trace=False,
                                       size=glide_drawing.WIDTH):
        """PNG auf die Fläche der Zeichnung legen; danach Referenz oder Nachzeichnung wählen.

        Rückgabe: {"frame": …, "trace_model": DrawingModel oder None} oder None.
        """
        frame = frame or {}
        zoom_preview = max(1, 384 // size)
        result = {"value": None}
        dialog, body = self._drawing_dialog(f"PNG auf {size} × {size} einpassen")
        tk.Label(body, text=f"{name} · {source.width()} × {source.height()} Pixel",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10), anchor="w").pack(anchor="w")
        preview = tk.Canvas(body, width=size * zoom_preview, height=size * zoom_preview, bg="#FFFFFF",
                            highlightthickness=1, highlightbackground=self.theme["line"])
        preview.pack(pady=(8, 8))
        mode = tk.StringVar(value=frame.get("mode", "fill"))
        zoom = tk.DoubleVar(value=frame.get("zoom_percent", 100))
        offset_x = tk.DoubleVar(value=frame.get("offset_x", 0))
        offset_y = tk.DoubleVar(value=frame.get("offset_y", 0))
        state = {"job": None, "image": None}

        def current_frame():
            return {"mode": mode.get(), "zoom_percent": int(round(zoom.get())),
                    "offset_x": int(round(offset_x.get())), "offset_y": int(round(offset_y.get()))}

        def render():
            state["job"] = None
            values = current_frame()
            framed = glide_drawing_image.render_framed_reference(
                source, values["mode"], values["zoom_percent"], values["offset_x"], values["offset_y"],
                size=size)
            state["image"] = framed.zoom(zoom_preview, zoom_preview)
            preview.delete("all")
            preview.create_image(0, 0, image=state["image"], anchor="nw")

        def schedule():
            if state["job"] is not None:
                dialog.after_cancel(state["job"])
            state["job"] = dialog.after(40, render)

        modes = ButtonFlow(body, self.theme["bg"], gap=8)
        modes.pack(fill="x")
        mode_buttons = {}

        def set_mode(value):
            mode.set(value)
            for key, button in mode_buttons.items():
                button.set_active(self.theme["active"] if key == value else None,
                                  self.theme["active_text"] if key == value else None)
            schedule()
        for key, label in (("fill", "Fläche füllen (zuschneiden)"), ("fit", "Ganzes Bild zeigen")):
            mode_buttons[key] = self._make_dialog_button(modes, label, lambda value=key: set_mode(value),
                                                         "muted", width=180, height=32)
            modes.add(mode_buttons[key])
        self._drawing_scale(body, "Größe", zoom, 25, 400, " %", schedule)
        self._drawing_scale(body, "Horizontal", offset_x, -size, size, " Zellen", schedule)
        self._drawing_scale(body, "Vertikal", offset_y, -size, size, " Zellen", schedule)
        tk.Label(body, text="„Nur als Referenz“ legt das Bild als blasse, nicht bemalbare Hilfsebene "
                            "hinter die Zeichnung. „Nachzeichnen“ erzeugt zuerst eine Vorschau.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(9), wraplength=420,
                 justify="left", anchor="w").pack(fill="x", pady=(8, 0))

        def reset():
            zoom.set(100)
            offset_x.set(0)
            offset_y.set(0)
            set_mode("fill")

        def as_reference():
            result["value"] = {"frame": current_frame(), "trace_model": None}
            dialog.destroy()

        def trace():
            values = current_frame()
            trace_source = glide_drawing_image.render_trace_reference(
                source, values["mode"], values["zoom_percent"], values["offset_x"], values["offset_y"],
                size=size)
            model = self.drawing_trace_preview_dialog(trace_source, replaces_existing, parent=dialog)
            if model is None:
                return
            result["value"] = {"frame": values, "trace_model": model}
            dialog.destroy()

        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(fill="x", pady=(14, 0))
        self._make_dialog_button(footer, "Zurücksetzen", reset, "muted", width=120).pack(side="left")
        self._make_dialog_button(footer, "Nachzeichnen …", trace, "confirm", width=140).pack(side="right")
        self._make_dialog_button(footer, "Nur als Referenz", as_reference, "accent", width=150).pack(
            side="right", padx=(0, 8))
        self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted", width=110).pack(
            side="right", padx=(0, 8))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.protocol("WM_DELETE_WINDOW", dialog.destroy)
        set_mode(mode.get())
        render()
        self._center_dialog(dialog, min_width=520)
        self._schedule_windows_chrome_theme(dialog)
        if start_trace:
            dialog.after(60, trace)
        self.run_modal(dialog)
        return result["value"]

    def drawing_trace_preview_dialog(self, trace_source, replaces_existing=False, parent=None):
        """Vorschau der Nachzeichnung; erst die Bestätigung ersetzt das Modell."""
        size = trace_source.width()
        zoom_preview = max(1, 384 // size)
        result = {"value": None}
        dialog, body = self._drawing_dialog("Nachzeichnung prüfen", parent=parent)
        tk.Label(body, text=f"{size} × {size} Zellen · höchstens 64 Farben · Hintergrund Weiß",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10), anchor="w").pack(anchor="w")
        preview = tk.Canvas(body, width=size * zoom_preview, height=size * zoom_preview, bg="#FFFFFF",
                            highlightthickness=1, highlightbackground=self.theme["line"])
        preview.pack(pady=(8, 8))
        white = tk.IntVar(value=glide_drawing_image.TRACE_WHITE_DEFAULT)
        grid_mode = tk.StringVar(value="cells")
        status = tk.Label(body, text="", bg=self.theme["bg"], fg=self.theme["text"], font=app_font(10), anchor="w")
        state = {"job": None, "image": None, "model": None}

        def draw():
            preview.delete("all")
            preview.create_image(0, 0, image=state["image"], anchor="nw")
            step = {"cells": 1, "groups": 8}.get(grid_mode.get())
            if not step:
                return
            extent = size * zoom_preview
            for value in range(0, size + 1, step):
                position = value * zoom_preview
                color = "#777777" if value % 8 == 0 else "#D0D0D0"
                preview.create_line(position, 0, position, extent, fill=color)
                preview.create_line(0, position, extent, position, fill=color)

        def refresh():
            state["job"] = None
            model = glide_drawing_image.quantize_reference(
                trace_source, max_colors=glide_drawing_image.TRACE_MAX_COLORS, white_threshold=white.get())
            state["model"] = model
            state["image"] = glide_drawing_image.model_to_photo(model).zoom(zoom_preview, zoom_preview)
            status.configure(text=f"{len(set(model.cells))} Farben verwendet · breite Konturen bleiben erhalten")
            draw()

        def schedule():
            if state["job"] is not None:
                dialog.after_cancel(state["job"])
            state["job"] = dialog.after(60, refresh)

        self._drawing_scale(body, "Weiß ab", white, 220, 255, " je Kanal", schedule)
        grid_row = ButtonFlow(body, self.theme["bg"], gap=8)
        grid_row.pack(fill="x", pady=(6, 0))
        grid_buttons = {}

        def set_grid(value):
            grid_mode.set(value)
            for key, button in grid_buttons.items():
                button.set_active(self.theme["active"] if key == value else None,
                                  self.theme["active_text"] if key == value else None)
            if state["image"] is not None:
                draw()
        for key, label in (("none", "Raster aus"), ("cells", "Jede Zelle"), ("groups", "8er-Gruppen")):
            grid_buttons[key] = self._make_dialog_button(grid_row, label, lambda value=key: set_grid(value),
                                                         "muted", width=110, height=32)
            grid_row.add(grid_buttons[key])
        status.pack(fill="x", pady=(8, 0))
        if replaces_existing:
            tk.Label(body, text="Die Übernahme ersetzt den aktuellen Inhalt. Rückgängig und "
                                "„Nachzeichnung zurücksetzen“ holen ihn zurück.",
                     bg=self.theme["bg"], fg=self.theme["delete"], font=app_font(9), wraplength=420,
                     justify="left", anchor="w").pack(fill="x", pady=(4, 0))

        def apply():
            result["value"] = state["model"]
            dialog.destroy()

        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(fill="x", pady=(14, 0))
        self._make_dialog_button(footer, "Nachzeichnung übernehmen", apply, "confirm", width=210).pack(side="right")
        self._make_dialog_button(footer, "Zurück zum Rahmen", dialog.destroy, "muted", width=160).pack(
            side="right", padx=(0, 8))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.protocol("WM_DELETE_WINDOW", dialog.destroy)
        set_grid("cells")
        refresh()
        self._center_dialog(dialog, min_width=480)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog, parent=parent)
        return result["value"]

    def drawing_color_dialog(self, initial, palette=(), title="Zeichenfarbe"):
        """Farbspektrum, Helligkeit, Direkteingabe und die Farben der Zeichnung."""
        width, height = 256, 144
        result = {"value": None}
        dialog, body = self._drawing_dialog(title)
        red, green, blue = (int(initial[index:index + 2], 16) / 255 for index in (1, 3, 5))
        hue, saturation, _value = colorsys.rgb_to_hsv(red, green, blue)
        state = {"hue": hue, "saturation": saturation, "color": initial, "image": None, "marker": None}
        # Das Spektrum öffnet immer mit voller Helligkeit. Bei Schwarz als
        # aktueller Farbe sah es sonst wie ein leerer schwarzer Kasten aus.
        # Die aktuelle Farbe bleibt trotzdem im Feld und in der Vorschau stehen.
        brightness = tk.IntVar(value=100)
        tk.Label(body, text="Farbton waagerecht, Sättigung senkrecht", bg=self.theme["bg"],
                 fg=self.theme["muted"], font=app_font(10), anchor="w").pack(anchor="w")
        canvas = tk.Canvas(body, width=width, height=height, highlightthickness=1,
                           highlightbackground=self.theme["line"], cursor="crosshair")
        canvas.pack(anchor="w", pady=(6, 6))
        swatch = tk.Canvas(body, width=48, height=26, highlightthickness=1,
                           highlightbackground=self.theme["line"], bg=initial)
        entry_var = tk.StringVar(value=initial)
        message = tk.Label(body, text="", bg=self.theme["bg"], fg=self.theme["delete"], font=app_font(9), anchor="w")

        def draw_spectrum():
            level = brightness.get() / 100
            rows = []
            for y in range(height):
                sat = 1 - y / (height - 1)
                rows.append("{" + " ".join(
                    "#{:02X}{:02X}{:02X}".format(*(round(channel * 255) for channel in
                                                   colorsys.hsv_to_rgb(x / (width - 1), sat, level)))
                    for x in range(width)) + "}")
            image = tk.PhotoImage(master=canvas, width=width, height=height)
            image.put(" ".join(rows))
            state["image"] = image
            canvas.delete("all")
            canvas.create_image(0, 0, image=image, anchor="nw")
            state["marker"] = None
            show()

        def set_color(color, from_entry=False):
            state["color"] = color
            swatch.configure(bg=color)
            if not from_entry:
                entry_var.set(color)
            message.configure(text="")

        def show():
            level = brightness.get() / 100
            color = "#{:02X}{:02X}{:02X}".format(
                *(round(channel * 255) for channel in colorsys.hsv_to_rgb(state["hue"], state["saturation"], level)))
            set_color(color)
            x = state["hue"] * (width - 1)
            y = (1 - state["saturation"]) * (height - 1)
            if state["marker"] is not None:
                canvas.delete(state["marker"])
            state["marker"] = canvas.create_oval(x - 5, y - 5, x + 5, y + 5,
                                                 outline="#FFFFFF" if level < 0.5 else "#000000", width=2)

        def pick(event):
            state["hue"] = min(1.0, max(0.0, event.x / (width - 1)))
            state["saturation"] = min(1.0, max(0.0, 1 - event.y / (height - 1)))
            show()

        canvas.bind("<Button-1>", pick)
        canvas.bind("<B1-Motion>", pick)
        self._drawing_scale(body, "Helligkeit", brightness, 5, 100, " %", draw_spectrum)
        row = tk.Frame(body, bg=self.theme["bg"])
        row.pack(fill="x", pady=(8, 0))
        swatch.pack(in_=row, side="left")
        field_border, field = self._make_field(row)
        field_border.pack(side="left", padx=(10, 0))
        field.pack(padx=1, pady=1)
        color_entry = tk.Entry(field, textvariable=entry_var, width=12, font=app_font(11), relief="flat",
                               bd=0, highlightthickness=0, bg=self.theme["input"], fg=self.theme["text"],
                               insertbackground=self.theme["text"])
        color_entry.pack(padx=self.FIELD_PAD_X, pady=4)
        tk.Label(row, text="#RGB, #RRGGBB oder Farbname", bg=self.theme["bg"], fg=self.theme["muted"],
                 font=app_font(9)).pack(side="left", padx=(10, 0))

        def typed(_event=None):
            try:
                set_color(glide_drawing_image.normalize_ui_color(entry_var.get(), dialog), from_entry=True)
            except glide_drawing.DrawingFormatError:
                pass
        color_entry.bind("<KeyRelease>", typed)
        message.pack(fill="x", pady=(4, 0))
        used = [color for color in palette if color != glide_drawing.BACKGROUND][-24:]
        if used:
            tk.Label(body, text="Farben dieser Zeichnung", bg=self.theme["bg"], fg=self.theme["muted"],
                     font=app_font(9), anchor="w").pack(anchor="w", pady=(8, 2))
            flow = ButtonFlow(body, self.theme["bg"], gap=4)
            flow.pack(fill="x")
            for color in [glide_drawing.BACKGROUND] + used:
                chip = tk.Canvas(flow, width=22, height=22, bg=color, highlightthickness=1,
                                 highlightbackground=self.theme["line"], cursor="hand2")
                chip.bind("<Button-1>", lambda _event, value=color: set_color(value))
                flow.add(chip)

        def apply(_event=None):
            try:
                result["value"] = glide_drawing_image.normalize_ui_color(entry_var.get(), dialog)
            except glide_drawing.DrawingFormatError as exc:
                message.configure(text=str(exc))
                return "break"
            dialog.destroy()
            return "break"

        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(fill="x", pady=(14, 0))
        self._make_dialog_button(footer, "Übernehmen", apply, "confirm").pack(side="right")
        self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        color_entry.bind("<Return>", apply)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.protocol("WM_DELETE_WINDOW", dialog.destroy)
        draw_spectrum()
        set_color(initial)
        self._center_dialog(dialog, min_width=420)
        self._schedule_windows_chrome_theme(dialog)
        color_entry.focus_set()
        self.run_modal(dialog)
        return result["value"]

    def _refresh_tree(self, selected_id=None):
        self.restore_note_chrome()
        # Eine Zeichnung gibt ihre Leisten zurück, bevor Pinnwand oder Liste sie
        # ordnen. Bis 3.29 geschah das erst am Ende des Aufbaus: Die Pinnwand
        # merkte sich dann einen Stand ohne Eingabezeile, die danach über der
        # Fläche stehen blieb oder nach dem Verlassen der Pinnwand fehlte.
        naechste = self.current_list() if self.view_mode == "list" and self.lists else None
        if not self.is_surface_list(naechste):
            self.restore_drawing_chrome()
        workspace = getattr(self, "workspace", None)
        ready = workspace is not None and getattr(self, "_workspace_ready", False)
        if ready:
            workspace.before_refresh()
        self._refresh_tree_contents(selected_id)
        if ready:
            workspace.refresh()
        self.sync_rich_note_view()
        self.sync_drawing_view()
        self.sync_gallery_view()
        self.sync_detail_pane()
        self.sync_plan_day_grid()
        self.sync_focus_panel()
        # Zuletzt: Beim Verlassen einer Zeichnung packte `restore_drawing_chrome`
        # die Eingabezeile erst nach `update_entry_mode` wieder ein – eine
        # Seite stand danach mit Eingabezeile da (gefunden 27.09.2026).
        self.sync_view_chrome()
        self.sync_tool_band()
        self.sync_card_foot()

    # Pack-Abstände der beiden Zeilen über der Inhaltsfläche (siehe create_ui).
    TOOL_BAND_ROWS = (("input_frame", 10), ("search_frame", 12))

    # --- Fuß der Inhaltskarte (29.09.2026) ---------------------------------
    # Hinweis und Auswahlleiste teilen sich unten in der Karte einen Streifen
    # fester Höhe: ohne Auswahl der Hinweis (höchstens zwei Zeilen), mit
    # Auswahl die Leiste. Vom 27. bis 29.09.2026 lagen beide in einem festen
    # Fußbereich unter der Karte; der kostete rund 110 Pixel Arbeitsfläche.
    # Davor wurde die Liste beim Markieren um 73 Pixel kürzer. Ansichten mit
    # eigener Fläche (Pinnwand, Seite, Notiz, Zeichnung, Galerie) brauchen den
    # Fuß nicht; dort ist er eine Pixelzeile hoch.
    HINT_MAX_LINES = 2
    SELECTION_BUTTON_HEIGHT = 32
    CARD_FOOT_PAD_Y = 6

    def on_hint_configure(self, event):
        hinweis = self.hint_label
        breite = max(240, event.width)
        if int(float(hinweis.cget("wraplength") or 0)) != breite:
            hinweis.configure(wraplength=breite)
            self.fit_hint_text()

    def hint_line_height(self, zeilen, label=None):
        hinweis = label or self.hint_label
        return glide_metrics.line_height(
            zeilen, self.measurement_linespace(hinweis.cget("font")),
            hinweis.cget("pady"), CanvasLabel.LABEL_INSET_Y)

    def fit_label_lines(self, label, voll, zeilen):
        """Kürzt `voll` in `label` auf höchstens `zeilen` Zeilen; der volle Text steht im Tooltip."""
        grenze = self.hint_line_height(zeilen, label) + 2
        label.configure(text=voll)
        if label.text_size()[1] <= grenze:
            return voll
        woerter = voll.split(" ")
        unten, oben = 1, len(woerter)
        while unten < oben:
            mitte = (unten + oben + 1) // 2
            label.configure(text=" ".join(woerter[:mitte]).rstrip(" ·") + " …")
            if label.text_size()[1] <= grenze:
                unten = mitte
            else:
                oben = mitte - 1
        text = " ".join(woerter[:unten]).rstrip(" ·") + " …"
        label.configure(text=text)
        self.add_tooltip(label, voll)
        return text

    def fit_hint_text(self):
        """Kürzt den Hinweis auf höchstens zwei Zeilen; der volle Text steht im Tooltip."""
        hinweis = getattr(self, "hint_label", None)
        if hinweis is None:
            return
        aktuell = hinweis.cget("text")
        if aktuell != getattr(self, "_hint_shown_text", None):
            self._hint_full_text = aktuell
        self._hint_shown_text = self.fit_label_lines(
            hinweis, getattr(self, "_hint_full_text", aktuell), self.HINT_MAX_LINES)

    def toggle_view_hints(self, event=None):
        key = str(self.view_mode)
        before = copy.deepcopy(self.settings.get("view_hints", {}))
        self.settings.setdefault("view_hints", {})[key] = not glide_interaction.hints_visible(self.settings, key)
        if not self.save_settings():
            self.settings["view_hints"] = before
        self._tool_hint_key = None
        self.sync_tool_band_hint()
        self.sync_card_foot()
        self.update_page_chips()
        return "break"

    def item_date_text(self, item):
        return glide_interaction.date_text(
            self.format_due_column(item.get("due"), item.get("due_time")),
            self.format_due_column(item.get("planned_date")), self.DUE_COLUMN_ICON, self.ICONS["today"])

    def card_foot_height(self):
        """Zwei Hinweiszeilen oder eine Knopfreihe – je nachdem, was höher ist – plus Trennlinie."""
        return 1 + 2 * self.CARD_FOOT_PAD_Y + max(self.SELECTION_BUTTON_HEIGHT,
                                                  self.hint_line_height(self.HINT_MAX_LINES))

    def card_foot_mode(self):
        """Was der Kartenfuß zeigt: "bar" bei Auswahl, sonst "hint" – oder None ohne Fuß."""
        liste = getattr(self, "list_frame", None)
        if liste is None:
            return None
        werk = getattr(self, "workspace", None)
        if werk is not None and getattr(werk, "visible", False):
            # Pinnwand und Reiter haben ihre eigenen Leisten.
            return None
        if self.view_mode in (self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW,
                              self.LIBRARY_VIEW, self.GLOBAL_BOARD_VIEW):
            return None
        if self.view_mode == "list" and self.lists:
            entry = self.current_list()
            if entry and (entry.get("list_kind") == "note" or self.is_page_list(entry)
                          or self.is_surface_list(entry)):
                return None
        try:
            if liste.winfo_manager() != "pack":
                return None
        except tk.TclError:
            return None
        return "bar" if self.selection_bar_ids() else ("hint" if glide_interaction.hints_visible(self.settings, self.view_mode) else None)

    def sync_card_foot(self):
        """Hält den Kartenfuß: feste Höhe, darin Hinweis oder Auswahlleiste.

        Nur diese Stelle packt Hinweis und Auswahlleiste. Der Fuß steht in der
        Packreihenfolge der Karte vorn und damit ganz unten; ohne Aufgabe ist er
        ausgepackt (Tk gäbe einem leeren Rahmen sonst eine Pixelzeile). Beim
        Markieren ändert sich weder die Karte noch die Liste darin.
        """
        fuss = getattr(self, "card_foot", None)
        hinweis = getattr(self, "hint_label", None)
        rahmen = getattr(self, "button_frame", None)
        if fuss is None or hinweis is None or rahmen is None:
            return
        # Liegt die Karte gerade nicht aus – Startseite und die übrigen
        # Übersichten –, bleibt ihr Inhalt unberührt: Tk 9 blendet den
        # eingebetteten Rahmen einer ausgepackten Leinwand wieder ein, sobald
        # sich darin etwas ändert, und die Liste galt dann als sichtbar
        # (gefunden 29.09.2026, test_ui_updates). Beim nächsten Zeigen gleicht
        # `update_home_visibility` den Fuß ab.
        if not self.list_frame_outer.winfo_manager():
            return
        modus = self.card_foot_mode()
        try:
            if not modus:
                if fuss.winfo_manager():
                    fuss.pack_forget()
                return
            hoehe = self.card_foot_height()
            if int(fuss.cget("height")) != hoehe:
                fuss.configure(height=hoehe)
            geschwister = self.list_frame_outer.inner.pack_slaves()
            if fuss.winfo_manager() != "pack" or (geschwister and geschwister[0] is not fuss):
                optionen = {"side": "bottom", "fill": "x"}
                vorn = next((kind for kind in geschwister if kind is not fuss), None)
                if vorn is not None:
                    optionen["before"] = vorn
                fuss.pack(**optionen)
            linie = self.card_foot_line
            if modus and not linie.winfo_manager():
                linie.pack(side="top", fill="x")
            elif not modus and linie.winfo_manager():
                linie.pack_forget()
            rand = (self.CONTENT_INSET[0], self.CONTENT_INSET[0])
            if modus == "bar":
                if hinweis.winfo_manager():
                    hinweis.pack_forget()
                if not rahmen.winfo_manager():
                    rahmen.pack(fill="both", expand=True, padx=rand, pady=self.CARD_FOOT_PAD_Y)
                    self._action_density_columns = None
                    self.sync_action_density()
                return
            if rahmen.winfo_manager():
                rahmen.pack_forget()
            if modus == "hint":
                if not hinweis.winfo_manager():
                    hinweis.pack(fill="both", expand=True, padx=rand, pady=(self.CARD_FOOT_PAD_Y, 0))
                self.fit_hint_text()
            elif hinweis.winfo_manager():
                hinweis.pack_forget()
        except (tk.TclError, ValueError):
            return

    def surface_hint_text(self):
        """Bedienhinweis für Seite, Zeichnung und Galerie – er steht in der Werkzeugleiste darüber."""
        entry = self.current_list() if self.view_mode == "list" and self.lists else None
        werk = getattr(self, "workspace", None)
        if entry is None or (werk is not None and getattr(werk, "visible", False)):
            return ""
        if self.is_page_list(entry):
            return ("„/“ am Zeilenanfang: Blöcke · Bilder: hineinziehen oder „Bild“, verschieben per Ziehen, "
                    "Größe an der Ecke · Doppelklick auf eine Aufgabe: Details")
        if self.is_drawing_list(entry):
            return ("Linksklick malt, Rechtsklick mit der zweiten Farbe · Strg/Cmd + Mausrad: Zoom · "
                    "Werkzeuge über ihre Taste: B F I L U E S")
        if self.is_gallery_list(entry):
            return ("Bilder aus Finder oder Explorer hineinziehen · Doppelklick: groß ansehen · "
                    "Pfeiltasten: blättern · Entf: aus der Galerie entfernen")
        return ""

    def sync_tool_band_hint(self):
        """Hinweis der Ansicht in der festen Werkzeugleiste – eine Zeile, voller Text im Tooltip."""
        hinweis = getattr(self, "tool_band_hint", None)
        band = getattr(self, "tool_band", None)
        if hinweis is None or band is None:
            return
        try:
            text = self.surface_hint_text() if band.winfo_manager() == "pack" and glide_interaction.hints_visible(self.settings, self.view_mode) else ""
            breite = max(240, band.winfo_width() - 2)
            schluessel = (text, breite)
            if schluessel == getattr(self, "_tool_hint_key", None) and hinweis.cget("text") == getattr(
                    self, "_tool_hint_shown", None):
                return
            self._tool_hint_key = schluessel
            hinweis.configure(wraplength=breite)
            self._tool_hint_shown = self.fit_label_lines(hinweis, text, 1) if text else ""
            if not text:
                hinweis.configure(text="")
        except (tk.TclError, ValueError):
            return

    def schedule_fixed_layout_sync(self, event=None):
        if getattr(self, "_fixed_layout_pending", False):
            return
        self._fixed_layout_pending = True

        def abgleichen():
            self._fixed_layout_pending = False
            self.sync_tool_band()
            self.sync_card_foot()

        try:
            self.root.after_idle(abgleichen)
        except tk.TclError:
            self._fixed_layout_pending = False

    def tool_band_host(self):
        """Rahmen für die Werkzeuge einer Ansicht in der festen Leiste über der Fläche."""
        return getattr(self, "tool_band_inner", None)

    HEADER_SLACK = 3

    def sync_header_height(self):
        """Feste Höhe der Kopfzeile: Titel, Kennzahlenzeile und Knöpfe passen immer hinein.

        Bis 27.09.2026 ergab sich die Höhe aus dem Inhalt; Chips mit anderen
        Zeichen machten sie einen Pixel höher, dreizeilige Kennzahlen zwanzig.
        Die Höhe wächst nur (etwa bei größerer Schrift) und schrumpft erst,
        wenn sich die Schriftgröße ändert.
        """
        kopf = getattr(self, "header_frame", None)
        if kopf is None or not hasattr(self, "title_row"):
            return
        try:
            schrift = tkfont.Font(root=self.root, font=app_font(9, "bold"))
            chipzeile = max(self.page_chip_row.winfo_reqheight(), schrift.metrics("linespace") + 6)
            noetig = max(self.title_row.winfo_reqheight() + 4 + chipzeile,
                         self.header_controls.winfo_reqheight() + 8) + self.HEADER_SLACK
            schluessel = (self.settings.get("ui_font_size"), self.settings.get("ui_font_family"),
                          self.design_name() if hasattr(self, "design_name") else None)
            if getattr(self, "_header_height_key", None) != schluessel:
                self._header_height_key = schluessel
                self._header_fixed_height = 0
            hoehe = max(noetig, getattr(self, "_header_fixed_height", 0))
            self._header_fixed_height = hoehe
            if kopf.pack_propagate():
                kopf.pack_propagate(False)
            if int(kopf.cget("height")) != hoehe:
                kopf.configure(height=hoehe)
        except (tk.TclError, ValueError, AttributeError):
            return
        self.sync_header_logo()

    # --- Logo in der Kopfzeile (29.09.2026) -------------------------------
    HEADER_LOGO_GAP = 14

    def header_logo_color(self):
        """Akzentfarbe der Oberfläche, auf dem Grund mindestens 3:1 (WCAG für Grafiken)."""
        farbe = str(self.theme.get("ui_accent") or glide_logo.BRAND_BLUE)
        if not re.fullmatch(r"#[0-9A-Fa-f]{6}", farbe):
            farbe = glide_logo.BRAND_BLUE
        return legible_on(farbe, [self.theme.get("bg")], minimum=3.0).upper()

    def header_logo_height(self):
        font = self.cached_font("_header_subtitle_font", app_font(9, "bold"))
        line = font.metrics("linespace") if font is not None else 18
        return max(24, self.title_row.winfo_reqheight() + max(self.page_chip_row.winfo_reqheight(), line + 6)
                   - self.header_logo_top_inset())

    def header_logo_top_inset(self):
        font = self.cached_font("_header_cap_font", self.header_title_font())
        if font is None:
            return 4
        pixels = abs(font.actual("size")) * float(self.root.tk.call("tk", "scaling"))
        return max(2, round(font.metrics("ascent") - pixels * 0.72) + CanvasLabel.LABEL_INSET_Y + 1)

    def sync_header_logo(self):
        """Zeigt das Logo ab der ersten Breitenstufe und zeichnet es in Akzentfarbe und Höhe neu."""
        leinwand = getattr(self, "header_logo", None)
        if leinwand is None or not hasattr(self, "title_row") or not hasattr(self, "page_chip_row"):
            return
        try:
            if self.header_density() == "minimal":
                if leinwand.winfo_manager():
                    leinwand.pack_forget()
                    self.update_header_title()
                return
            inset = self.header_logo_top_inset()
            if leinwand.winfo_manager() and inset != getattr(self, "_header_logo_inset", None):
                self._header_logo_inset = inset
                leinwand.pack_configure(pady=(inset, 0))
            hoehe = self.header_logo_height()
            farbe = self.header_logo_color()
            if (hoehe, farbe) != getattr(self, "_header_logo_key", None):
                self._header_logo_key = (hoehe, farbe)
                self.draw_logo(leinwand, hoehe, farbe)
            if not leinwand.winfo_manager():
                leinwand.pack(side="left", anchor="nw", padx=(0, self.HEADER_LOGO_GAP), pady=(inset, 0), before=self.title_block)
                self._header_logo_inset = inset
                self.update_header_title()
        except (tk.TclError, ValueError, OSError, AttributeError):
            return

    def draw_logo(self, leinwand, hoehe, farbe):
        """Zeichnet das Logo randlos auf `leinwand`: als SVG-Bild (Tk 9) oder als Fläche (Tk 8.6)."""
        leinwand.delete("logo")
        breite = max(1, round(hoehe * glide_logo.aspect()))
        leinwand.configure(width=breite, height=hoehe)
        try:
            bild = glide_logo.logo_photo(leinwand, hoehe, farbe)
        except (tk.TclError, ValueError, OSError):
            bild = None
        leinwand._logo_image = bild
        if bild is not None:
            leinwand.create_image(0, 0, image=bild, anchor="nw", tags=("logo",))
        else:
            glide_logo.draw_logo_polygons(leinwand, 0, 0, hoehe, farbe)
        leinwand.tag_raise("logo")
        return breite

    def sync_tool_band(self):
        """Hält die Oberkante der Inhaltsfläche in jeder Ansicht an derselben Stelle.

        Rechnet aus, wie hoch die fehlenden Zeilen wären, und setzt die Leiste
        genau so hoch davor. Gemessen wird die angeforderte Höhe der Zeilen:
        Die gilt auch, wenn sie gerade ausgeblendet sind.
        """
        self.sync_header_height()
        band = getattr(self, "tool_band", None)
        karte = getattr(self, "list_frame_outer", None)
        if band is None or karte is None:
            return
        if not getattr(self, "_fixed_layout_watch", False):
            # Pinnwand, Notiz und Zeichnung blenden Zeilen auch außerhalb von
            # `_refresh_tree` ein und aus. Jedes Ein- oder Ausblenden stößt
            # deshalb den Abgleich im nächsten Leerlauf an.
            self._fixed_layout_watch = True
            for name in ("input_frame", "search_frame", "list_frame_outer"):
                zeile = getattr(self, name, None)
                if zeile is not None:
                    for ereignis in ("<Map>", "<Unmap>"):
                        zeile.bind(ereignis, self.schedule_fixed_layout_sync, add="+")
        try:
            if karte.winfo_manager() != "pack" or karte.pack_info().get("in") is not self.content_frame:
                if band.winfo_manager():
                    band.pack_forget()
                return
            fehlend = 0
            vor = karte
            for name, abstand in reversed(self.TOOL_BAND_ROWS):
                zeile = getattr(self, name, None)
                if zeile is None:
                    continue
                if zeile.winfo_manager() != "pack":
                    fehlend += zeile.winfo_reqheight() + abstand
                elif fehlend == 0:
                    # Fehlt nur eine obere Zeile, steht die Leiste an ihrer
                    # Stelle – die Suchzeile bleibt dort, wo sie immer steht.
                    vor = zeile
            if not fehlend:
                if band.winfo_manager():
                    band.pack_forget()
                self.sync_tool_band_hint()
                return
            if int(band.cget("height")) != fehlend:
                band.configure(height=fehlend)
            geschwister = self.content_frame.pack_slaves()
            if band.winfo_manager() != "pack" or band not in geschwister \
                    or geschwister.index(band) + 1 != geschwister.index(vor):
                band.pack_forget()
                band.pack(fill="x", before=vor)
        except (tk.TclError, ValueError):
            return
        self.sync_tool_band_hint()

    def restore_note_chrome(self):
        """Die Notiz nutzt den Platz der auch im Aktionen-Menü verfügbaren Leisten."""
        for widget, options in getattr(self, "_note_saved_chrome", []):
            if widget.winfo_exists():
                widget.pack(**options)
        self._note_saved_chrome = []

    def _refresh_tree_contents(self, selected_id=None):
        if not hasattr(self, "tree"):
            return

        self.update_home_visibility()
        if self.view_mode == self.HISTORY_VIEW:
            self.update_stats_label()
            self.tree.selection_remove(self.tree.selection())
            for widget in self.home_content.winfo_children():
                widget.destroy()
            self.show_history_dialog(embedded=True)
            return
        if self.view_mode == self.PAGES_VIEW:
            self.update_stats_label()
            self.tree.selection_remove(self.tree.selection())
            self.render_pages_page()
            return
        if self.view_mode == self.DRAWINGS_VIEW:
            self.update_stats_label()
            self.tree.selection_remove(self.tree.selection())
            self.render_drawings_page()
            return
        if self.view_mode == self.NOTES_VIEW:
            self.update_stats_label()
            self.tree.selection_remove(self.tree.selection())
            self.render_notes_page()
            return
        if self.view_mode == self.LIBRARY_VIEW:
            self.tree.selection_remove(self.tree.selection())
            self.refresh_library_page()
            return
        if self.view_mode == self.HOME_VIEW:
            self.tree.selection_remove(self.tree.selection())
            self.refresh_home()
            return
        if self.view_mode == self.TEMPLATE_VIEW:
            self.tree.selection_remove(self.tree.selection())
            self.refresh_template_page()
            return

        if self.view_mode == self.TABLE_VIEW:
            self.refresh_table_view(selected_id=selected_id)
            return

        if self.view_mode == self.GLOBAL_BOARD_VIEW:
            # Die Fläche selbst baut die Arbeitsumgebung auf; der Aufgabenbaum
            # liegt darunter und bleibt leer, damit keine verdeckte Zeile als
            # Auswahl dienen kann.
            self.tree.selection_remove(self.tree.selection())
            for row_id in self.tree.get_children(""):
                self.tree.delete(row_id)
            self.update_stats_label()
            return

        if "headings" in str(self.tree.cget("show")):
            self.tree.configure(
                show="tree",
                columns=("due", "labels", "due_padding", "text_gap", "source"),
                displaycolumns=("text_gap", "due", "labels", "due_padding"),
            )
            self.tree.heading("#0", text="")

        # Die Labelspalte erscheint erst, sobald Labels existieren.
        self.sync_task_tree_columns()

        if self.view_mode in self.TASK_OVERVIEW_VIEWS:
            self.refresh_task_overview(selected_id=selected_id)
            return
        if self.view_mode == self.LABELS_VIEW:
            self.refresh_label_overview(selected_id=selected_id)
            return
        if self.view_mode == "trash":
            self.refresh_trash_overview(selected_id=selected_id)
            return
        if self.view_mode == "folder":
            self.refresh_folder_overview(selected_id=selected_id)
            return

        self.update_stats_label()

        if selected_id is None:
            selected_id = self.get_selected_item_id()
        self.remember_expanded_state()

        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)

        if not self.items:
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text="Noch keine Punkte vorhanden.", tags=("empty",))
            self.finish_tree_refresh()
            return

        gruppierung = self.list_group_field()
        if gruppierung:
            inserted = self.insert_grouped_tree_items(gruppierung)
        else:
            inserted = self.insert_tree_items("", self.items, [])
        if inserted == 0:
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text="Keine Treffer für den aktuellen Filter.", tags=("empty",))
            self.finish_tree_refresh()
            return

        if selected_id and self.tree.exists(selected_id):
            self.tree.selection_set(selected_id)
            self.tree.focus(selected_id)
            self.see_unless_folded(selected_id)

        self.finish_tree_refresh()

    def refresh_table_view(self, selected_id=None):
        """Zeichnet eine flache, spaltenbasierte Sicht der aktiven Liste."""
        if not hasattr(self, "tree"):
            return
        columns = self.table_columns_for_list()
        # Der native Treeview darf seine Spalten dynamisch erhalten. #0 bleibt
        # die erste sichtbare Spalte, damit Auswahl, Tastatur und IDs mit der
        # normalen Listenansicht identisch bleiben.
        # Gruppiert oder verschachtelt (3.30) braucht die Tabelle die schmale
        # Baumspalte für die Aufklapppfeile; sonst bleibt sie verborgen.
        mit_baum = bool(self.list_group_field()) or self.table_nested()
        self.tree.configure(show="tree headings" if mit_baum else "headings", columns=columns, displaycolumns=columns)
        # Überschrift und Zelleninhalt stehen auf derselben
        # linken Kante. Vorher zentrierte Tk jede Überschrift, wodurch sie über
        # ihren linksbündigen Werten hing.
        stored_widths = self.table_widths_for_list()
        sort_column, sort_direction = self.table_sort_for_list()
        arrow = self.ICONS["sort_descending" if sort_direction == "desc" else "sort_ascending"]
        self.tree.heading("#0", text="" if mit_baum else self.TABLE_COLUMN_LABELS["title"], anchor="w")
        if mit_baum:
            # Platz für Aufklapppfeil und Listennummer wie „2.1“.
            self.tree.column("#0", anchor="w", stretch=False, width=76, minwidth=40)
        else:
            self.tree.column("#0", anchor="w", stretch=True, width=360, minwidth=self.TABLE_COLUMN_MIN_WIDTH)
        for key in columns:
            caption = self.TABLE_COLUMN_LABELS[key]
            if key == sort_column:
                caption = f"{caption}  {arrow}"
            self.tree.heading(key, text=caption, anchor="w",
                              command=lambda column=key: self.sort_table_by(column))
            width = stored_widths.get(key, self.TABLE_COLUMN_DEFAULT_WIDTHS.get(key, 120))
            # Nur die Titelspalte wächst mit dem Fenster. Zieht jemand eine
            # Breite selbst, bleibt sie stehen – auch die der Titelspalte.
            self.tree.column(key, anchor="w", stretch=key == "title" and "title" not in stored_widths,
                             width=width, minwidth=self.TABLE_COLUMN_MIN_WIDTH)
        self.update_stats_label()
        current_selection = selected_id or self.tree.focus()
        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)
        entries = self.table_entries(apply_filters=True)
        if not entries:
            empty = "Keine Aufgaben passen zum aktuellen Filter." if self.has_active_filter() else "Noch keine Aufgaben in dieser Liste."
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text=empty, tags=("empty",))
            self.finish_tree_refresh()
            return
        # In einer Treeview mit show=headings liegt #0 weiterhin als
        # text-Spalte vor; der Titel wird zusätzlich als erster Wert gesetzt
        # und bleibt damit auch auf Tk-Versionen mit abweichender #0-Logik sichtbar.
        self.fill_table_rows(entries, columns)
        self.fit_table_columns()
        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
            self.see_unless_folded(current_selection)
        self.finish_tree_refresh()

    def get_in_progress_items(self, apply_filters=True):
        """Liefert fällige Aufgaben als abgeleitete Referenzen, ohne sie zu kopieren."""
        return self.render_cached(
            ("in_progress", bool(apply_filters),
             self.current_search_query() if apply_filters else "",
             self.get_filter_mode() if apply_filters and hasattr(self, "hide_done_var") else ""),
            lambda: self._collect_in_progress_items(apply_filters),
        )

    def _collect_in_progress_items(self, apply_filters=True):
        results = []
        query = self.current_search_query() if apply_filters else ""
        for list_index, entry in enumerate(self.planning_lists()):
            for item_index, item in enumerate(self.walk_items(entry.get("items", []))):
                if not self.is_schedulable_item(item):
                    continue
                due_value = self.normalize_due(item.get("due"))
                if not due_value:
                    continue
                if apply_filters and (
                    not self.item_text_matches_query(item, query)
                    or not self.item_matches_status_filter(item)
                ):
                    continue
                results.append((due_value, list_index, item_index, entry, item))
        results.sort(key=lambda value: (value[0], value[1], value[2]))
        return results

    def get_overdue_items(self, apply_filters=True):
        """Überfällige, noch offene Aufgaben.

        „Überfällig“ heißt: die Fälligkeit liegt vor dem heutigen Tag und der
        Punkt ist nicht erledigt. due_status liefert für erledigte Punkte nie
        „overdue“, deshalb genügt diese eine Bedingung.
        """
        return self.render_cached(
            ("overdue", bool(apply_filters),
             self.current_search_query() if apply_filters else "",
             self.get_filter_mode() if apply_filters and hasattr(self, "hide_done_var") else ""),
            lambda: [
                entry
                for entry in self.get_in_progress_items(apply_filters=apply_filters)
                if self.due_status(entry[4]) == "overdue"
            ],
        )

    def current_task_overview_items(self, apply_filters=True):
        """Datengrundlage der gerade geöffneten Aufgabenübersicht."""
        if self.view_mode == "saved_filter":
            return self.saved_filters.entries(apply_filters=apply_filters)
        if self.view_mode == self.PLAN_DAY_VIEW:
            return self.plan_day_entries(apply_filters=apply_filters)
        if self.view_mode == "overdue":
            return self.get_overdue_items(apply_filters=apply_filters)
        return self.get_in_progress_items(apply_filters=apply_filters)

    def inherited_list_color(self, entry):
        """Farbschlüssel einer Liste – ersatzweise der ihres nächsten Ordners.

        Hat weder die Liste noch einer ihrer Ordner eine Farbe, liefert die
        Methode None: Dann bleibt es bei der bisherigen Zustandsfarbe, statt
        eine Herkunft vorzutäuschen, die niemand vergeben hat.
        """
        if not isinstance(entry, dict):
            return None
        eigen = entry.get("color")
        if eigen in self.LIST_COLOR_KEYS:
            return eigen
        folder = self.get_folder(entry.get("folder_id"))
        gesehen = set()
        while isinstance(folder, dict) and folder.get("id") not in gesehen:
            gesehen.add(folder.get("id"))
            geerbt = folder.get("color")
            if geerbt in self.LIST_COLOR_KEYS:
                return geerbt
            folder = self.get_folder(folder.get("parent_id"))
        return None

    def refresh_task_overview(self, selected_id=None):
        """Zeigt fällige bzw. überfällige Aufgaben chronologisch in einer flachen Ansicht."""
        if not hasattr(self, "tree"):
            return
        self.update_stats_label()
        current_selection = selected_id or self.tree.focus()
        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)
        self.in_progress_item_sources = {}
        self._today_source_titles = {}
        self._today_source_fit_key = None

        entries = self.current_task_overview_items(apply_filters=True)
        teile = self.plan_day_sections(entries) if self.view_mode == self.PLAN_DAY_VIEW else None
        routinen = (self.today_routine_rows() if teile is not None and self.plan_day() == date.today().isoformat()
                    and not self.has_active_filter() else [])
        if (glide_today.leer(teile) and not routinen) if teile is not None else not entries:
            if self.view_mode == self.PLAN_DAY_VIEW:
                empty_text = (
                    "Keine Aufgaben dieses Tages passen zu den aktuellen Filtern."
                    if self.has_active_filter()
                    else f"Für {self.format_plan_day()} ist nichts eingeplant, nichts fällig und der Eingang ist leer. "
                         "Aufgaben lassen sich über das Kontextmenü oder in den Punktdetails einplanen."
                )
            elif self.view_mode == "saved_filter":
                empty_text = "Keine Aufgaben passen zu diesem Filter. Filter über den Titel bearbeiten oder die zusätzliche Suche zurücksetzen."
            elif self.view_mode == "overdue":
                empty_text = (
                    "Keine überfälligen Aufgaben passen zum aktuellen Filter."
                    if self.has_active_filter()
                    else "Nichts überfällig – alle Fälligkeiten liegen in der Zukunft."
                )
            else:
                empty_text = (
                    "Keine fälligen Aufgaben passen zum aktuellen Filter."
                    if self.has_active_filter()
                    else "Noch keine Aufgaben mit Fälligkeitsdatum vorhanden."
                )
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text=empty_text, tags=("empty",))
            self.finish_tree_refresh()
            return

        def punktzeile(due_value, source_list, item, parent="", prefix=""):
            """Eine Zeile der Übersicht – gleich, in welchem Abschnitt sie steht.

            Vorher stand dieser Aufbau einmal als Schleife da.
            „In Bearbeitung“ zeigt seit 3.24 zwei Abschnitte und braucht ihn
            zweimal; eine zweite Kopie wäre genau die Stelle, an der beide
            Abschnitte auseinanderlaufen.
            """
            item_id = item.get("id") or uuid.uuid4().hex
            item["id"] = item_id
            list_id = source_list.get("id")
            row_id = f"in-progress:{list_id}:{item_id}"
            if self.view_mode == self.PLAN_DAY_VIEW:
                due_value = self.normalize_due(glide_today.angezeigte_faelligkeit((source_list, item)))
            self.in_progress_item_sources[row_id] = (list_id, item_id)
            importance = self.clamp_importance(item.get("importance", 0))
            flag_prefix = self.IMPORTANCE_MARKERS.get(importance, "")
            done_prefix = "✓ " if item.get("done") else ""
            description_suffix = f"   {self.ICONS['description']}" if str(item.get("description") or "").strip() else ""
            attachment_count = len(item.get("attachments", []))
            attachment_suffix = (
                f"   {self.ICONS['attachment']} {attachment_count}" if attachment_count else ""
            )
            source_title = self.list_path_title(source_list, ellipsize=self.view_mode != self.PLAN_DAY_VIEW)
            if self.view_mode == self.PLAN_DAY_VIEW:
                row_text = f"{prefix}{flag_prefix}{done_prefix}{self.item_display_text(item)}{description_suffix}{attachment_suffix}"
            else:
                number_path = self.get_item_number_path(item_id, source_list.get("items", [])) or []
                number_text = ".".join(str(part) for part in number_path)
                task_prefix = f"{number_text}. " if number_text else ""
                row_text = f"{prefix}{source_title}   —   {task_prefix}{flag_prefix}{done_prefix}{self.item_display_text(item)}{description_suffix}{attachment_suffix}"
            color_key = item.get("color") if item.get("color") in self.ITEM_COLOR_KEYS else None
            due_state = self.due_status(item)
            # Herkunftsfarbe: In einer Übersicht stehen Punkte aus vielen
            # Listen untereinander; die Farbe ihrer Liste – ersatzweise die des
            # Ordners – gliedert die Ansicht ohne zusätzliche Trennlinien.
            # Die Aufgabenfarbe gilt für die Zeile; die Herkunftszelle in
            # „Heute“ bekommt unter Tk 9 zusätzlich ihre gedämpfte Textfarbe.
            source_color = self.inherited_list_color(source_list)
            # In „Verspätet" ist ausnahmslos alles überfällig – dort sagt Rot
            # nichts mehr, und die Herkunft steht vorn. In „In Bearbeitung"
            # mischen sich überfällig, heute und später: Da bleibt der
            # Fälligkeitszustand die wichtigere Auskunft.
            herkunft_zuerst = self.view_mode == "overdue"
            if color_key:
                tag = f"itemcolor_{color_key}"
            elif item.get("done"):
                tag = "done"
            elif herkunft_zuerst and source_color:
                tag = f"listcolor_{source_color}"
            elif due_state == "overdue":
                tag = "overdue"
            elif due_state == "today":
                tag = "due_today"
            elif source_color:
                tag = f"listcolor_{source_color}"
            elif importance == 3:
                tag = "priority_high"
            elif importance == 2:
                tag = "priority_medium"
            elif importance == 1:
                tag = "priority_low"
            else:
                tag = "open"
            self.tree.insert(
                parent,
                "end",
                iid=row_id,
                text=row_text,
                values=(
                    self.item_date_text(item),
                    self.format_item_labels(item),
                    "", "",
                    self.shorten_to_width(source_title, self.measurement_font(app_font(glide_design.FONT_SIZES["source"])),
                                          max(0, self.tree.column("source", "width") - 8)) if self.view_mode == self.PLAN_DAY_VIEW else "",
                ),
                tags=(tag,),
            )

            if self.view_mode == self.PLAN_DAY_VIEW:
                self._today_source_titles[row_id] = source_title
                # Tk 9 kann einzelne Zellen gestalten. Ältere Tk-Versionen
                # behalten die Quelle rechts in der normalen Zeilenfarbe.
                if getattr(self, "_tree_cell_tags_supported", True):
                    try:
                        self.tree.tk.call(str(self.tree), "tag", "cell", "add", "today_source", (row_id, "source"))
                    except tk.TclError:
                        self._tree_cell_tags_supported = False

        def abschnitt(kennung, text):
            """Eine aufklappbare Abschnittsüberschrift ohne eigene Punktzuordnung.

            Die Überschriften waren bis 3.24 flache Zeilen
            zwischen den Punkten – sie gliederten die Ansicht, ließen sich aber
            nicht schließen. In „Mein Tag“ steht unter „Eingang“ alles, was
            noch keinen Tag trägt; das kann die eigentliche Tagesplanung aus
            dem Bild schieben. Ein Abschnitt ist deshalb jetzt eine Elternzeile
            mit Aufklapppfeil, und sein Zustand übersteht den Neustart.
            """
            self.tree.insert("", "end", iid=kennung, text=text,
                             values=("", "", ""), tags=("group_item",),
                             open=self.overview_section_open(kennung))
            return kennung

        def zeilen(eintraege, parent=""):
            for due_value, _list_index, _item_index, source_list, item in eintraege:
                punktzeile(due_value, source_list, item, parent=parent)

        def tagesplan(eintraege, ueberschrift):
            """Die für den Tag eingeplanten Aufgaben, mit Zeitplan, wenn Uhrzeiten da sind."""
            if any(eintrag[4].get("planned_time") for eintrag in eintraege):
                # Zeitblöcke (AO-070): Punkte mit Uhrzeit chronologisch, die Dauer
                # aus der Schätzung. Überschneidungen werden benannt, nicht verschoben.
                bloecke = self.time_blocks([(eintrag[3], eintrag[4]) for eintrag in eintraege])
                ohne = [eintrag for eintrag in eintraege if not eintrag[4].get("planned_time")]
                erster, letzter = bloecke[0], bloecke[-1]
                abschnitt(self.TIMEPLAN_SECTION_ROW_ID,
                          f"{self.ICONS['timer']}  Zeitplan · "
                          + ("1 Block" if len(bloecke) == 1 else f"{len(bloecke)} Blöcke")
                          + f" · {erster['start']}–{letzter['end'] or letzter['start']}")
                for block in bloecke:
                    zeit = f"{block['start']}–{block['end']}" if block["end"] else block["start"]
                    hinweis = " · überschneidet sich" if block["overlap"] else ""
                    punktzeile(self.normalize_due(block["item"].get("due")) or "", block["entry"], block["item"],
                               parent=self.TIMEPLAN_SECTION_ROW_ID, prefix=f"{zeit}{hinweis}   ")
                if ohne:
                    abschnitt(self.UNTIMED_SECTION_ROW_ID, f"Ohne Uhrzeit · {len(ohne)}")
                    zeilen(ohne, self.UNTIMED_SECTION_ROW_ID)
            elif ueberschrift and eintraege:
                abschnitt(self.DAYPLAN_SECTION_ROW_ID,
                          f"{self.ICONS['today']}  Tagesplan · {len(eintraege)}")
                zeilen(eintraege, self.DAYPLAN_SECTION_ROW_ID)
            else:
                zeilen(eintraege)

        eingang = []
        if teile is not None:
            # „Heute“ (3.33.6, D14): oben die eine nächste Aufgabe, dann
            # Verspätetes und Liegengebliebenes, der Tagesplan und was heute
            # fällig ist. Jede Aufgabe steht genau einmal; künftige
            # Fälligkeiten zeigt „Demnächst“. An einem anderen Tag bleiben
            # der Tagesplan und was an diesem Tag fällig ist.
            if teile.naechste is not None:
                abschnitt(self.NEXT_TASK_SECTION_ROW_ID, f"{self.ICONS['next']}  Nächste Aufgabe")
                zeilen([teile.naechste], self.NEXT_TASK_SECTION_ROW_ID)
            if teile.verspaetet:
                abschnitt(self.OVERDUE_SECTION_ROW_ID,
                          f"{self.ICONS['overdue']}  Verspätet · {len(teile.verspaetet)} überfällig")
                zeilen(teile.verspaetet, self.OVERDUE_SECTION_ROW_ID)
            if teile.liegen:
                # Ohne Symbol: ◐ steht für „Demnächst“, und ein Symbol trägt
                # nur eine Bedeutung.
                abschnitt(self.LEFTOVER_SECTION_ROW_ID, f"Liegen geblieben · {len(teile.liegen)}")
                zeilen(teile.liegen, self.LEFTOVER_SECTION_ROW_ID)
            if not entries:
                # Ein leerer Tag bleibt als solcher erkennbar, auch wenn
                # darüber oder darunter andere Abschnitte Zeilen zeigen.
                self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, tags=("empty",), text=(
                    "Keine Aufgaben dieses Tages passen zu den aktuellen Filtern."
                    if self.has_active_filter()
                    else f"Für {self.format_plan_day()} ist nichts eingeplant."))
            tagesplan(teile.plan, teile.naechste is not None or bool(teile.verspaetet or teile.liegen))
            if teile.faellig:
                heute_gezeigt = self.plan_day() == date.today().isoformat()
                abschnitt(self.DUE_TODAY_SECTION_ROW_ID,
                          f"{self.ICONS['calendar']}  "
                          + ("Heute fällig" if heute_gezeigt else "An diesem Tag fällig")
                          + f" · {len(teile.faellig)}")
                zeilen(teile.faellig, self.DUE_TODAY_SECTION_ROW_ID)
            if routinen:
                # Routinen (AU06): wiederkehrende Checklisten des Nutzers, ohne
                # Gewohnheitsstatistik. Abhaken wirkt auf den Punkt der Routine;
                # Punkte, die oben schon stehen, erscheinen nicht doppelt.
                abschnitt(self.ROUTINES_SECTION_ROW_ID, f"{self.ICONS['check']}  Routinen · {len(routinen)}")
                for zeile in routinen:
                    quelle = next((entry for entry in self.lists if entry.get("id") == zeile["list_id"]), None)
                    if quelle is None:
                        continue
                    kopf = self.tree.insert(self.ROUTINES_SECTION_ROW_ID, "end",
                                            iid=self.ROUTINE_ROW_PREFIX + zeile["list_id"],
                                            text=glide_routines.summary(zeile), values=("", "", ""),
                                            tags=("group_item",),
                                            open=self.overview_section_open(self.ROUTINE_ROW_PREFIX + zeile["list_id"]))
                    offen = set(zeile["open"])
                    for item in self.walk_items(quelle.get("items", [])):
                        if item.get("id") in offen and not self.tree.exists(f"in-progress:{zeile['list_id']}:{item['id']}"):
                            punktzeile(self.normalize_due(item.get("due")) or "", quelle, item, parent=kopf)
            if teile.demnaechst:
                anzahl = len(teile.demnaechst)
                self.tree.insert("", "end", iid=self.UPCOMING_LINK_ROW_ID, values=("", "", ""), tags=("empty",),
                                 text=f"{self.ICONS['in_progress']}  Demnächst · {anzahl} weitere "
                                      + ("Fälligkeit" if anzahl == 1 else "Fälligkeiten")
                                      + " – Doppelklick öffnet")
            eingang = teile.eingang
        else:
            # „Demnächst“ (bis 3.33.5 „In Bearbeitung“) zeigt alle offenen
            # Fälligkeiten chronologisch; das Überfällige steht oben unter
            # eigener Überschrift. Die nächste Aufgabe gehört seit D14 nach
            # „Heute“ – hier wäre sie eine zweite Antwort auf dieselbe Frage.
            ueberfaellig = []
            if self.view_mode == "in_progress":
                ueberfaellig = [eintrag for eintrag in entries
                                if not eintrag[4].get("done") and self.due_status(eintrag[4]) == "overdue"]
            if ueberfaellig:
                ueberfaellige_ids = {id(eintrag) for eintrag in ueberfaellig}
                uebrige = [eintrag for eintrag in entries if id(eintrag) not in ueberfaellige_ids]
                abschnitt(self.OVERDUE_SECTION_ROW_ID,
                          f"{self.ICONS['overdue']}  Verspätet · {len(ueberfaellig)} überfällig")
                zeilen(ueberfaellig, self.OVERDUE_SECTION_ROW_ID)
                if uebrige:
                    abschnitt(self.IN_PROGRESS_SECTION_ROW_ID,
                              f"{self.ICONS['in_progress']}  Noch offen · {len(uebrige)}")
                    zeilen(uebrige, self.IN_PROGRESS_SECTION_ROW_ID)
            else:
                zeilen(entries)

        # Was noch im Eingang liegt und keinen Tag trägt,
        # steht am Ende derselben Ansicht. So ist die Frage „was mache ich
        # heute" und die Frage „was ist noch unsortiert" ein Blick statt zwei.
        if eingang:
            abschnitt(self.PLAN_INBOX_HEADING_ROW_ID,
                      f"Eingang \u00b7 {len(eingang)} ohne Bearbeitungstag")
            for source_list, item in eingang[:self.PLAN_INBOX_VISIBLE]:
                item_id = item.get("id") or uuid.uuid4().hex
                item["id"] = item_id
                list_id = source_list.get("id")
                row_id = f"in-progress:{list_id}:{item_id}"
                self.in_progress_item_sources[row_id] = (list_id, item_id)
                importance = self.clamp_importance(item.get("importance", 0))
                flag_prefix = self.IMPORTANCE_MARKERS.get(importance, "")
                description_suffix = f"   {self.ICONS['description']}" if str(item.get("description") or "").strip() else ""
                self.tree.insert(
                    self.PLAN_INBOX_HEADING_ROW_ID, "end", iid=row_id,
                    text=f"{self.list_path_title(source_list, ellipsize=True)}   —   "
                         f"{flag_prefix}{self.item_display_text(item)}{description_suffix}",
                    values=(
                        self.item_date_text(item),
                        self.format_item_labels(item),
                        "",
                    ),
                    tags=("priority_low",),
                )
            if len(eingang) > self.PLAN_INBOX_VISIBLE:
                self.tree.insert(
                    self.PLAN_INBOX_HEADING_ROW_ID, "end", iid=self.PLAN_INBOX_MORE_ROW_ID,
                    text=f"… und {len(eingang) - self.PLAN_INBOX_VISIBLE} weitere im Eingang",
                    values=("", "", ""), tags=("empty",),
                )
        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
            self.see_unless_folded(current_selection)
        self.finish_tree_refresh()

    def label_view_groups(self, apply_filters=True):
        """Punkte des gesamten Bestands, gruppiert nach ihren eigenen Labels.

        Die Reihenfolge folgt der Labelverwaltung; ein Punkt mit mehreren
        Labels steht in jeder zugehörigen Gruppe. Die beiden festen Labels
        bleiben außen vor: Sie tragen die Art eines Punkts, und ein Zug in eine
        solche Gruppe würde den Punkt umwandeln statt ihn zu etikettieren.
        Die Gruppe „Ohne Label“ sammelt nur echte Aufgaben – Gruppen und
        Zwischenüberschriften sind Gliederung und ohne Label kein Rückstand.
        """
        query = self.current_search_query() if apply_filters else ""
        gruppen = {}
        for label in self.labels:
            if self.is_system_label(label):
                continue
            gruppen[label.get("id")] = (label, [])
        ohne = []
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if apply_filters and (
                    not self.item_text_matches_query(item, query)
                    or not self.item_matches_status_filter(item)
                ):
                    continue
                eigene = self.column_labels(item)
                if not eigene:
                    if self.is_schedulable_item(item):
                        ohne.append((entry, item))
                    continue
                for label in eigene:
                    gruppe = gruppen.get(label.get("id"))
                    if gruppe is not None:
                        gruppe[1].append((entry, item))
        ergebnis = [
            (label.get("id"), label, eintraege)
            for label, eintraege in gruppen.values()
        ]
        ergebnis.append((self.UNLABELLED_GROUP_KEY, None, ohne))
        return ergebnis

    def label_view_row_text(self, source_list, item):
        """Zeilentext eines Punkts in der Labelansicht: Herkunft und Punkt."""
        importance = self.clamp_importance(item.get("importance", 0))
        flag_prefix = self.IMPORTANCE_MARKERS.get(importance, "")
        done_prefix = "✓ " if item.get("done") else ""
        number_path = self.get_item_number_path(item.get("id"), source_list.get("items", [])) or []
        number_text = ".".join(str(part) for part in number_path)
        task_prefix = f"{number_text}. " if number_text else ""
        source_title = self.list_path_title(source_list, ellipsize=True)
        attachment_count = len(item.get("attachments", []))
        attachment_suffix = (
            f"   {self.ICONS['attachment']} {attachment_count}" if attachment_count else ""
        )
        # Anders als in „In Bearbeitung“ steht hier der Punkt vorn und die
        # Herkunft dahinter: Die Gruppe nennt bereits das Label, und wenn die
        # Spalte eng wird, darf der Listenpfad weichen – nicht der Punkttext.
        return (
            f"{task_prefix}{flag_prefix}{done_prefix}{self.item_display_text(item)}"
            f"{attachment_suffix}   —   {source_title}"
        )

    def refresh_label_overview(self, selected_id=None):
        """Zeigt den gesamten Bestand nach Labels gruppiert, in Labelfarbe."""
        if not hasattr(self, "tree"):
            return
        self.update_stats_label()
        current_selection = selected_id or self.tree.focus()
        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)
        self.in_progress_item_sources = {}
        self.label_view_row_groups = {}

        gruppen = self.label_view_groups(apply_filters=True)
        sichtbar = [eintrag for eintrag in gruppen if eintrag[2] or eintrag[1] is not None]
        if not any(eintraege for _key, _label, eintraege in gruppen):
            empty_text = (
                "Keine Punkte passen zum aktuellen Filter."
                if self.has_active_filter()
                else "Noch keine Labels vergeben. Labels entstehen im Rechtsklickmenü eines Punkts."
            )
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text=empty_text, tags=("empty",))
            self.finish_tree_refresh()
            return

        for key, label, eintraege in sichtbar:
            if label is None and not eintraege:
                continue
            color_key = self.resolve_label_color(label.get("color")) if label else None
            group_row = f"{self.LABEL_GROUP_ROW_PREFIX}{key}"
            # „Ohne Label“ trägt bewusst kein Symbol: Die Symboltabelle hat
            # keines für „nichts vergeben“, und ein geliehenes führte in die Irre.
            titel = f"{self.LABEL_COLUMN_ICON} {label.get('name', '')}" if label else "Ohne Label"
            self.tree.insert(
                "",
                "end",
                iid=group_row,
                text=f"{titel}   ({len(eintraege)})",
                open=group_row not in self.settings.get("label_sections_closed", []),
                tags=(f"itemcolor_{color_key}",) if color_key else ("heading",),
            )
            for source_list, item in eintraege:
                item_id = item.get("id")
                if not item_id:
                    continue
                row_id = f"{self.LABEL_ITEM_ROW_PREFIX}{key}:{item_id}"
                if self.tree.exists(row_id):
                    continue
                self.in_progress_item_sources[row_id] = (source_list.get("id"), item_id)
                self.label_view_row_groups[row_id] = key
                due_value = self.normalize_due(item.get("due"))
                due_text = (
                    f"{self.DUE_COLUMN_ICON} {self.format_due_column(due_value, item.get('due_time'))}"
                    if due_value
                    else ""
                )
                self.tree.insert(
                    group_row,
                    "end",
                    iid=row_id,
                    text=self.label_view_row_text(source_list, item),
                    values=(
                        due_text,
                        self.format_item_labels(item, exclude_id=key if label else None),
                        "",
                    ),
                    tags=(f"itemcolor_{color_key}",) if color_key else ("open",),
                )

        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
            self.see_unless_folded(current_selection)
        self.finish_tree_refresh()

    def label_group_key_from_iid(self, iid):
        """Labelgruppe, zu der eine Zeile der Labelansicht gehört."""
        if not isinstance(iid, str):
            return None
        if iid.startswith(self.LABEL_GROUP_ROW_PREFIX):
            return iid[len(self.LABEL_GROUP_ROW_PREFIX):]
        return self.label_view_row_groups.get(iid)

    def move_item_to_label_group(self, row_id, target_key):
        """Vergibt beim Ziehen das Label der Zielgruppe und nimmt das der Quelle.

        Alle übrigen Labels des Punkts bleiben unangetastet: Wer einen Punkt von
        „Kunde“ nach „Intern“ zieht, meint diesen einen Wechsel und nicht das
        Löschen seiner anderen Labels. Das neue Label tritt an die Stelle des
        alten, damit die Reihenfolge – und damit das in der Liste sichtbare
        erste Label – erhalten bleibt.
        """
        source = self.in_progress_item_sources.get(row_id)
        source_key = self.label_view_row_groups.get(row_id)
        if not source or source_key is None or target_key is None or source_key == target_key:
            return False
        _list_id, item_id = source
        found = self.find_item_in_lists(item_id)
        if not found:
            return False
        item = found[0]
        vorher = [value for value in (item.get("labels") or []) if isinstance(value, str)]
        nachher = list(vorher)
        ziel_neu = target_key != self.UNLABELLED_GROUP_KEY and target_key not in nachher
        if source_key != self.UNLABELLED_GROUP_KEY and source_key in nachher:
            position = nachher.index(source_key)
            if ziel_neu:
                nachher[position] = target_key
            else:
                nachher.pop(position)
        elif ziel_neu:
            # Grenze bewusst prüfen: Ein Zug darf keinen Punkt über das erlaubte
            # Maß hinaus etikettieren, und bestehende Labels werden nicht
            # stillschweigend abgeschnitten.
            if len(nachher) >= self.MAX_LABELS_PER_ITEM:
                self.show_info(
                    "Labels",
                    f"Dieser Punkt trägt bereits {self.MAX_LABELS_PER_ITEM} Labels. "
                    "Entferne zuerst eines, bevor ein weiteres dazukommt.",
                )
                return False
            nachher.append(target_key)
        if nachher == vorher:
            return False
        with self.item_change((), restore=False) as change:
            item["labels"] = nachher
            change.mark()
        neue_zeile = f"{self.LABEL_ITEM_ROW_PREFIX}{target_key}:{item_id}"
        if self.tree.exists(neue_zeile):
            self.tree.selection_set(neue_zeile)
            self.tree.focus(neue_zeile)
            self.tree.see(neue_zeile)
        return True

    def on_label_view_drag_start(self, event):
        """Merkt den angefassten Punkt der Labelansicht."""
        row_id = self.tree.identify_row(event.y)
        self.drag_start_id = None
        self.drag_item_ids = []
        self.drag_has_moved = False
        if row_id and row_id.startswith(self.LABEL_GROUP_ROW_PREFIX):
            self.toggle_tree_row_open(row_id)
            return "break"
        if not row_id or row_id not in self.in_progress_item_sources:
            return "break"
        self.drag_start_id = row_id
        self.drag_start_x = event.x
        self.drag_start_y = event.y
        self.tree.selection_set(row_id)
        self.tree.focus(row_id)
        return "break"

    def on_label_view_drag_motion(self, event):
        """Hebt die Gruppe hervor, in die der Punkt fallen würde."""
        if not self.drag_start_id:
            return "break"
        if abs(event.x - self.drag_start_x) + abs(event.y - self.drag_start_y) > 6:
            self.drag_has_moved = True
        self.clear_drop_target_tags()
        target_key = self.label_group_key_from_iid(self.identify_tree_drop_row(event))
        if target_key and target_key != self.label_view_row_groups.get(self.drag_start_id):
            group_row = f"{self.LABEL_GROUP_ROW_PREFIX}{target_key}"
            try:
                tags = set(self.tree.item(group_row, "tags"))
                tags.add("drop_target")
                self.tree.item(group_row, tags=tuple(tags), open=True)
            except tk.TclError:
                pass
        return "break"

    def on_label_view_drag_end(self, event):
        """Legt den Punkt in der Zielgruppe ab und tauscht dabei das Label."""
        row_id = self.drag_start_id
        moved = self.drag_has_moved
        self.clear_drop_target_tags()
        self.drag_start_id = None
        self.drag_item_ids = []
        if not row_id or not moved:
            return "break"
        target_key = self.label_group_key_from_iid(self.identify_tree_drop_row(event))
        if target_key is None:
            return "break"
        self.move_item_to_label_group(row_id, target_key)
        return "break"

    def refresh_trash_overview(self, selected_id=None):
        """Zeigt alle gelöschten Listen und Ordner mit Herkunft und Löschzeitpunkt."""
        if not hasattr(self, "tree"):
            return
        self.update_stats_label()
        current_selection = selected_id or self.tree.focus()
        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)

        query = self.current_search_query()
        entries = list(self.trash)
        if query:
            entries = [entry for entry in entries if query in self.trash_entry_title(entry).lower()]
        if not entries:
            empty_text = (
                "Kein Eintrag im Papierkorb passt zur aktuellen Suche."
                if query
                else "Der Papierkorb ist leer. Gelöschte Punkte, Listen und Ordner landen hier und bleiben wiederherstellbar."
            )
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, text=empty_text, tags=("empty",))
            self.finish_tree_refresh()
            return

        for entry in entries:
            payload = self.trash_entry_payload(entry) or {}
            title = self.trash_entry_title(entry)
            kind = entry.get("kind")
            is_folder = kind == self.TRASH_KIND_FOLDER
            is_item = kind == self.TRASH_KIND_ITEM
            if is_folder:
                detail = "Ordner"
                related = sum(
                    1
                    for other in self.trash
                    if other.get("kind") == self.TRASH_KIND_LIST
                    and other.get("origin_folder_id") == payload.get("id")
                )
                if related:
                    detail += f" · {related} Liste(n) im Papierkorb"
            elif is_item:
                detail = self.ITEM_KIND_LABELS.get(self.item_kind(payload), "Punkt")
                children = self.count_items(payload.get("children", []))
                if children:
                    detail += f" · {children} Unterpunkt(e)"
                origin_title = str((entry.get("origin") or {}).get("list_title") or "").strip()
                if origin_title:
                    detail += f" · aus „{origin_title}“"
            else:
                detail = f"Liste · {self.count_items(payload.get('items', []))} Punkte"
                origin = str(entry.get("origin_folder_title") or "").strip()
                if origin:
                    detail += f" · aus „{origin}“"
            marker = "\U0001F4C1" if is_folder else ("•" if is_item else "▸")
            row_text = f"{marker}  {title}   —   {detail}"
            color_key = payload.get("color") if payload.get("color") in self.LIST_COLOR_KEYS else None
            tags = (f"listcolor_{color_key}",) if color_key else ("folder_list",)
            self.tree.insert(
                "",
                "end",
                iid=f"trash:{entry.get('id')}",
                text=row_text,
                values=(f"\U0001F5D1 {self.format_trash_timestamp(entry.get('deleted_at'))}", "", ""),
                tags=tags,
            )

        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
        self.finish_tree_refresh()

    @staticmethod
    def format_trash_timestamp(value, with_time=False):
        try:
            parsed = datetime.fromisoformat(str(value))
        except (TypeError, ValueError):
            return ""
        return parsed.strftime("%d.%m.%Y %H:%M" if with_time else "%d.%m.%Y")

    def build_trash_context_menu(self, row_id=None):
        """Kontextmenü des Papierkorbs – für eine Zeile oder den leeren Bereich."""
        trash_ids = self.get_selected_trash_ids()
        menu = self._new_themed_popup_menu()
        if trash_ids:
            if len(trash_ids) == 1:
                entry = self.get_trash_entry(trash_ids[0])
                menu.add_command(label=self.ellipsize_sidebar_title(self.trash_entry_title(entry)), state="disabled")
            else:
                menu.add_command(label=f"{len(trash_ids)} Einträge ausgewählt", state="disabled")
        else:
            menu.add_command(label=f"Papierkorb ({len(self.trash)})", state="disabled")
        menu.add_separator()
        menu.add_command(
            label="Wiederherstellen",
            command=lambda: self.restore_selected_trash_entries(False),
            state="normal" if trash_ids else "disabled",
        )
        menu.add_command(
            label="In Ordner wiederherstellen …",
            command=lambda: self.restore_selected_trash_entries(True),
            state="normal" if trash_ids and self.folders else "disabled",
        )
        menu.add_separator()
        menu.add_command(
            label="Endgültig entfernen",
            command=self.purge_selected_trash_entries,
            foreground=self.theme["delete"],
            state="normal" if trash_ids else "disabled",
        )
        menu.add_command(
            label="Papierkorb leeren",
            command=self.empty_trash,
            foreground=self.theme["delete"],
            state="normal" if self.trash else "disabled",
        )
        return menu

    def refresh_folder_overview(self, selected_id=None):
        """Zeigt die im ausgewählten Ordner enthaltenen Listen im Hauptbereich."""
        if not hasattr(self, "tree"):
            return
        self.update_stats_label()
        current_selection = selected_id or self.tree.focus()
        for row_id in self.tree.get_children(""):
            self.tree.delete(row_id)

        folder_lists = self.get_folder_lists(self.active_folder_id)
        sub_folders = self.get_child_folders(self.active_folder_id)
        current_folder = self.get_folder(self.active_folder_id)
        journal_view = bool(current_folder and current_folder.get("folder_kind") == "journal")
        if journal_view:
            # ZF-120: jede Inhaltsart nach Momentdatum, dann Erstellung und
            # Kennung – gleiche Tage bleiben damit reproduzierbar geordnet.
            folder_lists.sort(key=self.journal_sort_key, reverse=True)
            von, bis = self.journal_filter_range(self.active_folder_id)
            if von or bis:
                folder_lists = [entry for entry in folder_lists
                                if self.journal_in_range(entry, von, bis)]
        query = self.current_search_query()
        if query:
            filtered_lists = []
            for entry in folder_lists:
                journal_text = " ".join(str(value) for value in (entry.get("journal") or {}).values())
                rich_text = str((entry.get("rich_note") or {}).get("text") or "")
                label_text = str(self.format_item_labels(entry) or "")
                page_text = (f"{entry.get('title', '')} {entry.get('note', '')} {journal_text} {rich_text} "
                             f"{label_text}").lower()
                task_match = any(self.item_text_matches_query(item, query) for item in self.walk_items(entry.get("items", [])))
                if query in page_text or task_match:
                    filtered_lists.append(entry)
            folder_lists = filtered_lists
            sub_folders = [
                entry
                for entry in sub_folders
                if query in f"{entry.get('title', '')} {entry.get('note', '')}".lower()
                or any(
                    query in f"{value.get('title', '')} {value.get('note', '')}".lower()
                    for value in self.get_folder_lists_recursive(entry.get("id"))
                )
            ]

        # Die Bibliothek zeichnet ihre Ordner selbst mit den Tabellenspalten.
        # Vorher wurden dieselben Kennungen hier UND dort eingefügt.
        if current_folder and current_folder.get("folder_kind") == "library":
            return self.refresh_library_table(folder_lists, sub_folders, current_selection)

        # Unterordner stehen über den Listen: erst die Struktur, dann der Inhalt.
        for entry in sub_folders:
            sub_id = entry.get("id")
            contained = len(self.get_folder_lists_recursive(sub_id))
            nested = len(self.get_child_folders(sub_id))
            detail = f"{contained} Liste(n)"
            if nested:
                detail += f" · {nested} Unterordner"
            note_marker = f"  {self.ICONS['description']}" if str(entry.get("note") or "").strip() else ""
            row_text = f"{self.ICONS['folder']}  {entry.get('title', 'Ordner')}   —   {detail}{note_marker}"
            color_key = entry.get("color") if entry.get("color") in self.LIST_COLOR_KEYS else None
            tags = (f"listcolor_{color_key}",) if color_key else ("group_item",)
            self.tree.insert(
                "", "end", iid=f"folder-folder:{sub_id}", text=row_text,
                values=("", self.format_item_labels(entry), ""),
                tags=tags,
            )

        if not folder_lists and not sub_folders:
            empty_text = (
                "Keine Listen oder Inhalte passen zur aktuellen Suche."
                if query
                else "Im gewählten Zeitraum gibt es keine Einträge."
                if journal_view and any(self.journal_filter_range(self.active_folder_id))
                else (
                    "Noch keine Einträge in diesem Notizbuch. Oben kann direkt der erste Eintrag angelegt werden."
                    if journal_view else
                    "Noch keine Listen in diesem Ordner. Oben kann direkt eine neue Liste angelegt werden."
                )
            )
            self.tree.insert(
                "",
                "end",
                iid=self.EMPTY_ROW_ID,
                text=empty_text,
                tags=("empty",),
            )
            self.finish_tree_refresh()
            return

        for entry in folder_lists:
            drawing = self.is_drawing_list(entry)
            if journal_view:
                journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
                mood_label = dict(self.JOURNAL_MOODS).get(journal.get("mood"), "")
                detail_parts = []
                if journal.get("moment_date"):
                    try:
                        detail_parts.append(date.fromisoformat(journal["moment_date"]).strftime("%d.%m.%Y"))
                    except ValueError:
                        pass
                if mood_label and journal.get("mood"):
                    detail_parts.append(mood_label)
                if journal.get("location"):
                    detail_parts.append(journal["location"])
                favorite = "★  " if journal.get("favorite") else ""
                # Jede Zeile nennt Momentdatum und Inhaltsart (ZF-120).
                detail_parts.append(self.journal_kind_name(entry))
                if drawing:
                    detail_parts.append(self.drawing_summary(entry))
                elif entry.get("list_kind") != "note":
                    total, done, _overdue = self.list_metrics(entry["id"]).stats
                    detail_parts.append(f"{total} Punkte · {total - done} offen")
                detail = " · ".join(detail_parts) or "Notizbucheintrag"
                marker = self.ICONS["drawing"] if drawing else self.ICONS["board"] if self.journal_kind_name(
                    entry) == "Pinnwand" else "▸"
                row_text = f"{favorite}{marker}  {entry.get('title', 'Eintrag')}   —   {detail}"
                iid = f"folder-list:{entry.get('id')}"
                color_key = entry.get("color") if entry.get("color") in self.LIST_COLOR_KEYS else None
                tags = (f"listcolor_{color_key}",) if color_key else ("folder_list",)
                self.tree.insert("", "end", iid=iid, text=row_text,
                                 values=("", self.format_item_labels(entry), ""), tags=tags)
                continue
            total, done, overdue = self.list_metrics(entry["id"]).stats
            open_count = total - done
            detail = f"{total} Punkte · {open_count} offen"
            if total:
                detail += f" · {round(done / total * 100)} % erledigt"
            if overdue:
                detail += f" · {overdue} überfällig"
            if drawing:
                detail = self.drawing_summary(entry)
            note_marker = f"  {self.ICONS['description']}" if str(entry.get("note") or "").strip() else ""
            marker = self.ICONS["drawing"] if drawing else "▸"
            row_text = f"{marker}  {entry.get('title', 'Liste')}   —   {detail}{note_marker}"
            iid = f"folder-list:{entry.get('id')}"
            color_key = entry.get("color") if entry.get("color") in self.LIST_COLOR_KEYS else None
            tags = (f"listcolor_{color_key}",) if color_key else ("folder_list",)
            # Labels einer Liste erscheinen ausschließlich in dieser großen
            # Darstellung, nicht in der Seitenleiste.
            self.tree.insert(
                "", "end", iid=iid, text=row_text,
                values=("", self.format_item_labels(entry), ""),
                tags=tags,
            )

        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
        self.finish_tree_refresh()

    # Bibliothek als Tabelle (Entscheidung des Nutzers vom 27.09.2026). Die
    # Felder sind Glide-weit dieselben: Titel, Beschreibung, Farbe, Labels,
    # Aufgaben (die Checkliste einer Seite) und Erstellungsdatum.
    LIBRARY_COLUMNS = ("title", "note", "color", "labels", "tasks", "created")
    LIBRARY_COLUMN_LABELS = {"title": "Titel", "note": "Beschreibung", "color": "Farbe", "labels": "Labels",
                             "tasks": "Aufgaben", "created": "Erstellt"}
    LIBRARY_COLUMN_WIDTHS = {"title": 260, "note": 260, "color": 90, "labels": 160, "tasks": 96, "created": 104}

    def library_row_values(self, entry):
        """Die Zellen einer Seite in der Bibliothekstabelle."""
        beschreibung = " ".join(str(entry.get("note") or "").split())
        if len(beschreibung) > 70:
            beschreibung = beschreibung[:69].rstrip() + "…"
        farben = {key: label for label, key in self.LIST_COLOR_CHOICES}
        punkte = [item for item in self.walk_items(entry.get("items", [])) if self.is_schedulable_item(item)]
        erledigt = sum(1 for item in punkte if item.get("done"))
        try:
            erstellt = datetime.fromisoformat(str(entry.get("created_at") or "")).strftime("%d.%m.%Y")
        except ValueError:
            erstellt = "—"
        return {
            "title": str(entry.get("title") or "Seite"),
            "note": beschreibung or "—",
            "color": farben.get(entry.get("color"), "—"),
            "labels": self.format_item_labels(entry) or "—",
            "tasks": f"{erledigt} von {len(punkte)}" if punkte else "—",
            "created": erstellt,
            "_sort_created": str(entry.get("created_at") or ""),
            "_sort_tasks": (len(punkte) - erledigt, len(punkte)),
        }

    def is_library_view(self):
        ordner = self.get_folder(self.active_folder_id) if self.view_mode == "folder" else None
        return bool(ordner and ordner.get("folder_kind") == "library")

    def sort_library_by(self, column):
        spalte, absteigend = getattr(self, "_library_sort", ("title", False))
        self._library_sort = (column, not absteigend if column == spalte else False)
        self.refresh_folder_overview()

    def refresh_library_table(self, folder_lists, sub_folders, current_selection=None):
        """Die Seiten einer Bibliothek als Tabelle, sortierbar über die Überschriften."""
        spalten = self.LIBRARY_COLUMNS[1:]
        self.tree.configure(show="tree headings", columns=spalten, displaycolumns=spalten)
        sortiert, absteigend = getattr(self, "_library_sort", ("title", False))
        pfeil = self.ICONS["sort_descending" if absteigend else "sort_ascending"]
        for spalte in self.LIBRARY_COLUMNS:
            beschriftung = self.LIBRARY_COLUMN_LABELS[spalte] + (f"  {pfeil}" if spalte == sortiert else "")
            kennung = "#0" if spalte == "title" else spalte
            self.tree.heading(kennung, text=beschriftung, anchor="w",
                              command=lambda wert=spalte: self.sort_library_by(wert))
            self.tree.column(kennung, anchor="w", stretch=spalte in ("title", "note"),
                             width=self.LIBRARY_COLUMN_WIDTHS[spalte], minwidth=60)
        for entry in sub_folders:
            self.tree.insert("", "end", iid=f"folder-folder:{entry.get('id')}",
                             text=f"{self.ICONS['folder']}  {entry.get('title', 'Ordner')}",
                             values=("—", "—", "—", "—", "—"), tags=("group_item",))
        zeilen = [(entry, self.library_row_values(entry)) for entry in folder_lists]
        schluessel = {"created": lambda paar: paar[1]["_sort_created"],
                      "tasks": lambda paar: paar[1]["_sort_tasks"]}.get(
            sortiert, lambda paar: str(paar[1].get(sortiert, "")).casefold())
        zeilen.sort(key=schluessel, reverse=absteigend)
        if not zeilen and not sub_folders:
            self.tree.insert("", "end", iid=self.EMPTY_ROW_ID, tags=("empty",),
                             text="Noch keine Seiten in diesem Buch. Oben entsteht mit Enter eine neue Seite.")
        for entry, werte in zeilen:
            farbe = entry.get("color") if entry.get("color") in self.LIST_COLOR_KEYS else None
            self.tree.insert("", "end", iid=f"folder-list:{entry.get('id')}", text=werte["title"],
                             values=tuple(werte[spalte] for spalte in spalten),
                             tags=(f"listcolor_{farbe}",) if farbe else ("folder_list",))
        if current_selection and self.tree.exists(current_selection):
            self.tree.selection_set(current_selection)
            self.tree.focus(current_selection)
        self.finish_tree_refresh()

    def journal_sort_key(self, entry):
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        return (journal.get("moment_date") or "", str(entry.get("created_at") or ""), str(entry.get("id") or ""))

    def journal_kind_name(self, entry):
        if self.is_drawing_list(entry):
            return "Zeichnung"
        if self.is_gallery_list(entry):
            return "Galerie"
        if self.is_page_list(entry):
            return "Seite"
        if entry.get("list_kind") == "note":
            return "Notiz"
        if (self.settings.get("active_tab") or {}).get("list:" + str(entry.get("id"))) == "board":
            return "Pinnwand"
        return "Aufgabenliste"

    def journal_filter_range(self, folder_id):
        """(von, bis) des Tagebuchfilters dieses Ordners; beide leer = alle Tage."""
        filtern = (getattr(self, "_journal_filters", None) or {}).get(folder_id) or {}
        return filtern.get("from"), filtern.get("to")

    def journal_in_range(self, entry, von, bis):
        tag = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", "")).get("moment_date")
        if not tag:
            return False
        return (not von or tag >= von) and (not bis or tag <= bis)

    def set_journal_filter(self, folder_id, von=None, bis=None):
        """Tagesfilter (von == bis) oder inklusiver Von-bis-Filter; ohne Werte alle Tage."""
        filters = dict(getattr(self, "_journal_filters", None) or {})
        if von and bis and von > bis:
            von, bis = bis, von
        if von or bis:
            filters[folder_id] = {"from": von, "to": bis}
        else:
            filters.pop(folder_id, None)
        self._journal_filters = filters
        self.sync_journal_filter_button()
        self.refresh_tree()
        return "break"

    def journal_filter_text(self, folder_id):
        von, bis = self.journal_filter_range(folder_id)
        if not von and not bis:
            return "Zeitraum: alle Tage"
        def kurz(value):
            return date.fromisoformat(value).strftime("%d.%m.%Y") if value else "…"
        if von == bis:
            return f"Tag: {kurz(von)}"
        return f"Zeitraum: {kurz(von)} – {kurz(bis)}"

    def sync_journal_filter_button(self):
        knopf = getattr(self, "journal_filter_button", None)
        if knopf is not None:
            knopf.set_text(self.journal_filter_text(self.active_folder_id))

    def show_journal_filter_dialog(self, event=None):
        """Tag oder Zeitraum für das Tagebuch wählen – beide Grenztage zählen mit."""
        folder_id = self.active_folder_id
        if not folder_id:
            return "break"
        von, bis = self.journal_filter_range(folder_id)
        dialog = tk.Toplevel(self.root)
        dialog.title("Notizbuch filtern")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.resizable(False, False)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(body, text="Notizbuch filtern", bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(15, "bold"), anchor="w").pack(anchor="w")
        tk.Label(body, text="Für einen einzelnen Tag nur „Von“ ausfüllen. Die Volltextsuche wirkt zusätzlich.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10), wraplength=420,
                 justify="left").pack(anchor="w", pady=(4, 12))
        tk.Label(body, text="Von", bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10)).pack(anchor="w")
        von_feld = DueField(body, self, due=von, compact=True, dialog_parent=dialog, show_time=False)
        von_feld.pack(fill="x", pady=(2, 8))
        tk.Label(body, text="Bis", bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10)).pack(anchor="w")
        bis_feld = DueField(body, self, due=bis if bis != von else None, compact=True, dialog_parent=dialog,
                            show_time=False)
        bis_feld.pack(fill="x", pady=(2, 8))
        fehler = tk.Label(body, text="", bg=self.theme["bg"], fg=self.theme["delete"], anchor="w")
        fehler.pack(fill="x")
        ergebnis = {}

        def uebernehmen(_event=None):
            erster, meldung_a = von_feld.read()
            zweiter, meldung_b = bis_feld.read()
            if meldung_a or meldung_b:
                fehler.configure(text=meldung_a or meldung_b)
                return "break"
            anfang = erster[0] if erster else None
            ende = zweiter[0] if zweiter else None
            ergebnis["range"] = (anfang, ende or anfang)
            dialog.destroy()
            return "break"

        def alle():
            ergebnis["range"] = (None, None)
            dialog.destroy()

        leiste = tk.Frame(body, bg=self.theme["bg"])
        leiste.pack(fill="x", pady=(10, 0))
        self._make_dialog_button(leiste, "Filtern", uebernehmen, "confirm").pack(side="right")
        self._make_dialog_button(leiste, "Alle Tage", alle, "muted").pack(side="right", padx=(0, 8))
        self._make_dialog_button(leiste, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        dialog.bind("<Return>", uebernehmen)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=460)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        if "range" in ergebnis:
            self.set_journal_filter(folder_id, *ergebnis["range"])
        return "break"

    def edit_moment_date(self, list_id):
        """Momentdatum einer Seite im Tagebuch ändern – für jede Inhaltsart."""
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None:
            return "break"
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        antwort = self.themed_due_dialog(journal.get("moment_date") or date.today().isoformat(), None,
                                         title="Momentdatum", show_time=False)
        if not antwort or not antwort[0] or antwort[0] == journal.get("moment_date"):
            return "break"
        with self.sidebar_change(refresh_tree=True) as change:
            journal["moment_date"] = antwort[0]
            entry["journal"] = journal
            entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
            change.mark()
        return "break"

    @staticmethod
    def folder_list_id_from_iid(row_id):
        prefix = "folder-list:"
        if row_id and str(row_id).startswith(prefix):
            return str(row_id)[len(prefix):]
        return None

    @staticmethod
    def folder_folder_id_from_iid(row_id):
        """ID eines Unterordners in der Ordnerübersicht."""
        prefix = "folder-folder:"
        if row_id and str(row_id).startswith(prefix):
            return str(row_id)[len(prefix):]
        return None

    def get_selected_folder_list_id(self, event=None):
        row_id = ""
        if event is not None and self.is_mouse_event(event):
            row_id = self.tree.identify_row(event.y)
        if not row_id:
            row_id = self.tree.focus()
        return self.folder_list_id_from_iid(row_id)

    def activate_tree_row(self, event=None):
        self.cancel_item_rename()
        if self.view_mode == self.TABLE_VIEW:
            if self.detail_pane_applicable() and self.detail_pane_item() is not None:
                # Mit eingeschaltetem Detailbereich öffnet Enter den Bereich
                # statt der Maske; die Maske bleibt über „Alle Felder …“.
                self.sync_detail_pane(force=True)
                titel = self._detail_state["fields"].get("text")
                if titel is not None:
                    titel.focus_set()
                return "break"
            return self.edit_item()
        if self.view_mode in self.DERIVED_ITEM_VIEWS:
            return self.open_in_progress_source_item(event)
        if self.view_mode == "trash":
            return self.restore_selected_trash_entries(False)
        if self.view_mode == "folder":
            row_id = ""
            if event is not None and self.is_mouse_event(event):
                row_id = self.tree.identify_row(event.y)
            if not row_id:
                row_id = self.tree.focus()
            sub_folder_id = self.folder_folder_id_from_iid(row_id)
            if sub_folder_id and self.get_folder(sub_folder_id):
                self.set_active_folder(sub_folder_id)
                return "break"
            list_id = self.get_selected_folder_list_id(event)
            if list_id:
                self.set_active_list(list_id)
            return "break"
        return self.toggle_done(event)

    def overview_section_open(self, kennung):
        """Ob ein Abschnitt der Übersichten aufgeklappt ist."""
        return kennung not in set(self.settings.get("overview_sections_closed", []))

    def set_overview_section_open(self, kennung, offen):
        """Merkt sich den Zustand eines Abschnitts über die Sitzung hinaus."""
        zu = [wert for wert in self.settings.get("overview_sections_closed", [])
              if isinstance(wert, str)]
        if offen and kennung in zu:
            zu.remove(kennung)
        elif not offen and kennung not in zu:
            zu.append(kennung)
        else:
            return
        self.settings["overview_sections_closed"] = zu
        self.save_settings()

    def note_overview_section_state(self, event=None):
        """Merkt native Klappaktionen nach dem tatsächlichen Zustandswechsel."""
        if not hasattr(self, "tree"):
            return
        # Tk sendet TreeviewOpen VOR dem Zustandswechsel. Erst im Leerlauf
        # lesen; mehrere Ereignisse werden zu einem Speicheraufruf gebündelt.
        if getattr(self, "_tree_open_state_pending", False):
            return
        self._tree_open_state_pending = True

        def remember():
            self._tree_open_state_pending = False
            self.remember_tree_open_states()

        self.root.after_idle(remember)

    def remember_tree_open_states(self):
        """Merkt Abschnittszustände gemeinsam, ohne Aufgaben oder Undo zu ändern."""
        changed = False
        for setting, matches in (
            ("overview_sections_closed", lambda iid: iid in self.OVERVIEW_SECTION_ROW_IDS),
            ("group_sections_closed", self.is_group_section_row),
            ("label_sections_closed", lambda iid: iid.startswith(self.LABEL_GROUP_ROW_PREFIX)),
        ):
            old = self.settings.get(setting, [])
            closed = list(old)
            for iid in self.tree.get_children(""):
                if not matches(iid):
                    continue
                if self.tree.item(iid, "open"):
                    if iid in closed:
                        closed.remove(iid)
                elif iid not in closed:
                    closed.append(iid)
            if closed != old:
                self.settings[setting] = closed[-1000:]
                changed = True
        if self.view_mode in ("list", self.TABLE_VIEW):
            self.remember_expanded_state()
        if changed:
            self.save_settings()

    def toggle_tree_row_open(self, iid):
        """Klapppfeil in Ansichten mit eigener Drag-Klickbehandlung."""
        self.tree.focus(iid)
        self.tree.selection_set(iid)
        if self.tree.get_children(iid):
            self.tree.item(iid, open=not self.tree.item(iid, "open"))
            self.remember_tree_open_states()
        return "break"

    def open_next_task(self, event=None):
        """Führt auf die nächste Aufgabe – aus jeder Ansicht heraus.

        Die Startseite und das Menü brauchen einen Weg
        dorthin, der nicht voraussetzt, dass man weiß, in welchem Abschnitt
        welcher Ansicht sie steht. Seit 3.33.6 (D14) steht sie oben in „Heute“
        und ist dieselbe Aufgabe wie auf der Startseite.
        """
        self.set_overview_section_open(self.NEXT_TASK_SECTION_ROW_ID, True)
        self.set_today_view()
        eintrag = self.plan_day_sections().naechste
        if eintrag is None:
            return "break"
        zeile = f"in-progress:{eintrag[3].get('id')}:{eintrag[4].get('id')}"
        if hasattr(self, "tree") and self.tree.exists(zeile):
            self.tree.selection_set(zeile)
            self.tree.focus(zeile)
            self.tree.see(zeile)
        return "break"

    def open_in_progress_source_item(self, event=None):
        """Öffnet die echte Quellliste einer Zeile aus „Heute“ oder „Demnächst“."""
        row_id = ""
        if event is not None and self.is_mouse_event(event):
            row_id = self.tree.identify_row(event.y)
        if not row_id:
            row_id = self.tree.focus()
        # Die Abschnittsüberschriften sind keine
        # Punkte und tragen deshalb keine Quellzuordnung. Ein Doppelklick auf
        # sie führt dorthin, wofür der Abschnitt steht – auf den Eingang als
        # Liste beziehungsweise auf die Ansicht „Verspätet“.
        if row_id in (self.PLAN_INBOX_HEADING_ROW_ID, self.PLAN_INBOX_MORE_ROW_ID):
            return self.open_inbox_list()
        if row_id == self.OVERDUE_SECTION_ROW_ID:
            self.set_overdue_view()
            return "break"
        if row_id == self.UPCOMING_LINK_ROW_ID:
            self.set_in_progress_view()
            return "break"
        if row_id in (self.NEXT_TASK_SECTION_ROW_ID, self.IN_PROGRESS_SECTION_ROW_ID,
                      self.LEFTOVER_SECTION_ROW_ID, self.DAYPLAN_SECTION_ROW_ID,
                      self.DUE_TODAY_SECTION_ROW_ID, self.TIMEPLAN_SECTION_ROW_ID,
                      self.UNTIMED_SECTION_ROW_ID, self.ROUTINES_SECTION_ROW_ID):
            # Eine Abschnittsüberschrift klappt auf und zu; ein Doppelklick
            # darauf soll nichts anderes tun als das.
            return "break"
        if row_id.startswith(self.ROUTINE_ROW_PREFIX):
            # Die Zeile einer Routine steht für ihre Liste (AU06).
            list_id = row_id[len(self.ROUTINE_ROW_PREFIX):]
            if any(entry.get("id") == list_id for entry in self.lists):
                self.set_active_list(list_id)
                self.save_settings()
            return "break"
        source = self.in_progress_item_sources.get(row_id)
        if not source:
            return "break"
        list_id, item_id = source
        self.set_active_list(list_id, refresh=False)
        self.update_sidebar_list()
        self.refresh_tree(selected_id=item_id)
        self.reveal_tree_row(item_id)
        self.save_settings()
        return "break"

    def reveal_tree_row(self, item_id):
        """Klappt den Pfad zu einer Zeile auf, wählt sie und holt sie ins Bild.

        Derselbe Ablauf stand an zwei Stellen –
        beim Öffnen einer Aufgabe aus einer Übersicht und beim Sprung in die
        Quellliste. Eine der beiden fing `tk.TclError` ab, die andere nicht;
        das ist genau die Art Unterschied, die aus einer Kopie entsteht und
        die niemand beabsichtigt hat. Rückgabe: True, wenn die Zeile gefunden
        wurde.
        """
        if not item_id or not hasattr(self, "tree"):
            return False
        try:
            if not self.tree.exists(item_id):
                return False
            parent_id = self.tree.parent(item_id)
            while parent_id:
                self.tree.item(parent_id, open=True)
                self.expanded_ids.add(parent_id)
                self.collapsed_item_ids.discard(parent_id)
                parent_id = self.tree.parent(parent_id)
            self.tree.selection_set(item_id)
            self.tree.focus(item_id)
            self.tree.see(item_id)
        except tk.TclError:
            return False
        return True

    def insert_tree_items(self, parent_id, items, number_prefix):
        inserted_count = 0
        # Beide Zähler beginnen nach jeder Zwischenüberschrift wieder bei null:
        # position_index nummeriert ohne Filter, visible_index mit Filter.
        position_index = 0
        visible_index = 0
        query = self.current_search_query()

        for item in items:
            visible = self.item_visible_by_filter(item)

            if self.is_heading_item(item):
                if not visible:
                    continue
                item_id = item.get("id") or uuid.uuid4().hex
                item["id"] = item_id
                inserted_count += self.insert_heading_row(
                    parent_id, item, first_row=(parent_id == "" and inserted_count == 0)
                )
                position_index = 0
                visible_index = 0
                if item.get("children"):
                    inserted_count += self.insert_tree_items(
                        item_id, item.get("children", []), number_prefix
                    )
                continue

            position_index += 1
            if not visible:
                continue

            visible_index += 1
            # Ohne Filter bleibt die ursprüngliche Nummerierung erhalten. Mit Filter wird die sichtbare Ansicht sauber durchnummeriert.
            display_index = visible_index if self.has_active_filter() else position_index
            current_number = number_prefix + [display_index]
            gruppiert = getattr(self, "_group_number_paths", None)
            if gruppiert and item.get("id") in gruppiert:
                current_number = list(gruppiert[item["id"]])
            number_text = ".".join(str(part) for part in current_number)
            is_group = self.is_group_item(item)
            is_long = self.is_long_item(item)
            importance = 0 if is_group else self.clamp_importance(item.get("importance", 0))
            item["importance"] = importance
            flag_prefix = self.IMPORTANCE_MARKERS.get(importance, "")
            done_prefix = "✓ " if item.get("done") and not is_group else ""
            due_state = "" if is_group else self.due_status(item)
            due_text = "" if is_group else self.format_due_column(item.get("due"), item.get("due_time"))
            due_value = "" if is_group else self.item_date_text(item)
            # Im kompakten Modus bleibt die Zeile bei Titel,
            # Termin und Labels. Die Symbole sind Hinweise auf mehr Inhalt –
            # wer bewusst weniger sehen will, braucht auch die nicht.
            kompakt = self.list_detail_mode() == "compact"
            description_suffix = ("" if kompakt or not str(item.get("description") or "").strip()
                                  else f"   {self.ICONS['description']}")
            attachment_count = len(item.get("attachments", []))
            attachment_suffix = (
                "" if kompakt or not attachment_count
                else f"   {self.ICONS['attachment']} {attachment_count}"
            )
            repeat_suffix = (
                f"   {self.ICONS['repeat']}" if self.normalize_repeat(item.get("repeat")) else ""
            )
            # Beziehungen und laufende Zeiterfassung (Format 20).
            relation_index = self.relation_index() if (item.get("links") or item.get("blocked_by")) else None
            if item.get("blocked_by") and not item.get("done") and self.is_blocked(item, relation_index):
                repeat_suffix += f"   {self.ICONS['blocked']} wartet"
            if item.get("links") and not kompakt:
                repeat_suffix += f"   {self.ICONS['link']} {len(item['links'])}"
            timer = self.running_timer()
            if timer and timer.get("item_id") == item.get("id"):
                repeat_suffix += f"   {self.ICONS['timer']} läuft"
            # Der Stand der Checkliste steht in der Zeile,
            # sonst müsste man jeden Punkt öffnen, um ihn zu kennen.
            fortschritt_text = "" if kompakt else self.format_checklist_progress(item)
            checklist_suffix = f"   {self.ICONS['checklist']} {fortschritt_text}" if fortschritt_text else ""
            if is_group:
                # Eine Gruppe zeigt statt eines Status die Zahl enthaltener Aufgaben.
                contained = self.count_items(item.get("children", []))
                # „(0)“ ließ offen, wofür die Zahl steht. Eine leere Gruppe sagt
                # es besser mit einem Wort.
                group_suffix = f"   ({contained})" if contained else "   (leer)"
                row_text = (
                    f"{number_text}. {self.GROUP_MARKER}{self.item_display_text(item)}"
                    f"{group_suffix}{description_suffix}{attachment_suffix}{repeat_suffix}"
                )
            else:
                row_text = (
                    f"{number_text}. {flag_prefix}{done_prefix}{self.item_display_text(item)}"
                    f"{description_suffix}{checklist_suffix}{attachment_suffix}{repeat_suffix}"
                )
            item_id = item.get("id") or uuid.uuid4().hex
            item["id"] = item_id
            has_children = bool(item.get("children"))
            # Offen ist der Normalfall: Ein Punkt bleibt zugeklappt, wenn der
            # Nutzer ihn zugeklappt hat – nicht deshalb, weil er auf einer
            # tieferen Ebene liegt. Vorher galt das nur für die oberste Ebene;
            # dadurch verschwanden Unterpunkte aus der Ansicht, sobald ihr
            # Elternpunkt in eine Gruppe wanderte, obwohl sie in den Daten
            # standen.
            should_open = (
                bool(query)
                or item_id in self.expanded_ids
                or item_id not in self.collapsed_item_ids
            )
            color_key = item.get("color") if item.get("color") in self.ITEM_COLOR_KEYS else None
            item["color"] = color_key
            if color_key:
                # Eine bewusst gewählte Aufgabenfarbe hat Vorrang. Status,
                # Fälligkeit und Wichtigkeit bleiben über Marker/Text sichtbar.
                tag = f"itemcolor_{color_key}"
            elif is_group:
                tag = "group_item"
            elif item.get("done"):
                tag = "done"
            elif due_state == "overdue":
                tag = "overdue"
            elif due_state == "today":
                tag = "due_today"
            elif importance == 3:
                tag = "priority_high"
            elif importance == 2:
                tag = "priority_medium"
            elif importance == 1:
                tag = "priority_low"
            else:
                tag = "open"

            continuation_lines = []
            if is_long:
                # Der Langtext zeigt seinen vollständigen Text. Zahl und
                # Symbole stehen in der ersten Zeile, die übrigen Zeilen
                # beginnen bündig darunter.
                prefix = f"{number_text}. {flag_prefix}{done_prefix}"
                lines = self.wrap_long_task_text(
                    # Bewusst der ungekürzte Text: nur hier dürfen die eigenen
                    # Zeilenumbrüche eines Langtexts wirken.
                    f"{item.get('text', '')}{description_suffix}{attachment_suffix}{repeat_suffix}",
                    prefix,
                    self.task_text_available_width(len(current_number) - 1),
                )
                row_text = lines[0]
                continuation_lines = lines[1:]

            self.tree.insert(
                parent_id,
                "end",
                iid=item_id,
                text=row_text,
                values=(due_value, self.format_item_labels(item), ""),
                open=should_open,
                tags=(tag,),
            )
            inserted_count += 1
            if continuation_lines:
                # Ohne Unterpunkte stehen die Folgezeilen als Geschwister direkt
                # unter der Kopfzeile; mit Unterpunkten als deren erste Kinder,
                # damit sie nicht hinter dem Unterbaum landen. Ein Klapppfeil
                # entsteht dadurch nur dort, wo ohnehin schon einer wäre.
                line_parent = item_id if has_children else parent_id
                for line_index, line_text in enumerate(continuation_lines):
                    self.tree.insert(
                        line_parent,
                        "end",
                        iid=f"{item_id}{self.CONTINUATION_IID_MARKER}{line_index}",
                        text=line_text,
                        values=("", "", ""),
                        tags=(tag, "continuation"),
                    )
            inserted_count += self.insert_detail_rows(
                item_id if has_children else parent_id, item, item_id, tag)
            if has_children:
                inserted_count += self.insert_tree_items(item_id, item.get("children", []), current_number)
        return inserted_count

    def insert_detail_rows(self, parent_id, item, item_id, tag):
        """Checklisten-, Anhang- und Beschreibungszeilen unter einem Punkt.

        . Die Zeilen gehören zur Darstellung: Sie
        tragen ein eigenes IID-Suffix, zählen nicht als Punkte und lassen sich
        nicht verschieben. Eine Checklistenzeile ist die Ausnahme – sie lässt
        sich abhaken und schreibt dann in die Checkliste ihres Punkts.
        """
        modus = self.list_detail_mode()
        if modus in ("compact", "standard") or self.is_heading_item(item):
            return 0
        zeilen = 0
        grenze = self.MAX_DETAIL_ROWS_PER_ITEM

        if modus in ("checklist", "full"):
            for index, eintrag in enumerate(item.get("checklist") or []):
                if zeilen >= grenze:
                    break
                zeichen = self.ICONS["checklist"] if eintrag.get("done") else self.ICONS["task_open"]
                try:
                    self.tree.insert(
                        parent_id, "end",
                        iid=f"{item_id}{self.CHECKLIST_IID_MARKER}{index}",
                        text=f"      {zeichen}  {eintrag.get('text', '')}",
                        values=("", "", ""),
                        tags=("done" if eintrag.get("done") else tag, "detail", "checklistrow"),
                    )
                except tk.TclError:
                    break
                zeilen += 1

        if modus in ("attachments", "full"):
            for index, anhang in enumerate(item.get("attachments") or []):
                if zeilen >= grenze:
                    break
                name = str(anhang.get("name") or "Anhang")
                groesse = self.format_file_size(anhang.get("size")) if anhang.get("size") else ""
                beschriftung = f"{name} · {groesse}" if groesse else name
                try:
                    self.tree.insert(
                        parent_id, "end",
                        iid=f"{item_id}{self.ATTACHMENT_IID_MARKER}{index}",
                        text=f"      {self.ICONS['attachment']}  {beschriftung}",
                        values=("", "", ""), tags=(tag, "detail"),
                    )
                except tk.TclError:
                    break
                zeilen += 1

        if modus == "full":
            beschreibung = str(item.get("description") or "").strip()
            if beschreibung and zeilen < grenze:
                # Eine Beschreibung kann lang sein; in der Liste steht ihr
                # Anfang. Vollständig bleibt sie in den Punktdetails.
                einzeilig = " ".join(beschreibung.split())
                if len(einzeilig) > 160:
                    einzeilig = einzeilig[:159].rstrip() + "…"
                try:
                    self.tree.insert(
                        parent_id, "end", iid=f"{item_id}{self.NOTE_IID_MARKER}0",
                        text=f"      {self.ICONS['description']}  {einzeilig}",
                        values=("", "", ""), tags=(tag, "detail"),
                    )
                    zeilen += 1
                except tk.TclError:
                    pass
        return zeilen

    def toggle_checklist_row(self, iid):
        """Hakt einen Checklistenschritt direkt aus der Liste heraus ab."""
        index = self.checklist_row_index(iid)
        if index is None:
            return False
        item_id = self.owner_row_id(iid)
        gefunden = self.find_item(item_id)
        if not gefunden:
            return False
        item = gefunden[0]
        eintraege = item.get("checklist") or []
        if not 0 <= index < len(eintraege):
            return False
        with self.item_change([item_id], local=True) as change:
            eintraege[index]["done"] = not eintraege[index].get("done")
            change.mark()
        return bool(change.saved)

    def insert_heading_row(self, parent_id, item, first_row=False):
        """Zeichnet eine Zwischenüberschrift samt Abstand nach oben.

        Eine ttk.Treeview hat eine feste Zeilenhöhe. Der Abstand entsteht
        deshalb aus einer leeren Zeile über der Überschrift; das ist die
        kleinste Einheit, die Tk hier zulässt.
        """
        item_id = item.get("id")
        if not first_row:
            for gap_index in range(self.HEADING_GAP_ROWS):
                self.tree.insert(
                    parent_id,
                    "end",
                    iid=f"{item_id}{self.SPACER_IID_MARKER}{gap_index}",
                    text="",
                    values=("", "", ""),
                    tags=("spacer",),
                )
        self.tree.insert(
            parent_id,
            "end",
            iid=item_id,
            text=self.item_display_text(item),
            values=("", self.format_item_labels(item), ""),
            open=True,
            tags=("heading_item",),
        )
        return 1

    # --- Langtext: Umbruch -------------------------------------------------
    def task_row_font(self):
        """Schrift des Aufgabenbaums – dieselbe, aus der die Spaltenbreiten folgen."""
        return self.cached_font("_task_row_font", self.tree_font())

    def task_text_available_width(self, depth=0):
        """Nutzbare Pixelbreite der Textspalte auf der angegebenen Ebene."""
        tree = getattr(self, "tree", None)
        if tree is None:
            return 0
        try:
            width = int(tree.column("#0", "width"))
        except (tk.TclError, TypeError, ValueError):
            return 0
        # Einrückung je Ebene plus linker Innenabstand und Sicherheitsrand.
        return max(
            self.LONG_TASK_MIN_LINE_WIDTH,
            width - 20 * (depth + 1) - self.SIDEBAR_ITEM_LEFT_PADDING - 12,
        )

    def wrap_long_task_text(self, text, prefix="", available_width=0, max_lines=None):
        """Bricht den Text eines Langtexts auf höchstens fünf Zeilen um.

        Die erste Zeile trägt Nummer und Symbole, jede Folgezeile beginnt
        bündig unter dem Text. Eigene Zeilenumbrüche des Nutzers bleiben
        erhalten: an einem Umbruch beginnt in jedem Fall eine neue Zeile.
        Ohne messbare Schrift oder Breite greift eine zeichenbasierte
        Rückfallebene, damit der Umbruch nie ausfällt.
        """
        limit = max(1, int(max_lines or self.LONG_TASK_MAX_LINES))
        paragraphs = [
            paragraph.split()
            for paragraph in str(text or "").replace("\r", "").split("\n")
        ]
        paragraphs = [words for words in paragraphs if words] or [[]]
        font = self.task_row_font()
        if not any(paragraphs):
            return [prefix.rstrip() or ""]
        if font is None or available_width <= 0:
            # Zeichenbasierte Rückfallebene: grobe, aber stabile Schätzung.
            per_line = 60
            lines = []
            current = prefix
            for paragraph_index, words in enumerate(paragraphs):
                if paragraph_index:
                    lines.append(current.rstrip())
                    if len(lines) >= limit:
                        return lines[:limit]
                    current = "    "
                for word in words:
                    candidate = f"{current}{word} "
                    if len(candidate) > per_line and current.strip():
                        lines.append(current.rstrip())
                        if len(lines) >= limit:
                            return lines[:limit]
                        current = f"    {word} "
                    else:
                        current = candidate
            if current.strip() and len(lines) < limit:
                lines.append(current.rstrip())
            return lines[:limit] or [prefix.rstrip()]

        space_width = max(1, font.measure(" "))
        indent = " " * max(1, round(font.measure(prefix) / space_width))
        lines = []
        current = prefix
        current_empty = True  # noch kein Wort in der laufenden Zeile
        truncated = False
        for paragraph_index, words in enumerate(paragraphs):
            if truncated:
                break
            if paragraph_index:
                # Ein eigener Zeilenumbruch beendet die laufende Zeile.
                lines.append(current)
                if len(lines) >= limit:
                    truncated = True
                    break
                current = indent
                current_empty = True
            index = 0
            while index < len(words):
                word = words[index]
                candidate = f"{current}{word}" if current_empty else f"{current} {word}"
                if current_empty or font.measure(candidate) <= available_width:
                    current = candidate
                    current_empty = False
                    index += 1
                    continue
                lines.append(current)
                if len(lines) >= limit:
                    truncated = True
                    break
                current = indent
                current_empty = True
            if truncated or index < len(words):
                truncated = truncated or index < len(words)
                break
        if not truncated:
            if not current_empty:
                lines.append(current)
            elif not lines:
                lines.append(prefix.rstrip())
        if len(lines) > limit:
            lines = lines[:limit]
        # Bleibt Text übrig, endet die letzte Zeile mit einem Auslassungszeichen.
        if truncated and lines:
            last = lines[-1]
            while font.measure(f"{last} …") > available_width and len(last.split()) > 1:
                last = last.rsplit(" ", 1)[0]
            lines[-1] = f"{last} …"
        return lines

    def schedule_long_task_reflow(self):
        """Bricht Langtexts nach einer Breitenänderung neu um – gesammelt."""
        if not hasattr(self, "root") or getattr(self, "_long_reflow_id", None) is not None:
            return
        if self.view_mode != "list":
            return
        if not any(self.is_long_item(item) for item in self.walk_items()):
            return

        def run():
            self._after_ids.discard(getattr(self, "_long_reflow_id", None))
            self._long_reflow_id = None
            width = self.task_text_available_width()
            if width == getattr(self, "_long_reflow_width", None):
                return
            self._long_reflow_width = width
            self.refresh_tree()

        try:
            self._long_reflow_id = self._register_after(self.root.after(120, run))
        except tk.TclError:
            self._long_reflow_id = None

    # --- Synthetische Zeilen ------------------------------------------------
    SYNTHETIC_ROW_MARKERS = (CONTINUATION_IID_MARKER, SPACER_IID_MARKER,
                             CHECKLIST_IID_MARKER, ATTACHMENT_IID_MARKER, NOTE_IID_MARKER,
                             GROUP_HEADING_IID_MARKER)

    @classmethod
    def is_synthetic_row(cls, iid):
        """Fortsetzungs-, Abstands- und Detailzeilen sind Darstellung, keine Daten."""
        return isinstance(iid, str) and any(marker in iid for marker in cls.SYNTHETIC_ROW_MARKERS)

    @classmethod
    def owner_row_id(cls, iid):
        """Der Punkt, zu dem eine synthetische Zeile gehört."""
        if not isinstance(iid, str):
            return iid
        for marker in cls.SYNTHETIC_ROW_MARKERS:
            if marker in iid:
                return iid.split(marker, 1)[0]
        return iid

    @classmethod
    def checklist_row_index(cls, iid):
        """Der Schritt, den eine Checklistenzeile darstellt – sonst None."""
        if not isinstance(iid, str) or cls.CHECKLIST_IID_MARKER not in iid:
            return None
        try:
            return int(iid.split(cls.CHECKLIST_IID_MARKER, 1)[1])
        except (ValueError, IndexError):
            return None

    def get_visible_tree_iids(self, include_synthetic=False):
        """Alle sichtbaren Zeilen des Aufgabenbaums in Anzeigereihenfolge."""
        tree = getattr(self, "tree", None)
        if tree is None:
            return []
        result = []

        def collect(parent=""):
            try:
                children = tree.get_children(parent)
            except tk.TclError:
                return
            for iid in children:
                if iid == self.EMPTY_ROW_ID:
                    continue
                if include_synthetic or not self.is_synthetic_row(iid):
                    result.append(iid)
                try:
                    if tree.item(iid, "open"):
                        collect(iid)
                except tk.TclError:
                    continue

        collect("")
        return result

    def move_tree_focus(self, direction, event=None):
        """Pfeiltasten überspringen Fortsetzungs- und Abstandszeilen.

        Ohne diese Bindung bliebe die Auswahl auf einer Zeile stehen, hinter der
        kein Punkt steht – jede Folgeaktion liefe dann ins Leere.
        """
        tree = getattr(self, "tree", None)
        if tree is None:
            return None
        rows = self.get_visible_tree_iids()
        if not rows:
            return "break"
        current = self.owner_row_id(tree.focus() or "")
        if current in rows:
            index = rows.index(current) + direction
            index = max(0, min(index, len(rows) - 1))
        else:
            index = 0 if direction > 0 else len(rows) - 1
        target = rows[index]
        tree.selection_set(target)
        tree.focus(target)
        tree.see(target)
        self.selection_anchor_id = target
        return "break"

    def tree_row_at(self, y):
        """Zeile unter einer Y-Koordinate – synthetische Zeilen zeigen auf ihren Punkt."""
        tree = getattr(self, "tree", None)
        if tree is None:
            return ""
        try:
            row_id = tree.identify_row(y)
        except tk.TclError:
            return ""
        if self.is_synthetic_row(row_id):
            owner = self.owner_row_id(row_id)
            try:
                return owner if tree.exists(owner) else ""
            except tk.TclError:
                return ""
        return row_id

    def get_selected_item_ids(self):
        workspace = getattr(self, "workspace", None)
        if workspace is not None and workspace.visible:
            identity = workspace.selected_id
            return [identity] if self.view_mode == "list" and identity and self.find_item(identity) else []
        if not hasattr(self, "tree"):
            return []
        selected = []
        for item_id in self.tree.selection():
            if item_id and item_id != self.EMPTY_ROW_ID and self.find_item(item_id):
                selected.append(item_id)
        return selected

    def get_selected_item_id(self):
        workspace = getattr(self, "workspace", None)
        if workspace is not None and workspace.visible:
            selected = self.get_selected_item_ids()
            return selected[0] if selected else None
        if not hasattr(self, "tree"):
            return None
        focus_id = self.tree.focus()
        if focus_id and focus_id != self.EMPTY_ROW_ID and focus_id in self.tree.selection() and self.find_item(focus_id):
            return focus_id
        selected = self.get_selected_item_ids()
        return selected[0] if selected else None

    def iter_tree_ids(self, parent_id=""):
        if not hasattr(self, "tree"):
            return []
        result = []
        for child_id in self.tree.get_children(parent_id):
            if self.is_group_section_row(child_id):
                # Abschnittsköpfe der Gruppierung sind keine Punkte.
                result.extend(self.iter_tree_ids(child_id))
                continue
            if child_id == self.EMPTY_ROW_ID or self.is_synthetic_row(child_id):
                continue
            result.append(child_id)
            result.extend(self.iter_tree_ids(child_id))
        return result

    def select_all_items(self, event=None):
        focused = self.current_focus_widget()
        if focused is not None and focused in (getattr(self, "entry", None), getattr(self, "search_entry", None)):
            try:
                focused.selection_range(0, tk.END)
            except tk.TclError:
                pass
            return "break"
        ids = self.iter_tree_ids()
        if ids:
            self.tree.selection_set(ids)
            self.tree.focus(ids[0])
            self.selection_anchor_id = ids[0]
        return "break"

    def select_range_from_click(self, event=None):
        if event is None or not hasattr(self, "tree"):
            return "break"
        target_id = self.tree_row_at(event.y)
        if not target_id or target_id == self.EMPTY_ROW_ID:
            return "break"
        ids = self.iter_tree_ids()
        if target_id not in ids:
            return "break"
        anchor_id = self.selection_anchor_id or self.get_selected_item_id() or target_id
        if anchor_id not in ids:
            anchor_id = target_id
        start = ids.index(anchor_id)
        end = ids.index(target_id)
        if start > end:
            start, end = end, start
        selected_range = ids[start:end + 1]
        self.tree.selection_set(selected_range)
        self.tree.focus(target_id)
        return "break"

    def filter_top_level_selection(self, item_ids):
        selected_set = set(item_ids)
        top_level_ids = []
        for item_id in item_ids:
            found = self.find_item(item_id)
            if not found:
                continue
            parent_item = found[3]
            is_descendant = False
            while parent_item:
                parent_id = parent_item.get("id")
                if parent_id in selected_set:
                    is_descendant = True
                    break
                parent_found = self.find_item(parent_id)
                parent_item = parent_found[3] if parent_found else None
            if not is_descendant:
                top_level_ids.append(item_id)
        return top_level_ids

    def clear_tree_selection(self):
        if hasattr(self, "tree"):
            self.tree.selection_remove(self.tree.selection())
            self.selection_anchor_id = None

    # -----------------------------
    # Gemeinsamer Rahmen für Änderungen an der Auswahl
    # -----------------------------
    def selected_items_for_change(self, warn=True, top_level_only=False, view_message=True):
        """Auswahl, an der eine Änderung ansetzen darf – sonst None.

        Fasst die drei Vorbedingungen zusammen, die vor jeder Änderung an
        Punkten gelten: Es muss eine Liste offen sein, es muss etwas ausgewählt
        sein, und wer nichts ausgewählt hat, bekommt einen Hinweis.

        `top_level_only` lässt verschachtelte Punkte weg, deren Elternteil
        ebenfalls ausgewählt ist. Das brauchen Aktionen, die ganze Zweige
        bewegen oder kopieren – sonst würde ein Unterpunkt zweimal behandelt.

        `warn` und `view_message` steuern getrennte Hinweise: der eine gilt der
        leeren Auswahl, der andere der falschen Ansicht. Tastenkürzel, die
        beiläufig ins Leere greifen dürfen, schalten den ersten ab; nur
        `toggle_done` schaltet beide ab, weil es auch bei einem Klick neben die
        Liste auslöst.
        """
        if not self.require_list_view(message=view_message):
            return None
        item_ids = self.get_selected_item_ids()
        if top_level_only:
            selected = set(item_ids)
            item_ids = self.filter_top_level_selection(
                [item_id for item_id in self.iter_tree_ids() if item_id in selected]
            )
        if not item_ids:
            if warn:
                self.show_warning("Hinweis", "Zuerst einen Punkt auswählen.")
            return None
        return item_ids

    def changed_item_lists(self, item_ids):
        """Stabile Listen-IDs vor/nach einer bekannten lokalen Punktänderung."""
        if not item_ids:
            return None
        result = set()
        for item_id in item_ids:
            found = self.find_item_in_lists(item_id)
            if not found:
                return None
            result.add(found[3]["id"])
        return result

    @contextlib.contextmanager
    def item_change(self, item_ids, focus="last", restore=True, update_sidebar=False, background=False,
                    local=False):
        """Rahmen um jede Änderung an vorhandenen Punkten.

        Legt vorher den Rückgängig-Punkt an und schließt hinterher ab:
        speichern, neu zeichnen, Auswahl wiederherstellen. Blieb die Änderung
        wirkungslos, verschwindet der Rückgängig-Punkt wieder.

            item_ids = self.selected_items_for_change()
            if item_ids is None:
                return "break"
            with self.item_change(item_ids) as change:
                for item_id in item_ids:
                    …
                    change.mark()

        `focus` bestimmt, welcher Punkt nach dem Neuzeichnen im Blick ist:
        „last" der letzte der Auswahl, „first" der erste. Meldet die Änderung
        über `mark(id)` einen eigenen Punkt, gilt dieser.

        `background=True` ist ausschließlich für automatische Zustellbelege:
        ohne Undo, Aktivitätszählung, Auswahlwechsel oder modale Fehlermeldung.
        `change.saved` meldet das Speicherergebnis für transaktionale Aufrufer.

        `restore` stellt die Mehrfachauswahl wieder her; `update_sidebar`
        zeichnet zusätzlich die Seitenleiste neu – nötig, wenn sich die Zahl
        der Aufgaben einer Liste ändert.

        Bricht die Änderung mit einem Fehler ab, bleibt der Rückgängig-Punkt
        stehen: Ein halb ausgeführter Umbau muss rücknehmbar bleiben. Um den
        Bestand kümmert sich darüber `guarded_structural_change`.
        """
        change = ChangeRecord(item_ids)
        # Explizite Zusicherung geprüfter Aufrufer: nur diese Punkte/Teilbäume.
        # Unbekannte oder leere Auswahl bleibt ein Vollvergleich.
        affected_lists = self.changed_item_lists(item_ids) if local else None
        feedback_before = getattr(self, "_history_baseline", None)
        if not background:
            self.snapshot_undo(trim=False)
        # Vorzustand für die Tageszählung. Sie hängt an dieser einen Stelle,
        # weil jede Änderung an Punkten hier durchläuft – Klick, Tastatur und
        # Kontextmenü zählen dadurch genau einmal und nicht dreimal.
        done_before = self.done_item_ids(item_ids)
        with self.settings_write_batch():
            yield change
            if not change.changed:
                if not background and self.undo_stack:
                    self.undo_stack.pop()
                return
            if not background:
                self.trim_undo_stack()
                self.record_completions(done_before, item_ids)
            if affected_lists is not None:
                after_lists = self.changed_item_lists(item_ids)
                affected_lists = affected_lists | after_lists if after_lists is not None else None
            change.saved = self.save_items(show_error=not background, record_activity=not background,
                                          changed_list_ids=affected_lists)
        if background:
            return
        if change.saved:
            self.feedback_for_changes(feedback_before)
        # Erfolgreiches Speichern hat die Seitenleiste schon neu aufgebaut (P06r).
        if update_sidebar and not change.saved:
            self.update_sidebar_list()
        focus_id = change.focus_id
        if focus_id is None and change.selection:
            focus_id = change.selection[-1] if focus == "last" else change.selection[0]
        self.refresh_tree(selected_id=focus_id)
        if restore:
            self._restore_item_selection(change.selection)

    @contextlib.contextmanager
    def sidebar_change(self, refresh_tree=False, feedback=True):
        """Derselbe Rahmen für Änderungen an Listen und Ordnern.

        Die Seitenleiste hat keine Punktauswahl wiederherzustellen; abgeschlossen
        wird deshalb mit Speichern und Neuzeichnen der Seitenleiste.
        `refresh_tree` kommt dazu, wenn die Änderung auch den Inhalt der offenen
        Liste betrifft – beim Papierkorb etwa, oder wenn eine ganze Liste den
        Ordner wechselt.
        """
        change = ChangeRecord(())
        feedback_before = getattr(self, "_history_baseline", None)
        self.snapshot_undo(trim=False)
        with self.settings_write_batch():
            yield change
            if not change.changed:
                if self.undo_stack:
                    self.undo_stack.pop()
                return
            self.trim_undo_stack()
            change.saved = self.save_items()
            self.save_settings(defer=True)
        if change.saved and feedback:
            self.feedback_for_changes(feedback_before)
        # Erfolgreiches Speichern hat die Seitenleiste schon neu aufgebaut (P06r).
        if not change.saved:
            self.update_sidebar_list()
        if refresh_tree:
            self.refresh_tree()

    # -----------------------------
    # Undo / Komfortaktionen
    # -----------------------------
    def snapshot_undo(self, trim=True):
        """Legt den aktuellen Stand auf den Rückgängig-Stapel.

        `trim=False` lässt den Stapel vorerst über seine Grenze wachsen. Die
        beiden Änderungsrahmen nutzen das: Sie wissen erst hinterher, ob die
        Aktion überhaupt etwas bewirkt hat. Würde schon beim Anlegen gekürzt,
        kostete eine wirkungslose Aktion den ältesten Schritt – ein Schritt, den
        der Nutzer verlöre, ohne dass sich irgendetwas geändert hätte.
        """
        if (self.settings.get("time_booking") and not getattr(self, "_time_booking_recovering", False)
                and not self.recover_time_booking()):
            raise glide_focus.PendingBookingError()
        # Offene Zellstriche gehören in den Stand vor jeder weiteren Aktion –
        # sonst verlöre etwa ein sofortiges Löschen der Seite den letzten Zug.
        self.flush_drawing_editor()
        if self.active_list_id and self.lists:
            self.sync_current_list_reference()
        self.undo_stack.append(
            {
                "sidebar_locations": copy.deepcopy(self.settings.get("sidebar_locations", {})),
                "lists": PackedState(self.lists),
                "folders": PackedState(self.folders),
                "labels": PackedState(self.labels),
                "trash": PackedState(self.trash),
                "active_list_id": self.active_list_id,
                "active_folder_id": self.active_folder_id if self.view_mode == "folder" else None,
                "view_mode": self.view_mode,
            }
        )
        if trim:
            self.trim_undo_stack()

    def trim_undo_stack(self):
        """Hält den Rückgängig-Stapel auf seiner Höchstlänge."""
        while len(self.undo_stack) > self.MAX_UNDO_STEPS:
            self.undo_stack.pop(0)

    def apply_snapshot(self, snapshot):
        """Stellt einen Stand aus dem Rückgängig-Speicher vollständig her.

        Gemeinsame Grundlage von „Rückgängig“ und vom Bestandswächter: beide
        müssen denselben Weg zurückgehen, sonst driften sie auseinander.
        """
        with self.settings_write_batch():
            self._apply_snapshot(snapshot)

    def _apply_snapshot(self, snapshot):
        self.settings["sidebar_locations"] = copy.deepcopy(snapshot.get("sidebar_locations", {}))
        self.save_settings(defer=True)
        self.lists = unpack_state(snapshot.get("lists"))
        self.folders = unpack_state(snapshot.get("folders"))
        self.labels = unpack_state(snapshot.get("labels"))
        self.trash = unpack_state(snapshot.get("trash"))
        self.ensure_inbox_list()
        desired_list_id = snapshot.get("active_list_id")
        if desired_list_id not in [entry.get("id") for entry in self.lists]:
            desired_list_id = self.lists[0].get("id")
        desired_folder_id = snapshot.get("active_folder_id")
        desired_view_mode = snapshot.get("view_mode")
        self.active_list_id = None
        self.active_folder_id = None
        self.view_mode = "list"
        self.set_active_list(desired_list_id, refresh=False)
        if desired_folder_id and self.get_folder(desired_folder_id):
            self.set_active_folder(desired_folder_id, refresh=False)
        elif desired_view_mode in self.DERIVED_ITEM_VIEWS + ("trash", self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW, self.TABLE_VIEW):
            # Vorher standen hier nur „In Bearbeitung“ und der Papierkorb: Wer in
            # „Verspätet“ etwas zurücknahm, landete danach in der zuletzt
            # geöffneten Liste. Eine abgeleitete Ansicht bleibt jetzt stehen.
            self._activate_system_view(desired_view_mode, refresh=False)
        # Erfolgreiches Speichern baut die Seitenleiste bereits neu auf (P06r).
        if not self.save_items():
            self.update_sidebar_list()
        self.refresh_tree()

    def undo_last_change(self, event=None):
        if self.settings.get("time_booking") and not self.recover_time_booking():
            return "break"
        if event is not None and isinstance(self.current_focus_widget(), (tk.Entry, tk.Text, ttk.Entry)):
            # In Textfeldern bleibt echtes Strg+Z eine lokale Texteingabe-Aktion.
            return None
        editor = self.current_drawing_editor()
        if event is not None and editor is not None and self.current_focus_widget() is editor.canvas:
            # Auf der Zeichenfläche gilt der eigene Zellpuffer.
            return editor.undo()
        self.flush_drawing_editor()
        workspace = getattr(self, "workspace", None)
        if workspace is not None and workspace.view_undo_pending():
            # Aufräumen und Bereichsänderungen der Pinnwand (3.30) sind je ein
            # Schritt – solange danach keine Punktänderung kam.
            workspace.undo_view_change()
            self.hide_undo_toast()
            self.feedback("undone")
            return "break"
        if not self.undo_stack:
            self.show_info("Rückgängig", "Es gibt keine Änderung zum Rückgängigmachen.")
            return "break"
        self.apply_snapshot(self.snapshot_keeping_drawings(self.undo_stack.pop()))
        self.feedback("undone")
        return "break"

    # -----------------------------
    # Bestandswächter
    # -----------------------------
    @classmethod
    def collect_item_ids(cls, items, into=None):
        """Alle Punkt-IDs eines Zweigs, Unterpunkte eingeschlossen."""
        found = set() if into is None else into
        for item in items or []:
            if not isinstance(item, dict):
                continue
            item_id = item.get("id")
            if item_id:
                found.add(item_id)
            cls.collect_item_ids(item.get("children", []), found)
        return found

    def data_item_ids(self):
        """Jede Punkt-ID in allen Listen und im Papierkorb.

        Grundlage des Bestandswächters: Was hier vor einer Umbauaktion steht,
        muss danach noch stehen – in einer Liste oder im Papierkorb.
        """
        if self.active_list_id and self.lists:
            self.sync_current_list_reference()
        found = set()
        for entry in self.lists:
            self.collect_item_ids(entry.get("items", []), found)
        for entry in self.trash:
            payload = entry.get("payload")
            if isinstance(payload, dict):
                self.collect_item_ids([payload], found)
            elif isinstance(payload, list):
                self.collect_item_ids(payload, found)
            for key in ("items", "item"):
                nested = entry.get(key)
                if isinstance(nested, dict):
                    self.collect_item_ids([nested], found)
                elif isinstance(nested, list):
                    self.collect_item_ids(nested, found)
        return found

    @contextlib.contextmanager
    def guarded_structural_change(self, action_name, expected_removals=None):
        """Sichert zu, dass eine Umbauaktion keinen Punkt verliert.

        Gruppieren, Auflösen, Verschieben, Ein- und Ausrücken ordnen Punkte um.
        Keine dieser Aktionen darf einen Punkt entfernen. Der Wächter vergleicht
        den Bestand vor und nach der Aktion; fehlt danach ein Punkt, wird der
        vorherige Stand wiederhergestellt und der Vorgang gemeldet, statt den
        Verlust still zu speichern.

        Absichtliches Löschen läuft nicht über diesen Weg, sondern über den
        Papierkorb – und dessen Inhalt zählt hier mit.

        `expected_removals` nennt die IDs, die planmäßig entfallen. Das betrifft
        allein leere Hüllen wie den Gruppen-Container beim Auflösen: Die Gruppe
        selbst verschwindet, ihre Punkte nicht. Alles, was nicht ausdrücklich
        hier steht, muss die Aktion überleben.
        """
        allowed = set(expected_removals or ())
        before = self.data_item_ids() - allowed
        depth_before = len(self.undo_stack)
        try:
            yield
        except DataIntegrityError:
            # Eine Aktion hat selbst gemeldet, dass sie Punkte verlöre.
            self.rollback_to_undo_depth(depth_before)
            self.report_integrity_stop(action_name, len(before - self.data_item_ids()))
            return
        except Exception:
            # Ein echter Fehler: erst den Bestand retten, dann durchreichen.
            self.rollback_to_undo_depth(depth_before)
            self.report_integrity_stop(action_name, 0, crashed=True)
            raise
        missing = before - self.data_item_ids()
        if not missing:
            return
        self.rollback_to_undo_depth(depth_before)
        self.report_integrity_stop(action_name, len(missing))

    def rollback_to_undo_depth(self, depth):
        """Nimmt alle Schritte zurück, die seit dieser Stapeltiefe entstanden sind."""
        if len(self.undo_stack) <= depth:
            return False
        snapshot = self.undo_stack[depth]
        del self.undo_stack[depth:]
        self.apply_snapshot(snapshot)
        return True

    def report_integrity_stop(self, action_name, missing_count, crashed=False):
        """Meldet einen abgewehrten Datenverlust – sichtbar, nicht im Log."""
        if crashed:
            detail = "Der Vorgang wurde abgebrochen."
        else:
            detail = f"Dabei wären {missing_count} Punkt(e) verloren gegangen."
        self.show_error(
            "Abgebrochen – keine Daten verloren",
            f"„{action_name}“ wurde nicht ausgeführt.\n{detail}\n\n"
            "Der vorherige Stand ist vollständig wiederhergestellt.",
        )

    def format_item_lines(self, item, number_prefix, level=0):
        number_text = ".".join(str(part) for part in number_prefix)
        indent = "   " * level
        if self.is_heading_item(item):
            flag_prefix, done_prefix = self.HEADING_MARKER, ""
        elif self.is_group_item(item):
            flag_prefix, done_prefix = self.GROUP_MARKER, ""
        else:
            flag_prefix = self.IMPORTANCE_MARKERS.get(self.clamp_importance(item.get("importance", 0)), "")
            done_prefix = "✓ " if item.get("done") else ""
        lines = [f"{indent}{number_text}. {flag_prefix}{done_prefix}{self.item_display_text(item)}"]
        description = str(item.get("description") or "").strip()
        if description:
            lines.extend(f"{indent}   Beschreibung: {line}" for line in description.splitlines())
        label_names = self.format_item_label_names(item)
        if label_names:
            lines.append(f"{indent}   Labels: {label_names}")
        for attachment in item.get("attachments", []):
            lines.append(f"{indent}   Anhang: {attachment.get('name', 'Datei')}")
        for index, child in enumerate(item.get("children", []), start=1):
            lines.extend(self.format_item_lines(child, number_prefix + [index], level + 1))
        return lines

    def copy_selected_to_clipboard(self, event=None):
        if self.current_focus_widget() in (getattr(self, "entry", None), getattr(self, "search_entry", None)):
            return None
        if not self.require_list_view():
            return "break"
        selected_ids = self.get_selected_item_ids()
        if not selected_ids:
            self.show_warning("Hinweis", "Zuerst einen Punkt auswählen.")
            return "break"

        selected_ids = self.filter_top_level_selection(selected_ids)
        blocks = []
        for item_id in selected_ids:
            found = self.find_item(item_id)
            if not found:
                continue
            item, _siblings, _index, _parent_item = found
            number_path = self.get_item_number_path(item_id) or [1]
            blocks.extend(self.format_item_lines(item, number_path))
        if not blocks:
            return "break"
        text = "\n".join(blocks)
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.root.update()
        self.feedback("copied", len(selected_ids))
        return "break"

    def paste_items_from_clipboard(self, event=None):
        """Fügt Aufgaben aus der Zwischenablage als neue Punkte ein.

        Unterstützt den eigenen Kopier-/TXT-Export-Stil mit Nummerierung sowie
        einfache mehrzeilige Texte. Ist ein Listenpunkt ausgewählt, werden die
        eingefügten Punkte direkt danach als gleichrangige Punkte eingefügt;
        ohne Auswahl werden sie am Ende der Hauptliste ergänzt.
        """
        if self.current_focus_widget() in (getattr(self, "entry", None), getattr(self, "search_entry", None)):
            # In Textfeldern soll Strg+V die normale System-Einfügefunktion behalten.
            return None
        if not self.require_list_view():
            return "break"

        try:
            clipboard_text = self.root.clipboard_get()
        except tk.TclError:
            self.show_warning("Einfügen", "Die Zwischenablage enthält keinen Text.")
            return "break"

        clipboard_text = clipboard_text.strip()
        if not clipboard_text:
            self.show_warning("Einfügen", "Die Zwischenablage enthält keinen Text.")
            return "break"

        pasted_items = self.parse_clipboard_items(clipboard_text)
        if not pasted_items:
            self.show_warning("Einfügen", "Aus dem Inhalt der Zwischenablage konnten keine Punkte erstellt werden.")
            return "break"

        selected_id = self.get_selected_item_id()
        self.snapshot_undo()
        target_list = self.items
        insert_index = len(target_list)

        if selected_id:
            found = self.find_item(selected_id)
            if found:
                _selected_item, siblings, index, _parent_item = found
                target_list = siblings
                insert_index = index + 1

        for offset, item in enumerate(pasted_items):
            target_list.insert(insert_index + offset, item)

        self.save_items()
        self.refresh_tree(selected_id=pasted_items[-1].get("id"))
        self.feedback("pasted", len(pasted_items))
        return "break"

    def parse_clipboard_items(self, clipboard_text):
        lines = [line.rstrip() for line in clipboard_text.splitlines() if line.strip()]
        if not lines:
            return []

        # Bei einem vollständigen TXT-Export steht häufig zuerst ein Titel und
        # danach eine Linie aus Gleichheitszeichen. Diese Kopfzeile gehört nicht
        # als Aufgabe in die Liste.
        if len(lines) >= 2 and set(lines[1].strip()) == {"="}:
            lines = lines[2:]

        # Zuerst den vorhandenen TXT-Parser nutzen, aber nur wenn tatsächlich
        # nummerierte Listenzeilen enthalten sind. Unnummerierte Clipboard-Texte
        # werden im Fallback sauber als Bullet-/Checkbox-Zeilen interpretiert.
        numbered_line_pattern = re.compile(r"^\d+(?:\.\d+)*\.\s+")
        if any(numbered_line_pattern.match(line.strip()) for line in lines):
            parsed = self.parse_txt_items(lines)
            if parsed:
                return parsed

        # Fallback: Jede nicht leere Zeile wird als eigener Hauptpunkt eingefügt.
        plain_items = []
        bullet_pattern = re.compile(r"^[-*•–—]\s+")
        checkbox_pattern = re.compile(r"^\[\s*([xX])?\s*\]\s+")

        for raw_line in lines:
            text = raw_line.strip()
            done = False
            importance = 0

            checkbox_match = checkbox_pattern.match(text)
            if checkbox_match:
                done = bool(checkbox_match.group(1) and checkbox_match.group(1).lower() == "x")
                text = checkbox_pattern.sub("", text, count=1).strip()

            text = bullet_pattern.sub("", text, count=1).strip()

            kind = self.ITEM_KIND_TASK
            group_marker = next((marker.strip() for marker in
                (self.GROUP_MARKER, self.LEGACY_GROUP_MARKER)
                if text.startswith(marker.strip())), None)
            if group_marker:
                kind = self.ITEM_KIND_GROUP
                text = text[len(group_marker):].strip()
            elif text.startswith(self.HEADING_MARKER.strip()):
                kind = self.ITEM_KIND_HEADING
                text = text[len(self.HEADING_MARKER.strip()):].strip()
            elif text.startswith(self.LONG_MARKER.strip()):
                kind = self.ITEM_KIND_LONG
                text = text[len(self.LONG_MARKER.strip()):].strip()

            for marker, marker_importance in self.IMPORTANCE_PARSE_MARKERS:
                if text.startswith(marker):
                    importance = marker_importance
                    text = text[len(marker):].strip()
                    break

            if text.startswith("✓ ") or text.startswith("✅ "):
                done = True
                text = text[2:].strip()

            if text:
                plain_items.append(self.new_item(text, done=done, importance=importance, kind=kind))

        return plain_items

    def expand_all(self, event=None):
        self.set_tree_open_state(True)
        self.set_sidebar_open_state(True)
        return "break"

    def collapse_all(self, event=None):
        self.set_tree_open_state(False)
        self.set_sidebar_open_state(False)
        return "break"

    def active_folder_chain(self):
        """Die Ordner-IDs vom geöffneten Element bis zur Wurzel.

        . Beim globalen Zuklappen muss der Weg zur
        geöffneten Seite stehen bleiben – sonst verschwindet genau das
        Element, an dem gearbeitet wird, aus der Seitenleiste, und der Nutzer
        muss sich selbst wieder dorthin klicken.
        """
        if self.view_mode == "folder" and self.active_folder_id:
            start = self.active_folder_id
        elif self.active_list_id:
            eintrag = next((e for e in self.lists if e.get("id") == self.active_list_id), None)
            start = (eintrag or {}).get("folder_id")
        else:
            start = None
        kette = []
        gesehen = set()
        while start and start not in gesehen:
            gesehen.add(start)
            kette.append(start)
            ordner = self.get_folder(start)
            start = (ordner or {}).get("parent_id")
        return kette

    def set_sidebar_open_state(self, is_open):
        """Klappt alle Ordner der Seitenleiste auf oder zu.

        Bis 3.22 wirkte „Aufklappen“/„Zuklappen“ nur auf
        die Punkte der geöffneten Liste; Ordner und Gruppen der Seitenleiste
        blieben, wie sie waren. Jetzt wirkt der Schalter auf beides. Die
        einzige Ausnahme ist der Pfad zur geöffneten Seite: Dieser bleibt
        offen, damit die aktive Liste sichtbar bleibt.
        """
        if not hasattr(self, "sidebar_listbox"):
            return
        geschuetzt = set(self.active_folder_chain()) if not is_open else set()
        for ordner in self.folders:
            ordner_id = ordner.get("id")
            if not ordner_id:
                continue
            self.sidebar_folder_open_states[ordner_id] = True if ordner_id in geschuetzt else bool(is_open)
        self.update_sidebar_list(capture=False)
        self.save_settings()

    def set_tree_open_state(self, is_open):
        def apply(row_id):
            try:
                self.tree.item(row_id, open=is_open)
                for child_id in self.tree.get_children(row_id):
                    apply(child_id)
            except tk.TclError:
                pass
        for row_id in self.tree.get_children(""):
            apply(row_id)
        self.remember_tree_open_states()

    # -----------------------------
    # Listenaktionen
    # -----------------------------
    def on_entry_return(self, event=None):
        self.add_item()
        return "break"

    # --- „/“-Befehle in der Eingabezeile (27.09.2026) -----------------------
    def slash_word(self):
        """Das angefangene „/wort“ links der Schreibmarke oder None."""
        try:
            links = self.entry.get()[:self.entry.index("insert")]
        except tk.TclError:
            return None
        wort = links.split(" ")[-1] if links else ""
        return wort[1:] if wort.startswith("/") else None

    def update_slash_hint(self, event=None):
        """Zeigt unter der Eingabe jede Erkennung als Chip mit × – ohne eigenes Fenster und ohne Fokus (G01)."""
        if self.view_mode != "list" or getattr(self, "entry_placeholder_active", False):
            return self.hide_slash_hint()
        text = self.get_entry_text()
        if not text:
            self._capture_ignored = set()
        erfassung = parse_capture(text, self.labels, ignore=self.capture_ignored())
        wort = self.slash_word()
        vorschlag = None
        if wort is not None:
            vorschlaege = slash_suggestions(wort, self.labels)
            vorschlag = (("Tab ergänzt: " + "  ".join("/" + v for v in vorschlaege)) if vorschlaege
                         else "Kein Befehl passt – das Wort bleibt Text.")
        if not erfassung.teile and vorschlag is None:
            return self.hide_slash_hint()
        leiste = getattr(self, "_capture_hint", None)
        owner = self.entry.winfo_toplevel()
        if leiste is None or not leiste.winfo_exists():
            leiste = self._capture_hint = tk.Frame(owner, padx=6, pady=4, highlightthickness=1)
        leiste.configure(bg=self.theme["card"], highlightbackground=self.theme["input_border"])
        self.fill_capture_chips(leiste, erfassung.teile, vorschlag, self.ignore_capture_part)
        x = self.entry_border.winfo_rootx() - owner.winfo_rootx()
        y = self.entry_border.winfo_rooty() - owner.winfo_rooty() + self.entry_border.winfo_height() + 2
        leiste.place(x=x, y=y, width=max(240, self.entry_border.winfo_width()))
        leiste.lift()
        return None

    def paste_into_entry(self, event=None):
        """Mehrere Zeilen in der Eingabezeile: nach Rückfrage je Zeile eine Aufgabe (KO05).

        Eine einzelne Zeile fügt das Feld wie gewohnt ein. Bei mehreren Zeilen
        fragt Glide „N Aufgaben anlegen?“: je Zeile eine Aufgabe über denselben
        Parser wie die Eingabezeile (Aufzählungszeichen, Nummern und Kästchen
        entfallen, ein abgehaktes Kästchen legt die Aufgabe erledigt an), alles
        als eine Aufgabe in die Zeile, oder Abbrechen ohne Änderung. Die
        angelegten Aufgaben sind ein Undo-Schritt.
        """
        if self.view_mode != "list" or not self.list_accepts_items(self.current_list()):
            return None
        try:
            inhalt = self.root.clipboard_get()
        except tk.TclError:
            return None
        zeilen, abgeschnitten = split_capture_lines(inhalt)
        if len(zeilen) < 2:
            return None
        anzahl = len(zeilen)
        wahl = self.themed_choice_dialog(
            "Mehrere Zeilen einfügen",
            (f"Die Zwischenablage enthält mehr als {anzahl} Zeilen; übernommen werden die ersten {anzahl}. "
             if abgeschnitten else f"Die Zwischenablage enthält {anzahl} Zeilen. ")
            + "Je Zeile eine Aufgabe anlegen oder alles als eine Aufgabe übernehmen?",
            [("einzeln", f"{anzahl} Aufgaben anlegen"), ("eine", "Als eine Aufgabe einfügen")])
        if wahl == "eine":
            if getattr(self, "entry_placeholder_active", False):
                self.clear_entry_placeholder()
            self.entry.insert("insert", ", ".join(zeile["text"] for zeile in zeilen))
            self.update_slash_hint()
            return "break"
        if wahl != "einzeln":
            return "break"
        neue = []
        for zeile in zeilen:
            erfassung = parse_capture(zeile["text"], self.labels)
            if not erfassung.titel:
                continue
            try:
                felder = self.capture_item_fields(erfassung.felder)
            except ValueError:
                felder = {key: value for key, value in erfassung.felder.items() if key != "reminder"}
            neue.append(self.new_item(erfassung.titel, zeile["done"], **felder))
        if not neue:
            self.show_info("Einfügen", "Aus den Zeilen ließ sich kein Aufgabentitel bilden.")
            return "break"
        self.snapshot_undo()
        self.items.extend(neue)
        if not self.save_items():
            del self.items[-len(neue):]
            if self.undo_stack:
                self.undo_stack.pop()
            self.refresh_tree()
            return "break"
        self.refresh_tree(selected_id=neue[-1]["id"])
        self.feedback("pasted", len(neue))
        self.show_undo_toast(f"{len(neue)} Aufgaben angelegt")
        return "break"

    def capture_item_fields(self, felder):
        """Felder der Schnelleingabe in Punktfelder übersetzen (KO03).

        Eine feste Erinnerung wird zum Zeitpunkt mit Zeitzone wie in der
        Eingabemaske; eine Ortszeit, die es wegen der Zeitumstellung nicht
        gibt, wird mit derselben Meldung abgewiesen (ValueError). Ein Vorlauf
        gilt nur mit Fälligkeit – auch wenn sie aus einem eigenen Feld kommt.
        """
        felder = dict(felder)
        erinnerung = felder.pop("reminder", None)
        if isinstance(erinnerung, dict):
            if erinnerung.get("mode") == "fixed":
                felder["reminder"] = {"mode": "fixed",
                                      "at": self.local_reminder_time(erinnerung.get("day"), erinnerung.get("time"))}
            elif erinnerung.get("mode") == "relative" and felder.get("due"):
                felder["reminder"] = {"mode": "relative", "minutes": int(erinnerung.get("minutes") or 0)}
        return felder

    def capture_ignored(self):
        """Schlüssel der zurückgenommenen Erkennungen der laufenden Eingabe."""
        if not isinstance(getattr(self, "_capture_ignored", None), set):
            self._capture_ignored = set()
        return self._capture_ignored

    def ignore_capture_part(self, schluessel):
        self.capture_ignored().add(schluessel)
        self.update_slash_hint()
        self.entry.focus_set()

    def fill_capture_chips(self, leiste, teile, hinweis, zuruecknehmen):
        """Baut die Chipzeile neu: je Erkennung Text und ×, darunter ein Hinweis."""
        theme = self.theme
        for kind in leiste.winfo_children():
            kind.destroy()
        if teile:
            zeile = tk.Frame(leiste, bg=leiste.cget("bg"))
            zeile.pack(fill="x")
            for teil in teile:
                chip = tk.Frame(zeile, bg=theme["input"], highlightthickness=1,
                                highlightbackground=theme["input_border"])
                chip.pack(side="left", padx=(0, 6), pady=1)
                tk.Label(chip, text=teil.text, bg=theme["input"], fg=theme["text" if teil.felder else "muted"],
                         font=app_font(9)).pack(side="left", padx=(6, 2 if teil.felder else 6))
                if not teil.felder:
                    # Hinweis ohne Wirkung (KO03: Vorlauf ohne Fälligkeit): nichts zurückzunehmen.
                    continue
                weg = tk.Label(chip, text=self.ICONS["remove"], bg=theme["input"], fg=theme["muted"],
                               font=app_font(10, "bold"), cursor="hand2", padx=4)
                weg.pack(side="left")
                weg.bind("<Button-1>", lambda _event, key=teil.schluessel: zuruecknehmen(key))
                self.add_tooltip(weg, "Erkennung zurücknehmen – der Text bleibt im Titel")
        if hinweis:
            tk.Label(leiste, text=hinweis, bg=leiste.cget("bg"), fg=theme["muted"], font=app_font(9),
                     anchor="w", justify="left").pack(fill="x", pady=(3 if teile else 0, 0))

    def hide_slash_hint(self):
        leiste = getattr(self, "_capture_hint", None)
        if leiste is not None:
            try:
                leiste.place_forget()
            except tk.TclError:
                pass
        return None

    def complete_slash_command(self, event=None):
        """Tab vervollständigt das angefangene „/wort“ zum ersten passenden Befehl."""
        wort = self.slash_word()
        if wort is None:
            return None
        vorschlaege = slash_suggestions(wort, self.labels)
        if not vorschlaege:
            return "break"
        ende = self.entry.index("insert")
        self.entry.delete(ende - len(wort), ende)
        self.entry.insert(ende - len(wort), vorschlaege[0] + " ")
        self.update_slash_hint()
        return "break"

    def add_item(self):
        if self.view_mode in (self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW):
            self.focus_entry()
            return
        if self.view_mode in self.DERIVED_ITEM_VIEWS:
            self.show_info(
                self.get_display_title(),
                "Die Ansicht wird automatisch aus den Quelllisten erzeugt. Öffne dort eine Aufgabe oder Liste.",
            )
            return
        if self.view_mode == "trash":
            self.show_info(
                "Papierkorb",
                "Im Papierkorb lassen sich Einträge nur wiederherstellen oder endgültig entfernen.",
            )
            return
        text = self.get_entry_text()
        if not text:
            noun = "Listentitel" if self.view_mode == "folder" else "Punkt"
            self.show_warning("Hinweis", f"Bitte einen {noun} eingeben.")
            return
        if self.view_mode == "folder":
            self.snapshot_undo()
            ordner = self.get_folder(self.active_folder_id)
            art = self.FOLDER_KINDS.get((ordner or {}).get("folder_kind"), {}).get("list_kind")
            new_entry = self.new_list_object(text, [], folder_id=self.active_folder_id, list_kind=art)
            self.lists.append(new_entry)
            self.entry.delete(0, tk.END)
            self.entry_placeholder_active = False
            self.entry.configure(fg=self.theme["text"])
            self.save_items()
            self.refresh_folder_overview(selected_id=f"folder-list:{new_entry['id']}")
            return
        erfassung = parse_capture(text, self.labels, ignore=self.capture_ignored())
        titel, felder = erfassung.titel, erfassung.felder
        erkannt = [teil.text for teil in erfassung.teile if teil.felder]
        if not titel:
            self.show_warning("Hinweis", "Bitte einen Titel eingeben – erkannt wurden nur Angaben wie Datum oder Wichtigkeit.")
            return
        try:
            felder = self.capture_item_fields(felder)
        except ValueError as fehler:
            self.show_warning("Erinnerung", str(fehler))
            return
        self.snapshot_undo()
        self.items.append(self.new_item(titel, False, **felder))
        self.clear_entry_text()
        self.hide_slash_hint()
        self.save_items()
        self.refresh_tree(selected_id=self.items[-1]["id"])
        self.feedback("item_created")
        if erkannt:
            self.show_undo_toast("Angelegt · " + " · ".join(erkannt))

    def clear_entry_text(self):
        """Leert die Schnelleingabe und setzt den Platzhalterzustand zurück."""
        self._capture_ignored = set()
        self.entry.delete(0, tk.END)
        self.entry_placeholder_active = False
        self.entry.configure(fg=self.theme["text"])

    def attach_calendar_picker(self, parent, variable, with_time=True, title="Fälligkeit",
                               dialog_parent=None, formatter=None):
        """Setzt einen Kalenderknopf neben ein beliebiges Datumsfeld.

        Ein Kalender existierte bis 3.22 nur in `DueField`,
        also in der Eingabemaske, in der Mehrfachbearbeitung und im
        Kalenderfenster. Überall sonst – allen voran in der Schnellerfassung –
        musste ein Datum getippt werden. Diese Methode hängt dieselbe
        Auswahl an jedes Feld, das eine Zeichenkette hält: Der Knopf öffnet
        `themed_due_dialog`, und was dort gewählt wird, landet als Text im
        Feld. Getippt werden darf weiterhin; beide Wege schreiben in dieselbe
        Variable, damit es genau eine Wahrheit gibt.
        """
        def waehlen():
            roh = str(variable.get() or "").strip()
            start_due, start_time = None, None
            if roh:
                try:
                    start_due, start_time = parse_capture_due(roh)
                except ValueError:
                    start_due, start_time = None, None
            gewaehlt = self.themed_due_dialog(
                start_due, start_time,
                parent=dialog_parent or parent.winfo_toplevel(),
                **({} if with_time else {"title": title, "show_time": False}),
            )
            if gewaehlt is None:
                return
            datum, zeit = gewaehlt
            if not datum:
                variable.set("")
                return
            if formatter is not None:
                variable.set(formatter(datum, zeit))
                return
            text = self.format_due_display(datum)
            variable.set(f"{text} {zeit}" if zeit else text)

        knopf = self._make_dialog_button(parent, self.ICONS["calendar"], waehlen,
                                         "import", width=44, height=40)
        self.add_tooltip(knopf, "Datum im Kalender wählen")
        return knopf

    def _capture_text_field(self, parent, title, variable, with_calendar=False,
                            dialog_parent=None, pady=(10, 5)):
        self._make_field_label(parent, title).pack(anchor="w", pady=pady)
        zeile = tk.Frame(parent, bg=self.theme["bg"])
        zeile.pack(fill="x")
        border, field = self._make_field(zeile)
        border.pack(side="left", fill="x", expand=True)
        field.pack(fill="x", padx=1, pady=1)
        entry = tk.Entry(field, textvariable=variable, font=app_font(11), relief="flat", bd=0,
                         highlightthickness=0, bg=self.theme["input"], fg=self.theme["text"],
                         insertbackground=self.theme["text"])
        entry.pack(fill="x", padx=self.FIELD_PAD_X, pady=self.FIELD_PAD_Y)
        entry.bind("<FocusIn>", lambda e: border.configure(bg=self.theme["selection"]))
        entry.bind("<FocusOut>", lambda e: border.configure(bg=self.theme["input_border"]))
        if with_calendar:
            self.attach_calendar_picker(zeile, variable,
                                        dialog_parent=dialog_parent).pack(side="right", padx=(8, 0), before=border)
        return entry

    def capture_item(self, text, list_id, due_text="", description="", ignore=()):
        """Erfasst ohne Ansichtswechsel; ein Schreibfehler darf keine Dublette hinterlassen.

        Die Beschreibung kam dazu. Sie ist freiwillig und
        läuft durch dieselbe Begrenzung wie in der vollständigen Eingabemaske,
        damit hier nichts entstehen kann, was die Maske nicht mehr annimmt.

        Seit 3.33.3 (G01) liest derselbe Parser wie in der Eingabezeile den
        Titel; ein ausgefülltes Feld „Fällig“ hat Vorrang vor einer
        Fälligkeit im Titel.
        """
        erfassung = parse_capture(str(text or "").strip(), self.labels, ignore=ignore)
        text, felder = erfassung.titel, dict(erfassung.felder)
        if not text:
            raise ValueError("Bitte einen Aufgabentitel eingeben.")
        target = next((entry for entry in self.lists if entry["id"] == list_id), None)
        if target is None:
            raise ValueError("Die Zielliste ist nicht mehr vorhanden. Bitte erneut auswählen.")
        if not self.list_accepts_items(target):
            raise ValueError("Eine Zeichnung nimmt keine Aufgaben auf. Bitte eine andere Liste wählen.")
        due, due_time = parse_capture_due(due_text)
        if due:
            felder["due"], felder["due_time"] = due, due_time
        felder = self.capture_item_fields(felder)
        beschreibung = str(description or "").strip()
        if getattr(self, "_data_read_only", False):
            raise ValueError("Die Datenablage ist schreibgeschützt. Die Aufgabe wurde nicht angelegt.")
        item = self.new_item(text, description=beschreibung, **felder)
        undo_before, dirty_before = list(self.undo_stack), self.dirty
        items = target.setdefault("items", [])
        with self.item_change((), restore=False, update_sidebar=True) as change:
            items.append(item)
            change.mark()
        if not change.saved:
            items[:] = [value for value in items if value is not item]
            self.undo_stack = undo_before
            self.dirty = dirty_before
            self.update_sidebar_list(); self.refresh_tree()
            return None
        return item

    def show_quick_capture(self, event=None):
        existing = getattr(self, "_quick_capture_dialog", None)
        if existing is not None and existing.winfo_exists():
            existing.lift(); return "break"
        theme = self.theme
        dialog = self._quick_capture_dialog = tk.Toplevel(self.root)
        dialog.title("Schnellerfassung"); dialog.configure(bg=theme["bg"]); dialog.transient(self.root)
        dialog.minsize(500, 400)
        actions = tk.Frame(dialog, bg=theme["bg"])
        actions.pack(side="bottom", fill="x", padx=glide_design.SPACING[24], pady=glide_design.SPACING[16])
        body = tk.Frame(dialog, bg=theme["bg"], padx=glide_design.SPACING[24], pady=glide_design.SPACING[18])
        body.pack(fill="both", expand=True)
        tk.Label(body, text="Schnell eine Aufgabe festhalten", bg=theme["bg"], fg=theme["text"],
                 font=app_font(16, "bold"), anchor="w").pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[4]))
        title_var, due_var = tk.StringVar(), tk.StringVar()
        entry = self._capture_text_field(body, "Aufgabe", title_var, pady=(glide_design.SPACING[0], glide_design.SPACING[5]))
        # Dieselbe Erkennung wie in der Eingabezeile (G01): Chips mit ×.
        erkannt = tk.Frame(body, bg=theme["bg"])
        erkannt.pack(fill="x")
        ignoriert = set()

        def zeige_erkannt(*_args):
            if not title_var.get().strip():
                ignoriert.clear()
            teile = parse_capture(title_var.get(), self.labels, ignore=ignoriert).teile
            if due_var.get().strip():
                teile = tuple(teil._replace(text=f"{teil.text} – das Feld „Fällig“ hat Vorrang")
                              if "due" in teil.felder else teil for teil in teile)
            self.fill_capture_chips(erkannt, teile, None, zuruecknehmen)

        def zuruecknehmen(schluessel):
            ignoriert.add(schluessel)
            zeige_erkannt()
            entry.focus_set()
        titel_trace = title_var.trace_add("write", zeige_erkannt)
        self._make_field_label(body, "In Liste ablegen").pack(anchor="w", pady=(glide_design.SPACING[12], glide_design.SPACING[5]))
        choices, colors = {}, {}
        inbox_id = self.ensure_inbox_list()["id"]
        default = ""
        for index, source in enumerate(self.lists, 1):
            name = self.list_path_title(source)
            if name in choices:
                name += f" ({index})"
            choices[name] = source["id"]
            colors[name] = self.inherited_list_color(source) or "text"
            if source["id"] == inbox_id:
                default = name
        list_var = tk.StringVar(value=default)
        border, _ = self._make_option_menu(body, list_var, list(choices), option_colors=colors)
        border.pack(fill="x")
        # Der Kalenderknopf sitzt direkt am Feld. Getippt
        # werden darf weiter – die Freitexteingabe „morgen um 14:30" bleibt
        # der schnellste Weg und ist der Grund, warum es diesen Dialog gibt.
        due_entry = self._capture_text_field(body, "Fällig (optional)", due_var,
                                             with_calendar=True, dialog_parent=dialog,
                                             pady=(glide_design.SPACING[12], glide_design.SPACING[5]))
        hint = tk.Label(body, text="z. B. morgen um 14:30, Montag, in 3 Tagen oder 24.09.2026 – "
                                   "oder über den Kalender daneben",
                        bg=theme["bg"], fg=theme["muted"], anchor="w", justify="left")
        hint.pack(fill="x", pady=(glide_design.SPACING[5], glide_design.SPACING[0]))
        preview = tk.Label(body, text="", bg=theme["bg"], fg=theme["muted"], anchor="w", justify="left")
        preview.pack(fill="x", pady=(glide_design.SPACING[6], glide_design.SPACING[0]))
        # Eine Beschreibung gehört zum Festhalten dazu.
        # Wer eine Aufgabe im Vorbeigehen notiert, hat meist genau dann den
        # Zusammenhang im Kopf – und später nicht mehr. Drei Zeilen reichen
        # dafür und lassen den Dialog schmal.
        self._make_field_label(body, "Beschreibung (optional)").pack(anchor="w", pady=(glide_design.SPACING[12], glide_design.SPACING[5]))
        note_border, note_field = self._make_field(body)
        note_border.pack(fill="x")
        note_field.pack(fill="x", padx=glide_design.SPACING[1], pady=glide_design.SPACING[1])
        note = tk.Text(note_field, height=3, wrap="word", font=app_font(11), relief="flat", bd=0,
                       highlightthickness=0, bg=theme["input"], fg=theme["text"],
                       insertbackground=theme["text"],
                       selectbackground=theme["selection"], selectforeground=theme["selection_text"])
        note.pack(fill="both", expand=True, padx=self.FIELD_PAD_X, pady=self.FIELD_PAD_Y)
        note.bind("<FocusIn>", lambda e: note_border.configure(bg=theme["selection"]))
        note.bind("<FocusOut>", lambda e: note_border.configure(bg=theme["input_border"]))
        # Tab verlässt das Textfeld, statt einen Tabulator einzufügen: In
        # einem Dialog ist die Fokusreihenfolge wichtiger als Einrückung.
        note.bind("<Tab>", lambda e: (note.tk_focusNext().focus_set(), "break")[1])
        note.bind("<Shift-Tab>", lambda e: (note.tk_focusPrev().focus_set(), "break")[1])
        more = tk.BooleanVar(value=False)
        # Ein ttk.Checkbutton zeichnet sich nach den
        # Vorgaben des Betriebssystems – im Dunkelmodus ein weißer Kasten
        # mitten in der dunklen Maske. Alle anderen Kästchen in Glide sind
        # tk.Checkbutton mit Themefarben; dieses eine war übersehen worden.
        tk.Checkbutton(body, text="Danach eine weitere Aufgabe erfassen", variable=more,
                       bg=theme["bg"], fg=theme["text"], activebackground=theme["bg"],
                       activeforeground=theme["text"], selectcolor=theme["input"],
                       relief="flat", bd=0, highlightthickness=0, anchor="w",
                       font=app_font(10)).pack(fill="x", pady=(glide_design.SPACING[12], glide_design.SPACING[0]))
        message = tk.Label(body, text="", bg=theme["bg"], fg=theme["delete"], anchor="w", justify="left")
        message.pack(fill="x", pady=(glide_design.SPACING[8], glide_design.SPACING[0]))
        def show_preview(*_args):
            try:
                due, due_time = parse_capture_due(due_var.get())
                preview.configure(text="Fälligkeit: " + (self.format_due_full(due, due_time) if due else "Kein Termin"),
                                  fg=theme["muted"])
            except ValueError as exc:
                preview.configure(text=str(exc), fg=theme["delete"])
        trace = due_var.trace_add("write", show_preview)
        due_trace = due_var.trace_add("write", zeige_erkannt)
        def submit(open_source=False):
            try:
                item = self.capture_item(title_var.get(), choices.get(list_var.get()),
                                         due_var.get(), note.get("1.0", "end-1c"), ignore=ignoriert)
            except ValueError as exc:
                message.configure(text=str(exc), fg=theme["delete"]); return "break"
            if item is None:
                message.configure(text="Nicht gespeichert. Die Eingaben bleiben zum erneuten Versuch erhalten.", fg=theme["delete"])
                return "break"
            if more.get() and not open_source:
                title_var.set(""); due_var.set(""); note.delete("1.0", "end"); entry.focus_set()
                message.configure(text="Aufgabe gespeichert in: " + list_var.get(), fg=theme["confirm"])
            else:
                target_id = choices[list_var.get()]
                dialog.destroy()
                if open_source:
                    self.set_active_list(target_id)
                    self.workspace.set_mode("list")
                    self.refresh_tree(selected_id=item["id"])
            return "break"
        self._make_dialog_button(actions, "Erfassen", submit, "confirm", width=110).pack(side="right")
        self._make_dialog_button(actions, "Erfassen & öffnen", lambda: submit(True), "accent", width=158).pack(side="right", padx=glide_design.SPACING[8])
        self._make_dialog_button(actions, "Abbrechen", dialog.destroy, "muted", width=110).pack(side="right")
        # Return speichert – außer im Beschreibungsfeld,
        # wo eine neue Zeile das Erwartete ist. Strg+Return speichert auch von
        # dort aus.
        dialog.bind("<Return>", lambda e: submit())
        note.bind("<Return>", lambda e: None)
        note.bind("<Control-Return>", lambda e: submit())
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        def resize(event):
            for label in (hint, preview, message):
                label.configure(wraplength=max(240, event.width-48))
        body.bind("<Configure>", resize)
        show_preview()
        self._center_dialog(dialog, min_width=620, min_height=560)
        # Die Fensterleiste folgt dem Design wie bei jedem
        # anderen Dialog. Sie fehlte hier als einzige und blieb unter Windows
        # weiß, während die Maske darunter dunkel war.
        self._schedule_windows_chrome_theme(dialog)
        entry.focus_set()
        try:
            self.run_modal(dialog)
        finally:
            due_var.trace_remove("write", trace)
            due_var.trace_remove("write", due_trace)
            title_var.trace_remove("write", titel_trace)
            self._quick_capture_dialog = None
        return "break"

    def advanced_entry_context(self):
        """Womit die erweiterte Eingabe aus der aktuellen Ansicht startet.

        „Erweitert“ verlangte bis 3.24 eine geöffnete
        Liste und antwortete in „Mein Tag“, „In Bearbeitung“, „Verspätet“ und
        „Labels“ mit dem Hinweis, man möge die Aufgabe in ihrer Quellliste
        öffnen. Das war die Antwort auf eine andere Frage: Wer dort auf
        „Erweitert“ drückt, will einen neuen Punkt anlegen, nicht einen
        bestehenden bearbeiten. Die Maske führt die Zielliste ohnehin als Feld;
        gebraucht wird also keine geöffnete Liste, sondern eine sinnvolle
        Vorbelegung. Rückgabe: Hinweistext, Bearbeitungstag, Labels.
        """
        if self.view_mode == self.PLAN_DAY_VIEW:
            return (f"Der Punkt bekommt {self.format_plan_day()} als Bearbeitungstag. "
                    "Zielliste, Termin und alles Weitere sind frei wählbar.",
                    self.plan_day(), None)
        if self.view_mode == self.LABELS_VIEW:
            label = self.get_label(self.label_group_key_from_iid(self.tree.focus())
                                   if hasattr(self, "tree") else None)
            if label and not self.is_system_label(label):
                return (f"Der Punkt bekommt das Label „{label.get('name')}“. "
                        "Zielliste, Termin und alles Weitere sind frei wählbar.",
                        None, [label.get("id")])
            return ("Der Punkt wird in der gewählten Zielliste angelegt und erscheint hier, "
                    "sobald er ein Label trägt.", None, None)
        if self.view_mode in ("in_progress", "overdue", "saved_filter"):
            return ("Der Punkt wird in der gewählten Zielliste angelegt und erscheint hier, "
                    "sobald er fällig ist.", None, None)
        return ("Alle Angaben außer dem Titel sind freiwillig und später änderbar.", None, None)

    def add_item_advanced(self, event=None):
        """Öffnet die vollständige Eingabemaske für einen neuen Punkt.

        Was bereits in der Schnelleingabe steht, wird übernommen – der Wechsel
        in die erweiterte Eingabe kostet also nichts von dem, was schon getippt
        wurde.
        """
        if self.view_mode not in self.DERIVED_ITEM_VIEWS and not self.require_list_view():
            return "break"
        if not self.lists:
            self.show_info("Neuer Punkt", "Lege zuerst eine Liste an – ein Punkt braucht eine Zielliste.")
            return "break"
        hinweis, vorbelegter_tag, vorbelegte_labels = self.advanced_entry_context()
        prefilled = self.get_entry_text()
        details = self.new_item_dialog(
            "Neuer Punkt",
            hinweis,
            allow_list_choice=True,
            default_list_id=self.active_list_id,
            default_planned=vorbelegter_tag,
            default_labels=vorbelegte_labels,
            initial_text=prefilled,
        )
        if details is None:
            return "break"
        new_entry = self.build_item_from_dialog(details)
        if new_entry is None:
            return "break"
        target_list_id = details.get("list_id") or self.active_list_id
        self.snapshot_undo()
        # In einer abgeleiteten Ansicht zeigt `self.items` auf die zuletzt
        # geöffnete Liste. Dorthin anzuhängen wäre nicht nachvollziehbar –
        # deshalb geht der Punkt immer über seine Zielliste.
        if target_list_id and (target_list_id != self.active_list_id
                               or self.view_mode in self.DERIVED_ITEM_VIEWS):
            target = next((entry for entry in self.lists if entry.get("id") == target_list_id), None)
            if target is not None:
                target.setdefault("items", []).append(new_entry)
                if prefilled:
                    self.clear_entry_text()
                self.save_items()
                self.refresh_tree()
                self.feedback("item_created")
                return "break"
        self.items.append(new_entry)
        if prefilled:
            self.clear_entry_text()
        self.save_items()
        self.refresh_tree(selected_id=new_entry["id"])
        self.feedback("item_created")
        return "break"

    def delete_item(self, event=None):
        # Bei Tastatur-Events soll Entf in Eingabe-/Suchfeldern normal Text löschen.
        # Per Button darf Löschen unabhängig vom aktuellen Textfeld-Fokus funktionieren.
        if event is not None and self.current_focus_widget() in (self.entry, getattr(self, "search_entry", None)):
            return None
        if not self.require_list_view():
            return "break"

        selected_ids = self.get_selected_item_ids()
        if not selected_ids:
            self.show_warning("Hinweis", "Zuerst einen Punkt auswählen.")
            return

        # Ganze Zweige wandern gemeinsam. Wäre ein Unterpunkt zusätzlich
        # ausgewählt, entstünde sonst ein zweiter Papierkorbeintrag desselben
        # Punkts – und beim Wiederherstellen eine Dublette.
        selected_ids = self.filter_top_level_selection(
            [item_id for item_id in self.iter_tree_ids() if item_id in set(selected_ids)]
        ) or selected_ids
        # Die gelöschten Punkte gibt es danach nicht mehr: kein Ziel für Blick
        # oder Auswahl.
        with self.item_change((), restore=False) as change:
            geloescht = 0
            for item_id in selected_ids:
                if self.move_item_to_trash(item_id):
                    change.mark()
                    geloescht += 1
        if geloescht:
            self.feedback("deleted", geloescht)
            self.show_undo_toast(f"{geloescht} Punkt(e) in den Papierkorb gelegt")

    def move_item_to_trash(self, item_id):
        """Legt einen Punkt samt Unterpunkten in den Papierkorb.

        Vorher entfernte „Löschen“ einen Punkt sofort und endgültig: Er stand
        weder im Papierkorb noch sonst wo, und nach einem Neustart war auch
        Rückgängig verbraucht. Jetzt bleibt er wiederherstellbar – mit seiner
        Herkunft, sodass er an dieselbe Stelle zurückkehrt.
        """
        found = self.find_item(item_id)
        if not found:
            return False
        item, siblings, index, parent_item = found
        origin = {
            "list_id": self.active_list_id,
            "list_title": self.app_title,
            "parent_item_id": parent_item.get("id") if parent_item else None,
            "index": index,
        }
        removed = self.remove_item_by_id(item_id)
        if not removed:
            return False
        self.push_trash_entry(
            self.new_trash_entry(self.TRASH_KIND_ITEM, copy.deepcopy(removed), origin=origin)
        )
        return True

    # -----------------------------
    # Aktionen der erweiterten Kontextmenüs
    # -----------------------------
    def add_child_item(self, parent_id=None):
        """Legt einen Unterpunkt unter dem gewählten Punkt an."""
        if not self.require_list_view():
            return "break"
        parent_id = parent_id or self.get_selected_item_id()
        if not parent_id:
            return "break"
        found = self.find_item(parent_id)
        if not found:
            return "break"
        details = self.new_item_dialog(
            "Neuer Unterpunkt",
            "Der Punkt entsteht unterhalb des ausgewählten Punkts.",
        )
        if details is None:
            return "break"
        self.snapshot_undo()
        child = self.build_item_from_dialog(details)
        found[0].setdefault("children", []).append(child)
        self.expanded_ids.add(parent_id)
        self.collapsed_item_ids.discard(parent_id)
        self.save_items()
        self.refresh_tree(selected_id=child["id"])
        return "break"

    def add_sibling_item(self, kind=ITEM_KIND_TASK, reference_id=None):
        """Legt einen Punkt oder eine Gruppe auf derselben Ebene an."""
        if not self.require_list_view():
            return "break"
        is_group = kind == self.ITEM_KIND_GROUP
        details = self.new_item_dialog(
            "Neue Gruppe" if is_group else "Neuer Punkt",
            (
                "Eine Gruppe fasst Punkte zusammen und trägt selbst keinen Status."
                if is_group
                else "Titel eingeben. Alle weiteren Angaben sind freiwillig und später änderbar."
            ),
            kind=kind if is_group else None,
            allow_list_choice=True,
            default_list_id=self.active_list_id,
        )
        if details is None:
            return "break"
        reference_id = reference_id or self.get_selected_item_id()
        target_list_id = details.get("list_id")
        self.snapshot_undo()
        new_entry = self.build_item_from_dialog(details)
        # Eine abweichende Zielliste bekommt den Punkt am Ende; innerhalb der
        # geöffneten Liste entsteht er direkt unter der Auswahl.
        if target_list_id and target_list_id != self.active_list_id:
            target_entry = next(
                (entry for entry in self.lists if entry.get("id") == target_list_id), None
            )
            if target_entry is not None:
                target_entry.setdefault("items", []).append(new_entry)
                self.save_items()
                self.update_sidebar_list()
                self.refresh_tree()
                return "break"
        target_list = self.items
        insert_index = len(target_list)
        if reference_id:
            found = self.find_item(reference_id)
            if found:
                _item, siblings, index, _parent = found
                target_list = siblings
                insert_index = index + 1
        target_list.insert(insert_index, new_entry)
        self.save_items()
        self.update_sidebar_list()
        self.refresh_tree(selected_id=new_entry["id"])
        return "break"

    def convert_selected_kind(self, kind):
        """Wandelt die Auswahl zwischen Aufgabe und Gruppe um."""
        item_ids = self.selected_items_for_change()
        if item_ids is None:
            return "break"
        # Gruppen und Überschriften zählen nicht als Aufgabe: der Zähler in der
        # Seitenleiste ändert sich mit der Art.
        with self.item_change(item_ids, update_sidebar=True) as change:
            for item_id in item_ids:
                found = self.find_item(item_id)
                if found and self.set_item_kind(found[0], kind):
                    change.mark()
        return "break"

    def group_selected_items(self):
        """Fasst die ausgewählten Punkte in einer neuen Gruppe zusammen."""
        if not self.require_list_view():
            return "break"
        item_ids = self.filter_top_level_selection(
            [item_id for item_id in self.iter_tree_ids() if item_id in set(self.get_selected_item_ids())]
        )
        if not item_ids:
            self.show_warning("Hinweis", "Zuerst mindestens einen Punkt auswählen.")
            return "break"
        first_found = self.find_item(item_ids[0])
        if not first_found:
            return "break"
        # Alle Punkte müssen dieselbe Ebene teilen, sonst wäre das Ergebnis nicht vorhersehbar.
        target_siblings = first_found[1]
        for item_id in item_ids[1:]:
            found = self.find_item(item_id)
            if not found or found[1] is not target_siblings:
                self.show_info(
                    "Gruppieren",
                    "Nur Punkte derselben Ebene lassen sich gemeinsam gruppieren.",
                )
                return "break"
        title = self.themed_input_dialog("Neue Gruppe", "Titel der Gruppe:", ok_text="Gruppieren")
        if title is None:
            return "break"
        title = title.strip()
        if not title:
            self.show_warning("Hinweis", "Bitte einen Titel eingeben.")
            return "break"
        insert_index = first_found[2]
        with self.guarded_structural_change("Gruppieren"):
            self.snapshot_undo()
            moved = []
            for item_id in item_ids:
                removed = self.remove_item_by_id(item_id)
                if removed:
                    moved.append(removed)
            if len(moved) != len(item_ids):
                # Ein Punkt ließ sich nicht entfernen. Lieber gar nicht
                # gruppieren als einen Teil der Auswahl zurücklassen.
                self.rollback_to_undo_depth(len(self.undo_stack) - 1)
                self.show_warning(
                    "Gruppieren",
                    "Die Auswahl hat sich zwischenzeitlich verändert. Bitte erneut auswählen.",
                )
                return "break"
            group = self.new_item(title, False, children=moved, kind=self.ITEM_KIND_GROUP)
            insert_index = max(0, min(insert_index, len(target_siblings)))
            target_siblings.insert(insert_index, group)
            self.expanded_ids.add(group["id"])
            self.collapsed_item_ids.discard(group["id"])
            # Die Punkte liegen jetzt eine Ebene tiefer. Ohne diese Zeilen
            # zeichnete der Baum sie zugeklappt, und ihre Unterpunkte
            # verschwänden aus der Ansicht, obwohl sie in den Daten stehen.
            self.keep_branch_expanded(moved)
            self.save_items()
            self.refresh_tree(selected_id=group["id"])
        self.feedback("grouped", len(moved))
        self.show_undo_toast(f"{len(moved)} Punkte gruppiert")
        return "break"

    def keep_branch_expanded(self, items):
        """Hält einen ganzen Zweig aufgeklappt.

        Ein Punkt auf oberster Ebene wird von sich aus offen gezeichnet. Wandert
        er eine Ebene tiefer – etwa beim Gruppieren –, gilt das nicht mehr:
        seine Unterpunkte wären ohne Zutun unsichtbar. Diese Methode überträgt
        den offenen Zustand ausdrücklich, damit Darstellung und Daten beim
        Umbauen deckungsgleich bleiben.
        """
        for item_id in self.collect_item_ids(items):
            if item_id not in self.collapsed_item_ids:
                self.expanded_ids.add(item_id)

    def dissolve_selected_group(self):
        """Löst eine Gruppe auf; die Unterpunkte rücken an ihre Stelle.

        Zwingende Zusage: Diese Aktion darf niemals einen enthaltenen Punkt
        entfernen. Der Bestandswächter prüft das nach jedem Aufruf.
        """
        if not self.require_list_view():
            return "break"
        item_id = self.get_selected_item_id()
        found = self.find_item(item_id) if item_id else None
        if not found or not self.is_group_item(found[0]):
            return "break"
        group, siblings, index, _parent = found
        children = [child for child in group.get("children", []) if isinstance(child, dict)]
        expected = self.collect_item_ids(children)
        # Nur die Hülle der Gruppe darf verschwinden – kein enthaltener Punkt.
        with self.guarded_structural_change("Gruppe auflösen", expected_removals={group.get("id")}):
            self.snapshot_undo()
            siblings.pop(index)
            for offset, child in enumerate(children):
                siblings.insert(index + offset, child)
            # Doppelt geprüft: Jeder Punkt der Gruppe steht danach wieder in der
            # Liste. Der Wächter fängt den allgemeinen Fall, diese Zeile den
            # konkreten – Auflösen ist der Weg, den der Nutzer am häufigsten geht.
            restored = self.collect_item_ids(self.items)
            if expected - restored:
                raise DataIntegrityError("Gruppe auflösen hätte Punkte entfernt")
            self.keep_branch_expanded(children)
            self.save_items()
            self.refresh_tree(selected_id=children[0]["id"] if children else None)
        return "break"

    def copy_items_with_new_ids(self, items, mapping=None, remap_typed=True):
        """Tiefe Kopie mit frischen IDs für jeden Punkt und Anhang.

        Ohne neue IDs entstünden Dubletten: der Aufgabenbaum verweigert
        doppelte Zeilen-IDs, und listenübergreifende Suchen träfen den falschen
        Punkt. Anhänge behalten ihren Speicherpfad – die Datei wird geteilt,
        nicht kopiert.
        """
        duplicated = copy.deepcopy(items if isinstance(items, list) else [])
        local = {}
        stack = list(duplicated)
        while stack:
            item = stack.pop()
            if not isinstance(item, dict):
                continue
            # Wer die neue Kennung kennt, kann mitgebrachte
            # Verweise – etwa Pinnwandkarten und Verbindungen – nachziehen.
            # Ohne diese Zuordnung wäre eine importierte Anordnung verloren,
            # obwohl sie in der Datei steht.
            alt = item.get("id")
            item["id"] = uuid.uuid4().hex
            if isinstance(mapping, dict) and isinstance(alt, str):
                mapping[alt] = item["id"]
            if item.get("reminder"):
                item["reminder"] = self.reminder_config(item["reminder"])
            for attachment in item.get("attachments", []):
                if isinstance(attachment, dict):
                    attachment["id"] = uuid.uuid4().hex
            children = item.get("children", [])
            if isinstance(children, list):
                stack.extend(children)
            local[alt] = item["id"]
        # Verweise innerhalb der Kopie zeigen auf die Kopie; Verweise nach
        # außen bleiben, denn das Ziel besteht unverändert weiter.
        self.remap_item_references(duplicated, local)
        if remap_typed:
            for item in self.walk_items(duplicated):
                glide_objects.remap_holder(item, {}, local)
        return duplicated

    @staticmethod
    def remap_rich_note_items(entry, mapping):
        """Aufgabenmarken einer Seite folgen neuen Punktkennungen.

        Import, Vorlage und Duplikat vergeben neue Kennungen. Bis 27.09.2026
        zeigten die Marken `item:<id>` im Seitentext danach ins Leere, und die
        Aufgaben einer kopierten Seite waren von ihren Punkten getrennt.
        """
        dokument = entry.get('rich_note') if isinstance(entry, dict) else None
        glide_task_refs.remap(dokument, mapping)

    def remap_item_references(self, items, mapping):
        """Zieht Verknüpfungen und Abhängigkeiten auf neue Kennungen nach."""
        if not mapping:
            return
        for item in self.walk_items(items):
            for field in ("links", "blocked_by"):
                values = item.get(field)
                if isinstance(values, list) and values:
                    item[field] = list(dict.fromkeys(mapping.get(value, value) for value in values))

    def clean_item_references(self, lists, trash=None):
        """Entfernt Verweise auf fehlende Punkte und trennt Abhängigkeitskreise.

        Punkte im Papierkorb bleiben Ziel ihrer Verweise: Wird der Punkt
        wiederhergestellt, ist auch die Beziehung wieder da.
        """
        known = set()
        for entry in lists:
            self.collect_item_ids(entry.get("items", []), known)
        for entry in trash or []:
            for key in ("item", "list", "folder", "payload"):
                value = entry.get(key) if isinstance(entry, dict) else None
                if isinstance(value, dict):
                    self.collect_item_ids([value], known)
                    self.collect_item_ids(value.get("items", []), known)
                    for nested in value.get("lists", []) if isinstance(value.get("lists"), list) else []:
                        if isinstance(nested, dict):
                            self.collect_item_ids(nested.get("items", []), known)
        items = [item for entry in lists for item in self.walk_items(entry.get("items", []))]
        for item in items:
            own = item.get("id")
            for field in ("links", "blocked_by"):
                values = item.get(field)
                if isinstance(values, list):
                    item[field] = [value for value in values if value in known and value != own]
        graph = {item.get("id"): item for item in items}
        state = {}

        def visit(item_id):
            state[item_id] = 1
            item = graph.get(item_id)
            kept = []
            for target in item.get("blocked_by", []) if item else []:
                if state.get(target) == 1:
                    continue  # Diese Kante schlösse einen Kreis.
                if target in graph and state.get(target) is None:
                    visit(target)
                kept.append(target)
            if item is not None:
                item["blocked_by"] = kept
            state[item_id] = 2

        for item_id in list(graph):
            if state.get(item_id) is None:
                visit(item_id)

    def duplicate_selected_items(self):
        """Legt eine unabhängige Kopie der Auswahl direkt darunter an."""
        item_ids = self.selected_items_for_change(top_level_only=True)
        if item_ids is None:
            return "break"
        self.feedback("duplicated", len(item_ids))
        # Die Kopien sind neue Punkte: Nicht die Auswahl wird wiederhergestellt,
        # sondern die zuletzt angelegte Kopie bekommt den Blick.
        with self.item_change(item_ids, restore=False) as change:
            for item_id in item_ids:
                found = self.find_item(item_id)
                if not found:
                    continue
                item, siblings, index, _parent = found
                copy_item = self.copy_items_with_new_ids([item])
                if not copy_item:
                    continue
                siblings.insert(index + 1, copy_item[0])
                change.mark(copy_item[0]["id"])
        return "break"

    def move_selected_items(self, offset):
        """Verschiebt die Auswahl innerhalb ihrer Ebene um eine Position."""
        if self.view_mode == self.PLAN_DAY_VIEW:
            # Im Zeitplan heißt „nach oben“ früher (Ausbau AO-070).
            return self.shift_time_plan_selection(offset)
        item_ids = self.selected_items_for_change(top_level_only=True)
        if item_ids is None:
            return "break"
        # Nach oben zuerst den obersten Punkt bewegen, nach unten den untersten:
        # sonst überholen sich die Punkte einer Mehrfachauswahl gegenseitig.
        ordered = item_ids if offset < 0 else list(reversed(item_ids))
        with self.item_change(item_ids, focus="first") as change:
            for item_id in ordered:
                found = self.find_item(item_id)
                if not found:
                    continue
                item, siblings, index, _parent = found
                target = index + offset
                if 0 <= target < len(siblings):
                    siblings.pop(index)
                    siblings.insert(target, item)
                    change.mark()
        return "break"

    def move_selected_to_list_dialog(self):
        """Verschiebt die Auswahl in eine per Dialog gewählte Zielliste."""
        item_ids = self.selected_items_for_change()
        if item_ids is None:
            return "break"
        choices = []
        for entry in self.lists:
            if entry.get("id") == self.active_list_id or not self.list_accepts_items(entry):
                continue
            choices.append((entry.get("id"), self.list_path_title(entry)))
        if not choices:
            self.show_info("Verschieben", "Es gibt keine andere Liste als Ziel.")
            return "break"
        # Zuletzt benutzte Ziele zuerst (KO06), danach die gewohnte Reihenfolge.
        titel = dict(choices)
        vorn, rest = glide_interaction.recent_first(list(titel), self.settings.get("recent_move_targets"))
        choices = [(key, titel[key]) for key in vorn + rest]
        target_id = self.themed_choice_dialog(
            "In Liste verschieben", "In welche Liste sollen die Punkte verschoben werden?", choices,
            item_colors={entry["id"]: self.inherited_list_color(entry) or "text" for entry in self.lists}
        )
        if target_id:
            with self.settings_write_batch():
                self.remember_recent_target(target_id, "list")
                self.move_items_to_list(item_ids, target_id)
        return "break"

    def clear_list(self):
        if not self.require_list_view():
            return
        if self.ask_yes_no("Löschen", "Alle Punkte wirklich löschen?"):
            self.snapshot_undo()
            self.items.clear()
            self.save_items()
            self.refresh_tree()

    def edit_item(self):
        if not self.require_list_view():
            return
        item_id = self.get_selected_item_id()
        if not item_id:
            # Ein Menüeintrag mit „…“ darf nie still bleiben (R11, 29.09.2026).
            self.show_info("Punktdetails", "Markiere zuerst einen Punkt in der Liste.")
            return
        found = self.find_item(item_id)
        if not found:
            return
        item, _siblings, _index, _parent_item = found
        details = self.themed_item_details_dialog(item)
        if details is None:
            return

        with self.item_change([item_id], restore=False) as change:
            if self.apply_item_details(item, details):
                change.mark()

    def _new_themed_popup_menu(self, parent=None):
        return tk.Menu(
            parent or self.root,
            tearoff=0,
            bg=self.theme["card"],
            fg=self.theme["text"],
            activebackground=self.theme["selection"],
            activeforeground=self.theme["selection_text"],
            selectcolor=self.theme["ui_accent"],
            bd=0,
            relief="flat",
            borderwidth=0,
            activeborderwidth=0,
        )

    def _add_importance_cascade(self, menu, selected_items, enabled=True):
        importance_menu = self._new_themed_popup_menu(menu)
        importance_values = {self.clamp_importance(item.get("importance", 0)) for item in selected_items}
        current_importance = next(iter(importance_values)) if len(importance_values) == 1 else None
        for value, label in ((0, "Keine"), (1, "Niedrig"), (2, "Mittel"), (3, "Hoch")):
            prefix = "✓ " if current_importance == value else "    "
            importance_menu.add_command(
                label=f"{prefix}{self.IMPORTANCE_MARKERS.get(value, '')}{label}",
                foreground=self.theme[self.importance_color_key(value)],
                activeforeground=self.theme[self.importance_color_key(value)],
                activebackground=self.theme["hover"],
                command=lambda selected=value: self.set_importance_selected(selected),
            )
        menu.add_cascade(
            label="Wichtigkeit", menu=importance_menu, state="normal" if enabled else "disabled"
        )
        return importance_menu

    def _add_due_cascade(self, menu, selected_items, enabled=True):
        due_menu = self._new_themed_popup_menu(menu)
        due_values = {item.get("due") for item in selected_items}
        current_due = next(iter(due_values)) if len(due_values) == 1 else None
        today_iso = date.today().isoformat()
        tomorrow_iso = (date.today() + timedelta(days=1)).isoformat()
        due_menu.add_command(label="Datum auswählen …", command=self.set_due_date_selected)
        due_menu.add_separator()
        due_menu.add_command(
            label=f"{'✓ ' if current_due == today_iso else '    '}Heute",
            command=lambda: self.set_due_value_selected(today_iso),
        )
        due_menu.add_command(
            label=f"{'✓ ' if current_due == tomorrow_iso else '    '}Morgen",
            command=lambda: self.set_due_value_selected(tomorrow_iso),
        )
        due_menu.add_command(
            label=f"{'✓ ' if current_due is None and len(due_values) == 1 else '    '}Entfernen",
            command=lambda: self.set_due_value_selected(None),
        )
        menu.add_cascade(label="Fälligkeit", menu=due_menu, state="normal" if enabled else "disabled")
        return due_menu

    def _add_color_cascade(self, menu, selected_items):
        color_menu = self._new_themed_popup_menu(menu)
        color_values = {item.get("color") for item in selected_items}
        current_color = next(iter(color_values)) if len(color_values) == 1 else None
        for label, color_key in self.ITEM_COLOR_CHOICES:
            prefix = "✓ " if current_color == color_key else "    "
            color_menu.add_command(
                label=f"{prefix}{label}",
                foreground=self.theme[color_key],
                command=lambda selected=color_key: self.set_item_color_selected(selected),
            )
        color_menu.add_separator()
        color_menu.add_command(
            label=f"{'✓ ' if current_color is None and len(color_values) == 1 else '    '}Keine Farbe",
            command=lambda: self.set_item_color_selected(None),
        )
        menu.add_cascade(label="Aufgabenfarbe", menu=color_menu)
        return color_menu

    def _add_label_cascade(self, menu, selected_items):
        """Labels zuweisen oder lösen – Häkchen zeigt die Zuweisung der Auswahl."""
        label_menu = self._new_themed_popup_menu(menu)
        if not self.labels:
            label_menu.add_command(label="Noch keine Labels angelegt", state="disabled")
        else:
            # Zuletzt benutzte Labels zuerst, abgetrennt (KO06); sonst gewohnte Reihenfolge.
            nach_id = {label.get("id"): label for label in self.labels}
            vorn, rest = glide_interaction.recent_first(list(nach_id), self.settings.get("recent_labels"))
            reihenfolge = [nach_id[key] for key in vorn] + [None] * bool(vorn and rest) + [nach_id[key] for key in rest]
            for label in reihenfolge:
                if label is None:
                    label_menu.add_separator()
                    continue
                label_id = label.get("id")
                assigned_count = sum(1 for item in selected_items if label_id in (item.get("labels") or []))
                if assigned_count == len(selected_items) and selected_items:
                    prefix = "✓ "
                elif assigned_count:
                    prefix = "– "  # nur ein Teil der Auswahl trägt das Label
                else:
                    prefix = "    "
                label_menu.add_command(
                    label=f"{prefix}{label.get('name', '')}",
                    foreground=self.theme[self.label_color_key(label)],
                    command=lambda selected=label_id: self.toggle_label_on_selected_items(selected),
                )
            label_menu.add_separator()
            label_menu.add_command(label="Alle Labels entfernen", command=self.clear_labels_on_selected_items)
        label_menu.add_separator()
        label_menu.add_command(label="Labels verwalten …", command=self.open_label_manager)
        menu.add_cascade(label="Labels", menu=label_menu)
        return label_menu

    def build_item_context_menu(self):
        """Vollständiges Kontextmenü für die aktuelle Aufgaben-/Mehrfachauswahl."""
        item_ids = self.get_selected_item_ids()
        if not item_ids:
            return None
        selected_items = [self.find_item(item_id)[0] for item_id in item_ids if self.find_item(item_id)]
        if not selected_items:
            return None

        single = len(selected_items) == 1
        groups = [item for item in selected_items if self.is_group_item(item)]
        headings = [item for item in selected_items if self.is_heading_item(item)]
        longs = [item for item in selected_items if self.is_long_item(item)]
        tasks = [item for item in selected_items if self.is_schedulable_item(item)]
        only_groups = bool(groups) and not tasks and not headings
        has_tasks = bool(tasks)

        menu = self._new_themed_popup_menu()
        if single:
            header = "Gruppenaktionen" if only_groups else "Punktaktionen"
        else:
            header = f"Aktionen für {len(selected_items)} Punkte"
        menu.add_command(label=header, state="disabled")
        menu.add_separator()

        menu.add_command(
            label=(
                "Bearbeiten (Titel, Beschreibung, Anhänge) …"
                if single
                else "Bearbeiten … (nur einzeln)"
            ),
            command=self.edit_item,
            state="normal" if single else "disabled",
        )
        menu.add_command(
            label="Erledigt umschalten",
            command=self.toggle_done,
            state="normal" if has_tasks else "disabled",
        )
        if single and self.task_text_sources(item_ids[0]):
            menu.add_command(label='Textquelle öffnen …', command=lambda: self.open_task_text_source(item_ids[0]))
        if single:
            menu.add_cascade(label="Verweise und Rückverweise", menu=self.build_object_reference_menu(("item", item_ids[0]), menu))
        if has_tasks:
            menu.add_cascade(label="Einplanen", menu=self.build_quick_plan_menu(menu, item_ids),
                             accelerator=self.accel("Shift", "P"))
            self.add_repeat_skip_entries(menu, item_ids)
        menu.add_separator()

        menu.add_command(label="Als Reiter öffnen", command=lambda: self.workspace.open_tab(),
                         state="normal" if single and not headings else "disabled")
        menu.add_command(label="Auf Pinnwand anheften", command=lambda: self.workspace.pin(),
                         state="normal" if len(headings) < len(selected_items) else "disabled")
        menu.add_separator()

        # --- Neu anlegen ---
        create_menu = self._new_themed_popup_menu(menu)
        create_menu.add_command(
            label="Punkt darunter …",
            command=lambda: self.add_sibling_item(self.ITEM_KIND_TASK),
        )
        create_menu.add_command(
            label="Gruppe darunter …",
            command=lambda: self.add_sibling_item(self.ITEM_KIND_GROUP),
        )
        create_menu.add_command(
            label="Unterpunkt …",
            command=self.add_child_item,
            state="normal" if single else "disabled",
        )
        menu.add_cascade(label="Neu anlegen", menu=create_menu)

        # --- Art des Punkts ---
        # Aufgabe, Langtext, Zwischenüberschrift und Gruppe sind vier Zustände
        # derselben Eigenschaft; jeder Weg dorthin ist umkehrbar.
        kind_menu = self._new_themed_popup_menu(menu)
        kind_menu.add_command(
            label="In Aufgabe zurückwandeln",
            command=lambda: self.convert_selected_kind(self.ITEM_KIND_TASK),
            state="normal" if (groups or headings or longs) else "disabled",
        )
        kind_menu.add_command(
            label="In Langtext umwandeln",
            command=lambda: self.convert_selected_kind(self.ITEM_KIND_LONG),
            state="normal" if len(longs) < len(selected_items) else "disabled",
        )
        kind_menu.add_command(
            label="In Zwischenüberschrift umwandeln",
            command=lambda: self.convert_selected_kind(self.ITEM_KIND_HEADING),
            state="normal" if len(headings) < len(selected_items) else "disabled",
        )
        kind_menu.add_command(
            # Deutlich anders benannt als „Auswahl gruppieren“: Dieser Weg macht
            # aus jedem markierten Punkt eine eigene, leere Gruppe. Beides klang
            # vorher gleich und tat Gegenteiliges.
            label="Jeden Punkt zur leeren Gruppe machen",
            command=lambda: self.convert_selected_kind(self.ITEM_KIND_GROUP),
            state="normal" if len(groups) < len(selected_items) else "disabled",
        )
        for index, kind in enumerate((self.ITEM_KIND_TASK, self.ITEM_KIND_LONG, self.ITEM_KIND_HEADING, self.ITEM_KIND_GROUP)):
            kind_menu.entryconfigure(index, foreground=self.theme[self.kind_color_key(kind)])
        menu.add_cascade(label="Art", menu=kind_menu)

        # Gruppieren steht auf der obersten Ebene: Es ist der Weg, den man
        # sucht, wenn mehrere Punkte zusammengehören.
        menu.add_command(
            label="Auswahl gruppieren …",
            accelerator=self.accel("G"),
            command=self.group_selected_items,
        )
        menu.add_command(
            label="Gruppe auflösen (Inhalt bleibt)",
            command=self.dissolve_selected_group,
            state="normal" if single and only_groups else "disabled",
        )
        menu.add_separator()

        # Gruppen tragen bewusst keinen Status, keine Fälligkeit und keine Wichtigkeit.
        self._add_importance_cascade(menu, tasks or selected_items, enabled=has_tasks)
        self._add_due_cascade(menu, tasks or selected_items, enabled=has_tasks)
        menu.add_command(label="Bearbeitungstag und Aufwand …", command=self.set_planning_selected,
                         state="normal" if has_tasks else "disabled")
        relations_menu = self._new_themed_popup_menu(menu)
        relations_menu.add_command(label="Mit Punkten verknüpfen …", command=self.link_selected_items,
                                   state="normal" if single else "disabled")
        relations_menu.add_command(label="Wartet auf …", command=self.add_blockers_selected,
                                   state="normal" if single and has_tasks else "disabled")
        running = self.running_timer()
        tracking_this = bool(single and running and running.get("item_id") == selected_items[0].get("id"))
        relations_menu.add_separator()
        relations_menu.add_command(
            label="Zeiterfassung stoppen und buchen" if tracking_this else "Zeiterfassung starten",
            command=self.toggle_time_tracking_selected,
            state="normal" if single and has_tasks else "disabled")
        menu.add_cascade(label="Beziehungen und Zeit", menu=relations_menu)
        self._add_color_cascade(menu, selected_items)
        self._add_label_cascade(menu, selected_items)
        menu.add_separator()

        # --- Struktur ---
        structure_menu = self._new_themed_popup_menu(menu)
        structure_menu.add_command(label="Einrücken", command=self.indent_selected)
        structure_menu.add_command(label="Ausrücken", command=self.outdent_selected)
        structure_menu.add_separator()
        structure_menu.add_command(label="Nach oben", command=lambda: self.move_selected_items(-1))
        structure_menu.add_command(label="Nach unten", command=lambda: self.move_selected_items(1))
        structure_menu.add_separator()
        structure_menu.add_command(label="In Liste verschieben …", command=self.move_selected_to_list_dialog)
        menu.add_cascade(label="Struktur", menu=structure_menu)

        # --- Zwischenablage ---
        clipboard_menu = self._new_themed_popup_menu(menu)
        clipboard_menu.add_command(label="Kopieren", command=self.copy_selected_to_clipboard)
        clipboard_menu.add_command(label="Einfügen", command=self.paste_items_from_clipboard)
        clipboard_menu.add_command(label="Duplizieren", command=self.duplicate_selected_items)
        menu.add_cascade(label="Zwischenablage", menu=clipboard_menu)

        menu.add_separator()
        menu.add_command(label="Entfernen", command=self.delete_item, foreground=self.theme["delete"])
        return menu

