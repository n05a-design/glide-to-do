    @classmethod
    def normalize_template_records(cls, data):
        if isinstance(data, dict) and data.get("format_version", 1) not in (1, cls.TEMPLATE_FORMAT_VERSION):
            raise ValueError("Diese Vorlagendatei verwendet eine unbekannte Formatversion.")
        source = data.get("templates") if isinstance(data, dict) else data
        if not isinstance(source, list):
            raise ValueError("In der Datei fehlt die Vorlagenliste.")
        result, seen = [], set()
        for raw in source:
            if not isinstance(raw, dict):
                continue
            template_id = str(raw.get("id") or uuid.uuid4().hex)
            if template_id in seen:
                template_id = uuid.uuid4().hex
            kind = raw.get("kind") if raw.get("kind") in ("list", "folder") else "list"
            title = " ".join(str(raw.get("title") or "Vorlage").split())[:120] or "Vorlage"
            note = str(raw.get("note") or "")[:4000]
            color = raw.get("color") if raw.get("color") in cls.LIST_COLOR_KEYS else None
            labels = [value for value in (raw.get("labels") or []) if isinstance(value, str)][:cls.MAX_LABELS_PER_ITEM]
            items = [str(value).strip() for value in (raw.get("items") or []) if isinstance(value, str) and value.strip()][:200]
            result.append({"id": template_id, "kind": kind, "title": title, "note": note,
                           "color": color, "labels": labels, "items": items,
                           "list_kind": raw.get("list_kind") if raw.get("list_kind") in ("note", "page") else "tasks"})
            if cls.normalize_due(raw.get("schedule_anchor")):
                result[-1]["schedule_anchor"] = cls.normalize_due(raw["schedule_anchor"])
            if isinstance(raw.get("payload"), dict):
                result[-1]["payload"] = copy.deepcopy(raw["payload"])
                result[-1]["files"] = dict(raw.get("files") or {})
            seen.add(template_id)
        if not result and not isinstance(source, list):
            result = cls.default_template_records()
        return result

    def load_templates(self):
        try:
            if os.path.isfile(TEMPLATES_FILE):
                with open(TEMPLATES_FILE, "r", encoding="utf-8") as file:
                    records = self.normalize_template_records(json.load(file))
                if records == self.normalize_template_records(self.legacy_template_records()):
                    return self.default_template_records()
                legacy = {entry["id"]: entry for entry in self.legacy_template_records()}
                current = {entry["id"]: entry for entry in self.default_template_records()}
                # Nur unveränderte mitgelieferte Vorlagen aktualisieren. Eigene
                # Bearbeitungen bleiben erhalten. Neue integrierte Tagebuchvorlagen
                # werden einmalig ergänzt, damit bestehende Installationen sie
                # ebenfalls erhalten.
                # „Tagebuch“ heißt seit dem 27.09.2026 „Notizbuch“; unveränderte
                # Namen der mitgelieferten Notizbuchvorlagen ziehen mit.
                for entry in records:
                    if str(entry.get("id") or "").startswith("journal-") and \
                            str(entry.get("title") or "").startswith("Tagebuch – "):
                        entry["title"] = "Notizbuch – " + entry["title"][len("Tagebuch – "):]
                records = [copy.deepcopy(current[entry["id"]])
                           if entry == legacy.get(entry["id"]) and entry["id"] in current else entry
                           for entry in records]
                ids = {entry.get("id") for entry in records}
                for template_id in ("journal-note", "journal-gratitude", "journal-weekly", "journal-folder"):
                    if template_id in current and template_id not in ids:
                        records.append(copy.deepcopy(current[template_id]))
                return records
        except (OSError, ValueError, TypeError):
            pass
        return self.default_template_records()

    def save_templates(self):
        if getattr(self, "_data_read_only", False):
            return False
        payload = {"format_version": self.TEMPLATE_FORMAT_VERSION,
                   "templates": self.normalize_template_records(getattr(self, "templates", []))}
        self.templates = payload["templates"]
        try:
            if os.path.isfile(TEMPLATES_FILE):
                with open(TEMPLATES_FILE, "r", encoding="utf-8") as file:
                    previous = json.load(file)
                if not isinstance(previous, dict) or previous.get("format_version", 1) == 1:
                    os.makedirs(BACKUP_DIR, exist_ok=True)
                    backup = os.path.join(BACKUP_DIR, "vorlagen_vor_format2_" + datetime.now().strftime("%Y%m%d_%H%M%S_%f") + ".json")
                    shutil.copy2(TEMPLATES_FILE, backup)
            self.write_json_atomic(TEMPLATES_FILE, payload)
            return True
        except (OSError, ValueError):
            return False

    def template_by_id(self, template_id):
        return next((item for item in getattr(self, "templates", []) if item.get("id") == template_id), None)

    def read_foreign_lock(self, path=None):
        """Lokale Prozesse ohne Signale prüfen; fremde Rechner per Heartbeat."""
        try:
            with open(path or LOCK_FILE, "r", encoding="utf-8") as file:
                previous = json.load(file)
            stamp = datetime.fromisoformat(str(previous.get("refreshed_at") or previous.get("started_at")))
            if stamp.tzinfo is None:
                stamp = stamp.astimezone()
            if (datetime.now().astimezone() - stamp).total_seconds() > self.LOCK_MAX_AGE_HOURS * 3600:
                return None
            host = os.environ.get("COMPUTERNAME") or os.environ.get("HOSTNAME") or "unbekannt"
            if previous.get("host") != host:
                return previous
            pid = int(previous.get("pid", 0))
            if pid <= 0:
                return None
            if pid == os.getpid():
                return None
            if IS_WINDOWS:
                kernel = ctypes.WinDLL("kernel32", use_last_error=True)
                kernel.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_bool, ctypes.c_ulong]
                kernel.OpenProcess.restype = ctypes.c_void_p
                kernel.GetExitCodeProcess.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
                kernel.CloseHandle.argtypes = [ctypes.c_void_p]
                handle = kernel.OpenProcess(0x1000, False, pid)
                if not handle:
                    return previous if ctypes.get_last_error() == 5 else None
                try:
                    code = ctypes.c_ulong()
                    if kernel.GetExitCodeProcess(handle, ctypes.byref(code)) and code.value != 259:
                        return None
                finally:
                    kernel.CloseHandle(handle)
            else:
                try:
                    os.kill(pid, 0)
                except ProcessLookupError:
                    return None
                except PermissionError:
                    pass
            return previous
        except (OSError, ValueError, TypeError, AttributeError):
            return None

    def acquire_data_lock(self):
        foreign = self.read_foreign_lock()
        self._data_read_only = bool(foreign)
        self._read_only_reason = "lock"
        self._lock_token = {}
        if foreign:
            return foreign
        now = datetime.now().astimezone().isoformat(timespec="seconds")
        current = {"host": os.environ.get("COMPUTERNAME") or os.environ.get("HOSTNAME") or "unbekannt",
                   "pid": os.getpid(), "token": uuid.uuid4().hex, "started_at": now, "refreshed_at": now}
        try:
            self.write_json_atomic(LOCK_FILE, current)
            self._lock_token = current
        except OSError:
            self._data_read_only = True
        return None

    def show_data_lock_warning(self):
        info = getattr(self, "lock_info", None)
        if not info or not self.root.winfo_exists():
            return
        self.show_warning("Datenordner bereits geöffnet",
                          f"Der Datenordner ist seit {info.get('started_at', 'unbekannt')} auf "
                          f"{info.get('host', 'anderer Rechner')} geöffnet.\n\n"
                          "Dieser Start speichert keine Änderungen. Schließe Glide auf dem anderen "
                          "Rechner, warte auf den vollständigen Ordnerabgleich und starte Glide hier erneut.")

    def release_data_lock(self):
        token = getattr(self, "_lock_token", {})
        if not token:
            return
        try:
            with open(LOCK_FILE, "r", encoding="utf-8") as file:
                current = json.load(file)
            if current.get("token") == token.get("token"):
                os.remove(LOCK_FILE)
        except (OSError, ValueError, TypeError):
            pass
        self._lock_token = {}

    def refresh_data_lock(self):
        token = getattr(self, "_lock_token", {})
        if not token or getattr(self, "_data_read_only", False):
            return
        try:
            with open(LOCK_FILE, "r", encoding="utf-8") as file:
                existing = json.load(file)
            if existing.get("token") != token.get("token"):
                self._data_read_only = True
                self._read_only_reason = "lock"
                self.lock_info = existing
                return
            jetzt = datetime.now().astimezone().isoformat(timespec="seconds")
            if token.get("refreshed_at") == jetzt:
                # Die Prüfung oben ist erfolgt; der Inhalt wäre bytegleich.
                # Ein Speichervorgang rief das bis 08.10.2026 zweimal je
                # Sekunde mit Schreiben und fsync auf (P06r).
                return
            token = dict(token, refreshed_at=jetzt)
            self.write_json_atomic(LOCK_FILE, token)
            self._lock_token = token
        except (OSError, ValueError, TypeError):
            pass

    def data_folder_path(self):
        return BASE_DIR

    def change_data_folder(self, path, move_existing=False):
        """Öffnet vorhandene Daten oder kopiert in eine leere Ablage."""
        global BASE_DIR, SAVE_FILE, SETTINGS_FILE, BACKUP_DIR, ATTACHMENTS_DIR, TEMPLATES_FILE
        global LOCK_FILE, ERROR_LOG_FILE
        if not str(path or "").strip():
            raise ValueError("Bitte einen Datenordner auswählen.")
        target = os.path.realpath(os.path.abspath(os.path.expanduser(str(path))))
        source = os.path.realpath(BASE_DIR)
        if os.path.normcase(target) == os.path.normcase(source):
            return True
        if self.read_foreign_lock(os.path.join(target, "glide.lock")):
            raise ValueError("Der Zielordner ist auf einem anderen Arbeitsplatz geöffnet.")
        os.makedirs(target, exist_ok=True)
        if move_existing and os.listdir(target):
            raise ValueError("Zum Kopieren muss der Zielordner leer sein. Vorhandene Daten können stattdessen geöffnet werden.")
        if move_existing:
            try:
                nested = os.path.commonpath([source, target]) in (source, target)
            except ValueError:
                nested = False
            if nested:
                raise ValueError("Quell- und Zielordner dürfen nicht ineinander liegen.")
        target_data = os.path.join(target, "liste_speicher.json")
        if not move_existing and os.path.isfile(target_data):
            with open(target_data, "r", encoding="utf-8") as file:
                self.validate_backup_schema(json.load(file))
        if not self.save_items():
            raise OSError("Der aktuelle Bestand konnte nicht gespeichert werden.")
        self.save_settings()
        self.save_templates()
        if move_existing:
            for name in os.listdir(source):
                if name == "glide.lock":
                    continue
                src, dst = os.path.join(source, name), os.path.join(target, name)
                if os.path.isdir(src):
                    shutil.copytree(src, dst)
                else:
                    shutil.copy2(src, dst)
        if not os.environ.get("GLIDE_DATA_DIR"):
            self.write_json_atomic(DATA_POINTER_FILE, {"version": self.DATA_POINTER_VERSION, "path": target})
        self.release_data_lock()
        BASE_DIR = target
        SAVE_FILE = target_data
        SETTINGS_FILE = os.path.join(target, "settings.json")
        BACKUP_DIR = os.path.join(target, "backups")
        ATTACHMENTS_DIR = os.path.join(target, "attachments")
        TEMPLATES_FILE = os.path.join(target, "vorlagen.json")
        LOCK_FILE = os.path.join(target, "glide.lock")
        # Das Fehlerprotokoll liegt bei den Daten: Wer den Ordner wechselt,
        # nimmt es mit, statt zwei Protokolle an zwei Orten zu haben.
        ERROR_LOG_FILE = os.path.join(target, "fehlerprotokoll.txt")
        self._schema12_backup_checked = False
        self._schema13_backup_checked = False
        self._schema14_backup_checked = False
        self._last_backup_monotonic = None
        os.makedirs(BACKUP_DIR, exist_ok=True)
        os.makedirs(ATTACHMENTS_DIR, exist_ok=True)
        self.lock_info = self.acquire_data_lock()
        self.settings = self.load_settings()
        self.theme_name = self.design_info()["base"]
        self._ui_font_family = None
        self.apply_ui_font()
        self.templates = self.load_templates()
        self._templates_editing = False
        self.load_items()
        self.undo_stack.clear()
        self.update_sidebar_list()
        self.apply_theme()
        return True

    def show_data_folder_dialog(self):
        choice = filedialog.askdirectory(title="Datenordner auswählen", initialdir=BASE_DIR)
        if not choice or os.path.abspath(choice) == os.path.abspath(BASE_DIR):
            return
        try:
            populated = bool(os.listdir(choice))
            question = ("Vorhandene Daten aus diesem Ordner öffnen? Der bisherige Bestand bleibt erhalten."
                        if populated else "Den aktuellen Bestand in diesen leeren Ordner kopieren?")
            if self.ask_yes_no("Datenordner wechseln", question):
                self.change_data_folder(choice, move_existing=not populated)
                self.show_info("Datenordner geändert", f"Glide arbeitet jetzt in:\n{BASE_DIR}")
        except (OSError, ValueError) as exc:
            self.show_error("Datenordner wechseln", str(exc))

    def use_default_data_folder(self):
        if os.environ.get("GLIDE_DATA_DIR"):
            self.show_info("Datenordner", "GLIDE_DATA_DIR ist für diesen Start gesetzt und hat Vorrang.")
            return
        target = _default_app_data_dir()
        if os.path.abspath(target) == os.path.abspath(BASE_DIR):
            self.show_info("Datenordner", f"Der Standardordner ist bereits aktiv:\n{target}")
            return
        if not self.ask_yes_no("Standardordner benutzen",
                              "Den Standardordner öffnen? Vorhandene Daten dort bleiben erhalten. "
                              "Ist er leer, wird der aktuelle Bestand dorthin kopiert."):
            return
        try:
            populated = os.path.isdir(target) and bool(os.listdir(target))
            self.change_data_folder(target, move_existing=not populated)
            if os.path.isfile(DATA_POINTER_FILE):
                os.remove(DATA_POINTER_FILE)
            self.show_info("Datenordner geändert", "Der Standardordner ist wieder aktiv.")
        except (OSError, ValueError) as exc:
            self.show_error("Datenordner", str(exc))

    def load_settings(self):
        # Bestandsnutzer erkennen (N07): Gab es schon Einstellungen, ist dies kein Erststart.
        self._settings_existed = os.path.exists(SETTINGS_FILE)
        try:
            if os.path.exists(SETTINGS_FILE):
                with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
                    data = json.load(file)
                if isinstance(data, dict):
                    return self.normalize_personal_settings(data)
        except Exception:
            pass
        return self.normalize_personal_settings({})

    @staticmethod
    def settings_json_text(payload):
        """Kodierung aller JSON-Dateien von Glide (Nutzdaten, Einstellungen)."""
        return json.dumps(payload, ensure_ascii=False, indent=4)

    @staticmethod
    def file_signature(path):
        """Größe, Änderungszeit und Inode einer Datei; None, wenn sie fehlt."""
        try:
            stand = os.stat(path)
        except OSError:
            return None
        return (stand.st_size, stand.st_mtime_ns, stand.st_ino)

    @contextlib.contextmanager
    def settings_write_batch(self):
        """Fasst die Buchhaltungsschreibvorgänge einer Aktion zu einem zusammen.

        Tageszahl, „zuletzt bearbeitet“, Aktivität und Seitenleistenzuordnung
        schrieben `settings.json` bis 08.10.2026 je Aktion zwei- bis viermal
        (P06r, Zählung `scripts/pflege/zaehlung_aktualisierungen.py`). Innerhalb
        eines Rahmens merken sich Aufrufe mit `defer=True` nur den Bedarf; das
        Ende des äußersten Rahmens schreibt genau einmal – auch, wenn die
        Aktion mit einem Fehler abbricht.
        """
        self._settings_defer_depth = getattr(self, "_settings_defer_depth", 0) + 1
        try:
            yield
        finally:
            self._settings_defer_depth -= 1
            if not self._settings_defer_depth and getattr(self, "_settings_defer_pending", False):
                self._settings_defer_pending = False
                self.save_settings()

    def save_settings(self, *, show_error=False, defer=False):
        if getattr(self, "_data_read_only", False):
            return False
        if defer and getattr(self, "_settings_defer_depth", 0):
            self._settings_defer_pending = True
            return True
        # Atomar wie die Nutzdaten: ein Absturz während des Schreibens darf die
        # bestehenden Einstellungen nicht als Rumpfdatei zurücklassen.
        try:
            payload = self.normalize_personal_settings(getattr(self, "settings", {}))
            payload.update({
                    "design": self.design_name(),
                    "theme": self.theme_name,
                    "title": self.app_title,
                    "hide_done": bool(self.hide_done_var.get()) if hasattr(self, "hide_done_var") else False,
                    "filter_mode": self.get_filter_mode() if hasattr(self, "hide_done_var") else "all",
                    "active_list_id": self.active_list_id,
                    "active_folder_id": self.active_folder_id if self.view_mode == "folder" else None,
                    "view_mode": self.view_mode,
                })
            migration_backup = os.path.join(BASE_DIR, "settings.before-v1.json")
            if os.path.isfile(SETTINGS_FILE) and not os.path.exists(migration_backup):
                with open(SETTINGS_FILE, "rb") as existing_file:
                    existing_bytes = existing_file.read()
                try:
                    existing = json.loads(existing_bytes)
                except (ValueError, UnicodeError):
                    existing = None
                if not isinstance(existing, dict) or existing.get("settings_version") != self.SETTINGS_VERSION:
                    fd, migration_temp = tempfile.mkstemp(prefix=".glide-settings-", dir=BASE_DIR)
                    try:
                        with os.fdopen(fd, "wb") as backup_file:
                            backup_file.write(existing_bytes)
                            backup_file.flush()
                            os.fsync(backup_file.fileno())
                        os.replace(migration_temp, migration_backup)
                    finally:
                        if os.path.exists(migration_temp):
                            os.remove(migration_temp)
            inhalt = self.settings_json_text(payload)
            # Gleicher Inhalt und unveränderte Datei: nichts zu schreiben. Die
            # Dateisignatur stellt sicher, dass eine inzwischen gelöschte oder
            # fremd geänderte Datei trotzdem neu geschrieben wird.
            geschrieben = getattr(self, "_settings_written", None)
            if geschrieben is not None and geschrieben == (inhalt, self.file_signature(SETTINGS_FILE)):
                self.settings = payload
                return True
            self._settings_written = None
            # Der Schreiber kodiert erneut: Prüfungen ersetzen ihn mit der
            # ursprünglichen Signatur (Pfad, Daten).
            self.write_json_atomic(SETTINGS_FILE, payload)
            self._settings_written = (inhalt, self.file_signature(SETTINGS_FILE))
            self.settings = payload
            return True
        except Exception as exc:
            self._settings_written = None
            if show_error:
                self.show_error("Einstellungen nicht gespeichert", str(exc))
            return False

    @classmethod
    def normalize_personal_settings(cls, data):
        """Additive Einstellungsmigration; das Aufgabendatenformat bleibt unverändert."""
        result = dict(data) if isinstance(data, dict) else {}
        result["settings_version"] = cls.SETTINGS_VERSION
        name = result.get("profile_name", "")
        result["profile_name"] = " ".join(name.split())[:60] if isinstance(name, str) else ""
        logo = result.get("profile_logo", "G")
        # Ein Monogramm bleibt auch bei anderer Systemschrift ein Textlogo.
        result["profile_logo"] = "".join(
            char for char in logo if char.isalnum()
        )[:3] if isinstance(logo, str) else "G"
        result["profile_logo"] = result["profile_logo"] or "G"
        # Das Monogramm trägt eine Farbe aus derselben Palette wie Listen,
        # Aufgaben und Labels – ein Themeschlüssel, damit es in Hell und Dunkel
        # stimmt. Ein unbekannter Wert fällt auf die Akzentfarbe zurück.
        logo_color = result.get("profile_logo_color", "accent")
        result["profile_logo_color"] = (
            logo_color if logo_color in cls.LIST_COLOR_KEYS else "accent"
        )
        for key, default in (("start_on_home", False), ("show_home_stats", True)):
            value = result.get(key, default)
            result[key] = value if isinstance(value, bool) else default
        # Der Name des Begleiters.
        mascot = result.get("mascot_name", "")
        result["mascot_name"] = " ".join(str(mascot).split())[:24] if isinstance(mascot, str) else ""
        care = result.get("mascot_care") if isinstance(result.get("mascot_care"), dict) else {}
        normalized_care = {}
        for key, default in (("satiety", 70), ("energy", 70), ("affection", 60)):
            value = care.get(key, default)
            normalized_care[key] = max(0, min(100, int(value))) if isinstance(value, (int, float)) else default
        last_day = cls.normalize_due(care.get("day")) or date.today().isoformat()
        try:
            days = max(0, min(30, (date.today() - date.fromisoformat(last_day)).days))
        except ValueError:
            days = 0
        if days:
            normalized_care["satiety"] = max(0, normalized_care["satiety"] - 8 * days)
            normalized_care["energy"] = max(0, normalized_care["energy"] - 5 * days)
            normalized_care["affection"] = max(0, normalized_care["affection"] - 3 * days)
        normalized_care["day"] = date.today().isoformat()
        result["mascot_care"] = normalized_care
        # Wie viel Rückmeldung eine Aktion auslöst.
        stufe = result.get("action_feedback", cls.ACTION_FEEDBACK_DEFAULT)
        result["action_feedback"] = stufe if stufe in cls.ACTION_FEEDBACK_KEYS else cls.ACTION_FEEDBACK_DEFAULT
        # Welche Abschnitte der Übersichten zugeklappt sind.
        # Nur bekannte Kennungen, damit eine alte Datei keine Zeilen verbirgt,
        # die es gar nicht mehr gibt.
        zu = result.get("overview_sections_closed", [])
        result["overview_sections_closed"] = [
            kennung for kennung in dict.fromkeys(zu if isinstance(zu, list) else [])
            if kennung in cls.OVERVIEW_SECTION_ROW_IDS
        ]
        zu = result.get("label_sections_closed")
        result["label_sections_closed"] = list(dict.fromkeys(
            value for value in (zu if isinstance(zu, list) else [])
            if isinstance(value, str) and value.startswith(cls.LABEL_GROUP_ROW_PREFIX)
            and len(value) <= 260))[-1000:]
        # Reihenfolge, Sichtbarkeit und Spaltenzahl der
        # Startseitenkacheln. Alles additiv – fehlende Werte ergeben die
        # Standardstartseite.
        # Wer „Heute fällig“ ausgeblendet hatte, hatte die
        # Fälligkeiten abgewählt, nicht die Tagesplanung. Die verschmolzene
        # Kachel bleibt deshalb sichtbar; der veraltete Schlüssel fällt hier
        # heraus, weil er unter den bekannten Kacheln nicht mehr steht.
        # Ohne eigene Reihenfolge gilt der Standard (D12); eine eigene
        # Auswahl bleibt nach dem Versionswechsel unverändert.
        result["home_tile_order"], result["home_tiles_hidden"] = glide_home.normalize(
            result.get("home_tile_order"), result.get("home_tiles_hidden"), result["show_home_stats"])
        columns = str(result.get("home_columns", "auto"))
        result["home_columns"] = columns if columns in dict(cls.HOME_COLUMN_CHOICES) else "auto"
        # Beide additiv; fehlende Werte bedeuten „Monat"
        # und „Ausführlich" und damit die Startseite, die es vor 3.24 gab.
        kalender_modus = str(result.get("home_calendar_mode", cls.HOME_CALENDAR_DEFAULT))
        result["home_calendar_mode"] = kalender_modus if kalender_modus in dict(
            cls.HOME_CALENDAR_CHOICES) else cls.HOME_CALENDAR_DEFAULT
        dichte_wert = str(result.get("home_density", cls.HOME_DENSITY_DEFAULT))
        result["home_density"] = dichte_wert if dichte_wert in dict(
            cls.HOME_DENSITY_CHOICES) else cls.HOME_DENSITY_DEFAULT
        # Der Informationsumfang der Listenansicht. Additiv
        # wie `sidebar_visible`; ein fehlender oder unbekannter Wert bedeutet
        # „Standard" und damit genau die Ansicht, die es vor 3.23 gab.
        # Bewegte Rückmeldungen sind additiv und
        # standardmäßig an. Ein fehlender Wert bedeutet „ein"; wer sie im
        # Dopamin-Design kannte, verliert nichts, alle übrigen Designs
        # bekommen sie neu.
        animationen = result.get("animations_enabled", True)
        result["animations_enabled"] = animationen if isinstance(animationen, bool) else True
        detail = result.get("list_detail_mode", cls.LIST_DETAIL_DEFAULT)
        erlaubt = {schluessel for schluessel, _name, _note in cls.LIST_DETAIL_MODES}
        result["list_detail_mode"] = detail if detail in erlaubt else cls.LIST_DETAIL_DEFAULT
        startup_view = result.get("startup_view", "home" if result.get("start_on_home") else "last")
        result["startup_view"] = startup_view if startup_view in cls.STARTUP_VIEW_KEYS else "last"
        # Die feste Liste steht als eigener Wert daneben: So bleibt die Wahl
        # erhalten, auch wenn zwischendurch eine andere Startansicht gilt.
        feste_liste = result.get("startup_list_id")
        result["startup_list_id"] = feste_liste if isinstance(feste_liste, str) and 0 < len(feste_liste) <= 200 else ""
        # history_enabled ist additiv: Das Einstellungsformat bleibt 2, ein
        # fehlender Wert bedeutet „protokollieren".
        for key, default in (("sidebar_visible", True), ("sidebar_narrow", False),
                             ("show_moon_phase", True), ("show_yearly_stats", True),
                             ("show_seconds", True), ("reminder_attention", True), ("history_enabled", True), ("mascot_playful", True),
                             # Seit 27.09.2026: echte Systembenachrichtigung über Tk 9
                             # (`tk sysnotify`). Aus, bis man sie einschaltet.
                             ("system_notifications", False)):
            value = result.get(key, default)
            result[key] = value if isinstance(value, bool) else default
        week_start = result.get("week_start", "monday")
        result["week_start"] = week_start if week_start in ("monday", "sunday") else "monday"
        font_size = result.get("ui_font_size", "mittel")
        result["ui_font_size"] = font_size if font_size in cls.UI_FONT_SIZE_CHOICES else "mittel"
        family = result.get("ui_font_family", "")
        result["ui_font_family"] = str(family).strip()[:120] if isinstance(family, str) else ""
        accent = result.get("accent_color", "accent")
        result["accent_color"] = accent if accent in dict((key, label) for label, key in cls.ACCENT_COLOR_CHOICES) else "accent"
        # Aus den drei bisherigen Werten wird ein Design.
        # Die Übernahme läuft genau einmal und verliert nichts: Wer im
        # Dunkelmodus mit Dopamin arbeitete, findet „Dopamin“ wieder; wer den
        # Dunkelmodus mit Materialoptik hatte – die Vorgabe seit 3.7 –,
        # bekommt „Liquid Glass · dunkel“ und damit genau das Bild von vorher.
        design = result.get("design")
        if design not in cls.DESIGNS:
            theme = result.get("theme", "light")
            theme = theme if theme in ("light", "dark") else "light"
            alter_modus = result.get("color_mode", "standard")
            altes_glas = result.get("glass_mode", True)
            altes_glas = altes_glas if isinstance(altes_glas, bool) else True
            if alter_modus == "dopamine":
                design = "dopamine"
            elif alter_modus == "contrast":
                design = "contrast_dark" if theme == "dark" else "contrast_light"
            elif altes_glas:
                design = "glass_dark" if theme == "dark" else "glass_light"
            else:
                design = theme
        result["design"] = design
        # Die drei abgeleiteten Werte bleiben geschrieben: Eine ältere Fassung,
        # die dieselbe Datei öffnet, liest weiterhin ihr gewohntes Feld statt
        # auf die eigene Vorgabe zurückzufallen.
        info = cls.DESIGNS[design]
        result["theme"] = info["base"]
        result["color_mode"] = info["layer"] or "standard"
        result["glass_mode"] = bool(info["glass"])
        # Tagesziel: 0 heißt „keine Herausforderung", nicht „Ziel sofort erreicht".
        goal = result.get("daily_goal", cls.DAILY_GOAL_DEFAULT)
        if isinstance(goal, bool) or not isinstance(goal, int):
            goal = cls.DAILY_GOAL_DEFAULT
        result["daily_goal"] = max(0, min(cls.DAILY_GOAL_MAX, goal))
        # Tageskapazität: 0 heißt „kein Vergleich", nicht „keine Zeit". Ein
        # beschädigter oder fremder Wert führt auf 0 zurück, damit nie eine
        # erfundene Kapazität in der Anzeige steht.
        capacity = result.get("daily_capacity_minutes", cls.DAILY_CAPACITY_DEFAULT)
        if isinstance(capacity, bool) or not isinstance(capacity, int):
            capacity = cls.DAILY_CAPACITY_DEFAULT
        result["daily_capacity_minutes"] = max(0, min(cls.DAILY_CAPACITY_MAX, capacity))
        # Mein Tag: eine bewusst zusammengestellte Auswahl für den aktuellen
        # Kalendertag. Die Auswahl gehört zu den gerätespezifischen
        # Einstellungen und bleibt deshalb außerhalb eines Aufgabenbackups.
        # `today_plan` wird beim ersten Start von 3.22 in
        # Bearbeitungstage überführt und danach nicht mehr geschrieben. Das
        # Feld bleibt bis dahin gültig, damit die Übernahme etwas vorfindet.
        migriert = result.get("today_plan_migrated")
        result["today_plan_migrated"] = migriert if isinstance(migriert, bool) else False
        if result["today_plan_migrated"]:
            result.pop("today_plan", None)
        else:
            plan = result.get("today_plan")
            plan_date = plan.get("date") if isinstance(plan, dict) else None
            plan_ids = plan.get("item_ids", []) if isinstance(plan, dict) else []
            if plan_date != date.today().isoformat():
                plan_date = date.today().isoformat()
                plan_ids = []
            if not isinstance(plan_ids, list):
                plan_ids = []
            cleaned_plan_ids = []
            for item_id in plan_ids:
                if isinstance(item_id, str) and item_id and item_id not in cleaned_plan_ids:
                    cleaned_plan_ids.append(item_id)
                if len(cleaned_plan_ids) >= 500:
                    break
            result["today_plan"] = {"date": plan_date, "item_ids": cleaned_plan_ids}
        # Tabellenansicht: sichtbare Spalten gehören zur jeweiligen Liste und
        # liegen deshalb in den persönlichen Einstellungen. Die Aufgaben- und
        # Backup-Daten bleiben unverändert. „title“ ist immer vorhanden, alle
        # anderen Spalten dürfen je Liste frei gewählt werden.
        raw_table_columns = result.get("table_columns", {})
        cleaned_table_columns = {}
        if isinstance(raw_table_columns, dict):
            for list_id, columns in raw_table_columns.items():
                if not isinstance(list_id, str) or not list_id or not isinstance(columns, list):
                    continue
                valid = []
                for column in columns:
                    if column in cls.TABLE_COLUMN_KEYS and column not in valid:
                        valid.append(column)
                if "title" not in valid:
                    valid.insert(0, "title")
                cleaned_table_columns[list_id] = valid
                if len(cleaned_table_columns) >= 200:
                    break
        result["table_columns"] = cleaned_table_columns
        # Selbst gezogene Spaltenbreiten je Liste. Sie sind
        # reine Darstellung und gehören deshalb neben die Spaltenauswahl in die
        # persönlichen Einstellungen, nicht in die Aufgabendaten.
        raw_widths = result.get("table_column_widths", {})
        cleaned_widths = {}
        if isinstance(raw_widths, dict):
            for list_id, widths in raw_widths.items():
                if not isinstance(list_id, str) or not list_id or not isinstance(widths, dict):
                    continue
                valid = {}
                for column, width in widths.items():
                    if column not in cls.TABLE_COLUMN_KEYS:
                        continue
                    if isinstance(width, bool) or not isinstance(width, int):
                        continue
                    valid[column] = max(cls.TABLE_COLUMN_MIN_WIDTH,
                                        min(cls.TABLE_COLUMN_MAX_WIDTH, width))
                if valid:
                    cleaned_widths[list_id] = valid
                if len(cleaned_widths) >= 200:
                    break
        result["table_column_widths"] = cleaned_widths
        # Sortierung je Liste. Ohne Eintrag gilt die
        # Reihenfolge der Liste selbst; ein beschädigter Wert führt dorthin
        # zurück, damit nie nach einer Spalte sortiert wird, die es nicht gibt.
        raw_sort = result.get("table_sort", {})
        cleaned_sort = {}
        if isinstance(raw_sort, dict):
            for list_id, rule in raw_sort.items():
                if not isinstance(list_id, str) or not list_id or not isinstance(rule, dict):
                    continue
                column = rule.get("column")
                if column not in cls.TABLE_COLUMN_KEYS:
                    continue
                cleaned_sort[list_id] = {
                    "column": column,
                    "direction": "desc" if rule.get("direction") == "desc" else "asc",
                }
                if len(cleaned_sort) >= 200:
                    break
        result["table_sort"] = cleaned_sort
        # Erledigungshistorie: {"JJJJ-MM-TT": Anzahl}. Ältere Tage als
        # COMPLETION_HISTORY_DAYS fallen beim Normalisieren heraus, damit die
        # Datei nicht unbegrenzt wächst.
        for history_key in ("completion_history", "activity_history"):
            cleaned = {}
            history = result.get(history_key)
            if isinstance(history, dict):
                limit = date.today() - timedelta(days=cls.COMPLETION_HISTORY_DAYS)
                for day, count in history.items():
                    try:
                        valid_day = date.fromisoformat(day)
                    except (ValueError, TypeError):
                        continue
                    if limit <= valid_day <= date.today() and isinstance(count, int) and not isinstance(count, bool) and count > 0:
                        cleaned[day] = min(count, 10 ** 6)
            result[history_key] = dict(sorted(cleaned.items()))
        recent = []
        seen = set()
        for value in result.get("recent_lists", []) if isinstance(result.get("recent_lists"), list) else []:
            if not isinstance(value, dict):
                continue
            list_id, edited = value.get("id"), value.get("edited_at")
            if not isinstance(list_id, str) or not list_id or list_id in seen or not isinstance(edited, str):
                continue
            try:
                datetime.fromisoformat(edited)
            except ValueError:
                continue
            recent.append({"id": list_id, "edited_at": edited})
            seen.add(list_id)
            if len(recent) >= cls.MAX_RECENT_LISTS:
                break
        result["recent_lists"] = recent
        result = cls.normalize_settings_330(result)
        return SavedFilters.normalize_settings(ItemWorkspace.normalize_settings(result))

    # --- Einstellungen seit 3.30 -------------------------------------------
    DRAWING_OPACITY_DEFAULT = 33
    MAX_DRAWING_PALETTES = 24

    @classmethod
    def normalize_drawing_tools(cls, raw):
        """Programmweite Zeichenwerkzeuge: Farben, Paletten, Vorschau.

        Reiner Ansichts- und Werkzeugzustand. Zeichnungen behalten ihre
        konkreten Farben; eine Palette färbt nie um.
        """
        raw = raw if isinstance(raw, dict) else {}

        def color(value, default=None):
            try:
                return glide_drawing.normalize_color(value)
            except glide_drawing.DrawingFormatError:
                return default

        recent = []
        for value in raw.get("recent_colors") if isinstance(raw.get("recent_colors"), list) else []:
            value = color(value)
            if value and value not in recent:
                recent.append(value)
            if len(recent) >= DrawingEditor.RECENT_LIMIT:
                break
        palettes = []
        seen = set()
        for entry in raw.get("palettes") if isinstance(raw.get("palettes"), list) else []:
            if not isinstance(entry, dict):
                continue
            palette_id = entry.get("id")
            if (not isinstance(palette_id, str) or not re.fullmatch(r"user-[0-9a-f]{8,32}", palette_id)
                    or palette_id in seen):
                continue
            colors = []
            for value in entry.get("colors") if isinstance(entry.get("colors"), list) else []:
                value = color(value)
                if value and value not in colors:
                    colors.append(value)
            if not colors:
                continue
            name = " ".join(str(entry.get("name") or "Palette").split())[:60] or "Palette"
            palettes.append({"id": palette_id, "name": name, "colors": colors[:glide_drawing.MAX_COLORS]})
            seen.add(palette_id)
            if len(palettes) >= cls.MAX_DRAWING_PALETTES:
                break
        chosen = raw.get("palette")
        if chosen not in ("drawing", glide_drawing.GLIDE_PALETTE_ID) and chosen not in seen:
            chosen = "drawing"
        opacity = raw.get("reference_opacity", cls.DRAWING_OPACITY_DEFAULT)
        if isinstance(opacity, bool) or not isinstance(opacity, int):
            opacity = cls.DRAWING_OPACITY_DEFAULT
        return {
            "secondary_color": color(raw.get("secondary_color"), glide_drawing.BACKGROUND),
            "recent_colors": recent,
            "pixel_perfect": raw.get("pixel_perfect") is True,
            "preview": raw.get("preview") is True,
            "reference_opacity": max(10, min(90, opacity)),
            "palette": chosen,
            "palettes": palettes,
        }

    @classmethod
    def normalize_settings_330(cls, result):
        """Alle Einstellungen, die 3.30 ergänzt. Fehlende Werte ergeben 3.29."""
        result["view_hints"] = glide_interaction.normalize_hints(result.get("view_hints"))
        result["drawing_tools"] = cls.normalize_drawing_tools(result.get("drawing_tools"))
        pinned = []
        for value in result.get("pinned_pages") if isinstance(result.get("pinned_pages"), list) else []:
            if (isinstance(value, dict) and value.get("kind") in ("list", "folder")
                    and isinstance(value.get("id"), str) and value.get("id")
                    and not any(entry["kind"] == value["kind"] and entry["id"] == value["id"] for entry in pinned)):
                pinned.append({"kind": value["kind"], "id": value["id"][:64]})
            if len(pinned) >= cls.MAX_PINNED_PAGES:
                break
        result["pinned_pages"] = pinned
        result["sidebar_sections_visible"] = glide_sidebar.normalize_visibility(result.get("sidebar_sections_visible"))
        result["sidebar_locations"] = glide_sidebar.normalize_locations(result.get("sidebar_locations"))
        zu = result.get("sidebar_sections_closed")
        result["sidebar_sections_closed"] = list(dict.fromkeys(
            value for value in (zu if isinstance(zu, list) else []) if value in cls.SIDEBAR_SECTIONS))
        # Eingebetteter Detailbereich (MO-030): aus, bis ihn jemand einschaltet.
        result["detail_pane"] = result.get("detail_pane") is True
        breite = result.get("detail_pane_width")
        result["detail_pane_width"] = (max(280, min(640, breite)) if isinstance(breite, int)
                                       and not isinstance(breite, bool) else 360)
        # Hintergrundverlauf je Design (26.09.2026): nur bekannte Entwürfe.
        verlaeufe = result.get("backdrops")
        result["backdrops"] = {
            design: wert for design, wert in (verlaeufe.items() if isinstance(verlaeufe, dict) else [])
            if isinstance(design, str) and isinstance(wert, str) and glide_backdrop.find_preset(design, wert)
        }
        # Seiten (26.09.2026): Favoriten, zuletzt geöffnete, Lesebreite.
        for schluessel, grenze in (("page_favorites", 200), ("page_recent", cls.PAGE_RECENT_LIMIT)):
            werte = result.get(schluessel)
            result[schluessel] = list(dict.fromkeys(
                wert for wert in (werte if isinstance(werte, list) else []) if isinstance(wert, str) and wert))[:grenze]
        result["page_full_width"] = result.get("page_full_width") is True
        # Galerie (27.09.2026): Kachelgröße je Galerie.
        groessen = result.get("gallery_tile_size")
        result["gallery_tile_size"] = {
            schluessel: wert for schluessel, wert in (groessen.items() if isinstance(groessen, dict) else [])
            if isinstance(schluessel, str) and wert in ("small", "medium", "large")}
        # Gruppieren und Verschachteln je Liste (AO-040, AO-030).
        gruppen = result.get("list_group_by")
        result["list_group_by"] = dict(list(
            (key, value) for key, value in (gruppen.items() if isinstance(gruppen, dict) else [])
            if isinstance(key, str) and 0 < len(key) <= 120 and value in dict(cls.LIST_GROUP_FIELDS)
        )[:cls.MAX_GROUP_SETTINGS])
        verschachtelt = result.get("table_nesting")
        result["table_nesting"] = dict(list(
            (key, "nested") for key, value in (verschachtelt.items() if isinstance(verschachtelt, dict) else [])
            if isinstance(key, str) and 0 < len(key) <= 120 and value == "nested"
        )[:cls.MAX_GROUP_SETTINGS])
        zu = result.get("group_sections_closed")
        result["group_sections_closed"] = list(dict.fromkeys(
            value for value in (zu if isinstance(zu, list) else [])
            if isinstance(value, str) and value.startswith(cls.GROUP_SECTION_PREFIX) and len(value) <= 260))[-1000:]
        known_filters = {value.get("id") for value in result.get("saved_filters", []) if isinstance(value, dict)}
        filters = result.get("home_filter_tiles")
        result["home_filter_tiles"] = list(dict.fromkeys(
            value for value in (filters if isinstance(filters, list) else [])
            if isinstance(value, str) and value in known_filters))[:cls.MAX_HOME_FILTER_TILES]
        spans = result.get("home_tile_span")
        result["home_tile_span"] = {key: "wide" for key, value in (spans.items() if isinstance(spans, dict) else [])
                                    if key in cls.HOME_TILE_KEYS and value == "wide"}
        # Eine bestehende Startseite soll nach dem Update gleich aussehen: Die
        # neuen Kacheln aus 3.30 bleiben aus, bis jemand sie einblendet.
        if result.get("home_tiles_330") is not True:
            if isinstance(result.get("home_tile_order"), list) and result["home_tile_order"]:
                hidden = list(result.get("home_tiles_hidden") or [])
                for key in cls.HOME_TILES_330:
                    if key not in hidden and key not in result["home_tile_order"]:
                        hidden.append(key)
                result["home_tiles_hidden"] = hidden
            result["home_tiles_330"] = True
        profile = result.get("daily_capacity_by_weekday")
        result["daily_capacity_by_weekday"] = [
            (max(0, min(cls.DAILY_CAPACITY_MAX, value)) if isinstance(value, int) and not isinstance(value, bool)
             else None)
            for value in (profile if isinstance(profile, list) and len(profile) == 7 else [None] * 7)]
        recent_pages = []
        for value in result.get("recent_pages") if isinstance(result.get("recent_pages"), list) else []:
            if (isinstance(value, dict) and value.get("kind") in ("list", "folder")
                    and isinstance(value.get("id"), str) and value.get("id")
                    and not any(entry["id"] == value["id"] for entry in recent_pages)):
                recent_pages.append({"kind": value["kind"], "id": value["id"][:64],
                                     "opened_at": str(value.get("opened_at") or "")[:40]})
            if len(recent_pages) >= cls.MAX_RECENT_PAGES:
                break
        result["recent_pages"] = recent_pages
        card_size = result.get("library_card_size", "medium")
        result["library_card_size"] = card_size if card_size in ("small", "medium", "large") else "medium"
        # Eine Erfassung; Fokuspausen und vorbereitete Buchungen überleben Neustart.
        result["time_tracking"] = glide_focus.normalize(result.get("time_tracking"))
        result["time_booking"] = glide_focus.normalize_booking(result.get("time_booking"))
        # Komfort 3.33.20 (KO06, AU06, N07): lokale Anzeigewerte, additiv.
        for schluessel in ("recent_labels", "recent_move_targets"):
            result[schluessel] = glide_interaction.remember_recent(result.get(schluessel), None)
        result["today_routines"] = glide_routines.normalize_selection(result.get("today_routines"))
        result["routine_done_days"] = glide_routines.normalize_done_days(result.get("routine_done_days"))
        # N01 (3.33.21): gemerktes Designpaar oder aus.
        paar = glide_appearance.normalize_auto(result.get("design_auto"), cls.DESIGNS)
        if paar is None:
            result.pop("design_auto", None)
        else:
            result["design_auto"] = paar
        gesehen = glide_release.normalize_seen(result.get("release_notes_seen"))
        if gesehen is None:
            result.pop("release_notes_seen", None)
        else:
            result["release_notes_seen"] = gesehen
        return result

    def list_edit_signatures(self):
        """Vergleicht Inhalte nur im Arbeitsspeicher, ohne die Listen zu erweitern."""
        return self.list_comparison().list_signatures

    def record_recent_list_edits(self, record=True, comparison=None):
        """Erfasst tatsächliche, erfolgreich gespeicherte Änderungen, keine Aufrufe."""
        comparison = comparison if comparison is not None else self.list_comparison()
        current = comparison.list_signatures
        item_signatures = comparison.item_signatures
        previous_items = getattr(self, "_activity_item_signatures", None)
        self._activity_item_signatures = item_signatures
        if record and previous_items is not None:
            events = sum(previous_items.get(key) != value for key, value in item_signatures.items())
            events += len(set(previous_items) - set(item_signatures))
            if events:
                history = self.settings.setdefault("activity_history", {})
                day = date.today().isoformat()
                history[day] = history.get(day, 0) + events
                self.save_settings(defer=True)
        previous = getattr(self, "_list_edit_signatures", None)
        self._list_edit_signatures = current
        if previous is None or not record:
            return
        changed = [list_id for list_id, signature in current.items() if previous.get(list_id) != signature]
        recent = [entry for entry in self.settings.get("recent_lists", [])
                  if entry["id"] in current and entry["id"] not in changed]
        timestamp = datetime.now().isoformat(timespec="seconds")
        recent = ([{"id": list_id, "edited_at": timestamp} for list_id in changed] + recent)[:self.MAX_RECENT_LISTS]
        if recent != self.settings.get("recent_lists", []):
            self.settings["recent_lists"] = recent
            self.save_settings(defer=True)

    def done_item_ids(self, item_ids):
        """IDs aus `item_ids`, die gerade als erledigt gelten."""
        result = set()
        for item_id in item_ids or ():
            found = self.find_item_in_lists(item_id)
            if found and found[0].get("done"):
                result.add(item_id)
        return result

    def record_completions(self, done_before, item_ids):
        """Bucht neu abgehakte Punkte auf den heutigen Tag.

        Gezählt wird ausschließlich der Übergang offen → erledigt. Ein Punkt,
        der wieder geöffnet wird, zieht nichts ab: Die Zahl beantwortet
        „wie viel habe ich an diesem Tag geschafft", nicht „wie viele Punkte
        stehen jetzt auf erledigt".

        Die Historie beginnt mit dieser Version und liegt in `settings.json` –
        gerätespezifisch und nicht Bestandteil eines Aufgabenbackups. Import,
        Rückgängig und das Wiederherstellen aus dem Papierkorb laufen nicht
        über diesen Weg und verändern die Tageszahl deshalb nicht.
        """
        neu = 0
        for item_id in item_ids or ():
            if item_id in done_before:
                continue
            found = self.find_item_in_lists(item_id)
            if found and found[0].get("done") and self.is_schedulable_item(found[0]):
                neu += 1
        self.book_completions(neu)

    def book_completions(self, anzahl):
        """Schreibt erledigte Punkte auf den heutigen Tag.

        Eigene Methode, weil sie zwei Aufrufer hat: die Zählung in
        `item_change` und das Vorrücken einer Wiederholung. Ein vorgerückter
        Punkt steht am Ende wieder auf offen und würde von der Zählung sonst
        übersehen – geschafft hat man ihn trotzdem.
        """
        if not anzahl:
            return
        heute = date.today().isoformat()
        history = dict(self.settings.get("completion_history", {}))
        vorher = history.get(heute, 0)
        history[heute] = vorher + anzahl
        self.settings["completion_history"] = history
        self.save_settings(defer=True)
        if self.animations_enabled():
            ziel = self.daily_goal()
            if ziel and vorher < ziel <= history[heute]:
                self.play_celebration(f"{self.ICONS['check']}  Tagesziel erreicht!")
            else:
                text = f"{self.ICONS['check']}  " + ("Erledigt!" if anzahl == 1
                                                     else f"{anzahl} erledigt!")
                kombo = self.register_completion_combo(anzahl)
                if kombo > 1:
                    text += f"   \u00d7{kombo} Kombo"
                self.play_celebration(text)

    # Wer im Dopamin-Design mehrere Aufgaben hintereinander
    # abhakt, bekommt einen mitlaufenden Zähler – die Kombo. Sie zählt keine
    # Daten und wird nirgends gespeichert; sie lebt ausschließlich in der
    # laufenden Sitzung und läuft nach dieser Pause wieder auf null.
    COMBO_WINDOW_SECONDS = 8

    def register_completion_combo(self, anzahl):
        """Erhöht die laufende Kombo und gibt ihren Stand zurück."""
        if not self.arcade_mode():
            return 0
        jetzt = time.monotonic()
        letzte = getattr(self, "_combo_time", None)
        stand = getattr(self, "_combo_count", 0) if letzte is not None and (
            jetzt - letzte) <= self.COMBO_WINDOW_SECONDS else 0
        self._combo_count = stand + max(1, int(anzahl))
        self._combo_time = jetzt
        return self._combo_count

    def completions_today(self):
        return int(self.settings.get("completion_history", {}).get(date.today().isoformat(), 0))

    def completion_chart(self, today=None):
        """Die letzten Tage als (Datum, Anzahl) – ältester Tag zuerst."""
        today = today or date.today()
        history = self.settings.get("completion_history", {})
        tage = []
        for zurueck in range(self.COMPLETION_CHART_DAYS - 1, -1, -1):
            tag = today - timedelta(days=zurueck)
            tage.append((tag, int(history.get(tag.isoformat(), 0))))
        return tage

    def yearly_activity_history(self):
        """Bewahrt ältere Erledigungen neben den neueren Bearbeitungszahlen.

        Erledigungen sind zugleich Bearbeitungen. Deshalb gilt je Tag der
        größere Zähler; Addieren würde dieselbe Aktion doppelt zählen. Beide
        gespeicherten Historien bleiben unverändert und getrennt nutzbar.
        """
        history = dict(self.settings.get("completion_history", {}))
        for day, count in self.settings.get("activity_history", {}).items():
            history[day] = max(history.get(day, 0), count)
        return history

    def next_scheduled_item(self, today=None):
        """Der nächste anstehende Punkt mit Fälligkeit – für die Kopfzeile.

        „Anstehend" heißt: offen, ab heute, frühestes Datum zuerst und bei
        gleichem Tag die frühere Uhrzeit. Überfälliges bleibt außen vor; dafür
        gibt es die eigene Ansicht „Verspätet", und die Kopfzeile beantwortet
        die Frage nach dem Kommenden, nicht nach dem Liegengebliebenen.
        """
        today_iso = (today or date.today()).isoformat()
        bester = None
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if item.get("done") or not self.is_schedulable_item(item):
                    continue
                faellig = self.normalize_due(item.get("due"))
                if not faellig or faellig < today_iso:
                    continue
                schluessel = (faellig, self.normalize_due_time(item.get("due_time")) or "99:99")
                if bester is None or schluessel < bester[0]:
                    bester = (schluessel, item, entry)
        return (bester[1], bester[2]) if bester else (None, None)

    def daily_goal(self):
        goal = self.settings.get("daily_goal", self.DAILY_GOAL_DEFAULT)
        return goal if isinstance(goal, int) and not isinstance(goal, bool) else self.DAILY_GOAL_DEFAULT

    def daily_capacity_minutes(self, day=None):
        """Selbst gesetzte Tageskapazität; 0 bedeutet kein Kapazitätsvergleich."""
        return glide_planning.capacity_for(self.settings, day, self.DAILY_CAPACITY_DEFAULT,
                                           self.DAILY_CAPACITY_MAX)

    def time_blocks(self, entries):
        """Zeitblöcke eines Tages: Start, Ende (aus der Schätzung) und Überschneidung.

        `entries` sind (Liste, Punkt). Ohne Schätzung hat ein Block keinen
        festen Endpunkt und zählt für Überschneidungen als 30 Minuten.
        """
        bloecke = []
        for entry, item in entries:
            zeit = self.normalize_due_time(item.get("planned_time"))
            if not zeit:
                continue
            stunde, minute = (int(teil) for teil in zeit.split(":"))
            anfang = stunde * 60 + minute
            dauer = item.get("estimated_minutes")
            geschaetzt = isinstance(dauer, int) and not isinstance(dauer, bool) and dauer > 0
            ende = anfang + (dauer if geschaetzt else 30)
            bloecke.append({"entry": entry, "item": item, "start": zeit, "minutes": (anfang, ende),
                            "end": f"{min(ende, 24 * 60 - 1) // 60:02d}:{min(ende, 24 * 60 - 1) % 60:02d}"
                            if geschaetzt else "", "overlap": False})
        bloecke.sort(key=lambda block: (block["minutes"][0], block["minutes"][1]))
        spaetestes = -1
        vorheriger = None
        for block in bloecke:
            if block["minutes"][0] < spaetestes and not block["item"].get("done"):
                block["overlap"] = True
                if vorheriger is not None and not vorheriger["item"].get("done"):
                    vorheriger["overlap"] = True
            if block["minutes"][1] > spaetestes:
                spaetestes = block["minutes"][1]
                vorheriger = block
        return bloecke

    TIME_PLAN_STEP_MINUTES = 15

    @staticmethod
    def block_minutes(item):
        """Dauer eines Zeitblocks wie in `time_blocks`: die Schätzung, sonst 30 Minuten."""
        dauer = item.get("estimated_minutes")
        return dauer if isinstance(dauer, int) and not isinstance(dauer, bool) and dauer > 0 else 30

    @staticmethod
    def clock_text(minuten):
        minuten = max(0, min(24 * 60 - 1, int(minuten)))
        return f"{minuten // 60:02d}:{minuten % 60:02d}"

    def time_plan_section_of(self, row_id):
        """Zeitplan-Abschnitt einer Baumzeile in „Heute“ – sonst None."""
        if self.view_mode != self.PLAN_DAY_VIEW or not row_id or not hasattr(self, "tree"):
            return None
        abschnitte = (self.TIMEPLAN_SECTION_ROW_ID, self.UNTIMED_SECTION_ROW_ID)
        if row_id in abschnitte:
            return row_id
        try:
            parent = self.tree.parent(row_id)
        except tk.TclError:
            return None
        return parent if parent in abschnitte else None

    def time_plan_items(self, rows):
        """Punkte zu Zeitplanzeilen, in Anzeigereihenfolge und ohne Dubletten."""
        punkte = []
        for row in rows:
            quelle = getattr(self, "in_progress_item_sources", {}).get(row)
            gefunden = self.find_item_in_lists(quelle[1]) if quelle else None
            if gefunden and all(gefunden[0] is not punkt for punkt in punkte):
                punkte.append(gefunden[0])
        return punkte

    def apply_time_plan(self, zuweisungen, rows=()):
        """Setzt je Punkt die neue Uhrzeit (None nimmt sie weg) – ein Rückgängig-Schritt."""
        tag = self.plan_day()
        geaendert = []
        with self.item_change((), restore=False) as change:
            for punkt, neu in zuweisungen:
                if punkt.get("planned_time") == neu and (neu is None or punkt.get("planned_date") == tag):
                    continue
                punkt["planned_time"] = neu
                if neu is not None:
                    punkt["planned_date"] = tag
                geaendert.append(neu)
                change.mark()
        if not geaendert:
            return False
        # Die Zeilen tragen Liste und Punkt im Namen und überstehen den
        # Neuaufbau; so lässt sich mit Alt+↑/↓ weiterschieben.
        vorhanden = [row for row in rows if self.tree.exists(row)]
        if vorhanden:
            self.tree.selection_set(vorhanden)
            self.tree.focus(vorhanden[0])
            self.tree.see(vorhanden[0])
        text = "Uhrzeit entfernt" if geaendert[0] is None else f"Zeitplan: {geaendert[0]}"
        self.show_undo_toast(text + (f" · {len(geaendert)} Punkte" if len(geaendert) > 1 else ""))
        return True

    def apply_clock_assignments(self, assignments):
        if getattr(self, "_data_read_only", False):
            return 0
        changed = []
        for identity, day, clock in assignments:
            found = self.find_item_in_lists(identity)
            if not found or not self.is_schedulable_item(found[0]) or self.is_archived_entry(found[3]):
                return 0
            item = found[0]
            if item.get("planned_time") != clock or (clock is not None and item.get("planned_date") != day):
                changed.append((identity, day, clock))
        if not changed:
            return 0
        with self.item_change([value[0] for value in changed], restore=False, local=True) as change:
            for identity, day, clock in changed:
                item = self.find_item_in_lists(identity)[0]
                item["planned_time"] = clock
                if clock is not None:
                    item["planned_date"] = day
            change.mark()
        if not change.saved:
            return 0
        target = changed[0]
        self.show_undo_toast("Uhrzeit entfernt" if target[2] is None else
                            f"Zeitblock {self.relative_day_text(target[1])} {target[2]} · {len(changed)} Aufgaben")
        return len(changed)

    def choose_time_block(self, event=None):
        if event is not None and isinstance(self.current_focus_widget(), (tk.Entry, tk.Text, ttk.Entry)):
            return None
        ids = self.quick_plan_selection()
        if self.current_focus_widget() is getattr(self, "plan_grid_canvas", None):
            identity = getattr(self, "_plan_grid_focus_id", None)
            ids = [identity] if identity else ids
        items = self.quick_plan_items(ids)
        if not items:
            self.show_info("Zeitblock", "Bitte eine oder mehrere Aufgaben auswählen.")
            return "break"
        old = [(self.find_item_in_lists(item["id"])[3]["id"], copy.deepcopy(item)) for item in items]
        value = self.themed_due_dialog(self.plan_day(), items[0].get("planned_time") or "09:00",
                                      title="Zeitblock", planning_preview_ids=ids)
        if value is None:
            return "break"
        for source, item in old:
            fresh = self.find_item_in_lists(item["id"])
            if not fresh or fresh[3]["id"] != source or fresh[0] != item or self.is_archived_entry(fresh[3]):
                self.show_warning("Zeitblock", "Die Auswahl hat sich geändert. Bitte erneut auswählen.")
                return "break"
        try:
            assignments = glide_planning.time_assignments(items, *value)
        except ValueError as exc:
            self.show_warning("Zeitblock", str(exc))
            return "break"
        self.apply_clock_assignments(assignments)
        return "break"

    def move_plan_grid_focus(self, delta):
        items = [item for item in self.plan_day_items(day=self.plan_day()) if not item.get("done")]
        identities = [item["id"] for item in items]
        if not identities:
            return None
        old = getattr(self, "_plan_grid_focus_id", None)
        position = identities.index(old) if old in identities else (-1 if delta > 0 else 0)
        self._plan_grid_focus_id = identities[(position + delta) % len(identities)]
        self.select_plan_grid_row(self._plan_grid_focus_id)
        self.draw_plan_grid()
        block = self._plan_grid_blocks.get(self._plan_grid_focus_id)
        if block:
            region = self.plan_grid_canvas.bbox("all")
            self.plan_grid_canvas.yview_moveto(max(0, (block[1][1] - 20) / max(1, region[3])))
        return "break"

    def shift_plan_grid_focus(self, delta):
        identity = getattr(self, "_plan_grid_focus_id", None)
        found = self.find_item_in_lists(identity) if identity else None
        if found and found[0].get("planned_time"):
            hour, minute = map(int, found[0]["planned_time"].split(":"))
            clock = self.clock_text(hour * 60 + minute + delta)
            try:
                values = glide_planning.time_assignments([found[0]], self.plan_day(), clock)
                self.apply_clock_assignments(values)
            except ValueError as exc:
                self.show_warning("Zeitblock", str(exc))
        return "break"

    def clear_plan_grid_focus(self, event=None):
        identity = getattr(self, "_plan_grid_focus_id", None)
        if identity:
            self.apply_clock_assignments([(identity, None, None)])
        return "break"

    def time_plan_drop(self, target_id, rows, event_y=None):
        """Ziehen im Zeitplan von „Heute“ setzt die Uhrzeit (AO-070, zweite Stufe).

        Wie beim Umordnen entscheidet die Zeilenhälfte: obere Hälfte eines
        Blocks – der gezogene Punkt endet, wo der Block beginnt; untere Hälfte
        – er beginnt am Blockende. Die Kopfzeile „Zeitplan“ legt vor den ersten
        Block, „Ohne Uhrzeit“ nimmt die Uhrzeit weg. Mehrere Punkte folgen
        lückenlos aufeinander. Überschneidungen werden wie bisher nur benannt.
        """
        abschnitt = self.time_plan_section_of(target_id)
        punkte = self.time_plan_items(rows)
        if abschnitt is None or not punkte or target_id in rows:
            return False
        if abschnitt == self.UNTIMED_SECTION_ROW_ID:
            return self.apply_time_plan([(punkt, None) for punkt in punkte if punkt.get("planned_time")], rows)
        gezogen = {id(punkt) for punkt in punkte}
        bloecke = [block for block in self.time_blocks([(eintrag[3], eintrag[4]) for eintrag in self.plan_day_entries()])
                   if id(block["item"]) not in gezogen]
        gesamt = sum(self.block_minutes(punkt) for punkt in punkte)
        if target_id == self.TIMEPLAN_SECTION_ROW_ID:
            if not bloecke:
                return False
            anfang = bloecke[0]["minutes"][0] - gesamt
        else:
            quelle = self.in_progress_item_sources.get(target_id)
            ziel = next((block for block in bloecke if quelle and block["item"].get("id") == quelle[1]), None)
            if ziel is None:
                return False
            davor = False
            try:
                bbox = self.tree.bbox(target_id)
                davor = bool(bbox) and event_y is not None and event_y < bbox[1] + bbox[3] / 2
            except tk.TclError:
                pass
            anfang = ziel["minutes"][0] - gesamt if davor else ziel["minutes"][1]
        anfang = max(0, anfang)
        zuweisungen = []
        for punkt in punkte:
            zuweisungen.append((punkt, self.clock_text(anfang)))
            anfang += self.block_minutes(punkt)
        return self.apply_time_plan(zuweisungen, rows)

    def shift_time_plan_selection(self, offset):
        """Alt+↑/↓ im Zeitplan: ausgewählte Blöcke um 15 Minuten früher oder später."""
        rows = [row for row in self.tree.selection()
                if self.time_plan_section_of(row) == self.TIMEPLAN_SECTION_ROW_ID]
        zuweisungen = []
        for punkt in self.time_plan_items(rows):
            zeit = self.normalize_due_time(punkt.get("planned_time"))
            if zeit:
                stunde, minute = (int(teil) for teil in zeit.split(":"))
                neu = stunde * 60 + minute + offset * self.TIME_PLAN_STEP_MINUTES
                zuweisungen.append((punkt, self.clock_text(neu)))
        self.apply_time_plan(zuweisungen, rows)
        return "break"

    def on_time_plan_drag_start(self, event):
        """Ziehen beginnt in „Heute“ auf Punktzeilen; sonst bleibt es ein Klick.

        Innerhalb der Liste wirkt es nur im Zeitplan. Ins Stundenraster darf
        jede Punktzeile fallen – auch aus „Ohne Uhrzeit“ und dem Eingang.
        """
        row_id = self.tree.identify_row(event.y)
        greifbar = row_id in getattr(self, "in_progress_item_sources", {}) and (
            self.time_plan_section_of(row_id) or self.plan_grid_applicable())
        self.drag_start_id = row_id if greifbar else None
        self.drag_item_ids = []
        self.drag_start_x, self.drag_start_y = event.x, event.y
        self.drag_has_moved = False

    def on_time_plan_drag_motion(self, event):
        if not self.drag_start_id:
            return
        if abs(event.x - self.drag_start_x) + abs(event.y - self.drag_start_y) > 6:
            self.drag_has_moved = True
        self.clear_drop_target_tags()
        minuten = self.plan_grid_minutes_at(event.x_root, event.y_root) if self.drag_has_moved else None
        self.show_plan_grid_drop_preview(minuten)
        if minuten is not None:
            return
        target_id = self.identify_tree_drop_row(event)
        if (target_id and target_id != self.drag_start_id and self.time_plan_section_of(target_id)
                and self.time_plan_section_of(self.drag_start_id)):
            try:
                tags = set(self.tree.item(target_id, "tags"))
                tags.add("drop_target")
                self.tree.item(target_id, tags=tuple(tags))
            except tk.TclError:
                pass

    def on_time_plan_drag_end(self, event):
        source_id = self.drag_start_id
        self.clear_drop_target_tags()
        self.drag_start_id = None
        self.drag_item_ids = []
        self.show_plan_grid_drop_preview(None)
        if not source_id or not self.drag_has_moved:
            return
        auswahl = self.tree.selection()
        rows = list(auswahl) if source_id in auswahl else [source_id]
        minuten = self.plan_grid_minutes_at(event.x_root, event.y_root)
        if minuten is not None:
            self.plan_grid_drop(minuten, [row for row in rows if row in self.in_progress_item_sources])
            return
        rows = [row for row in rows if self.time_plan_section_of(row) and row in self.in_progress_item_sources]
        self.time_plan_drop(self.identify_tree_drop_row(event), rows, event.y)

    # --- Stundenraster (zweiter Ausbau 3.30) --------------------------------
    # Eine zuschaltbare Fläche rechts neben dem Zeitplan von „Mein Tag“: Blöcke
    # stehen nach Uhrzeit, Ziehen setzt die Uhrzeit im 15-Minuten-Raster. Es
    # ist dieselbe Änderung wie im Zeitplan (`apply_time_plan`) – ein
    # Rückgängig-Schritt mit Rückmeldung.
    PLAN_GRID_HOUR_PX = 48
    PLAN_GRID_RANGE = (6, 22)
    PLAN_GRID_WIDTH = 300
    PLAN_GRID_MIN_WINDOW = 900
    PLAN_GRID_LEFT = 48

    def plan_grid_enabled(self):
        return self.settings.get("plan_day_grid") is True

    def toggle_plan_day_grid(self, event=None):
        self.settings["plan_day_grid"] = not self.plan_grid_enabled()
        self.save_settings()
        if self.plan_grid_enabled() and self.view_mode != self.PLAN_DAY_VIEW:
            self.set_plan_day_view(day=self.plan_day())
        else:
            self.sync_plan_day_grid()
        return "break"

    def plan_grid_applicable(self):
        return self.plan_grid_enabled() and self.view_mode == self.PLAN_DAY_VIEW

    def plan_grid_replaces_list(self):
        """Unter 900 Pixeln steht das Raster statt der Liste, nicht daneben.

        Vorher verschwand es in schmalen Fenstern ganz. Jetzt schaltet
        „Raster“ dort zwischen Liste und Raster um.
        """
        try:
            return self.plan_grid_applicable() and self.root.winfo_width() < self.PLAN_GRID_MIN_WINDOW
        except tk.TclError:
            return False

    def _restore_plan_list(self):
        """Holt die Liste zurück, die das Raster im schmalen Fenster ersetzt hat."""
        info = getattr(self, "_plan_list_pack", None)
        self._plan_list_pack = None
        if info and not self.list_frame.winfo_manager():
            try:
                self.list_frame.pack(**info)
            except tk.TclError:
                pass

    def sync_plan_day_grid(self):
        if not hasattr(self, "list_frame_outer"):
            return
        knopf = getattr(self, "plan_day_grid_button", None)
        if knopf is not None:
            try:
                knopf.set_text("Raster ✓" if self.plan_grid_enabled() else "Raster")
            except tk.TclError:
                pass
        rahmen = getattr(self, "plan_grid_frame", None)
        if not self.plan_grid_applicable():
            if rahmen is not None and rahmen.winfo_exists() and rahmen.winfo_manager():
                rahmen.pack_forget()
            self._restore_plan_list()
            return
        if rahmen is None or not rahmen.winfo_exists():
            self.build_plan_grid()
            rahmen = self.plan_grid_frame
        anstelle = self.plan_grid_replaces_list()
        if anstelle != getattr(self, "_plan_grid_instead", None) or not rahmen.winfo_manager():
            self._plan_grid_instead = anstelle
            rahmen.pack_forget()
            if anstelle:
                if self.list_frame.winfo_manager():
                    info = dict(self.list_frame.pack_info())
                    info.pop("in", None)
                    self._plan_list_pack = info
                    rahmen.pack(side="right", fill="both", expand=True, before=self.list_frame)
                    self.list_frame.pack_forget()
                else:
                    rahmen.pack(side="right", fill="both", expand=True)
            else:
                self._restore_plan_list()
                rahmen.pack(side="right", fill="y", before=self.list_frame)
        self.draw_plan_grid()

    def build_plan_grid(self):
        theme = self.theme
        self.plan_grid_frame = tk.Frame(self.list_frame_outer.inner, bg=theme["card"], width=self.PLAN_GRID_WIDTH)
        self.plan_grid_frame.pack_propagate(False)
        self.plan_grid_title = tk.Label(self.plan_grid_frame, text="STUNDENRASTER", bg=theme["card"],
                                        fg=theme["muted"], font=app_font(8, "bold"), anchor="w")
        self.plan_grid_title.pack(fill="x", padx=12, pady=(10, 4))
        canvas = self.plan_grid_canvas = tk.Canvas(self.plan_grid_frame, bg=theme["card"], highlightthickness=0,
                                                   bd=0, yscrollincrement=1)
        canvas.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        canvas.bind("<ButtonPress-1>", self.plan_grid_press)
        canvas.bind("<B1-Motion>", self.plan_grid_motion)
        canvas.bind("<ButtonRelease-1>", self.plan_grid_release)
        canvas.bind("<Double-Button-1>", self.plan_grid_double)
        canvas.configure(takefocus=1)
        canvas.bind("<Tab>", lambda event: self.move_plan_grid_focus(1))
        canvas.bind("<Shift-Tab>", lambda event: self.move_plan_grid_focus(-1))
        canvas.bind("<Up>", lambda event: self.move_plan_grid_focus(-1))
        canvas.bind("<Down>", lambda event: self.move_plan_grid_focus(1))
        canvas.bind("<Return>", self.choose_time_block)
        canvas.bind("<Alt-Up>", lambda event: self.shift_plan_grid_focus(-15))
        canvas.bind("<Alt-Down>", lambda event: self.shift_plan_grid_focus(15))
        canvas.bind("<Delete>", self.clear_plan_grid_focus)
        canvas.bind("<Escape>", lambda event: self.plan_day_grid_button.focus_set() or "break")
        canvas.bind("<Configure>", lambda _event: self.draw_plan_grid())
        self.bind_mousewheel(canvas)

    def plan_grid_y(self, minuten):
        return (minuten - self._plan_grid_range[0] * 60) * self.PLAN_GRID_HOUR_PX / 60 + 8

    def draw_plan_grid(self):
        canvas = getattr(self, "plan_grid_canvas", None)
        if canvas is None or not canvas.winfo_exists() or not self.plan_grid_applicable():
            return
        theme = self.theme
        self.plan_grid_frame.configure(bg=theme["card"])
        self.plan_grid_title.configure(bg=theme["card"], fg=theme["muted"])
        canvas.configure(bg=theme["card"])
        canvas.delete("all")
        bloecke = self.time_blocks([(eintrag[3], eintrag[4]) for eintrag in self.plan_day_entries()])
        erste, letzte = self.PLAN_GRID_RANGE
        for block in bloecke:
            erste = min(erste, block["minutes"][0] // 60)
            letzte = max(letzte, min(24, -(-block["minutes"][1] // 60)))
        self._plan_grid_range = (erste, letzte)
        breite = max(180, canvas.winfo_width())
        links = self.PLAN_GRID_LEFT
        for stunde in range(erste, letzte + 1):
            y = self.plan_grid_y(stunde * 60)
            canvas.create_line(links, y, breite, y, fill=theme["line"])
            canvas.create_text(links - 6, y, text=f"{stunde:02d}:00", anchor="e", fill=theme["muted"],
                               font=app_font(8))
        # Überschneidende Blöcke nebeneinander statt übereinander.
        bahnen, platz = [], []
        for block in bloecke:
            start, ende = block["minutes"]
            bahn = next((index for index, frei_ab in enumerate(bahnen) if frei_ab <= start), None)
            if bahn is None:
                bahn = len(bahnen)
                bahnen.append(ende)
            else:
                bahnen[bahn] = ende
            platz.append(bahn)
        spalte = (breite - links - 8) / max(1, len(bahnen))
        self._plan_grid_blocks = {}
        for block, bahn in zip(bloecke, platz):
            start, ende = block["minutes"]
            y1 = self.plan_grid_y(start)
            y2 = max(y1 + 18, self.plan_grid_y(ende))
            x1 = links + 4 + bahn * spalte
            x2 = x1 + spalte - 4
            farbe = theme["line"] if block["item"].get("done") else theme["ui_accent"]
            kennung = block["item"].get("id")
            marke = f"block:{kennung}"
            canvas.create_rectangle(x1, y1, x2, y2, fill=farbe,
                                    outline=theme["delete"] if block["overlap"] else farbe,
                                    width=2 if block["overlap"] else 1, tags=("block", marke))
            canvas.create_text(x1 + 6, y1 + 3, anchor="nw", width=max(20, x2 - x1 - 10),
                               text=f"{block['start']}  {self.item_display_text(block['item'])}",
                               fill=readable_text_color(farbe), font=app_font(9), tags=("block", marke))
            self._plan_grid_blocks[kennung] = (block, (x1, y1, x2, y2))
            if kennung == getattr(self, "_plan_grid_focus_id", None):
                canvas.create_rectangle(x1 - 2, y1 - 2, x2 + 2, y2 + 2,
                                        outline=theme["text"], width=2, dash=(3, 2), tags=("keyboard_focus",))
        focused = self.find_item_in_lists(getattr(self, "_plan_grid_focus_id", None))
        self.plan_grid_title.configure(text="STUNDENRASTER" +
            (f" · {self.item_display_text(focused[0])[:32]}" if focused else ""))
        if not bloecke:
            canvas.create_text(links + 8, 14, anchor="nw", width=max(80, breite - links - 16), fill=theme["muted"],
                               font=app_font(9), text="Keine Punkte mit Uhrzeit. Punkte aus der Liste "
                                                      "hierher ziehen oder im Feld „Bearbeitungstag“ "
                                                      "eine Uhrzeit setzen.")
        if self.plan_day() == date.today().isoformat():
            jetzt = datetime.now()
            minuten = jetzt.hour * 60 + jetzt.minute
            if erste * 60 <= minuten <= letzte * 60:
                y = self.plan_grid_y(minuten)
                canvas.create_line(links, y, breite, y, fill=theme["delete"], width=2, tags=("jetzt",))
        canvas.configure(scrollregion=(0, 0, breite, self.plan_grid_y(letzte * 60) + 8))

    def plan_grid_block_at(self, x, y):
        for kennung, (_block, (x1, y1, x2, y2)) in (getattr(self, "_plan_grid_blocks", None) or {}).items():
            if x1 <= x <= x2 and y1 <= y <= y2:
                return kennung
        return None

    def select_plan_grid_row(self, kennung):
        found = self.find_item_in_lists(kennung)
        if not found:
            return
        zeile = f"in-progress:{found[3].get('id')}:{kennung}"
        if self.tree.exists(zeile):
            self.tree.selection_set(zeile)
            self.tree.focus(zeile)
            self.tree.see(zeile)

    def plan_grid_press(self, event):
        canvas = self.plan_grid_canvas
        x, y = canvas.canvasx(event.x), canvas.canvasy(event.y)
        kennung = self.plan_grid_block_at(x, y)
        self._plan_grid_drag = None
        if kennung:
            self._plan_grid_focus_id = kennung
            canvas.focus_set()
            block = self._plan_grid_blocks[kennung][0]
            self._plan_grid_drag = {"id": kennung, "y": y, "start": block["minutes"][0], "shown": 0.0, "moved": False}
            self.select_plan_grid_row(kennung)
        return "break"

    def plan_grid_motion(self, event):
        drag = getattr(self, "_plan_grid_drag", None)
        if not drag:
            return "break"
        canvas = self.plan_grid_canvas
        delta = canvas.canvasy(event.y) - drag["y"]
        if abs(delta) < 4 and not drag["moved"]:
            return "break"
        drag["moved"] = True
        canvas.move(f"block:{drag['id']}", 0, delta - drag["shown"])
        drag["shown"] = delta
        return "break"

    def plan_grid_release(self, event):
        drag = getattr(self, "_plan_grid_drag", None)
        self._plan_grid_drag = None
        if not drag or not drag["moved"]:
            return "break"
        delta = self.plan_grid_canvas.canvasy(event.y) - drag["y"]
        schritt = self.TIME_PLAN_STEP_MINUTES
        neu = int(round((drag["start"] + delta * 60 / self.PLAN_GRID_HOUR_PX) / schritt) * schritt)
        found = self.find_item_in_lists(drag["id"])
        if not found or not self.apply_time_plan([(found[0], self.clock_text(neu))]):
            self.draw_plan_grid()
        return "break"

    def plan_grid_minutes_at(self, x_root, y_root):
        """Uhrzeit im 15-Minuten-Raster unter einem Bildschirmpunkt – None außerhalb des Rasters."""
        canvas = getattr(self, "plan_grid_canvas", None)
        try:
            if (canvas is None or not canvas.winfo_exists() or not canvas.winfo_ismapped()
                    or not self.plan_grid_applicable()):
                return None
            x, y = x_root - canvas.winfo_rootx(), y_root - canvas.winfo_rooty()
            if not (0 <= x < canvas.winfo_width() and 0 <= y < canvas.winfo_height()):
                return None
            y = canvas.canvasy(y)
        except tk.TclError:
            return None
        erste = getattr(self, "_plan_grid_range", self.PLAN_GRID_RANGE)[0]
        schritt = self.TIME_PLAN_STEP_MINUTES
        minuten = erste * 60 + (y - 8) * 60 / self.PLAN_GRID_HOUR_PX
        return max(0, min(24 * 60 - schritt, int(round(minuten / schritt)) * schritt))

    def show_plan_grid_drop_preview(self, minuten):
        """Gestrichelte Linie mit Uhrzeit, wo ein aus der Liste gezogener Punkt beginnen würde."""
        canvas = getattr(self, "plan_grid_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("drop_preview")
        if minuten is None:
            return
        y = self.plan_grid_y(minuten)
        breite = max(180, canvas.winfo_width())
        canvas.create_line(self.PLAN_GRID_LEFT, y, breite, y, fill=self.theme["ui_accent"], width=2,
                           dash=(4, 3), tags=("drop_preview",))
        canvas.create_text(breite - 6, y - 2, anchor="se", text=self.clock_text(minuten) + " · " + self.planning_available_text(self.plan_day(),
                           [item["id"] for item in self.time_plan_items(self.drag_item_ids or ())]),
                           fill=self.theme["ui_accent"], font=app_font(8, "bold"), tags=("drop_preview",))

    def plan_grid_drop(self, minuten, rows):
        """Punkte aus der Liste ins Raster: Beginn an der Zeigerzeit, mehrere lückenlos nacheinander.

        Ein Punkt aus dem Eingang oder mit anderem Bearbeitungstag wird dabei
        für den angezeigten Tag eingeplant – dieselbe Änderung wie im Zeitplan.
        """
        punkte = self.time_plan_items(rows)
        if not punkte:
            return False
        zuweisungen = []
        for punkt in punkte:
            zuweisungen.append((punkt, self.clock_text(minuten)))
            minuten += self.block_minutes(punkt)
        return self.apply_time_plan(zuweisungen, rows)

    def plan_grid_double(self, event):
        canvas = self.plan_grid_canvas
        kennung = self.plan_grid_block_at(canvas.canvasx(event.x), canvas.canvasy(event.y))
        if kennung:
            self.edit_in_progress_item(kennung)
        return "break"

    def quick_plan_selection(self):
        """Stabile Punktkennungen; abgeleitete Zeilen behalten ihre Quellliste."""
        if self.view_mode in self.DERIVED_ITEM_VIEWS:
            ids = []
            for row in self.tree.selection():
                source = self.in_progress_item_sources.get(row)
                found = self.find_item_in_lists(source[1]) if source else None
                if found and found[3].get("id") == source[0] and self.is_schedulable_item(found[0]):
                    ids.append(source[1])
            return list(dict.fromkeys(ids))
        if self.view_mode in ("list", self.TABLE_VIEW):
            return [item_id for item_id in self.get_selected_item_ids()
                    if self.is_schedulable_item(self.find_item(item_id)[0])]
        return []

    def skip_repeat_occurrences(self, item_ids=None, missed=False):
        """Rückt Wiederholungen vor, ohne eine Erledigung zu buchen (KO02).

        `missed=False` lässt genau den aktuellen Termin aus, `missed=True` alle
        verpassten Termine bis heute. Wie beim Vorrücken nach dem Abhaken wird
        der Bearbeitungstag frei und eine feste Erinnerung entfällt; die Reihe,
        der Aufwand und alles Übrige bleiben. Keine Tageszahl, kein
        Abschlussdatum, ein Undo-Schritt für alle Quelllisten.
        """
        if item_ids is None:
            item_ids = self.quick_plan_selection()
        items = self.quick_plan_items(item_ids)
        plan, gruende = glide_repeat.skip_plan(items, date.today(), missed=missed)
        if not plan:
            grund = next(iter(gruende.values()), "keine Aufgabe mit Wiederholung ausgewählt")
            self.show_info("Wiederholung", f"Nichts zu überspringen: {grund}.")
            return "break"
        with self.item_change(list(plan)) as change:
            for item_id, neu in plan.items():
                found = self.find_item_in_lists(item_id)
                if not found:
                    continue
                item = found[0]
                item["due"] = neu
                item["planned_date"] = None
                item["planned_time"] = None
                if (item.get("reminder") or {}).get("mode") == "fixed":
                    item["reminder"] = None  # Eine feste Erinnerung gehörte zum ausgelassenen Termin.
                elif item.get("reminder"):
                    item["reminder"] = self.reminder_config(item["reminder"])
                change.mark(item_id)
        if change.changed and change.saved:
            if len(plan) == 1:
                termin = self.format_due_display(next(iter(plan.values())))
                text = (f"Verpasste Termine übersprungen · nächster {termin}" if missed
                        else f"Termin übersprungen · nächster {termin}")
            else:
                text = f"{len(plan)} Wiederholungen vorgerückt"
            self.show_undo_toast(text)
        return "break"

    def skip_repeat_selected(self, event=None):
        """Diesen Termin der gewählten Wiederholungen auslassen (Menü, Palette)."""
        return self.skip_repeat_occurrences(missed=False)

    def skip_missed_repeats_selected(self, event=None):
        """Verpasste Termine der gewählten Wiederholungen auslassen (Menü, Palette)."""
        return self.skip_repeat_occurrences(missed=True)

    def add_repeat_skip_entries(self, menu, item_ids):
        """Menüeinträge nur für Aufgaben mit Wiederholung; verpasste nur bei Überfälligem."""
        items = self.quick_plan_items(item_ids)
        heute = date.today().isoformat()
        wiederholt = [item for item in items if self.normalize_repeat(item.get("repeat")) and not item.get("done")]
        if not wiederholt:
            return
        menu.add_command(label="Diesen Termin überspringen",
                         command=lambda ids=list(item_ids): self.skip_repeat_occurrences(ids))
        if any((self.normalize_due(item.get("due")) or heute) < heute for item in wiederholt):
            menu.add_command(label="Verpasste Termine überspringen",
                             command=lambda ids=list(item_ids): self.skip_repeat_occurrences(ids, missed=True))

    def quick_plan_items(self, item_ids):
        result = []
        for item_id in dict.fromkeys(item_ids or ()):
            found = self.find_item_in_lists(item_id)
            if found and self.is_schedulable_item(found[0]):
                result.append(found[0])
        return result

    def planning_available(self, day, item_ids=()):
        """Rest nach Einplanen; voller Zieltag, unabhängig von Suche/Offenfilter."""
        items = [item for entry in self.planning_lists()
                 for item in self.walk_items(entry.get("items", []))
                 if self.is_schedulable_item(item)]
        projected = glide_planning.projected_items(items, self.quick_plan_items(item_ids), day)
        return self.planning_summary(projected, day=day)

    def planning_available_text(self, day, item_ids=()):
        return glide_planning.available_text(self.planning_available(day, item_ids))

    def apply_quick_plan(self, item_ids, day, toast=True):
        """Nur planned_date, ein Undo-Schritt, frische Objekte nach jedem Undo."""
        items = self.quick_plan_items(item_ids)
        changed = glide_planning.changed_ids(items, day)
        if not changed:
            return 0
        rows = tuple(self.tree.selection())
        focus = self.tree.focus()
        scroll = self.tree.yview()
        with self.item_change(changed, restore=False, local=True) as change:
            for item_id in changed:
                self.find_item_in_lists(item_id)[0]["planned_date"] = day
            change.mark()
        # In Heute können umgeplante Aufgaben verschwinden; nur überlebende
        # Zeilen wieder markieren. Allgemeine Listenaktionen bleiben unverändert.
        surviving = [row for row in rows if self.tree.exists(row)]
        if surviving:
            self.tree.selection_set(surviving)
            self.tree.focus(focus if focus in surviving else surviving[-1])
        if scroll:
            self.tree.yview_moveto(scroll[0])
        self.sync_selection_bar()
        if not change.saved:
            return 0
        if toast:
            count = "1 Aufgabe" if len(changed) == 1 else f"{len(changed)} Aufgaben"
            text = f"{count} ohne Bearbeitungstag" if day is None else (
                f"{count} für {self.relative_day_text(day)} eingeplant · {self.planning_available_text(day)}")
            self.show_undo_toast(text)
        return len(changed)

    def choose_quick_plan(self, choice, item_ids=None, review=False, shown_day=None):
        ids = tuple(self.quick_plan_selection() if item_ids is None else item_ids)
        if not ids:
            return "break"
        if choice == "date":
            items = self.quick_plan_items(ids)
            initial = items[0].get("planned_date") if len(items) == 1 else None
            value = self.themed_due_dialog(initial or self.plan_day(), title="Einplanen",
                                           show_time=False, planning_preview_ids=ids)
            if value is None:
                return "break"
            day = value[0]
        else:
            day = shown_day or glide_planning.target_day(choice, date.today(), self.settings.get("week_start"))
        if review:
            return self.day_review_decide(choice, target_day=day)
        self.apply_quick_plan(ids, day)
        return "break"

    def build_quick_plan_menu(self, parent=None, item_ids=None, review=False):
        ids = tuple(self.quick_plan_selection() if item_ids is None else item_ids)
        menu = self._new_themed_popup_menu(parent)
        # Ein Scan des Bestands für alle fünf Vorschauen; keine Menü-Objektcaches.
        items = [item for entry in self.planning_lists()
                 for item in self.walk_items(entry.get("items", []))
                 if self.is_schedulable_item(item)]
        selected = self.quick_plan_items(ids)
        reference = date.today()
        for choice, label in glide_planning.CHOICES:
            day = None
            if choice not in ("date", "unplan"):
                day = glide_planning.target_day(choice, reference, self.settings.get("week_start"))
                summary = self.planning_summary(glide_planning.projected_items(items, selected, day), day=day)
                label += " · " + glide_planning.available_text(summary) + " · " + self.format_due_display(day)
            menu.add_command(label=label, state="normal" if selected else "disabled",
                             command=lambda value=choice, shown=day: self.choose_quick_plan(value, ids, review, shown))
        return menu

    def show_quick_plan_menu(self, event=None, item_ids=None, review=False, anchor=None):
        if event is not None and isinstance(event.widget, (tk.Entry, tk.Text, ttk.Entry)):
            return None
        ids = tuple(self.quick_plan_selection() if item_ids is None else item_ids)
        if not ids:
            return "break"
        self._destroy_item_context_menu()
        menu = self.build_quick_plan_menu(item_ids=ids, review=review)
        self._item_context_menu = menu
        widget = anchor or self.plan_button
        if not widget.winfo_ismapped():
            widget = self.tree
        try:
            menu.tk_popup(widget.winfo_rootx(), widget.winfo_rooty() + min(widget.winfo_height(), 36))
        finally:
            menu.grab_release()
        return "break"

    def hide_quick_plan_row(self, event=None):
        button = getattr(self, "quick_plan_row_button", None)
        if button is not None:
            button.place_forget()
        self._quick_plan_row = None

    def show_quick_plan_row(self, event=None):
        """Eine bedarfsweise Zeilenaktion; gespeichert wird nur die stabile Zeile."""
        if self.view_mode not in ("list", self.TABLE_VIEW, self.PLAN_DAY_VIEW, "in_progress"):
            self.hide_quick_plan_row()
            return
        row = self.tree.identify_row(event.y) if event is not None else self.tree.focus()
        source = self.in_progress_item_sources.get(row) if self.view_mode in self.DERIVED_ITEM_VIEWS else None
        item_id = source[1] if source else row
        found = self.find_item_in_lists(item_id)
        bbox = self.tree.bbox(row) if row and self.tree.exists(row) else ()
        if not bbox or not found or not self.is_schedulable_item(found[0]):
            self.hide_quick_plan_row()
            return
        if not hasattr(self, "quick_plan_row_button"):
            self.quick_plan_row_button = self.make_button(
                self.tree, self.ICONS["calendar"], self.quick_plan_row_action, "muted",
                width=28, height=28, radius=9, font=app_font(10), bg_key="card")
            self.add_tooltip(self.quick_plan_row_button, "Einplanen (Strg/Cmd+Umschalt+P)")
        self._quick_plan_row = (self.view_mode, row, item_id)
        self.quick_plan_row_button.place(x=max(0, self.tree.winfo_width() - 32),
                                         y=bbox[1] + max(0, (bbox[3] - 28) // 2), width=28, height=28)

    def leave_quick_plan_row(self, event):
        button = getattr(self, "quick_plan_row_button", None)
        if button is not None and button.winfo_ismapped():
            x, y = event.x_root, event.y_root
            if (button.winfo_rootx() <= x < button.winfo_rootx() + button.winfo_width()
                    and button.winfo_rooty() <= y < button.winfo_rooty() + button.winfo_height()):
                return
        self.hide_quick_plan_row()

    def quick_plan_row_action(self):
        target = getattr(self, "_quick_plan_row", None)
        if not target or target[0] != self.view_mode or not self.tree.exists(target[1]):
            return "break"
        row, item_id = target[1:]
        ids = self.quick_plan_selection() if row in self.tree.selection() else [item_id]
        return self.show_quick_plan_menu(item_ids=ids, anchor=self.quick_plan_row_button)

    def planning_summary(self, items, capacity=None, day=None):
        """Eine Aufwandsbilanz für alle Planungswege, unabhängig von Tk."""
        capacity = self.daily_capacity_minutes(day) if capacity is None else capacity
        return glide_planning.summarize(items, capacity, self.is_schedulable_item)

    def format_planning_summary(self, summary):
        """Klartext zur Aufwandsbilanz; nennt immer Grund und Bezugsgröße."""
        if not summary or not summary.get("items"):
            return ""
        teile = []
        if summary["estimated"]:
            teile.append(f"{self.format_estimated_minutes(summary['minutes'])} geplant")
            if summary["done_minutes"]:
                teile.append(f"davon {self.format_estimated_minutes(summary['done_minutes'])} erledigt")
        if summary["without_estimate"]:
            teile.append(f"{summary['without_estimate']} ohne Schätzung")
        capacity = summary.get("capacity") or 0
        rest = summary.get("remaining")
        if capacity and rest is not None:
            bezug = self.format_estimated_minutes(capacity)
            if rest >= 0:
                teile.append(f"{self.format_estimated_minutes(rest)} frei von {bezug}")
            else:
                teile.append(f"{self.format_estimated_minutes(-rest)} über {bezug}")
        return " · ".join(teile)

    def home_summary(self, today=None):
        """Lokale Bestandszahlen; erledigte und gelöschte Daten zählen nicht als fällig."""
        today = today or date.today()
        today_iso = today.isoformat()
        total = done = overdue = due_today = 0
        due_lists = []
        for entry in self.planning_lists():
            matching = 0
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item):
                    continue
                total += 1
                if item.get("done"):
                    done += 1
                    continue
                due = self.normalize_due(item.get("due"))
                if due == today_iso:
                    due_today += 1
                    matching += 1
                elif due and due < today_iso:
                    overdue += 1
            if matching:
                due_lists.append((entry, matching))
        lookup = {entry["id"]: entry for entry in self.lists}
        recent = [(lookup[value["id"]], value["edited_at"])
                  for value in self.settings.get("recent_lists", []) if value["id"] in lookup]
        return {"total": total, "done": done, "open": total - done, "overdue": overdue,
                "due_today": due_today, "lists": len(self.lists), "due_lists": due_lists, "recent": recent}

    # -----------------------------
    # Gruppieren nach Feld (3.30, PW-010, AO-040, AO-030)
    # -----------------------------
    # Eine Funktion liefert die Gruppen, eine setzt das Feld. Spaltenboard,
    # Liste und Tabelle teilen beides – Ziehen bedeutet überall dasselbe.
    GROUP_FIELDS = ItemWorkspace.BOARD_GROUP_FIELDS
    GROUP_FIELD_KEYS = tuple(key for key, _name in GROUP_FIELDS)
    # Liste und Tabelle gruppieren nie nach „Liste“: Sie zeigen genau eine.
    LIST_GROUP_FIELDS = tuple((key, name) for key, name in GROUP_FIELDS if key != "list")
    GROUP_SECTION_PREFIX = "groupby:"
    MAX_GROUP_SETTINGS = 2000

    def date_group_bounds(self, today=None):
        """Heute, morgen und der letzte Tag dieser Woche (nach Wochenbeginn)."""
        today = today or date.today()
        return today, today + timedelta(days=1), self.next_week_start(today) - timedelta(days=1)

    def date_group_key(self, value, today=None):
        day = self.normalize_due(value)
        if not day:
            return "none"
        today, tomorrow, week_end = self.date_group_bounds(today)
        current = date.fromisoformat(day)
        if current < today:
            return "past"
        if current == today:
            return "today"
        if current == tomorrow:
            return "tomorrow"
        return "week" if current <= week_end else "later"

    def date_group_target(self, key, today=None):
        """Das Datum, das Ablegen in einer Datumsgruppe setzt: (ISO, "" für ohne, oder None) und Grund."""
        today, tomorrow, week_end = self.date_group_bounds(today)
        if key == "today":
            return today.isoformat(), None
        if key == "tomorrow":
            return tomorrow.isoformat(), None
        if key == "week":
            day = today + timedelta(days=2)
            if day > week_end:
                return None, "Diese Woche hat nach morgen keinen Tag mehr."
            return day.isoformat(), None
        if key == "later":
            return max(week_end + timedelta(days=1), today + timedelta(days=2)).isoformat(), None
        if key == "none":
            return "", None
        return None, ("Ein vergangenes Datum setzt man nicht durch Ziehen – die Gruppe zeigt, "
                      "was liegen geblieben ist.")

    def entry_color_value(self, entry):
        key = self.inherited_list_color(entry)
        return self.theme[key] if key in self.theme else self.theme["ui_accent"]

    def group_columns(self, field, lists=()):
        """Die Gruppen eines Felds in fester Reihenfolge.

        Jede Gruppe ist ein Wörterbuch mit key, title, color (Farbwert),
        settable und reason – dem Satz, der erklärt, warum eine Gruppe keine
        Punkte annimmt.
        """
        theme = self.theme

        def gruppe(key, title, color, settable=True, reason=None):
            return {"key": key, "title": title, "color": color, "settable": settable, "reason": reason}

        if field in ("due", "planned"):
            namen = {"past": "Überfällig" if field == "due" else "Liegen geblieben", "today": "Heute",
                     "tomorrow": "Morgen", "week": "Diese Woche", "later": "Später",
                     "none": "Ohne Termin" if field == "due" else "Ohne Bearbeitungstag"}
            farben = {"past": "overdue", "today": "due_today", "tomorrow": "due_action", "week": "clear",
                      "later": "muted", "none": "muted"}
            result = []
            for key in ("past", "today", "tomorrow", "week", "later", "none"):
                ziel, grund = self.date_group_target(key)
                result.append(gruppe(key, namen[key], theme[farben[key]], ziel is not None, grund))
            return result
        if field == "importance":
            namen = {3: "Hoch", 2: "Mittel", 1: "Niedrig", 0: "Ohne Wichtigkeit"}
            return [gruppe(str(value), namen[value],
                           theme[self.importance_color_key(value)] if value else theme["muted"])
                    for value in (3, 2, 1, 0)]
        if field == "done":
            return [gruppe("open", "Offen", theme["ui_accent"]), gruppe("done", "Erledigt", theme["confirm"])]
        if field == "eisenhower":
            # Jeder Quadrant nimmt an; was Ablegen ändert, entscheidet eisenhower.aenderung.
            farben = {"q1": theme[self.importance_color_key(3)], "q2": theme["clear"],
                      "q3": theme["due_action"], "q4": theme["muted"]}
            return [gruppe(key, titel, farben[key]) for key, titel, _wichtig, _dringend in glide_eisenhower.QUADRANTEN]
        if field == "label":
            result = [gruppe(label["id"], str(label.get("name") or "Label"), self.label_color(label))
                      for label in self.labels if not self.is_system_label(label)]
            result.append(gruppe("none", "Ohne Label", theme["muted"]))
            return result
        if field == "list":
            return [gruppe(entry["id"], str(entry.get("title") or "Liste"), self.entry_color_value(entry),
                           self.list_accepts_items(entry),
                           None if self.list_accepts_items(entry) else "Diese Seite nimmt keine Aufgaben auf.")
                    for entry in lists]
        return []

    def regular_label_ids(self):
        return {label["id"] for label in self.labels if not self.is_system_label(label)}

    def item_group_keys(self, item, field, entry=None, known_labels=None):
        """Die Gruppen, in denen ein Punkt steht – beim Label können es mehrere sein."""
        if field == "due":
            return [self.date_group_key(item.get("due"))]
        if field == "planned":
            return [self.date_group_key(item.get("planned_date"))]
        if field == "importance":
            return [str(self.clamp_importance(item.get("importance", 0)))]
        if field == "eisenhower":
            return [glide_eisenhower.quadrant(item)]
        if field == "done":
            return ["done" if item.get("done") else "open"]
        if field == "label":
            known = self.regular_label_ids() if known_labels is None else known_labels
            own = [value for value in item.get("labels", []) or [] if value in known]
            return list(dict.fromkeys(own)) or ["none"]
        if field == "list":
            return [entry.get("id")] if isinstance(entry, dict) and entry.get("id") else []
        return []

    def set_group_value(self, item_ids, field, target, source=None):
        """Setzt das Gruppierungsfeld der Punkte – ein Rückgängig-Schritt.

        Regeln (PW-010): Beim Datum bleibt die Uhrzeit, nur der Tag wechselt;
        eine Wiederholung bleibt Serie, verschoben wird das aktuelle Vorkommen;
        beim Label ersetzt das Ziel das Quelllabel. Rückgabe (geändert, Grund);
        eine Gruppe, die nichts annimmt, sagt warum.
        """
        gefunden = [self.find_item_in_lists(item_id) for item_id in dict.fromkeys(item_ids or ())]
        gefunden = [value for value in gefunden if value and self.is_schedulable_item(value[0])]
        if not gefunden:
            return False, "Nur Aufgaben und Langtexts lassen sich so einordnen."
        items = [value[0] for value in gefunden]
        kennungen = [item["id"] for item in items]
        if field in ("due", "planned"):
            tag, grund = self.date_group_target(target)
            if tag is None:
                return False, grund
            datum, uhrzeit = ("due", "due_time") if field == "due" else ("planned_date", "planned_time")
            with self.item_change(kennungen, restore=False, local=True) as change:
                for item in items:
                    if not tag:
                        # Ohne Tag entfällt auch die Uhrzeit – eine Frist ohne Tag gibt es nicht.
                        if item.get(datum) or item.get(uhrzeit):
                            item[datum] = None
                            item[uhrzeit] = None
                            change.mark()
                    elif item.get(datum) != tag:
                        item[datum] = tag
                        change.mark()
            return bool(change.changed and change.saved is not False), None
        if field == "importance":
            wert = self.clamp_importance(int(target)) if str(target).isdigit() else 0
            with self.item_change(kennungen, restore=False, local=True) as change:
                for item in items:
                    if self.clamp_importance(item.get("importance", 0)) != wert:
                        item["importance"] = wert
                        change.mark()
            return bool(change.changed and change.saved is not False), None
        if field == "eisenhower":
            # D13/D02: nur Wichtigkeit oder Bearbeitungstag ändern sich; eine
            # Fälligkeit nie. Was nicht geht, bleibt unverändert und sagt warum.
            heute = date.today()
            plaene, gruende = [], []
            for item in items:
                felder, grund = glide_eisenhower.aenderung(item, target, heute)
                if felder is None:
                    gruende.append(grund)
                else:
                    plaene.append((item, felder))
            if not plaene:
                return False, gruende[0] if gruende else None
            with self.item_change([item["id"] for item, _felder in plaene], restore=False, local=True) as change:
                for item, felder in plaene:
                    for key, value in felder.items():
                        if item.get(key) != value:
                            item[key] = value
                            change.mark()
            geaendert = bool(change.changed and change.saved is not False)
            if geaendert:
                teile = []
                for key, value in next((felder for _item, felder in plaene if felder), {}).items():
                    teile.append(f"Wichtigkeit {self.IMPORTANCE_NAMES.get(value, value)}" if key == "importance"
                                 else f"Bearbeitungstag {self.format_due_display(value)}")
                self.show_undo_toast("Eingeordnet · " + " · ".join(teile) if teile else "Eingeordnet")
            return geaendert, gruende[0] if gruende else None
        if field == "done":
            erledigt = target == "done"
            offen = [item for item in items if not item.get("done")]
            if erledigt and offen and not self.confirm_complete_blocked(offen):
                return False, None
            with self.item_change(kennungen, restore=False, local=True) as change:
                neu_erledigt = []
                for item in items:
                    if bool(item.get("done")) != erledigt:
                        item["done"] = erledigt
                        change.mark()
                        if erledigt:
                            neu_erledigt.append(item["id"])
                if neu_erledigt:
                    vorgerueckt = self.advance_repeating_items(neu_erledigt)
                    if vorgerueckt:
                        self.book_completions(vorgerueckt)
                        change.mark()
            return bool(change.changed and change.saved is not False), None
        if field == "label":
            bekannt = self.regular_label_ids()
            if target != "none" and target not in bekannt:
                return False, "Dieses Label gibt es nicht mehr."
            with self.item_change(kennungen, restore=False, local=True) as change:
                for item in items:
                    labels = list(item.get("labels", []) or [])
                    if target == "none":
                        # „Ohne Label“ heißt ohne eigenes Label; Artlabels bleiben.
                        neu = [value for value in labels if value not in bekannt]
                    elif source in (None, "none") or source not in labels:
                        neu = labels + [target]
                    else:
                        neu = [target if value == source else value for value in labels]
                    neu = list(dict.fromkeys(neu))
                    if neu != labels:
                        item["labels"] = neu
                        change.mark()
            return bool(change.changed and change.saved is not False), None
        if field == "list":
            ziel = next((entry for entry in self.lists if entry.get("id") == target), None)
            if ziel is None or not self.list_accepts_items(ziel):
                return False, "Diese Seite nimmt keine Aufgaben auf."
            with self.guarded_structural_change("In andere Liste verschieben"):
                with self.item_change((), restore=False, update_sidebar=True) as change:
                    for item_id in kennungen:
                        found = self.find_item_in_lists(item_id)
                        if not found or found[3] is ziel:
                            continue
                        _item, geschwister, index, _quelle = found
                        ziel.setdefault("items", []).append(geschwister.pop(index))
                        change.mark()
            return bool(change.changed and change.saved is not False), None
        return False, None

    def list_group_field(self, list_id=None):
        """Gruppierung der Liste in Listen- und Tabellenansicht – oder None."""
        if self.view_mode not in ("list", self.TABLE_VIEW):
            return None
        list_id = list_id or self.active_list_id
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None or not self.list_accepts_items(entry) or entry.get("list_kind") in ("note", "page"):
            return None
        value = (self.settings.get("list_group_by") or {}).get(list_id)
        return value if value in dict(self.LIST_GROUP_FIELDS) else None

    def set_list_group(self, field, list_id=None):
        list_id = list_id or self.active_list_id
        if not list_id:
            return "break"
        werte = dict(self.settings.get("list_group_by") or {})
        if field in dict(self.LIST_GROUP_FIELDS):
            werte[list_id] = field
        else:
            werte.pop(list_id, None)
        self.settings["list_group_by"] = werte
        self.save_settings()
        self.refresh_tree()
        return "break"

    def table_nested(self, list_id=None):
        list_id = list_id or self.active_list_id
        return (self.settings.get("table_nesting") or {}).get(list_id) == "nested"

    def set_table_nested(self, nested=True, list_id=None):
        list_id = list_id or self.active_list_id
        if not list_id:
            return "break"
        werte = dict(self.settings.get("table_nesting") or {})
        if nested:
            werte[list_id] = "nested"
        else:
            werte.pop(list_id, None)
        self.settings["table_nesting"] = werte
        self.save_settings()
        self.refresh_tree()
        return "break"

    def see_unless_folded(self, iid):
        """Holt eine Zeile ins Bild – außer ihr Abschnitt ist bewusst zugeklappt.

        `Treeview.see` klappt alle Vorfahren auf. Ein zugeklappter Abschnitt
        der Gruppierung ginge sonst bei jedem Neuaufbau wieder auf, sobald die
        Auswahl darin liegt.
        """
        try:
            parent = self.tree.parent(iid)
            while parent:
                if not self.tree.item(parent, "open"):
                    return
                parent = self.tree.parent(parent)
            self.tree.see(iid)
        except tk.TclError:
            pass

    def is_group_section_row(self, iid):
        return isinstance(iid, str) and iid.startswith(self.GROUP_SECTION_PREFIX)

    def group_section_iid(self, key, list_id=None):
        return f"{self.GROUP_SECTION_PREFIX}{list_id or self.active_list_id}:{key}"

    def group_section_key(self, iid):
        return iid.rsplit(":", 1)[1] if self.is_group_section_row(iid) else None

    def group_section_of_row(self, iid):
        """Der Abschnitt, in dem eine Baumzeile steht – oder None."""
        if not iid or not hasattr(self, "tree"):
            return None
        try:
            while iid and not self.is_group_section_row(iid):
                iid = self.tree.parent(iid)
        except tk.TclError:
            return None
        return iid or None

    def grouped_top_entries(self, items=None, heading=None):
        """(Punkt, Zwischenüberschrift) der obersten Punkte – die Überschrift bleibt als Zuordnung erhalten."""
        result = []
        for item in self.items if items is None else items:
            if self.is_heading_item(item):
                result.extend(self.grouped_top_entries(item.get("children", []), item))
            else:
                result.append((item, heading))
        return result

    def list_view_number_paths(self, items=None, prefix=(), result=None):
        """Nummern wie in der ungruppierten Liste: nach jeder Zwischenüberschrift neu, Überschriften ohne Nummer."""
        result = {} if result is None else result
        position = 0
        for item in self.items if items is None else items:
            if self.is_heading_item(item):
                position = 0
                self.list_view_number_paths(item.get("children", []), prefix, result)
                continue
            position += 1
            pfad = list(prefix) + [position]
            if item.get("id"):
                result[item["id"]] = pfad
            self.list_view_number_paths(item.get("children", []), pfad, result)
        return result

    def grouped_top_items(self, items=None):
        """Die obersten Punkte der Gruppierung. Zwischenüberschriften lösen sich auf."""
        result = []
        for item in self.items if items is None else items:
            if self.is_heading_item(item):
                result.extend(self.grouped_top_items(item.get("children", [])))
            else:
                result.append(item)
        return result

    def insert_group_section(self, key, title, count, table=False):
        iid = self.group_section_iid(key)
        offen = iid not in set(self.settings.get("group_sections_closed", []))
        text = f"{title}   ({count})"
        if table:
            columns = list(self.tree.cget("columns"))
            values = [text if column == "title" else "" for column in columns]
            self.tree.insert("", "end", iid=iid, text="", values=values, tags=("group_item",), open=offen)
        else:
            self.tree.insert("", "end", iid=iid, text=text, values=("", "", ""), tags=("group_item",),
                             open=offen)
        return iid

    def insert_grouped_tree_items(self, field):
        """Listenansicht mit Abschnitten je Gruppe (AO-040).

        Die Hierarchie bleibt: Unterpunkte stehen unter ihrem Elternpunkt im
        Abschnitt des Elternpunkts. Ein Punkt mit mehreren Labels steht unter
        seinem ersten – eine Baumzeile gibt es nur einmal.
        """
        spalten = self.group_columns(field)
        faecher = {spalte["key"]: [] for spalte in spalten}
        bekannt = self.regular_label_ids()
        for item, kopf in self.grouped_top_entries():
            schluessel = self.item_group_keys(item, field, known_labels=bekannt)
            if schluessel and schluessel[0] in faecher:
                faecher[schluessel[0]].append((item, kopf))
        eingefuegt = 0
        # Zweiter Ausbau: Jeder Punkt trägt seine Nummer aus der ungruppierten
        # Liste, und Zwischenüberschriften stehen als Trennzeile im Abschnitt.
        self._group_number_paths = self.list_view_number_paths()
        try:
            for position, spalte in enumerate(spalten):
                fach = faecher[spalte["key"]]
                sichtbar = sum(1 for item, _kopf in fach if self.item_visible_by_filter(item))
                if not sichtbar:
                    continue
                abschnitt = self.insert_group_section(spalte["key"], spalte["title"], sichtbar)
                eingefuegt += self.insert_tree_items(abschnitt, [item for item, kopf in fach if kopf is None], [])
                koepfe = []
                for _item, kopf in fach:
                    if kopf is not None and all(kopf is not bekannter for bekannter in koepfe):
                        koepfe.append(kopf)
                for kopf in koepfe:
                    punkte = [item for item, zugehoerig in fach if zugehoerig is kopf]
                    if not any(self.item_visible_by_filter(item) for item in punkte):
                        continue
                    self.tree.insert(abschnitt, "end", iid=f"{kopf.get('id')}{self.GROUP_HEADING_IID_MARKER}{position}",
                                     text=self.item_display_text(kopf), values=("", "", ""), tags=("heading_item",))
                    eingefuegt += self.insert_tree_items(abschnitt, punkte, [])
        finally:
            self._group_number_paths = None
        return eingefuegt

    def note_group_section_state(self, iid):
        if not self.is_group_section_row(iid) or not self.tree.exists(iid):
            return False
        self.remember_tree_open_states()
        return True

    def table_tree_entries(self, items, apply_filters=True):
        """Verschachtelte Tabellenzeilen (AO-030): [(Punkt, passt, Kinder)], je Ebene sortiert.

        Ein Elternpunkt, der selbst nicht passt, bleibt als Zusammenhang stehen,
        sobald ein Unterpunkt passt – abgeschwächt statt versteckt.
        """
        query = self.current_search_query() if apply_filters else ""
        result = []
        for item in self.grouped_top_items(items):
            if not (self.is_schedulable_item(item) or self.is_group_item(item)):
                continue
            kinder = self.table_tree_entries(item.get("children", []), apply_filters)
            passt = self.is_schedulable_item(item) and (not apply_filters or (
                self.item_text_matches_query(item, query) and self.item_matches_status_filter(item)))
            if passt or kinder:
                result.append((item, passt, kinder))
        column, direction = self.table_sort_for_list()
        if column:
            result.sort(key=lambda value: self.table_sort_value(value[0], column)[0], reverse=direction == "desc")
            result.sort(key=lambda value: 1 if self.table_sort_value(value[0], column)[1] else 0)
        return result

    def table_row_tag(self, item):
        importance = self.clamp_importance(item.get("importance", 0))
        due_state = self.due_status(item)
        if item.get("color") in self.ITEM_COLOR_KEYS:
            return f"itemcolor_{item['color']}"
        if item.get("done"):
            return "done"
        if due_state == "overdue":
            return "overdue"
        if due_state == "today":
            return "due_today"
        if importance == 3:
            return "priority_high"
        if importance == 2:
            return "priority_medium"
        return "open"

    def insert_table_rows(self, parent, rows, columns, nested):
        """Fügt Tabellenzeilen ein; `rows` sind (Punkt, passt, Kinder) oder (Reihenfolge, Punkt)."""
        for row in rows:
            if nested:
                item, passt, kinder = row
            else:
                item, passt, kinder = row[1], True, []
            item_id = item.get("id") or uuid.uuid4().hex
            item["id"] = item_id
            tags = (self.table_row_tag(item),) if passt else ("context",)
            offen = item_id not in self.collapsed_item_ids
            # Mit Baumspalte (gruppiert oder verschachtelt) steht dort die
            # Nummer aus der Liste; vorher zeigte die 40 Pixel schmale Spalte
            # den abgeschnittenen Titel ein zweites Mal.
            nummern = getattr(self, "_table_number_paths", None)
            if nummern is not None:
                pfad = nummern.get(item_id)
                text = ".".join(str(teil) for teil in pfad) if pfad else ""
            else:
                text = self.item_display_text(item)
            self.tree.insert(parent, "end", iid=item_id, text=text,
                             values=self.table_column_values(item, columns), tags=tags, open=offen)
            if kinder:
                self.insert_table_rows(item_id, kinder, columns, True)

    def fit_table_columns(self, event=None):
        """Blendet bei schmaler Tabelle ganze Spalten nach TABLE_COLUMN_PRIORITY aus."""
        if self.view_mode != self.TABLE_VIEW or not hasattr(self, "tree"):
            return
        try:
            spalten = [str(spalte) for spalte in self.tree.cget("columns")]
            verfuegbar = event.width if event is not None else self.tree.winfo_width()
            if not spalten or verfuegbar <= 1:
                return
            if "tree" in str(self.tree.cget("show")):
                verfuegbar -= int(self.tree.column("#0", "width"))
            breiten = self.table_widths_for_list()
            rest = verfuegbar - (self.TABLE_TITLE_MIN_VISIBLE if "title" in spalten else 0)
            gewaehlt = {"title"}
            for spalte in self.TABLE_COLUMN_PRIORITY:
                if spalte == "title" or spalte not in spalten:
                    continue
                breite = int(breiten.get(spalte, self.TABLE_COLUMN_DEFAULT_WIDTHS.get(spalte, 120)))
                if breite > rest:
                    break
                gewaehlt.add(spalte)
                rest -= breite
            # Unbekannte Schlüssel (neuere Einstellungsdatei) bleiben sichtbar.
            anzeigen = [spalte for spalte in spalten
                        if spalte in gewaehlt or spalte not in self.TABLE_COLUMN_PRIORITY]
            bisher = [str(spalte) for spalte in self.tree.cget("displaycolumns")]
            if bisher == ["#all"]:
                bisher = spalten
            if anzeigen != bisher:
                self.tree.configure(displaycolumns=anzeigen)
        except (tk.TclError, ValueError, TypeError):
            pass

    def table_heading_of_items(self):
        """Punkt-ID → Zwischenüberschrift seines obersten Vorfahren (oder None)."""
        result = {}

        def merken(item, kopf):
            if item.get("id"):
                result[item["id"]] = kopf
            for kind in item.get("children", []):
                merken(kind, kopf)

        for item, kopf in self.grouped_top_entries():
            merken(item, kopf)
        return result

    def fill_table_rows(self, entries, columns):
        """Tabelle mit Gruppen (AO-040) und/oder verschachtelten Unterpunkten (AO-030)."""
        field = self.list_group_field()
        nested = self.table_nested()
        rows = self.table_tree_entries(self.items) if nested else entries
        self._table_number_paths = self.list_view_number_paths() if field or nested else None
        try:
            if not field:
                self.insert_table_rows("", rows, columns, nested)
                return
            self.fill_grouped_table_rows(rows, columns, field, nested)
        finally:
            self._table_number_paths = None

    def fill_grouped_table_rows(self, rows, columns, field, nested):
        """Abschnitte je Gruppe mit Zwischenüberschriften wie in der Liste; sortiert wird darunter."""
        spalten = self.group_columns(field)
        faecher = {spalte["key"]: [] for spalte in spalten}
        bekannt = self.regular_label_ids()
        for row in rows:
            item = row[0] if nested else row[1]
            schluessel = self.item_group_keys(item, field, known_labels=bekannt)
            if schluessel and schluessel[0] in faecher:
                faecher[schluessel[0]].append(row)
        # Eine Spaltensortierung gilt innerhalb jeder Überschrift: `fach` ist
        # schon sortiert, und das Aufteilen nach Überschrift erhält diese
        # Reihenfolge. Die Überschriften selbst stehen wie in der Liste.
        koepfe_von = self.table_heading_of_items()
        listenfolge = []
        for _item, kopf in self.grouped_top_entries():
            if kopf is not None and all(kopf is not bekannter for bekannter in listenfolge):
                listenfolge.append(kopf)
        for position, spalte in enumerate(spalten):
            fach = faecher[spalte["key"]]
            if not fach:
                continue
            abschnitt = self.insert_group_section(spalte["key"], spalte["title"], len(fach), table=True)

            def kopf_von(row):
                return koepfe_von.get((row[0] if nested else row[1]).get("id"))

            self.insert_table_rows(abschnitt, [row for row in fach if kopf_von(row) is None], columns, nested)
            koepfe = [kopf for kopf in listenfolge if any(kopf_von(row) is kopf for row in fach)]
            for kopf in koepfe:
                werte = [self.item_display_text(kopf) if column == "title" else "" for column in columns]
                self.tree.insert(abschnitt, "end", iid=f"{kopf.get('id')}{self.GROUP_HEADING_IID_MARKER}{position}",
                                 text="", values=werte, tags=("heading_item",))
                self.insert_table_rows(abschnitt, [row for row in fach if kopf_von(row) is kopf], columns, nested)

    def group_drop(self, source_id, target_id, dragged_ids):
        """Ziehen zwischen Abschnitten setzt das Feld. Rückgabe: erledigt?"""
        field = self.list_group_field()
        if not field:
            return False
        ziel = self.group_section_of_row(target_id)
        quelle = self.group_section_of_row(source_id)
        if not ziel or ziel == quelle:
            return False
        kennungen = [item_id for item_id in dragged_ids if self.find_item(item_id)]
        _geaendert, grund = self.set_group_value(kennungen, field, self.group_section_key(ziel),
                                                 self.group_section_key(quelle))
        if grund:
            self.show_info("Gruppieren", grund)
        return True

    def group_menu_entries(self):
        """Menüeinträge „Gruppieren nach“ für Menüleiste und Listenmenü."""
        return tuple([("Gruppieren: aus", lambda: self.set_list_group(None), "", "grouping.none")]
                     + [(f"Gruppieren: {name}", lambda value=key: self.set_list_group(value), "", "grouping." + key)
                        for key, name in self.LIST_GROUP_FIELDS])

    # -----------------------------
    # Eingebetteter Detailbereich (3.30, MO-030)
    # -----------------------------
    # Zuschaltbar (E-04), rechts neben Liste oder Tabelle. Unter 980 Pixel
    # Fensterbreite bleibt es bei der Punktmaske. Jede Änderung läuft über
    # `item_change` und ist ein Rückgängig-Schritt; übernommen wird beim
    # Verlassen eines Felds, mit Enter oder vor dem Wechsel der Auswahl – so
    # geht keine Eingabe verloren.
    DETAIL_PANE_MIN_WINDOW = 980
    DETAIL_PANE_WIDTH_DEFAULT = 360
    DETAIL_PANE_WIDTH_RANGE = (280, 640)

    def detail_pane_enabled(self):
        return self.settings.get("detail_pane") is True

    def detail_pane_width(self):
        wert = self.settings.get("detail_pane_width")
        unten, oben = self.DETAIL_PANE_WIDTH_RANGE
        if isinstance(wert, int) and not isinstance(wert, bool):
            return max(unten, min(oben, wert))
        return self.DETAIL_PANE_WIDTH_DEFAULT

    def toggle_detail_pane(self, event=None):
        self.commit_detail_pane()
        self.settings["detail_pane"] = not self.detail_pane_enabled()
        self.save_settings()
        self.sync_detail_pane(force=True)
        return "break"

    def detail_pane_applicable(self):
        if not self.detail_pane_enabled() or self.view_mode not in ("list", self.TABLE_VIEW):
            return False
        werkstatt = getattr(self, "workspace", None)
        if werkstatt is not None and werkstatt.visible:
            return False
        eintrag = self.current_list() if self.lists else None
        if not eintrag or not self.list_accepts_items(eintrag) or eintrag.get("list_kind") in ("note", "page"):
            return False
        try:
            return self.root.winfo_width() >= self.DETAIL_PANE_MIN_WINDOW
        except tk.TclError:
            return False

    def detail_pane_item(self):
        item_id = self.get_selected_item_id()
        found = self.find_item(item_id) if item_id else None
        return found[0] if found and self.is_schedulable_item(found[0]) else None

    def detail_pane_has_focus(self):
        fokus = self.current_focus_widget()
        pane = getattr(self, "detail_pane", None)
        return fokus is not None and pane is not None and str(fokus).startswith(str(pane))

    def build_detail_pane_shell(self):
        parent = self.list_frame_outer.inner
        self.detail_sash = tk.Frame(parent, width=6, cursor="sb_h_double_arrow", bg=self.theme["line"])
        self.detail_pane = tk.Frame(parent, bg=self.theme["card"], width=self.detail_pane_width())
        self.detail_pane.pack_propagate(False)
        self.detail_sash.bind("<ButtonPress-1>", self._detail_sash_press)
        self.detail_sash.bind("<B1-Motion>", self._detail_sash_drag)
        self.detail_sash.bind("<ButtonRelease-1>", self._detail_sash_release)
        self._detail_state = {"item_id": None, "fields": {}, "signature": None}

    def _detail_sash_press(self, event):
        self._detail_drag = (event.x_root, self.detail_pane.winfo_width())
        return "break"

    def _detail_sash_drag(self, event):
        start = getattr(self, "_detail_drag", None)
        if not start:
            return "break"
        unten, oben = self.DETAIL_PANE_WIDTH_RANGE
        breite = max(unten, min(oben, start[1] - (event.x_root - start[0])))
        self.detail_pane.configure(width=breite)
        self._detail_pending_width = int(breite)
        return "break"

    def _detail_sash_release(self, event):
        if getattr(self, "_detail_drag", None):
            self._detail_drag = None
            breite = getattr(self, "_detail_pending_width", None)
            if breite is not None:
                self.settings["detail_pane_width"] = breite
                self.save_settings()
        return "break"

    def sync_detail_pane(self, force=False):
        """Zeigt, versteckt oder füllt den Detailbereich passend zur Auswahl."""
        if not hasattr(self, "list_frame_outer"):
            return
        pane = getattr(self, "detail_pane", None)
        if not self.detail_pane_applicable():
            if pane is not None and pane.winfo_manager():
                self.commit_detail_pane()
                pane.pack_forget()
                self.detail_sash.pack_forget()
                self._detail_state.update(item_id=None, signature=None)
            return
        if pane is None:
            self.build_detail_pane_shell()
            pane = self.detail_pane
        if not pane.winfo_manager():
            pane.configure(width=self.detail_pane_width(), bg=self.theme["card"])
            self.detail_sash.configure(bg=self.theme["line"])
            pane.pack(side="right", fill="y", before=self.list_frame)
            self.detail_sash.pack(side="right", fill="y", before=self.list_frame)
        item = self.detail_pane_item()
        state = self._detail_state
        signatur = (item.get("id") if item else None,
                    json.dumps(item, sort_keys=True, default=str) if item else None,
                    tuple(sorted(self.theme.items())))
        if not force and state["signature"] == signatur:
            return
        if not force and item is not None and state["item_id"] == item.get("id") and self.detail_pane_has_focus():
            # Während jemand tippt, baut der Bereich nicht neu auf.
            state["signature"] = signatur
            return
        if state["item_id"] and (item is None or state["item_id"] != item.get("id")):
            self.commit_detail_pane()
            item = self.detail_pane_item()
        self.render_detail_pane(item)
        state["signature"] = (item.get("id") if item else None,
                              json.dumps(item, sort_keys=True, default=str) if item else None,
                              tuple(sorted(self.theme.items())))

    def render_detail_pane(self, item):
        """Alle Felder des Punkts außer den Anhängen – seit dem Ausbau 3.30 vollständig.

        Der Bereich scrollt, sobald er höher als das Fenster wird. Jede
        Übernahme ist ein Rückgängig-Schritt; die Anhänge bleiben in der Maske,
        weil sie Dateien anfassen.
        """
        pane = self.detail_pane
        theme = self.theme
        state = self._detail_state
        vorher = state.get("canvas")
        position = 0.0
        if item is not None and state.get("item_id") == item.get("id") and vorher is not None:
            try:
                position = vorher.yview()[0]
            except tk.TclError:
                position = 0.0
        for kind in pane.winfo_children():
            kind.destroy()
        state["fields"] = {}
        state["item_id"] = item.get("id") if item else None
        state["canvas"] = None
        breite = self.detail_pane_width() - 40
        if item is None:
            inhalt = tk.Frame(pane, bg=theme["card"])
            inhalt.pack(fill="both", expand=True, padx=14, pady=12)
            tk.Label(inhalt, text="Einen Punkt auswählen, um ihn hier zu bearbeiten.", bg=theme["card"],
                     fg=theme["muted"], font=app_font(10), wraplength=breite,
                     justify="left", anchor="w").pack(fill="x")
            return

        leinwand = tk.Canvas(pane, bg=theme["card"], highlightthickness=0, bd=0)
        leiste = ThemedAutoScrollbar(pane, bg_color=theme["card"], track_color=theme["card"],
                                     thumb_color=theme["input_border"], active_thumb_color=theme["muted"],
                                     width=10, radius=5)
        leiste.configure(height=1)
        leiste.pack(side="right", fill="y", pady=8)
        leinwand.pack(side="left", fill="both", expand=True)
        leiste.set_command(leinwand.yview)
        leinwand.configure(yscrollcommand=leiste.set)
        huelle = tk.Frame(leinwand, bg=theme["card"])
        fenster = leinwand.create_window((0, 0), window=huelle, anchor="nw")

        def anpassen(_event=None):
            try:
                leinwand.configure(scrollregion=leinwand.bbox("all"))
                leinwand.itemconfigure(fenster, width=leinwand.winfo_width())
            except tk.TclError:
                pass
        huelle.bind("<Configure>", anpassen)
        leinwand.bind("<Configure>", anpassen)
        state["canvas"] = leinwand
        inhalt = tk.Frame(huelle, bg=theme["card"])
        inhalt.pack(fill="both", expand=True, padx=14, pady=12)

        def ueberschrift(text):
            tk.Label(inhalt, text=text, bg=theme["card"], fg=theme["muted"], font=app_font(8, "bold"),
                     anchor="w").pack(fill="x", pady=(10, 2))

        def eingabe(parent, wert, schrift=app_font(11)):
            feld = tk.Entry(parent, font=schrift, bg=theme["input"], fg=theme["text"],
                            insertbackground=theme["text"], relief="flat", highlightthickness=1,
                            highlightbackground=theme["input_border"], highlightcolor=theme["selection"])
            feld.insert(0, "" if wert is None else str(wert))
            feld.bind("<FocusOut>", lambda _event: self.commit_detail_pane())
            feld.bind("<Return>", lambda _event: self.commit_detail_pane() or "break")
            return feld

        def hinweis(text):
            tk.Label(inhalt, text=text, bg=theme["card"], fg=theme["muted"], font=app_font(9), anchor="w",
                     justify="left", wraplength=breite).pack(fill="x", pady=(2, 0))

        if self.item_kind(item) == self.ITEM_KIND_LONG:
            # Ein Langtext darf eigene Zeilenumbrüche tragen – wie in der Maske.
            titel = tk.Text(inhalt, height=3, wrap="word", font=app_font(12, "bold"), bg=theme["input"],
                            fg=theme["text"], insertbackground=theme["text"], relief="flat",
                            highlightthickness=1, highlightbackground=theme["input_border"],
                            highlightcolor=theme["selection"], padx=6, pady=4)
            titel.insert("1.0", item.get("text", ""))
            titel.bind("<FocusOut>", lambda _event: self.commit_detail_pane())
        else:
            titel = eingabe(inhalt, item.get("text", ""), app_font(12, "bold"))
        titel.pack(fill="x")
        state["fields"]["text"] = titel
        zeile = tk.Frame(inhalt, bg=theme["card"])
        zeile.pack(fill="x", pady=(8, 0))
        erledigt = self._make_dialog_button(
            zeile, f"{self.ICONS['check']} Erledigt" if item.get("done") else "Erledigen",
            lambda value=item["id"]: self.toggle_detail_pane_done(value),
            "confirm" if not item.get("done") else "muted", width=120, height=32)
        erledigt.pack(side="left")
        wichtigkeit = tk.StringVar(value=self.IMPORTANCE_NAMES.get(self.clamp_importance(item.get("importance", 0)),
                                                                   "keine"))
        namen = [self.IMPORTANCE_NAMES.get(value, str(value)) for value in (0, 1, 2, 3)]
        rand, _feld = self._make_option_menu(zeile, wichtigkeit, namen)
        rand.pack(side="left", fill="x", expand=True, padx=(8, 0))
        wichtigkeit.trace_add("write", lambda *_: self.commit_detail_pane())
        state["fields"]["importance"] = wichtigkeit

        ueberschrift("ART · FARBE")
        zeile = tk.Frame(inhalt, bg=theme["card"])
        zeile.pack(fill="x")
        art_namen = {self.ITEM_KIND_NAMES[value]: value for value in self.ITEM_KINDS}
        art = tk.StringVar(value=self.ITEM_KIND_NAMES[self.item_kind(item)])
        rand, _feld = self._make_option_menu(zeile, art, list(art_namen),
                                             option_colors={name: self.kind_color_key(value)
                                                            for name, value in art_namen.items()})
        rand.pack(side="left", fill="x", expand=True)
        farb_namen = {"Keine Farbe": None, **{name: key for name, key in self.ITEM_COLOR_CHOICES}}
        farbe = tk.StringVar(value=next((name for name, key in self.ITEM_COLOR_CHOICES if key == item.get("color")),
                                        "Keine Farbe"))
        rand, _feld = self._make_option_menu(zeile, farbe, list(farb_namen),
                                             option_colors={name: key for name, key in self.ITEM_COLOR_CHOICES})
        rand.pack(side="left", fill="x", expand=True, padx=(8, 0))
        art.trace_add("write", lambda *_: self.detail_pane_kind_changed())
        farbe.trace_add("write", lambda *_: self.commit_detail_pane())
        state["fields"]["kind"] = (art, art_namen)
        state["fields"]["color"] = (farbe, farb_namen)

        ueberschrift("FÄLLIG")
        faellig = DueField(inhalt, self, due=item.get("due"), due_time=item.get("due_time"), compact=True)
        faellig.pack(fill="x")
        state["fields"]["due"] = faellig

        ueberschrift("WIEDERHOLUNG")
        regel = self.normalize_repeat(item.get("repeat")) or {}
        wiederholungs_namen = {label: key for label, key in self.REPEAT_CHOICES}
        wiederholung = tk.StringVar(value=next((label for label, key in self.REPEAT_CHOICES
                                                if key == regel.get("art", self.REPEAT_NONE)),
                                               self.REPEAT_CHOICES[0][0]))
        wiederholungs_rand, _feld = self._make_option_menu(inhalt, wiederholung, list(wiederholungs_namen))
        wiederholungs_rand.pack(fill="x")
        zusatz = tk.Frame(inhalt, bg=theme["card"])
        abstand_zeile = tk.Frame(zusatz, bg=theme["card"])
        tk.Label(abstand_zeile, text=f"Alle wie viele Tage (1 bis {self.REPEAT_MAX_INTERVAL})", bg=theme["card"],
                 fg=theme["muted"], font=app_font(9), anchor="w").pack(fill="x")
        abstand = eingabe(abstand_zeile, regel.get("abstand", 2))
        abstand.pack(fill="x")
        tage_zeile = tk.Frame(zusatz, bg=theme["card"])
        gewaehlt = set(regel.get("tage", []))
        tage = [tk.BooleanVar(value=index in gewaehlt) for index in range(7)]
        for index, name in enumerate(self.REPEAT_WEEKDAY_NAMES):
            tk.Checkbutton(tage_zeile, text=name, variable=tage[index], command=self.commit_detail_pane,
                           bg=theme["card"], fg=theme["text"], activebackground=theme["card"],
                           activeforeground=theme["text"], selectcolor=theme["input"],
                           font=app_font(10)).grid(row=index // 4, column=index % 4, sticky="w", padx=(0, 6))
        ende_zeile = tk.Frame(zusatz, bg=theme["card"])
        tk.Label(ende_zeile, text="Endet am (leer: kein Ende)", bg=theme["card"], fg=theme["muted"],
                 font=app_font(9), anchor="w").pack(fill="x")
        ende = eingabe(ende_zeile, self.format_due_display(regel.get("ende") or ""))
        ende.pack(fill="x")
        # KO02 (3.33.20): derselbe Weg wie im Kontextmenü, nur für eine
        # gespeicherte Regel mit Termin. Offene Eingaben gehen vorher ein.
        ueberspringen = None
        if regel and self.normalize_due(item.get("due")) and not item.get("done"):
            ueberspringen = self._make_dialog_button(
                zusatz, "Diesen Termin überspringen",
                lambda iid=item["id"]: (self.commit_detail_pane(), self.skip_repeat_occurrences([iid])),
                "muted", width=220, height=30)
            self.add_tooltip(ueberspringen, "Zum nächsten Termin, ohne zu erledigen")

        def zusatz_zeigen(*_args):
            wahl = wiederholungs_namen.get(wiederholung.get(), self.REPEAT_NONE)
            for teil in (abstand_zeile, tage_zeile, ende_zeile, ueberspringen):
                if teil is not None:
                    teil.pack_forget()
            if wahl == self.REPEAT_NONE:
                zusatz.pack_forget()
                return
            zusatz.pack(fill="x", pady=(6, 0), after=wiederholungs_rand)
            if wahl == self.REPEAT_EVERY_N_DAYS:
                abstand_zeile.pack(fill="x", pady=(0, 6))
            elif wahl == self.REPEAT_WEEKDAYS:
                tage_zeile.pack(fill="x", pady=(0, 6))
            ende_zeile.pack(fill="x")
            if ueberspringen is not None and wahl == regel.get("art"):
                ueberspringen.pack(anchor="w", pady=(6, 0))
        zusatz_zeigen()
        wiederholung.trace_add("write", lambda *_: (zusatz_zeigen(), self.commit_detail_pane()))
        state["fields"]["repeat"] = {"art": wiederholung, "namen": wiederholungs_namen, "abstand": abstand,
                                     "tage": tage, "ende": ende}

        ueberschrift("ERINNERUNG")
        erinnerung, lies_erinnerung = self.make_reminder_editor(inhalt, self.root, item)
        self.blend_embedded_editor(erinnerung, theme["card"], breite, hide_label="Benachrichtigung")
        erinnerung.pack(fill="x")
        erinnerung.mode_var.trace_add("write", lambda *_: self.commit_detail_pane())
        state["fields"]["reminder"] = lies_erinnerung

        ueberschrift("BEARBEITUNGSTAG")
        geplant = DueField(inhalt, self, due=item.get("planned_date"), due_time=item.get("planned_time"),
                           compact=True)
        geplant.pack(fill="x")
        state["fields"]["planned"] = geplant
        ueberschrift("AUFWAND IN MINUTEN")
        aufwand = eingabe(inhalt, item.get("estimated_minutes") or "")
        aufwand.pack(fill="x")
        state["fields"]["estimated_minutes"] = aufwand
        ueberschrift("ERFASSTE ZEIT IN MINUTEN")
        erfasst = eingabe(inhalt, item.get("time_spent_minutes") or "")
        erfasst.pack(fill="x")
        state["fields"]["time_spent_minutes"] = erfasst
        ueberschrift("LABELS")
        labels = LabelDropdown(inhalt, self, list(self.labels), selected_ids=list(item.get("labels") or []),
                               allow_create=True, on_change=lambda *_args: self.commit_detail_pane())
        labels.pack(fill="x")
        state["fields"]["labels"] = labels
        ueberschrift("BESCHREIBUNG")
        beschreibung = tk.Text(inhalt, height=6, wrap="word", font=app_font(10), bg=theme["input"],
                               fg=theme["text"], insertbackground=theme["text"], relief="flat",
                               highlightthickness=1, highlightbackground=theme["input_border"],
                               highlightcolor=theme["selection"], padx=6, pady=6)
        beschreibung.insert("1.0", item.get("description") or "")
        beschreibung.bind("<FocusOut>", lambda _event: self.commit_detail_pane())
        beschreibung.pack(fill="x")
        state["fields"]["description"] = beschreibung

        schritte = item.get("checklist") or []
        fortschritt = self.checklist_progress(item)
        ueberschrift(f"CHECKLISTE · {fortschritt['done']} VON {fortschritt['total']}" if schritte else "CHECKLISTE")
        for index, eintrag in enumerate(schritte):
            reihe = tk.Frame(inhalt, bg=theme["card"])
            reihe.pack(fill="x")
            marke = self.ICONS["check"] if eintrag.get("done") else self.ICONS["task_open"]
            schritt = tk.Label(reihe, text=f"{marke}  {eintrag.get('text', '')}", bg=theme["card"],
                               fg=theme["muted"] if eintrag.get("done") else theme["text"],
                               font=app_font(10), anchor="w", cursor="hand2", justify="left",
                               wraplength=breite - 36)
            schritt.pack(side="left", fill="x", expand=True)
            schritt.bind("<Button-1>", lambda _event, value=index, iid=item["id"]:
                         self.toggle_detail_pane_step(iid, value))
            self._make_dialog_button(reihe, "×", lambda value=index, iid=item["id"]:
                                     self.remove_detail_pane_step(iid, value), "muted", width=30, height=24
                                     ).pack(side="right")
        neuer_schritt = tk.Entry(inhalt, font=app_font(10), bg=theme["input"], fg=theme["text"],
                                 insertbackground=theme["text"], relief="flat", highlightthickness=1,
                                 highlightbackground=theme["input_border"], highlightcolor=theme["selection"])
        neuer_schritt.pack(fill="x", pady=(4, 0))

        def schritt_anfuegen(_event=None, iid=item["id"]):
            self.add_detail_pane_step(iid, neuer_schritt.get())
            return "break"
        neuer_schritt.bind("<Return>", schritt_anfuegen)
        hinweis("Schritt eintippen, Enter fügt ihn an.")

        # Anhänge (zweiter Ausbau): damit braucht der Bereich die Maske nicht mehr.
        anhaenge = list(item.get("attachments") or [])
        state["fields"]["attachments"] = [copy.deepcopy(anhang) for anhang in anhaenge]
        ueberschrift(f"ANHÄNGE · {len(anhaenge)}" if anhaenge else "ANHÄNGE")
        for index, anhang in enumerate(anhaenge):
            pfad = self.resolve_attachment_path(anhang)
            vorhanden = bool(pfad) and os.path.isfile(pfad)
            groesse = os.path.getsize(pfad) if vorhanden else anhang.get("size", 0)
            reihe = tk.Frame(inhalt, bg=theme["card"])
            reihe.pack(fill="x")
            eintrag = tk.Label(reihe, text=f"{self.ICONS['attachment']}  {anhang.get('name', 'Anhang')}  ·  "
                                           f"{self.format_file_size(groesse)}"
                                           + ("" if vorhanden else "  ·  nicht gefunden"),
                               bg=theme["card"], fg=theme["text"] if vorhanden else theme["muted"],
                               font=app_font(10), anchor="w", justify="left", cursor="hand2",
                               wraplength=breite - 36)
            eintrag.pack(side="left", fill="x", expand=True)
            eintrag.bind("<Button-1>", lambda _event, value=index: self.open_detail_pane_attachment(value))
            self._make_dialog_button(reihe, "×", lambda value=index: self.remove_detail_pane_attachment(value),
                                     "muted", width=30, height=24).pack(side="right")
        self._make_dialog_button(inhalt, "+ Datei …", self.add_detail_pane_attachments, "muted",
                                 width=170, height=30).pack(anchor="w", pady=(4, 0))

        eigene_id = item["id"]
        index_aller = self.relation_index()
        state["fields"]["links"] = list(item.get("links") or [])
        state["fields"]["blocked_by"] = list(item.get("blocked_by") or [])
        for feld, kopf, knopf, nur_aufgaben, rueck_titel, rueck in (
                ("links", "VERKNÜPFT MIT", "Verknüpfen …", False, "Verweist hierher",
                 self.item_backlinks(eigene_id, index_aller)),
                ("blocked_by", "WARTET AUF", "Voraussetzung …", True, "Darauf warten",
                 self.item_dependents(eigene_id, index_aller))):
            ueberschrift(kopf)
            for ziel in state["fields"][feld]:
                paar = index_aller.get(ziel)
                text = self.relation_label(paar[1], index_aller) if paar else "(im Papierkorb)"
                if paar and feld == "blocked_by" and paar[1].get("done"):
                    text = f"{self.ICONS['check']} {text}"
                reihe = tk.Frame(inhalt, bg=theme["card"])
                reihe.pack(fill="x")
                tk.Label(reihe, text=text, bg=theme["card"], fg=theme["text"], font=app_font(10), anchor="w",
                         justify="left", wraplength=breite - 36).pack(side="left", fill="x", expand=True)
                self._make_dialog_button(reihe, "×", lambda f=feld, z=ziel: self.remove_detail_pane_relation(f, z),
                                         "muted", width=30, height=24).pack(side="right")
            self._make_dialog_button(inhalt, f"+ {knopf}",
                                     lambda f=feld, t=nur_aufgaben, k=knopf, h=kopf.capitalize():
                                     self.add_detail_pane_relation(f, t, k, h),
                                     "muted", width=170, height=30).pack(anchor="w", pady=(4, 0))
            if rueck:
                hinweis(rueck_titel + ": " + "; ".join(self.relation_label(punkt, index_aller)
                                                       for _eintrag, punkt in rueck[:6]))

        self.detail_status = tk.Label(inhalt, text="", bg=theme["card"], fg=theme["delete"], font=app_font(9),
                                      anchor="w", wraplength=breite, justify="left")
        self.detail_status.pack(fill="x", pady=(8, 0))
        self._make_dialog_button(inhalt, "Alle Felder …", lambda value=item["id"]: self.open_full_item_mask(value),
                                 "muted", width=140, height=32).pack(anchor="w", pady=(6, 0))
        for feld in (faellig, geplant):
            for kind in (feld.date_entry, getattr(feld, "time_entry", None)):
                if kind is not None:
                    kind.bind("<FocusOut>", lambda _event: self.commit_detail_pane(), add="+")
                    kind.bind("<Return>", lambda _event: self.commit_detail_pane() or "break", add="+")
        for kind in self.iter_descendants(erinnerung):
            if isinstance(kind, tk.Entry):
                kind.bind("<FocusOut>", lambda _event: self.commit_detail_pane(), add="+")
        # Mausrad über dem ganzen Bereich; Textfelder behalten ihr eigenes.
        self.bind_mousewheel(leinwand)
        for kind in self.iter_descendants(huelle):
            if not isinstance(kind, tk.Text):
                self.bind_mousewheel(kind, leinwand)
        if position:
            leinwand.after_idle(lambda: leinwand.winfo_exists() and leinwand.yview_moveto(position))

    @staticmethod
    def iter_descendants(widget):
        stapel = list(widget.winfo_children())
        while stapel:
            aktuell = stapel.pop()
            yield aktuell
            stapel.extend(aktuell.winfo_children())

    def blend_embedded_editor(self, block, bg, wraplength, hide_label=None):
        """Passt einen Maskenbaustein an eine Fläche mit anderem Hintergrund und schmaler Breite an."""
        for kind in [block, *self.iter_descendants(block)]:
            try:
                if isinstance(kind, (tk.Frame, tk.Label, tk.Checkbutton)) and kind.cget("bg") == self.theme["bg"]:
                    kind.configure(bg=bg)
                    if isinstance(kind, tk.Checkbutton):
                        kind.configure(activebackground=bg)
                if isinstance(kind, tk.Label) and int(float(kind.cget("wraplength") or 0)) > wraplength:
                    kind.configure(wraplength=wraplength)
                if hide_label and isinstance(kind, tk.Label) and kind.cget("text") == hide_label:
                    kind.pack_forget()
                    hide_label = None
            except (tk.TclError, ValueError):
                pass

    def detail_pane_kind_changed(self):
        """Artwechsel im Bereich – zu Gruppe oder Überschrift erst nach Rückfrage.

        Gruppen und Überschriften tragen keine Planung; der Wechsel nimmt dem
        Punkt Fälligkeit, Wiederholung, Erinnerung und Checkliste. In der
        Maske sieht man das vor dem Bestätigen, hier wirkt die Wahl sofort.
        """
        state = self._detail_state
        felder = state.get("fields") or {}
        found = self.find_item_in_lists(state.get("item_id"))
        if "kind" not in felder or not found:
            return
        variable, namen = felder["kind"]
        neu = namen.get(variable.get(), self.ITEM_KIND_TASK)
        punkt = found[0]
        planung = any(punkt.get(feld) for feld in ("due", "repeat", "reminder", "planned_date", "estimated_minutes",
                                                   "checklist", "blocked_by", "time_spent_minutes"))
        if neu in (self.ITEM_KIND_GROUP, self.ITEM_KIND_HEADING) and planung and not self.ask_yes_no(
                "Art ändern", f"Als {self.ITEM_KIND_NAMES[neu]} verliert der Punkt Fälligkeit, Planung, "
                "Wiederholung, Erinnerung und Checkliste. Trotzdem ändern?\n\nRückgängig bleibt möglich."):
            variable.set(self.ITEM_KIND_NAMES[self.item_kind(punkt)])
            return
        self.commit_detail_pane()

    def read_repeat_rule(self, art, abstand_text, tage, ende_text):
        """Wiederholungsregel aus Maskenwerten; (Regel, Fehlertext). Maske und Detailbereich teilen sie."""
        if art == self.REPEAT_NONE:
            return None, None
        regel = {"art": art}
        if art == self.REPEAT_EVERY_N_DAYS:
            roh = str(abstand_text).strip()
            if not roh.isdigit() or not 1 <= int(roh) <= self.REPEAT_MAX_INTERVAL:
                return None, ("Bitte für „alle N Tage\" eine Zahl von 1 bis "
                              f"{self.REPEAT_MAX_INTERVAL} eingeben.")
            regel["abstand"] = int(roh)
        elif art == self.REPEAT_WEEKDAYS:
            if not tage:
                return None, "Bitte mindestens einen Wochentag auswählen."
            regel["tage"] = list(tage)
        rohes_ende = str(ende_text).strip()
        if rohes_ende:
            geparst = self.parse_due_input(rohes_ende)
            if not geparst:
                return None, "Bitte für das Enddatum ein gültiges Datum eingeben, etwa 31.12.2026."
            regel["ende"] = geparst
        return regel, None

    def add_relation_targets(self, own_id, field, current, chosen, index):
        """Hängt gewählte Punkte an; „wartet auf“ lehnt Kreise ab. Liefert (neu, abgelehnt)."""
        neu, abgelehnt = list(current), []
        for target in chosen:
            if field == "blocked_by" and own_id and self.dependency_creates_cycle(own_id, target, index):
                abgelehnt.append(target)
                continue
            if target not in neu:
                neu.append(target)
        return neu[:self.MAX_ITEM_REFERENCES], abgelehnt

    def add_detail_pane_relation(self, field, only_tasks, button_text, heading):
        state = self._detail_state
        own_id = state.get("item_id")
        if not own_id:
            return "break"
        self.commit_detail_pane()
        aktuell = list(state["fields"].get(field) or [])
        gewaehlt = self.choose_items_dialog(button_text.rstrip(" …"), heading, exclude_ids=[own_id] + aktuell,
                                            only_tasks=only_tasks)
        if not gewaehlt:
            return "break"
        neu, abgelehnt = self.add_relation_targets(own_id, field, aktuell, gewaehlt, self.item_index())
        if abgelehnt:
            self.show_warning("Abhängigkeit abgelehnt", "Mindestens eine Voraussetzung wartet selbst "
                              "auf diesen Punkt. Die Punkte würden dann aufeinander warten.")
        state["fields"][field] = neu
        self.commit_detail_pane()
        self.sync_detail_pane(force=True)
        return "break"

    def add_detail_pane_attachments(self):
        """Dateien anhängen: als lokale Kopie ablegen, dann wie jedes Feld übernehmen."""
        state = self._detail_state
        if not state.get("item_id"):
            return "break"
        self.commit_detail_pane()
        pfade = filedialog.askopenfilenames(title="Dateien oder Bilder anhängen", parent=self.root)
        if not pfade:
            return "break"
        # Abgelegt wird eine Kopie mit eigenem Pfad; dieselbe Datei erkennt man
        # deshalb an Name und Größe, nicht am Ursprungspfad.
        def merkmal(name, pfad):
            try:
                return name, os.path.getsize(pfad)
            except (OSError, TypeError):
                return name, None
        bekannt = {merkmal(anhang.get("name"), self.resolve_attachment_path(anhang))
                   for anhang in state["fields"].get("attachments") or []}
        neu = []
        for pfad in pfade:
            kennzeichen = merkmal(os.path.basename(pfad), pfad)
            if kennzeichen not in bekannt:
                bekannt.add(kennzeichen)
                neu.append({"name": os.path.basename(pfad), "pending_path": pfad})
        gespeichert = self._store_pending_attachments(neu) if neu else []
        if gespeichert is None:
            return "break"
        state["fields"]["attachments"] = list(state["fields"].get("attachments") or []) + gespeichert
        self.commit_detail_pane()
        self.sync_detail_pane(force=True)
        return "break"

    def remove_detail_pane_attachment(self, index):
        """Nimmt den Anhang vom Punkt; die Datei bleibt für Rückgängig und ältere Backups liegen."""
        state = self._detail_state
        anhaenge = list(state.get("fields", {}).get("attachments") or [])
        if not state.get("item_id") or not 0 <= index < len(anhaenge):
            return "break"
        anhaenge.pop(index)
        state["fields"]["attachments"] = anhaenge
        self.commit_detail_pane()
        self.sync_detail_pane(force=True)
        return "break"

    def open_detail_pane_attachment(self, index):
        anhaenge = (self._detail_state.get("fields") or {}).get("attachments") or []
        if not 0 <= index < len(anhaenge):
            return "break"
        pfad = self.resolve_attachment_path(anhaenge[index])
        if pfad and os.path.isfile(pfad):
            self.open_external_path(pfad)
        else:
            self.show_warning("Anhang nicht gefunden", "Die Datei ist in der Datenablage nicht verfügbar.")
        return "break"

    def remove_detail_pane_relation(self, field, target):
        state = self._detail_state
        if not state.get("item_id"):
            return "break"
        state["fields"][field] = [entry for entry in state["fields"].get(field) or [] if entry != target]
        self.commit_detail_pane()
        self.sync_detail_pane(force=True)
        return "break"

    def add_detail_pane_step(self, item_id, text):
        text = " ".join(str(text).split())[:self.MAX_CHECKLIST_TEXT]
        if not text:
            return False
        self.commit_detail_pane()
        found = self.find_item_in_lists(item_id)
        if not found:
            return False
        schritte = list(found[0].get("checklist") or [])
        if len(schritte) >= self.MAX_CHECKLIST_ENTRIES:
            self.show_warning("Checkliste", f"Eine Checkliste fasst {self.MAX_CHECKLIST_ENTRIES} Schritte. "
                              "Für mehr Struktur eignen sich Unterpunkte.")
            return False
        with self.item_change((), restore=False) as change:
            found[0]["checklist"] = schritte + [{"id": uuid.uuid4().hex, "text": text, "done": False}]
            change.mark()
        self.sync_detail_pane(force=True)
        return True

    def remove_detail_pane_step(self, item_id, index):
        self.commit_detail_pane()
        found = self.find_item_in_lists(item_id)
        if not found or not 0 <= index < len(found[0].get("checklist") or []):
            return "break"
        with self.item_change((), restore=False) as change:
            found[0]["checklist"] = [schritt for position, schritt in enumerate(found[0]["checklist"])
                                     if position != index]
            change.mark()
        self.sync_detail_pane(force=True)
        return "break"

    def detail_pane_values(self, item):
        """Die Felder des Bereichs als Maskenergebnis – oder (None, Fehlertext)."""
        felder = self._detail_state["fields"]
        details = self.item_details_snapshot(item)
        if "text" in felder:
            feld = felder["text"]
            text = (feld.get("1.0", "end-1c") if isinstance(feld, tk.Text) else feld.get()).strip()
            if not text:
                return None, "Der Titel darf nicht leer sein."
            details["text"] = text
        if "importance" in felder:
            namen = {self.IMPORTANCE_NAMES.get(value, str(value)): value for value in (0, 1, 2, 3)}
            details["importance"] = namen.get(felder["importance"].get(), details["importance"])
        if "kind" in felder:
            variable, namen = felder["kind"]
            details["kind"] = namen.get(variable.get(), details["kind"])
        if "color" in felder:
            variable, namen = felder["color"]
            details["color"] = namen.get(variable.get(), details["color"])
        if "due" in felder:
            gelesen, fehler = felder["due"].read()
            if fehler:
                return None, fehler
            details["due"], details["due_time"] = gelesen if gelesen else (None, None)
        if "repeat" in felder:
            teile = felder["repeat"]
            regel, fehler = self.read_repeat_rule(
                teile["namen"].get(teile["art"].get(), self.REPEAT_NONE), teile["abstand"].get(),
                [index for index, variable in enumerate(teile["tage"]) if variable.get()], teile["ende"].get())
            if fehler:
                return None, fehler
            if regel and not details["due"]:
                return None, "Eine Wiederholung braucht ein Fälligkeitsdatum."
            details["repeat"] = regel
        if "reminder" in felder:
            try:
                details["reminder"] = felder["reminder"](details["due"])
            except (ValueError, OverflowError, OSError) as exc:
                return None, str(exc)
        if "planned" in felder:
            gelesen, fehler = felder["planned"].read()
            if fehler:
                return None, fehler
            details["planned_date"], details["planned_time"] = gelesen if gelesen else (None, None)
        if "estimated_minutes" in felder:
            roh = felder["estimated_minutes"].get().strip()
            if roh and not roh.isdigit():
                return None, "Der Aufwand ist eine Zahl in Minuten."
            details["estimated_minutes"] = int(roh) if roh else None
        if "time_spent_minutes" in felder:
            roh = felder["time_spent_minutes"].get().strip()
            if roh and (not roh.isdigit() or int(roh) > self.MAX_TIME_SPENT_MINUTES):
                return None, "Die erfasste Zeit ist eine Zahl in Minuten."
            details["time_spent_minutes"] = int(roh) if roh else None
        if "labels" in felder:
            details["labels"] = felder["labels"].read()
        if "description" in felder:
            details["description"] = felder["description"].get("1.0", "end-1c")
        for feld in ("links", "blocked_by"):
            if feld in felder:
                details[feld] = list(felder[feld])
        if "attachments" in felder:
            details["attachments"] = [copy.deepcopy(anhang) for anhang in felder["attachments"]]
        return details, None

    def item_details_snapshot(self, item):
        """Der Punkt in der Form, die `apply_item_details` erwartet – ohne Änderung."""
        return {
            "text": item.get("text", ""), "kind": self.item_kind(item),
            "importance": item.get("importance", 0), "color": item.get("color"),
            "due": item.get("due"), "due_time": item.get("due_time"),
            "repeat": copy.deepcopy(item.get("repeat")), "labels": list(item.get("labels") or []),
            "description": item.get("description") or "",
            "attachments": copy.deepcopy(item.get("attachments") or []),
            "reminder": copy.deepcopy(item.get("reminder")), "planned_date": item.get("planned_date"),
            "estimated_minutes": item.get("estimated_minutes"),
            "checklist": copy.deepcopy(item.get("checklist") or []),
            "links": list(item.get("links") or []), "blocked_by": list(item.get("blocked_by") or []),
            "planned_time": item.get("planned_time"), "time_spent_minutes": item.get("time_spent_minutes"),
        }

    def commit_detail_pane(self):
        """Übernimmt die Felder des Bereichs in den Punkt – ein Rückgängig-Schritt je Übernahme."""
        state = getattr(self, "_detail_state", None)
        if not state or not state.get("item_id") or not state.get("fields") or getattr(self, "_detail_committing", False):
            return False
        found = self.find_item_in_lists(state["item_id"])
        if not found:
            return False
        item = found[0]
        try:
            details, fehler = self.detail_pane_values(item)
        except tk.TclError:
            return False
        status = getattr(self, "detail_status", None)
        if fehler:
            if status is not None and status.winfo_exists():
                status.configure(text=fehler)
            return False
        if status is not None and status.winfo_exists():
            status.configure(text="")
        self._detail_committing = True
        try:
            # Keine Kennungen übergeben: Die Auswahl bleibt, wo sie gerade ist.
            with self.item_change((), restore=False) as change:
                if self.apply_item_details(item, details):
                    change.mark()
        finally:
            self._detail_committing = False
        if change.changed:
            self._detail_state["signature"] = None
        return bool(change.changed)

    def toggle_detail_pane_done(self, item_id):
        self.commit_detail_pane()
        found = self.find_item_in_lists(item_id)
        if not found:
            return "break"
        item = found[0]
        if not item.get("done") and not self.confirm_complete_blocked([item]):
            return "break"
        with self.item_change([item_id], local=True) as change:
            item["done"] = not item.get("done")
            change.mark()
            if item["done"]:
                vorgerueckt = self.advance_repeating_items([item_id])
                if vorgerueckt:
                    self.book_completions(vorgerueckt)
        self.sync_detail_pane(force=True)
        return "break"

    def toggle_detail_pane_step(self, item_id, index):
        self.commit_detail_pane()
        found = self.find_item_in_lists(item_id)
        if not found or not 0 <= index < len(found[0].get("checklist") or []):
            return "break"
        with self.item_change((), restore=False) as change:
            schritt = found[0]["checklist"][index]
            schritt["done"] = not schritt.get("done")
            change.mark()
        self.sync_detail_pane(force=True)
        return "break"

    def open_full_item_mask(self, item_id):
        """Die vollständige Punktmaske bleibt der Weg zu allen Feldern."""
        self.commit_detail_pane()
        found = self.find_item_in_lists(item_id)
        if not found:
            return "break"
        details = self.themed_item_details_dialog(found[0])
        if details is None:
            return "break"
        with self.item_change((), restore=False) as change:
            if self.apply_item_details(found[0], details):
                change.mark()
        self.sync_detail_pane(force=True)
        return "break"

    # -----------------------------
    # Notiz als Präsentation (3.30, MO-080 – erste Stufe)
    # -----------------------------
    @staticmethod
    def note_slides(document):
        """Folien aus einer Notiz: Jede Überschrift (H1/H2) beginnt eine neue.

        Text vor der ersten Überschrift wird zur Titelfolie. Ohne Überschriften
        ist die ganze Notiz eine Folie.
        """
        text = str((document or {}).get("text") or "")
        kopf_bereiche = [(span["start"], span["end"]) for span in (document or {}).get("spans", []) or []
                         if isinstance(span, dict) and span.get("tag") in ("h1", "h2")]
        folien, titel, zeilen = [], "", []
        position = 0
        for zeile in text.split("\n"):
            ist_kopf = zeile.strip() and any(anfang <= position < ende for anfang, ende in kopf_bereiche)
            if ist_kopf:
                if titel or any(value.strip() for value in zeilen):
                    folien.append((titel, "\n".join(zeilen).strip()))
                titel, zeilen = zeile.strip(), []
            else:
                zeilen.append(zeile)
            position += len(zeile) + 1
        if titel or any(value.strip() for value in zeilen) or not folien:
            folien.append((titel, "\n".join(zeilen).strip()))
        return folien

    def open_print_html(self, html_text, name, titel):
        """Schreibt eine Druckseite in den Temp-Ordner und öffnet sie im Browser.

        Dort druckt man oder sichert als PDF – Glide braucht dafür keine eigene
        PDF-Bibliothek (Druck- und PDF-Ausgabe seit 3.17).
        """
        ziel = os.path.join(tempfile.gettempdir(), f"{name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.html")
        try:
            with open(ziel, "w", encoding="utf-8", newline="\n") as datei:
                datei.write(html_text)
        except OSError as fehler:
            self.show_error(titel, str(fehler))
            return "break"
        self.open_external_path(ziel)
        return "break"

    def build_note_slides_html(self, titel, folien):
        """Notizfolien als Druckseite: je Überschrift eine A4-Seite quer."""
        esc = self.escape_print_text
        zeilen = [
            "<!DOCTYPE html>", '<html lang="de">', "<head>", '<meta charset="utf-8">',
            f"<title>{esc(titel)} · Folien · {APP_NAME}</title>", "<style>",
            "@page { size: A4 landscape; margin: 16mm; }",
            "* { box-sizing: border-box; }",
            "body { margin: 0; font-family: 'DejaVu Sans', 'Helvetica Neue', Arial, sans-serif;"
            " color: #111; background: #fff; }",
            "section.slide { height: 176mm; display: flex; flex-direction: column;"
            " break-after: page; page-break-after: always; }",
            "section.slide:last-of-type { break-after: auto; page-break-after: auto; }",
            "h1 { font-size: 28pt; margin: 0 0 8mm; }",
            "div.text { font-size: 16pt; line-height: 1.45; white-space: pre-wrap; flex: 1; }",
            "footer { font-size: 9pt; color: #555; text-align: right; }",
            "</style>", "</head>", "<body>",
        ]
        for nummer, (kopf, text) in enumerate(folien, 1):
            zeilen.extend([
                '<section class="slide">',
                f"<h1>{esc(kopf or titel)}</h1>",
                f'<div class="text">{esc(text)}</div>',
                f"<footer>Folie {nummer} / {len(folien)} · {esc(titel)}</footer>",
                "</section>",
            ])
        zeilen.extend(["</body>", "</html>"])
        return "\n".join(zeilen)

    def print_note_presentation(self):
        """Die Folien einer Notiz als Druckseite öffnen (MO-080, zweite Stufe)."""
        editor = getattr(self, "rich_note_editor", None)
        if editor is None or not editor.winfo_exists():
            self.show_info("Folien als PDF", "Zuerst eine Notiz öffnen.")
            return "break"
        editor.flush()
        try:
            folien = self.note_slides(editor.document())
        except ValueError:
            return "break"
        return self.open_print_html(self.build_note_slides_html(self.get_display_title(), folien),
                                    "glide_folien", "Folien als PDF")

    def start_note_presentation(self):
        """Blendet über dem Notizeditor eine Folienansicht ein – kein Zusatzfenster."""
        editor = getattr(self, "rich_note_editor", None)
        if editor is None or not editor.winfo_exists():
            self.show_info("Präsentieren", "Zuerst eine Notiz öffnen.")
            return "break"
        editor.flush()
        try:
            folien = self.note_slides(editor.document())
        except ValueError:
            return "break"
        self.end_note_presentation()
        theme = self.theme
        flaeche = tk.Frame(editor, bg=theme["bg"], takefocus=True)
        flaeche.place(x=0, y=0, relwidth=1, relheight=1)
        kopf = tk.Label(flaeche, bg=theme["bg"], fg=theme["text"], font=app_font(26, "bold"), anchor="w",
                        justify="left")
        kopf.pack(fill="x", padx=48, pady=(40, 12))
        inhalt = tk.Label(flaeche, bg=theme["bg"], fg=theme["text"], font=app_font(16), anchor="nw",
                          justify="left")
        inhalt.pack(fill="both", expand=True, padx=48)
        fuss = tk.Label(flaeche, bg=theme["bg"], fg=theme["muted"], font=app_font(10), anchor="e")
        fuss.pack(fill="x", padx=24, pady=(0, 16))
        self._note_presentation = {"frame": flaeche, "slides": folien, "index": 0, "title": kopf,
                                   "body": inhalt, "footer": fuss}
        for sequence, schritt in (("<Right>", 1), ("<Next>", 1), ("<space>", 1), ("<Left>", -1), ("<Prior>", -1)):
            flaeche.bind(sequence, lambda _event, value=schritt: self.note_presentation_step(value))
        flaeche.bind("<Escape>", lambda _event: self.end_note_presentation())
        flaeche.bind("<Configure>", lambda event: inhalt.configure(wraplength=max(200, event.width - 96)))
        self.show_note_slide(0)
        flaeche.focus_set()
        return "break"

    def show_note_slide(self, index):
        zustand = getattr(self, "_note_presentation", None)
        if not zustand:
            return "break"
        folien = zustand["slides"]
        index = max(0, min(len(folien) - 1, index))
        zustand["index"] = index
        titel, text = folien[index]
        zustand["title"].configure(text=titel or str((self.current_list() or {}).get("title") or ""))
        zustand["body"].configure(text=text)
        zustand["footer"].configure(text=f"Folie {index + 1} / {len(folien)} · Pfeiltasten blättern · Escape beendet")
        return "break"

    def note_presentation_step(self, schritt):
        zustand = getattr(self, "_note_presentation", None)
        if not zustand:
            return "break"
        return self.show_note_slide(zustand["index"] + schritt)

    def end_note_presentation(self):
        zustand = getattr(self, "_note_presentation", None)
        self._note_presentation = None
        if zustand and zustand["frame"].winfo_exists():
            zustand["frame"].destroy()
            editor = getattr(self, "rich_note_editor", None)
            if editor is not None and editor.winfo_exists():
                editor.text.focus_set()
        return "break"

    # -----------------------------
    # Startseite direkt anpassen, Angeheftetes (3.30)
    # -----------------------------
    MAX_PINNED_PAGES = 20
    MAX_HOME_FILTER_TILES = 4
    HOME_TILES_330 = ("drawings", "pinned", "filters")

    def pinned_pages(self):
        """Angeheftete, noch vorhandene und nicht archivierte Seiten als (Art, Objekt)."""
        result = []
        for value in self.settings.get("pinned_pages", []) if isinstance(getattr(self, "settings", None), dict) else []:
            if value.get("kind") == "folder":
                holder = self.get_folder(value.get("id"))
                if holder is not None and not self.is_archived_folder(holder.get("id")):
                    result.append(("folder", holder))
            else:
                holder = next((entry for entry in self.lists if entry.get("id") == value.get("id")), None)
                if holder is not None and not self.is_archived_entry(holder):
                    result.append(("list", holder))
        return result

    def is_pinned(self, kind, identity):
        return any(value.get("kind") == kind and value.get("id") == identity
                   for value in self.settings.get("pinned_pages", []))

    def set_pinned(self, kind, identity, pinned=True):
        """Heftet eine Seite an oder löst sie. Ändert keine Liste und keinen Verlauf."""
        list_ids = {entry.get("id") for entry in self.lists}
        folder_ids = {folder.get("id") for folder in self.folders if isinstance(folder, dict)}
        # Gelöschte Seiten verlieren hier ihren Platz; archivierte behalten
        # ihn, damit sie nach dem Zurückholen wieder angeheftet sind.
        pages = [value for value in self.settings.get("pinned_pages", [])
                 if not (value.get("kind") == kind and value.get("id") == identity)
                 and value.get("id") in (folder_ids if value.get("kind") == "folder" else list_ids)]
        if pinned:
            if len(pages) >= self.MAX_PINNED_PAGES:
                self.show_info("Anheften", f"Es lassen sich höchstens {self.MAX_PINNED_PAGES} Seiten anheften.")
                return False
            pages.append({"kind": kind, "id": identity})
        self.settings["pinned_pages"] = pages
        self.save_settings()
        self.update_sidebar_list()
        if self.view_mode == self.HOME_VIEW:
            self.refresh_home()
        return True

    def move_pinned(self, kind, identity, delta):
        pages = list(self.settings.get("pinned_pages", []))
        index = next((position for position, value in enumerate(pages)
                      if value.get("kind") == kind and value.get("id") == identity), None)
        if index is None:
            return False
        target = max(0, min(len(pages) - 1, index + delta))
        if target == index:
            return False
        pages.insert(target, pages.pop(index))
        self.settings["pinned_pages"] = pages
        self.save_settings()
        self.update_sidebar_list()
        return True

    # -----------------------------
    # Abschnitte und Schnellaktionen der Seitenleiste (3.30, AO-020)
    # -----------------------------
    # Drei Abschnitte lassen sich einklappen: Ansichten, Angeheftet und die
    # Listen mit ihren Ordnern. Getrennt bleiben sie wie seit 2.8 nur durch
    # Abstand; ein eingeklappter Abschnitt zeigt eine einzige ruhige Zeile.
    # „Listen und Ordner“ lässt sich seit dem 26.09.2026 nicht mehr einklappen:
    # Der Pfeil neben „+“ verbarg den Hauptinhalt der Leiste und wirkte wie ein
    # Fehler. Ein früher gespeicherter Zustand „zu“ gilt nicht mehr.
    # „pages“ und „lists“ (27.09.2026): Seiten- und Listenbereich klappen mit
    # einem Pfeil vor ihrer Überschrift ein, wie Ordner im Baum. „notes“
    # (29.09.2026) ist der Notizbereich unter den Listen.
    SIDEBAR_SECTIONS = ("views", "pinned", "pages", "lists", "notes", "drawings")
    SIDEBAR_SECTION_ARROWS = {True: "▽", False: "▷"}
    # Abstand zwischen Seiten- und Listenbereich – enger als zum Systembereich.
    SIDEBAR_LISTS_GAP = 10

    def sidebar_section_open(self, key):
        if key not in self.SIDEBAR_SECTIONS:
            return True
        return key not in (self.settings.get("sidebar_sections_closed") or [])

    def set_sidebar_section_open(self, key, offen=True):
        if key not in self.SIDEBAR_SECTIONS:
            return "break"
        zu = [value for value in (self.settings.get("sidebar_sections_closed") or []) if value != key]
        if not offen:
            zu.append(key)
        self.settings["sidebar_sections_closed"] = zu
        self.save_settings()
        self.apply_sidebar_sections()
        return "break"

    def toggle_sidebar_section(self, key):
        return self.set_sidebar_section_open(key, not self.sidebar_section_open(key))

    def apply_sidebar_sections(self):
        """Blendet eingeklappte Abschnitte aus, ohne die Reihenfolge zu verändern."""
        system = getattr(self, "system_listbox", None)
        titelzeile = getattr(self, "sidebar_title_row", None)
        if system is None or titelzeile is None:
            return
        self.apply_sidebar_visibility()
        theme = self.theme
        kopf = getattr(self, "views_collapsed_header", None)
        if kopf is None:
