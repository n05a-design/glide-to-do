    LABEL_COLUMN_WIDTH = 150
    LABEL_COLUMN_MAX_VISIBLE = 1
    LABEL_COLUMN_NAME_MAX_CHARS = 14
    # Symbol vor dem Label in der Liste – wie das Kalendersymbol vor dem Datum.
