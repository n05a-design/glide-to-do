    def drawing_paste_text(self, editor=None, event=None):
        """Eine als Text kopierte Zeichnung (JSON oder Glide-SVG) übernehmen."""
        try:
            text = self.root.clipboard_get()
        except tk.TclError:
            text = ""
        try:
            model, warnings = self.parse_drawing_text(text)
        except glide_drawing.DrawingFormatError as exc:
            self.show_error("Zeichnung einfügen", f"Die Zwischenablage enthält keine gültige Glide-Zeichnung; "
                                                  f"der Bestand ist unverändert.\n\n{exc}")
            return "break"
        entry = self.drawing_entry(editor) if editor is not None else None
        choice = self.drawing_import_preview_dialog(model, "Aus der Zwischenablage", warnings,
                                                    allow_replace=entry is not None,
                                                    current_title=str(entry.get("title", "")) if entry else "")
        if choice == "replace" and entry is not None:
            self.apply_drawing_change(entry, lambda: entry.update(drawing=model.to_document()) or True)
        elif choice == "new":
            folder_id = entry.get("folder_id") if entry else None
            self.create_drawing_from_model(model, "Eingefügte Zeichnung", folder_id)
        return "break"

    def current_drawing_editor(self):
        editor = getattr(self, "drawing_editor", None)
        try:
            if editor is not None and editor.winfo_exists():
                return editor
        except tk.TclError:
            pass
        return None

    def flush_drawing_editor(self):
        editor = self.current_drawing_editor()
        if editor is None:
            return True
        editor._release()
        return editor.flush()

    def store_drawing(self, list_id, document):
        """Autosave einer Zeichnung: Modell übernehmen, atomar speichern.

        Zeichenaktionen legen bewusst keinen globalen Rückgängig-Schritt an; sie
        haben seit 3.30 den eigenen Aktionspuffer des Editors (je Pinselzug, Form
        oder Füllung ein Schritt, höchstens 50). Ein Schreibfehler bleibt im
        Status der Zeichenseite sichtbar, der letzte gültige Dateistand bleibt
        erhalten.
        """
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None or not self.is_drawing_list(entry):
            return False
        document = self.normalize_drawing_document(document, entry.get("title", ""))
        if entry.get("drawing") != document:
            entry["drawing"] = document
            entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
        elif not self.dirty:
            return True
        saved = self.save_items(show_error=False)
        if not saved:
            self.log_error(f"Zeichnung „{entry.get('title', '')}“ konnte nicht gespeichert werden.\n")
        return saved

    def reference_png_path(self, path):
        """Pfad eines PNG für die Referenz: das Bild selbst oder eine Umwandlung."""
        endung = glide_image_preview.extension(path)
        if endung == ".png":
            return path
        if endung in glide_image_preview.VECTOR:
            if not self.previews.reads_svg(self.root):
                raise glide_drawing.DrawingFormatError("SVG braucht Tk 9 (Python 3.14).")
            ziel = os.path.join(tempfile.mkdtemp(prefix="glide-referenz-"),
                                os.path.splitext(os.path.basename(path))[0] + ".png")
            bild = tk.PhotoImage(master=self.root, file=path, format="svg -scaletowidth 1024")
            bild.write(ziel, format="png")
            return ziel
        if endung in glide_image_preview.CONVERTIBLE:
            ziel = self.previews.convert(path) if self.previews.can_convert(path) else None
            if not ziel:
                raise glide_drawing.DrawingFormatError(
                    "Dieses Bildformat lässt sich hier nicht umwandeln. Bitte als PNG speichern.")
            if ziel.endswith(".ppm"):
                # Unter Linux liefert `djpeg` PPM (N08); die Referenz erwartet PNG.
                png = os.path.join(tempfile.mkdtemp(prefix="glide-referenz-"),
                                   os.path.splitext(os.path.basename(path))[0] + ".png")
                tk.PhotoImage(master=self.root, file=ziel).write(png, format="png")
                ziel = png
            return ziel
        if endung in glide_image_preview.NATIVE:
            ziel = os.path.join(tempfile.mkdtemp(prefix="glide-referenz-"),
                                os.path.splitext(os.path.basename(path))[0] + ".png")
            tk.PhotoImage(master=self.root, file=path).write(ziel, format="png")
            return ziel
        raise glide_drawing.DrawingFormatError("Das ist kein unterstütztes Bildformat.")

    def read_reference_png(self, path):
        """Liest ein lokales PNG mit festen Grenzen für Datei- und Bildgröße."""
        size = os.path.getsize(path)
        if size > glide_drawing_image.MAX_REFERENCE_BYTES:
            raise glide_drawing.DrawingFormatError("Das PNG ist größer als 32 MB.")
        with open(path, "rb") as source:
            if source.read(8) != b"\x89PNG\r\n\x1a\n":
                raise glide_drawing.DrawingFormatError("Die Datei ist kein PNG-Bild.")
        image = tk.PhotoImage(master=self.root, file=path, format="png")
        limit = glide_drawing_image.MAX_REFERENCE_DIMENSION
        if max(image.width(), image.height()) > limit:
            raise glide_drawing.DrawingFormatError(
                f"PNG-Referenzen dürfen höchstens {limit} × {limit} Pixel groß sein.")
        return image

    def hide_drawing_chrome(self):
        """Eine Zeichnung braucht weder Eingabezeile, Suche noch Aufgabenbaum.

        Läuft bei jedem Neuaufbau: Andere Aktualisierungswege packen einzelne
        Leisten wieder ein. Gemerkt wird nur die ursprüngliche Anordnung.
        """
        saved = list(getattr(self, "_drawing_saved_chrome", None) or [])
        known = {widget for widget, _options in saved}
        for widget in (self.input_frame, self.search_frame, self.list_frame):
            try:
                if widget.winfo_manager() == "pack":
                    if widget not in known:
                        saved.append((widget, widget.pack_info()))
                    widget.pack_forget()
            except tk.TclError:
                continue
        self._drawing_saved_chrome = saved

    def restore_drawing_chrome(self):
        saved = getattr(self, "_drawing_saved_chrome", None) or []
        self._drawing_saved_chrome = []
        home_saved = getattr(self, "_home_saved_pack", None)
        for widget, options in saved:
            try:
                if not widget.winfo_exists():
                    continue
                options = dict(options)
                if (home_saved and self.list_frame_outer.winfo_manager() != "pack"
                        and options.get("in") is self.content_frame):
                    # Die Startseite hat die Listenoberfläche gerade ausgeblendet.
                    # Bis 3.29 scheiterte das Einpacken dann still, und die
                    # Eingabezeile fehlte bis zum Neustart. Die Leiste gehört in
                    # die Merkliste der Startseite: Eingabe und Suche vor den
                    # Inhaltsbereich, Hinweis und Knopfleisten dahinter.
                    if all(known is not widget for known, _info in home_saved):
                        options.pop("before", None)
                        if widget in (self.input_frame, self.search_frame):
                            index = next((position for position, (known, _info) in enumerate(home_saved)
                                          if known is self.list_frame_outer), len(home_saved))
                            home_saved.insert(index, (widget, options))
                        else:
                            home_saved.append((widget, options))
                    continue
                if widget in (self.input_frame, self.search_frame):
                    # Eingabe und Suche stehen über dem Inhaltsbereich; ohne
                    # „before“ landeten sie nach dem Wiedereinblenden darunter.
                    options["before"] = self.list_frame_outer
                widget.pack(**options)
            except tk.TclError:
                continue

    def sync_drawing_view(self):
        if not hasattr(self, "list_frame"):
            return
        entry = self.current_list() if self.view_mode == "list" else None
        visible = self.is_drawing_list(entry)
        editor = self.current_drawing_editor()
        identity = entry.get("id") if visible else None
        signature = (identity, tuple(sorted(self.theme.items())))
        if editor is not None and (not visible or getattr(self, "_drawing_signature", None) != signature):
            editor._release()
            saved = editor.flush()
            leaving_title = next((value.get("title", "Zeichnung") for value in self.lists
                                  if value.get("id") == editor.list_id), "")
            editor.destroy()
            editor = None
            if not saved and leaving_title:
                # Mit der Fläche verschwände auch ihre Statuszeile. Der Stand
                # liegt bereits im Arbeitsspeicher des Bestands und wird beim
                # nächsten erfolgreichen Speichern mitgeschrieben.
                self.show_warning(
                    "Zeichnung nicht gespeichert",
                    f"Die letzten Änderungen an „{leaving_title}“ konnten nicht in die Datei "
                    "geschrieben werden. Sie bleiben erhalten, solange Glide geöffnet ist, und "
                    "werden beim nächsten erfolgreichen Speichern mitgeschrieben. Bitte den "
                    "Datenordner prüfen.")
        self.drawing_editor = editor
        if not visible:
            if not self.is_gallery_list(entry):
                self.restore_drawing_chrome()
            return
        self.hide_drawing_chrome()
        if editor is None:
            self._drawing_signature = signature
            try:
                editor = DrawingEditor(self.list_frame_outer.inner, self, entry,
                                       on_change=lambda document, lid=identity: self.store_drawing(lid, document))
            except glide_drawing.DrawingFormatError as exc:
                self.show_error("Zeichnung", f"Die Zeichnung kann nicht angezeigt werden:\n{exc}")
                return
            editor.pack(fill="both", expand=True, padx=self.CONTENT_INSET, pady=self.CONTENT_INSET[0])
            self.drawing_editor = editor
        elif not editor.has_pending_changes():
            reference = entry.get("drawing_reference")
            key = None if not isinstance(reference, dict) else (
                reference.get("attachment_id"), reference.get("mode"), reference.get("zoom_percent"),
                reference.get("offset_x"), reference.get("offset_y"))
            if entry.get("drawing") != editor._last_document or key != editor.reference_key:
                editor.reload(entry)
        folder = self.get_folder(entry.get("folder_id")) if entry.get("folder_id") else None
        if folder and folder.get("folder_kind") == "journal":
            self.sync_note_date_header(entry, before=editor)

    def gallery_cache_dir(self):
        """Vorschaubilder der Galerie – im Cache des Systems, nicht im Datenordner."""
        if sys.platform == "darwin":
            basis = os.path.expanduser("~/Library/Caches/Glide")
        elif os.name == "nt":
            basis = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"), "Glide", "Cache")
        else:
            basis = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "glide")
        if os.environ.get("GLIDE_TEST_MODE"):
            basis = os.path.join(BASE_DIR, "cache")
        return os.path.join(basis, "galerie")

    @property
    def previews(self):
        """Gemeinsamer Vorschau-Zwischenspeicher für Galerie und Seitenbilder (Tk 9)."""
        cache = getattr(self, "_previews", None)
        if cache is None:
            cache = self._previews = glide_image_preview.PreviewCache(self.gallery_cache_dir)
        return cache

    def file_drop_support(self):
        """Lädt tkdnd aus `vendor/tkinterdnd2` einmal; False, wenn es fehlt oder nicht lädt.

        Entscheidung des Nutzers vom 27.09.2026: Bilder aus Finder und Explorer
        sollen sich schon jetzt hineinziehen lassen. tkinterdnd2 0.6.3 (MIT)
        liegt deshalb im Projekt (`vendor/provenance.json`). Fehlt der Ordner
        oder passt die Bibliothek nicht zum System, bleibt „Bilder hinzufügen …“.
        """
        if getattr(self, "_file_drop", None) is not None:
            return self._file_drop
        self._file_drop = False
        self._file_drop_error = ""
        if os.environ.get("GLIDE_NO_FILE_DROP"):
            return False
        vendor = os.path.join(_GLIDE_SOURCE_DIR, "vendor")
        if os.path.isdir(os.path.join(vendor, "tkinterdnd2")) and vendor not in sys.path:
            sys.path.insert(1, vendor)
        # Kein __pycache__ neben dem Paket: Der Ordner liegt im synchronisierten
        # Ablageordner und im signierten Bundle.
        vorher = sys.dont_write_bytecode
        sys.dont_write_bytecode = True
        try:
            from tkinterdnd2 import TkinterDnD, DND_FILES
            TkinterDnD._require(self.root)
        except Exception as exc:  # ImportError, RuntimeError, TclError, OSError
            self._file_drop_error = str(exc)
            return False
        finally:
            sys.dont_write_bytecode = vorher
        self._dnd_files_type = DND_FILES
        self._file_drop = True
        return True

    def register_file_drop(self, widget, callback):
        """Macht `widget` zum Ziel für Dateien aus Finder/Explorer; `callback(pfade, event)`."""
        if not self.file_drop_support():
            return False
        try:
            widget.drop_target_register(self._dnd_files_type)
        except (tk.TclError, AttributeError):
            return False

        def ablegen(event):
            try:
                pfade = [pfad for pfad in self.root.tk.splitlist(event.data) if os.path.isfile(pfad)]
            except tk.TclError:
                pfade = []
            if pfade:
                callback(pfade, event)
            return getattr(event, "action", "copy")

        widget.dnd_bind("<<Drop>>", ablegen)
        return True

    def sync_gallery_view(self):
        """Blendet die Galerie ein, solange eine Galerie offen ist."""
        if not hasattr(self, "list_frame"):
            return
        entry = self.current_list() if self.view_mode == "list" and self.lists else None
        sichtbar = self.is_gallery_list(entry)
        ansicht = getattr(self, "gallery_view", None)
        if ansicht is not None and (not sichtbar or ansicht.list_id != entry.get("id")
                                    or getattr(self, "_gallery_theme", None) != self.theme_name):
            try:
                ansicht.destroy()
            except tk.TclError:
                pass
            ansicht = self.gallery_view = None
        if not sichtbar:
            return
        self.hide_drawing_chrome()
        if ansicht is None:
            ansicht = self.gallery_view = GalleryView(self.list_frame_outer.inner, self, entry)
            self._gallery_theme = self.theme_name
            ansicht.pack(fill="both", expand=True, padx=self.CONTENT_INSET, pady=self.CONTENT_INSET[0])
        ansicht.redraw()

    def add_gallery_images(self, list_id, paths=None):
        """Bilder als Anhänge der Galerie ablegen."""
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None:
            return []
        if paths is None:
            paths = filedialog.askopenfilenames(
                title="Bilder hinzufügen",
                filetypes=[("Bilder", glide_image_preview.FILE_PATTERN), ("Alle Dateien", "*.*")])
        paths = [pfad for pfad in (paths or ()) if pfad and os.path.isfile(pfad)]
        if not paths:
            return []
        neu = []
        try:
            for pfad in paths:
                neu.append(self.store_attachment(pfad))
        except OSError as exc:
            self.show_error("Bilder hinzufügen", str(exc))
        if not neu:
            return []
        with self.sidebar_change(refresh_tree=True) as change:
            entry.setdefault("attachments", []).extend(neu)
            entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
            change.mark()
        return neu

    def page_attachment(self, list_id, attachment_id):
        """Anhang einer Seite nach Kennung – Grundlage der Seitenbilder."""
        if not attachment_id:
            return None
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        return next((anhang for anhang in (entry or {}).get("attachments") or []
                     if anhang.get("id") == attachment_id), None)

    def add_page_images(self, list_id, paths):
        """Bilder als Anhänge einer Seite ablegen (27.09.2026); der Editor setzt sie in den Text.

        Wie in der Galerie sind es gewöhnliche Anhänge: Sie reisen mit Backup,
        `.glidepage` und Papierkorb. Rückgängig nimmt den Anhang zurück, das
        Bild im Text nimmt das Rückgängig der Seite zurück.
        """
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None or not self.is_page_list(entry):
            return []
        paths = [pfad for pfad in (paths or ()) if pfad and os.path.isfile(pfad)
                 and glide_image_preview.is_image_name(pfad)]
        if not paths:
            return []
        self.refresh_data_lock()
        if getattr(self, "_data_read_only", False):
            self.show_warning("Bild einfügen", self.read_only_notice())
            return []
        neu = []
        try:
            for pfad in paths:
                neu.append(self.store_attachment(pfad))
        except OSError as exc:
            self.show_error("Bild einfügen", str(exc))
        if not neu:
            return []
        with self.sidebar_change(refresh_tree=False, feedback=False) as change:
            entry.setdefault("attachments", []).extend(neu)
            entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
            change.mark()
        return neu if change.saved else []

    def remove_gallery_image(self, list_id, attachment_id):
        """Nimmt ein Bild aus der Galerie; Rückgängig holt es zurück."""
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None:
            return False
        vorher = list(entry.get("attachments") or [])
        with self.sidebar_change(refresh_tree=True) as change:
            entry["attachments"] = [anhang for anhang in vorher if anhang.get("id") != attachment_id]
            if len(entry["attachments"]) != len(vorher):
                change.mark()
        if change.changed:
            self.show_undo_toast("Bild entfernt")
        return bool(change.changed)

    def set_gallery_caption(self, list_id, attachment_id, title, note):
        """Titel und Notiz eines Galeriebilds; leer heißt: Dateiname."""
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        anhang = next((value for value in (entry or {}).get("attachments") or []
                       if value.get("id") == attachment_id), None)
        if anhang is None:
            return False
        titel, notiz = " ".join(str(title or "").split())[:200], str(note or "").strip()[:4000]
        if (anhang.get("title") or "") == titel and (anhang.get("note") or "") == notiz:
            return False
        with self.sidebar_change(refresh_tree=False) as change:
            for feld, wert in (("title", titel), ("note", notiz)):
                if wert:
                    anhang[feld] = wert
                else:
                    anhang.pop(feld, None)
            change.mark()
        return True

    def apply_drawing_change(self, entry, mutate):
        """Rahmen für Umbauten einer Zeichnung mit vollständigem Vorher-Stand.

        Nachzeichnen, Ersetzen durch Import, Leeren und Referenzwechsel sind
        Strukturaktionen. Sie gehören nicht in den Aktionspuffer des Editors,
        weil sie die Seite als Ganzes betreffen; deshalb entsteht ein globaler
        Rückgängig-Schritt, der ausdrücklich auch das Zellmodell dieser Seite
        zurückholt.
        """
        self.flush_drawing_editor()
        with self.sidebar_change(refresh_tree=True, feedback=False) as record:
            if self.undo_stack:
                self.undo_stack[-1]["drawing_restore"] = [entry.get("id")]
            if mutate():
                entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
                record.mark()
        return bool(record.changed and record.saved is not False)

    def snapshot_keeping_drawings(self, snapshot):
        """Globales Rückgängig nimmt Zellstriche nicht still mit zurück.

        Ein älterer Stand aus einer beliebigen anderen Aktion enthielte das
        damalige Bild. Nur eine Strukturaktion der Zeichnung selbst
        (`drawing_restore`) stellt deren Zellmodell zurück.
        """
        restore = set(snapshot.get("drawing_restore") or ())
        live = {entry.get("id"): entry for entry in self.lists if self.is_drawing_list(entry)}
        result = dict(snapshot)
        lists = unpack_state(snapshot.get("lists"))
        for entry in lists:
            current = live.get(entry.get("id"))
            if current is None or entry.get("id") in restore or not self.is_drawing_list(entry):
                continue
            entry["drawing"] = copy.deepcopy(current.get("drawing"))
        result["lists"] = lists
        return result

    def drawing_entry(self, editor):
        entry = next((value for value in self.lists if value.get("id") == editor.list_id), None)
        return entry if self.is_drawing_list(entry) else None

