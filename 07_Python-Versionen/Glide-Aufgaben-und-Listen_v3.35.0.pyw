    def build_sidebar_quick_actions(self, baum=None):
        """„+“ und „…“ an der rechten Kante einer Ordnerzeile, nur beim Überfahren.

        Die beiden Knöpfe liegen über dem Baum statt in ihm: Die Zeilen
        springen nicht, und Ziehen beginnt überall sonst wie bisher. Eine
        Listenzeile zeigt seit dem 27.09.2026 nur „…“ – dort liegen
        Bearbeiten und Löschen, seit die Knöpfe unter dem Baum entfallen sind.
        Seit dem 29.09.2026 hat jeder Baum – Seiten, Listen, Notizen – sein
        eigenes Knopfpaar: Tk hängt ein Widget nicht in einen anderen Baum um.
        """
        baum = baum or self.sidebar_listbox
        theme = self.theme
        self.sidebar_quick_row = None
        self.sidebar_quick_kind = None
        self.sidebar_quick_tree = None
        knoepfe = []
        for text, befehl, hinweis in (("+", self.sidebar_quick_add, "In diesem Ordner anlegen"),
                                     ("…", self.sidebar_quick_more, "Bearbeiten, Löschen und weitere Aktionen")):
            knopf = tk.Label(baum, text=text, font=app_font(11, "bold"), cursor="hand2", width=2,
                             bg=theme["hover"], fg=theme["text"])
            knopf.bind("<Button-1>", lambda event, run=befehl: run(event) or "break")
            knopf.bind("<Leave>", lambda _event: self.root.after(60, self.hide_sidebar_quick_actions_unless_hovered))
            self.add_tooltip(knopf, hinweis)
            knoepfe.append(knopf)
        paare = getattr(self, "sidebar_quick_buttons", None) or {}
        paare[str(baum)] = tuple(knoepfe)
        self.sidebar_quick_buttons = paare
        if baum is getattr(self, "sidebar_listbox", None):
            self.sidebar_quick_add_button, self.sidebar_quick_more_button = knoepfe
        baum.bind("<Motion>", self.on_sidebar_quick_motion, add="+")
        baum.bind("<Leave>", lambda _event: self.root.after(60, self.hide_sidebar_quick_actions_unless_hovered),
                  add="+")
        baum.bind("<B1-Motion>", lambda _event: self.hide_sidebar_quick_actions(), add="+")

    def sidebar_quick_pair(self, baum=None):
        """Das Knopfpaar („+“, „…“) eines Seitenleistenbaums."""
        paare = getattr(self, "sidebar_quick_buttons", None) or {}
        return paare.get(str(baum or self.sidebar_listbox), (None, None))

    def on_sidebar_quick_motion(self, event):
        baum = getattr(event, "widget", None)
        if baum not in self.sidebar_trees():
            baum = self.sidebar_listbox
        iid = baum.identify_row(event.y)
        row = self.sidebar_iid_to_row.get(iid) if iid else None
        if not row or row[0] not in ("folder", "list") or getattr(self, "_sidebar_rename", None):
            self.hide_sidebar_quick_actions()
            return
        box = baum.bbox(iid)
        plus, mehr = self.sidebar_quick_pair(baum)
        if not box or plus is None:
            self.hide_sidebar_quick_actions()
            return
        # Nur ein Baum zeigt seine Knöpfe; der zuletzt überfahrene verliert sie.
        for anderer in self.sidebar_trees():
            if anderer is not baum:
                for knopf in self.sidebar_quick_pair(anderer):
                    if knopf is not None:
                        knopf.place_forget()
        _x, y, _w, hoehe = box
        groesse = max(18, min(24, hoehe - 4))
        rechts = baum.winfo_width() - 6
        oben = y + (hoehe - groesse) // 2
        hintergrund = self.theme["selection"] if iid in baum.selection() else self.theme["hover"]
        schrift = self.theme["selection_text"] if iid in baum.selection() else self.theme["text"]
        knoepfe = [(mehr, rechts - groesse)]
        if row[0] == "folder":
            knoepfe.append((plus, rechts - 2 * groesse - 4))
        else:
            plus.place_forget()
        for knopf, links in knoepfe:
            knopf.configure(bg=hintergrund, fg=schrift)
            knopf.place(x=links, y=oben, width=groesse, height=groesse)
            knopf.lift()
        self.sidebar_quick_row = row[1]
        self.sidebar_quick_kind = row[0]
        self.sidebar_quick_tree = baum

    def hide_sidebar_quick_actions(self):
        for paar in (getattr(self, "sidebar_quick_buttons", None) or {}).values():
            for knopf in paar:
                try:
                    knopf.place_forget()
                except tk.TclError:
                    pass
        self.sidebar_quick_row = None
        self.sidebar_quick_kind = None
        self.sidebar_quick_tree = None

    def hide_sidebar_quick_actions_unless_hovered(self):
        try:
            unter = self.root.winfo_containing(self.root.winfo_pointerx(), self.root.winfo_pointery())
        except (KeyError, tk.TclError):
            unter = None
        if any(unter is knopf for paar in (getattr(self, "sidebar_quick_buttons", None) or {}).values()
               for knopf in paar):
            return
        if unter is not None and unter in self.sidebar_trees():
            return
        self.hide_sidebar_quick_actions()

    def folder_quick_add_menu(self, folder_id=None):
        """Was in der Seitenleiste neu entstehen kann – in einem Ordner oder oben.

        Dasselbe Menü hängt am „+“ einer Ordnerzeile und am „+“ neben
        „Listen“. Ohne Ordner kommt der Import dazu: Bis 27.09.2026 standen
        „Liste importieren“ und „+ Neuer Ordner“ als eigene Knöpfe unter dem
        Baum, als zweiter Weg zu denselben Befehlen (Aufräumen).

        Seit dem 29.09.2026 tragen Bibliothek und Notizbuch ihr „+“ auch im
        Seiten- und Notizbereich. Eine Bibliothek bietet nur Seiten an, ein
        Notizbuch zuerst die Tagesnotiz; ein Unterordner erbt die Ordnerart.
        """
        menu = self._new_themed_popup_menu()
        section = self.sidebar_section_for("folder", folder_id) if folder_id else "lists"
        ordnerart = (self.get_folder(folder_id) or {}).get("folder_kind")
        if section == "lists":
            menu.add_command(label="Aus Vorlage …", command=lambda: self.choose_creation_template(folder_id, section))
            menu.add_command(label="Neue Liste …", command=lambda: self.create_container_dialog("list", parent_id=folder_id))
        if section in ("pages", "lists"):
            menu.add_command(label="Neue Seite", command=lambda: self.create_in_sidebar_section("page", folder_id, section))
            menu.add_cascade(label="Seite aus Vorlage", menu=self.page_template_menu(menu, folder_id, section))
        if section in ("notes", "lists"):
            if ordnerart == "journal":
                menu.add_command(label="Neue Tagesnotiz", command=lambda: self.create_journal_entry(folder_id))
            menu.add_command(label="Neue Notiz …", command=lambda: self.create_container_dialog(
                "list", parent_id=folder_id, list_kind=self.LIST_KIND_NOTE, sidebar_section=section))
        if section == "lists":
            menu.add_command(label="Neue Pinnwand …", command=lambda: self.create_container_dialog(
                "list", parent_id=folder_id, list_kind="board"))
            menu.add_command(label="Neue Galerie", command=lambda: self.create_new_gallery(folder_id))
        if glide_sidebar.accepts(section, "list", "drawing", ordnerart):
            menu.add_command(label="Neue Zeichnung", command=lambda: self.create_in_sidebar_section("drawing", folder_id, section))
        for key, info in self.FOLDER_KINDS.items():
            if glide_sidebar.accepts(section, "folder", key):
                menu.add_command(label=("Neuer Unterordner …" if folder_id else "Neuer Ordner …") if key == "standard"
                                 else "Neues Buch …" if key == "library" else "Neues Notizbuch …",
                                 command=lambda k=key: self.create_container_dialog(
                                     "folder", parent_id=folder_id, folder_kind=k, sidebar_section=section))
        if folder_id is None:
            menu.add_separator()
            menu.add_command(label="Listen importieren …", command=self.import_txt_as_new_lists)
        return menu

    def show_sidebar_add_menu(self, event=None):
        """„+“ neben „Listen“: im geöffneten Ordner anlegen, sonst oben."""
        ordner = self.active_folder_id if self.view_mode == "folder" and self.get_folder(self.active_folder_id) and self.sidebar_section_for("folder", self.active_folder_id) == "lists" else None
        self._popup_at_widget(self.folder_quick_add_menu(ordner), self.add_list_button)
        return "break"

    def sidebar_quick_add(self, event=None):
        folder_id = self.sidebar_quick_row
        if not folder_id or self.get_folder(folder_id) is None:
            return "break"
        menu = self.folder_quick_add_menu(folder_id)
        self._popup_at_widget(menu, self.sidebar_quick_pair(getattr(self, "sidebar_quick_tree", None))[0])
        return "break"

    def sidebar_quick_more(self, event=None):
        kennung = self.sidebar_quick_row
        knopf = self.sidebar_quick_pair(getattr(self, "sidebar_quick_tree", None))[1]
        if getattr(self, "sidebar_quick_kind", None) == "list":
            menu = self.build_list_menu(kennung)
            if menu is not None:
                self._popup_at_widget(menu, knopf)
            return "break"
        folder_id = kennung
        if not folder_id or self.get_folder(folder_id) is None:
            return "break"
        menu = self.build_folder_menu(folder_id)
        if menu is not None:
            self._popup_at_widget(menu, knopf)
        return "break"

    def _popup_at_widget(self, menu, widget):
        try:
            menu.tk_popup(widget.winfo_rootx(), widget.winfo_rooty() + widget.winfo_height())
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    def render_pinned_sidebar(self):
        """Der Block „Angeheftet“ unter den Systemzeilen.

        Bewusst kein Teil des Listenbaums: Auswahl, Umbenennen an Ort und
        Stelle und Ziehen im Baum sollen von einer zweiten Zeile derselben
        Liste nichts wissen müssen. Ohne angeheftete Seiten verschwindet der
        Block ganz und kostet keinen Pixel.
        """
        frame = getattr(self, "pinned_sidebar_frame", None)
        if frame is None:
            return
        for child in frame.winfo_children():
            child.destroy()
        pages = self.pinned_pages()
        self.pinned_sidebar_rows = []
        if not pages:
            frame.pack_forget()
            return
        theme = self.theme
        if not frame.winfo_manager():
            frame.pack(fill="x", pady=(self.SIDEBAR_SECTION_GAP // 2, 0), after=self.system_listbox)
        is_open = self.sidebar_section_open("pinned")
        kopf = tk.Frame(frame, bg=theme["card"], cursor="hand2")
        kopf.pack(fill="x")
        pfeil = tk.Label(kopf, text=self.ICONS["dropdown_closed" if is_open else "group"], width=2,
                         bg=theme["card"], fg=theme["muted"], font=app_font(9), cursor="hand2", takefocus=True)
        pfeil.pack(side="left", padx=(6, 2))
        titel = tk.Label(kopf, text=f"Angeheftet ({len(pages)})", bg=theme["card"], fg=theme["muted"],
                         font=app_font(9, "bold"), anchor="w", cursor="hand2")
        titel.pack(side="left", fill="x", expand=True)
        for widget in (kopf, pfeil, titel):
            widget.bind("<Button-1>", lambda _event: self.toggle_pinned_sidebar())
        for sequence in ("<Return>", "<space>"):
            pfeil.bind(sequence, lambda _event: self.toggle_pinned_sidebar())
        self.pinned_sidebar_header = kopf
        if not is_open:
            return
        active = ("folder", self.active_folder_id) if self.view_mode == "folder" else (
            ("list", self.active_list_id) if self.view_mode in ("list", self.TABLE_VIEW) else None)
        for kind, holder in pages:
            selected = active == (kind, holder.get("id"))
            bg = theme["selection" if selected else "card"]
            fg = theme["selection_text" if selected else "text"]
            row = tk.Frame(frame, bg=bg, cursor="hand2")
            row.pack(fill="x")
            image = self.page_icon_image(holder)
            symbol = tk.Label(row, width=28 if image else 3, bg=bg, fg=fg, font=self.tree_font(),
                              image=image or "", text="" if image else self.ICONS[
                                  "folder" if kind == "folder" else "drawing" if self.is_drawing_list(holder)
                                  else "list"])
            symbol.pack(side="left")
            label = tk.Label(row, text=str(holder.get("title") or ("Ordner" if kind == "folder" else "Liste")),
                             bg=bg, fg=fg, font=self.tree_font(), anchor="w")
            label.pack(side="left", fill="x", expand=True, pady=2)
            widgets = (row, symbol, label)

            def hover(on, widgets=widgets, selected=selected):
                if selected:
                    return
                for widget in widgets:
                    widget.configure(bg=theme["hover" if on else "card"])

            for widget in widgets:
                widget.bind("<Button-1>", lambda _event, value=(kind, holder.get("id")): self.open_pinned_page(*value))
                widget.bind("<Enter>", lambda _event, action=hover: action(True))
                widget.bind("<Leave>", lambda _event, action=hover: action(False))
                widget.bind("<Button-3>", lambda event, value=(kind, holder.get("id")): self.show_pinned_menu(
                    event, *value))
                if IS_MACOS:
                    widget.bind("<Button-2>", lambda event, value=(kind, holder.get("id")): self.show_pinned_menu(
                        event, *value))
                self.bind_context_menu_modifier(
                    widget, lambda event, value=(kind, holder.get("id")): self.show_pinned_menu(event, *value))
            self.pinned_sidebar_rows.append(((kind, holder.get("id")), row))

    def toggle_pinned_sidebar(self):
        self.toggle_sidebar_section("pinned")
        self.render_pinned_sidebar()
        return "break"

    def open_pinned_page(self, kind, identity):
        if kind == "folder":
            if self.get_folder(identity) is not None:
                self.set_active_folder(identity)
        elif any(entry.get("id") == identity for entry in self.lists):
            self.set_active_list(identity)
        return "break"

    def show_pinned_menu(self, event, kind, identity):
        menu = self._new_themed_popup_menu()
        menu.add_command(label="Öffnen", command=lambda: self.open_pinned_page(kind, identity))
        menu.add_separator()
        menu.add_command(label="Nach oben", command=lambda: self.move_pinned(kind, identity, -1))
        menu.add_command(label="Nach unten", command=lambda: self.move_pinned(kind, identity, 1))
        menu.add_separator()
        menu.add_command(label="Lösen", command=lambda: self.set_pinned(kind, identity, False))
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass
        return "break"

    def show_filter_pin_menu(self, anchor):
        """Gespeicherte Filter an die Startseite heften oder davon lösen."""
        menu = self._new_themed_popup_menu()
        angeheftet = list(self.settings.get("home_filter_tiles", []))
        filter_liste = self.settings.get("saved_filters", [])
        if not filter_liste:
            menu.add_command(label="Noch keine gespeicherten Filter – Filter anlegen …",
                             command=self.saved_filters.show_manager)
        for saved in filter_liste:
            dran = saved["id"] in angeheftet
            menu.add_command(label=("✓ " if dran else "    ") + saved["name"],
                             command=lambda value=saved["id"], on=dran: self.pin_home_filter(value, not on))
        try:
            menu.tk_popup(anchor.winfo_rootx() + 20, anchor.winfo_rooty() + 20)
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    def pin_home_filter(self, identity, pinned=True):
        values = [value for value in self.settings.get("home_filter_tiles", []) if value != identity]
        if pinned:
            if len(values) >= self.MAX_HOME_FILTER_TILES:
                self.show_info("Filter anheften",
                               f"Es lassen sich höchstens {self.MAX_HOME_FILTER_TILES} Filter anheften.")
                return False
            values.append(identity)
            hidden = [key for key in self.settings.get("home_tiles_hidden", []) if key != "filters"]
            self.settings["home_tiles_hidden"] = hidden
        self.settings["home_filter_tiles"] = values
        self.save_settings()
        if self.view_mode == self.HOME_VIEW:
            self.refresh_home()
        return True

    def toggle_item_done_anywhere(self, item_id):
        """Abhaken aus einer Kachel heraus – derselbe Weg wie in der Liste."""
        found = self.find_item_in_lists(item_id)
        if not found or not self.is_schedulable_item(found[0]):
            return False
        item = found[0]
        if not item.get("done") and not self.confirm_complete_blocked([item]):
            return False
        with self.item_change([item_id], restore=False, local=True) as change:
            item["done"] = not item.get("done")
            change.mark()
            if item["done"]:
                advanced = self.advance_repeating_items([item_id])
                if advanced:
                    self.book_completions(advanced)
                    change.mark()
        if self.view_mode == self.HOME_VIEW:
            self.refresh_home()
        if item.get("done") and change.changed and change.saved is not False:
            self.show_undo_toast("Erledigt")
            self.schedule_checklist_reset([item_id])
        return change.saved is not False

    # --- Wiederkehrende Checklisten (27.09.2026) ---------------------------
    CHECKLIST_RESET_DELAY_MS = 1200

    def set_recurring_checklist(self, list_id, on=True):
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None or entry.get("list_kind", self.LIST_KIND_TASKS) != self.LIST_KIND_TASKS \
                or self.is_inbox_list(entry):
            return False
        if (entry.get("recurring_checklist") is True) == bool(on):
            return False
        with self.sidebar_change(refresh_tree=False) as change:
            if on:
                entry["recurring_checklist"] = True
            else:
                entry.pop("recurring_checklist", None)
            change.mark()
        if on and change.saved is not False:
            self.show_undo_toast("Wiederkehrende Checkliste: öffnet sich wieder, wenn alles erledigt ist")
            self.schedule_checklist_reset([], list_ids=[list_id])
        return bool(change.changed)

    def toggle_today_routine(self, list_id):
        """Wiederkehrende Checkliste in „Heute“ als Routine zeigen oder nicht (AU06).

        Lokale Anzeigeeinstellung wie die Bereichszuordnung der Seitenleiste;
        kein neues Datenfeld, nicht Teil des Aufgabenbackups.
        """
        vorher = list(self.settings.get("today_routines") or [])
        self.settings["today_routines"] = glide_routines.toggled(vorher, list_id)
        if not self.save_settings(show_error=True):
            self.settings["today_routines"] = vorher
            return "break"
        gezeigt = list_id in self.settings["today_routines"]
        self.show_undo_toast("Routine in „Heute“" if gezeigt else "Routine nicht mehr in „Heute“")
        if self.view_mode == self.PLAN_DAY_VIEW:
            self.refresh_tree()
        return "break"

    def today_routine_rows(self):
        """Zeilen des Abschnitts „Routinen“ für den heutigen Tag."""
        eintraege = glide_routines.selected(self.lists, self.settings.get("today_routines"),
                                            archived_folder=self.is_archived_folder)
        return glide_routines.section(eintraege, self.settings.get("routine_done_days"), date.today().isoformat())

    def remember_routine_completion(self, list_id):
        """Vollständigen Durchgang einer Routine für heute merken (vor dem Zurücksetzen)."""
        if list_id not in (self.settings.get("today_routines") or []):
            return
        gueltig = {entry.get("id") for entry in self.lists}
        self.settings["routine_done_days"] = glide_routines.remember_completion(
            self.settings.get("routine_done_days"), list_id, date.today().isoformat(), gueltig)
        self.save_settings(defer=True)

    def checklist_complete(self, entry):
        """Alles abgehakt – Punkte, Unterpunkte und ihre Schritte?"""
        punkte = [item for item in self.walk_items(entry.get("items", [])) if self.is_schedulable_item(item)]
        if not punkte:
            return False
        return all(item.get("done") for item in punkte)

    def schedule_checklist_reset(self, item_ids, list_ids=None):
        """Nach dem letzten Haken öffnet sich eine wiederkehrende Checkliste nach kurzer Pause wieder."""
        ziele = set(list_ids or [])
        for item_id in item_ids or ():
            gefunden = self.find_item_in_lists(item_id)
            if gefunden:
                ziele.add(gefunden[3].get("id"))
        for list_id in ziele:
            entry = next((value for value in self.lists if value.get("id") == list_id), None)
            if entry is None or entry.get("recurring_checklist") is not True or not self.checklist_complete(entry):
                continue
            self._register_after(self.root.after(self.CHECKLIST_RESET_DELAY_MS,
                                                 lambda lid=list_id: self.reset_checklist(lid, automatic=True)))

    def reset_checklist(self, list_id, automatic=False):
        """Öffnet alle Punkte und Schritte einer Liste wieder; Rückgängig stellt sie wieder her."""
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        if entry is None:
            return False
        if automatic and not (entry.get("recurring_checklist") is True and self.checklist_complete(entry)):
            return False
        ids = [item.get("id") for item in self.walk_items(entry.get("items", []))]
        with self.item_change([], restore=False, update_sidebar=True) as change:
            if automatic:
                self.remember_routine_completion(list_id)
            for item in self.walk_items(entry.get("items", [])):
                if item.get("done"):
                    item["done"] = False
                    change.mark()
                for schritt in item.get("checklist") or []:
                    if isinstance(schritt, dict) and schritt.get("done"):
                        schritt["done"] = False
                        change.mark()
        if change.changed and change.saved is not False:
            if list_id == self.active_list_id:
                self.refresh_tree()
            self.show_undo_toast("Checkliste wieder offen" if automatic else f"{len(ids)} Punkte wieder offen")
        return bool(change.changed)

    def toggle_home_editing(self):
        self._home_editing = not getattr(self, "_home_editing", False)
        self.refresh_home()
        return "break"

    def _home_tile_settings_changed(self):
        self.save_settings()
        self.refresh_home()

    def move_home_tile(self, key, delta):
        order = self.home_tile_order()
        if key not in order:
            return False
        visible = [value for value in order if self.home_tile_visible(value)]
        if key not in visible:
            return False
        position = visible.index(key)
        target = max(0, min(len(visible) - 1, position + delta))
        if target == position:
            return False
        neighbour = visible[target]
        order.remove(key)
        index = order.index(neighbour) + (1 if delta > 0 else 0)
        order.insert(index, key)
        self.settings["home_tile_order"] = order
        self._home_tile_focus = key
        self._home_tile_settings_changed()
        return True

    def move_home_tile_to(self, key, visible_index):
        visible = [value for value in self.home_tile_order() if self.home_tile_visible(value)]
        if key not in visible:
            return False
        return self.move_home_tile(key, max(0, min(len(visible) - 1, visible_index)) - visible.index(key))

    def set_home_tile_hidden(self, key, hidden=True):
        self.settings["home_tile_order"], self.settings["home_tiles_hidden"] = glide_home.own_selection(
            self.settings.get("home_tile_order"), self.settings.get("home_tiles_hidden"), key, hidden)
        if key == "stats":
            self.settings["show_home_stats"] = not hidden
        self._home_tile_settings_changed()

    def set_home_tile_span(self, key, span):
        spans = dict(self.settings.get("home_tile_span") or {})
        if span == "wide":
            spans[key] = "wide"
        else:
            spans.pop(key, None)
        self.settings["home_tile_span"] = spans
        self._home_tile_settings_changed()

    def render_home_editor(self):
        """Bearbeitungsmodus der Startseite: ziehen, verbreitern, ausblenden.

        Die Kacheln stehen hier als schlichte Zeilen: Ein Klick darf nichts
        öffnen, und Ziehen baut nicht bei jeder Mausbewegung neu auf – erst
        das Loslassen ordnet um.
        """
        theme = self.theme
        titles = {key: title for key, title, _g, _b, _s in self.HOME_TILE_DEFINITIONS}
        fixed_wide = {key for key, _t, _g, breit, _s in self.HOME_TILE_DEFINITIONS if breit}
        spans = self.settings.get("home_tile_span") or {}
        # Beschriftungen auf dem Grund sind `CanvasLabel`: Ein `tk.Label` in
        # der Grundfarbe stand auf dem Verlauf als dunkler Balken
        # (Rückmeldung 27.09.2026).
        kopf = tk.Frame(self.home_content, bg=theme["bg"])
        kopf.pack(fill="x", pady=(0, 10))
        CanvasLabel(kopf, text="Startseite anpassen", bg=theme["bg"], fg=theme["text"], font=app_font(15, "bold"),
                    anchor="w").pack(side="left")
        self._make_dialog_button(kopf, "Fertig", self.toggle_home_editing, "confirm", width=110,
                                 height=34).pack(side="right")
        self._make_dialog_button(kopf, "Weitere Einstellungen …", self.show_home_tiles_dialog, "muted", width=200,
                                 height=34).pack(side="right", padx=(0, 8))
        CanvasLabel(self.home_content, text="Am Griff ziehen oder mit Alt+Pfeiltasten verschieben. „Ganze Breite“ "
                                            "stellt eine Kachel über das Raster.", bg=theme["bg"], fg=theme["muted"],
                    font=app_font(10), anchor="w").pack(fill="x", pady=(0, 8))
        liste = tk.Frame(self.home_content, bg=theme["bg"])
        liste.pack(fill="x")
        visible = [key for key in self.home_tile_order() if self.home_tile_visible(key)]
        rows = []
        drag = {"key": None, "marker": None}
        focus_key = getattr(self, "_home_tile_focus", None)

        def target_index(y_root):
            for index, (_key, row) in enumerate(rows):
                middle = row.winfo_rooty() + row.winfo_height() / 2
                if y_root < middle:
                    return index
            return len(rows) - 1

        def press(_event, key):
            drag["key"] = key

        def motion(event):
            if drag["key"] is None or not rows:
                return
            index = target_index(event.y_root)
            row = rows[index][1]
            if drag["marker"] is None:
                drag["marker"] = tk.Frame(liste, bg=theme["selection"], height=3)
            drag["marker"].place(in_=row, relx=0, rely=0, relwidth=1, y=-4)
            drag["marker"].lift()

        def release(event):
            key = drag["key"]
            drag["key"] = None
            if drag["marker"] is not None:
                drag["marker"].destroy()
                drag["marker"] = None
            if key is not None and rows:
                self.move_home_tile_to(key, target_index(event.y_root))

        for key in visible:
            surface = self.make_rounded_container(liste, fill_key="card", outline_key="line", radius=12,
                                                  inner_pad_x=12, inner_pad_y=8, auto_height=True, register=False)
            surface.pack(fill="x", pady=(0, 6))
            row = surface.inner
            row.configure(takefocus=1)
            griff = tk.Label(row, text=self.ICONS["details"], bg=theme["card"], fg=theme["muted"],
                             font=app_font(14), cursor="fleur")
            griff.pack(side="left", padx=(0, 10))
            tk.Label(row, text=titles.get(key, key), bg=theme["card"], fg=theme["text"], font=app_font(11),
                     anchor="w").pack(side="left", fill="x", expand=True)
            self._make_dialog_button(row, "Ausblenden", lambda value=key: self.set_home_tile_hidden(value, True),
                                     "muted", width=110, height=30).pack(side="right")
            if key not in fixed_wide:
                wide = spans.get(key) == "wide"
                self._make_dialog_button(row, "Normale Breite" if wide else "Ganze Breite",
                                         lambda value=key, now=wide: self.set_home_tile_span(
                                             value, "normal" if now else "wide"),
                                         "accent" if wide else "muted", width=130, height=30).pack(side="right",
                                                                                                  padx=(0, 6))
            griff.bind("<ButtonPress-1>", lambda event, value=key: press(event, value))
            griff.bind("<B1-Motion>", motion)
            griff.bind("<ButtonRelease-1>", release)
            row.bind("<Alt-Up>", lambda _event, value=key: self.move_home_tile(value, -1) or "break")
            row.bind("<Alt-Down>", lambda _event, value=key: self.move_home_tile(value, 1) or "break")
            # Der Tastaturfokus braucht einen sichtbaren Rahmen, sonst weiß
            # niemand, welche Kachel Alt+Pfeil gerade verschiebt.
            row.bind("<FocusIn>", lambda _event, frame=surface: frame.set_theme(
                theme["bg"], theme["card"], theme["selection"]))
            row.bind("<FocusOut>", lambda _event, frame=surface: frame.set_theme(
                theme["bg"], theme["card"], theme["line"]))
            row.bind("<Button-1>", lambda _event, frame=row: frame.focus_set(), add="+")
            rows.append((key, row))
            if key == focus_key:
                row.after_idle(row.focus_set)
        versteckt = [key for key in self.home_tile_order() if not self.home_tile_visible(key)]
        if versteckt:
            CanvasLabel(self.home_content, text="AUSGEBLENDET", bg=theme["bg"], fg=theme["muted"],
                        font=app_font(8, "bold"), anchor="w").pack(fill="x", pady=(14, 4))
            flow = ButtonFlow(self.home_content, bg=theme["bg"], gap=8)
            flow.pack(fill="x")
            for key in versteckt:
                flow.add(self._make_dialog_button(flow, f"+ {titles.get(key, key)}",
                                                  lambda value=key: self.set_home_tile_hidden(value, False),
                                                  "muted", width=max(140, len(titles.get(key, key)) * 8),
                                                  height=32))
        self.home_tile_editor_rows = rows

    # -----------------------------
    # Tagesbeginn und Wochenrückblick (3.30)
    # -----------------------------
    DAY_REVIEW_REASONS = {
        "overdue": "überfällig", "due_today": "heute fällig", "carried": "verschleppt", "inbox": "im Eingang",
        "planned_today": "für heute eingeplant",
    }

    def home_mode(self):
        mode = getattr(self, "_home_mode", "tiles")
        return mode if mode in ("tiles", "day_review", "day_close", "day_proposal", "week_review", "calendar") else "tiles"

    def _open_home_mode(self, mode):
        self._home_mode = mode
        if self.view_mode == self.HOME_VIEW:
            self.update_home_visibility()
            self.update_header_title()
            self.refresh_home()
        else:
            self._activate_system_view(self.HOME_VIEW)
        self.update_window_title()
        self.update_header_title()
        return "break"

    def day_review_queue(self, today=None):
        """Was heute entschieden werden will: Überfälliges, heute Fälliges,
        Verschlepptes und der Eingang – je Punkt genau einmal."""
        today = today or date.today().isoformat()
        seen, queue = set(), []

        def add(entry, item, reason):
            if item.get("id") in seen:
                return
            seen.add(item.get("id"))
            queue.append({"list_id": entry.get("id"), "item_id": item.get("id"), "reason": reason})

        candidates = [(entry, item) for entry in self.planning_lists()
                      for item in self.walk_items(entry.get("items", []))
                      if self.is_schedulable_item(item) and not item.get("done")]
        for reason, test in (
                ("overdue", lambda item: (self.normalize_due(item.get("due")) or "9999") < today),
                ("due_today", lambda item: self.normalize_due(item.get("due")) == today),
                ("carried", lambda item: (self.normalize_due(item.get("planned_date")) or "9999") < today)):
            for entry, item in candidates:
                if self.normalize_due(item.get("planned_date")) == today:
                    continue
                if test(item):
                    add(entry, item, reason)
        for entry, item in candidates:
            if self.is_inbox_list(entry) and not item.get("planned_date"):
                add(entry, item, "inbox")
        return queue

    # Tagesabschluss (G03, 30.09.2026) -----------------------------------------
    # Das Gegenstück zum Tagesbeginn: Was heute eingeplant oder fällig war und
    # offen blieb, bekommt einen neuen Tag; am Ende steht, was erledigt wurde,
    # und auf Wunsch wandert das als Rückblick in die Tagesnotiz. Dieselbe
    # Fläche und dieselben Entscheidungen wie der Tagesbeginn, ohne „Heute“.
    def day_close_queue(self, today=None):
        today = today or date.today().isoformat()
        queue, seen = [], set()
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done") or item.get("id") in seen:
                    continue
                if self.normalize_due(item.get("planned_date")) == today:
                    reason = "planned_today"
                elif self.normalize_due(item.get("due")) == today:
                    reason = "due_today"
                else:
                    continue
                seen.add(item.get("id"))
                queue.append({"list_id": entry.get("id"), "item_id": item.get("id"), "reason": reason})
        return queue

    def done_today_items(self, today=None):
        """Heute Erledigtes (`done_at` vom heutigen Tag), als (Punkt, Liste)."""
        today = today or date.today().isoformat()
        return [(item, entry) for entry in self.planning_lists() for item in self.walk_items(entry.get("items", []))
                if item.get("done") and str(item.get("done_at") or "")[:10] == today]

    def start_day_close(self, event=None):
        self._day_review = {"mode": "close", "queue": self.day_close_queue(), "index": 0,
                            "counts": {"today": 0, "later": 0, "done": 0, "skipped": 0}, "moved": []}
        return self._open_home_mode("day_close")

    def day_close_summary(self, today=None):
        """Text des Rückblicks für die Tagesnotiz."""
        today = today or date.today()
        state = getattr(self, "_day_review", None) or {}
        zeilen = [f"Tagesabschluss {datetime.now():%H:%M}"]
        erledigt = self.done_today_items(today.isoformat())
        if erledigt:
            zeilen.append(f"Erledigt ({len(erledigt)}):")
            zeilen += [f"{self.ICONS['check']} {self.normalize_item_text(item.get('text', ''), self.ITEM_KIND_TASK)}"
                       for item, _entry in erledigt]
        else:
            zeilen.append("Heute nichts abgehakt.")
        verschoben = [text for text in state.get("moved", []) if text]
        if verschoben:
            zeilen.append(f"Weitergegeben ({len(verschoben)}): " + ", ".join(verschoben))
        return "\n".join(zeilen)

    def write_day_close_note(self):
        """Hängt den Rückblick an die heutige Tagesnotiz; legt sie an, wenn es keine gibt."""
        heute = date.today().isoformat()
        notiz = next((entry for entry in self.lists
                      if (entry.get("journal") or {}).get("moment_date") == heute and entry.get("list_kind") == "note"),
                     None)
        if notiz is None:
            notiz = self.create_list_from_template("journal-note")
            if notiz is None:
                return None
        dokument = copy.deepcopy(notiz.get("rich_note") or {"text": "", "spans": []})
        text = str(dokument.get("text") or "")
        dokument["text"] = text + ("\n\n" if text.strip() else "") + self.day_close_summary()
        with self.sidebar_change(refresh_tree=False) as change:
            notiz["rich_note"] = dokument
            change.mark()
        self.set_active_list(notiz["id"])
        return notiz

    def start_day_review(self, event=None):
        self._day_review = {"queue": self.day_review_queue(), "index": 0,
                            "counts": {"today": 0, "later": 0, "done": 0, "skipped": 0}}
        return self._open_home_mode("day_review")

    def next_week_start(self, reference=None):
        return date.fromisoformat(glide_planning.target_day(
            "next_week", reference or date.today(), self.settings.get("week_start")))

    def day_review_decide(self, decision, target_day=None):
        """Wendet die Entscheidung auf den aktuellen Punkt an und geht weiter."""
        state = getattr(self, "_day_review", None)
        if not state or state["index"] >= len(state["queue"]):
            return "break"
        step = state["queue"][state["index"]]
        found = self.find_item_in_lists(step["item_id"])
        if found and decision != "skip":
            item = found[0]
            if decision == "done":
                if not self.confirm_complete_blocked([item]):
                    return "break"
                with self.item_change([step["item_id"]], restore=False, local=True) as change:
                    if not item.get("done"):
                        item["done"] = True
                        change.mark()
                        advanced = self.advance_repeating_items([step["item_id"]])
                        if advanced:
                            self.book_completions(advanced)
                if change.changed and not change.saved:
                    return "break"
            else:
                day = target_day if target_day is not None or decision == "date" else glide_planning.target_day(
                    decision, date.today(), self.settings.get("week_start"))
                changed = item.get("planned_date") != day
                if changed and not self.apply_quick_plan([step["item_id"]], day, toast=False):
                    return "break"
        key = {"today": "today", "done": "done", "skip": "skipped"}.get(decision, "later")
        if key == "later" and found and "moved" in state:
            state["moved"].append(self.normalize_item_text(found[0].get("text", ""), self.ITEM_KIND_TASK))
        state["counts"][key] += 1
        state["index"] += 1
        self.refresh_home()
        return "break"

    def render_day_review(self):
        theme = self.theme
        state = getattr(self, "_day_review", None) or {"queue": [], "index": 0,
                                                      "counts": {"today": 0, "later": 0, "done": 0, "skipped": 0}}
        self._day_review = state
        queue, position = state["queue"], state["index"]
        surface = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                              radius=self.HOME_CARD_RADIUS, inner_pad_x=self.HOME_CARD_PAD_X,
                                              inner_pad_y=self.HOME_CARD_PAD_Y, auto_height=True, register=False)
        surface.pack(fill="x", pady=(0, self.HOME_CARD_GAP))
        panel = surface.inner

        def text(value, size=11, bold=False, color="text", pady=(0, 6)):
            widget = tk.Label(panel, text=value, bg=theme["card"], fg=theme[color], anchor="w", justify="left",
                              font=app_font(size, "bold" if bold else "normal"))
            widget.pack(fill="x", pady=pady)
            widget.bind("<Configure>", lambda event, target=widget: target.configure(
                wraplength=max(120, event.width - 4)))
            return widget

        today_iso = date.today().isoformat()
        planned_today = self.planning_summary(self.plan_day_items(day=today_iso), day=today_iso)
        capacity_text = glide_planning.available_text(planned_today)
        buttons = ButtonFlow(panel, bg=theme["card"], gap=8)
        abschluss = state.get("mode") == "close"
        if not abschluss:
            text("1 Rückblick · 2 Tagesvorschlag · 3 Zeitblöcke", 10, color="muted")
            buttons.add(self._make_dialog_button(buttons, "Was passt heute?", self.start_day_proposal,
                                                 "confirm", width=180, height=36))
        if position >= len(queue) and abschluss:
            counts = state["counts"]
            erledigt = self.done_today_items()
            text(f"{self.ICONS['check']}  Tagesabschluss", 15, True)
            text(f"{len(erledigt)} heute erledigt · {counts['later']} weitergegeben · {counts['done']} jetzt abgehakt"
                 if queue else f"{len(erledigt)} heute erledigt; nichts Offenes war für heute eingeplant.",
                 color="muted")
            for item, _entry in erledigt[:12]:
                text(f"{self.ICONS['check']}  {self.normalize_item_text(item.get('text', ''), self.ITEM_KIND_TASK)}",
                     10, pady=(0, 2))
            if len(erledigt) > 12:
                text(f"… und {len(erledigt) - 12} weitere", 10, color="muted", pady=(0, 2))
            buttons.pack(fill="x", pady=(10, 0))
            # „Zur Startseite“ und „Heute öffnen“ stehen in der Leiste unten;
            # hier nur der neue Weg.
            buttons.add(self._make_dialog_button(buttons, "In die Tagesnotiz übernehmen", self.write_day_close_note,
                                                 "confirm", width=230, height=36))
            self.refresh_page_actions((("Zur Startseite", self.set_home_view, "muted", 160),
                                       ("Heute öffnen", self.set_today_view, "confirm", 170)))
            return surface
        if position >= len(queue):
            counts = state["counts"]
            text(f"{self.ICONS['check']}  Tagesbeginn abgeschlossen", 15, True)
            text(f"{counts['today']} für heute eingeplant · {counts['later']} verschoben · {counts['done']} erledigt"
                 f" · {counts['skipped']} übersprungen" if queue else
                 "Heute ist nichts zu entscheiden: nichts überfällig, nichts verschleppt, der Eingang ist leer.",
                 color="muted")
            text(f"Heute: {capacity_text}", 10, color="muted", pady=(4, 10))
            buttons.pack(fill="x", pady=(4, 0))
            # Beide Wege stehen in der Leiste unten – einmal, nicht zweimal
            # (bis 30.09.2026 zusätzlich hier in der Karte).
            self.refresh_page_actions((("Zur Startseite", self.set_home_view, "muted", 160),
                                       ("Heute öffnen", self.set_today_view, "confirm", 170)))
            return surface
        step = queue[position]
        found = self.find_item_in_lists(step["item_id"])
        if not found:
            state["index"] += 1
            return self.render_day_review()
        item, entry = found[0], found[3]
        text(f"Punkt {position + 1} von {len(queue)} · {self.DAY_REVIEW_REASONS.get(step['reason'], '')}",
             10, color="muted")
        text(self.normalize_item_text(item.get("text", ""), self.ITEM_KIND_TASK), 16, True)
        details = [self.list_path_title(entry)]
        if item.get("due"):
            details.append(f"fällig {self.format_due_display(item['due'])}")
        if item.get("planned_date"):
            details.append(f"eingeplant {self.format_due_display(item['planned_date'])}")
        if item.get("estimated_minutes"):
            details.append(f"Aufwand {self.format_estimated_minutes(item['estimated_minutes'])}")
        if self.is_blocked(item):
            details.append(f"{self.ICONS['blocked']} wartet noch")
        text(" · ".join(details), 10, color="muted", pady=(0, 10))
        text(f"Heute: {capacity_text}", 10, color="muted", pady=(0, 10))
        buttons.pack(fill="x")
        plan_button = self._make_dialog_button(buttons, "Einplanen", lambda: self.show_quick_plan_menu(
            item_ids=[step["item_id"]], review=True, anchor=plan_button), "muted", width=160, height=36)
        buttons.add(plan_button)
        for label_text, decision, key in (("Erledigt (E)", "done", "e"),
                                          ("Überspringen (Leertaste)", "skip", "space")):
            buttons.add(self._make_dialog_button(buttons, label_text, lambda value=decision: self.day_review_decide(value),
                                                 "muted", width=230, height=36))
            panel.bind(f"<{key}>", lambda _event, value=decision: self.day_review_decide(value))
        for key, choice in (("h", "today"), ("m", "tomorrow"), ("w", "next_week"), ("o", "unplan")):
            panel.bind(f"<{key}>", lambda _event, value=choice: self.day_review_decide(value))
        panel.bind("<p>", lambda event: self.show_quick_plan_menu(event, [step["item_id"]], review=True, anchor=plan_button))
        panel.configure(takefocus=1)
        panel.focus_set()
        self.refresh_page_actions((("Zur Startseite", self.set_home_view, "muted", 160),
                                   ("Heute öffnen", self.set_today_view, "confirm", 170)))
        return surface

    def day_proposal(self, day=None):
        day = day or date.today().isoformat()
        index = self.item_index()
        records = [dict(list_id=entry["id"], item=item, blocked=self.is_blocked(item, index))
                   for entry in self.planning_lists() for item in self.walk_items(entry.get("items", []))
                   if self.is_schedulable_item(item)]
        return glide_day_proposal.propose(records, day, self.planning_available(day))

    def start_day_proposal(self, event=None):
        proposal = self.day_proposal()
        self._day_proposal = dict(proposal=proposal, page=0,
            selected={(row["list_id"], row["item_id"]) for row in proposal["rows"] if row["selected"]})
        return self._open_home_mode("day_proposal")

    def apply_day_proposal(self, event=None):
        if getattr(self, "_data_read_only", False):
            return "break"
        state = getattr(self, "_day_proposal", None)
        if not state:
            return "break"
        original = state["proposal"]
        fresh = self.day_proposal()
        if original["signature"] != fresh["signature"]:
            self.show_warning("Tagesvorschlag aktualisiert",
                              "Tag, Aufgaben oder Kapazität haben sich geändert. Bitte die neue Auswahl prüfen.")
            return self.start_day_proposal()
        try:
            rows = glide_day_proposal.selected_rows(fresh, state["selected"])
        except ValueError as exc:
            self.show_warning("Tagesvorschlag", str(exc))
            return "break"
        if not rows:
            return "break"
        changed = self.apply_quick_plan([row["item_id"] for row in rows], fresh["day"])
        if changed == len(rows):
            self.open_day_grid(day=fresh["day"])
        return "break"

    def open_day_grid(self, event=None, day=None):
        self.settings["plan_day_grid"] = True
        self.save_settings()
        self.set_plan_day_view(day=day or date.today().isoformat())
        self.plan_grid_canvas.focus_set()
        return "break"

    def render_day_proposal(self):
        state = getattr(self, "_day_proposal", None)
        if not state:
            return self.start_day_proposal()
        proposal, selected = state["proposal"], state["selected"]
        theme = self.theme
        surface = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                              radius=self.HOME_CARD_RADIUS, inner_pad_x=self.HOME_CARD_PAD_X,
                                              inner_pad_y=self.HOME_CARD_PAD_Y, auto_height=True, register=False)
        surface.pack(fill="x", pady=(0, self.HOME_CARD_GAP))
        panel = surface.inner

        def text(value, size=10, bold=False, color="text"):
            label = tk.Label(panel, text=value, font=app_font(size, "bold" if bold else "normal"),
                             bg=theme["card"], fg=theme[color], anchor="w", justify="left")
            label.pack(fill="x", pady=(0, 8))
            label.bind("<Configure>", lambda event: label.configure(wraplength=max(120, event.width - 4)))
            return label

        text("Was passt heute?", 16, True)
        text("1 Rückblick · 2 Tagesvorschlag · 3 Zeitblöcke", color="muted")
        text(self.format_due_display(proposal["day"]), color="muted")
        budget = proposal["budget"]
        text("Bitte eine Tageskapazität festlegen." if budget is None else
             f"Auswahlbudget {glide_planning.duration(budget)}", 12, True)
        if proposal["planned_unknown"] or any(row["assumed"] for row in proposal["rows"]):
            text("Für Aufgaben ohne Schätzung reserviert der Vorschlag 30 Minuten. Der gespeicherte Aufwand bleibt leer.",
                 color="muted")
        chosen_label = text("", color="muted")

        def totals():
            chosen = [row for row in proposal["rows"] if (row["list_id"], row["item_id"]) in selected]
            minutes = sum(row["minutes"] for row in chosen)
            chosen_label.configure(text=f"{len(chosen)} ausgewählt · {glide_planning.duration(minutes)}")
            valid = bool(chosen and budget is not None and minutes <= budget)
            apply_button.command = self.apply_day_proposal if valid else None
            apply_button.configure(takefocus=int(valid))
            apply_button.set_theme(theme["card"], theme["text"] if valid else theme["muted"],
                                   border_color=theme["confirm"] if valid else theme["line"])

        rows = proposal["rows"]
        pages = max(1, math.ceil(len(rows) / 50))
        state["page"] = min(state["page"], pages - 1)
        if not rows:
            text("Keine weiteren passenden Aufgaben. Bereits eingeplante und gesperrte Aufgaben bleiben außen vor.",
                 color="muted")
        for row in rows[state["page"] * 50:(state["page"] + 1) * 50]:
            identity = (row["list_id"], row["item_id"])
            variable = tk.BooleanVar(panel, value=identity in selected)
            source = next((entry for entry in self.lists if entry["id"] == row["list_id"]), None)
            title = self.normalize_item_text(row["title"], self.ITEM_KIND_TASK)
            suffix = "30 min angenommen" if row["assumed"] else glide_planning.duration(row["minutes"])
            label = f"{title}\n{glide_day_proposal.REASONS[row['reason']]} · {suffix} · {source['title'] if source else ''}"

            def toggle(key=identity, value=variable):
                selected.add(key) if value.get() else selected.discard(key)
                totals()

            check = tk.Checkbutton(panel, text=label, variable=variable, command=toggle,
                                   font=app_font(10), bg=theme["card"], fg=theme["text"],
                                   selectcolor=theme["card"], activebackground=theme["card"],
                                   activeforeground=theme["text"], anchor="w", justify="left")
            check._proposal_identity = identity
            check.pack(fill="x", pady=(0, 8))
            check.bind("<Configure>", lambda event, widget=check: widget.configure(
                wraplength=max(120, event.width - 32)))
        buttons = ButtonFlow(panel, bg=theme["card"], gap=8)
        buttons.pack(fill="x", pady=(8, 0))
        buttons.add(self._make_dialog_button(buttons, "Neu berechnen", self.start_day_proposal,
                                             "muted", width=160, height=36))
        if budget is None:
            buttons.add(self._make_dialog_button(buttons, "Kapazität festlegen …", self.show_settings_dialog,
                                                 "muted", width=210, height=36))
        if pages > 1:
            text(f"Seite {state['page'] + 1} von {pages} · {len(rows)} Kandidaten", color="muted")
            for title, delta in (("Vorige", -1), ("Weitere", 1)):
                def turn(step=delta):
                    state["page"] = (state["page"] + step) % pages
                    self.refresh_home()
                buttons.add(self._make_dialog_button(buttons, title, turn, "muted", width=100, height=36))
        self.refresh_page_actions((("Zurück zum Rückblick", self.start_day_review, "muted", 210),
                                   ("Abbrechen · Heute öffnen", self.set_today_view, "muted", 230),
                                   ("Übernehmen & Raster", self.apply_day_proposal, "confirm", 220)))
        apply_button = next(button for group in self.template_action_groups for button in group.inner.winfo_children()
                            if isinstance(button, RoundedButton) and button.text == "Übernehmen & Raster")
        totals()
        return surface

    def week_days(self, offset=0, reference=None):
        """Die sieben Tage einer Woche nach eingestelltem Wochenbeginn."""
        reference = (reference or date.today()) + timedelta(days=7 * offset)
        first = 6 if self.settings.get("week_start") == "sunday" else 0
        start = reference - timedelta(days=(reference.weekday() - first) % 7)
        return [start + timedelta(days=step) for step in range(7)]

    def week_review_data(self, offset=0):
        """Geplant, erledigt, weitergewandert und Zeit einer Woche."""
        days = [day.isoformat() for day in self.week_days(offset)]
        today = date.today().isoformat()
        rows = {day: {"planned": 0, "planned_minutes": 0, "done": 0,
                      "capacity": self.daily_capacity_minutes(day)} for day in days}
        done_items, carried = [], []
        spent = estimate = 0
        history = self.settings.get("completion_history", {}) if isinstance(self.settings, dict) else {}
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item):
                    continue
                planned = self.normalize_due(item.get("planned_date"))
                if planned in rows:
                    rows[planned]["planned"] += 1
                    rows[planned]["planned_minutes"] += item.get("estimated_minutes") or 0
                    if not item.get("done") and planned < today:
                        carried.append((entry, item))
                done_day = str(item.get("done_at") or "")[:10]
                if item.get("done") and done_day in rows:
                    done_items.append((entry, item))
                    spent += item.get("time_spent_minutes") or 0
                    estimate += item.get("estimated_minutes") or 0
        for day in days:
            rows[day]["done"] = history.get(day, 0) if isinstance(history.get(day, 0), int) else 0
        return {"days": days, "rows": rows, "done_items": done_items, "carried": carried,
                "spent": spent, "estimate": estimate}

    def show_week_review(self, event=None, offset=None):
        self._week_offset = 0 if offset is None else int(offset)
        return self._open_home_mode("week_review")

    def render_week_review(self):
        theme = self.theme
        offset = getattr(self, "_week_offset", 0)
        data = self.week_review_data(offset)
        first, last = date.fromisoformat(data["days"][0]), date.fromisoformat(data["days"][-1])
        surface = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                              radius=self.HOME_CARD_RADIUS, inner_pad_x=self.HOME_CARD_PAD_X,
                                              inner_pad_y=self.HOME_CARD_PAD_Y, auto_height=True, register=False)
        surface.pack(fill="x", pady=(0, self.HOME_CARD_GAP))
        panel = surface.inner

        def text(value, size=10, bold=False, color="text", pady=(0, 4)):
            widget = tk.Label(panel, text=value, bg=theme["card"], fg=theme[color], anchor="w", justify="left",
                              font=app_font(size, "bold" if bold else "normal"))
            widget.pack(fill="x", pady=pady)
            widget.bind("<Configure>", lambda event, target=widget: target.configure(
                wraplength=max(120, event.width - 4)))
            return widget

        text(f"Woche vom {first:%d.%m.} bis {last:%d.%m.%Y}", 15, True, pady=(0, 10))
        table = tk.Frame(panel, bg=theme["card"])
        table.pack(fill="x")
        for column, heading in enumerate(("Tag", "Geplant", "Aufwand", "Kapazität", "Erledigt")):
            tk.Label(table, text=heading, bg=theme["card"], fg=theme["muted"], font=app_font(9, "bold"),
                     anchor="w").grid(row=0, column=column, sticky="w", padx=(0, 18))
        for row_number, day in enumerate(data["days"], 1):
            row = data["rows"][day]
            parsed = date.fromisoformat(day)
            over = row["capacity"] and row["planned_minutes"] > row["capacity"]
            cells = (f"{self.WEEKDAY_NAMES[parsed.weekday()][:2]} {parsed:%d.%m.}", str(row["planned"]),
                     self.format_estimated_minutes(row["planned_minutes"]) or "–",
                     self.format_estimated_minutes(row["capacity"]) if row["capacity"] else "–", str(row["done"]))
            for column, value in enumerate(cells):
                tk.Label(table, text=value, bg=theme["card"],
                         fg=theme["delete"] if over and column == 2 else theme["text"],
                         font=app_font(10, "bold" if day == date.today().isoformat() else "normal"),
                         anchor="w").grid(row=row_number, column=column, sticky="w", padx=(0, 18))
        total_done = sum(row["done"] for row in data["rows"].values())
        text(f"{total_done} Aufgaben erledigt · {len(data['carried'])} weitergewandert", 11, True, pady=(12, 4))
        if data["spent"] or data["estimate"]:
            text(f"Erfasste Zeit für Erledigtes: {self.format_estimated_minutes(data['spent']) or '–'}"
                 f" · geschätzt: {self.format_estimated_minutes(data['estimate']) or '–'}", color="muted")
        if data["done_items"]:
            text("ERLEDIGT", 8, True, "muted", pady=(10, 4))
            for entry, item in data["done_items"][:12]:
                text(f"{self.ICONS['check']}  {self.normalize_item_text(item.get('text', ''), self.ITEM_KIND_TASK)}"
                     f"  ·  {entry.get('title', '')}")
        if data["carried"]:
            text("WEITERGEWANDERT – EINGEPLANT, NOCH OFFEN", 8, True, "muted", pady=(10, 4))
            for entry, item in data["carried"][:12]:
                text(f"{self.ICONS['task_open']}  {self.normalize_item_text(item.get('text', ''), self.ITEM_KIND_TASK)}"
                     f"  ·  eingeplant {self.format_due_display(item.get('planned_date'))}")
        text("Erledigt je Tag stammt aus der Tageszählung; die Liste des Erledigten aus dem Erledigt-Datum "
             "der Punkte (seit 3.30).", 8, color="muted", pady=(12, 0))
        self.refresh_page_actions((
            ("Vorwoche", lambda: self.show_week_review(offset=offset - 1), "muted", 120),
            ("Diese Woche", lambda: self.show_week_review(offset=0), "accent", 130),
            ("Folgewoche", lambda: self.show_week_review(offset=offset + 1), "muted", 130),
            ("Woche planen", self.calendar_from_week_review, "accent", 150),
            ("Zur Startseite", self.set_home_view, "muted", 150),
        ))
        return surface

    def set_home_view(self, refresh=True):
        self._home_mode = "tiles"
        self._activate_system_view(self.HOME_VIEW, refresh=refresh)

    def set_template_view(self, refresh=True):
        self._activate_system_view(self.TEMPLATE_VIEW, refresh=refresh)

    def apply_startup_view(self):
        """Öffnet die in den Einstellungen gewählte Ansicht beim Programmstart.

        „Letzte Ansicht" bleibt die Vorgabe und tut
        nichts – der geladene Stand steht bereits. Eine feste Liste, die es
        nicht mehr gibt, führt auf die Startseite statt ins Leere.
        """
        wahl = self.settings.get("startup_view", "last")
        if wahl == "last":
            return
        if wahl == "list":
            kennung = self.settings.get("startup_list_id") or ""
            if any(entry.get("id") == kennung for entry in self.lists):
                self.set_active_list(kennung)
            else:
                self.set_home_view()
            return
        wege = {
            "home": self.set_home_view,
            "templates": self.set_template_view,
            "planday": self.set_today_view,
            "in_progress": self.set_in_progress_view,
            "library": self.set_library_view,
            "globalboard": self.open_global_board,
        }
        wege.get(wahl, self.set_home_view)()

    def set_library_view(self, refresh=True):
        self._activate_system_view(self.LIBRARY_VIEW, refresh=refresh)

    def home_greeting(self):
        """Aktuelle Begrüßung der Startseite, mit Namen, wenn einer gesetzt ist."""
        name = str(self.settings.get("profile_name", "") or "").strip()
        greetings = self.HOME_GREETINGS
        index = getattr(self, "_home_greeting_index", 0) % len(greetings)
        return greetings[index].format(name=f", {name}" if name else "")

    def advance_home_greeting(self):
        """Rückt eine Begrüßung weiter – beim Betreten der Startseite."""
        self._home_greeting_index = (
            getattr(self, "_home_greeting_index", 0) + 1
        ) % len(self.HOME_GREETINGS)
        # Aufforderung und Vorlagenauswahl wechseln mit, aber in eigenem Takt.
        self._home_prompt_index = random.randrange(len(self.HOME_PROMPTS))
        self._home_template_offset = random.randrange(len(self.LIST_TEMPLATES) or 1)

    def home_prompt(self):
        """Aufforderung unter der Begrüßung."""
        prompts = self.HOME_PROMPTS
        return prompts[getattr(self, "_home_prompt_index", 0) % len(prompts)]

    def home_template_keys(self):
        """Vorlagen, die gerade auf der Startseite stehen.

        Es sind mehr Vorlagen vorhanden als Platz in der Kachel ist. Welche
        angeboten werden, wechselt beim Zurückkehren zur Startseite – sonst
        sähe man dauerhaft dieselben drei und die übrigen nie.
        """
        keys = [item.get("id") for item in getattr(self, "templates", []) if item.get("kind") == "list"]
        if not hasattr(self, "templates"):
            keys = list(self.LIST_TEMPLATES)
        if len(keys) <= self.HOME_TEMPLATE_VISIBLE:
            return keys
        start = getattr(self, "_home_template_offset", 0) % len(keys)
        gedreht = keys[start:] + keys[:start]
        return gedreht[:self.HOME_TEMPLATE_VISIBLE]

    def schedule_home_day_check(self):
        """Auch ein über Mitternacht offenes Fenster zeigt den aktuellen Tag."""
        try:
            self._home_tick_id = self._register_after(self.root.after(30000, self.home_day_tick))
        except tk.TclError:
            self._home_tick_id = None

    def home_day_tick(self):
        self._after_ids.discard(self._home_tick_id)
        self._home_tick_id = None
        today = date.today()
        if today != self._home_day:
            self._home_day = today
            self.update_sidebar_list()
            self.refresh_tree()
        self.schedule_home_day_check()

    def update_home_visibility(self):
        """Bewahrt Reihenfolge und Abstände der vorhandenen Listenoberfläche."""
        workspace = getattr(self, "workspace", None)
        if workspace is not None:
            workspace.before_refresh()
        if not hasattr(self, "home_frame"):
            return
        self.template_actions.pack_forget()
        self.home_scrollbar.place_forget()
        self.update_sidebar_heading()
        if self.view_mode in (self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW):
            if not self._home_saved_pack:
                self._home_saved_pack = [(widget, widget.pack_info())
                                         for widget in self.content_frame.pack_slaves()
                                         if widget not in (self.home_frame, self.template_actions)]
                for widget, _info in self._home_saved_pack:
                    widget.pack_forget()
            if self.view_mode in (self.TEMPLATE_VIEW, self.LIBRARY_VIEW) or (
                    self.view_mode == self.HOME_VIEW and self.home_mode() != "tiles"):
                self.template_actions.pack(side="bottom", fill="x", pady=(8, 0))
            self.home_frame.pack(fill="both", expand=True, pady=(self.HOME_EDGE_GAP, 0))
        elif self._home_saved_pack:
            self.home_frame.pack_forget()
            for widget, info in self._home_saved_pack:
                widget.pack(**info)
            self._home_saved_pack = []
            self.sync_card_foot()

    def create_home_panel(self):
        self.template_actions = tk.Frame(self.content_frame, bg=self.theme["bg"])
        self.home_frame = tk.Frame(self.content_frame, bg=self.theme["bg"])
        self.home_canvas = tk.Canvas(self.home_frame, bg=self.theme["bg"], bd=0,
                                     highlightthickness=0, yscrollincrement=1)
        self.home_canvas.pack(side="left", fill="both", expand=True)
        self.home_scrollbar = ThemedAutoScrollbar(
            self.root, bg_color=self.theme["bg"], track_color=self.theme["bg"],
            thumb_color=self.theme["input_border"], active_thumb_color=self.theme["muted"], width=14,
        )
        self.home_scrollbar.set_command(self.home_canvas.yview)
        self.home_canvas.configure(yscrollcommand=self._sync_home_scrollbar)
        self.home_content = tk.Frame(self.home_canvas, bg=self.theme["bg"])
        self._home_window = self.home_canvas.create_window((0, 0), window=self.home_content, anchor="nw")
        self.home_content.bind("<Configure>", self._layout_home_canvas)
        self.home_canvas.bind("<Configure>", self._layout_home_canvas)
        self._bind_home_wheel(self.home_canvas)
        self.bind_drag_scroll(self.home_canvas, canvas=self.home_canvas)

    def _layout_home_canvas(self, _event=None):
        width, height = self.home_canvas.winfo_width(), self.home_canvas.winfo_height()
        # Wechselt die Breite über eine Schwelle, wird die
        # Startseite mit der neuen Spaltenzahl neu aufgebaut – aber nur dann.
        # Ein Neuaufbau bei jeder Pixeländerung wäre genau das Flackern, das
        # Punkt 9 andernorts beseitigt.
        if self.view_mode == self.HOME_VIEW and width > 1:
            spalten = self.home_column_count(width)
            if spalten != getattr(self, "_home_columns_rendered", None):
                self._home_columns_rendered = spalten
                self.refresh_home()
        # Der Änderungsverlauf füllt die Seite wie eine Liste: Seine Karte reicht
        # bis zur unteren Flucht, gescrollt wird in der Tabelle darin. Alle
        # übrigen Seiten behalten ihre natürliche Höhe (0) und scrollen als Ganzes.
        fuellen = self.view_mode == self.HISTORY_VIEW and height > 1
        self.home_canvas.itemconfigure(self._home_window, width=max(1, width), height=height if fuellen else 0)
        content_height = height if fuellen else self.home_content.winfo_reqheight()
        self.home_canvas.configure(scrollregion=(0, 0, width, max(height, content_height)))
        if content_height <= height:
            self.home_canvas.yview_moveto(0)
        self._sync_home_scrollbar(*self.home_canvas.yview())

    def _sync_home_scrollbar(self, first, last):
        self.home_scrollbar.set(first, last)
        visible = (self.view_mode in (self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW)
                   and float(last) - float(first) < ThemedAutoScrollbar.FULLY_VISIBLE_RATIO)
        if not visible:
            self.home_scrollbar.place_forget()
            return
        # Im äußeren Fensterrand: Ein-/Ausblenden ändert keine Kachelbreite
        # und damit auch keine Texthöhe oder Rastergeometrie mehr.
        self.home_scrollbar.place(
            x=self.home_canvas.winfo_rootx()-self.root.winfo_rootx()+self.home_canvas.winfo_width()+6,
            y=self.home_canvas.winfo_rooty()-self.root.winfo_rooty(),
            width=14, height=self.home_canvas.winfo_height())

    def _bind_home_wheel(self, widget):
        if widget in (getattr(self, '_calendar_pool', None), getattr(self, '_calendar_pool_bar', None)):
            self.bind_mousewheel(widget, target=self._calendar_pool)
            return
        self._bind_canvas_wheel(widget, self.home_canvas)
        for child in widget.winfo_children():
            self._bind_home_wheel(child)

    def _bind_canvas_wheel(self, widget, canvas):
        self.bind_mousewheel(widget, target=canvas)

    # --- Startseite als Kachelraster (Punkt 2, 3.22.0) ----------------------
    # Die Startseite war eine einzige Spalte in fester Reihenfolge: Auf einem
    # breiten Bildschirm blieb rechts die halbe Fläche leer, und wer eine
    # Kachel nicht brauchte, konnte nur die Bestandsstatistik abschalten.
    # Seit 3.22 stehen die Kacheln in einem Raster, dessen Spaltenzahl der
    # Fensterbreite folgt, und jede Kachel lässt sich ein- und ausschalten
    # sowie in ihrer Reihenfolge verschieben.
    # Bestand, Standard (D12) und Begründungen der einzelnen Kacheln stehen
    # Tk-frei in home_tiles.py.
    HOME_TILE_DEFINITIONS = glide_home.DEFINITIONS
    HOME_TILE_KEYS = glide_home.KEYS
    HOME_COLUMN_CHOICES = (("auto", "Automatisch"), ("1", "Eine Spalte"),
                           ("2", "Zwei Spalten"), ("3", "Drei Spalten"))
    # Höhe der Pinnwandvorschau. Hoch genug,
    # dass mehrere Karten als Karten erkennbar bleiben; niedrig genug, dass die
    # Kachel neben den übrigen nicht aus der Reihe fällt.
    HOME_BOARD_PREVIEW_HEIGHT = 140
    # Wie viele Karten die Vorschau höchstens zeichnet. Über dieser Zahl ist
    # eine verkleinerte Fläche ohnehin nur noch ein Muster.
    HOME_BOARD_PREVIEW_CARDS = 40
    # Die Kalenderkachel kennt drei Darstellungen. Sie
    # zeigen denselben Bestand – die Frage ist, wie weit man vorausschauen
    # will: der Monat als Raster, die laufende Woche als Tagesliste oder die
    # nächsten Termine als Aufzählung.
    HOME_CALENDAR_CHOICES = (("month", "Monat als Raster"),
                             ("week", "Diese Woche"),
                             ("next", "Nächste Termine"))
    HOME_CALENDAR_DEFAULT = "month"
    # Wie ausführlich die Kacheln sind, die Zeilen zeigen. „Kompakt" ist keine
    # andere Kachel, sondern dieselbe mit weniger Zeilen.
    HOME_DENSITY_CHOICES = (("normal", "Ausführlich"), ("compact", "Kompakt"))
    HOME_DENSITY_DEFAULT = "normal"
    HOME_DENSITY_ROWS = {"normal": 5, "compact": 3}
    # Die Schwellen waren geraten – 980 und 1500 Pixel für
    # die Fläche der Startseite. Weil die Seitenleiste und die Ränder von der
    # Fensterbreite abgehen, sprang die zweite Spalte erst bei einem Fenster
    # von rund 1300 Pixeln an; ein auf die Bildschirmhälfte gelegtes Fenster
    # blieb einspaltig.
    #
    # Abgeleitet statt geraten: Eine Kachel ist ab HOME_TILE_MIN_WIDTH lesbar
    # – dieselbe Breite, die auch eine Pinnwandkarte in der Vorgabe hat und
    # die für zwei Zeilen Fließtext plus Zähler reicht. Die Schwellen ergeben
    # sich daraus zuzüglich der Zwischenräume. Gemessen wird weiterhin die
    # tatsächlich verfügbare Fläche, nicht die Bildschirmauflösung.
    HOME_TILE_MIN_WIDTH = 300
    HOME_TILE_GAP = 16
    HOME_TWO_COLUMN_WIDTH = HOME_TILE_MIN_WIDTH * 2 + HOME_TILE_GAP
    HOME_THREE_COLUMN_WIDTH = HOME_TILE_MIN_WIDTH * 3 + HOME_TILE_GAP * 2
    HOME_IMPULSES = (
        "Fang mit der Aufgabe an, die du am liebsten aufschieben würdest.",
        "Was heute nicht fertig wird, darf morgen dranstehen – trag es ein, statt es zu merken.",
        "Eine Aufgabe ohne nächsten Schritt ist ein Wunsch. Schreib den Schritt dazu.",
        "Zwei Minuten? Dann jetzt.",
        "Am Ende des Tages kurz aufräumen spart morgen früh zehn Minuten Suchen.",
        "Eine lange Liste wird kürzer, wenn du streichst – nicht nur, wenn du abhakst.",
        "Plane den Tag mit Puffer. Ohne Puffer plant er dich.",
        "Wichtig und dringend sind zwei Dinge. Sortiere zuerst nach wichtig.",
    )

    def home_tile_order(self):
        """Reihenfolge der Kacheln; unbekannte Namen fallen still heraus."""
        return glide_home.ordered(self.settings.get("home_tile_order", []))

    def home_calendar_mode(self):
        """Die gewählte Darstellung der Kalendervorschau."""
        wert = str(self.settings.get("home_calendar_mode", self.HOME_CALENDAR_DEFAULT))
        return wert if wert in dict(self.HOME_CALENDAR_CHOICES) else self.HOME_CALENDAR_DEFAULT

    def home_density(self):
        """Wie viele Zeilen eine Kachel höchstens zeigt."""
        wert = str(self.settings.get("home_density", self.HOME_DENSITY_DEFAULT))
        return wert if wert in dict(self.HOME_DENSITY_CHOICES) else self.HOME_DENSITY_DEFAULT

    def home_row_limit(self):
        return self.HOME_DENSITY_ROWS.get(self.home_density(), 5)

    def home_calendar_days(self):
        """Fällige und eingeplante Punkte je Tag – der Rohstoff der Vorschau.

        Gezählt werden offene Punkte; ein Punkt mit Fälligkeit und
        Bearbeitungstag zählt an beiden Tagen, denn beide Tage sind eine
        eigene Aussage.
        """
        zaehler = {}
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                for feld in ("due", "planned_date"):
                    tag = self.normalize_due(item.get(feld))
                    if tag:
                        zaehler[tag] = zaehler.get(tag, 0) + 1
        return zaehler

    def home_next_events(self, grenze=6):
        """Die nächsten offenen Punkte mit Termin, chronologisch."""
        heute = date.today().isoformat()
        treffer = []
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                faellig = self.normalize_due(item.get("due"))
                if faellig and faellig >= heute:
                    treffer.append((faellig, item.get("due_time") or "", entry, item))
        treffer.sort(key=lambda wert: (wert[0], wert[1]))
        return treffer[:grenze]

    def home_overdue_entries(self, grenze=6):
        """Überfällige, noch offene Punkte – die ältesten zuerst."""
        eintraege = self.get_overdue_items(apply_filters=False)
        gekuerzt = []
        for eintrag in eintraege[:grenze]:
            # Die Übersicht liefert (Fälligkeit, …, Quelle, Punkt).
            gekuerzt.append((eintrag[0], eintrag[3], eintrag[4]))
        return gekuerzt, len(eintraege)

    def home_tile_visible(self, key):
        """Ist diese Kachel eingeschaltet?"""
        versteckt = self.settings.get("home_tiles_hidden", [])
        if key == "stats" and not self.settings.get("show_home_stats", True):
            # Der ältere Schalter bleibt gültig: Wer den Bestand abgeschaltet
            # hatte, findet ihn nach dem Versionswechsel weiterhin ausgeblendet.
            return False
        return key not in versteckt if isinstance(versteckt, list) else True

    def home_column_count(self, width=None):
        """Spaltenzahl des Kachelrasters für die gemessene Breite."""
        wahl = str(self.settings.get("home_columns", "auto"))
        if wahl in ("1", "2", "3"):
            return int(wahl)
        if width is None:
            width = self.home_canvas.winfo_width() if hasattr(self, "home_canvas") else 0
        if width >= self.HOME_THREE_COLUMN_WIDTH:
            return 3
        if width >= self.HOME_TWO_COLUMN_WIDTH:
            return 2
        return 1

    # Über der Stufe 2 liegt alles, was weder heute geplant
    # noch fällig ist – für die Startseitenkachel kein „nächster Schritt“.
    NEXT_TASK_TODAY_RANK = 2

    def task_urgency_rank(self, item):
        """Rangfolge, nach der Glide die nächste Aufgabe bestimmt.

        Die Frage „was mache ich als Nächstes“ wird an zwei
        Stellen gestellt – im Abschnitt „Nächste Aufgabe“ und in der Kachel auf
        der Startseite. Bis 3.24 beantwortete sie jede Stelle für sich: die
        Übersicht nach Fälligkeit, die Kachel nach einer eigenen Rangfolge.
        Zwei Antworten auf dieselbe Frage sind eine zu viel. Maßgeblich ist
        jetzt überall diese Reihenfolge: heute eingeplant, dann überfällig,
        dann länger geplant, dann alles Weitere; innerhalb einer Stufe nach
        Wichtigkeit und Termin.
        """
        heute = date.today().isoformat()
        geplant = self.normalize_due(item.get("planned_date"))
        faellig = self.normalize_due(item.get("due"))
        if item.get("blocked_by") and self.is_blocked(item, self.relation_index()):
            # Seit 3.30: Wer noch auf eine offene Voraussetzung wartet, kann
            # nicht die nächste Aufgabe sein – egal wie dringend er ist.
            stufe = 4
        elif geplant == heute:
            stufe = 0
        elif faellig and faellig <= heute:
            stufe = 1
        elif geplant and geplant <= heute:
            stufe = 2
        else:
            stufe = 3
        return (stufe, -self.clamp_importance(item.get("importance", 0)),
                faellig or "9999-12-31", item.get("planned_time") or "99:99")

    # Der Zustand des Begleiters spiegelt den
    # Bestand, nicht den Menschen. Das ist keine Feinheit, sondern die Grenze,
    # die `docs/decisions/ARBEITSBEGLEITER.md` zieht: Glide leitet aus
    # Abschlüssen keine Bewertung ab. Eine Figur, die trauriger wird, weil
    # jemand wenig geschafft hat, täte genau das. Sie reagiert deshalb auf das,
    # was auf dem Tisch liegt – überfällige Fristen, ein voller Eingang, ein
    # erreichtes Tagesziel, ein leerer Tag –, und ist ansonsten guter Dinge.
    MASCOT_STATES = {
        "sorgt": "{n} Aufgabe(n) sind überfällig.",
        "freut": "Das Tagesziel ist erreicht.",
        "winkt": "{n} Aufgabe(n) liegen heute an.",
        "schlaeft": "Für heute steht nichts an.",
        "ruhig": "Alles im Blick.",
    }

    def mascot_state(self):
        """Zustand und Begründung des Begleiters – (Zustand, Satz)."""
        ueberfaellig = len(self.get_overdue_items(apply_filters=False))
        if ueberfaellig:
            return "sorgt", self.MASCOT_STATES["sorgt"].format(n=ueberfaellig)
        ziel = self.daily_goal()
        if ziel and self.completions_today() >= ziel:
            return "freut", self.MASCOT_STATES["freut"]
        heute = [eintrag for eintrag in self.plan_day_entries(apply_filters=False,
                                                              day=date.today().isoformat())
                 if not eintrag[4].get("done")]
        if heute:
            return "winkt", self.MASCOT_STATES["winkt"].format(n=len(heute))
        if not self.get_in_progress_items(apply_filters=False):
            return "schlaeft", self.MASCOT_STATES["schlaeft"]
        return "ruhig", self.MASCOT_STATES["ruhig"]

    def mascot_name(self):
        """Wie der Begleiter heißt – ohne Vergabe bleibt er namenlos."""
        name = self.settings.get("mascot_name", "")
        return (" ".join(str(name).split())[:24] if isinstance(name, str) else "") or "Gismo"

    def mascot_care(self):
        """Lokale Tamagotchi-Werte; sie bewerten nie die Arbeitsleistung."""
        value = self.settings.get("mascot_care", {})
        return {key: max(0, min(100, int(value.get(key, default))))
                for key, default in (("satiety", 70), ("energy", 70), ("affection", 60))}

    def care_for_mascot(self, action):
        care = self.mascot_care()
        messages = {
            "feed": "Der Snack war genau richtig.",
            "play": "Eine kleine Spielrunde später ist die Laune bestens.",
            "rest": "Kurze Pause – jetzt ist wieder Energie da.",
        }
        if action == "feed":
            care["satiety"] = min(100, care["satiety"] + 24)
            care["energy"] = max(0, care["energy"] - 3)
        elif action == "play":
            care["affection"] = min(100, care["affection"] + 20)
            care["energy"] = max(0, care["energy"] - 10)
            care["satiety"] = max(0, care["satiety"] - 5)
        elif action == "rest":
            care["energy"] = min(100, care["energy"] + 28)
        else:
            return ""
        care["day"] = date.today().isoformat()
        previous = self.settings.get("mascot_care")
        self.settings["mascot_care"] = care
        if not self.save_settings():
            self.settings["mascot_care"] = previous
            return ""
        return messages[action]

    def rename_mascot(self, event=None):
        """Vergibt oder löscht den Namen des Begleiters."""
        name = self.themed_input_dialog(
            "Begleiter benennen",
            "Wie soll der Begleiter heißen? Ein leeres Feld verwendet Gismo.",
            initial=self.mascot_name(), ok_text="Übernehmen")
        if name is None:
            return "break"
        self.settings["mascot_name"] = " ".join(str(name).split())[:24]
        self.save_settings()
        self.refresh_home()
        return "break"

    def home_primary_actions(self):
        """Die vier Wege, die auf der Startseite täglich gebraucht werden."""
        return (
            ("today", f"{self.ICONS['today']}  Heute", self.set_today_view, "accent"),
            ("progress", f"{self.ICONS['in_progress']}  Demnächst", self.set_in_progress_view, "due_action"),
            ("inbox", f"{self.ICONS['inbox']}  Eingang", self.open_inbox_list, "ui_accent"),
            ("board", f"{self.ICONS['board']}  Pinnwand", self.open_global_board, "muted"),
        )

    def home_more_actions(self):
        """Was auf der Startseite selten gebraucht wird, nach Zweck gruppiert."""
        return (
            ("Ansichten", (
                (f"{self.ICONS['next']}  Nächste Aufgabe", self.open_next_task),
                (f"{self.ICONS['overdue']}  Verspätet", self.set_overdue_view),
                (f"{self.ICONS['calendar']}  Kalender", self.open_calendar_view),
                (f"{self.ICONS['templates']}  Vorlagen", self.set_template_view),
            )),
            ("Anlegen", (
                ("Neue Liste", self.create_new_list),
                ("Neuer Ordner", self.create_new_folder),
            )),
            ("Einrichten", (
                ("Startseite einrichten …", self.show_home_tiles_dialog),
                ("Einstellungen …", self.show_settings_dialog),
            )),
        )

    def show_home_more_menu(self, event=None):
        """Die selteneren Schnellzugriffe der Startseite als Menü."""
        menu = self._new_themed_popup_menu()
        for index, (gruppe, eintraege) in enumerate(self.home_more_actions()):
            if index:
                menu.add_separator()
            menu.add_command(label=gruppe.upper(), state="disabled")
            for beschriftung, befehl in eintraege:
                menu.add_command(label="   " + beschriftung, command=befehl)
        try:
            menu.tk_popup(self.root.winfo_pointerx(), self.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def global_board_preview(self):
        """Karten und Verbindungen der globalen Pinnwand als Vorschaugeometrie.

        Die Kachel zeichnet die echte Fläche,
        nicht eine gedachte. Die Kartenhöhe ist dabei eine Annahme – die
        wirkliche entsteht erst beim Aufbau aus dem Text der Karte –, aber ihr
        Verhältnis zur Breite und ihre Position stimmen, und darum geht es in
        einer Vorschau. Rückgabe: Flächen, Verbindungen als Indexpaare und die
        Gesamtzahl der Karten.
        """
        werkstatt = getattr(self, "workspace", None)
        bereich = werkstatt.GLOBAL_SCOPE if werkstatt is not None else "global"
        boards = self.settings.get("pinboards", {})
        board = boards.get(bereich) if isinstance(boards, dict) else None
        if not isinstance(board, dict):
            return [], [], 0
        karten = [card for card in board.get("cards", []) or [] if isinstance(card, dict)]
        grundbreite = board.get("width", 300)
        grundbreite = grundbreite if isinstance(grundbreite, (int, float)) else 300
        faktoren = getattr(werkstatt, "CARD_SCALE_FACTORS", {}) or {}
        flaechen, reihenfolge = [], {}
        for card in karten[:self.HOME_BOARD_PREVIEW_CARDS]:
            faktor = faktoren.get(card.get("scale"), 1.0)
            breite = max(40.0, float(grundbreite) * float(faktor))
            reihenfolge[card.get("item_id")] = len(flaechen)
            flaechen.append((float(card.get("x", 0) or 0), float(card.get("y", 0) or 0),
                             breite, breite * 0.42))
        # A tall or crowded board is condensed explicitly, never silently
        # presented as a faithful spatial miniature.
        self._home_preview_condensed = False
        if flaechen:
            extent_w = max(x+w for x,y,w,h in flaechen) - min(x for x,y,w,h in flaechen)
            extent_h = max(y+h for x,y,w,h in flaechen) - min(y for x,y,w,h in flaechen)
            self._home_preview_condensed = len(karten) > 24 or board.get("layout") == "grid" or extent_h > extent_w * 1.2 or extent_w > extent_h * 6
            if self._home_preview_condensed:
                columns = max(1, math.ceil(math.sqrt(len(flaechen) * 1.4)))
                flaechen = [(i % columns * 110, i // columns * 65, 96, 48) for i in range(len(flaechen))]
        verbindungen = []
        for eintrag in board.get("connections", []) or []:
            if not isinstance(eintrag, dict):
                continue
            a = reihenfolge.get(eintrag.get("from"))
            b = reihenfolge.get(eintrag.get("to"))
            if a is not None and b is not None and a != b:
                verbindungen.append((a, b))
        return flaechen, verbindungen, len(karten)

    def home_focus_candidate(self):
        """Ein konkreter nächster Schritt aus dem Bestand.

        Gesucht wird nicht „die wichtigste Aufgabe“ – das kann kein Programm
        wissen –, sondern die naheliegendste: offen, heute eingeplant oder
        fällig, danach nach Wichtigkeit und Termin. Ohne Treffer bleibt die
        Kachel leer statt eine Aufgabe zu erfinden.
        """
        kandidaten = []
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                rang = self.task_urgency_rank(item)
                if rang[0] > self.NEXT_TASK_TODAY_RANK:
                    continue
                kandidaten.append((rang, entry, item))
        if not kandidaten:
            return None, None
        beste = min(kandidaten, key=lambda wert: wert[0])
        return beste[2], beste[1]

    def home_week_overview(self, tage=7):
        """Offene Aufgaben je Tag der kommenden Woche, nach Fälligkeit."""
        heute = date.today()
        zaehler = {(heute + timedelta(days=schritt)).isoformat(): 0 for schritt in range(tage)}
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                faellig = self.normalize_due(item.get("due"))
                if faellig in zaehler:
                    zaehler[faellig] += 1
        return [(tag, anzahl) for tag, anzahl in sorted(zaehler.items())]

    def home_label_overview(self, grenze=6):
        """Die am häufigsten vergebenen Labels mit ihrer Anzahl offener Punkte."""
        zaehler = {}
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                for label_id in item.get("labels", []) or ():
                    zaehler[label_id] = zaehler.get(label_id, 0) + 1
        treffer = []
        for label_id, anzahl in zaehler.items():
            label = self.get_label(label_id)
            if label is not None:
                treffer.append((label, anzahl))
        treffer.sort(key=lambda wert: (-wert[1], str(wert[0].get("name", "")).lower()))
        return treffer[:grenze]

    def home_impulse(self):
        return self.HOME_IMPULSES[getattr(self, "_home_prompt_index", 0) % len(self.HOME_IMPULSES)]

    def show_home_tiles_dialog(self, event=None):
        """Kacheln der Startseite ein- und ausschalten und ordnen."""
        dialog = tk.Toplevel(self.root)
        dialog.title("Startseite einrichten")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Startseite einrichten", bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(16, "bold"), anchor="w").pack(fill="x", pady=(0, 6))
        tk.Label(outer, text="Welche Kacheln erscheinen, in welcher Reihenfolge und in wie vielen Spalten. "
                             "Die Auswahl gilt für dieses Gerät und liegt bei den persönlichen Einstellungen.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10),
                 anchor="w", justify="left", wraplength=560).pack(fill="x", pady=(0, 14))
        # Drei Auswahlen nebeneinander statt einer
        # untereinander – Spalten, Kalenderdarstellung, Ausführlichkeit. Sie
        # gehören zusammen: Alle drei sagen, wie viel die Startseite zeigt.
        spalten = tk.StringVar(value=dict(self.HOME_COLUMN_CHOICES).get(
            str(self.settings.get("home_columns", "auto")), "Automatisch"))
        kalender = tk.StringVar(value=dict(self.HOME_CALENDAR_CHOICES).get(
            self.home_calendar_mode(), "Monat als Raster"))
        dichte = tk.StringVar(value=dict(self.HOME_DENSITY_CHOICES).get(
            self.home_density(), "Ausführlich"))
        auswahlen = tk.Frame(outer, bg=self.theme["bg"])
        auswahlen.pack(fill="x", pady=(0, 14))
        auswahlen.columnconfigure((0, 1, 2), weight=1, uniform="homeoptionen")
        for spalte, (beschriftung, variable, moeglichkeiten) in enumerate((
                ("Spalten", spalten, [text for _key, text in self.HOME_COLUMN_CHOICES]),
                ("Kalendervorschau", kalender, [text for _key, text in self.HOME_CALENDAR_CHOICES]),
                ("Ausführlichkeit", dichte, [text for _key, text in self.HOME_DENSITY_CHOICES]))):
            zelle = tk.Frame(auswahlen, bg=self.theme["bg"])
            zelle.grid(row=0, column=spalte, sticky="new",
                       padx=(0, 8) if spalte < 2 else (0, 0))
            self._make_field_label(zelle, beschriftung).pack(anchor="w", pady=(0, self.FIELD_LABEL_GAP))
            feld, _knopf = self._make_option_menu(zelle, variable, moeglichkeiten)
            feld.pack(fill="x")
        self._make_field_label(outer, "Kacheln").pack(anchor="w", pady=(0, self.FIELD_LABEL_GAP))
        rahmen, feld = self._make_field(outer)
        rahmen.pack(fill="both", expand=True)
        feld.pack(fill="both", expand=True, padx=self.FIELD_BORDER_WIDTH, pady=self.FIELD_BORDER_WIDTH)
        liste = tk.Listbox(feld, height=14, bg=self.theme["input"], fg=self.theme["text"],
                           selectbackground=self.theme["selection"], selectforeground=self.theme["selection_text"],
                           activestyle="none", relief="flat", bd=0, highlightthickness=0,
                           font=app_font(10), name="home_tiles")
        self._attach_field_scrollbar(feld, liste)
        liste.pack(fill="both", expand=True, padx=self.FIELD_PAD_X, pady=self.FIELD_PAD_Y)
        titel = {key: text for key, text, _gewicht, _breit, _sichtbar in self.HOME_TILE_DEFINITIONS}
        entwurf = [[key, self.home_tile_visible(key)] for key in self.home_tile_order()]

        def zeichnen(auswahl=0):
            liste.delete(0, tk.END)
            for key, sichtbar in entwurf:
                marke = self.ICONS["check"] if sichtbar else self.ICONS["task_open"]
                liste.insert(tk.END, f"{marke}  {titel.get(key, key)}")
            if entwurf:
                index = max(0, min(auswahl, len(entwurf) - 1))
                liste.selection_clear(0, tk.END)
                liste.selection_set(index)
                liste.activate(index)
                liste.see(index)

        def gewaehlt():
            auswahl = liste.curselection()
            return int(auswahl[0]) if auswahl else None

        def umschalten(_event=None):
            index = gewaehlt()
            if index is not None:
                entwurf[index][1] = not entwurf[index][1]
                zeichnen(index)
            return "break"

        def verschieben(richtung):
            index = gewaehlt()
            ziel = (index + richtung) if index is not None else None
            if index is None or ziel is None or not 0 <= ziel < len(entwurf):
                return "break"
            entwurf[index], entwurf[ziel] = entwurf[ziel], entwurf[index]
            zeichnen(ziel)
            return "break"

        def standard():
            # D12: Eine zurückgesetzte Startseite bekommt den Standard „Ruhig“.
            entwurf[:] = [[key, key in glide_home.STANDARD] for key in glide_home.KEYS]
            zeichnen(0)
            return "break"

        aktionen = ButtonFlow(outer, bg=self.theme["bg"])
        aktionen.pack(fill="x", pady=(10, 0))
        for text, befehl, farbe in (("Ein-/Ausschalten", umschalten, "confirm"),
                                    ("▲ Nach oben", lambda: verschieben(-1), "accent"),
                                    ("▼ Nach unten", lambda: verschieben(1), "accent"),
                                    ("Standard wiederherstellen", standard, "muted")):
            aktionen.add(self._make_dialog_button(aktionen, text, befehl, farbe, width=170, height=36))
        liste.bind("<Double-Button-1>", umschalten)
        liste.bind("<space>", umschalten)

        def submit(_event=None):
            vorher = dict(self.settings)
            if entwurf == [[key, key in glide_home.STANDARD] for key in glide_home.KEYS]:
                # Entspricht die Auswahl dem Standard, bleibt die Startseite
                # „nicht eingerichtet“ und folgt einem künftigen Standard.
                self.settings["home_tile_order"], self.settings["home_tiles_hidden"] = glide_home.standard_selection()
            else:
                self.settings["home_tile_order"] = [key for key, _sichtbar in entwurf]
                self.settings["home_tiles_hidden"] = [key for key, sichtbar in entwurf if not sichtbar]
            self.settings["home_columns"] = next(
                (key for key, text in self.HOME_COLUMN_CHOICES if text == spalten.get()), "auto")
            self.settings["home_calendar_mode"] = next(
                (key for key, text in self.HOME_CALENDAR_CHOICES if text == kalender.get()),
                self.HOME_CALENDAR_DEFAULT)
            self.settings["home_density"] = next(
                (key for key, text in self.HOME_DENSITY_CHOICES if text == dichte.get()),
                self.HOME_DENSITY_DEFAULT)
            # Der ältere Schalter bleibt mit der Kachel gleichbedeutend.
            self.settings["show_home_stats"] = "stats" not in self.settings["home_tiles_hidden"]
            if not self.save_settings(show_error=True):
                self.settings = vorher
                return "break"
            dialog.destroy()
            self.refresh_tree()
            return "break"

        fuss = ButtonFlow(outer, bg=self.theme["bg"])
        fuss.pack(fill="x", pady=(16, 0))
        fuss.add(self._make_dialog_button(fuss, "Speichern", submit, "confirm"))
        fuss.add(self._make_dialog_button(fuss, "Abbrechen", dialog.destroy, "muted"))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        zeichnen()
        # Drei Auswahlen nebeneinander brauchen Breite.
        self._center_dialog(dialog, min_width=840, min_height=700)
        self._schedule_windows_chrome_theme(dialog)
        liste.focus_set()
        self.run_modal(dialog)
        return "break"

    def refresh_home(self):
        with self.render_pass():
            return self._refresh_home()

    # Navigationswerte in settings.json; keine Kachel liest sie (P03r).
    HOME_SIGNATURE_IGNORED = frozenset(("active_list_id", "active_folder_id", "view_mode", "title", "recent_pages"))

    def home_signature(self):
        """Eingangsgrößen der Startseite in der Kachelansicht (P03r).

        Bis 08.10.2026 riss jeder Aufruf alle Kacheln ab und baute sie neu –
        auch bei der Rückkehr aus einer Liste ohne jede Änderung. Gleiche
        Signatur heißt: Die vorhandenen Kacheln zeigen bereits genau das.
        Datenstand und Einstellungen decken Inhalte ab – ohne die
        Navigationswerte, die jeder Ansichtswechsel mitschreibt und die keine
        Kachel liest –, Minute und Tag die Zeitbezüge, Design, Spaltenzahl,
        Kachelauswahl und Modus die Darstellung.
        """
        einstellungen = {key: value for key, value in self.settings.items() if key not in self.HOME_SIGNATURE_IGNORED}
        try:
            einstellungen_text = json.dumps(einstellungen, sort_keys=True, ensure_ascii=False, default=str)
        except (TypeError, ValueError):
            return None
        return (getattr(self, "_data_revision", 0), einstellungen_text,
                id(self.theme), datetime.now().strftime("%Y-%m-%d %H:%M"), self.home_column_count(),
                self.home_mode(), bool(getattr(self, "_home_editing", False)), self.view_mode,
                bool(getattr(self, "_timer_indicator_visible", False)), self.is_pixel_design())

    def _refresh_home(self):
        if not hasattr(self, "home_content"):
            return
        signatur = self.home_signature() if self.home_mode() not in (
            "day_review", "day_close", "day_proposal", "week_review", "calendar") else None
        if (signatur is not None and signatur == getattr(self, "_home_signature", None)
                and getattr(self, "_home_rendered_view", None) == self.HOME_VIEW
                and self.home_content.winfo_children()):
            return
        self._home_signature = None
        scroll_position = self.home_canvas.yview()[0] if getattr(self, "_home_rendered_view", None) == self.HOME_VIEW else 0
        self._home_rendered_view = self.HOME_VIEW
        self._home_columns_rendered = self.home_column_count()
        theme = self.theme
        for widget in self.home_content.winfo_children():
            widget.destroy()
        # Dieselbe Farbe erneut zu setzen zeichnete die ganze Startseite neu
        # (rund 37 ms je Aufbau); gesetzt wird nur nach einem Designwechsel.
        for widget in (self.home_frame, self.home_canvas, self.home_content):
            if widget.cget("bg") != theme["bg"]:
                widget.configure(bg=theme["bg"])
        leiste = self.home_scrollbar
        farben = (theme["bg"], theme["bg"], theme["input_border"], theme["muted"])
        if (leiste.bg_color, leiste.track_color, leiste.thumb_color, leiste.active_thumb_color) != farben:
            leiste.set_theme(*farben)
        summary = self.home_summary()
        self._home_summary = summary
        self._set_stats_text(date.today().strftime("%d.%m.%Y"))
        # Tagesbeginn und Wochenrückblick sind Unterseiten der Startseite:
        # derselbe eingebettete Bereich, kein eigenes Fenster.
        mode = self.home_mode()
        if mode in ("day_review", "day_close", "day_proposal", "week_review", "calendar"):
            (self.render_calendar if mode == "calendar" else self.render_week_review if mode == "week_review" else
             self.render_day_proposal if mode == "day_proposal" else self.render_day_review)()
            self._bind_home_wheel(self.home_content)
            self.home_content.update_idletasks()
            self._layout_home_canvas()
            self.home_canvas.yview_moveto(0)
            return
        # Zähler der Blockfarben für die Kachelköpfe des Pixel-Designs.
        pixel_block = {"n": 0}

        def label(parent, text, size=11, bold=False, color="text", surface="card",
                  pady=(0, 6), anchor="w", wrap=True):
            widget = tk.Label(parent, text=text, bg=theme[surface], fg=theme[color],
                              font=app_font(size, "bold" if bold else "normal"),
                              justify="left", anchor=anchor)
            widget.pack(fill="x", pady=pady)
            if wrap:
                def umbruch(event, target=widget):
                    # Gleiche Breite, gleicher Umbruch: Ein erneutes Setzen
                    # stieße nur eine weitere Layoutrunde an.
                    breite = max(100, event.width - 4)
                    if getattr(target, "_wrap_seen", None) != breite:
                        target._wrap_seen = breite
                        target.configure(wraplength=breite)
                widget.bind("<Configure>", umbruch)
            self._bind_home_wheel(widget)
            return widget

        def card(parent, title=None, pad_y=None):
            container = self.make_rounded_container(
                parent,
                fill_key="card",
                outline_key="line",
                radius=self.HOME_CARD_RADIUS,
                inner_pad_x=self.HOME_CARD_PAD_X,
                inner_pad_y=self.HOME_CARD_PAD_Y if pad_y is None else pad_y,
                auto_height=True,
                register=False,
            )
            container.pack(fill="x", pady=(glide_design.SPACING[0], self.HOME_CARD_GAP))
            if title and self.is_pixel_design():
                # Pixel-Design: Der Kachelkopf ist eine Farbfläche; die Farben
                # wechseln Blau, Gelb, Pink wie Bausteine.
                farbe = theme[self.PIXEL_BLOCK_KEYS[pixel_block["n"] % len(self.PIXEL_BLOCK_KEYS)]]
                pixel_block["n"] += 1
                kopf = tk.Label(container.inner, text=title, bg=farbe, fg=readable_text_color(farbe),
                                font=self.pixel_heading_font(12), anchor="w", padx=glide_design.SPACING[10], pady=glide_design.SPACING[4])
                kopf.pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[8]))
                kopf.pixel_block = True
                self._bind_home_wheel(kopf)
            elif title:
                label(container.inner, title, 13, True)
            self._bind_home_wheel(container)
            self._bind_home_wheel(container.inner)
            return container.inner

        def action(parent, text, command, color="accent", side=None, pady=3):
            width = tkfont.Font(font=app_font(10, "bold")).measure(text) + 30
            button = self._make_dialog_button(parent, text, command, theme[color],
                                               width=width, height=40)
            if isinstance(parent, ButtonFlow):
                parent.add(button)
            elif side:
                button.pack(side=side, padx=(glide_design.SPACING[0], glide_design.SPACING[6]), pady=pady)
            else:
                button.text_anchor = "w"
                button.wrap_text = True
                button.pack(fill="x", pady=pady)
            self._bind_home_wheel(button)
            return button

        def flow(parent, pady=(0, 0)):
            row = ButtonFlow(parent, bg=theme["card"])
            row.pack(fill="x", pady=pady)
            self._bind_home_wheel(row)
            return row

        def list_color(entry):
            """Themeschlüssel der Farbe einer Liste – sonst die des Ordners."""
            if not isinstance(entry, dict):
                return "accent"
            eigen = entry.get("color")
            if eigen in self.LIST_COLOR_KEYS:
                return eigen
            folder = self.get_folder(entry.get("folder_id"))
            while isinstance(folder, dict):
                geerbt = folder.get("color")
                if geerbt in self.LIST_COLOR_KEYS:
                    return geerbt
                folder = self.get_folder(folder.get("parent_id"))
            return "accent"

        # --- Kacheln ---------------------------------------------------------
        def kachel_clock(parent):
            kopf = card(parent, pad_y=12)
            kopf_zeile = tk.Frame(kopf, bg=theme["card"])
            kopf_zeile.pack(fill="x")
            self._bind_home_wheel(kopf_zeile)
            uhr = AnalogClock(
                kopf_zeile, size=62, bg_color=theme["card"], face_color=theme["card"],
                rim_color=theme["line"], mark_color=theme["muted"],
                hand_color=theme["text"], second_color=theme["ui_accent"] if self.settings.get("show_seconds", True) else theme["card"],
            )
            uhr.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[14]))
            self._bind_home_wheel(uhr)
            if self.settings.get("show_moon_phase", True):
                mond = tk.Frame(kopf_zeile, bg=theme["card"])
                mond.pack(side="right", padx=(glide_design.SPACING[10], glide_design.SPACING[0]))
                mond_icon = MoonPhase(mond, moon_phase_info(), size=44,
                                      bg_color=theme["card"], light_color=theme["flag"],
                                      dark_color=theme["input"], outline_color=theme["line"])
                mond_icon.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[6]))
                moon = moon_phase_info()
                tk.Label(mond, text=f"{moon['name']}\n{moon['percent']} % beleuchtet",
                         bg=theme["card"], fg=theme["muted"], justify="left",
                         font=app_font(8), anchor="w").pack(side="left")
                self._bind_home_wheel(mond)
            kopf_text = tk.Frame(kopf_zeile, bg=theme["card"])
            kopf_text.pack(side="left", fill="both", expand=True)
            self._bind_home_wheel(kopf_text)
            heute = date.today()
            label(kopf_text, heute.strftime("%A, %d. %B %Y").replace(
                heute.strftime("%A"), self.WEEKDAY_NAMES[heute.weekday()]).replace(
                heute.strftime("%B"), self.MONTH_NAMES[heute.month - 1]),
                14, True, pady=(glide_design.SPACING[0], glide_design.SPACING[2]), surface="card")
            naechster, naechste_liste = self.next_scheduled_item()
            if naechster is not None:
                wann = self.format_due_full(naechster.get("due"), naechster.get("due_time"))
                titel = str(naechster.get("text") or "").splitlines()[0]
                label(kopf_text, f"Als Nächstes: {wann} · {titel}",
                      10, color=list_color(naechste_liste), pady=(glide_design.SPACING[0], glide_design.SPACING[0]), surface="card")
            else:
                label(kopf_text, "Nichts Terminiertes in Sicht.", 10, color="muted",
                      pady=(glide_design.SPACING[0], glide_design.SPACING[0]), surface="card")

        def tagesziel(parent):
            """Fortschritt zum Tagesziel; nichts, solange kein Ziel gesetzt ist."""
            ziel = self.daily_goal()
            if not ziel:
                return
            geschafft = self.completions_today()
            erreicht = geschafft >= ziel
            label(parent,
                  f"Heute geschafft: {geschafft} von {ziel}"
                  + ("  – Ziel erreicht." if erreicht else ""),
                  11, True, "confirm" if erreicht else "text", pady=(glide_design.SPACING[0], glide_design.SPACING[5]))
            ProgressBar(
                parent, value=geschafft, maximum=ziel, bg_color=theme["card"],
                track_color=theme["input"],
                fill_color=theme["confirm"] if erreicht else theme["ui_accent"],
            ).pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[10]))

        def kachel_welcome(parent):
            welcome = card(parent)
            gruss_zeile = tk.Frame(welcome, bg=theme["card"])
            gruss_zeile.pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[10]))
            self._bind_home_wheel(gruss_zeile)
            flaeche, schrift = self.monogram_colors()
            monogramm = MonogramTile(
                gruss_zeile, self.settings.get("profile_logo", "G"), flaeche, schrift,
                bg_color=theme["card"], size=66, radius=17,
            )
            monogramm.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[14]))
            self._bind_home_wheel(monogramm)
            gruss_text = tk.Frame(gruss_zeile, bg=theme["card"])
            gruss_text.pack(side="left", fill="both", expand=True)
            self._bind_home_wheel(gruss_text)
            label(gruss_text, self.home_greeting(), 15, True, pady=(glide_design.SPACING[2], glide_design.SPACING[4]), surface="card")
            label(gruss_text, self.home_prompt(), color="muted", pady=(glide_design.SPACING[0], glide_design.SPACING[0]), surface="card")
            tagesziel(welcome)
            # Zehn gleich aussehende
            # Schaltflächen nebeneinander sind keine Auswahl, sondern eine
            # Wand. Vier davon führen dorthin, wo man täglich hinwill; die
            # übrigen sechs stellt man einmal ein oder braucht sie selten.
            # Sie stehen deshalb hinter einer einzigen Fläche – dieselbe
            # Auflösung, die die Pinnwand in 3.24 bekommen hat.
            schnell = flow(welcome)
            schnell.compact_keys = {"today", "more"}
            schnell.compact_below = 760
            self.home_quick_actions = schnell
            for key, text, befehl, farbe in self.home_primary_actions():
                button = action(schnell, text, befehl, farbe)
                schnell.entries[-1] = (button, key)
            weiter = action(schnell, "Weitere …", self.show_home_more_menu, "muted")
            schnell.entries[-1] = (weiter, "more")
            schnell.reflow()

        def kachel_today(parent):
            heute_iso = date.today().isoformat()
            eintraege = self.plan_day_entries(apply_filters=False, day=heute_iso)
            offen = [item for _d, _l, _i, _e, item in eintraege if not item.get("done")]
            tile = card(parent, f"{self.ICONS['today']}  Heute")
            # D12: Tagesziel und nächste Aufgabe stehen hier, solange ihre
            # eigenen Kacheln aus sind – sichtbar ist jede Angabe nur einmal.
            zusatz = glide_home.today_sections(sichtbar)
            if zusatz["goal"]:
                tagesziel(tile)
            naechste = None
            if zusatz["next"]:
                naechste, naechste_quelle = self.home_focus_candidate()
                if naechste is not None:
                    label(tile, "Als Nächstes", 10, True, "muted", pady=(glide_design.SPACING[0], glide_design.SPACING[3]))
                    action(tile, self.item_display_text(naechste).splitlines()[0],
                           lambda lid=naechste_quelle["id"], iid=naechste["id"]: self.open_task_in_source_list(lid, iid),
                           list_color(naechste_quelle))
            label(tile, "Eingeplant", 10, True, "muted", pady=(glide_design.SPACING[10] if naechste is not None else glide_design.SPACING[0], glide_design.SPACING[3]))
            if eintraege:
                planung = self.format_planning_summary(
                    self.planning_summary([item for _d, _l, _i, _e, item in eintraege], day=heute_iso))
                label(tile, f"{len(eintraege)} eingeplant · {len(offen)} offen"
                            + (f"\n{planung}" if planung else ""), color="muted")
                for _due, _l, _i, quelle, item in eintraege[:5]:
                    if item.get("done"):
                        continue
                    action(tile, self.item_display_text(item).splitlines()[0],
                           lambda lid=quelle["id"], iid=item["id"]: self.open_task_in_source_list(lid, iid),
                           list_color(quelle))
            else:
                label(tile, "Für heute ist noch nichts eingeplant.", color="muted")
            offene_eingaenge = len(self.plan_inbox_items(apply_filters=False))
            if offene_eingaenge:
                label(tile, f"{offene_eingaenge} Aufgabe(n) liegen ohne Tag im Eingang.", color="muted")
            # Zweiter Abschnitt: dieselbe Kachel, andere Frage. Fälligkeit ist
            # nicht Planung – deshalb eine eigene Überschrift und eine eigene
            # Leermeldung statt einer gemeinsamen Zahl, die beides vermischt.
            label(tile, "Heute fällig", 10, True, "muted", pady=(glide_design.SPACING[10], glide_design.SPACING[3]))
            if summary["due_lists"]:
                for eintrag, anzahl in summary["due_lists"]:
                    action(tile, f"{self.list_path_title(eintrag)}  ·  {anzahl} offen",
                           lambda lid=eintrag["id"]: self.set_active_list(lid), list_color(eintrag))
            else:
                label(tile, "Für heute sind keine offenen Aufgaben fällig.", color="muted")
            action(tile, f"{self.ICONS['today']}  Heute öffnen", self.set_today_view, "accent")

        def kachel_focus(parent):
            # Dieselbe Aufgabe, die „Heute“ unter
            # „Nächste Aufgabe“ zeigt – und der Weg genau dorthin. Die Kachel
            # hieß bis 3.24 „Fokus“; das war ein Zustand, kein Gegenstand.
            item, quelle = self.home_focus_candidate()
            tile = card(parent, f"{self.ICONS['next']}  Nächste Aufgabe")
            if item is None:
                label(tile, "Nichts steht an. Ein guter Moment, um zu planen oder Feierabend zu machen.",
                      color="muted")
                action(tile, f"{self.ICONS['in_progress']}  Demnächst öffnen",
                       self.set_in_progress_view, "due_action")
                return
            label(tile, self.item_display_text(item).splitlines()[0], 12, True)
            teile = []
            if item.get("due"):
                teile.append("Fällig " + self.format_due_full(item.get("due"), item.get("due_time")))
            if item.get("estimated_minutes") is not None:
                teile.append(self.format_estimated_minutes(item["estimated_minutes"]))
            teile.append(self.list_path_title(quelle))
            label(tile, " · ".join(teile), color="muted")
            zeile = flow(tile, pady=(glide_design.SPACING[4], glide_design.SPACING[0]))
            action(zeile, "Öffnen", lambda lid=quelle["id"], iid=item["id"]: self.open_task_in_source_list(lid, iid),
                   list_color(quelle), side="left")
            action(zeile, f"{self.ICONS['check']}  Erledigt",
                   lambda iid=item["id"]: self.update_in_progress_item(iid, "done", True),
                   "confirm", side="left")
            action(zeile, f"{self.ICONS['next']}  Im Abschnitt zeigen",
                   self.open_next_task, "due_action", side="left")

        def kachel_week(parent):
            tile = card(parent, "Die nächsten sieben Tage")
            uebersicht = self.home_week_overview()
            hoechstwert = max([anzahl for _tag, anzahl in uebersicht] + [1])
            if not any(anzahl for _tag, anzahl in uebersicht):
                label(tile, "In den nächsten sieben Tagen ist nichts fällig.", color="muted")
            for tag, anzahl in uebersicht:
                parsed = date.fromisoformat(tag)
                zeile = tk.Frame(tile, bg=theme["card"])
                zeile.pack(fill="x", pady=glide_design.SPACING[2])
                self._bind_home_wheel(zeile)
                tk.Label(zeile, text=f"{self.WEEKDAY_NAMES[parsed.weekday()][:2]} {parsed.strftime('%d.%m.')}",
                         bg=theme["card"], fg=theme["muted"], font=app_font(9), width=10,
                         anchor="w").pack(side="left")
                tk.Label(zeile, text=str(anzahl) if anzahl else "–", bg=theme["card"],
                         fg=theme["text"] if anzahl else theme["muted"], font=app_font(9, "bold"),
                         width=3, anchor="e").pack(side="right")
                balken = ProgressBar(zeile, value=anzahl, maximum=hoechstwert, bg_color=theme["card"],
                                     track_color=theme["input"], fill_color=theme["ui_accent"], height=8)
                balken.pack(side="left", fill="x", expand=True, padx=(glide_design.SPACING[8], glide_design.SPACING[8]))
                self._bind_home_wheel(balken)

        def kachel_labels(parent):
            tile = card(parent, "Labels im Bestand")
            treffer = self.home_label_overview()
            if not treffer:
                label(tile, "Noch keine Labels an offenen Aufgaben.", color="muted")
                return
            for entry, anzahl in treffer:
                zeile = tk.Frame(tile, bg=theme["card"])
                zeile.pack(fill="x", pady=glide_design.SPACING[2])
