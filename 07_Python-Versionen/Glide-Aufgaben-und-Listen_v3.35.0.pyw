    # ------------------------------------------------------------------
    # Was bei schmalem Fenster zuerst weicht.
    #
    # Die Regel stand schon fest: Essentielles bleibt, Sekundäres geht zuerst.
    # Bis 3.22 war sie nirgends umgesetzt – stattdessen schrumpfte der Titel
    # als Einziges, weil er als Letztes um den Platz bat. Am schmalen Rand
    # stand deshalb ein „…“ neben vier vollständig beschrifteten Knöpfen.
    #
    # Drei Stufen, an der Breite des Kopfbereichs gemessen. Die Schwellen sind
    # keine Gerätebreiten, sondern die Summe dessen, was in der jeweiligen
    # Stufe nebeneinanderpassen muss.
    HEADER_DENSITY_FULL = 1120      # alle Knöpfe
    HEADER_DENSITY_COMPACT = 900    # seit 27.09.2026 wie „full“: alle Knöpfe sind Symbole
    # Darunter: Drucken und Einstellungen wandern ins Überlaufmenü.
    # Gemessen wird die Breite der Aktionsreihe selbst, nicht die des
    # Fensters: Sie steht rechts neben der Seitenleiste und ist deshalb je
    # nach deren Zustand unterschiedlich breit. Drei Paare brauchen rund
    # 3 × 220 Pixel plus zweimal 12 Pixel Abstand; darunter beginnen die
    # Beschriftungen zu drängen.
    ACTION_DENSITY_MIN_WIDTH = 700
    # Dieselbe Regel für die Höhe (3.30): Bei niedrigem Fenster bekam die
    # Liste nur noch den Rest unter vier Aktionsreihen, und die Seitenleiste
    # drückte den Listenbaum auf zwei Zeilen. Gemessen wird die Fensterhöhe;
    # darunter weichen Aktionen, die auch über „⋯“, Kontextmenü, Menüleiste
    # und Kürzel erreichbar sind.
    # 850 statt 900: Die Standardgröße 1280 × 860 zeigt damit alles.
    HEIGHT_DENSITY_FULL = 850       # alle Aktionsreihen
    HEIGHT_DENSITY_COMPACT = 780    # je Rahmen eine Reihe
    # Darunter: nur die erste Aktionsreihe, Seitenleistenknöpfe in einer Zeile.

    def height_density(self, height=None):
        """Welche Höhenstufe zur aktuellen Fensterhöhe passt."""
        if height is None:
            try:
                height = self.root.winfo_height()
            except tk.TclError:
                return "full"
        if height <= 1 or height >= self.HEIGHT_DENSITY_FULL:
            return "full"
        return "compact" if height >= self.HEIGHT_DENSITY_COMPACT else "minimal"

    def bind_main_window_resize(self, callback):
        """Meldet <Configure> nur des Hauptfensters an Python.

        Ein Binding am Hauptfenster gilt über dessen Bindtag für jedes Kind.
        Ein Neuaufbau der Startseite rief so rund 5.000-mal Python auf, nur
        um festzustellen, dass das Ereignis von einem Kind kam (P03,
        02.10.2026). Der Vergleich steht deshalb in Tcl; Python sieht nur die
        Größenänderung des Fensters selbst.
        """
        befehl = self.root.register(lambda breite, hoehe: callback(types.SimpleNamespace(
            widget=self.root, width=int(breite), height=int(hoehe))))
        self.root.bind("<Configure>", f'+if {{"%W" eq "{self.root}"}} {{{befehl} %w %h}}')

    def sync_height_density(self, event=None):
        """Reagiert auf Größenänderungen des Hauptfensters (nicht seiner Kinder)."""
        if event is not None and (event.widget is not self.root or event.height <= 1):
            # Beim Neuaufbau meldet Tk kurz eine Höhe von 1 Pixel; die fiele
            # sonst auf „alles zeigen“ zurück, bis das Fenster wieder bewegt wird.
            return
        stufe = self.height_density(event.height if event is not None else None)
        if stufe == getattr(self, "_height_density", None):
            return
        self._height_density = stufe
        self._action_density_columns = None
        self.sync_action_density()
        arbeitsbereich = getattr(self, "workspace", None)
        if self.view_mode in (self.LIBRARY_VIEW, self.TEMPLATE_VIEW) or (
                arbeitsbereich is not None and arbeitsbereich.visible and arbeitsbereich.mode == "board"):
            self.refresh_tree()

    def header_density(self, width=None):
        """Welche Stufe der Kopfzeile zur aktuellen Breite passt."""
        if width is None:
            kopf = getattr(self, "header_frame", None)
            width = kopf.winfo_width() if kopf is not None else 0
        if width <= 1:
            return "full"
        if width >= self.HEADER_DENSITY_FULL:
            return "full"
        if width >= self.HEADER_DENSITY_COMPACT:
            return "compact"
        return "minimal"

    def sync_header_density(self, event=None):
        """Blendet sekundäre Bedienelemente nach der verfügbaren Breite aus."""
        if not hasattr(self, "header_controls"):
            return
        stufe = self.header_density(event.width if event is not None else None)
        if stufe == getattr(self, "_header_density", None):
            return
        self._header_density = stufe
        self.update_stats_label()
        # Die Zahl offener Hinweise ist die eigentliche Information; das Wort
        # „Benachrichtigungen“ ist nur ihre Überschrift.
        self.apply_reminder_badge()
        # Das Zahnrad ist die äußerste Schaltfläche der
        # Kopfzeile und steht damit auf derselben rechten Flucht wie
        # „Hinzufügen" und „Anzeige" darunter – also ohne rechten Abstand.
        # Bis 3.23 packte diese Stelle es mit `padx=(0, 8)` neu, sobald die
        # Dichtestufe einmal wechselte; danach stand es acht Pixel vor der
        # Flucht, ohne dass am Aufbau etwas zu sehen gewesen wäre.
        self.pack_header_controls()
        self.sync_header_logo()
        self.sync_action_density()
        self.update_header_title()

    def pack_header_controls(self):
        """Packt die Kopfzeilenknöpfe in fester Reihenfolge von rechts nach links.

        Bis 26.09.2026 packte der Dichtewechsel einzelne Knöpfe neu. Tk hängt
        einen neu gepackten Knopf hinten an – bei `side="right"` also links.
        Nach dem ersten Wechsel stand das Zahnrad ganz links statt auf der
        rechten Flucht, und im Minimalzustand der Überlauf links außen. Jetzt
        gilt eine Reihenfolge; gepackt wird nur, wenn sie sich ändert.
        """
        leiste = getattr(self, "header_controls", None)
        if leiste is None:
            return
        minimal = getattr(self, "_header_density", None) == "minimal"
        pending = bool(getattr(self, "_pending_reminder_count", 0))
        reihe = (
            ("header_overflow_button", minimal and not pending, (0, 0)),
            ("settings_button", not minimal and not pending, (0, 0)),
            ("notifications_button", pending, (0, 0)),
            ("capture_button", True, (0, 8)),
            ("search_button", True, (0, 8)),
            ("sidebar_toggle_button", True, (0, 8)),
            ("timer_button", bool(getattr(self, "_timer_indicator_visible", False)), (0, 8)),
        )
        soll = [(getattr(self, name, None), rand) for name, sichtbar, rand in reihe
                if sichtbar and getattr(self, name, None) is not None]
        try:
            if [str(knopf) for knopf, _rand in soll] == [str(knopf) for knopf in leiste.pack_slaves()]:
                return
            for knopf in leiste.pack_slaves():
                knopf.pack_forget()
            for knopf, rand in soll:
                knopf.pack(side="right", padx=rand)
        except tk.TclError:
            pass

    def explain_saved_filter_item(self, list_id, item_id):
        """„Warum steht das hier?“ – jede Bedingung des Filters mit erfüllt/verfehlt (D-03)."""
        bedingungen = self.saved_filters.explain_item(list_id, item_id)
        if bedingungen is None:
            self.show_info("Filter erklären", "Der Punkt oder der Filter ist nicht mehr vorhanden.")
            return "break"
        found = self.find_item_in_lists(item_id)
        titel = self.item_display_text(found[0]) if found else "Punkt"
        if not bedingungen:
            text = "Der Filter setzt keine Bedingung: Er zeigt jede planbare Aufgabe."
        else:
            text = "\n".join(f"{'✓' if b['ok'] else '✗'}  {b['title']}: {b['detail']}" for b in bedingungen)
        self.show_info(f"Warum steht „{titel}“ hier?", text)
        return "break"

    def explain_saved_filter(self, event=None):
        """„Ausgeblendet: N“ erklären – je verfehlter Bedingung die Anzahl (D-03)."""
        criteria = self.saved_filters.current()
        if self.view_mode != "saved_filter" or criteria is None:
            self.show_info("Filter erklären", "Öffne zuerst einen gespeicherten Filter (Ansicht › Oberfläche › Gespeicherte Filter …).")
            return "break"
        passend, ausgeblendet, gruende = self.saved_filters.hidden_reasons(criteria)
        zeilen = [f"Passend: {passend} · Ausgeblendet: {ausgeblendet}"]
        if gruende:
            zeilen.append("Ausgeblendet wegen (erste verfehlte Bedingung):")
            zeilen += [f"• {name}: {anzahl}" for name, anzahl in gruende]
        zeilen.append("Bedingungen: " + self.saved_filters.summary(criteria))
        self.show_info(f"Filter „{criteria.get('name', '')}“", "\n".join(zeilen))
        return "break"

    def show_header_overflow_menu(self, event=None):
        """Die bei schmalem Fenster ausgeblendeten Aktionen als Menü."""
        menu = self._new_themed_popup_menu()
        menu.add_command(label="Drucken und PDF …", command=self.show_print_dialog)
        menu.add_command(label="Änderungsverlauf", command=self.open_history_view)
        menu.add_command(label="Einstellungen …", command=self.show_settings_dialog)
        menu.add_separator()
        menu.add_command(label="Erledigte Punkte löschen", command=lambda: self.remove_done_items())
        menu.add_command(label="Liste leeren", command=self.clear_list)
        menu.add_command(label="Löschen", command=self.delete_item)
        menu.add_command(label="Bearbeiten", command=self.edit_item)
        menu.add_command(label="Rückgängig", command=self.undo_last_change)
        menu.add_separator()
        menu.add_command(label="Alle Aktionen durchsuchen …", command=self.show_actions_dialog)
        knopf = getattr(self, "header_overflow_button", None)
        try:
            if knopf is not None and knopf.winfo_ismapped():
                menu.tk_popup(knopf.winfo_rootx(), knopf.winfo_rooty() + knopf.winfo_height())
            else:
                menu.tk_popup(self.root.winfo_pointerx(), self.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def sync_action_density(self, event=None):
        """Ordnet die Auswahlleiste nach der Breite, ohne Knöpfe zu stauchen.

        Breit: Anzahl und alle fünf Knöpfe. Darunter weicht zuerst die Anzahl,
        bei Mindestbreite bleiben Wichtigkeit, Fällig, Einplanen und Löschen.
        Abgeleitete Ansichten zeigen die gemeinsame Einplanen-Aktion; andere
        Änderungen bleiben dort im Kontextmenü.
        """
        rahmen = getattr(self, "button_frame", None)
        leiste = getattr(self, "selection_bar", None)
        if rahmen is None or leiste is None:
            return
        try:
            breite = int(rahmen.winfo_width())
        except tk.TclError:
            return
        if breite <= 1:
            return
        stufe = 2 if breite >= self.SELECTION_BAR_FULL else 1 if breite >= self.SELECTION_BAR_COMPACT else 0
        signature = (stufe, self.view_mode in self.DERIVED_ITEM_VIEWS)
        if signature == getattr(self, "_action_density_columns", None):
            return
        self._action_density_columns = signature
        sichtbar = list(self.selection_buttons) if stufe else [self.flag_button, self.due_button, self.plan_button, self.delete_button]
        if self.view_mode in self.DERIVED_ITEM_VIEWS:
            sichtbar = [self.plan_button]
        try:
            for widget in (self.selection_count_label, *self.selection_buttons):
                widget.grid_forget()
            for spalte in range(6):
                leiste.inner.columnconfigure(spalte, weight=0, uniform="")
            spalte = 0
            if stufe == 2:
                self.selection_count_label.grid(row=0, column=0, sticky="w", padx=(6, 12))
                spalte = 1
            for index, knopf in enumerate(sichtbar):
                leiste.inner.columnconfigure(spalte + index, weight=1, uniform="auswahl")
                knopf.grid(row=0, column=spalte + index, sticky="ew",
                           padx=(0, 0 if index == len(sichtbar) - 1 else 6))
        except tk.TclError:
            pass

    # Breite der Inhaltsspalte, ab der die Auswahlleiste mehr zeigt: fünf
    # Knöpfe zu rund 110 Pixeln plus Abstände, mit Anzahl rund 120 mehr.
    SELECTION_BAR_FULL = 720
    SELECTION_BAR_COMPACT = 600

    def selection_bar_ids(self):
        """Markierte Punkte, an denen die Auswahlleiste wirkt."""
        if self.view_mode == "trash":
            return []
        if self.view_mode in self.DERIVED_ITEM_VIEWS:
            return self.quick_plan_selection()
        try:
            return list(self.get_selected_item_ids() or [])
        except (AttributeError, tk.TclError):
            return []

    def sync_selection_bar(self, event=None):
        """Zeigt die Auswahlleiste im Kartenfuß, solange Punkte markiert sind.

        Sie ersetzt dort den Hinweis; der Fuß behält seine Höhe, die Liste
        darüber ändert sich nicht.
        """
        if getattr(self, "button_frame", None) is None or getattr(self, "selection_bar", None) is None:
            return
        ids = self.selection_bar_ids()
        if ids:
            try:
                self.selection_count_label.configure(
                    text="1 Punkt" if len(ids) == 1 else f"{len(ids)} Punkte")
            except tk.TclError:
                pass
        self.sync_card_foot()

    def show_selection_labels_menu(self, event=None):
        """Labels der markierten Punkte zuweisen oder lösen."""
        items = [found[0] for found in (self.find_item(item_id) for item_id in self.selection_bar_ids()) if found]
        if not items:
            return "break"
        menu = self._new_themed_popup_menu()
        self._popup_at_widget(self._add_label_cascade(menu, items), self.labels_button)
        return "break"

    def update_path_row(self):
        """„Zurück zur Pinnwand“ neben dem Titel, solange eine Zeichnung von einer Karte aus offen ist."""
        row = getattr(self, "path_row", None)
        # Beim Schließen meldet der Kopf noch eine Größenänderung; dann gibt es
        # den Rahmen schon nicht mehr.
        if row is None or not row.winfo_exists():
            return
        rueckweg = self.board_return_target()
        signature = (tuple(sorted(self.theme.items())), bool(rueckweg))
        if signature == getattr(self, "_path_signature", None):
            return
        self._path_signature = signature
        for child in row.winfo_children():
            child.destroy()
        if not rueckweg:
            if row.winfo_manager():
                row.pack_forget()
            return
        # Aus einer Zeichnungskarte heraus geöffnet (ZF-100): Der Rückweg
        # führt auf dieselbe Pinnwand. Er steht rechts neben dem Titel in
        # derselben Zeile und ändert deshalb keine Höhe.
        zurueck = CanvasLabel(row, text=f"{self.ICONS['back']} Zurück zur Pinnwand", bg=self.theme["bg"],
                              fg=self.theme["ui_accent"], font=app_font(9, "bold"), cursor="hand2", takefocus=1)
        zurueck.pack(side="left")
        for sequence in ("<Button-1>", "<Return>", "<space>"):
            zurueck.bind(sequence, lambda _event: self.return_to_board())
        if not row.winfo_manager():
            row.pack(side="left", anchor="center", padx=(glide_design.SPACING[14], glide_design.SPACING[0]), after=self.title_label)

    def board_return_target(self):
        ziel = getattr(self, "_board_return", None)
        if not ziel or self.view_mode != "list" or self.active_list_id != ziel.get("page_id"):
            return None
        return ziel

    def return_to_board(self):
        ziel = self.board_return_target()
        self._board_return = None
        if not ziel:
            return "break"
        scope = ziel.get("scope") or ""
        if scope == ItemWorkspace.GLOBAL_SCOPE:
            self.open_global_board()
        elif scope.startswith("list:") and any(entry.get("id") == scope[5:] for entry in self.lists):
            self.set_active_list(scope[5:])
            self.workspace.set_mode("board")
        elif scope.startswith("folder:") and self.get_folder(scope[7:]):
            self.set_active_folder(scope[7:])
            self.workspace.set_mode("board")
        return "break"

    def relative_day_text(self, iso_value, today=None):
        """„heute“, „morgen“, „in 3 Tagen“, „vor 2 Tagen“ – sonst das Datum."""
        tag = self.normalize_due(iso_value)
        if not tag:
            return ""
        heute = today or date.today()
        abstand = (date.fromisoformat(tag) - heute).days
        if abstand == 0:
            return "heute"
        if abstand == 1:
            return "morgen"
        if abstand == -1:
            return "gestern"
        if 1 < abstand <= 6:
            return f"in {abstand} Tagen"
        if -6 <= abstand < -1:
            return f"vor {-abstand} Tagen"
        return self.format_due_display(tag)

    def page_chips(self):
        """Die Kennzahlen der geöffneten Seite als kurze Texte (AO-060)."""
        workspace = getattr(self, "workspace", None)
        key = ("page_chips", self.view_mode, self.active_list_id, self.active_folder_id,
               workspace.visible if workspace else False, workspace.mode if workspace else None,
               date.today())
        return list(self.render_cached(key, self._page_chips))

    def list_metrics(self, list_id):
        today = date.today()
        def calculate():
            entry = next((value for value in self.lists if value.get("id") == list_id), None)
            return glide_metrics.summarize(
                entry.get("items", []) if entry else [], walk=self.walk_items,
                schedulable=self.is_schedulable_item, normalize_due=self.normalize_due,
                regular_labels=self.regular_label_ids(), today=today)
        return self.render_cached(("list_metrics", list_id, today), calculate)

    def _page_chips(self):
        if self.view_mode == "list" and self.active_list_id and not (
                getattr(self, "workspace", None) is not None and self.workspace.visible and self.workspace.mode != "board"):
            entry = self.current_list()
            if not entry:
                return []
            if self.is_gallery_list(entry):
                anzahl = len(entry.get("attachments") or [])
                return ["1 Bild" if anzahl == 1 else f"{anzahl} Bilder"]
            if self.is_drawing_list(entry):
                dokument = entry.get("drawing") or {}
                groesse = dokument.get("width") or glide_drawing.WIDTH
                chips = [f"{groesse} × {groesse}", f"{len(dokument.get('palette') or [])} Farben"]
                try:
                    zellen = bytes.fromhex("".join(dokument.get("rows") or []))
                    chips.append(f"{len(zellen) - zellen.count(0)} Zellen bemalt")
                except ValueError:
                    pass
                return chips
            metrics = self.list_metrics(entry["id"])
            offen = metrics.total - metrics.done
            chips = [f"{offen} offen" if metrics.total else "Noch keine Aufgaben"]
            # Der Fortschritt stand bis 27.09.2026 nur rechts neben dem Titel.
            if metrics.done:
                chips.append(f"{metrics.done} erledigt")
            ueberfaellig = metrics.overdue
            if ueberfaellig:
                chips.append(f"{ueberfaellig} überfällig")
            naechste = metrics.next_due
            if naechste:
                chips.append(f"nächste Fälligkeit {self.relative_day_text(naechste)}")
            labels = metrics.labels
            if labels:
                chips.append(f"{len(labels)} Label" + ("s" if len(labels) != 1 else ""))
            return chips
        if self.view_mode == "folder" and self.active_folder_id:
            listen = self.get_folder_lists_recursive(self.active_folder_id)
            metrics = [self.list_metrics(entry["id"]) for entry in listen]
            total = sum(value.total for value in metrics)
            offen = total - sum(value.done for value in metrics)
            chips = [f"{len(listen)} Seite" + ("n" if len(listen) != 1 else "")]
            if total:
                chips.append(f"{offen} offen")
            ueberfaellig = sum(value.overdue for value in metrics)
            if ueberfaellig:
                chips.append(f"{ueberfaellig} überfällig")
            return chips
        return []

    def update_page_chips(self):
        zeile = getattr(self, "page_chip_row", None)
        if zeile is None or not zeile.winfo_exists():
            return
        chips = self.page_chips()
        notiz, bearbeitbar = getattr(self, "_chip_note", None) or ("", False)
        notiz = self.header_note_text()
        signatur = (tuple(chips), notiz, bearbeitbar, self.theme.get("bg"), self.theme.get("muted"))
        sichtbar = bool(chips or notiz)
        if signatur == getattr(self, "_chip_signature", None) and sichtbar == bool(zeile.winfo_manager()):
            return
        self._chip_signature = signatur
        for kind in zeile.winfo_children():
            kind.destroy()
        if not sichtbar:
            if zeile.winfo_manager():
                zeile.pack_forget()
            return
        # Kennzahlen als Text mit Trennpunkt, ohne Kasten: Auf dem Verlauf stand
        # jede als eigenes Feld in der Eingabefarbe (Rückmeldung 26.09.2026).
        for index, text in enumerate(chips):
            CanvasLabel(zeile, text=("·  " if index else "") + text, bg=self.theme["bg"], fg=self.theme["muted"],
                        font=app_font(8, "bold"), padx=glide_design.SPACING[0], pady=glide_design.SPACING[1]).pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[6]))
        if notiz:
            vorsatz = "·  " if chips else ""
            etikett = CanvasLabel(zeile, text=vorsatz + notiz, bg=self.theme["bg"], fg=self.theme["muted"],
                                  font=app_font(8, "italic"), padx=glide_design.SPACING[0], pady=glide_design.SPACING[1],
                                  cursor="hand2" if bearbeitbar else "")
            etikett._header_note = (vorsatz, notiz)
            if bearbeitbar:
                etikett.bind("<Button-1>", self.edit_page_note)
                self.add_tooltip(etikett, "Beschreibungstext bearbeiten")
            etikett.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[6]))
        if not zeile.winfo_manager():
            zeile.pack(side="left", anchor="w", fill="x", expand=True, pady=(glide_design.SPACING[0], glide_design.SPACING[4]))
        self.fit_page_chips()

    def fit_page_chips(self, event=None):
        """Zeigt nur ganze Kennzahlen: Was nicht passt, fällt von hinten weg.

        Vorher schnitt die Zeile den letzten Chip mitten im Wort ab – bei
        Mindestbreite blieb davon ein einzelner Strich stehen.
        """
        zeile = getattr(self, "page_chip_row", None)
        if zeile is None or not zeile.winfo_exists():
            return
        breite = event.width if event is not None else zeile.winfo_width()
        if breite <= 1:
            return
        belegt, voll = 0, False
        for chip in zeile.winfo_children():
            if getattr(chip, "_is_backdrop", False):
                continue
            notiz = getattr(chip, "_header_note", None)
            if notiz is not None and not voll:
                # Die Notiz steht zuletzt und kürzt sich auf den Rest der Zeile.
                vorsatz, text = notiz
                schrift = self.measurement_font(chip.cget("font"))
                rest = breite - belegt - 6 - schrift.measure(vorsatz) - 4
                kurz = self.shorten_to_width(text, schrift, rest) if rest > 40 else ""
                if kurz:
                    if chip.cget("text") != vorsatz + kurz:
                        chip.configure(text=vorsatz + kurz)
                    if not chip.winfo_manager():
                        chip.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[6]))
                    continue
            bedarf = chip.winfo_reqwidth() + 6
            if not voll and belegt + bedarf <= breite:
                belegt += bedarf
                if not chip.winfo_manager():
                    chip.pack(side="left", padx=(glide_design.SPACING[0], glide_design.SPACING[6]))
            else:
                voll = True
                if chip.winfo_manager():
                    chip.pack_forget()

    @staticmethod
    def packed_width(widget):
        """Wunschbreite eines gepackten Rahmens aus seinen Kindern – ohne Leerlauf abzuwarten."""
        kinder = widget.pack_slaves()
        if not kinder:
            return widget.winfo_reqwidth()
        breiten = []
        for kind in kinder:
            info = kind.pack_info()
            rand = info.get("padx", 0)
            rand = sum(int(float(teil)) for teil in (rand if isinstance(rand, (tuple, list)) else str(rand).split()))
            breiten.append((kind.winfo_reqwidth() + rand, info.get("side")))
        if all(seite in ("left", "right") for _breite, seite in breiten):
            return sum(breite for breite, _seite in breiten)
        return max(breite for breite, _seite in breiten)

    def update_header_title(self, event=None):
        """Zeigt den Seitentitel und kürzt ihn nur, wenn der Platz nicht reicht.

        Gespeicherter Titel, Fenstertitel und alle Exporte bleiben vollständig.
        """
        self.update_path_row()
        self.update_page_chips()
        self.fit_stats_text()
        label = getattr(self, "title_label", None)
        header = getattr(self, "header_frame", None)
        if label is None or header is None:
            return
        full_title = self.get_display_title()
        try:
            available = header.winfo_width()
            if available <= 1:
                label.configure(text=full_title)
                return
            logo = getattr(self, "header_logo", None)
            for widget, gap in (
                (getattr(self, "header_controls", None), 12),
                (logo if logo is not None and logo.winfo_manager() else None, self.HEADER_LOGO_GAP),
            ):
                if widget is not None:
                    # Die Wunschbreite eines Rahmens rechnet Tk erst im
                    # Leerlauf nach; die seiner Kinder stimmt sofort. Nach
                    # einem Größenwechsel kürzte der Titel sonst mit der
                    # alten Breite der Kennzahlen.
                    available -= self.packed_width(widget) + gap
            available = max(self.HEADER_TITLE_MIN_WIDTH, available)
            # Die Messschrift folgt der Schrift des Titels. Vorher blieb sie
            # nach einem Wechsel der Schriftgröße auf dem alten Stand, und der
            # große Titel wurde mit der kleinen Breite gekürzt – er ragte dann
            # über seinen Platz hinaus.
            schluessel = str(label.cget("font"))
            font = getattr(self, "_header_title_measure_font", None)
            if font is None or getattr(self, "_header_title_measure_key", None) != schluessel:
                font = tkfont.Font(root=self.root, font=label.cget("font"))
                self._header_title_measure_font = font
                self._header_title_measure_key = schluessel
            # Der Titel ist ein CanvasLabel: Er braucht zur Schriftbreite noch
            # seinen Innenabstand. Ohne diesen Zuschlag blieb der gekürzte Titel
            # bei großer Schrift ein paar Pixel zu breit („Sonntag“, 27.09.2026).
            if hasattr(label, "text_size"):
                available -= max(0, label.text_size()[0] - font.measure(label.cget("text")))
            text = full_title
            if font.measure(text) > available:
                ellipsis = "…"
                while text and font.measure(text + ellipsis) > available:
                    text = text[:-1]
                text = (text.rstrip() + ellipsis) if text else ellipsis
            if label.cget("text") != text:
                label.configure(text=text)
        except tk.TclError:
            pass

    def apply_theme(self):
        vorher = getattr(self, "theme", None) or {}
        self.theme = self.active_theme()
        self.root.configure(bg=self.theme["bg"])
        # Nicht jedes Widget ist für den Designwechsel eingetragen. Solche
        # Nachzügler behielten Grund- und Kartenfarbe des alten Designs und
        # standen seit den verlaufsabhängigen Farben als Kästen da (Rückmeldung
        # 26.09.2026). Ein Durchgang zieht beide Farben im ganzen Fenster nach.
        zuordnung = {str(vorher.get(schluessel, "")).lower(): self.theme[schluessel]
                     for schluessel in ("bg", "card")
                     if vorher.get(schluessel) and str(vorher.get(schluessel)).lower() != str(self.theme[schluessel]).lower()}
        if zuordnung and hasattr(self, "_recolor_tree"):
            try:
                self._recolor_tree(self.root, zuordnung, karten_mit=True)
            except tk.TclError:
                pass
        # Die Überschrift „Seiten“ trägt ihre Farben selbst (Auswahl, Hover);
        # sie blieb nach einem Designwechsel in der alten Schriftfarbe stehen
        # und war im Dunkeldesign kaum lesbar (gefunden 27.09.2026). Dasselbe
        # gilt für „Notizen“.
        self.update_pages_heading()
        self.update_notes_heading()
        self.update_drawings_heading()
        # Der Seitentitel wechselt mit dem Design die Schrift (Pixelschrift, 3.30).
        titel = getattr(self, "title_label", None)
        if titel is not None:
            try:
                titel.configure(font=self.header_title_font())
            except tk.TclError:
                pass
        # Das Logo trägt die Akzentfarbe (29.09.2026).
        self.sync_header_logo()

        for widget, bg_key, fg_key in self.theme_widgets:
            try:
                config = {"bg": self.theme[bg_key]}
                if fg_key is not None:
                    config["fg"] = self.theme[fg_key]
                widget.configure(**config)
            except tk.TclError:
                pass

        self.entry.configure(
            bg=self.theme["input"],
            fg=self.theme["placeholder"] if getattr(self, "entry_placeholder_active", False) else self.theme["text"],
            insertbackground=self.theme["text"],
            highlightthickness=0,
            highlightbackground=self.theme["input"],
            highlightcolor=self.theme["input"],
            relief="flat",
            bd=0,
            borderwidth=0,
        )
        if hasattr(self, "search_entry"):
            self.search_entry.configure(
                bg=self.theme["input"],
                fg=self.theme["placeholder"] if getattr(self, "search_placeholder_active", False) else self.theme["text"],
                insertbackground=self.theme["text"],
                highlightthickness=0,
                highlightbackground=self.theme["input"],
                highlightcolor=self.theme["input"],
                relief="flat",
                bd=0,
                borderwidth=0,
            )
        check = getattr(self, "hide_done_check", None)
        if check is not None:
            check.configure(
                bg=self.theme["input"],
                fg=self.theme["text"],
                activebackground=self.theme["input"],
                activeforeground=self.theme["text"],
                selectcolor=self.theme["input"],
            )
        if hasattr(self, "scrollbar"):
            self.scrollbar.set_theme(
                bg_color=self.theme["card"],
                track_color=self.theme["card"],
                thumb_color=self.theme["input_border"],
                active_thumb_color=self.theme["muted"],
            )
        if hasattr(self, "sidebar_listbox"):
            for style_name, surface_key in (("Sidebar.Treeview", "card"), ("System.Treeview", "card")):
                self.style.configure(
                    style_name,
                    background=self.theme[surface_key],
                    fieldbackground=self.theme[surface_key],
                    foreground=self.theme["text"],
                    borderwidth=0,
                    relief="flat",
                    rowheight=34,
                    font=self.sidebar_row_font(),
                )
                try:
                    self.style.layout(style_name, [("Treeview.treearea", {"sticky": "nswe"})])
                except tk.TclError:
                    pass
                self.style.map(
                    style_name,
                    background=[("selected", self.theme["selection"])],
                    foreground=[("selected", self.theme["selection_text"])],
                )
            # Im Hauptbaum bleibt der native Klapppfeil erhalten, erhält aber
            # Luft innerhalb des Auswahlbalkens. Der Eingang braucht keinen
            # Klapppfeil und kann deshalb exakt an der 10-Pixel-Kante beginnen.
            self.style.configure(
                "Sidebar.Treeview.Item",
                padding=(self.SIDEBAR_ITEM_LEFT_PADDING, 0, 0, 0),
            )
            self.style.configure("Sidebar.Treeview", indent=self.SIDEBAR_INDENT)
            try:
                self.style.layout(
                    "System.Treeview.Item",
                    [
                        (
                            "Treeitem.padding",
                            {
                                "sticky": "nswe",
                                "children": [
                                    ("Treeitem.image", {"side": "left", "sticky": ""}),
                                    ("Treeitem.text", {"sticky": "nswe"}),
                                ],
                            },
                        )
                    ],
                )
                self.style.configure(
                    "System.Treeview.Item",
                    padding=(self.SYSTEM_ITEM_LEFT_PADDING, 0, 0, 0),
                )
            except tk.TclError:
                pass
            for sidebar_tree_name in ("system_listbox", "sidebar_listbox", "pages_listbox", "notes_listbox", "drawings_listbox"):
                sidebar_tree = getattr(self, sidebar_tree_name, None)
                if sidebar_tree is None:
                    continue
                sidebar_tree.tag_configure("folder", foreground=self.theme["muted"])
                sidebar_tree.tag_configure("list", foreground=self.theme["text"])
                sidebar_tree.tag_configure(
                    "system",
                    foreground=self.theme["text"],
                    font=self.sidebar_section_font(),
                )
                sidebar_tree.tag_configure("drop_target", background=self.theme["input_border"])
                # Der Hover setzt ausschließlich den Hintergrund. Vordergrund-
                # farben aus den Farbtags bleiben dadurch erhalten, und der
                # Auswahlzustand hat weiterhin Vorrang.
                sidebar_tree.tag_configure("hover", background=self.theme["hover"])
                for color_key in self.LIST_COLOR_KEYS:
                    sidebar_tree.tag_configure(f"listcolor_{color_key}", foreground=self.theme[color_key])

        self.style.configure(
            "App.Treeview",
            background=self.theme["card"],
            fieldbackground=self.theme["card"],
            foreground=self.theme["text"],
            borderwidth=0,
            relief="flat",
            rowheight=glide_design.ROW_HEIGHTS["task"],
                    font=self.tree_font(),
        )
        self.style.configure(
            "App.Treeview.Heading",
            background=self.theme["hover"],
            foreground=self.theme["text"],
            relief="flat",
            font=app_font(10, "bold"),
        )
        # Der Text der Überschrift liegt links in der Zelle.
        # Mit „we" füllte er die ganze Breite und stand damit mittig über
        # linksbündigen Werten.
        self.style.layout("App.Treeview.Heading", [("Treeheading.cell", {"sticky": "nswe", "children": [
            ("Treeheading.padding", {"sticky": "nswe", "children": [("Treeheading.text", {"sticky": "w"})]})]})])
        self.style.configure(
            "App.Treeview.Item",
            padding=(self.SIDEBAR_ITEM_LEFT_PADDING, 0, 0, 0),
        )
        try:
            # Entfernt die native Treeview-Rahmen-/Focus-Outline um den Listenbereich.
            self.style.layout("App.Treeview", [("Treeview.treearea", {"sticky": "nswe"})])
        except tk.TclError:
            pass
        self.style.map(
            "App.Treeview",
            background=[("selected", self.theme["selection"])],
            foreground=[("selected", self.theme["selection_text"])],
        )
        # Auch die deaktivierte Auswahl bleibt lesbar –
        # ohne diese Zuordnung färbt Tk sie systemabhängig grau auf grau.
        self.style.map(
            "App.Treeview",
            background=[("selected", "!focus", self.theme["selection"]),
                        ("selected", self.theme["selection"])],
            foreground=[("selected", "!focus", self.theme["selection_text"]),
                        ("selected", self.theme["selection_text"])],
        )

        self.style.configure("Dialog.Treeview", background=self.theme["card"],
                             fieldbackground=self.theme["card"], foreground=self.theme["text"],
                             borderwidth=0, relief="flat", font=app_font(11), rowheight=38)
        self.style.layout("Dialog.Treeview", [("Treeview.treearea", {"sticky": "nswe"})])
        self.style.configure("Dialog.Treeview.Heading", background=self.theme["hover"],
                             foreground=self.theme["text"], relief="flat", font=app_font(10, "bold"))
        # „we" ließ den Überschriftentext die ganze Zelle
        # füllen und damit über linksbündigen Werten mittig stehen. Die
        # Hauptliste hatte das in 3.22 bekommen, die Dialogtabellen nicht.
        self.style.layout("Dialog.Treeview.Heading", [("Treeheading.cell", {"sticky": "nswe", "children": [
            ("Treeheading.padding", {"sticky": "nswe", "children": [
                ("Treeheading.text", {"sticky": "w"})]})]})])
        self.style.map("Dialog.Treeview", background=[("selected", self.theme["selection"])],
                       foreground=[("selected", self.theme["selection_text"])])
        # Ohne eigene Zuordnung nimmt Tk für den Zustand
        # „active" – die Überschrift unter dem Mauszeiger – seine eigene helle
        # Systemfarbe, behält aber die Schriftfarbe des Themes. Im Dunkelmodus
        # ergab das weiße Schrift auf weißem Grund: Die Überschrift
        # verschwand, sobald man sie anfasste. Beide Tabellenstile bekommen
        # deshalb eine ausdrückliche Hover-Farbe, deren Schrift aus der
        # Helligkeit der Fläche folgt.
        for stil in ("App.Treeview.Heading", "Dialog.Treeview.Heading"):
            kopf_hover = mix_hex_colors(self.theme["hover"], self.theme["ui_accent"], 0.22)  # noqa: B023
            self.style.map(
                stil,
                background=[("active", kopf_hover), ("pressed", kopf_hover)],
                foreground=[("active", readable_text_color(kopf_hover)),
                            ("pressed", readable_text_color(kopf_hover))],
                relief=[("active", "flat"), ("pressed", "flat")],
            )

        if hasattr(self, "tree"):
            self.tree.tag_configure("today_source", foreground=self.theme["muted"],
                                    font=app_font(glide_design.FONT_SIZES["source"]))
            self.tree.tag_configure("open", foreground=self.theme["text"])
            self.tree.tag_configure("priority_low", foreground=self.theme["priority_low"])
            self.tree.tag_configure("priority_medium", foreground=self.theme["priority_medium"])
            self.tree.tag_configure("priority_high", foreground=self.theme["priority_high"])
            self.tree.tag_configure("overdue", foreground=self.theme["overdue"])
            self.tree.tag_configure("due_today", foreground=self.theme["due_today"])
            self.tree.tag_configure("done", foreground=self.theme["muted"])
            self.tree.tag_configure("empty", foreground=self.theme["muted"])
            # Elternpunkt eines Filtertreffers in der verschachtelten Tabelle (AO-030).
            self.tree.tag_configure("context", foreground=self.theme["muted"])
            # Detailzeilen stehen unter ihrem Punkt und treten zurück.
            self.tree.tag_configure("detail", foreground=self.theme["muted"])
            self.tree.tag_configure("folder_list", foreground=self.theme["text"])
            self.tree.tag_configure(
                "group_item",
                foreground=self.theme["text"],
                font=self.group_row_font(),
            )
            self.tree.tag_configure(
                "heading_item",
                foreground=self.theme["text"],
                font=self.heading_row_font(),
            )
            # Die Abstandszeile über einer Überschrift bleibt leer und unsichtbar.
            self.tree.tag_configure("spacer", foreground=self.theme["card"])
            self.tree.tag_configure("drop_target", background=self.theme["input_border"])
            self.tree.tag_configure("hover", background=self.theme["hover"])
            for color_key in self.LIST_COLOR_KEYS:
                self.tree.tag_configure(f"listcolor_{color_key}", foreground=self.theme[color_key])
            for color_key in self.ITEM_COLOR_KEYS:
                self.tree.tag_configure(f"itemcolor_{color_key}", foreground=self.theme[color_key])

        for button in self.buttons:
            color_key = getattr(button, "color_key", "accent")
            bg_key = getattr(button, "bg_key", "bg")
            hover_text_color = self.theme.get("theme_toggle_hover_text") if color_key == "theme_toggle" else "#FFFFFF"
            button.set_theme(
                bg_color=self.theme[bg_key],
                text_color=self.theme[color_key],
                border_color=self.theme[color_key],
                hover_fill=self.theme[color_key],
                hover_text_color=hover_text_color,
            )

        for container in getattr(self, "rounded_containers", []):
            fill_key = getattr(container, "fill_key", "card")
            outline_key = getattr(container, "outline_key", "line")
            container.set_theme(
                bg_color=self.theme["bg"],
                fill_color=self.theme[fill_key],
                outline_color=self.theme[outline_key],
                glass_mode=self.glass_enabled(),
                glass_highlight=self.theme.get("glass_highlight", self.theme[outline_key]),
                glass_shadow=self.theme.get("glass_shadow", self.theme["bg"]),
                glass_gradient=self.theme.get("glass_gradient", ""),
            )


        self._apply_sidebar_visibility()

        for menu in getattr(self, "menus", []):
            try:
                menu.configure(
                    bg=self.theme["card"],
                    fg=self.theme["text"],
                    activebackground=self.theme["selection"],
                    activeforeground=self.theme["selection_text"],
                    selectcolor=self.theme["ui_accent"],
                    bd=0,
                    relief="flat",
                )
            except tk.TclError:
                pass
        self.refresh_tree()
        self._schedule_windows_chrome_theme(self.root)
        self.rebuild_backdrop_menu()
        self.refresh_backdrop()

    def _on_windows_window_map(self, event=None):
        if event is None or event.widget is self.root:
            self._schedule_windows_chrome_theme(self.root)

    def _schedule_windows_chrome_theme(self, window=None, attempt=0):
        """Wendet DWM-Farben erst nach dem Mapping mit begrenzten Retries an."""
        if not IS_WINDOWS or attempt >= len(self.WINDOWS_CHROME_RETRY_DELAYS_MS):
            return
        target = window or self.root

        holder = {}

        def apply_or_retry():
            self._after_ids.discard(holder.get("id"))
            try:
                if not target.winfo_exists():
                    return
                if target.winfo_ismapped() and self._apply_windows_chrome_theme(target):
                    return
            except tk.TclError:
                return
            self._schedule_windows_chrome_theme(target, attempt + 1)

        try:
            holder["id"] = self._register_after(
                target.after(self.WINDOWS_CHROME_RETRY_DELAYS_MS[attempt], apply_or_retry)
            )
        except tk.TclError:
            pass

    def _apply_windows_chrome_theme(self, window=None):
        """Färbt unter Windows den nativen Fensterrahmen passend zum App-Theme."""
        if not IS_WINDOWS:
            return False
        target = window or self.root
        try:
            target.update_idletasks()
            user32 = ctypes.WinDLL("user32", use_last_error=True)
            dwmapi = ctypes.WinDLL("dwmapi", use_last_error=True)
            user32.GetParent.argtypes = [ctypes.c_void_p]
            user32.GetParent.restype = ctypes.c_void_p
            inner_hwnd = ctypes.c_void_p(target.winfo_id())
            hwnd = user32.GetParent(inner_hwnd) or inner_hwnd.value
            dark_value = ctypes.c_int(1 if self.theme_name == "dark" else 0)
            dwmapi.DwmSetWindowAttribute.argtypes = [
                ctypes.c_void_p,
                ctypes.c_uint,
                ctypes.c_void_p,
                ctypes.c_uint,
            ]
            dwmapi.DwmSetWindowAttribute.restype = ctypes.c_long
            user32.RedrawWindow.argtypes = [
                ctypes.c_void_p,
                ctypes.c_void_p,
                ctypes.c_void_p,
                ctypes.c_uint,
            ]
            user32.RedrawWindow.restype = ctypes.c_int
            applied = False
            for attribute in (20, 19):
                result = dwmapi.DwmSetWindowAttribute(
                    ctypes.c_void_p(hwnd),
                    attribute,
                    ctypes.byref(dark_value),
                    ctypes.sizeof(dark_value),
                )
                if result == 0:
                    applied = True
                    break
            # Windows 11 zeichnet bei aktivem Glasmodus ein natives Mica-
            # Material hinter den Clientbereich. Der Wert 2 entspricht
            # DWMSBT_MAINWINDOW; ältere Windows-Versionen ignorieren die
            # Eigenschaft mit einem Fehler, den wir bewusst abfangen.
            backdrop = ctypes.c_int(2 if self.glass_enabled() else 1)
            backdrop_result = dwmapi.DwmSetWindowAttribute(
                ctypes.c_void_p(hwnd), 38, ctypes.byref(backdrop), ctypes.sizeof(backdrop)
            )
            applied = applied or backdrop_result == 0
            # Rahmen + Titelzeile neu zeichnen, ohne das Fenster flackern zu lassen.
            user32.RedrawWindow(
                ctypes.c_void_p(hwnd),
                None,
                None,
                0x0001 | 0x0080 | 0x0400,
            )
            return applied
        except Exception:
            # Auf älteren Windows-Versionen bleibt lediglich die native Titelleiste hell.
            return False

    def theme_button_text(self):
        """Der Schalter zeigt, wohin er führt – nicht, wo man gerade steht."""
        partner = self.design_info()["partner"]
        if partner == self.design_name():
            # Ein Design ohne Gegenstück: Der Schalter benennt das aktive
            # Design, statt einen Wechsel zu versprechen, den es nicht gibt.
            return f"{self.ICONS['theme_to_light']}  {self.DESIGNS[partner]['name'].split(' · ')[0]}"
        if self.DESIGNS[partner]["base"] == "dark":
            return f"{self.ICONS['theme_to_dark']}  Dark Mode"
        return f"{self.ICONS['theme_to_light']}  Light Mode"

    def toggle_theme(self):
        """Wechselt zum hellen bzw. dunklen Gegenstück des aktiven Designs.

        Der Schalter bleibt, was er war – ein Weg zwischen
        hell und dunkel –, verlässt aber das gewählte Design nicht mehr. Wer
        im Kontrastdesign arbeitet, landet im hellen Kontrastdesign und nicht
        im normalen Hellmodus. Das Dopamin-Design hat kein helles Gegenstück
        und ist deshalb sein eigener Partner: Der Schalter tut dort nichts,
        und `theme_button_text` sagt das auch.
        """
        partner = self.design_info()["partner"]
        if partner == self.design_name():
            return
        self.set_design(partner)
        self.feedback("design_changed")

