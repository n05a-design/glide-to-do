    def manual_html(self):
        from html import escape
        sections = []
        for title, entries in self.MANUAL_SECTIONS:
            rows = ''.join('<tr><th>'+escape(name)+'</th><td>'+escape(purpose)+'</td><td>'+escape(place)+'</td></tr>'
                           for name, purpose, place in entries)
            sections.append('<section><h2>'+escape(title)+'</h2><table>'+rows+'</table></section>')
        return ('<!doctype html><html lang="de"><meta charset="utf-8"><title>Glide Handbuch</title>'
                '<style>body{font:11pt system-ui;max-width:1050px;margin:2em auto;padding:1em;color:#111}'
                'table{border-collapse:collapse;width:100%}th,td{text-align:left;vertical-align:top;border-bottom:1px solid #bbb;padding:.6em}'
                'th{width:22%}tr{break-inside:avoid}@media print{body{margin:0;max-width:none}.print{display:none}}</style>'
                '<button class="print" onclick="window.print()">Drucken / als PDF speichern</button>'
                '<h1>Glide – Handbuch</h1><p>Version '+escape(APP_VERSION)+'</p>'+''.join(sections)+'</html>')

    def export_manual(self, open_for_print=False):
        if open_for_print:
            descriptor, path = tempfile.mkstemp(prefix="glide-handbuch-", suffix=".html")
            os.close(descriptor)
        else:
            path = filedialog.asksaveasfilename(title="Handbuch speichern", defaultextension=".html",
                                              initialfile=f"Glide-Handbuch-{APP_VERSION}.html",
                                              filetypes=[("HTML-Dokument", "*.html")])
        if not path:
            return "break"
        try:
            self.validate_backup_target(os.path.abspath(path))
            with open(path, "w", encoding="utf-8") as output:
                output.write(self.manual_html())
            if open_for_print:
                self.open_external_path(path)
            else:
                self.show_info("Handbuch gespeichert", path)
        except (OSError, ValueError) as error:
            self.show_error("Handbuch", str(error))
        return "break"

    def show_manual_dialog(self, event=None):
        """Das Handbuch: je Baustein, was er tut und wo er liegt.

        Glide ist über die Versionen gewachsen, und mit ihm
        die Zahl der Stellen, an denen etwas steht. Die Tastenkürzelübersicht
        beantwortet „wie“, die App-Aktionen beantworten „was“ – aber „wo finde
        ich das“ beantwortete bis 3.24 nichts. Das Suchfeld filtert alle drei
        Spalten, weil man mal den Namen, mal die Wirkung und mal den Ort kennt.
        """
        previous_focus = self.current_focus_widget()
        dialog = tk.Toplevel(self.root)
        dialog.title("Handbuch")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.minsize(620, 420)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Handbuch", bg=self.theme["bg"], fg=self.theme["text"],
                 font=app_font(17, "bold"), anchor="w").pack(fill="x", pady=(0, 6))
        tk.Label(outer, text="Jeder Baustein von Glide: was er tut und wo er liegt.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10),
                 anchor="w").pack(fill="x", pady=(0, 14))
        footer = tk.Frame(outer, bg=self.theme["bg"])
        footer.pack(side="bottom", fill="x", pady=(16, 0))
        self._make_dialog_button(footer, "Schließen", dialog.destroy, "muted").pack(side="right")
        self._make_dialog_button(footer, "Tastenkürzel …",
                                 lambda: (dialog.destroy(), self.show_shortcuts_dialog()),
                                 "muted").pack(side="right", padx=(0, 10))

        manual_actions = ButtonFlow(dialog, bg=self.theme["bg"])
        manual_actions.pack(side="bottom", fill="x", padx=24, pady=10)
        manual_actions.add(self._make_dialog_button(manual_actions, "Als HTML speichern", self.export_manual, "export"))
        manual_actions.add(self._make_dialog_button(manual_actions, "Öffnen und drucken", lambda: self.export_manual(True), "import"))
        suche = tk.StringVar()
        suchrahmen, suchfeld = self._make_field(outer)
        suchrahmen.pack(fill="x", pady=(0, 12))
        suchfeld.pack(fill="x", padx=self.FIELD_BORDER_WIDTH, pady=self.FIELD_BORDER_WIDTH)
        eingabe = tk.Entry(suchfeld, name="manual_search", textvariable=suche,
                           bg=self.theme["input"], fg=self.theme["text"],
                           insertbackground=self.theme["text"], relief="flat", bd=0,
                           highlightthickness=0, font=app_font(11))
        eingabe.pack(fill="x", padx=self.FIELD_PAD_X, pady=self.FIELD_PAD_Y)

        flaeche = tk.Frame(outer, bg=self.theme["bg"])
        flaeche.pack(fill="both", expand=True)
        canvas = tk.Canvas(flaeche, bg=self.theme["bg"], highlightthickness=0, bd=0,
                           yscrollincrement=24, takefocus=True, height=440)
        balken = ThemedAutoScrollbar(
            flaeche, bg_color=self.theme["bg"], track_color=self.theme["bg"],
            thumb_color=self.theme["input_border"], active_thumb_color=self.theme["muted"],
            width=10, radius=5,
        )
        balken.configure(height=1)
        balken.pack(side="right", fill="y", padx=(0, self.DIALOG_SCROLLBAR_PAD))
        canvas.pack(side="left", fill="both", expand=True)
        balken.set_command(canvas.yview)
        canvas.configure(yscrollcommand=balken.set)
        inhalt = tk.Frame(canvas, bg=self.theme["bg"])
        fenster = canvas.create_window((0, 0), window=inhalt, anchor="nw")

        def sync(_event=None):
            try:
                canvas.configure(scrollregion=canvas.bbox("all"))
                canvas.itemconfigure(fenster, width=canvas.winfo_width())
            except tk.TclError:
                pass
        inhalt.bind("<Configure>", sync)
        canvas.bind("<Configure>", sync)
        self.bind_mousewheel(canvas)
        self.bind_mousewheel(dialog, target=canvas)

        def aufbauen(*_args):
            for kind in inhalt.winfo_children():
                kind.destroy()
            begriff = " ".join(suche.get().lower().split())
            treffer = 0
            for bereich, eintraege in self.manual_entries(begriff):
                treffer += len(eintraege)
                tk.Label(inhalt, text=bereich, bg=self.theme["bg"], fg=self.theme["text"],
                         font=app_font(12, "bold"), anchor="w").pack(fill="x", pady=(14, 6))
                for name, zweck, ort in eintraege:
                    zeile = tk.Frame(inhalt, bg=self.theme["bg"])
                    zeile.pack(fill="x", pady=(0, 8))
                    tk.Label(zeile, text=name, bg=self.theme["bg"], fg=self.theme["text"],
                             font=app_font(10, "bold"), anchor="w", justify="left",
                             width=24).pack(side="left", anchor="n")
                    text = tk.Frame(zeile, bg=self.theme["bg"])
                    text.pack(side="left", fill="x", expand=True)
                    zweck_label = tk.Label(text, text=zweck, bg=self.theme["bg"], fg=self.theme["text"],
                                           font=app_font(10), anchor="w", justify="left")
                    zweck_label.pack(fill="x")
                    ort_label = tk.Label(text, text=ort, bg=self.theme["bg"], fg=self.theme["muted"],
                                         font=app_font(9), anchor="w", justify="left")
                    ort_label.pack(fill="x")
                    for widget in (zweck_label, ort_label):
                        widget.bind("<Configure>", lambda event, ziel=widget: ziel.configure(
                            wraplength=max(160, event.width - 4)))
            if not treffer:
                tk.Label(inhalt, text="Kein Eintrag passt zu dieser Suche.", bg=self.theme["bg"],
                         fg=self.theme["muted"], font=app_font(10), anchor="w").pack(fill="x", pady=(14, 0))
            sync()

        suche.trace_add("write", aufbauen)
        aufbauen()
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=780, min_height=600)
        self._schedule_windows_chrome_theme(dialog)
        eingabe.focus_set()
        self.run_modal(dialog)
        self.restore_focus(previous_focus)
        return "break"

    @classmethod
    def manual_entries(cls, query=""):
        """Handbuchabschnitte, gefiltert über Name, Zweck und Ort."""
        begriff = " ".join(str(query or "").lower().split())
        ergebnis = []
        for bereich, eintraege in cls.MANUAL_SECTIONS:
            passend = [eintrag for eintrag in eintraege
                       if not begriff or begriff in " ".join(eintrag).lower()
                       or begriff in bereich.lower()]
            if passend:
                ergebnis.append((bereich, passend))
        return ergebnis

