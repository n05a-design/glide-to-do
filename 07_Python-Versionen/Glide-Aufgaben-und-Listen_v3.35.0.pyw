    def complete_backup_payload(self):
        self.flush_rich_note()
        payload = copy.deepcopy(self.data_payload())
        payload.update(
            {
                "app": APP_NAME,
                "app_version": APP_VERSION,
                "exported_at": datetime.now().isoformat(timespec="seconds"),
                # Die Anordnung der Pinnwandkarten und ihre
                # Verbindungen gehören zum Bestand, nicht zum Gerät. Bis 3.23
                # lagen sie ausschließlich in den persönlichen Einstellungen
                # und reisten deshalb nur im vollständigen App-Sicherung mit;
                # ein Aufgabensicherung und eine exportierte Liste verloren sie.
                #
                # Sie stehen bewusst neben den Aufgabenfeldern und nicht in
                # ihnen: Derselbe Punkt kann auf mehreren Pinnwänden liegen –
                # in seiner Liste, im Ordner darüber und auf der globalen
                # Fläche – und dort jeweils woanders. Eine Koordinate am Punkt
                # könnte nur eine davon tragen. Ältere Glide-Fassungen lesen
                # dieselbe Datei weiterhin und übergehen diesen Abschnitt.
                "pinboards": self.exportable_pinboards(),
            }
        )
        return payload

    def exportable_pinboards(self):
        """Die gespeicherten Pinnwände in der Form, in der sie reisen können."""
        boards = self.settings.get("pinboards") if isinstance(self.settings, dict) else None
        return copy.deepcopy(boards) if isinstance(boards, dict) else {}

    def pinboards_from_backup(self, data, container_map=None, item_map=None):
        """Liest den Pinnwandabschnitt eines Backups und zieht Verweise nach.

        Ohne Zuordnungen (vollständiger Import) behalten alle Kennungen ihren
        Wert. Beim Hinzufügen bekommen Listen, Ordner und Punkte neue
        Kennungen; jede Karte und jede Verbindung wandert dann mit. Was sich
        nicht zuordnen lässt, fällt weg, statt auf fremde Objekte zu zeigen.
        """
        roh = data.get("pinboards") if isinstance(data, dict) else None
        if not isinstance(roh, dict):
            return {}
        geprueft = ItemWorkspace.normalize_settings(
            {"pinboards": copy.deepcopy(roh), "open_tabs": [], "active_tab": {}})["pinboards"]
        if container_map is None and item_map is None:
            return geprueft
        container_map = container_map or {}
        item_map = item_map or {}
        ergebnis = {}
        for bereich, board in geprueft.items():
            if bereich == ItemWorkspace.GLOBAL_SCOPE:
                # Die globale Pinnwand des Gebers ist nicht die des Nehmers:
                # Beim Hinzufügen bliebe sonst offen, welche von beiden gilt.
                continue
            art, _, kennung = bereich.partition(":")
            neue_kennung = container_map.get(kennung)
            if not neue_kennung:
                continue
            karten = []
            for card in board.get("cards", []):
                if ItemWorkspace.is_page_card(card.get("item_id")):
                    # Zeichnungskarte (ZF-100): Verweis auf die neue Seitenkennung.
                    neue_seite = container_map.get(card["item_id"][len(ItemWorkspace.PAGE_CARD_PREFIX):])
                    if neue_seite:
                        karten.append({**card, "item_id": ItemWorkspace.PAGE_CARD_PREFIX + neue_seite,
                                       "list_id": neue_seite})
                    continue
                neues_item = item_map.get(card.get("item_id"))
                neue_liste = container_map.get(card.get("list_id"))
                if not neues_item or not neue_liste:
                    continue
                karten.append({**card, "item_id": neues_item, "list_id": neue_liste})
            # Ein Spaltenboard oder eine Pinnwand mit Bereichen trägt auch ohne
            # angeheftete Karten Einstellungen, die mitreisen sollen.
            if not karten and not board.get("areas") and board.get("layout") != "columns":
                continue
            # Bereiche bekommen beim Hinzufügen neue Kennungen (PW-030); eingeklappte
            # Listenspalten zeigen auf die neuen Listen.
            board = {**board,
                     "areas": [{**area, "id": uuid.uuid4().hex} for area in board.get("areas", [])],
                     "collapsed": [container_map.get(value, value) for value in board.get("collapsed", [])]}
            vorhandene = {card["item_id"] for card in karten}

            def neue_karte(kennung):
                if ItemWorkspace.is_page_card(kennung):
                    seite = container_map.get(kennung[len(ItemWorkspace.PAGE_CARD_PREFIX):])
                    return ItemWorkspace.PAGE_CARD_PREFIX + seite if seite else None
                return item_map.get(kennung)
            verbindungen = []
            for eintrag in board.get("connections", []):
                von, nach = neue_karte(eintrag.get("from")), neue_karte(eintrag.get("to"))
                if von in vorhandene and nach in vorhandene:
                    verbindungen.append({**eintrag, "from": von, "to": nach})
            ergebnis[f"{art}:{neue_kennung}"] = {**board, "cards": karten, "connections": verbindungen}
        return ergebnis

    def attachment_owners(self, lists, trash=None, folders=None):
        """Container und Aufgaben, einschließlich wiederherstellbarer Einträge."""
        yield from (folders or [])
        for entry in lists:
            yield entry
            yield from self.walk_items(entry.get("items", []))
        for deleted in (trash or []):
            for key in ("folder", "list", "item"):
                entry = deleted.get(key)
                if not isinstance(entry, dict):
                    continue
                if key == "item":
                    yield from self.walk_items([entry])
                else:
                    yield entry
                    if key == "list":
                        yield from self.walk_items(entry.get("items", []))

    def collect_attachment_sources(self, lists, trash=None, folders=None):
        """Alle Anhangsdateien, die ein Aufgabensicherung enthalten muss.

        Gelöschte, aber noch wiederherstellbare Listen zählen mit: ohne ihre
        Dateien wäre eine Wiederherstellung aus dem Backup unvollständig.
        """
        sources = {}
        total_size = 0
        for item in self.attachment_owners(lists, trash, folders):
            for attachment in item.get("attachments", []):
                storage = self.validate_attachment_storage(attachment.get("storage"))
                source = self.resolve_attachment_path(attachment)
                if not source or not os.path.isfile(source):
                    raise FileNotFoundError(
                        f"Der Anhang „{attachment.get('name', storage)}“ fehlt. "
                        "Das Aufgabensicherung wurde nicht erstellt."
                    )
                size = os.path.getsize(source)
                if size > self.MAX_BACKUP_ATTACHMENT_BYTES:
                    raise ValueError(f"Der Anhang „{attachment.get('name', storage)}“ ist zu groß.")
                if storage not in sources:
                    sources[storage] = source
                    total_size += size
        if total_size > self.MAX_BACKUP_TOTAL_BYTES:
            raise ValueError("Die Anhänge überschreiten die zulässige Gesamtgröße eines Backups.")
        return sources

    def validate_backup_target(self, path):
        target = os.path.normcase(os.path.realpath(os.path.abspath(path)))
        protected = {
            os.path.normcase(os.path.realpath(SAVE_FILE)),
            os.path.normcase(os.path.realpath(SETTINGS_FILE)),
        }
        if target in protected:
            raise ValueError("Diese Glide-Systemdatei darf nicht als Backupziel überschrieben werden.")
        attachments_root = os.path.normcase(os.path.realpath(ATTACHMENTS_DIR))
        try:
            if os.path.commonpath([target, attachments_root]) == attachments_root:
                raise ValueError("Ein Aufgabensicherung darf nicht im internen Anhangsordner liegen.")
        except ValueError as exc:
            if "Anhangsordner" in str(exc):
                raise
        return target

    def write_complete_backup(self, path, payload):
        """Schreibt ein vollständiges Backup atomar; fehlende Anhänge brechen ab."""
        target = self.validate_backup_target(path)
        attachment_paths = self.collect_attachment_sources(
            payload.get("lists", []), payload.get("trash", []), payload.get("folders", [])
        )
        data_bytes = json.dumps(payload, ensure_ascii=False, indent=4).encode("utf-8")
        if len(data_bytes) > self.MAX_BACKUP_DATA_BYTES:
            raise ValueError("Die Glide-Daten sind für ein einzelnes Backup zu groß.")
        target_dir = os.path.dirname(target)
        os.makedirs(target_dir, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix=".glide-backup-", suffix=".tmp", dir=target_dir)
        os.close(fd)
        try:
            with zipfile.ZipFile(temp_path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
                archive.writestr("data.json", data_bytes)
                for storage, source in sorted(attachment_paths.items()):
                    archive.write(source, arcname=storage)
            with zipfile.ZipFile(temp_path, "r") as check_archive:
                damaged = check_archive.testzip()
                if damaged:
                    raise OSError(f"Das erzeugte Backup ist bei {damaged} beschädigt.")
            with open(temp_path, "r+b") as file:
                file.flush()
                os.fsync(file.fileno())
            os.replace(temp_path, target)
            temp_path = None
            return len(attachment_paths)
        finally:
            if temp_path:
                try:
                    os.remove(temp_path)
                except OSError:
                    pass

    def inspect_backup_archive(self, archive):
        infos = archive.infolist()
        if len(infos) > self.MAX_BACKUP_MEMBERS:
            raise ValueError("Das Backup enthält zu viele Dateien.")
        seen_names = set()
        attachment_infos = {}
        data_info = None
        total_size = 0
        for info in infos:
            name = info.filename
            canonical_key = name.casefold()
            if canonical_key in seen_names:
                raise ValueError("Das Backup enthält doppelte Dateinamen.")
            seen_names.add(canonical_key)
            if info.flag_bits & 0x1:
                raise ValueError("Verschlüsselte Backup-Einträge werden nicht unterstützt.")
            unix_mode = (info.external_attr >> 16) & 0xFFFF
            if unix_mode and stat.S_ISLNK(unix_mode):
                raise ValueError("Symbolische Links sind in einem Backup nicht zulässig.")
            if info.is_dir():
                if name != "attachments/":
                    raise ValueError(f"Unbekannter Ordner im Backup: {name}")
                continue
            if name == "data.json":
                if info.file_size > self.MAX_BACKUP_DATA_BYTES:
                    raise ValueError("data.json im Backup ist zu groß.")
                data_info = info
            else:
                storage = self.validate_attachment_storage(name)
                if storage != name:
                    raise ValueError("Das Backup enthält einen nicht kanonischen Anhangspfad.")
                if info.file_size > self.MAX_BACKUP_ATTACHMENT_BYTES:
                    raise ValueError(f"Der Backup-Anhang {name} ist zu groß.")
                attachment_infos[storage] = info
            total_size += info.file_size
            if total_size > self.MAX_BACKUP_TOTAL_BYTES:
                raise ValueError("Das Backup überschreitet die zulässige Gesamtgröße.")
            if (
                info.file_size > self.BACKUP_COPY_CHUNK
                and info.compress_size > 0
                and info.file_size / info.compress_size > self.MAX_BACKUP_COMPRESSION_RATIO
            ):
                raise ValueError("Das Backup weist eine unplausibel hohe Kompressionsrate auf.")
        if data_info is None:
            raise ValueError("Im Glide-Backup fehlt data.json.")
        return data_info, attachment_infos

    def read_zip_member_limited(self, archive, info, limit):
        chunks = []
        total = 0
        with archive.open(info, "r") as source:
            while True:
                chunk = source.read(self.BACKUP_COPY_CHUNK)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("Ein Backup-Inhalt überschreitet die zulässige Größe.")
                chunks.append(chunk)
        if total != info.file_size:
            raise ValueError("Eine Dateigröße im Backup ist inkonsistent.")
        return b"".join(chunks)

    def copy_zip_member_limited(self, archive, info, target_path, limit):
        total = 0
        with archive.open(info, "r") as source, open(target_path, "wb") as target:
            while True:
                chunk = source.read(self.BACKUP_COPY_CHUNK)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("Ein Backup-Anhang überschreitet die zulässige Größe.")
                target.write(chunk)
            target.flush()
            os.fsync(target.fileno())
        if total != info.file_size:
            raise ValueError("Eine Anhangsgröße im Backup ist inkonsistent.")
        return total

    @classmethod
    def safe_attachment_filename(cls, original_name, attachment_id=None):
        """Baut einen Speichernamen, der validate_attachment_storage immer besteht.

        Kritisch sind Namen, die nach der Bereinigung auf Punkt oder Leerzeichen
        enden – etwa "report." oder eine Endung außerhalb von A-Z/0-9 wie
        ".☃". Solche Namen wären zwar schreibbar, aber nie wieder auflösbar:
        die Datei verschwände beim nächsten Start und jedes Aufgabensicherung
        würde daran scheitern.

        `attachment_id` hält Datensatz-ID und Dateiname nachvollziehbar gekoppelt.
        """
        prefix = attachment_id if isinstance(attachment_id, str) and attachment_id else uuid.uuid4().hex
        prefix = re.sub(r"[^A-Za-z0-9]", "", prefix)[:32] or uuid.uuid4().hex
        stem, extension = os.path.splitext(os.path.basename(str(original_name or "datei")))
        safe_stem = re.sub(r"[^\w .()-]+", "_", stem, flags=re.UNICODE).strip(" .")[:90] or "datei"
        safe_extension = re.sub(r"[^A-Za-z0-9.]", "", extension)[:16].strip(". ")
        suffix = f".{safe_extension}" if safe_extension else ""
        candidate = f"{prefix}_{safe_stem}{suffix}".rstrip(" .")
        try:
            cls.validate_attachment_storage(f"attachments/{candidate}")
        except ValueError:
            # Letzte Rückfallebene: garantiert gültig; der Anzeigename bleibt im
            # Datensatz vollständig erhalten.
            candidate = f"{prefix}.dat"
        return candidate

    def remap_import_attachments(self, lists, trash=None, folders=None):
        """Gibt eingehenden Dateien neue Namen, damit Restore nie Bytes überschreibt."""
        storage_map = {}
        used_destinations = set()
        for item in self.attachment_owners(lists, trash, folders):
            reference = item.get("drawing_reference") if isinstance(item.get("drawing_reference"), dict) else None
            for attachment in item.get("attachments", []):
                previous_id = attachment.get("id")
                old_storage = self.validate_attachment_storage(attachment.get("storage"))
                if old_storage not in storage_map:
                    new_storage = None
                    # Begrenzte Versuche: ohne Obergrenze könnte ein Backup mit
                    # einem nicht normierbaren Anzeigenamen die App einfrieren.
                    for attempt in range(64):
                        candidate_name = (
                            self.safe_attachment_filename(attachment.get("name"))
                            if attempt < 32
                            else f"{uuid.uuid4().hex}.dat"
                        )
                        candidate = f"attachments/{candidate_name}"
                        final_path = self.resolve_attachment_path({"storage": candidate})
                        if candidate not in used_destinations and final_path and not os.path.exists(final_path):
                            new_storage = candidate
                            break
                    if new_storage is None:
                        raise OSError(
                            "Für einen Anhang aus dem Backup konnte kein freier Zielname "
                            "erzeugt werden."
                        )
                    storage_map[old_storage] = new_storage
                    used_destinations.add(new_storage)
                attachment["storage"] = storage_map[old_storage]
                attachment["id"] = uuid.uuid4().hex
                # Seitenbilder zeigen auf die Anhangskennung (27.09.2026).
                dokument = item.get("rich_note") if isinstance(item.get("rich_note"), dict) else None
                for bild in ((dokument or {}).get("images") or {}).values():
                    if isinstance(bild, dict) and bild.get("attachment") == previous_id:
                        bild["attachment"] = attachment["id"]
                cover = item.get('cover') or {}
                if cover.get('kind') == 'image' and cover.get('attachment') == previous_id:
                    cover['attachment'] = attachment['id']
                # Die PNG-Referenz einer Zeichnung zeigt auf die Anhangskennung
                # und muss der neuen Kennung folgen.
                if reference is not None and reference.get("attachment_id") == previous_id:
                    reference["attachment_id"] = attachment["id"]
                    reference = None
        return storage_map

    def ensure_inbox_in_collection(self, lists):
        inboxes = [entry for entry in lists if entry.get("system_role") == "inbox"]
        if inboxes:
            inbox = inboxes[0]
            for duplicate in inboxes[1:]:
                duplicate["system_role"] = None
        else:
            inbox = self.new_list_object("Eingang", [], system_role="inbox", color="due_action")
            lists.insert(0, inbox)
        inbox["title"] = "Eingang"
        inbox["folder_id"] = None
        return [inbox] + [entry for entry in lists if entry is not inbox]

    def export_full_backup(self):
        """Sichert Daten und alle referenzierten Anhänge gemeinsam und atomar."""
        self.flush_rich_note()
        self.sync_current_list_reference()
        default_filename = f"glide_backup_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.glidebackup"
        path = filedialog.asksaveasfilename(
            title="Aufgabensicherung speichern (alle Listen)",
            defaultextension=".glidebackup",
            initialfile=default_filename,
            filetypes=[("Glide-Aufgabensicherung", "*.glidebackup"), ("Alle Dateien", "*.*")],
        )
        if not path:
            return
        try:
            count = self.write_complete_backup(path, self.complete_backup_payload())
            attachment_word = "Anhang" if count == 1 else "Anhängen"
            self.record_data_operation("backup", path)
            self.show_info(
                "Backup erstellt",
                f"Aufgabensicherung mit {count} {attachment_word} gespeichert nach:\n{path}",
            )
        except Exception as e:
            self.show_error("Fehler beim Backup", str(e))

    # --- Druck- und PDF-Ausgabe ---------------------------------------------

    @staticmethod
    def escape_print_text(value):
        """Markup-sichere Ausgabe ohne zusätzliche Bibliothek."""
        text = str(value if value is not None else "")
        for quelle, ziel in (("&", "&amp;"), ("<", "&lt;"), (">", "&gt;"), ('"', "&quot;")):
            text = text.replace(quelle, ziel)
        return text

    def print_default_options(self):
        return {"done": False, "description": True, "labels": True,
                "due": True, "effort": True, "boxes": True, "notes": False}

    def print_document_sections(self, fmt, day=None):
        """Titel, Untertitel und Abschnitte einer Druckausgabe.

        Jeder Abschnitt ist eine Überschrift mit einer flachen Punktliste aus
        (Ebene, Punkt, Quellliste). Gedruckt werden dieselben Objekte, die die
        Ansichten zeigen; es entsteht keine eigene Datenhaltung.
        """
        heute = date.today()
        abschnitte = []
        if fmt == "today":
            titel = "Tageszettel"
            untertitel = f"{self.WEEKDAY_NAMES[heute.weekday()]}, {heute.strftime('%d.%m.%Y')}"
            geplant = self.plan_day_entries(apply_filters=False, day=heute.isoformat())
            if geplant:
                abschnitte.append(("Tagesplan",
                                   [(0, eintrag[4], eintrag[3]) for eintrag in geplant]))
            faellig = [eintrag for eintrag in self.get_in_progress_items(apply_filters=False)
                       if self.normalize_due(eintrag[4].get("due")) == heute.isoformat()]
            if faellig:
                abschnitte.append(("Heute fällig", [(0, eintrag[4], eintrag[3]) for eintrag in faellig]))
            ueberfaellig = self.get_overdue_items(apply_filters=False)
            if ueberfaellig:
                abschnitte.append(("Überfällig", [(0, eintrag[4], eintrag[3]) for eintrag in ueberfaellig]))
        elif fmt == "planday":
            ziel = self.normalize_due(day) or self.plan_day()
            titel = "Tagesplanung"
            untertitel = self.format_plan_day(ziel)
            eintraege = self.plan_day_entries(apply_filters=False, day=ziel)
            if eintraege:
                abschnitte.append((f"Bearbeitungstag {self.format_due_display(ziel)}",
                                   [(0, eintrag[4], eintrag[3]) for eintrag in eintraege]))
        else:
            # Liste und Checkliste teilen die Datengrundlage und unterscheiden
            # sich nur in der Darstellung.
            ordner = self.get_folder(self.active_folder_id) if self.view_mode == "folder" else None
            if ordner:
                titel = str(ordner.get("title") or "Ordner")
                untertitel = "Ordner mit allen enthaltenen Listen"
                for entry in self.get_folder_lists_recursive(ordner.get("id")):
                    punkte = self.flatten_print_items(entry.get("items", []), entry)
                    if punkte:
                        abschnitte.append((self.list_path_title(entry), punkte))
            else:
                entry = self.current_list() if self.lists else None
                if entry is None:
                    return "Glide", "Keine Liste geöffnet", []
                titel = str(entry.get("title") or "Liste")
                untertitel = self.list_path_title(entry)
                abschnitte.append((titel, self.flatten_print_items(entry.get("items", []), entry)))
            if fmt == "checklist":
                untertitel = (untertitel + " · Checkliste") if untertitel else "Checkliste"
        return titel, untertitel, abschnitte

    def flatten_print_items(self, items, source, level=0):
        """Punkte einer Liste in Lesereihenfolge, mit Einrückungsebene."""
        ergebnis = []
        for item in items or ():
            if not isinstance(item, dict):
                continue
            ergebnis.append((level, item, source))
            ergebnis.extend(self.flatten_print_items(item.get("children", []), source, level + 1))
        return ergebnis

    def print_item_details(self, item, options):
        """Zusatzangaben einer Druckzeile in fester Reihenfolge."""
        teile = []
        if options.get("due"):
            frist = self.format_due_full(item.get("due"), item.get("due_time"))
            if frist:
                teile.append("Fällig: " + frist)
            wiederholung = self.describe_repeat(item.get("repeat"))
            if wiederholung:
                teile.append(wiederholung)
        if options.get("effort"):
            if item.get("planned_date"):
                teile.append("Bearbeitungstag: " + self.format_due_display(item.get("planned_date")))
            aufwand = self.format_estimated_minutes(item.get("estimated_minutes"))
            if aufwand:
                teile.append("Aufwand: " + aufwand)
        if options.get("labels"):
            namen = [str(label.get("name") or "") for label in self.item_labels(item)]
            namen = [name for name in namen if name]
            if namen:
                teile.append("Labels: " + ", ".join(namen))
        fortschritt = self.checklist_progress(item)
        if fortschritt["total"]:
            teile.append(f"Checkliste: {fortschritt['done']} von {fortschritt['total']}")
        anhaenge = len(item.get("attachments", []) or [])
        if anhaenge:
            teile.append(f"{anhaenge} Anhang" if anhaenge == 1 else f"{anhaenge} Anhänge")
        return teile

    def build_print_html(self, fmt, options=None, day=None):
        """Vollständige, eigenständige Druckseite ohne externe Verweise."""
        if fmt not in dict(self.PRINT_FORMATS):
            raise ValueError(f"Unbekanntes Druckformat: {fmt}")
        options = dict(self.print_default_options(), **(options or {}))
        titel, untertitel, abschnitte = self.print_document_sections(fmt, day=day)
        name = str(self.settings.get("profile_name") or "").strip()
        kopf = self.escape_print_text(titel)
        zeilen = [
            "<!DOCTYPE html>", '<html lang="de">', "<head>",
            '<meta charset="utf-8">',
            f"<title>{kopf} · {APP_NAME}</title>", "<style>",
            "@page { size: A4; margin: 18mm 16mm; }",
            "* { box-sizing: border-box; }",
            "body { margin: 0; font-family: 'DejaVu Sans', 'Helvetica Neue', Arial, sans-serif;"
            " font-size: 11pt; line-height: 1.45; color: #111; background: #fff; }",
            "header { border-bottom: 1.5pt solid #111; padding-bottom: 6pt; margin-bottom: 14pt; }",
            "h1 { font-size: 17pt; margin: 0 0 2pt; }",
            "p.subtitle { margin: 0; font-size: 10pt; color: #444; }",
            "h2 { font-size: 12pt; margin: 16pt 0 6pt; padding-bottom: 3pt;"
            " border-bottom: 0.5pt solid #999; page-break-after: avoid; }",
            "ul { list-style: none; margin: 0; padding: 0; }",
            "li { padding: 3pt 0; border-bottom: 0.4pt dotted #bbb; page-break-inside: avoid; }",
            "span.box { display: inline-block; width: 10pt; height: 10pt; border: 0.8pt solid #111;"
            " margin-right: 7pt; vertical-align: -1pt; }",
            "span.done { text-decoration: line-through; color: #555; }",
            "span.kind { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.4pt;"
            " color: #555; margin-left: 6pt; }",
            "div.meta { font-size: 9pt; color: #444; margin-left: 17pt; }",
            "div.note { font-size: 9.5pt; color: #333; margin-left: 17pt; white-space: pre-wrap; }",
            "div.lines { margin-top: 16pt; }",
            "div.lines span { display: block; border-bottom: 0.5pt solid #999; height: 20pt; }",
            "footer { margin-top: 18pt; padding-top: 5pt; border-top: 0.5pt solid #999;"
            " font-size: 8.5pt; color: #555; }",
            "p.empty { font-size: 10pt; color: #444; }",
            "</style>", "</head>", "<body>", "<header>",
            f"<h1>{kopf}</h1>",
        ]
        if untertitel:
            zeilen.append(f'<p class="subtitle">{self.escape_print_text(untertitel)}</p>')
        zeilen.append("</header>")
        gedruckt = 0
        begrenzt = False
        sichtbare_abschnitte = 0
        for ueberschrift, punkte in abschnitte:
            auswahl = []
            for ebene, item, quelle in punkte:
                if item.get("done") and not options.get("done"):
                    continue
                auswahl.append((ebene, item, quelle))
            if not auswahl:
                continue
            sichtbare_abschnitte += 1
            zeilen.append(f"<h2>{self.escape_print_text(ueberschrift)}</h2>")
            zeilen.append("<ul>")
            for ebene, item, quelle in auswahl:
                if gedruckt >= self.MAX_PRINT_ITEMS:
                    begrenzt = True
                    break
                gedruckt += 1
                einzug = f' style="padding-left: {ebene * 12}pt"' if ebene else ""
                kasten = '<span class="box"></span>' if options.get("boxes") else ""
                text = self.escape_print_text(" ".join(str(item.get("text") or "").split()))
                klasse = ' class="done"' if item.get("done") else ""
                art = ""
                if not self.is_schedulable_item(item):
                    art = f'<span class="kind">{self.escape_print_text(self.ITEM_KIND_NAMES.get(self.item_kind(item), ""))}</span>'
                elif item.get("done"):
                    art = '<span class="kind">erledigt</span>'
                zeilen.append(f"<li{einzug}>{kasten}<span{klasse}>{text}</span>{art}")
                details = self.print_item_details(item, options)
                if quelle is not None and fmt in ("today", "planday"):
                    quelle_titel = str(quelle.get("title") or "").strip()
                    if quelle_titel:
                        details.insert(0, "Aus: " + quelle_titel)
                if details:
                    zeilen.append(f'<div class="meta">{self.escape_print_text(" · ".join(details))}</div>')
                if options.get("description"):
                    text_note = " ".join(str(item.get("description") or "").split())
                    if text_note:
                        zeilen.append(f'<div class="note">{self.escape_print_text(text_note)}</div>')
                zeilen.append("</li>")
            zeilen.append("</ul>")
            if begrenzt:
                break
        if not sichtbare_abschnitte:
            zeilen.append('<p class="empty">Für diese Auswahl gibt es nichts zu drucken.</p>')
        if begrenzt:
            zeilen.append(f'<p class="empty">Nach {self.MAX_PRINT_ITEMS} Punkten abgeschnitten. '
                          "Bitte die Auswahl eingrenzen.</p>")
        if options.get("notes"):
            zeilen.append('<div class="lines">' + "<span></span>" * 8 + "</div>")
        erzeugt = datetime.now().strftime("%d.%m.%Y um %H:%M")
        fuss = f"{APP_NAME} · gedruckt am {erzeugt} · {gedruckt} Punkt(e)"
        if name:
            fuss += " · " + name
        zeilen += [f"<footer>{self.escape_print_text(fuss)}</footer>", "</body>", "</html>", ""]
        return "\n".join(zeilen)

    def write_print_document(self, path, fmt, options=None, day=None):
        """Schreibt die Druckansicht atomar und gibt den Zielpfad zurück."""
        html_text = self.build_print_html(fmt, options, day=day)
        target = os.path.abspath(path)
        self.validate_backup_target(target)
        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix=".glide-print-", suffix=".tmp",
                                         dir=os.path.dirname(target) or ".")
        try:
            with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as file:
                file.write(html_text)
                file.flush()
                os.fsync(file.fileno())
            os.replace(temp_path, target)
            temp_path = None
        finally:
            if temp_path:
                try:
                    os.remove(temp_path)
                except OSError:
                    pass
        return target

    def show_print_dialog(self, event=None, fmt=None):
        """Druckansicht wählen, erzeugen und im Standardprogramm öffnen."""
        dialog = tk.Toplevel(self.root)
        dialog.title("Drucken und PDF")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Drucken und PDF", font=app_font(15, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        tk.Label(outer, text="Glide erzeugt eine Druckansicht und öffnet sie im Standardprogramm. "
                 "Dessen Druckdialog druckt auf Papier oder speichert als PDF.",
                 font=app_font(10), bg=self.theme["bg"], fg=self.theme["muted"],
                 justify="left", wraplength=620, anchor="w").pack(anchor="w", pady=(4, 16))
        namen = dict(self.PRINT_FORMATS)
        start = fmt if fmt in namen else ("list" if self.view_mode in ("list", self.TABLE_VIEW, "folder")
                                          else "planday" if self.view_mode == self.PLAN_DAY_VIEW else "today")
        auswahl = tk.StringVar(value=namen[start])
        self._make_field_label(outer, "Was soll gedruckt werden?").pack(anchor="w", pady=(0, 5))
        feld, _knopf = self._make_option_menu(outer, auswahl, [text for _key, text in self.PRINT_FORMATS])
        feld.pack(fill="x", pady=(0, 14))
        tk.Label(outer, text="Inhalt", font=app_font(11, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w", pady=(0, 6))
        vorgaben = self.print_default_options()
        variablen = {}
        for key, text in self.PRINT_OPTION_LABELS:
            variablen[key] = tk.BooleanVar(value=vorgaben[key])
            tk.Checkbutton(
                outer, name="print_" + key, text=text, variable=variablen[key],
                bg=self.theme["bg"], fg=self.theme["text"], selectcolor=self.theme["input"],
                activebackground=self.theme["bg"], activeforeground=self.theme["text"],
                anchor="w", justify="left", wraplength=620, font=app_font(10), highlightthickness=0,
            ).pack(fill="x", pady=2)
        hinweis = tk.Label(outer, text="", bg=self.theme["bg"], fg=self.theme["delete"],
                           font=app_font(10), justify="left", wraplength=620, anchor="w")
        hinweis.pack(anchor="w", pady=(10, 0))

        def gewaehltes_format():
            return next(key for key, text in self.PRINT_FORMATS if text == auswahl.get())

        def optionen():
            return {key: bool(var.get()) for key, var in variablen.items()}

        def ausgeben(speichern):
            key = gewaehltes_format()
            try:
                vorschau = self.build_print_html(key, optionen())
            except Exception as exc:
                hinweis.configure(text=str(exc))
                return "break"
            if speichern:
                ziel = filedialog.asksaveasfilename(
                    title="Druckansicht speichern", defaultextension=".html",
                    initialfile=f"glide_{key}_{datetime.now().strftime('%Y-%m-%d')}.html",
                    filetypes=[("HTML-Druckansicht", "*.html"), ("Alle Dateien", "*.*")],
                    parent=dialog,
                )
                if not ziel:
                    return "break"
            else:
                ziel = os.path.join(tempfile.gettempdir(),
                                    f"glide_druck_{datetime.now().strftime('%Y%m%d_%H%M%S')}.html")
            try:
                pfad = self.write_print_document(ziel, key, optionen())
            except Exception as exc:
                hinweis.configure(text=str(exc))
                return "break"
            dialog.destroy()
            if speichern:
                self.show_info("Druckansicht gespeichert", f"Gespeichert nach:\n{pfad}")
            else:
                self.open_external_path(pfad)
            return "break"

        footer = ButtonFlow(outer, bg=self.theme["bg"], gap=10)
        footer.pack(fill="x", pady=(18, 0))
        footer.add(self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted"))
        footer.add(self._make_dialog_button(footer, "Als HTML speichern",
                                            lambda: ausgeben(True), "export"))
        footer.add(self._make_dialog_button(footer, "Öffnen und drucken",
                                            lambda: ausgeben(False), "confirm"))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.bind("<Return>", lambda _event: ausgeben(False))
        self._center_dialog(dialog, min_width=700)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return "break"

    # --- Kalenderausgabe (ICS) ----------------------------------------------

    @staticmethod
    def escape_ics_text(value):
        """Textwert nach RFC 5545: Backslash, Semikolon, Komma, Umbruch."""
        text = str(value if value is not None else "")
        text = text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
        text = text.replace("\r\n", "\\n").replace("\r", "\\n").replace("\n", "\\n")
        return text

    @classmethod
    def fold_ics_line(cls, line):
        """Zeile bei 75 Oktetten falten – Fortsetzung mit einem Leerzeichen.

        Gefaltet wird nach Bytes, nicht nach Zeichen: Ein Umlaut belegt zwei
        Oktette, und eine Faltung mitten in einem Zeichen macht die Datei
        unlesbar. Deshalb wird zeichenweise gezählt und vor dem Zeichen
        umgebrochen, das die Grenze überschreiten würde.
        """
        zeilen = []
        aktuell = ""
        laenge = 0
        grenze = cls.ICS_LINE_LIMIT
        for zeichen in line:
            breite = len(zeichen.encode("utf-8"))
            if laenge + breite > grenze:
                zeilen.append(aktuell)
                aktuell = zeichen
                laenge = breite + 1  # das führende Leerzeichen der Folgezeile
                grenze = cls.ICS_LINE_LIMIT
                continue
            aktuell += zeichen
            laenge += breite
        zeilen.append(aktuell)
        return [zeilen[0]] + [" " + rest for rest in zeilen[1:]]

    @staticmethod
    def ics_utc_stamp(value=None):
        """Zeitpunkt als UTC-Stempel „20260914T071500Z"."""
        if value is None:
            moment = datetime.now(timezone.utc)
        else:
            try:
                moment = datetime.fromisoformat(str(value))
            except (TypeError, ValueError):
                return None
            moment = moment.astimezone(timezone.utc) if moment.tzinfo else moment.replace(tzinfo=timezone.utc)
        return moment.strftime("%Y%m%dT%H%M%SZ")

    @classmethod
    def ics_local_stamp(cls, day, clock):
        """Schwebende Ortszeit „20261001T093000" ohne Zonenkennung."""
        tag = cls.normalize_due(day)
        zeit = cls.normalize_due_time(clock)
        if not tag or not zeit:
            return None
        return tag.replace("-", "") + "T" + zeit.replace(":", "") + "00"

    @classmethod
    def ics_date_stamp(cls, day):
        tag = cls.normalize_due(day)
        return tag.replace("-", "") if tag else None

    @classmethod
    def ics_repeat_rule(cls, item, ganztaegig=False):
        """Wiederholungsregel des Punkts als RRULE-Wert oder None.

        ``ganztaegig`` sagt, ob DTSTART als Datum geschrieben wurde. RFC 5545
        verlangt, dass UNTIL denselben Werttyp und dieselbe Zeitform wie
        DTSTART trägt – siehe die Begründung am Ende dieser Methode.
        """
        regel = cls.normalize_repeat(item.get("repeat"))
        if not regel:
            return None
        art = regel.get("art")
        if art == cls.REPEAT_DAILY:
            teile = ["FREQ=DAILY"]
        elif art == cls.REPEAT_EVERY_N_DAYS:
            teile = ["FREQ=DAILY", f"INTERVAL={int(regel.get('abstand') or 1)}"]
        elif art == cls.REPEAT_WEEKDAYS:
            tage = [cls.ICS_WEEKDAYS[tag] for tag in regel.get("tage") or () if 0 <= tag <= 6]
            if not tage:
                return None
            teile = ["FREQ=WEEKLY", "BYDAY=" + ",".join(tage)]
        elif art == cls.REPEAT_WEEKLY:
            teile = ["FREQ=WEEKLY"]
        elif art == cls.REPEAT_MONTHLY:
            teile = ["FREQ=MONTHLY"]
        elif art == cls.REPEAT_YEARLY:
            teile = ["FREQ=YEARLY"]
        else:
            return None
        ende = cls.normalize_due(regel.get("ende"))
        if ende:
            # UNTIL bezeichnet den letzten möglichen Termin; der ganze Tag
            # gehört dazu, deshalb steht die Zeit am Tagesende.
            #
            # Entscheidend ist die Zeitform: Glide schreibt DTSTART in
            # schwebender Ortszeit beziehungsweise als reines Datum. Ein
            # UNTIL mit „Z" wäre UTC und damit eine andere Zeitform – der
            # Leser rechnet es in Ortszeit um und landet östlich von
            # Greenwich einen Tag zu spät, westlich einen Tag zu früh. Das
            # Enddatum überlebte den Rundlauf „exportieren, importieren"
            # nur in der Zeitzone UTC. Deshalb ohne „Z", und bei einem
            # Ganztagstermin als Datum – so, wie RFC 5545 es verlangt.
            tagesform = ende.replace("-", "")
            teile.append("UNTIL=" + (tagesform if ganztaegig else tagesform + "T235959"))
        return ";".join(teile)

    def ics_event_lines(self, item, source, kind="due", options=None):
        """Ein VEVENT als Zeilenliste – oder [] wenn der Punkt keinen Termin hat."""
        options = options if isinstance(options, dict) else self.ics_default_options()
        if not isinstance(item, dict) or not self.is_schedulable_item(item):
            return []
        if item.get("done") and not options.get("done"):
            return []
        if kind == "planned":
            tag = self.normalize_due(item.get("planned_date"))
            zeit = None
        else:
            tag = self.normalize_due(item.get("due"))
            zeit = self.normalize_due_time(item.get("due_time"))
        if not tag:
            return []
        titel = " ".join(str(item.get("text") or "").split()) or "Aufgabe"
        if kind == "planned":
            titel = "Planung: " + titel
        if item.get("done"):
            titel = "Erledigt: " + titel
        zeilen = ["BEGIN:VEVENT",
                  f"UID:glide-{item.get('id') or uuid.uuid4().hex}"
                  f"{'-plan' if kind == 'planned' else ''}@{self.ICS_UID_DOMAIN}",
                  f"DTSTAMP:{self.ics_utc_stamp()}",
                  "SEQUENCE:0",
                  f"SUMMARY:{self.escape_ics_text(titel)}"]
        if zeit:
            minuten = self.ICS_DEFAULT_MINUTES
            if options.get("effort") and isinstance(item.get("estimated_minutes"), int) \
                    and not isinstance(item.get("estimated_minutes"), bool) and item["estimated_minutes"] > 0:
                minuten = item["estimated_minutes"]
            beginn = datetime.fromisoformat(f"{tag}T{zeit}")
            ende = beginn + timedelta(minutes=minuten)
            zeilen.append("DTSTART:" + beginn.strftime("%Y%m%dT%H%M%S"))
            zeilen.append("DTEND:" + ende.strftime("%Y%m%dT%H%M%S"))
        else:
            # Ganztägig: DTEND ist nach RFC der Folgetag, sonst fehlte der Tag.
            start = datetime.fromisoformat(tag).date()
            zeilen.append("DTSTART;VALUE=DATE:" + start.strftime("%Y%m%d"))
            zeilen.append("DTEND;VALUE=DATE:" + (start + timedelta(days=1)).strftime("%Y%m%d"))
        beschreibung = []
        if options.get("description"):
            text = str(item.get("description") or "").strip()
            if text:
                beschreibung.append(text)
        if isinstance(source, dict) and source.get("title"):
            beschreibung.append("Aus: " + str(source["title"]))
        wichtig = self.clamp_importance(item.get("importance", 0))
        if wichtig:
            beschreibung.append("Wichtigkeit: " + self.IMPORTANCE_NAMES.get(wichtig, ""))
        if options.get("effort") and item.get("estimated_minutes"):
            beschreibung.append("Aufwand: " + self.format_estimated_minutes(item["estimated_minutes"]))
        if options.get("labels"):
            namen = self.format_item_label_names(item)
            if namen:
                beschreibung.append("Labels: " + namen)
                zeilen.append("CATEGORIES:" + ",".join(
                    self.escape_ics_text(name.strip()) for name in namen.split(",") if name.strip()))
        if beschreibung:
            zeilen.append("DESCRIPTION:" + self.escape_ics_text("\n".join(beschreibung)))
        if wichtig in self.ICS_PRIORITIES:
            zeilen.append(f"PRIORITY:{self.ICS_PRIORITIES[wichtig]}")
        if kind == "due":
            regel = self.ics_repeat_rule(item, ganztaegig=not zeit)
            if regel:
                zeilen.append("RRULE:" + regel)
            if options.get("alarms"):
                zeilen.extend(self.ics_alarm_lines(item))
        zeilen.append("END:VEVENT")
        return zeilen

    def ics_alarm_lines(self, item):
        """VALARM aus der Erinnerung des Punkts; ohne Erinnerung leer."""
        try:
            reminder = self.normalize_reminder(item.get("reminder"))
        except ValueError:
            return []
        if not reminder:
            return []
        if reminder["mode"] == "relative":
            minuten = int(reminder.get("minutes") or 0)
            trigger = "TRIGGER:-PT{}M".format(minuten) if minuten else "TRIGGER:PT0M"
        else:
            stempel = self.ics_utc_stamp(reminder.get("at"))
            if not stempel:
                return []
            trigger = "TRIGGER;VALUE=DATE-TIME:" + stempel
        return ["BEGIN:VALARM", "ACTION:DISPLAY",
                "DESCRIPTION:" + self.escape_ics_text(" ".join(str(item.get("text") or "Aufgabe").split())),
                trigger, "END:VALARM"]

    def ics_default_options(self):
        return {"done": False, "description": True, "labels": True,
                "effort": True, "planned": False, "alarms": True}

    def ics_sources(self, scope, day=None):
        """Titel der Ausgabe und die Punkte je Quellliste – wie beim Druck."""
        if scope == "all":
            paare = []
            for entry in self.lists:
                if not isinstance(entry, dict):
                    continue
                paare.extend((item, entry) for _ebene, item, _quelle
                             in self.flatten_print_items(entry.get("items", []), entry))
            return "Glide – alle Listen", paare
        titel, _untertitel, abschnitte = self.print_document_sections(
            "list" if scope == "list" else scope, day=day)
        paare = []
        gesehen = set()
        for _kopf, punkte in abschnitte:
            for _ebene, item, quelle in punkte:
                kennung = id(item)
                if kennung in gesehen:
                    # „Mein Tag" und „Heute fällig" können denselben Punkt
                    # nennen; im Kalender soll er einmal erscheinen.
                    continue
                gesehen.add(kennung)
                paare.append((item, quelle))
        return f"Glide – {titel}", paare

    def build_ics_document(self, scope, options=None, day=None):
        """Vollständige ICS-Datei als Text; liefert (Text, Bericht)."""
        if scope not in dict(self.ICS_SCOPES):
            raise ValueError(f"Unbekannter Umfang für die Kalenderausgabe: {scope!r}")
        options = options if isinstance(options, dict) else self.ics_default_options()
        name, paare = self.ics_sources(scope, day)
        bericht = {"events": 0, "skipped": 0, "truncated": False}
        koerper = []
        for item, quelle in paare:
            if bericht["events"] >= self.MAX_ICS_EVENTS:
                bericht["truncated"] = True
                break
            zeilen = self.ics_event_lines(item, quelle, "due", options)
            if zeilen:
                koerper.extend(zeilen)
                bericht["events"] += 1
            elif self.is_schedulable_item(item) and not self.normalize_due(item.get("due")) \
                    and not (item.get("done") and not options.get("done")):
                bericht["skipped"] += 1
            if options.get("planned") and bericht["events"] < self.MAX_ICS_EVENTS:
                geplant = self.ics_event_lines(item, quelle, "planned", options)
                if geplant:
                    koerper.extend(geplant)
                    bericht["events"] += 1
        kopf = ["BEGIN:VCALENDAR", "VERSION:2.0",
                f"PRODID:-//Glide//Aufgaben und Listen {APP_VERSION}//DE",
                "CALSCALE:GREGORIAN", "METHOD:PUBLISH",
                "X-WR-CALNAME:" + self.escape_ics_text(
                    name + (f" (erste {self.MAX_ICS_EVENTS} Termine)" if bericht["truncated"] else "")),
                "X-WR-TIMEZONE:" + self.escape_ics_text(time.tzname[0] if time.tzname else "")]
        gefaltet = []
        for zeile in kopf + koerper + ["END:VCALENDAR"]:
            gefaltet.extend(self.fold_ics_line(zeile))
        return "\r\n".join(gefaltet) + "\r\n", bericht

    def write_ics_document(self, path, scope, options=None, day=None):
        """Kalenderdatei atomar schreiben; Nutzdatendateien sind ausgeschlossen."""
        ziel = os.path.abspath(path)
        self.validate_backup_target(ziel)
        text, bericht = self.build_ics_document(scope, options, day)
        ordner = os.path.dirname(ziel)
        os.makedirs(ordner, exist_ok=True)
        handle, temporaer = tempfile.mkstemp(prefix=".glide-ics-", suffix=".tmp", dir=ordner)
        try:
            with os.fdopen(handle, "w", encoding="utf-8", newline="") as datei:
                datei.write(text)
                datei.flush()
                os.fsync(datei.fileno())
            os.replace(temporaer, ziel)
            temporaer = None
        finally:
            if temporaer:
                try:
                    os.remove(temporaer)
                except OSError:
                    pass
        return ziel, bericht

    def ics_summary(self, bericht, pfad=None):
        teile = [f"{bericht.get('events', 0)} Termin(e) geschrieben"]
        if bericht.get("skipped"):
            teile.append(f"{bericht['skipped']} Punkt(e) ohne Fälligkeit übersprungen")
        if bericht.get("truncated"):
            teile.append(f"bei {self.MAX_ICS_EVENTS} Terminen abgeschnitten")
        text = ".\n".join(teile) + "."
        return text + (f"\n\n{pfad}" if pfad else "")

    def show_calendar_export_dialog(self, event=None, scope=None):
        """Umfang und Inhalt wählen, Kalenderdatei schreiben und öffnen."""
