    def render_overview_sections(self, innen, abschnitte):
        """Abschnitte einer Übersicht als eine Tabelle (29.09.2026).

        Knöpfe und Hinweise fluchten über alle Abschnitte: Vorher stand jede
        Zeile für sich, und ein langer Hinweis machte ihren Knopf kürzer als die
        übrigen. `abschnitte` ist eine Folge von (Titel, Zeilen, Leertext); eine
        Zeile ist (Zusatz, Beschriftung, Befehl, Hinweis). `Zusatz` baut einen
        Knopf davor – etwa den Stern der Seiten – oder ist None.
        """
        theme = self.theme
        tabelle = tk.Frame(innen, bg=theme["card"])
        tabelle.pack(fill="x")
        tabelle.columnconfigure(1, weight=1)
        nummer = 0
        for titel, zeilen, leer in abschnitte:
            tk.Label(tabelle, text=titel, bg=theme["card"], fg=theme["text"], font=app_font(13, "bold"),
                     anchor="w").grid(row=nummer, column=0, columnspan=3, sticky="ew", pady=(10, 4))
            nummer += 1
            if not zeilen:
                tk.Label(tabelle, text=leer, bg=theme["card"], fg=theme["muted"], font=app_font(10),
                         anchor="w", justify="left", wraplength=640).grid(
                    row=nummer, column=0, columnspan=3, sticky="ew", pady=(0, 4))
                nummer += 1
                continue
            for zusatz, beschriftung, befehl, hinweis in zeilen:
                if zusatz is not None:
                    zusatz(tabelle).grid(row=nummer, column=0, padx=(0, 8), pady=2)
                knopf = self._make_dialog_button(tabelle, beschriftung, befehl, "muted", width=420, height=34)
                knopf.text_anchor = "w"
                knopf.grid(row=nummer, column=1, sticky="ew", pady=2)
                if hinweis:
                    tk.Label(tabelle, text=hinweis, bg=theme["card"], fg=theme["muted"], font=app_font(9),
                             anchor="e").grid(row=nummer, column=2, sticky="e", padx=(8, 0), pady=2)
                nummer += 1
        return tabelle

    def render_pages_page(self):
        """Seitenübersicht: Favoriten, Zuletzt und alle Seiten – nur Seiten."""
        for widget in self.home_content.winfo_children():
            widget.destroy()
        theme = self.theme
        karte = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                            radius=18, padding=10, register=False, auto_height=True)
        karte.pack(fill="x")
        innen = tk.Frame(karte.inner, bg=theme["card"])
        innen.pack(fill="both", expand=True, padx=14, pady=12)
        leiste = ButtonFlow(innen, bg=theme["card"], gap=8)
        leiste.pack(fill="x", pady=(0, 12))
        leiste.add(self._make_dialog_button(leiste, "Neue Seite", self.create_new_page, "confirm", width=128))
        leiste.add(self._make_dialog_button(leiste, "Aus Zwischenablage", self.new_page_from_clipboard,
                                            "muted", width=168))
        leiste.add(self._make_dialog_button(leiste, "Markdown-Datei …", self.import_markdown_page, "muted",
                                            width=152))
        alle = sorted(self.page_entries(), key=lambda entry: str(entry.get("updated_at") or ""), reverse=True)
        nach_id = {entry["id"]: entry for entry in alle}
        favoriten = [nach_id[i] for i in (self.settings.get("page_favorites") or []) if i in nach_id]
        zuletzt = [nach_id[i] for i in (self.settings.get("page_recent") or []) if i in nach_id][:6]

        def zeilen(eintraege):
            ergebnis = []
            for entry in eintraege:
                favorit = entry["id"] in (self.settings.get("page_favorites") or [])

                def stern(master, lid=entry["id"], favorit=favorit):
                    knopf = self._make_dialog_button(master, "★" if favorit else "☆",
                                                     lambda: self.toggle_page_favorite(lid),
                                                     "muted", width=40, height=34)
                    self.add_tooltip(knopf, "Aus Favoriten entfernen" if favorit else "Zu Favoriten hinzufügen")
                    return knopf
                pfad = " › ".join(self.folder_path_titles(entry.get("folder_id"))) if entry.get("folder_id") else ""
                offen = sum(1 for item in self.walk_items(entry.get("items", []))
                            if self.is_schedulable_item(item) and not item.get("done"))
                hinweis = " · ".join(teil for teil in (pfad, f"{offen} offen" if offen else "") if teil)
                ergebnis.append((stern, f"{self.ICONS['pages']}  {entry.get('title') or 'Seite'}",
                                 lambda lid=entry["id"]: self.set_active_list(lid), hinweis))
            return ergebnis

        self.render_overview_sections(innen, (
            ("Favoriten", zeilen(favoriten), "Noch keine Favoriten – in einer Seite unter „Mehr“ oder hier mit ☆."),
            ("Zuletzt geöffnet", zeilen(zuletzt), "Noch keine Seite geöffnet."),
            ("Alle Seiten", zeilen(alle), "Noch keine Seiten. „Neue Seite“ oder einen KI-Bericht als Markdown "
                                          "aus der Zwischenablage übernehmen.")))
        self._bind_home_wheel(karte)

    def remember_recent_page(self, list_id):
        zuletzt = [value for value in (self.settings.get("page_recent") or []) if value != list_id]
        self.settings["page_recent"] = [list_id] + zuletzt[:self.PAGE_RECENT_LIMIT - 1]
        self.save_settings()

    def toggle_page_favorite(self, list_id):
        favoriten = list(self.settings.get("page_favorites") or [])
        if list_id in favoriten:
            favoriten.remove(list_id)
        else:
            favoriten.append(list_id)
        self.settings["page_favorites"] = favoriten
        self.save_settings()
        if self.view_mode == self.PAGES_VIEW:
            self.refresh_tree()
        return "break"

    def sync_note_date_header(self, entry=None, before=None):
        header = getattr(self, "note_date_header", None)
        if header is None:
            return
        visible = bool(entry and entry.get("list_kind") in ("note", "drawing"))
        if before is None:
            # Vor dem ersten gepackten Inhalt: Punktliste oder, bei einer Notiz
            # ohne Punkte, der Editor (29.09.2026).
            editor = getattr(self, "rich_note_editor", None)
            kandidaten = [self.list_frame, editor]
            before = next((w for w in kandidaten if w is not None and w.winfo_manager()), None)
        try:
            if not visible:
                header.pack_forget()
                self.note_journal_actions.pack_forget()
                return
            title, meta = self._german_note_date(entry.get("created_at"))
            updated = self._list_timestamp(entry.get("updated_at"), default_now=False)
            created = self._list_timestamp(entry.get("created_at"), default_now=False)
            if updated and created and updated != created:
                try:
                    stamp = datetime.fromisoformat(updated.replace("Z", "+00:00"))
                    if stamp.tzinfo is not None:
                        stamp = stamp.astimezone()
                    meta += f" · zuletzt bearbeitet {stamp:%d.%m.%Y %H:%M}"
                except ValueError:
                    pass
            self.note_date_title.configure(text=title)
            self.note_date_meta.configure(text=meta)
            if header.winfo_manager() != "pack":
                header.pack(fill="x", before=before)
            journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
            mood = dict(self.JOURNAL_MOODS).get(journal.get("mood"), "Stimmung")
            self.note_favorite_button.set_text("★ Favorit" if journal.get("favorite") else "☆ Favorit")
            self.note_mood_button.set_text(mood if journal.get("mood") else "Stimmung")
            self.note_location_button.set_text(journal.get("location") or "Ort")
            if self.note_journal_actions.winfo_manager() != "pack":
                self.note_journal_actions.pack(fill="x", padx=self.CONTENT_INSET[0], pady=(4, 4), before=before)
        except tk.TclError:
            pass

    def update_current_journal(self, **changes):
        entry = self.current_list() if self.view_mode == "list" else None
        if not entry or entry.get("list_kind") not in ("note", "drawing"):
            return "break"
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        journal.update(changes)
        journal = self.normalize_journal(journal, created_at=entry.get("created_at", ""))
        if journal != entry.get("journal"):
            with self.sidebar_change(refresh_tree=False) as change:
                entry["journal"] = journal
                entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
                change.mark()
        self.sync_note_date_header(entry)
        return "break"

    def toggle_journal_favorite(self):
        entry = self.current_list()
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        return self.update_current_journal(favorite=not journal.get("favorite"))

    def choose_journal_mood(self):
        entry = self.current_list()
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        chosen = self.themed_choice_dialog(
            "Stimmung", "Wie fühlt sich dieser Moment an?", list(self.JOURNAL_MOODS)
        )
        if chosen is None:
            return "break"
        return self.update_current_journal(mood=chosen)

    def edit_journal_location(self):
        entry = self.current_list()
        journal = self.normalize_journal(entry.get("journal"), created_at=entry.get("created_at", ""))
        value = self.themed_input_dialog(
            "Ort", "Wo ist dieser Moment entstanden? (optional)", journal.get("location", ""),
            ok_text="Übernehmen", accent_key="muted",
        )
        if value is None:
            return "break"
        return self.update_current_journal(location=value)

    def insert_journal_prompt(self):
        choices = [(prompt, prompt) for prompt in self.JOURNAL_PROMPTS]
        prompt = self.themed_choice_dialog("Schreibimpuls", "Wähle eine Frage:", choices)
        if not prompt:
            return "break"
        editor = getattr(self, "rich_note_editor", None)
        if editor is not None and editor.winfo_exists():
            editor.text.insert("insert", f"\n{prompt}\n\n")
            editor.text.see("insert")
            editor.text.focus_set()
            editor.changed()
        self.update_current_journal(prompt=prompt)
        return "break"

    NOTE_TEXT_MIN_LINES = 5

    def sync_rich_note_view(self):
        if not hasattr(self, "list_frame"):
            return
        entry = self.current_list() if self.view_mode == "list" else None
        visible = bool(entry and entry.get("list_kind") in ("note", self.LIST_KIND_PAGE)
                       and not getattr(self.workspace, "visible", False))
        seite = visible and self.is_page_list(entry)
        editor = getattr(self, "rich_note_editor", None)
        if not visible and editor is None:
            self.sync_note_date_header(None)
            return
        identity = entry.get("id") if visible else None
        signature = (identity, seite, tuple(sorted(self.theme.items())))
        if editor is not None and (not visible or getattr(self, "_rich_note_signature", None) != signature):
            editor.flush()
            editor.destroy()
            self.rich_note_editor = editor = None
        if not visible:
            self.sync_note_date_header(None)
            self.tree.configure(height=10)
            if (self.view_mode == "list" and not getattr(self.workspace, "visible", False)
                    and not self.is_surface_list(entry)):
                self.list_frame.pack_configure(fill="both", expand=True)
            return
        if seite:
            # Die Seite ist ihr eigener Inhalt: Aufgaben stehen im Text, die
            # Punktliste darüber entfällt.
            if self.list_frame.winfo_manager():
                self.list_frame.pack_forget()
            if editor is None and self.append_unlisted_page_tasks(entry):
                self.save_items()
        elif not entry.get("items"):
            # Eine Notiz ohne Punkte zeigt keine leere Punktliste (B3,
            # 29.09.2026): Die Eingabezeile darüber legt den ersten an, dann
            # erscheint die Liste. Vorher standen dort „Noch keine Punkte
            # vorhanden“, ein Knopf und Gismo – Form ohne Inhalt.
            if self.list_frame.winfo_manager():
                self.list_frame.pack_forget()
        elif not self.list_frame.winfo_manager():
            # Hinter dem Editor in der Packreihenfolge: Der Text behält Vorrang.
            if editor is not None and editor.winfo_manager():
                self.list_frame.pack(fill="x", expand=False, after=editor)
            else:
                self.list_frame.pack(fill="x", expand=False)
        self.sync_note_date_header(None if seite else entry)
        # Hinweis und Auswahlleiste regelt seit dem 29.09.2026 der Kartenfuß
        # (`card_foot_mode`): Notiz und Seite haben keinen.
        self.tree.configure(height=6)
        self.scrollbar.configure(height=1)
        if not seite and self.list_frame.winfo_manager():
            self.list_frame.pack_configure(fill="x", expand=False)
        if editor is None:
            self._rich_note_signature = signature
            speichern = lambda document, lid=identity: self.store_rich_note(lid, document)
            if seite:
                editor = PageEditor(self.list_frame_outer.inner, self, entry, on_change=speichern)
                editor.pack(fill="both", expand=True, padx=self.CONTENT_INSET, pady=self.CONTENT_INSET[0])
                self.remember_recent_page(identity)
            else:
                # Seit 29.09.2026 der Seiteneditor als Notizeditor (R5).
                editor = NoteEditor(self.list_frame_outer.inner, self, entry, on_change=speichern)
                # Eine Notiz ist zuerst Text (29.09.2026): Der Editor bekommt
                # seinen Platz vor der Punktliste – unten angesetzt, in der
                # Packreihenfolge vor ihr. Bei 860 × 700 blieb vom Text vorher
                # nur ein Strich, weil die Liste ihre sechs Zeilen zuerst nahm.
                # Seine Mindesthöhe sind NOTE_TEXT_MIN_LINES Zeilen; mehr Platz
                # bekommt er wie bisher über `expand`.
                editor.text.configure(height=self.NOTE_TEXT_MIN_LINES)
                optionen = {"before": self.list_frame} if self.list_frame.winfo_manager() else {}
                editor.pack(side="bottom", fill="both", expand=True, padx=self.CONTENT_INSET,
                            pady=(8, self.CONTENT_INSET[0]), **optionen)
            self.rich_note_editor = editor
        elif editor._last != entry.get("rich_note"):
            editor.load(entry.get("rich_note"))
            editor._last = RichNoteEditor.normalize(entry.get("rich_note"))
        else:
            editor.refresh_tasks()
        query = self.current_search_query()
        editor.text.tag_remove("search_match", "1.0", "end")
        if query:
            editor.text.tag_configure("search_match", background=self.theme["selection"], foreground=self.theme["selection_text"])
            start = "1.0"
            while True:
                found = editor.text.search(query, start, stopindex="end", nocase=True)
                if not found:
                    break
                end = editor.text.index(f"{found}+{len(query)}c")
                editor.text.tag_add("search_match", found, end)
                start = end

    # --- Zeichnungsseiten ----------------------------------------------------
    def drawing_view_state(self, list_id):
        """Ansichtszustand je Zeichnung für die laufende Sitzung, nie gespeichert."""
        states = getattr(self, "_drawing_views", None)
        if states is None:
            states = self._drawing_views = {}
        return states.setdefault(list_id, {})

    # Werkzeugzustand über alle Zeichnungen hinweg ---------------------------
    DRAWING_SNAPSHOT_MIME = "application/vnd.glide.drawing-snapshot+json"
    MAX_DRAWING_SNAPSHOTS = 10

    def drawing_tool_settings(self):
        """Programmweite Werkzeugeinstellungen (Farben, Paletten, Vorschau)."""
        settings = self.settings if isinstance(getattr(self, "settings", None), dict) else {}
        tools = settings.get("drawing_tools")
        if not isinstance(tools, dict) or "recent_colors" not in tools:
            tools = self.normalize_drawing_tools(tools)
            if isinstance(getattr(self, "settings", None), dict):
                self.settings["drawing_tools"] = tools
        return tools

    def remember_drawing_tools(self, **changes):
        """Übernimmt Werkzeugwerte und speichert gebündelt nach einer kurzen Pause."""
        tools = dict(self.drawing_tool_settings())
        tools.update(changes)
        self.settings["drawing_tools"] = self.normalize_drawing_tools(tools)
        job = getattr(self, "_drawing_tools_job", None)
        if job is not None:
            try:
                self.root.after_cancel(job)
            except tk.TclError:
                pass
        try:
            self._drawing_tools_job = self.root.after(400, self._save_drawing_tools)
        except tk.TclError:
            self._drawing_tools_job = None

    def _save_drawing_tools(self):
        self._drawing_tools_job = None
        self.save_settings()

    def drawing_palette(self, palette_id, model=None):
        """Name und Farben einer Palette: diese Zeichnung, Glide 32 oder eigene."""
        if palette_id == glide_drawing.GLIDE_PALETTE_ID:
            return palette_id, glide_drawing.GLIDE_PALETTE_NAME, list(glide_drawing.GLIDE_PALETTE)
        for palette in self.drawing_tool_settings()["palettes"]:
            if palette["id"] == palette_id:
                return palette["id"], palette["name"], list(palette["colors"])
        colors = model.used_colors()[:64] if model is not None else []
        return "drawing", "Diese Zeichnung", colors

    def show_drawing_palette_menu(self, editor, anchor):
        tools = self.drawing_tool_settings()
        menu = tk.Menu(self.root, tearoff=0, bg=self.theme["card"], fg=self.theme["text"],
                       activebackground=self.theme["selection"], activeforeground=self.theme["selection_text"],
                       bd=0)
        choice = tk.StringVar(value=tools["palette"])
        editor._palette_choice = choice

        def choose():
            self.remember_drawing_tools(palette=choice.get())
            editor.draw_strip()

        entries = [("drawing", "Farben dieser Zeichnung"),
                   (glide_drawing.GLIDE_PALETTE_ID, f"{glide_drawing.GLIDE_PALETTE_NAME} · Glide-Inhaltspalette")]
        entries += [(palette["id"], palette["name"]) for palette in tools["palettes"]]
        for value, label in entries:
            menu.add_radiobutton(label=label, value=value, variable=choice, command=choose)
        menu.add_separator()
        menu.add_command(label="Farben dieser Zeichnung als Palette speichern …",
                         command=lambda: self.drawing_save_palette(editor))
        menu.add_command(label="Palette importieren (.gpl, .hex, .ase) …", command=lambda: self.drawing_import_palette(editor))
        menu.add_command(label="Gewählte Palette exportieren …", command=lambda: self.drawing_export_palette(editor))
        if tools["palette"].startswith("user-"):
            menu.add_command(label="Gewählte Palette löschen …", command=lambda: self.drawing_delete_palette(editor))
        try:
            menu.tk_popup(anchor.winfo_rootx(), anchor.winfo_rooty() + anchor.winfo_height())
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    def _add_drawing_palette(self, name, colors):
        tools = self.drawing_tool_settings()
        if len(tools["palettes"]) >= self.MAX_DRAWING_PALETTES:
            raise glide_drawing.DrawingFormatError(
                f"Es können höchstens {self.MAX_DRAWING_PALETTES} eigene Paletten gespeichert werden.")
        palette = {"id": "user-" + uuid.uuid4().hex[:12], "name": name, "colors": list(colors)}
        self.remember_drawing_tools(palettes=tools["palettes"] + [palette], palette=palette["id"])
        return palette

    def drawing_save_palette(self, editor):
        colors = [color for color in editor.model.used_colors()]
        name = self.themed_input_dialog("Palette speichern", "Name der Palette:",
                                        initial=f"Palette aus „{self.drawing_title(editor)}“")
        if not name or not name.strip():
            return
        try:
            self._add_drawing_palette(" ".join(name.split())[:60], colors)
        except glide_drawing.DrawingFormatError as exc:
            self.show_error("Palette speichern", str(exc))
            return
        editor.draw_strip()
        editor.update_status(f"Palette gespeichert: {len(colors)} Farben")

    def drawing_import_palette(self, editor):
        path = filedialog.askopenfilename(
            parent=self.root, title="Palette importieren",
            filetypes=[("Paletten", "*.gpl *.hex *.txt *.ase *.aseprite"), ("GIMP-Palette", "*.gpl"),
                       ("Hex-Liste", "*.hex"), ("Aseprite oder Adobe-Farbfelder", "*.ase *.aseprite")])
        if not path:
            return
        stem = os.path.splitext(os.path.basename(path))[0]
        try:
            # Aseprite und Adobe-Farbfelder sind binär (G20, 30.09.2026).
            if path.lower().endswith((".ase", ".aseprite")):
                with open(path, "rb") as source:
                    data = source.read(glide_drawing.MAX_BINARY_PALETTE_BYTES + 1)
                name, colors = glide_drawing.parse_binary_palette(data, stem)
            else:
                with open(path, "r", encoding="utf-8-sig") as source:
                    text = source.read(256 * 1024 + 1)
                name, colors = glide_drawing.parse_palette(text, stem)
            self._add_drawing_palette(name, colors)
        except (OSError, UnicodeError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("Palette importieren", f"Die Datei wurde nicht übernommen.\n\n{exc}")
            return
        editor.draw_strip()
        editor.update_status(f"Palette „{name}“ importiert: {len(colors)} Farben")

    def drawing_export_palette(self, editor):
        palette_id, name, colors = self.drawing_palette(self.drawing_tool_settings()["palette"], editor.model)
        if not colors:
            return
        stem = re.sub(r"[^\w .()-]+", "_", name, flags=re.UNICODE).strip(" .")[:60] or "Palette"
        path = filedialog.asksaveasfilename(
            parent=self.root, title="Palette exportieren", initialfile=stem + ".gpl", defaultextension=".gpl",
            filetypes=[("GIMP-Palette", "*.gpl"), ("Hex-Liste", "*.hex")])
        if not path:
            return
        text = glide_drawing.palette_to_hex(colors) if path.lower().endswith(".hex") else \
            glide_drawing.palette_to_gpl(name, colors)
        try:
            self.write_text_atomic(path, text)
        except (OSError, ValueError) as exc:
            self.show_error("Palette exportieren", str(exc))
            return
        editor.update_status(f"Palette exportiert: {os.path.basename(path)}")

    def drawing_delete_palette(self, editor):
        tools = self.drawing_tool_settings()
        palette = next((entry for entry in tools["palettes"] if entry["id"] == tools["palette"]), None)
        if palette is None or not self.ask_yes_no("Palette löschen", f"Die Palette „{palette['name']}“ "
                                                  "wird gelöscht. Zeichnungen behalten ihre Farben."):
            return
        self.remember_drawing_tools(palettes=[entry for entry in tools["palettes"] if entry is not palette],
                                    palette="drawing")
        editor.draw_strip()

    def drawing_title(self, editor):
        entry = self.drawing_entry(editor)
        return str(entry.get("title") or "Zeichnung") if entry else "Zeichnung"

    # Farben der Zeichnung ------------------------------------------------------
    def drawing_replace_color(self, editor, color=None):
        """Ersetzt eine Farbe in der ganzen Zeichnung – ein Rückgängig-Schritt.

        Seit 3.35.0 (G19) zeigt die Zeichnung das Ergebnis, bevor es gilt:
        Ablehnen setzt Zellen und Palette zurück, ohne Verlaufseintrag.
        """
        color = color or editor.color
        if color not in editor.model.palette or color not in editor.model.used_colors():
            # Vorher nur ein Satz in der Statuszeile – der Menüeintrag wirkte tot (R11).
            editor.update_status(f"{color} kommt in der Zeichnung nicht vor")
            self.show_info("Farbe ersetzen", f"Die Vordergrundfarbe {color} kommt in der Zeichnung nicht vor. "
                           "Wähle zuerst eine Farbe aus der Zeichnung, etwa mit der Pipette (I).")
            return
        replacement = self.drawing_color_dialog(color, editor.model.palette,
                                                title=f"{color} ersetzen durch …")
        if not replacement or replacement == color:
            return
        model = editor.model
        palette_vorher = len(model.palette)
        try:
            model.begin_action("Farbe ersetzen")
            anzahl = model.replace_color(color, replacement)
        except glide_drawing.DrawingFormatError as exc:
            editor._abort_action(str(exc))
            return
        editor.render_full()
        editor.update_status(f"Vorschau: {anzahl} Zelle(n) {color} → {replacement}")
        if not self.ask_yes_no("Farbe ersetzen",
                               f"{anzahl} Zelle(n) wechseln von {color} zu {replacement}. Die Zeichnung zeigt "
                               "das Ergebnis bereits. Übernehmen?"):
            model.discard_open_action(palette_vorher)
            editor.render_full()
            editor.update_status("Farbe ersetzen verworfen – Zeichnung unverändert")
            return
        editor._finish_action({"color": replacement})

    def drawing_compact_palette(self, editor):
        unused = editor.model.unused_palette_count()
        if not unused:
            editor.update_status("Alle Palettenfarben kommen in der Zeichnung vor")
            return
        if not self.ask_yes_no("Unbenutzte Farben entfernen",
                               f"{unused} Farbe(n) kommen in der Zeichnung nicht mehr vor und werden aus "
                               "ihrer Palette entfernt. Danach ist Platz für neue Farben; der bisherige "
                               "Rückgängig-Verlauf dieser Seite entfällt."):
            return
        removed = editor.model.compact_palette()
        editor.render_full()
        editor.mark_unsaved()
        editor.schedule_save()
        editor.update_status(f"{removed} unbenutzte Farbe(n) entfernt")

    # Zwischenstände als Anhänge (ZD-080) ---------------------------------------
    def drawing_snapshots(self, entry):
        return [item for item in entry.get("attachments", []) if item.get("mime") == self.DRAWING_SNAPSHOT_MIME]

    def drawing_snapshot_save(self, editor):
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        if len(self.drawing_snapshots(entry)) >= self.MAX_DRAWING_SNAPSHOTS:
            self.show_info("Zwischenstand merken", f"Eine Zeichnung behält höchstens "
                                                   f"{self.MAX_DRAWING_SNAPSHOTS} Zwischenstände. Bitte zuerst "
                                                   "einen älteren löschen.")
            return
        name = self.themed_input_dialog("Zwischenstand merken", "Name des Zwischenstands:",
                                        initial=datetime.now().strftime("%d.%m.%Y %H:%M"))
        if name is None:
            return
        name = " ".join(name.split())[:60] or datetime.now().strftime("%d.%m.%Y %H:%M")
        editor.flush()
        handle, temporary = tempfile.mkstemp(prefix=".glide-snapshot-", suffix=".json")
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as file:
                file.write(editor.model.to_json() + "\n")
            stored = self.store_attachment(temporary)
        except OSError as exc:
            self.show_error("Zwischenstand merken", str(exc))
            return
        finally:
            try:
                os.remove(temporary)
            except OSError:
                pass
        stored.update(name=f"Zwischenstand – {name}.json", mime=self.DRAWING_SNAPSHOT_MIME)
        with self.sidebar_change(refresh_tree=False, feedback=False) as change:
            entry.setdefault("attachments", []).append(stored)
            change.mark()
        editor.update_status(f"Zwischenstand „{name}“ gemerkt · „Mehr“ → „Zwischenstände …“")

    def read_drawing_snapshot(self, attachment):
        path = self.resolve_attachment_path(attachment)
        if not path or not os.path.isfile(path):
            raise OSError("Die Datei des Zwischenstands fehlt auf diesem Gerät.")
        with open(path, "rb") as source:
            content = source.read(glide_drawing.MAX_JSON_BYTES + 1)
        return glide_drawing.DrawingModel.from_json(content)

    def drawing_snapshot_dialog(self, editor):
        """Gemerkte Stände ansehen, wiederherstellen, als neue Zeichnung öffnen oder löschen."""
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        dialog, body = self._drawing_dialog("Zwischenstände")
        tk.Label(body, text="Wiederherstellen legt den aktuellen Stand als Rückgängig-Schritt ab.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10), anchor="w").pack(anchor="w")
        rows = tk.Frame(body, bg=self.theme["bg"])
        rows.pack(fill="both", expand=True, pady=(8, 0))
        images = []

        def fill():
            for child in rows.winfo_children():
                child.destroy()
            images.clear()
            snapshots = self.drawing_snapshots(entry)
            if not snapshots:
                tk.Label(rows, text="Noch keine Zwischenstände. „Mehr“ → „Zwischenstand merken …“",
                         bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10)).pack(anchor="w")
            for attachment in snapshots:
                row = tk.Frame(rows, bg=self.theme["bg"])
                row.pack(fill="x", pady=4)
                try:
                    model = self.read_drawing_snapshot(attachment)
                    image = glide_drawing_image.thumbnail_photo(model, 48, master=row)
                    images.append(image)
                    tk.Label(row, image=image, **self.thumbnail_frame_options()).pack(side="left")
                except (OSError, glide_drawing.DrawingFormatError) as exc:
                    model = None
                    tk.Label(row, text=f"nicht lesbar: {exc}", bg=self.theme["bg"], fg=self.theme["delete"],
                             font=app_font(9)).pack(side="left")
                name = str(attachment.get("name") or "Zwischenstand")
                name = name.removeprefix("Zwischenstand – ").removesuffix(".json")
                when = str(attachment.get("added_at") or "")[:16].replace("T", " ")
                tk.Label(row, text=f"{name}\n{when}", bg=self.theme["bg"], fg=self.theme["text"],
                         font=app_font(10), justify="left", anchor="w").pack(side="left", padx=(10, 0))
                buttons = tk.Frame(row, bg=self.theme["bg"])
                buttons.pack(side="right")
                if model is not None:
                    self._make_dialog_button(buttons, "Wiederherstellen",
                                             lambda value=model: restore(value), "confirm",
                                             width=140, height=30).pack(side="left")
                    self._make_dialog_button(buttons, "Als neue Zeichnung",
                                             lambda value=model, label=name: as_new(value, label), "muted",
                                             width=150, height=30).pack(side="left", padx=(6, 0))
                self._make_dialog_button(buttons, "Löschen", lambda value=attachment: delete(value), "muted",
                                         width=80, height=30).pack(side="left", padx=(6, 0))

        def restore(model):
            def mutate():
                entry["drawing"] = model.to_document()
                return True
            if self.apply_drawing_change(entry, mutate):
                dialog.destroy()
                current = self.current_drawing_editor()
                if current is not None:
                    current.update_status("Zwischenstand wiederhergestellt · Rückgängig holt den vorherigen Stand")

        def as_new(model, label):
            dialog.destroy()
            self.create_drawing_from_model(model, f"{entry.get('title', 'Zeichnung')} – {label}",
                                           entry.get("folder_id"))

        def delete(attachment):
            if not self.ask_yes_no("Zwischenstand löschen", "Der Zwischenstand wird aus den Anhängen "
                                   "dieser Zeichnung entfernt.", parent=dialog):
                return
            with self.sidebar_change(refresh_tree=False, feedback=False) as change:
                entry["attachments"] = [item for item in entry.get("attachments", []) if item is not attachment]
                change.mark()
            fill()

        fill()
        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(fill="x", pady=(14, 0))
        self._make_dialog_button(footer, "Schließen", dialog.destroy, "muted", width=110).pack(side="right")
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.protocol("WM_DELETE_WINDOW", dialog.destroy)
        self._center_dialog(dialog, min_width=560)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)

    def create_drawing_from_model(self, model, title, folder_id=None):
        folder = self.get_folder(folder_id) if folder_id else None
        entry = self.new_list_object(
            " ".join(str(title or "Zeichnung").split())[:120] or "Zeichnung", [],
            folder_id=folder_id if folder else None, list_kind=self.LIST_KIND_DRAWING,
            drawing=model.to_document(),
            journal={"moment_date": date.today().isoformat()} if folder and folder.get("folder_kind") == "journal" else None,
        )
        with self.sidebar_change(refresh_tree=True) as change:
            self.lists.append(entry)
            self.set_active_list(entry["id"], refresh=False)
            change.mark()
        return entry

    # PNG (ZD-120) --------------------------------------------------------------
    def drawing_export_png(self, editor, scale):
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        editor.flush()
        model = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
        title = str(entry.get("title") or "Zeichnung")
        stem = re.sub(r"[^\w .()-]+", "_", title, flags=re.UNICODE).strip(" .")[:80] or "Zeichnung"
        path = filedialog.asksaveasfilename(
            parent=self.root, title=f"Als PNG exportieren ({model.width * scale} Pixel)",
            defaultextension=".png", initialfile=f"{stem}_{model.width * scale}px.png",
            filetypes=[("PNG-Bild", "*.png")])
        if not path:
            return
        try:
            self.write_bytes_atomic(path, model.to_png(scale))
        except (OSError, ValueError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("Als PNG exportieren", str(exc))
            return
        editor.update_status(f"PNG exportiert: {os.path.basename(path)} · {model.width * scale} × "
                             f"{model.height * scale} Pixel")

    # Symbol (G16, 30.09.2026) ---------------------------------------------------
    ICON_PREVIEW_GROUNDS = (("Heller Grund", "#FFFFFF"), ("Dunkler Grund", "#1C1C1E"))
    ICON_PREVIEW_SIZES = (16, 32, 48)

    def drawing_icon_preview(self, model, transparent=True):
        """Symbolvorschau vor dem ICO-Export (G-03 seit 3.35.0) – True heißt exportieren.

        16, 32 und 48 px auf hellem und dunklem Grund, in Originalgröße und
        doppelt (ganzzahlig, ohne Glättung). Die Bilder entstehen aus derselben
        Rechnung wie die ICO-Datei (`drawing.icon_preview_rows`) und sind
        deshalb pixelgleich zu ihr.
        """
        result = {"ok": False}
        theme = self.theme
        dialog, body = self._drawing_dialog("Symbol vor dem Export prüfen")
        dialog._glide_icon_previews = {}
        tk.Label(body, text=("Grund durchsichtig" if transparent else "Grund weiß")
                 + " · links Originalgröße, rechts doppelt. 256 px entsteht ebenso ohne Glättung.",
                 bg=theme["bg"], fg=theme["muted"], font=app_font(10), anchor="w", justify="left",
                 wraplength=self.DIALOG_TEXT_WIDTH).pack(anchor="w")
        raster = tk.Frame(body, bg=theme["bg"])
        raster.pack(anchor="w", pady=(10, 0))
        for zeile, (name, grund) in enumerate(self.ICON_PREVIEW_GROUNDS):
            tk.Label(raster, text=name, bg=theme["bg"], fg=theme["text"], font=app_font(10),
                     anchor="w").grid(row=zeile, column=0, sticky="w", padx=(0, 12))
            for spalte, groesse in enumerate(self.ICON_PREVIEW_SIZES, 1):
                zeilen = glide_drawing.icon_preview_rows(model.width, model.palette, model.cells, groesse,
                                                         background=grund, transparent_background=transparent)
                bild = tk.PhotoImage(master=dialog, width=groesse, height=groesse)
                bild.put(" ".join("{" + " ".join(reihe) + "}" for reihe in zeilen))
                doppelt = tk.PhotoImage(master=dialog, width=2 * groesse, height=2 * groesse)
                doppelt.tk.call(doppelt.name, "copy", bild.name, "-zoom", 2, 2)
                dialog._glide_icon_previews[(grund, groesse)] = bild
                dialog._glide_icon_previews[(grund, groesse, 2)] = doppelt
                zelle = tk.Frame(raster, bg=grund, padx=10, pady=10, highlightthickness=1,
                                 highlightbackground=theme["line"])
                zelle.grid(row=zeile, column=spalte, padx=4, pady=4, sticky="nsew")
                tk.Label(zelle, image=bild, bg=grund, bd=0, highlightthickness=0).pack(side="left", anchor="s")
                tk.Label(zelle, image=doppelt, bg=grund, bd=0, highlightthickness=0).pack(
                    side="left", anchor="s", padx=(10, 0))
        for spalte, groesse in enumerate(self.ICON_PREVIEW_SIZES, 1):
            tk.Label(raster, text=f"{groesse} px", bg=theme["bg"], fg=theme["muted"],
                     font=app_font(9)).grid(row=len(self.ICON_PREVIEW_GROUNDS), column=spalte)

        def exportieren(_event=None):
            result["ok"] = True
            dialog.destroy()
            return "break"

        footer = tk.Frame(body, bg=theme["bg"])
        footer.pack(fill="x", pady=(14, 0))
        self._make_dialog_button(footer, "Exportieren …", exportieren, "muted").pack(side="right")
        self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        dialog.bind("<Return>", exportieren)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.protocol("WM_DELETE_WINDOW", dialog.destroy)
        self._center_dialog(dialog, min_width=420)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return result["ok"]

    def drawing_export_ico(self, editor, transparent=True):
        """Zeichnung als ICO mit 16, 32, 48 und 256 Pixeln – App-Symbol und Favicon.

        ICO lesen Windows, macOS, Linux und alle Browser; es ist deshalb das
        eine Symbolformat für alle Plattformen. Verkleinert wird ohne
        Glättung (nächster Nachbar); Zeichnungen in 16 oder 32 Zellen passen
        ohne Verlust.
        """
        entry = self.drawing_entry(editor)
        if entry is None:
            return
        editor.flush()
        model = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
        if not self.drawing_icon_preview(model, transparent):
            editor.update_status("Symbolexport abgebrochen")
            return
        title = str(entry.get("title") or "Zeichnung")
        stem = re.sub(r"[^\w .()-]+", "_", title, flags=re.UNICODE).strip(" .")[:80] or "Zeichnung"
        path = filedialog.asksaveasfilename(
            parent=self.root, title="Als Symbol exportieren (ICO)", defaultextension=".ico",
            initialfile=f"{stem}.ico", filetypes=[("Symbol", "*.ico")])
        if not path:
            return
        try:
            self.write_bytes_atomic(path, model.to_ico(transparent_background=transparent))
        except (OSError, ValueError, glide_drawing.DrawingFormatError) as exc:
            self.show_error("Als Symbol exportieren", str(exc))
            return
        groessen = ", ".join(str(size) for size in glide_drawing.ICON_SIZES)
        hinweis = "" if model.width in (16, 32) else " · verkleinert ohne Glättung"
        editor.update_status(f"Symbol exportiert: {os.path.basename(path)} · {groessen} Pixel{hinweis}")

    def write_bytes_atomic(self, path, data):
        """Binärexport atomar schreiben; Nutzdatendateien sind als Ziel ausgeschlossen."""
        target = os.path.abspath(path)
        self.validate_backup_target(target)
        directory = os.path.dirname(target)
        os.makedirs(directory, exist_ok=True)
        handle, temporary = tempfile.mkstemp(prefix=".glide-export-", suffix=".tmp", dir=directory)
        try:
            with os.fdopen(handle, "wb") as file:
                file.write(data)
                file.flush()
                os.fsync(file.fileno())
            os.replace(temporary, target)
            temporary = None
        finally:
            if temporary:
                try:
                    os.remove(temporary)
                except OSError:
                    pass
        return target

    # Importvorschau und Einfügen aus Text (Rest ZF-050) --------------------------
    def parse_drawing_text(self, text):
        """JSON-Zellmodell oder Glide-SVG aus Text; liefert (Modell, Warnungen)."""
        if not isinstance(text, str) or not text.strip():
            raise glide_drawing.DrawingFormatError("Die Zwischenablage enthält keinen Text.")
        stripped = text.lstrip("﻿ \t\r\n")
        if stripped.startswith("<"):
            imported = glide_drawing.import_glide_svg(stripped)
            return imported.model, list(imported.warnings)
        return glide_drawing.DrawingModel.from_json(stripped), []

