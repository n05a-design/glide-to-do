    # ------------------------------------------------------------------
    # Ein Zwischenspeicher für die Dauer eines Aufbaus.
    #
    # Der Profilerlauf zeigte, woran der Ansichtswechsel hing: Nicht am
    # Zeichnen, sondern daran, dass derselbe Bestand für einen einzigen
    # Wechsel mehrfach vollständig durchlaufen wurde. Die Seitenleiste fragt
    # für ihre acht Zeilen nacheinander nach der Zahl der fälligen Punkte, der
    # überfälligen, der eingeplanten und der mit Label – jede dieser Fragen
    # lief über alle Listen und alle verschachtelten Punkte. Danach rechnete
    # `refresh_sidebar_row_texts` dieselben Zahlen für die Textkürzung noch
    # einmal aus, und die Ansicht selbst ein drittes Mal.
    #
    # Der Zwischenspeicher lebt ausschließlich innerhalb eines Aufbaus: Er
    # entsteht mit `render_pass()` und verschwindet an dessen Ende. Außerhalb
    # rechnet jede Abfrage wie bisher frisch. Das ist die entscheidende
    # Eigenschaft – ein Speicher, der über den Aufbau hinaus lebte, müsste bei
    # jeder denkbaren Bestandsänderung geleert werden, und genau eine
    # vergessene Stelle würde eine falsche Zahl anzeigen. Innerhalb eines
    # Aufbaus dagegen ändert sich der Bestand nicht: Aufbauten lesen nur.
    #
    # Verschachtelung ist ausdrücklich erlaubt und der Normalfall – ein
    # Ansichtswechsel öffnet den Durchgang, ruft danach Seitenleiste und
    # Baumaufbau, die ihn beide ebenfalls öffnen. Nur der äußerste legt den
    # Speicher an und räumt ihn wieder weg.
    @contextlib.contextmanager
    def render_pass(self):
        """Fasst einen Aufbau zusammen, damit Kennzahlen nur einmal laufen."""
        aeusserster = getattr(self, "_render_cache", None) is None
        if aeusserster:
            self._render_cache = {}
        try:
            yield
        finally:
            if aeusserster:
                self._render_cache = None

    def render_cached(self, key, factory):
        """Liefert einen für diesen Aufbau bereits berechneten Wert."""
        speicher = getattr(self, "_render_cache", None)
        if speicher is None:
            return factory()
        if key not in speicher:
            speicher[key] = factory()
        return speicher[key]

    def clear_render_cache(self):
        """Verwirft den Aufbau-Zwischenspeicher.

        Zählt zugleich den Datenstand hoch: Jede Bestandsänderung läuft vor
        dem Speichern hier durch. Die Startseite erkennt daran, ob sie
        unverändert stehen bleiben darf (P03r).
        """
        self._data_revision = getattr(self, "_data_revision", 0) + 1
        cache = getattr(self, "_render_cache", None)
        if cache is not None:
            cache.clear()

    def count_due_tasks(self):
        """Anzahl aller Punkte mit Fälligkeit – Grundlage für „Demnächst“."""
        return len(self.get_in_progress_items(apply_filters=False))

    def set_trash_view(self, refresh=True):
        """Öffnet den Papierkorb mit allen gelöschten Listen und Ordnern."""
        self._activate_system_view("trash", refresh=refresh)

    def _activate_system_view(self, mode, refresh=True):
        with self.render_pass():
            return self.__activate_system_view(mode, refresh=refresh)

    def __activate_system_view(self, mode, refresh=True):
        if self.active_list_id and self.lists:
            self.sync_current_list_reference()
        # Nur beim Wechsel von woanders auf die Startseite: Ein Neuaufbau
        # derselben Ansicht behält seinen Begrüßungssatz.
        if mode == self.HOME_VIEW and self.view_mode != self.HOME_VIEW:
            self.advance_home_greeting()
        self.view_mode = mode
        self.active_folder_id = None
        self.finish_page_switch(refresh=refresh)

