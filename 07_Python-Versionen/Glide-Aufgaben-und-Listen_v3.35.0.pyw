        self.home_content.update_idletasks()
        self._layout_home_canvas()
        self.home_canvas.yview_moveto(scroll_position)

    # --- Pixelsymbole (Format 20) ----------------------------------------------
    def page_icon_scale(self):
        """Ganzzahliger Faktor, damit 16 Zellen bei hoher Auflösung lesbar bleiben."""
        try:
            scaling = float(self.root.tk.call("tk", "scaling"))
        except (tk.TclError, ValueError):
            scaling = 1.3333
        return max(1, min(4, round(scaling / 1.3333)))

    def page_icon_image(self, holder, scale=None):
        """PhotoImage des Pixelsymbols einer Liste oder eines Ordners, zwischengespeichert."""
        icon = holder.get("icon") if isinstance(holder, dict) else None
        if not isinstance(icon, dict):
            return None
        scale = scale or self.page_icon_scale()
        key = (hashlib.sha256("".join(icon.get("rows", [])).encode("ascii") + "".join(
            icon.get("palette", [])).encode("ascii")).hexdigest(), scale)
        cache = getattr(self, "_page_icon_cache", None)
        if cache is None:
            cache = self._page_icon_cache = {}
        image = cache.get(key)
        if image is None:
            try:
                model = glide_drawing.DrawingModel.from_document(icon)
                image = glide_drawing_image.model_to_photo(model, scale=scale, master=self.root)
            except (glide_drawing.DrawingFormatError, tk.TclError):
                return None
            if len(cache) > 400:
                cache.clear()
            cache[key] = image
        return image

    def page_icon_dialog(self, kind, identity):
        """16-×-16-Symbol zeichnen oder aus einer Zeichnung übernehmen."""
        holder = self.get_folder(identity) if kind == "folder" else next(
            (entry for entry in self.lists if entry.get("id") == identity), None)
        if holder is None:
            return False
        size = self.PAGE_ICON_SIZE
        state = {"document": copy.deepcopy(holder.get("icon")) or glide_drawing.DrawingModel.blank(size).to_document(),
                 "result": None}
        dialog = tk.Toplevel(self.root)
        dialog.title("Pixelsymbol")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.minsize(620, 620)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(body, text=f"Pixelsymbol für „{holder.get('title', '')}“", bg=self.theme["bg"],
                 fg=self.theme["text"], font=app_font(15, "bold"), anchor="w").pack(anchor="w")
        tk.Label(body, text="16 × 16 Zellen. Es erscheint in der Seitenleiste, in Übersichten und in der Suche.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10), anchor="w").pack(anchor="w")
        holder_frame = tk.Frame(body, bg=self.theme["card"])
        holder_frame.pack(fill="both", expand=True, pady=(10, 0))
        pseudo = {"id": f"page-icon-{kind}-{identity}", "drawing": state["document"], "attachments": []}

        def keep(document):
            state["document"] = document
            return True

        editor = DrawingEditor(holder_frame, self, pseudo, on_change=keep)
        editor.pack(fill="both", expand=True, padx=8, pady=8)
        editor.more_button.destroy()
        drawings = [entry for entry in self.lists if self.is_drawing_list(entry) and entry.get("id") != identity]

        def from_drawing():
            if not drawings:
                self.show_info("Pixelsymbol", "Es gibt noch keine Zeichnung zum Übernehmen.", parent=dialog)
                return
            menu = self._new_themed_popup_menu(dialog)
            for entry in drawings[:40]:
                menu.add_command(label=self.list_path_title(entry)[:80],
                                 command=lambda value=entry: adopt(value))
            try:
                menu.tk_popup(adopt_button.winfo_rootx(), adopt_button.winfo_rooty() + adopt_button.winfo_height())
            finally:
                try:
                    menu.grab_release()
                except tk.TclError:
                    pass

        def adopt(entry):
            model = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
            icon = model.downscaled(size) if model.width > size else model
            editor.model = icon
            editor.render_full()
            editor.mark_unsaved()
            editor.update_status(f"Aus „{entry.get('title', 'Zeichnung')}“ verkleinert – nach Belieben nachbessern")

        def finish(value):
            editor.flush()
            state["result"] = value
            dialog.destroy()

        footer = tk.Frame(body, bg=self.theme["bg"])
        footer.pack(fill="x", pady=(12, 0))
        adopt_button = self._make_dialog_button(footer, "Aus Zeichnung übernehmen …", from_drawing, "muted", width=230)
        adopt_button.pack(side="left")
        self._make_dialog_button(footer, "Übernehmen", lambda: finish("set"), "confirm").pack(side="right")
        self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 10))
        if holder.get("icon"):
            self._make_dialog_button(footer, "Symbol entfernen", lambda: finish("remove"), "muted",
                                     width=150).pack(side="right", padx=(0, 10))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=640, min_height=680)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        if state["result"] is None:
            return False
        icon = None if state["result"] == "remove" else self.normalize_page_icon(state["document"])
        if state["result"] == "set" and icon is not None and not any(
                bytes.fromhex("".join(icon["rows"]))):
            icon = None
        with self.sidebar_change(refresh_tree=True) as change:
            if holder.get("icon") != icon:
                holder["icon"] = icon
                change.mark()
        if state["result"] == "set" and icon is not None:
            self.feedback("icon_set")
        return True

    # --- Archiv (Format 20) ----------------------------------------------------
    def is_archived_folder(self, folder_id):
        """Liegt ein Ordner selbst oder über einen Vorfahren im Archiv?"""
        if not folder_id:
            return False
        for current in [folder_id] + self.folder_ancestor_ids(folder_id):
            folder = self.get_folder(current)
            if folder and folder.get("archived"):
                return True
        return False

    def is_archived_entry(self, entry):
        """Eine Liste ist archiviert, wenn sie selbst oder ihr Ordnerzweig es ist."""
        if not isinstance(entry, dict):
            return False
        return bool(entry.get("archived")) or self.is_archived_folder(entry.get("folder_id"))

    def planning_lists(self):
        """Listen, die in Tagesplanung, Übersichten und Erinnerungen zählen.

        Archiviertes bleibt vollständig im Bestand, zählt aber in keiner
        Planung – das ist der Unterschied zum Löschen.
        """
        return self.render_cached("planning_lists",
                                  lambda: [entry for entry in self.lists if not self.is_archived_entry(entry)])

    def archived_entries(self):
        """Archivierte Listen und Ordner, die selbst markiert sind."""
        return ([("folder", folder) for folder in self.folders if folder.get("archived")]
                + [("list", entry) for entry in self.lists if entry.get("archived")])

    def set_archived(self, kind, identity, archived=True):
        """Archiviert eine Liste oder einen Ordner oder holt sie zurück."""
        holder = self.get_folder(identity) if kind == "folder" else next(
            (entry for entry in self.lists if entry.get("id") == identity), None)
        if holder is None or (kind == "list" and self.is_inbox_list(holder)):
            return False
        if bool(holder.get("archived")) == archived:
            return False
        if archived:
            self.flush_rich_note()
            self.flush_drawing_editor()
        with self.sidebar_change(refresh_tree=True) as change:
            holder["archived"] = archived
            holder["archived_at"] = datetime.now().astimezone().isoformat(timespec="seconds") if archived else None
            change.mark()
            leaving = archived and (
                (kind == "list" and self.active_list_id == identity and self.view_mode == "list")
                or (kind == "folder" and self.view_mode == "folder"
                    and (self.active_folder_id == identity or self.is_archived_folder(self.active_folder_id))))
            if leaving:
                self._activate_system_view(self.LIBRARY_VIEW, refresh=False)
        self.feedback("archived" if archived else "unarchived")
        if archived:
            self.show_undo_toast(f"„{holder.get('title', '')}“ archiviert")
        return True

    def library_entries(self, archived=False):
        """Alle normalen Listen und Ordner in der Reihenfolge der Seitenleiste.

        Archivierte Zweige fehlen hier; mit ``archived=True`` erscheinen genau
        die archivierten Einträge.
        """
        if archived:
            return self.archived_entries()
        entries = [("list", entry) for entry in self.lists
                   if not entry.get("folder_id") and not self.is_inbox_list(entry) and not entry.get("archived")]

        def visit(parent_id):
            for folder in self.get_child_folders(parent_id):
                if folder.get("archived"):
                    continue
                entries.append(("folder", folder))
                visit(folder["id"])
                entries.extend(("list", entry) for entry in self.get_folder_lists(folder["id"])
                               if not self.is_inbox_list(entry) and not entry.get("archived"))

        visit(None)
        return entries

    def toggle_library_archive(self):
        self._library_show_archive = not getattr(self, "_library_show_archive", False)
        self.refresh_library_page()
        return "break"

    def cycle_library_card_size(self):
        order = ("small", "medium", "large")
        current = self.settings.get("library_card_size", "medium")
        self.settings["library_card_size"] = order[(order.index(current) + 1) % 3 if current in order else 1]
        self.save_settings()
        self.refresh_library_page()
        return "break"

    def library_card_preview(self, kind, entry, preview_rows):
        """Frische Anzeigedaten; nur Widgets werden zwischen Aufrufen erhalten."""
        if kind == "folder":
            nested = {folder["id"] for folder in self.iter_folder_subtree(entry["id"])}
            lists = [value for value in self.lists if value.get("folder_id") in nested]
            items = [item for value in lists for item in value.get("items", [])]
            children = [("folder", value) for value in self.get_child_folders(entry["id"])]
            children += [("list", value) for value in self.get_folder_lists(entry["id"])]
            previews = [(self.ICONS[child_kind], " ".join(str(value.get("title") or "").split()), "")
                        for child_kind, value in children[:preview_rows]]
            remaining = max(0, len(children) - len(previews))
            summary = f"{len(lists)} Listen · {len(nested) - 1} Unterordner"
        elif self.is_drawing_list(entry):
            items, previews, remaining = [], [], 0
            summary = self.drawing_summary(entry)
        else:
            items = entry.get("items", [])
            tasks = [item for item in self.walk_items(items) if self.is_schedulable_item(item)]
            pending = [item for item in tasks if not item.get("done")]
            pending.sort(key=lambda item: (item.get("due") or "9999", -item.get("importance", 0)))
            previews = []
            for item in pending[:preview_rows]:
                title_line = str(item.get("text") or "").splitlines()[0]
                due = self.format_due_display(item.get("due")) if item.get("due") else ""
                previews.append((self.ICONS["priority_high"] if item.get("importance", 0) >= 2 else self.ICONS["task_open"],
                                 title_line, due))
            remaining, summary = max(0, len(pending) - len(previews)), ""
        return previews, remaining, summary, self.compute_stats(items)

    def refresh_library_page(self):
        """Inhaltshohe Kacheln in unabhängig gestapelten, responsiven Spalten."""
        scroll_position = self.home_canvas.yview()[0] if getattr(self, "_home_rendered_view", None) == self.LIBRARY_VIEW else 0
        self._home_rendered_view = self.LIBRARY_VIEW
        theme = self.theme
        for widget in (self.home_frame, self.home_canvas, self.home_content):
            widget.configure(bg=theme["bg"])
        self.home_scrollbar.set_theme(theme["bg"], theme["bg"], theme["input_border"], theme["muted"])
        showing_archive = bool(getattr(self, "_library_show_archive", False))
        entries = self.library_entries(archived=showing_archive)
        list_count = sum(kind == "list" for kind, _entry in entries)
        archived_count = len(self.archived_entries())
        self._set_stats_text((f"Archiv · {len(entries)} Einträge" if showing_archive else
                              f"{list_count} Listen · {len(entries) - list_count} Ordner")
                             + (f" · {archived_count} im Archiv" if archived_count and not showing_archive else ""))
        card_size = self.settings.get("library_card_size", "medium")
        # Kartengröße S/M/L: Spaltenbreite und Zahl der Vorschauzeilen.
        column_width = {"small": 260, "medium": 352, "large": 480}.get(card_size, 352)
        preview_rows = {"small": 2, "medium": 3, "large": 5}.get(card_size, 3)
        thumbnail_edge = {"small": 64, "medium": 128, "large": 192}.get(card_size, 128)
        context = (tuple(sorted(theme.items())), app_font(10, "bold"), card_size, showing_archive, self.page_icon_scale(), self.design_name())
        cache = getattr(self, "_library_card_cache", None)
        if cache is not None and (cache["context"] != context or not cache["grid"].winfo_exists()):
            cache = None
        created_grid = cache is None
        if created_grid:
            for widget in self.home_content.winfo_children():
                widget.destroy()
            grid = tk.Frame(self.home_content, bg=theme["bg"])
            grid.pack(fill="x")
            column_frames = [tk.Frame(grid, bg=theme["bg"]) for _ in range(4)]
            cache = {"context": context, "grid": grid, "columns": column_frames, "cards": {},
                     "column_count": None, "empty_hint": None}
            self._library_card_cache = cache

            def release_cache(event, state=cache):
                if event.widget is state["grid"] and getattr(self, "_library_card_cache", None) is state:
                    self._library_card_cache = None
                    self._library_images = []
            grid.bind("<Destroy>", release_cache, add="+")
        else:
            grid, column_frames = cache["grid"], cache["columns"]
        old_order = list(getattr(self, "library_cards", []))
        card_gap = 12
        card_padding = 16
        self.library_cards = []
        self.library_open_buttons = {}
        self._library_images = []
        if created_grid:
            cache["button_font"] = tkfont.Font(root=self.root, font=app_font(10, "bold"))
        button_font = cache["button_font"]

        def reveal_focused_button(event):
            canvas = self.home_canvas
            target = event.widget
            top = target.winfo_rooty() - canvas.winfo_rooty()
            bottom = top + target.winfo_height()
            viewport_height = canvas.winfo_height()
            offset = top - card_padding if top < card_padding else (
                bottom - viewport_height + card_padding if bottom > viewport_height - card_padding else 0)
            if offset:
                height = max(viewport_height, self.home_content.winfo_reqheight())
                canvas.yview_moveto(max(0, canvas.canvasy(0) + offset) / max(1, height))

        keys = {(kind, entry["id"]) for kind, entry in entries}
        for key in cache["cards"].keys() - keys:
            cache["cards"].pop(key)[1].destroy()
        for kind, entry in entries:
            color = entry.get("color") or ("import" if kind == "folder" else "ui_accent")
            parent_id = entry.get("parent_id" if kind == "folder" else "folder_id")
            path = tuple(self.folder_path_titles(parent_id)) if parent_id else ()
            previews, remaining, summary, stats = self.library_card_preview(kind, entry, preview_rows)
            is_drawing = kind == "list" and self.is_drawing_list(entry)
            rich_text = " ".join(str((entry.get("rich_note") or {}).get("text") or "").split()) if entry.get("list_kind") in (
                self.LIST_KIND_NOTE, self.LIST_KIND_PAGE) else ""
            assigned = [(self.get_label(value) or {}).get("name", "") for value in entry.get("labels", [])]
            # Signatur enthält die sichtbaren Werte, keine dauerhaften Datenzähler.
            signature = json.dumps((entry.get("title"), entry.get("list_kind"), color, path, entry.get("icon"), summary, stats,
                rich_text[:40 * preview_rows], len(rich_text) > 40 * preview_rows,
                " ".join(str(entry.get("note") or "").split())[:101], assigned, previews, remaining,
                entry.get("drawing") if is_drawing else None, entry.get("cover")), sort_keys=True, ensure_ascii=False)
            key = (kind, entry["id"])
            previous = cache["cards"].get(key)
            if previous is not None and previous[0] == signature:
                _signature, surface, button, images = previous
                self.library_cards.append(surface)
                self.library_open_buttons[key] = button
                self._library_images.extend(images)
                continue
            if previous is not None:
                previous[1].destroy()
            image_start = len(self._library_images)
            surface = self.make_rounded_container(grid, radius=self.HOME_CARD_RADIUS,
                width=1, inner_pad_x=card_padding, inner_pad_y=card_padding,
                auto_height=True, register=False)
            panel = surface.inner
            self.library_cards.append(surface)

            def label(text, size=10, bold=False, foreground="muted", pady=(0, 4)):
                widget = tk.Label(panel, text=text, anchor="w", justify="left",
                    bg=theme["card"], fg=theme[foreground], font=app_font(size, "bold" if bold else "normal"))
                widget.pack(fill="x", pady=pady)
                widget.bind("<Configure>", lambda event, target=widget: target.configure(wraplength=max(80, event.width - 4)))
                return widget

            if entry.get('cover'):
                self.make_page_cover(panel, entry, height=100).pack(fill='x', pady=(glide_design.SPACING[0], glide_design.SPACING[8]))
            is_drawing = kind == "list" and self.is_drawing_list(entry)
            symbol = self.ICONS["drawing"] if is_drawing else self.ICONS[kind]
            heading = label(f"{symbol}  {entry.get('title') or ('Ordner' if kind == 'folder' else 'Liste')}",
                            11, True, color)
            icon_image = self.page_icon_image(entry)
            if icon_image is not None:
                heading.configure(text=f"  {entry.get('title') or 'Liste'}", image=icon_image, compound="left")
                self._library_images.append(icon_image)
            parent_id = entry.get("parent_id" if kind == "folder" else "folder_id")
            if parent_id:
                label(" › ".join(self.folder_path_titles(parent_id)), 9)
            command = (lambda value=entry["id"]: self.set_active_folder(value)) if kind == "folder" else (
                lambda value=entry["id"]: self.set_active_list(value))
            if is_drawing:
                try:
                    model = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
                    image = glide_drawing_image.thumbnail_photo(model, thumbnail_edge, master=panel)
                    self._library_images.append(image)
                    tk.Label(panel, image=image, **self.thumbnail_frame_options()).pack(anchor="w", pady=(glide_design.SPACING[4], glide_design.SPACING[8]))
                except (glide_drawing.DrawingFormatError, tk.TclError):
                    pass
            total, done, _overdue = stats
            if summary:
                label(summary, 9)
            if entry.get("list_kind") in (self.LIST_KIND_NOTE, self.LIST_KIND_PAGE):
                text = " ".join(str((entry.get("rich_note") or {}).get("text") or "").split())
                if text:
                    label(text[:40 * preview_rows] + ("…" if len(text) > 40 * preview_rows else ""), 9,
                          foreground="text")
            if not is_drawing:
                label(f"{total - done} offen   ·   {done} erledigt" + (f"   ·   {_overdue} überfällig" if _overdue else ""),
                      9, foreground="delete" if _overdue else "muted")
            progress = tk.Canvas(panel, height=4, bg=theme["line"], highlightthickness=0)
            progress.pack(fill="x", pady=(glide_design.SPACING[3], glide_design.SPACING[10]))
            def draw_progress(event, bar=progress, ratio=done / total if total else 0):
                bar.delete("all")
                if ratio:
                    bar.create_rectangle(0, 0, event.width * ratio, 4, fill=theme["confirm"], outline="")
            progress.bind("<Configure>", draw_progress)
            note = " ".join(str(entry.get("note") or "").split())
            if note:
                label(note[:100] + ("…" if len(note) > 100 else ""), 9)
            assigned = [(self.get_label(value) or {}).get("name", "") for value in entry.get("labels", [])]
            if assigned:
                label(" · ".join(assigned[:3]) + (f" +{len(assigned)-3}" if len(assigned) > 3 else ""),
                      8, foreground=color, pady=(glide_design.SPACING[0], glide_design.SPACING[8]))
            if not is_drawing:
                label("ENTHALTEN" if kind == "folder" else "NÄCHSTE AUFGABEN", 8, True, "muted", pady=(glide_design.SPACING[7], glide_design.SPACING[5]))
            if not previews and not is_drawing:
                label("Noch keine Inhalte." if not total else "Alle Aufgaben erledigt.", 9, foreground="text")
            for marker, text, due in previews:
                text = " ".join(text.split())
                short = text[:76] + ("…" if len(text) > 76 else "")
                preview_row = label(f"{marker}  {short}" + (f"  ·  {due}" if due else ""),
                                    9, foreground="text", pady=(glide_design.SPACING[0], glide_design.SPACING[6]))
                self.add_tooltip(preview_row, text)
            if remaining:
                label(f"+ {remaining} weitere " + ("Einträge" if kind == "folder" else "offene Aufgaben"), 8)
            button = heading
            button.configure(takefocus=True)
            button.command = command
            button.bind("<Return>", lambda event, fn=command: fn() or "break")
            button.bind("<space>", lambda event, fn=command: fn() or "break")
            button.bind("<FocusIn>", reveal_focused_button, add="+")
            def context(event, identity=entry["id"], entry_kind=kind):
                menu = self.build_folder_menu(identity) if entry_kind == "folder" else self.build_list_menu(identity)
                try:
                    menu.tk_popup(event.x_root, event.y_root)
                finally:
                    menu.grab_release()
                return "break"
            for child in (surface, panel, *panel.winfo_children()):
                child.bind("<Button-2>" if sys.platform == "darwin" else "<Button-3>", context)
            self.library_open_buttons[(kind, entry["id"])] = button
            # Die ganze Vorschau öffnet den Inhalt; der explizite Button ist
            # zusätzlich per Tab und Enter erreichbar.
            for widget in (surface, panel, *panel.winfo_children()):
                self._bind_home_wheel(widget)
                widget.configure(cursor="hand2")
                widget.bind("<Button-1>", lambda _event, open_page=command: open_page())

            cache["cards"][key] = (signature, surface, button, self._library_images[image_start:])

        def layout(_event=None, *, force=False):
            columns = max(1, min(4 if card_size == "small" else 3, (grid.winfo_width() + card_gap) // column_width))
            if columns == cache["column_count"] and not force:
                return
            cache["column_count"] = columns
            # Separate Abstandsspalten halten alle Karten gleich breit. Jeder
            # Stapel folgt seiner eigenen Inhaltshöhe, ohne gemeinsame Rasterzeilen.
            for position in range(7):
                active = position < columns * 2 - 1
                is_gap = position % 2 == 1
                grid.columnconfigure(position, weight=1 if active and not is_gap else 0,
                    minsize=card_gap if active and is_gap else 0,
                    uniform="library" if active and not is_gap else "")
            for column, frame in enumerate(column_frames):
                if column < columns:
                    frame.grid(row=0, column=column * 2, sticky="new")
                else:
                    frame.grid_remove()
            for surface in self.library_cards:
                surface.pack_forget()
            for index, surface in enumerate(self.library_cards):
                # Die zyklische Zuordnung bewahrt die Seitenleistenreihenfolge
                # und vermeidet Umsortieren bei nachträglichem Textumbruch.
                surface.pack(in_=column_frames[index % columns], fill="x",
                    pady=(glide_design.SPACING[0], card_gap if index + columns < len(self.library_cards) else glide_design.SPACING[0]))

        if created_grid:
            cache["layout"] = layout
            grid.bind("<Configure>", layout)
        else:
            layout = cache["layout"]
        layout(force=old_order != self.library_cards)
        if entries:
            if cache["empty_hint"] is not None:
                cache["empty_hint"].destroy()
                cache["empty_hint"] = None
            if not grid.winfo_manager():
                grid.pack(fill="x")
        if not entries:
            grid.pack_forget()
            empty_text = ("Das Archiv ist leer. Archivieren steht im Kontextmenü einer Liste oder eines Ordners."
                          if showing_archive else "Noch keine Listen oder Ordner. Lege unten deine erste Liste an.")
            empty_hint = cache["empty_hint"]
            if empty_hint is None:
                empty_hint = cache["empty_hint"] = tk.Label(self.home_content, text=empty_text,
                         bg=theme["bg"], fg=theme["muted"], anchor="w", justify="left", wraplength=380)
                empty_hint.pack(fill="x", pady=glide_design.SPACING[16])
                empty_hint.bind("<Configure>", lambda event: empty_hint.configure(wraplength=max(1, event.width)))
                self._bind_home_wheel(empty_hint)
        size_names = {"small": "S", "medium": "M", "large": "L"}
        self.refresh_page_actions((
            ("Neu ▾", self.show_library_new_menu, "accent", 110),
            ("Importieren ▾", self.show_library_import_menu, "import", 154),
            ("Aktive zeigen" if showing_archive else f"Archiv ({archived_count})", self.toggle_library_archive, "muted", 150),
            (f"Kartengröße: {size_names.get(card_size, 'M')}", self.cycle_library_card_size, "muted", 150),
        ))
        if created_grid:
            self._bind_home_wheel(grid)
            self._bind_home_wheel(self.home_canvas)
        self.home_content.update_idletasks()
        self._layout_home_canvas()
        self.home_canvas.yview_moveto(scroll_position)

    def show_library_new_menu(self, event=None):
        menu = self.build_menu(self.root, (("Neue Liste", self.create_new_list),
            ("Neuer Ordner", self.create_new_folder), ("Neue Notiz", self.create_new_note),
            ("Neue Seite", self.create_new_page), ("Neue Zeichnung", self.create_new_drawing),
            ("Aus Vorlage …", self.choose_creation_template)))
        self._popup_at_widget(menu, self.template_actions)
        return "break"

    def show_library_import_menu(self, event=None):
        menu = self.build_menu(self.root, (("TXT als Liste …", self.import_txt_as_new_lists),
            ("Listen/Ordner hinzufügen …", self.import_partial_backup),
            ("Markdown als Seite …", self.import_markdown_page), ("Glide-Seiten …", self.import_glide_pages)))
        self._popup_at_widget(menu, self.template_actions)
        return "break"

    def refresh_template_actions(self):
        editing = bool(getattr(self, "_templates_editing", False))
        specs = (
            ("Vorlagen speichern" if editing else "Bearbeiten", self.toggle_template_editing, "accent", 186 if editing else 128),
            ("Vorlagen exportieren …", self.export_templates_file, "export", 222),
            ("Vorlagen hinzufügen …", self.import_templates_file, "import", 222),
            ("Listen/Ordner hinzufügen …", self.import_partial_backup, "clear", 252),
        )
        self.refresh_page_actions(specs)

    def refresh_page_actions(self, specs):
        """Zwei Aktionspaare auf denselben Zwischenflächen wie in den Listen."""
        if (getattr(self, "_height_density", None) or self.height_density()) != "full":
            # Bei niedrigem Fenster weichen die Importe; beide stehen im Menü
            # „Datei“. Die ersten beiden Knöpfe bleiben immer.
            specs = tuple(specs[:2]) + tuple(spec for spec in specs[2:] if spec[1] not in (
                self.import_txt_as_new_lists, self.import_partial_backup))
        signature = (tuple(specs), tuple(sorted(self.theme.items())), app_font(10, "bold"), self.design_name())
        children = tuple(self.template_actions.winfo_children())
        if signature == getattr(self, "_page_actions_signature", None) and children == getattr(
                self, "_page_action_children", None):
            return
        self._page_actions_signature = signature
        for widget in children:
            widget.destroy()
        self.template_actions.configure(bg=self.theme["bg"])
        self.template_action_groups = []
        for pair in (specs[:2], specs[2:]):
            if not pair:
                # Ohne Knöpfe keine Fläche: Bis 30.09.2026 stand bei nur zwei
                # Aktionen rechts eine leere, gerahmte Leiste.
                continue
            required = sum(spec[3] for spec in pair) + 5
            group = self.make_rounded_container(
                self.template_actions, radius=16, padding=7, width=required + 14,
                auto_height=True, register=False,
            )
            buttons = [self._make_dialog_button(group.inner, text, command, color, width=width, height=38)
                       for text, command, color, width in pair]

            def layout_pair(width, panel=group.inner, pair_buttons=buttons, needed=required):
                # So viele Spalten, wie nebeneinander passen. Vorher stand bei
                # zu wenig Breite jeder Knopf in einer eigenen Zeile – unter
                # „Listen und Ordner“ fünf Zeilen, über denen bei Mindestgröße
                # nur noch eine Kachel Platz fand.
                breitester = max((int(button.cget("width")) for button in pair_buttons), default=1)
                spalten = len(pair_buttons) if width >= needed else max(1, min(
                    len(pair_buttons), (max(1, width) + 5) // (breitester + 5)))
                for spalte in range(len(pair_buttons)):
                    panel.columnconfigure(spalte, weight=1 if spalte < spalten else 0,
                                          uniform="page_action" if spalte < spalten and spalten < len(pair_buttons) else "")
                if not pair_buttons:
                    return
                spalten = max(1, spalten)
                zeilen = (len(pair_buttons) + spalten - 1) // spalten
                for index, button in enumerate(pair_buttons):
                    zeile, spalte = divmod(index, spalten)
                    letzte_spalte = spalte == spalten - 1 or index == len(pair_buttons) - 1
                    button.grid(row=zeile, column=spalte, sticky="ew",
                                padx=(0, 0 if letzte_spalte else 5),
                                pady=(0, 6 if zeile < zeilen - 1 else 0))

            group.inner.bind("<Configure>", lambda event, arrange=layout_pair, panel=group.inner: arrange(panel.winfo_width()), add="+")
            layout_pair(required)
            self.template_action_groups.append(group)

        required_width = sum(int(group.cget("width")) for group in self.template_action_groups) + 12

        def layout_groups(width):
            stacked = width < required_width
            self.template_actions.columnconfigure(0, weight=1)
            self.template_actions.columnconfigure(1, weight=0 if stacked else 1)
            for index, group in enumerate(self.template_action_groups):
                group.grid(row=index if stacked else 0, column=0 if stacked else index,
                           sticky="ew", padx=(0, 12) if not stacked and index == 0 else 0,
                           pady=(0, 8) if stacked and index == 0 else 0)

        previous_binding = getattr(self.template_actions, "_page_action_layout_binding", None)
        if previous_binding:
            self.template_actions.unbind("<Configure>", previous_binding)
        self.template_actions._page_action_layout_binding = self.template_actions.bind(
            "<Configure>", lambda event: layout_groups(self.template_actions.winfo_width()))
        layout_groups(self.template_actions.winfo_width())
        self._page_action_children = tuple(self.template_actions.winfo_children())

    def add_tooltip(self, widget, text):
        """Erklärt kompakte Textsymbole auch beim Tastaturfokus.

        Seit dem 27.09.2026 gilt:
        - Je Element gibt es genau eine Anmeldung. Ein zweiter Aufruf tauscht
          nur den Text. Vorher hängte jeder Aufruf weitere Bindungen an;
          Knöpfe, die ihren Hinweis bei jeder Aktualisierung neu setzen
          („Anzeige“, Glocke), öffneten dann mehrere Hinweise übereinander –
          sichtbar am gestapelten Schatten.
        - Im ganzen Programm ist höchstens ein Hinweis sichtbar; jeder Klick
          schließt ihn.
        - Das Fenster steht an seiner Stelle, bevor es erscheint. Vorher
          erschien es oben links und wanderte dann sichtbar diagonal zu
          seinem Platz.
        """
        state = getattr(widget, "_glide_tooltip", None)
        if state is not None:
            state["source"] = text
            return
        state = {"after": None, "window": None, "text": "", "source": text}
        try:
            widget._glide_tooltip = state
        except (AttributeError, TypeError):
            pass
        self._install_tooltip_guard()

        def quelle():
            wert = state["source"]
            return wert() if callable(wert) else wert

        def hide(_event=None):
            if state["after"] is not None:
                try:
                    widget.after_cancel(state["after"])
                except tk.TclError:
                    pass
                state["after"] = None
            if state["window"] is not None:
                try:
                    state["window"].destroy()
                except tk.TclError:
                    pass
                state["window"] = None
            if getattr(self, "_active_tooltip_hide", None) is hide:
                self._active_tooltip_hide = None

        def show():
            state["after"] = None
            try:
                if not widget.winfo_exists() or not widget.winfo_ismapped():
                    return
            except tk.TclError:
                return
            value = quelle()
            if not value:
                return
            vorher = getattr(self, "_active_tooltip_hide", None)
            if vorher is not None and vorher is not hide:
                vorher()
            state["text"] = value
            tip = tk.Toplevel(widget)
            tip.withdraw()
            tip.overrideredirect(True)
            state["window"] = tip
            self._active_tooltip_hide = hide
            tk.Label(tip, text=value, bg=self.theme["card"], fg=self.theme["text"],
                     relief="solid", bd=1, padx=8, pady=5, font=app_font(9)).pack()
            tip.update_idletasks()
            folgt = callable(state["source"])
            x = widget.winfo_pointerx() + 14 if folgt else widget.winfo_rootx()
            y = widget.winfo_pointery() + 18 if folgt else widget.winfo_rooty() + widget.winfo_height() + 3
            x = min(x, widget.winfo_screenwidth() - tip.winfo_reqwidth() - 8)
            y = min(y, widget.winfo_screenheight() - tip.winfo_reqheight() - 8)
            tip.geometry(f"+{max(0, x)}+{max(0, y)}")
            tip.deiconify()

        def schedule(_event=None):
            hide()
            state["after"] = widget.after(500, show)

        for event in ("<Enter>", "<FocusIn>"):
            widget.bind(event, schedule, add="+")
        widget.bind("<Motion>", lambda _event: schedule()
                    if callable(state["source"]) and quelle() != state["text"] else None, add="+")
        for event in ("<Leave>", "<FocusOut>", "<ButtonPress>", "<Destroy>", "<Unmap>"):
            widget.bind(event, hide, add="+")

    def _install_tooltip_guard(self):
        """Einmal: Jeder Klick und jede Taste irgendwo im Programm schließt den Hinweis."""
        if getattr(self, "_tooltip_guard", False) or not hasattr(self, "root"):
            return
        self._tooltip_guard = True

        def schliessen(_event=None):
            hide = getattr(self, "_active_tooltip_hide", None)
            if hide is not None:
                hide()

        for sequence in ("<ButtonPress>", "<KeyPress>", "<MouseWheel>"):
            self.root.bind_all(sequence, schliessen, add="+")

    def toggle_template_editing(self):
        if getattr(self, "_templates_editing", False):
            if not self.save_templates():
                self.show_error("Vorlagen speichern", "Die Vorlagen konnten nicht gespeichert werden.")
                return
            self._templates_editing = False
        else:
            self._templates_before_edit = copy.deepcopy(self.templates)
            self._templates_editing = True
        self.refresh_tree()

    def edit_template(self, template_id):
        if not getattr(self, "_templates_editing", False):
            return
        template = self.template_by_id(template_id)
        if not template:
            return
        try:
            with TemplateDraft(self, template) as draft:
                updated = draft.edit()
            if updated is not None:
                index = self.templates.index(template)
                self.templates[index] = updated
                self.refresh_tree()
        except (OSError, ValueError, TypeError, KeyError) as exc:
            self.show_error("Vorlage bearbeiten", str(exc))

    def delete_template(self, template_id):
        if not getattr(self, "_templates_editing", False):
            return
        if self.ask_yes_no("Vorlage löschen", "Diese Vorlage wirklich löschen?"):
            self.templates = [item for item in self.templates if item["id"] != template_id]
            self.refresh_tree()

    def capture_template(self, list_id=None, folder_id=None):
        self.flush_rich_note()
        holder = self.get_folder(folder_id) if folder_id else next(
            (entry for entry in self.lists if entry["id"] == list_id), None)
        if holder is None:
            return None
        payload = self.partial_backup_payload([list_id] if list_id else [], [folder_id] if folder_id else [])
        files = {}
        for storage, path in self.collect_attachment_sources(payload["lists"], folders=payload.get("folders")).items():
            with open(path, "rb") as file:
                raw = file.read(self.MAX_BACKUP_ATTACHMENT_BYTES + 1)
            if len(raw) > self.MAX_BACKUP_ATTACHMENT_BYTES:
                raise ValueError("Ein Anhang ist für die Vorlage zu groß.")
            files[storage] = base64.b64encode(raw).decode("ascii")
        template = {"id": uuid.uuid4().hex, "kind": "folder" if folder_id else "list",
                    "title": holder.get("title") or "Vorlage", "note": holder.get("note") or "",
                    "color": holder.get("color"), "labels": list(holder.get("labels", [])),
                    "items": [], "payload": payload, "files": files,
                    # Seitenvorlagen stehen im „+“ neben „Seiten“ (27.09.2026).
                    "list_kind": holder.get("list_kind") if not folder_id else None}
        self.templates.append(template)
        if not getattr(self, "_templates_editing", False) and not self.save_templates():
            self.templates.remove(template)
            raise OSError("Die Vorlage konnte nicht gespeichert werden.")
        return template

    def template_from_current_list(self):
        return self.capture_template(list_id=self.active_list_id)

    def save_list_as_template(self, list_id=None):
        try:
            template = self.capture_template(list_id=list_id or self.active_list_id)
            if template:
                self.show_info("Vorlage gespeichert", f"„{template['title']}“ steht jetzt unter Vorlagen bereit.")
            return template
        except (OSError, ValueError) as exc:
            self.show_error("Vorlage", str(exc))

    def save_folder_as_template(self, folder_id):
        try:
            template = self.capture_template(folder_id=folder_id)
            if template:
                self.show_info("Vorlage gespeichert", f"„{template['title']}“ steht jetzt unter Vorlagen bereit.")
            return template
        except (OSError, ValueError) as exc:
            self.show_error("Vorlage", str(exc))

    def export_templates_file(self):
        path = filedialog.asksaveasfilename(title="Vorlagen exportieren", defaultextension=".glidetemplates",
                                            initialfile="glide_vorlagen.glidetemplates",
                                            filetypes=[("Glide-Vorlagen", "*.glidetemplates"), ("Alle Dateien", "*.*")])
        if not path:
            return
        payload = {"format_version": self.TEMPLATE_FORMAT_VERSION, "templates": self.templates}
        try:
            self.write_json_atomic(path, payload)
            self.record_data_operation("exported", path)
            self.show_info("Vorlagen exportiert", f"{len(self.templates)} Vorlage(n) gespeichert.")
        except OSError as exc:
            self.show_error("Vorlagenexport", str(exc))

    def validate_template_payload(self, template):
        referenced = self.validate_backup_schema(template["payload"], portable=True)
        files = template.get("files", {})
        if not isinstance(files, dict):
            raise ValueError("Die Anhänge der Vorlage sind ungültig.")
        total = 0
        for storage in referenced:
            encoded = files.get(storage)
            if not isinstance(encoded, str) or len(encoded) > (self.MAX_BACKUP_ATTACHMENT_BYTES + 2) // 3 * 4:
                raise ValueError("Ein Vorlagenanhang fehlt oder ist zu groß.")
            try:
                raw = base64.b64decode(encoded, validate=True)
            except (ValueError, UnicodeEncodeError) as exc:
                raise ValueError("Ein Vorlagenanhang ist beschädigt.") from exc
            total += len(raw)
            if len(raw) > self.MAX_BACKUP_ATTACHMENT_BYTES or total > self.MAX_BACKUP_TOTAL_BYTES:
                raise ValueError("Die Vorlagenanhänge überschreiten die zulässige Größe.")
        return referenced

    def import_templates_file(self):
        path = filedialog.askopenfilename(title="Vorlagen hinzufügen", filetypes=[("Glide-Vorlagen", "*.glidetemplates"), ("JSON", "*.json"), ("Alle Dateien", "*.*")])
        if not path:
            return
        try:
            if os.path.getsize(path) > self.MAX_BACKUP_TOTAL_BYTES * 2:
                raise ValueError("Die Vorlagendatei ist zu groß.")
            with open(path, "r", encoding="utf-8-sig") as file:
                incoming = self.normalize_template_records(json.load(file))
            for record in incoming:
                if "payload" in record:
                    self.validate_template_payload(record)
            existing = {item.get("id") for item in self.templates}
            for item in incoming:
                if item["id"] in existing:
                    item["id"] = uuid.uuid4().hex
                self.templates.append(item)
                existing.add(item["id"])
            if not getattr(self, "_templates_editing", False) and not self.save_templates():
                self.templates = self.templates[:-len(incoming)] if incoming else self.templates
                raise OSError("Die Vorlagen konnten nicht gespeichert werden.")
            self.update_sidebar_list()
            self.refresh_tree()
            self.show_info("Vorlagen hinzugefügt", f"{len(incoming)} Vorlage(n) ergänzt.")
            self.record_data_operation("imported", path)
        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
            self.show_error("Vorlagenimport", str(exc))

    # -----------------------------
    # Vorlagen mit Eingabefeldern (3.30)
    # -----------------------------
    # Ein Platzhalter wie {{Projektname}} steht als Text in der Vorlage. Beim
    # Verwenden fragt Glide jeden Namen einmal ab und setzt die Angabe überall
    # ein – in Titel, Beschreibung, Punkte, Checklisten und Notiztext. Das
    # Vorlagenformat ändert sich dafür nicht; eine Vorlage ohne Platzhalter
    # verhält sich wie bisher.
    TEMPLATE_FIELD_PATTERN = re.compile(r"\{\{\s*([^{}\n]{1,40}?)\s*\}\}")
    MAX_TEMPLATE_FIELDS = 12
    TEMPLATE_DATE_FIELDS = ("datum", "heute", "tag")

    @classmethod
    def template_field_name(cls, raw):
        return " ".join(str(raw).split())

    @classmethod
    def template_fields(cls, value, found=None):
        """Die Platzhalter einer Vorlage in der Reihenfolge ihres ersten Auftretens."""
        found = [] if found is None else found
        if isinstance(value, str):
            for match in cls.TEMPLATE_FIELD_PATTERN.finditer(value):
                name = cls.template_field_name(match.group(1))
                if name and name not in found:
                    found.append(name)
        elif isinstance(value, dict):
            for key, inner in value.items():
                if key in ("files", "id"):
                    continue
                cls.template_fields(inner, found)
        elif isinstance(value, list):
            for inner in value:
                cls.template_fields(inner, found)
        return found[:cls.MAX_TEMPLATE_FIELDS]

    @classmethod
    def fill_template_text(cls, text, values):
        return cls.TEMPLATE_FIELD_PATTERN.sub(
            lambda match: values.get(cls.template_field_name(match.group(1)), match.group(0)), text)

    @classmethod
    def fill_template_rich_note(cls, document, values):
        """Ersetzt Platzhalter im Notiztext und verschiebt die Formatierungen mit."""
        if not isinstance(document, dict) or not isinstance(document.get("text"), str):
            return document
        text = document["text"]
        stuecke, punkte, alt, neu = [], [], 0, 0
        for match in cls.TEMPLATE_FIELD_PATTERN.finditer(text):
            name = cls.template_field_name(match.group(1))
            if name not in values:
                continue
            stuecke.append(text[alt:match.start()])
            neu += match.start() - alt
            ersatz = values[name]
            punkte.append((match.start(), match.end(), neu, neu + len(ersatz)))
            stuecke.append(ersatz)
            neu += len(ersatz)
            alt = match.end()
        if not punkte:
            return document
        stuecke.append(text[alt:])

        def abbilden(offset, ende):
            verschiebung = 0
            for alt_anfang, alt_ende, neu_anfang, neu_ende in punkte:
                if offset <= alt_anfang:
                    break
                if offset < alt_ende:
                    return neu_ende if ende else neu_anfang
                verschiebung = neu_ende - alt_ende
            return offset + verschiebung

        ergebnis = dict(document)
        ergebnis["text"] = "".join(stuecke)
        spans = []
        for span in document.get("spans", []) or []:
            if not isinstance(span, dict):
                continue
            anfang, ende = abbilden(span.get("start", 0), False), abbilden(span.get("end", 0), True)
            if anfang < ende:
                spans.append({**span, "start": anfang, "end": ende})
        ergebnis["spans"] = spans
        return ergebnis

    @classmethod
    def fill_template_value(cls, value, values):
        if isinstance(value, str):
            return cls.fill_template_text(value, values)
        if isinstance(value, list):
            return [cls.fill_template_value(inner, values) for inner in value]
        if isinstance(value, dict):
            ergebnis = {}
            for key, inner in value.items():
                if key in ("files", "id"):
                    ergebnis[key] = inner
                elif key == "rich_note":
                    ergebnis[key] = cls.fill_template_rich_note(inner, values)
                else:
                    ergebnis[key] = cls.fill_template_value(inner, values)
            return ergebnis
        return value

    # Platzhalter, die sich selbst füllen (G11, 30.09.2026): Datum und Zeit
    # beim Anlegen. Sie werden nicht abgefragt; ein Dialog erscheint nur noch
    # für echte Angaben wie {{Projektname}}.
    WOCHENTAGE = ("Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag")
    MONATE = ("Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September",
              "Oktober", "November", "Dezember")

    def template_auto_value(self, name, jetzt=None):
        """Wert eines selbstfüllenden Platzhalters oder None, wenn der Name keiner ist."""
        jetzt = jetzt or datetime.now()
        heute = jetzt.date()
        schluessel = self.search_key(name)
        if schluessel in self.TEMPLATE_DATE_FIELDS:
            return heute.strftime("%d.%m.%Y")
        werte = {
            "wochentag": self.WOCHENTAGE[heute.weekday()],
            "kw": str(heute.isocalendar()[1]),
            "kalenderwoche": str(heute.isocalendar()[1]),
            "monat": self.MONATE[heute.month - 1],
            "jahr": str(heute.year),
            "uhrzeit": jetzt.strftime("%H:%M"),
            "morgen": (heute + timedelta(days=1)).strftime("%d.%m.%Y"),
            "gestern": (heute - timedelta(days=1)).strftime("%d.%m.%Y"),
        }
        return werte.get(schluessel)

    def template_field_default(self, name):
        if self.search_key(name) in self.TEMPLATE_DATE_FIELDS:
            return date.today().strftime("%d.%m.%Y")
        if self.search_key(name) == "jahr":
            return str(date.today().year)
        return ""

    def ask_template_fields(self, fields, title=""):
        """Ein Dialog für alle Platzhalter. Rückgabe: {Name: Text} oder None bei Abbruch."""
        dialog = tk.Toplevel(self.root)
        dialog.title("Vorlage ausfüllen")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.resizable(False, False)
        body = tk.Frame(dialog, bg=self.theme["bg"])
        body.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(body, text=f"„{title}“ ausfüllen" if title else "Vorlage ausfüllen", bg=self.theme["bg"],
                 fg=self.theme["text"], font=app_font(15, "bold"), anchor="w").pack(fill="x")
        tk.Label(body, text="Die Angaben ersetzen die Platzhalter in Titeln, Punkten, Beschreibungen und "
                            "Notizen. Leere Felder bleiben leer.", bg=self.theme["bg"], fg=self.theme["muted"],
                 font=app_font(10), wraplength=440, justify="left", anchor="w").pack(fill="x", pady=(4, 12))
        eingaben = {}
        for name in fields:
            tk.Label(body, text=name, bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(10),
                     anchor="w").pack(fill="x", pady=(6, 2))
            feld = tk.Entry(body, font=app_font(11), bg=self.theme["input"], fg=self.theme["text"],
                            insertbackground=self.theme["text"], relief="flat", highlightthickness=1,
                            highlightbackground=self.theme["input_border"], highlightcolor=self.theme["selection"])
            feld.insert(0, self.template_field_default(name))
            feld.pack(fill="x")
            eingaben[name] = feld
        ergebnis = {}

        def uebernehmen(_event=None):
            ergebnis["values"] = {name: " ".join(feld.get().split()) for name, feld in eingaben.items()}
            dialog.destroy()
            return "break"

        leiste = tk.Frame(body, bg=self.theme["bg"])
        leiste.pack(fill="x", pady=(16, 0))
        self._make_dialog_button(leiste, "Übernehmen", uebernehmen, "confirm").pack(side="right")
        self._make_dialog_button(leiste, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        dialog.bind("<Return>", uebernehmen)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=480)
        self._schedule_windows_chrome_theme(dialog)
        if eingaben:
            next(iter(eingaben.values())).focus_set()
        self.run_modal(dialog)
        return ergebnis.get("values")

    def _create_list_from_template(self, template_key, template, reference_date, folder_id=None):
        if template_key == "journal-note":
            today = reference_date
            title = f"Tagesnotiz · {today:%d.%m.%Y}"
            existing = {entry.get("title") for entry in self.lists}
            candidate, number = title, 2
            while candidate in existing:
                candidate = f"{title} ({number})"
                number += 1
            entry = self.new_list_object(
                candidate, [], folder_id=folder_id, color=(template or {}).get("color"),
                note=(template or {}).get("note", ""), list_kind="note",
                rich_note=self.journal_note_document(),
                journal={"moment_date": today.isoformat()},
            )
            with self.sidebar_change(refresh_tree=True) as change:
                self.lists.append(entry)
                self.set_active_list(entry["id"], refresh=False)
                change.mark()
            self.save_settings()
            return entry if change.saved else None

        if template_key == "journal-folder":
            today = reference_date
            base_title = f"Notizbuch {today.year}"
            existing = {folder.get("title") for folder in self.folders}
            title, number = base_title, 2
            while title in existing:
                title = f"{base_title} ({number})"
                number += 1
            root = self.new_folder_object(title, parent_id=folder_id, color=(template or {}).get("color"),
                                          note=(template or {}).get("note", ""),
                                          folder_kind="journal")
            quarter = (today.month - 1) // 3 + 1
            with self.sidebar_change(refresh_tree=True) as change:
                self.folders.append(root)
                quarter_folders = []
                for q in range(1, 5):
                    folder = self.new_folder_object(f"Q{q}", color=(template or {}).get("color"),
                                                    parent_id=root["id"], folder_kind="journal")
                    self.folders.append(folder)
                    quarter_folders.append(folder)
                entry = self.new_list_object(
                    f"Tagesnotiz · {today:%d.%m.%Y}", [],
                    folder_id=quarter_folders[quarter - 1]["id"],
                    color=(template or {}).get("color"), list_kind="note",
                    rich_note=self.journal_note_document(),
                    journal={"moment_date": today.isoformat()},
                )
                self.sidebar_folder_open_states[root["id"]] = True
                self.sidebar_folder_open_states[quarter_folders[quarter - 1]["id"]] = True
                self.set_active_list(entry["id"], refresh=False)
                self.lists.append(entry)
                change.mark()
            self.save_settings()
            return root if change.saved else None

        if template and "payload" in template:
            try:
                referenced = self.validate_template_payload(template)
                payload = copy.deepcopy(template["payload"])
                roots = payload["folders"] if template["kind"] == "folder" else payload["lists"]
                roots = [root for root in roots if not root.get("parent_id")] if template["kind"] == "folder" else roots
                if roots:
                    roots[0].update({key: copy.deepcopy(template.get(key)) for key in ("title", "note", "color", "labels")})
                anchor = self.normalize_due(template.get("schedule_anchor"))
                offset = (reference_date - date.fromisoformat(anchor)).days if anchor else 0
                for entry in payload["lists"]:
                    for item in self.walk_items(entry.get("items", [])):
                        item["done"] = False
                        if offset and item.get("planned_date"):
                            item["planned_date"] = (date.fromisoformat(item["planned_date"]) + timedelta(days=offset)).isoformat()
                        if offset and item.get("due"):
                            item["due"] = (date.fromisoformat(item["due"]) + timedelta(days=offset)).isoformat()
                            rule = item.get("repeat")
                            if rule:
                                for key in ("start", "ende"):
                                    if rule.get(key):
                                        rule[key] = (date.fromisoformat(rule[key]) + timedelta(days=offset)).isoformat()
                previous = {entry["id"] for entry in (self.folders if template["kind"] == "folder" else self.lists)}
                with tempfile.TemporaryDirectory(prefix="glide-template-") as temporary:
                    path = os.path.join(temporary, "vorlage.glidebackup")
                    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as archive:
                        archive.writestr("data.json", json.dumps(payload, ensure_ascii=False))
                        for storage in referenced:
                            archive.writestr(storage, base64.b64decode(template["files"][storage], validate=True))
                    if not self.import_full_backup(additive=True, path=path, show_success=False, target_folder_id=folder_id):
                        return None
                records = self.folders if template["kind"] == "folder" else self.lists
                created = [entry for entry in records if entry["id"] not in previous]
                if template["kind"] == "folder":
                    created = [entry for entry in created if entry.get("parent_id") == folder_id]
                    if created:
                        self.set_active_folder(created[0]["id"])
                return created[0] if created else None
            except (OSError, ValueError, TypeError, KeyError) as exc:
                self.show_error("Vorlage verwenden", str(exc))
                return None
        if template is not None:
            title = template.get("title") or "Neue Liste"
            note = template.get("note") or ""
            task_texts = template.get("items", [])
            template_color = template.get("color")
            template_labels = template.get("labels", [])
            kind = template.get("kind", "list")
            template_list_kind = template.get("list_kind", "tasks")
        else:
            template = self.LIST_TEMPLATES.get(template_key)
            if template is None:
                return None
            title, note, task_texts = template
            template_color = None
            template_labels = []
            kind = "list"
            template_list_kind = "tasks"
        if kind == "folder":
            folder = self.new_folder_object(title, parent_id=folder_id, color=template_color, note=note, labels=template_labels)
            with self.sidebar_change(refresh_tree=True) as change:
                self.folders.append(folder)
                for text in task_texts or ["Neue Liste"]:
                    entry = self.new_list_object(str(text), [], folder_id=folder["id"], color=template_color, note=note)
                    self.lists.append(entry)
                self.set_active_folder(folder["id"], refresh=False)
                change.mark()
            return folder if change.saved else None
        existing_titles = {entry.get("title") for entry in self.lists}
        candidate, number = title, 2
        while candidate in existing_titles:
            candidate = f"{title} ({number})"
            number += 1
        tasks = [self.new_item(text, due=reference_date.isoformat() if template_key == "daily" else None)
                 for text in task_texts]
        entry = self.new_list_object(candidate, tasks, folder_id=folder_id, note=note, color=template_color, labels=template_labels,
                                     list_kind=template_list_kind,
                                     rich_note=self.journal_note_document(template_key)
                                     if template_list_kind == "note" else None,
                                     journal={"moment_date": reference_date.isoformat()}
                                     if template_list_kind == "note" else None)
        with self.sidebar_change(refresh_tree=True) as change:
            self.lists.append(entry)
            self.set_active_list(entry["id"], refresh=False)
            change.mark()
        self.save_settings()
        return entry if change.saved else None

