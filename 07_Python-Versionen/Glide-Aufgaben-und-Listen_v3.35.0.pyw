    PAGE_RECENT_LIMIT = 12

    @classmethod
    def is_page_list(cls, entry):
        return isinstance(entry, dict) and entry.get("list_kind") == cls.LIST_KIND_PAGE

    def change_page_feature(self, page_id, field, value, attachments=()):
        if field not in ('live_lists', 'cover'):
            raise ValueError('Unbekannter Seiteninhalt.')
        self.refresh_data_lock()
        if getattr(self, '_data_read_only', False):
            return False
        if self.flush_rich_note() is False:
            return False
        entry = self.page_entry(page_id)
        if not entry or entry.get('list_kind') != self.LIST_KIND_PAGE or self.is_archived_entry(entry):
            return False
        value = glide_pages.live_lists(value) if field == 'live_lists' else glide_pages.cover(value)
        if entry.get(field) == value:
            return True
        before = copy.deepcopy(self.lists); undo_depth = len(self.undo_stack)
        with self.sidebar_change(refresh_tree=True, feedback=False) as change:
            if value is None or value == []:
                entry.pop(field, None)
            else:
                entry[field] = value
            entry.setdefault('attachments', []).extend(attachments)
            entry['updated_at'] = datetime.now().astimezone().isoformat(timespec='seconds')
            change.mark()
        if change.saved is False:
            self.lists = before; del self.undo_stack[undo_depth:]
            self.sync_current_list_reference(); self.refresh_tree(); self.update_sidebar_list()
            return False
        return True

    def choose_live_list(self, page_id, target=None):
        entry = self.page_entry(page_id)
        if not entry or entry.get('list_kind') != self.LIST_KIND_PAGE or self.is_archived_entry(entry) or getattr(self, '_data_read_only', False):
            return False
        if target is None:
            choices = [(glide_objects.uri('list', item['id']), str(item.get('title') or 'Liste'))
                       for item in self.lists if item.get('list_kind') == self.LIST_KIND_TASKS and not self.is_archived_entry(item)]
            target = self.themed_choice_dialog('Live-Liste einbetten',
                'Die Seite zeigt die Originalaufgaben. Abhaken wirkt auch in der Quellliste.', choices)
        if target is None:
            return False
        state, _, _ = glide_pages.live_rows(target, self.lists, self.trash, self.folders)
        if glide_objects.parse(target) is None or glide_objects.parse(target)[0] != 'list' or state != 'active':
            return False
        entry = self.page_entry(page_id)
        values = entry.get('live_lists', []) if entry else []
        if target in values:
            return True
        if len(values) >= 20:
            self.show_info('Live-Liste', 'Eine Seite darf höchstens 20 Live-Listen enthalten.'); return False
        return self.change_page_feature(page_id, 'live_lists', values + [target])

    def remove_live_list(self, page_id, target):
        entry = self.page_entry(page_id)
        if not entry or target not in entry.get('live_lists', []):
            return False
        return self.change_page_feature(page_id, 'live_lists', [v for v in entry['live_lists'] if v != target])

    def toggle_live_task(self, page_id, target, item_id):
        entry = self.page_entry(page_id)
        self.refresh_data_lock()
        if not entry or self.is_archived_entry(entry) or target not in entry.get('live_lists', []) or getattr(self, '_data_read_only', False):
            return False
        state, _, rows = glide_pages.live_rows(target, self.lists, self.trash, self.folders)
        if state != 'active' or item_id not in {row[0] for row in rows}:
            return False
        self.flush_rich_note()
        before = copy.deepcopy((self.lists, self.trash, self.settings)); depth = len(self.undo_stack)
        if self.toggle_item_done_anywhere(item_id):
            return True
        self.lists, self.trash, self.settings = before; del self.undo_stack[depth:]
        self.save_settings()
        self.sync_current_list_reference(); self.refresh_tree(); self.update_sidebar_list()
        return False

    def page_cover_menu(self, page_id, parent):
        menu = self._new_themed_popup_menu(parent)
        menu.add_command(label='Bilddatei auswählen …', command=lambda: self.choose_page_cover(page_id))
        menu.add_command(label='Pixelzeichnung übernehmen …', command=lambda: self.choose_page_cover(page_id, drawing=True))
        menu.add_command(label='Titelbild entfernen', command=lambda: self.change_page_feature(page_id, 'cover', None),
                         state='normal' if (self.page_entry(page_id) or {}).get('cover') else 'disabled')
        return menu

    def choose_page_cover(self, page_id, path=None, drawing=False, drawing_id=None):
        self.refresh_data_lock()
        entry = self.page_entry(page_id)
        if not entry or entry.get('list_kind') != self.LIST_KIND_PAGE or self.is_archived_entry(entry) or getattr(self, '_data_read_only', False):
            return False
        if drawing:
            choices = [(value['id'], str(value.get('title') or 'Zeichnung')) for value in self.lists
                       if self.is_drawing_list(value) and not value.get('archived')]
            identity = drawing_id or self.themed_choice_dialog('Pixelzeichnung als Titelbild',
                'Die Zeichnung wird als eigenes Titelbild übernommen.', choices)
            source = next((value for value in self.lists if value['id'] == identity and self.is_drawing_list(value)
                           and not value.get('archived')), None)
            return bool(source) and self.change_page_feature(page_id, 'cover',
                {'kind': 'drawing', 'document': copy.deepcopy(source['drawing'])})
        if path is None:
            path = filedialog.askopenfilename(parent=self.root, title='Titelbild auswählen',
                                             filetypes=[('Bilder', glide_image_preview.FILE_PATTERN)])
        if not path or not glide_image_preview.is_image_name(path) or not os.path.isfile(path):
            return False
        try:
            attachment = self.store_attachment(path)
        except OSError as exc:
            self.show_error('Titelbild', str(exc)); return False
        ok = self.change_page_feature(page_id, 'cover', {'kind': 'image', 'attachment': attachment['id']}, [attachment])
        if not ok:
            stored = self.resolve_attachment_path(attachment)
            if stored and os.path.isfile(stored):
                os.remove(stored)
        return ok

    def make_page_cover(self, host, entry, height=110, image_path=None):
        canvas = tk.Canvas(host, height=height, bg=self.theme['input'], highlightthickness=0)
        value = copy.deepcopy(entry.get('cover'))
        def render(event=None):
            if not canvas.winfo_exists():
                return
            width = max(80, canvas.winfo_width()); canvas.delete('all'); image = None
            try:
                if value and value.get('kind') == 'drawing':
                    model = glide_drawing.DrawingModel.from_document(value['document'])
                    image = glide_drawing_image.thumbnail_photo(model, height, master=canvas)
                elif value and value.get('kind') == 'image':
                    attachment = next((a for a in entry.get('attachments', []) if a['id'] == value['attachment']), None)
                    path = image_path or (self.resolve_attachment_path(attachment) if attachment else None)
                    if path and self.previews.needs_conversion(canvas, path):
                        self.request_cover_conversion(path)
                    if path: image = self.previews.image(canvas, path, width=width)
            except (ValueError, tk.TclError):
                image = None
            canvas._photo = image
            if image is not None:
                canvas.create_image(width//2, height//2, anchor='center', image=image)
            else:
                canvas.create_text(width//2, height//2, text='Titelbild · Keine Vorschau', width=width-12,
                                   fill=self.theme['muted'], font=app_font(10))
        canvas.bind('<Configure>', render)
        return canvas

    def request_cover_conversion(self, path):
        """Bildumwandlung im Hintergrund; Tk ausschließlich im Hauptthread."""
        pending = getattr(self, '_cover_conversions', None)
        if pending is None: pending = self._cover_conversions = set()
        if path in pending: return
        pending.add(path)
        completed = threading.Event()
        def worker():
            try: self.previews.convert(path)
            finally: completed.set()
        threading.Thread(target=worker, daemon=True).start()
        timer = [None]
        def poll():
            self._after_ids.discard(timer[0])
            if not completed.is_set():
                timer[0] = self.root.after(100, poll); self._after_ids.add(timer[0]); return
            # Failed conversion is attempted once per path/session.
            editor = getattr(self, 'rich_note_editor', None)
            if isinstance(editor, PageEditor):
                editor._features_signature = None; editor.refresh_page_features()
            self._library_card_cache = None
            if self.view_mode == self.LIBRARY_VIEW: self.refresh_library_page()
        timer[0] = self.root.after(100, poll); self._after_ids.add(timer[0])

    def choose_creation_template(self, folder_id=None, section=None):
        choices = [(t['id'], str(t.get('title') or 'Vorlage')) for t in self.templates
                   if section is None or self.sidebar_template_allowed(t, section, folder_id)]
        identity = self.themed_choice_dialog('Aus Vorlage anlegen', 'Vorlage auswählen; danach ausfüllen und prüfen.', choices)
        if identity is None: return None
        return self.create_template_in_section(identity, folder_id, section) if section else self.create_list_from_template(identity)

    def confirm_template_preview(self, template):
        dialog = tk.Toplevel(self.root); dialog.title('Vorlage prüfen und anlegen'); dialog.transient(self.root)
        body = tk.Frame(dialog, bg=self.theme['bg']); body.pack(fill='both', expand=True, padx=20, pady=16)
        tk.Label(body, text='Gefüllte Vorschau', bg=self.theme['bg'], fg=self.theme['text'],
                 font=app_font(15, 'bold'), anchor='w').pack(fill='x')
        tk.Label(body, text='Mit „Anlegen“ entsteht ein neuer Eintrag. Abbrechen erhält den bisherigen Bestand.',
                 bg=self.theme['bg'], fg=self.theme['muted'], font=app_font(10), anchor='w',
                 wraplength=580).pack(fill='x', pady=(4, 12))
        preview_dir = tempfile.TemporaryDirectory(prefix='glide-preview-')
        entries = template.get('payload', {}).get('lists', []) or [template]
        first = next((entry for entry in entries if entry.get('cover')), None)
        if first:
            path = None
            value = first['cover']
            if value.get('kind') == 'image':
                attachment = next((a for a in first.get('attachments', []) if a.get('id') == value['attachment']), None)
                if attachment and attachment.get('storage') in template.get('files', {}):
                    extension = os.path.splitext(attachment.get('name', ''))[1].lower()
                    if extension in glide_image_preview.IMAGE_EXTENSIONS:
                        try:
                            path = os.path.join(preview_dir.name, 'titelbild' + extension)
                            with open(path, 'wb') as target:
                                target.write(base64.b64decode(template['files'][attachment['storage']], validate=True))
                        except (OSError, ValueError):
                            path = None
            self.make_page_cover(body, first, height=80, image_path=path).pack(fill='x', pady=(0, 6))
        area = tk.Frame(body, bg=self.theme['bg']); area.pack(fill='both', expand=True)
        text = tk.Text(area, wrap='word', height=16, width=60, bg=self.theme['input'], fg=self.theme['text'],
                       relief='flat', font=app_font(11), padx=10, pady=10)
        self._attach_field_scrollbar(area, text); text.pack(fill='both', expand=True)
        names = {glide_objects.uri('list', entry['id']): str(entry.get('title') or 'Liste')
                 for entry in self.lists + template.get('payload', {}).get('lists', [])}
        text.insert('1.0', glide_pages.template_preview(template, names)); text.configure(state='disabled')
        self._template_preview_text = text
        result = {'confirmed': False}
        def submit(event=None):
            result['confirmed'] = True; dialog.destroy(); return 'break'
        foot = tk.Frame(body, bg=self.theme['bg']); foot.pack(fill='x', pady=(12, 0))
        self._make_dialog_button(foot, 'Abbrechen', dialog.destroy, 'muted').pack(side='right')
        button = self._make_dialog_button(foot, 'Anlegen', submit, 'confirm'); button.pack(side='right', padx=8)
        dialog.bind('<Return>', submit); dialog.bind('<Escape>', lambda e: dialog.destroy())
        dialog.protocol('WM_DELETE_WINDOW', dialog.destroy)
        self._center_dialog(dialog, min_width=640); self._schedule_windows_chrome_theme(dialog)
        button.focus_set()
        try:
            self.run_modal(dialog)
        finally:
            self._template_preview_text = None
            preview_dir.cleanup()
        return result['confirmed']

    def create_list_from_template(self, template_key, folder_id=None):
        self.refresh_data_lock()
        if getattr(self, '_data_read_only', False): return None
        reference_time = datetime.now()
        reference_date = reference_time.date()
        template = copy.deepcopy(self.template_by_id(template_key))
        if template is None:
            legacy = self.LIST_TEMPLATES.get(template_key)
            if legacy is None: return None
            template = {'title': legacy[0], 'note': legacy[1], 'items': list(legacy[2]), 'kind': 'list'}
        fields = self.template_fields({key: value for key,value in template.items() if key != 'files'})
        values = {name: value for name in fields if (value := self.template_auto_value(name, reference_time)) is not None}
        missing = [name for name in fields if name not in values]
        if missing:
            filled = self.ask_template_fields(missing, str(template.get('title') or ''))
            if filled is None: return None
            values.update(filled)
        template = self.fill_template_value(template, values) if values else template
        template = glide_pages.prepare_template(template, reference_date)
        preview = copy.deepcopy(template)
        if template_key == 'daily':
            template['title'] += reference_date.strftime(' %d.%m.%Y')
            if template.get('payload', {}).get('lists'):
                template['payload']['lists'][0]['title'] = template['title']
            preview = copy.deepcopy(template)
        if template_key in ('journal-note', 'journal-folder'):
            preview['title'] = f'Tagesnotiz · {reference_date:%d.%m.%Y}'
            preview['rich_note'] = self.journal_note_document()
            if template_key == 'journal-folder': preview['note'] = f'Notizbuch {reference_date.year} mit vier Quartalen'
        if not self.confirm_template_preview(preview): return None
        if self.flush_rich_note() is False: return None
        if folder_id and (not self.get_folder(folder_id) or self.is_archived_folder(folder_id)): return None
        before = copy.deepcopy((self.lists, self.folders, self.labels, self.trash, self.settings, self.active_list_id, self.active_folder_id, self.view_mode)); depth = len(self.undo_stack)
        result = self._create_list_from_template(template_key, template, reference_date, folder_id=folder_id)
        if result is None:
            self.lists, self.folders, self.labels, self.trash, self.settings, self.active_list_id, self.active_folder_id, self.view_mode = before
            self.save_settings()
            del self.undo_stack[depth:]; self.sync_current_list_reference(); self.refresh_tree(); self.update_sidebar_list()
        return result

    def page_entry(self, list_id):
        entry = next((value for value in self.lists if value.get("id") == list_id), None)
        return entry if entry and entry.get("list_kind") in ("page", "note") else None

    @contextlib.contextmanager
    def page_task_change(self):
        change = getattr(self, '_task_editor_change', None)
        if change is not None:
            yield change
        else:
            with self.item_change((), restore=False, update_sidebar=True) as change:
                yield change

    def mark_page_task_change(self):
        change = getattr(self, '_task_editor_change', None)
        if change is not None:
            change.mark()
        else:
            self.save_items()

    def transfer_document_task(self, document_id, item_id, target_id):
        """Heimat wechseln, dieselbe Aufgabe und einen Textverweis behalten."""
        self.flush_rich_note()
        source = self.page_entry(document_id)
        target = next((entry for entry in self.lists if entry.get('id') == target_id), None)
        found = self.find_item_in_lists(item_id)
        if (getattr(self, '_data_read_only', False) or not source or not target or not found
                or found[3]['id'] != document_id or target.get('list_kind', 'tasks') != 'tasks'
                or self.is_archived_entry(target)):
            return False
        with self.guarded_structural_change('Aufgabe in Liste übernehmen'):
            with self.item_change((), restore=False, update_sidebar=True) as change:
                removed = self._pop_item(source.get('items', []), item_id)
                if removed:
                    item = removed[0]
                    target.setdefault('items', []).append(item)
                    self.preserve_task_text(source, self.collect_item_ids([item]))
                    change.mark()
        return bool(removed) and change.saved is not False

    def preserve_task_text(self, source, identities):
        if source.get('list_kind') in ('page', 'note'):
            source['rich_note'] = glide_task_refs.reference_document(
                RichNoteEditor.normalize(source.get('rich_note')), identities)

    def task_text_sources(self, item_id):
        ids = glide_task_refs.sources(self.planning_lists()).get(item_id, [])
        return [entry for entry in self.planning_lists() if entry['id'] in ids]

    def open_task_text_source(self, item_id):
        sources = self.task_text_sources(item_id)
        identity = sources[0]['id'] if len(sources) == 1 else self.themed_choice_dialog(
            'Textquelle öffnen', 'Wo soll die Aufgabe geöffnet werden?',
            [(entry['id'], self.list_path_title(entry)) for entry in sources]) if sources else None
        if identity:
            self.set_active_list(identity)
            editor = getattr(self, 'rich_note_editor', None)
            if editor:
                ranges = editor.task_ranges(item_id)
                if ranges:
                    editor.text.mark_set('insert', ranges[0][0])
                    editor.text.see(ranges[0][0])
        return 'break'

    def show_tasks_from_pages(self):
        criteria = next((value for value in self.settings.get('saved_filters', [])
                         if value.get('id') == 'from-pages'), None)
        if criteria is None:
            criteria = dict(id='from-pages', name='Aus Seiten', query='', list_ids=[], label_ids=[],
                            status='all', importance='all', due='any', label_mode='any', source='pages')
            if not self.saved_filters.save(criteria):
                return 'break'
        self.saved_filters.open(criteria['id'])
        return 'break'

    def page_task_hint(self, item):
        """Kurzinfo zu einer Seitenaufgabe (Tooltip des Kästchens)."""
        teile = []
        if item.get("due"):
            teile.append(f"Fällig {self.format_due_display(item.get('due'))}")
        if item.get("planned_date"):
            teile.append(f"Bearbeitungstag {self.format_due_display(item.get('planned_date'))}")
        labels = self.format_item_labels(item)
        if labels:
            teile.append(labels)
        teile.append("Doppelklick auf den Titel: alle Punktdetails")
        return " · ".join(teile)

    def create_page_task(self, list_id, title):
        """Legt eine Seitenaufgabe als echten Punkt der Seite an; liefert ihre Kennung."""
        entry = self.page_entry(list_id)
        title = " ".join(str(title or "").split())
        if entry is None or not title:
            return None
        if getattr(self, '_data_read_only', False):
            return None
        with self.page_task_change() as change:
            item = self.new_item(title, False)
            entry.setdefault('items', []).append(item)
            if entry.get('id') == self.active_list_id:
                self.items = entry['items']
            change.mark()
        return item['id']

    def rename_page_tasks(self, titles):
        geaendert = False
        for item_id, title in titles.items():
            found = self.find_item_in_lists(item_id)
            if not found:
                continue
            item = found[0]
            if " ".join(str(item.get("text") or "").split()) != title:
                item["text"] = title
                geaendert = True
        if geaendert:
            self.mark_page_task_change()

    def _pop_item(self, items, item_id, parent=None):
        for index, item in enumerate(items):
            if item.get("id") == item_id:
                return items.pop(index), parent, index
            found = self._pop_item(item.get("children", []) or [], item_id, item)
            if found:
                return found
        return None

    def remove_page_tasks(self, list_id, item_ids):
        """Gelöschte Aufgabenzeilen: ihre Punkte wandern in den Papierkorb."""
        entry = self.page_entry(list_id)
        if entry is None:
            return 0
        anzahl = 0
        for item_id in item_ids:
            found = self._pop_item(entry.get("items", []), item_id)
            if not found:
                continue
            item, eltern, index = found
            self.push_trash_entry(self.new_trash_entry(
                self.TRASH_KIND_ITEM, copy.deepcopy(item),
                origin={"list_id": entry.get("id"), "list_title": str(entry.get("title") or ""),
                        "parent_item_id": eltern.get("id") if eltern else None, "index": index}))
            anzahl += 1
        if anzahl:
            self.mark_page_task_change()
        return anzahl

    def restore_page_task(self, list_id, item_id):
        """Holt eine Seitenaufgabe aus dem Papierkorb zurück (Rückgängig im Editor)."""
        entry = self.page_entry(list_id)
        if entry is None:
            return False
        for index, trash_entry in enumerate(list(self.trash)):
            if trash_entry.get("kind") != self.TRASH_KIND_ITEM:
                continue
            payload = self.trash_entry_payload(trash_entry) or {}
            if payload.get("id") != item_id or (trash_entry.get("origin") or {}).get("list_id") != list_id:
                continue
            entry.setdefault("items", []).append(copy.deepcopy(payload))
            del self.trash[index]
            self.mark_page_task_change()
            return True
        return False

    def edit_page_task(self, item_id):
        """Alle Punktdetails einer Seitenaufgabe – derselbe Dialog wie in jeder Liste."""
        found = self.find_item_in_lists(item_id)
        if not found:
            return "break"
        item = found[0]
        details = self.themed_item_details_dialog(item)
        if details is None:
            return "break"
        with self.item_change([item_id], restore=False, local=True) as change:
            if self.apply_item_details(item, details):
                change.mark()
        return "break"

    PAGE_IMPORT_IMAGE_LIMIT = 200

    def page_document_from_markdown(self, markdown, list_id, base_dir=None):
        """Markdown → Seitendokument; Aufgaben (`- [ ]`) werden echte Punkte der Seite.

        B4 (3.34.0): Ein Bild allein auf seiner Zeile, dessen Datei hier liegt
        (`file:`-Adresse, absoluter Pfad oder relativ zu `base_dir`), wird
        wieder ein Seitenbild – als Anhang derselben Änderung.
        """
        entry = self.page_entry(list_id)
        gespeichert = {}

        def bild(beschreibung, quelle):
            pfad = glide_page_markdown.local_image_path(quelle, base_dir)
            if (entry is None or not pfad or not glide_image_preview.is_image_name(pfad)
                    or not os.path.isfile(pfad)):
                return None
            if pfad not in gespeichert:
                if len(gespeichert) >= self.PAGE_IMPORT_IMAGE_LIMIT:
                    return None
                try:
                    anhang = self.store_attachment(pfad)
                except OSError:
                    return None
                titel = " ".join(str(beschreibung or "").split())[:200]
                if titel and titel != os.path.splitext(os.path.basename(pfad))[0]:
                    anhang["title"] = titel
                entry.setdefault("attachments", []).append(anhang)
                gespeichert[pfad] = anhang
            anhang = gespeichert[pfad]
            natur = self.previews.natural_size(self.root, self.resolve_attachment_path(anhang) or pfad)
            breite = max(RichNoteEditor.IMAGE_WIDTH_RANGE[0], min(natur[0], 720)) if natur else 360
            # Wie beim Einfügen: Kleine Bilder stehen links im Text, große mittig.
            return "img:" + uuid.uuid4().hex[:16], {"attachment": anhang["id"],
                                                    "mode": "left" if breite <= 396 else "center", "width": breite}

        dokument = glide_page_markdown.markdown_to_page(markdown, bild)
        kennungen = {}
        for aufgabe in dokument.pop("tasks", []):
            item_id = self.create_page_task(list_id, aufgabe["text"])
            if item_id and aufgabe.get("done"):
                found = self.find_item_in_lists(item_id)
                if found:
                    found[0]["done"] = True
            kennungen[f"taskref:{aufgabe['ref']}"] = item_id
        spans = []
        for span in dokument["spans"]:
            if span["tag"].startswith("taskref:"):
                if kennungen.get(span["tag"]):
                    spans.append(dict(span, tag="item:" + kennungen[span["tag"]]))
                continue
            spans.append(span)
        dokument["spans"] = spans
        return RichNoteEditor.normalize(dokument)

    def page_markdown(self, list_id, image_folder=None, image_links=None):
        """Seite als Markdown. Bilder verweisen auf `image_folder/<Datei>`, mit `image_links="file"`
        auf die gespeicherte Anhangdatei (file-URL), sonst nur auf den Dateinamen."""
        entry = self.page_entry(list_id)
        if entry is None:
            return ""
        self.flush_rich_note()

        def zustand(item_id):
            found = self.find_item_in_lists(item_id)
            return (found[0].get("text"), found[0].get("done")) if found else None

        def bildquelle(info):
            anhang = self.page_attachment(list_id, info.get("attachment")) or {}
            name = str(anhang.get("name") or "Bild")
            titel = str(anhang.get("title") or os.path.splitext(name)[0]).replace("]", ")")
            if image_links == "file":
                datei = self.resolve_attachment_path(anhang) if anhang else None
                if datei and os.path.isfile(datei):
                    from pathlib import Path
                    return titel, Path(datei).resolve().as_uri()
            pfad = f"{image_folder}/{name}" if image_folder else name
            return titel, pfad.replace(" ", "%20")

        kopf = f"# {entry.get('title') or 'Seite'}\n\n"
        return kopf + glide_page_markdown.page_to_markdown(entry.get("rich_note"), zustand, bildquelle)

    def page_image_attachments(self, list_id):
        entry = self.page_entry(list_id)
        dokument = (entry or {}).get("rich_note") or {}
        kennungen = {info.get("attachment") for info in (dokument.get("images") or {}).values()}
        return [anhang for anhang in (entry or {}).get("attachments") or [] if anhang.get("id") in kennungen]

    def export_page_markdown(self, list_id):
        entry = self.page_entry(list_id)
        if entry is None:
            return "break"
        ziel = filedialog.asksaveasfilename(
            title="Seite als Markdown speichern", defaultextension=".md",
            initialfile=f"{self.safe_filename(str(entry.get('title') or 'seite'))}.md",
            filetypes=[("Markdown", "*.md"), ("Alle Dateien", "*.*")], parent=self.root)
        if not ziel:
            return "break"
        bilder = self.page_image_attachments(list_id)
        ordnername = os.path.splitext(os.path.basename(ziel))[0] + " Bilder" if bilder else None
        try:
            self.validate_backup_target(ziel)
            with open(ziel, "w", encoding="utf-8") as datei:
                datei.write(self.page_markdown(list_id, ordnername))
            # Bilder liegen neben der Datei, damit Markdown-Programme sie zeigen.
            if bilder:
                ordner = os.path.join(os.path.dirname(ziel), ordnername)
                os.makedirs(ordner, exist_ok=True)
                for anhang in bilder:
                    quelle = self.resolve_attachment_path(anhang)
                    if quelle and os.path.isfile(quelle):
                        shutil.copy2(quelle, os.path.join(ordner, os.path.basename(str(anhang.get("name") or "bild"))))
        except Exception as fehler:
            self.show_error("Als Markdown speichern", str(fehler))
            return "break"
        self.show_info("Seite gespeichert", f"Gespeichert nach:\n{ziel}"
                       + (f"\nBilder im Ordner „{ordnername}“." if bilder else ""))
        return "break"

    PAGE_PRINT_IMAGE_LIMIT = 6_000_000
    PAGE_IMAGE_TYPES = {".png": "image/png", ".gif": "image/gif", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
                        ".svg": "image/svg+xml", ".webp": "image/webp"}

    def build_page_print_html(self, list_id):
        """Druckseite einer Seite mit Text, Aufgaben, Tabellen und eingebetteten Bildern (B4)."""
        entry = self.page_entry(list_id)
        if entry is None:
            return None
        self.flush_rich_note()

        def zustand(item_id):
            found = self.find_item_in_lists(item_id)
            return (found[0].get("text"), found[0].get("done")) if found else None

        def bilddaten(info):
            anhang = self.page_attachment(list_id, info.get("attachment")) or {}
            name = str(anhang.get("name") or "Bild")
            titel = str(anhang.get("title") or os.path.splitext(name)[0])
            mime = self.PAGE_IMAGE_TYPES.get(os.path.splitext(name)[1].lower())
            datei = self.resolve_attachment_path(anhang) if anhang else None
            if not mime or not datei or not os.path.isfile(datei):
                return titel, None, None
            try:
                with open(datei, "rb") as quelle:
                    # Ein Byte mehr als die Grenze: Größeres bleibt ein benannter Platzhalter.
                    return titel, mime, quelle.read(self.PAGE_PRINT_IMAGE_LIMIT + 1)
            except OSError:
                return titel, None, None

        koerper = glide_page_markdown.page_to_print_html(entry.get("rich_note"), zustand, bilddaten,
                                                         max_image_bytes=self.PAGE_PRINT_IMAGE_LIMIT)
        titel = self.escape_print_text(str(entry.get("title") or "Seite"))
        erzeugt = datetime.now().strftime("%d.%m.%Y um %H:%M")
        return "\n".join([
            "<!DOCTYPE html>", '<html lang="de">', "<head>", '<meta charset="utf-8">',
            f"<title>{titel} · {APP_NAME}</title>", "<style>",
            "@page { size: A4; margin: 18mm 16mm; }",
            "body { margin: 0; font-family: 'DejaVu Sans', 'Helvetica Neue', Arial, sans-serif;"
            " font-size: 11pt; line-height: 1.5; color: #111; background: #fff; }",
            "h1 { font-size: 20pt; margin: 0 0 10pt; } h2 { font-size: 15pt; margin: 14pt 0 6pt; }",
            "h3 { font-size: 13pt; margin: 12pt 0 5pt; } h4 { font-size: 11.5pt; margin: 10pt 0 4pt; }",
            "p { margin: 0 0 8pt; } pre { background: #f4f4f6; padding: 6pt; white-space: pre-wrap; font-size: 9.5pt; }",
            "blockquote { margin: 0 0 8pt; padding-left: 10pt; border-left: 2pt solid #999; color: #333; }",
            "ul.page { list-style: none; margin: 0 0 8pt; padding: 0; } ul.page li { margin: 2pt 0; }",
            "span.box { display: inline-block; width: 9pt; height: 9pt; border: 0.8pt solid #111;"
            " margin-right: 6pt; vertical-align: -1pt; text-align: center; font-size: 7pt; line-height: 9pt; }",
            "table { border-collapse: collapse; margin: 0 0 8pt; } td { border: 0.5pt solid #999; padding: 2pt 5pt; }",
            "img { max-width: 100%; height: auto; page-break-inside: avoid; }",
            "span.image-missing { color: #555; font-style: italic; } hr { border: 0; border-top: 0.6pt solid #999; }",
            "footer { margin-top: 18pt; padding-top: 5pt; border-top: 0.5pt solid #999; font-size: 8.5pt; color: #555; }",
            "</style>", "</head>", "<body>", f"<h1>{titel}</h1>", koerper,
            f"<footer>{self.escape_print_text(APP_NAME + ' · gedruckt am ' + erzeugt)}</footer>",
            "</body>", "</html>", ""])

    def print_page(self, list_id):
        """Seite als Druckseite im Browser öffnen – dort drucken oder als PDF sichern (B4)."""
        html = self.build_page_print_html(list_id)
        if html is None:
            return "break"
        return self.open_print_html(html, "glide_seite", "Seite drucken")

    def copy_page_markdown(self, list_id):
        self.root.clipboard_clear()
        # B4: Kopiertes Markdown verweist auf die gespeicherten Bilddateien,
        # damit ein Markdown-Programm auf diesem Rechner sie zeigt.
        self.root.clipboard_append(self.page_markdown(list_id, image_links="file"))
        self.show_undo_toast("Seite als Markdown kopiert")
        return "break"

    def new_page_from_markdown(self, markdown, title=None, folder_id=None, base_dir=None):
        """Neue Seite aus Markdown – der Weg für KI-Berichte (Zwischenablage oder Datei)."""
        self.refresh_data_lock()
        if getattr(self, '_data_read_only', False) or self.flush_rich_note() is False: return None
        before = copy.deepcopy((self.lists, self.settings)); depth = len(self.undo_stack)
        if folder_id and not glide_sidebar.accepts(self.sidebar_section_for("folder", folder_id), "list", "page"):
            return None
        markdown = str(markdown or "")
        if not markdown.strip():
            self.show_warning("Seite aus Markdown", "Es gibt keinen Text, aus dem eine Seite werden kann.")
            return None
        if not title:
            erste = next((zeile for zeile in markdown.splitlines() if zeile.strip()), "Neue Seite")
            treffer = re.match(r"^#{1,6}\s+(.*)$", erste.strip())
            title = (treffer.group(1) if treffer else erste).strip()[:120] or "Neue Seite"
            if treffer:
                # Die erste Überschrift wird zum Seitentitel und steht nicht doppelt da.
                markdown = markdown.split(erste, 1)[1]
        entry = self.new_list_object(title, [], folder_id=folder_id, list_kind=self.LIST_KIND_PAGE)
        with self.sidebar_change(refresh_tree=True) as change:
            if not folder_id and getattr(self, "_creating_sidebar_section", None):
                self.locate_sidebar_root("list", entry["id"], self._creating_sidebar_section)
            self.lists.append(entry)
            previous_change = getattr(self, '_task_editor_change', None)
            self._task_editor_change = change
            try:
                entry["rich_note"] = self.page_document_from_markdown(markdown, entry["id"], base_dir)
            finally:
                self._task_editor_change = previous_change
            change.mark()
        if change.saved is False:
            self.lists, self.settings = before; del self.undo_stack[depth:]
            self.sync_current_list_reference(); self.save_settings(); self.refresh_tree(); self.update_sidebar_list()
            return None
        self.set_active_list(entry["id"])
        return entry

    def new_page_from_clipboard(self, event=None):
        try:
            inhalt = self.root.clipboard_get()
        except tk.TclError:
            inhalt = ""
        self.new_page_from_markdown(inhalt)
        return "break"

    def import_markdown_page(self, event=None):
        pfad = filedialog.askopenfilename(
            title="Markdown als Seite öffnen", parent=self.root,
            filetypes=[("Markdown", "*.md *.markdown *.txt"), ("Alle Dateien", "*.*")])
        if not pfad:
            return "break"
        try:
            with open(pfad, "r", encoding="utf-8-sig") as datei:
                inhalt = datei.read(5_000_000)
        except (OSError, UnicodeDecodeError) as fehler:
            self.show_error("Markdown als Seite", str(fehler))
            return "break"
        # Bilder neben der Datei (etwa „… Bilder/“ aus „Als Markdown speichern“) kommen mit.
        self.new_page_from_markdown(inhalt, base_dir=os.path.dirname(os.path.abspath(pfad)))
        return "break"

    def append_unlisted_page_tasks(self, entry):
        """Punkte der Seite, die (noch) keine Zeile haben – etwa hierher verschoben –, ans Ende."""
        dokument = RichNoteEditor.normalize(entry.get("rich_note"))
        vorhanden = {span["tag"][5:] for span in dokument["spans"] if span["tag"].startswith("item:")}
        fehlend = [item for item in entry.get("items", []) if item.get("id") not in vorhanden]
        if not fehlend:
            return False
        text = dokument["text"]
        spans = list(dokument["spans"])
        for item in fehlend:
            titel = " ".join(str(item.get("text") or "Aufgabe").split())
            if text:
                text += "\n"
            start = len(text)
            text += titel
            spans.append({"tag": "task", "start": start, "end": len(text)})
            spans.append({"tag": "item:" + item["id"], "start": start, "end": len(text)})
        entry["rich_note"] = RichNoteEditor.normalize({"text": text, "spans": spans, "links": dokument["links"]})
        return True

    def page_entries(self):
        return [entry for entry in getattr(self, "lists", []) if self.is_page_list(entry)
                and not self.is_archived_entry(entry)]

