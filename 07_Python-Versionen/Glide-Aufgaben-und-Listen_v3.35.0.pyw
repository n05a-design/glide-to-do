    # Mausrad / Menü / Dialoge
    # -----------------------------
    def bind_mousewheel(self, widget, target=None):
        """Tk 8-Mausrad und Tk 9-Trackpad; Bindungen bleiben am jeweiligen Widget."""
        target = target if target is not None else widget
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.bind_optional(widget, sequence, lambda event: self._on_mousewheel(event, target))
        self.bind_optional(widget, "<TouchpadScroll>",
                           lambda event: self._on_mousewheel(event, target, precise=True))

    def _on_mousewheel(self, event, widget, precise=False):
        self.note_scrolling()
        try:
            if precise:
                # Tk 9 kodiert X/Y als zwei vorzeichenbehaftete 16-Bit-Werte.
                packed = int(getattr(event, "delta", 0))
                vertical = packed & 0xffff
                if vertical >= 0x8000:
                    vertical -= 0x10000
                # Der waagrechte Anteil steht in den oberen 16 Bit (TIP 684).
                # Bis 29.09.2026 ging er verloren: Die Pinnwand ließ sich mit
                # zwei Fingern nicht nach links und rechts schieben (R2).
                horizontal = (packed >> 16) & 0xffff
                if horizontal >= 0x8000:
                    horizontal -= 0x10000
                if horizontal and abs(horizontal) >= abs(vertical):
                    self._scroll_horizontal_precise(widget, horizontal)
                    return "break"
                if not vertical:
                    return "break"
                if isinstance(widget, tk.Canvas):
                    return self._queue_canvas_scroll(widget, -vertical)
                # Native Text-/Treeview-Widgets scrollen in Zeilen. Kleine
                # Trackpad-Deltas sammeln, statt jede Geste zu vervielfachen.
                remainder = getattr(widget, "_glide_wheel_remainder", 0) - vertical
                steps = int(remainder / 16)
                widget._glide_wheel_remainder = remainder - steps * 16
            elif getattr(event, "num", None) in (4, 5):
                steps = -1 if event.num == 4 else 1
            else:
                delta = getattr(event, "delta", 0)
                if not delta:
                    return "break"
                # Tk 9 liefert auch auf dem Mac normierte 120er-Mausraddeltas;
                # Tk 8 kann dort kleine, bereits zeilenbezogene Werte liefern.
                steps = -int(delta / 120) if abs(delta) >= 120 or not IS_MACOS else -int(delta)
                if not steps:
                    steps = -1 if delta > 0 else 1
            first, last = widget.yview()
            if steps and last - first < ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
                if isinstance(widget, tk.Canvas) and int(float(widget.cget("yscrollincrement"))) == 1:
                    return self._queue_canvas_scroll(widget, steps * 24)
                widget.yview_scroll(steps, "units")
        except (tk.TclError, ValueError, TypeError):
            pass
        return "break"

    def _queue_canvas_scroll(self, canvas, pixel):
        """Sammelt Scrollschritte einer Leinwand und wendet sie einmal je Leerlauf an.

        Messung vom 29.09.2026 (R6): Jeder einzelne Schritt verschob auf der
        Startseite und in den Übersichten sofort alle eingebetteten Kacheln; eine
        Trackpad-Geste mit zwölf Ereignissen kostete so bis zu 255 ms. Liste und
        Seite fasst Tk ohnehin zusammen.
        """
        canvas._glide_scroll_pending = getattr(canvas, "_glide_scroll_pending", 0) + pixel
        if not getattr(canvas, "_glide_scroll_job", None):
            try:
                canvas._glide_scroll_job = canvas.after_idle(lambda c=canvas: self._apply_canvas_scroll(c))
            except tk.TclError:
                canvas._glide_scroll_job = None
        return "break"

    @staticmethod
    def _apply_canvas_scroll(canvas):
        canvas._glide_scroll_job = None
        pixel = getattr(canvas, "_glide_scroll_pending", 0)
        canvas._glide_scroll_pending = 0
        if not pixel:
            return
        try:
            first, last = canvas.yview()
            if last - first >= ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
                return
            if int(float(canvas.cget("yscrollincrement"))) == 1:
                canvas.yview_scroll(int(round(pixel)), "units")
                return
            region = canvas.bbox("all")
            if region:
                hoehe = max(canvas.winfo_height(), region[3] - region[1])
                canvas.yview_moveto(first + pixel / max(1, hoehe))
        except (tk.TclError, ValueError):
            pass

    @staticmethod
    def _scroll_horizontal_precise(widget, horizontal):
        """Trackpad quer: Leinwände pixelgenau, andere Widgets in Schritten."""
        try:
            first, last = widget.xview()
        except (tk.TclError, AttributeError, ValueError):
            return
        if last - first >= ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
            return
        try:
            if isinstance(widget, tk.Canvas):
                region = widget.bbox("all")
                breite = max(widget.winfo_width(), (region[2] - region[0]) if region else 1)
                widget.xview_moveto(first - horizontal / max(1, breite))
                return
            rest = getattr(widget, "_glide_wheel_rest_x", 0) - horizontal
            schritte = int(rest / 16)
            widget._glide_wheel_rest_x = rest - schritte * 16
            if schritte:
                widget.xview_scroll(schritte, "units")
        except (tk.TclError, ValueError, TypeError):
            pass

    def bind_horizontal_wheel(self, widget, target=None):
        """Shift und Mausrad schieben den Inhalt quer.

        . Tk meldet unter Windows und macOS `Shift-MouseWheel`,
        unter X11 die Tasten 6 und 7 (und mit gedrückter Umschalttaste 4 und 5).
        """
        target = target if target is not None else widget
        def quer(event, richtung=None):
            try:
                if richtung is not None:
                    schritte = richtung
                else:
                    delta = getattr(event, "delta", 0)
                    if not delta:
                        return "break"
                    schritte = -int(delta / 120) if abs(delta) >= 120 or not IS_MACOS else -int(delta)
                    if not schritte:
                        schritte = -1 if delta > 0 else 1
                first, last = target.xview()
                if last - first < ThemedAutoScrollbar.FULLY_VISIBLE_RATIO:
                    if isinstance(target, tk.Canvas) and int(float(target.cget("xscrollincrement"))) <= 1:
                        schritte *= 24
                    target.xview_scroll(schritte, "units")
            except (tk.TclError, ValueError, TypeError):
                pass
            return "break"
        self.bind_optional(widget, "<Shift-MouseWheel>", quer)
        for sequence, richtung in (("<Button-6>", -1), ("<Button-7>", 1),
                                   ("<Shift-Button-4>", -1), ("<Shift-Button-5>", 1)):
            # `event=None`: Tk ruft diese Sequenzen je nach Plattform und Eingabegerät
            # gelegentlich ohne Ereignis auf; der Schritt steht ohnehin fest.
            self.bind_optional(widget, sequence, lambda event=None, richtung=richtung: quer(event, richtung))

    def bind_drag_scroll(self, widget, canvas=None):
        """Gedrücktes Mausrad scrollt fortlaufend in Zeigerrichtung.

        Unter macOS liefert Tk mit der rechten Maustaste
        ebenfalls Knopf 2; dort bleibt die mittlere Taste deshalb dem
        Kontextmenü vorbehalten und diese Bindung entfällt.
        """
        if IS_MACOS:
            return
        state = {"x": 0, "y": 0, "dx": 0, "dy": 0, "aktiv": False,
                 "cursor": "", "job": None}

        def tick():
            state["job"] = None
            if not state["aktiv"]:
                return
            def speed(delta):
                if abs(delta) < 12:
                    return 0
                return (1 if delta > 0 else -1) * max(1, min(12, abs(delta) // 18))
            sx, sy = speed(state["dx"]), speed(state["dy"])
            try:
                target = canvas if canvas is not None else widget
                if sy:
                    target.yview_scroll(sy, "units")
                if sx:
                    target.xview_scroll(sx, "units")
            except (tk.TclError, ValueError, TypeError):
                pass
            try:
                state["job"] = widget.after(32, tick)
            except tk.TclError:
                state["aktiv"] = False

        def start(event):
            state.update(x=event.x, y=event.y, dx=0, dy=0, aktiv=True)
            try:
                state["cursor"] = widget.cget("cursor")
                widget.configure(cursor="fleur")
            except tk.TclError:
                pass
            tick()
            return "break"

        def move(event):
            if not state["aktiv"]:
                return None
            state["dx"] = event.x - state["x"]
            state["dy"] = event.y - state["y"]
            return "break"

        def stop(_event):
            state["aktiv"] = False
            if state.get("job") is not None:
                try:
                    widget.after_cancel(state["job"])
                except tk.TclError:
                    pass
                state["job"] = None
            try:
                widget.configure(cursor=state["cursor"])
            except tk.TclError:
                pass
            return "break"

        self.bind_optional(widget, "<ButtonPress-2>", start)
        self.bind_optional(widget, "<B2-Motion>", move)
        self.bind_optional(widget, "<ButtonRelease-2>", stop)

    @staticmethod
    def accel(*keys):
        """Plattformgerechte Beschriftung eines Tastenkürzels.

        Unter macOS heißt der Modifikator Cmd; „Strg+E“ wäre dort schlicht falsch.
        """
        modifier = "Cmd" if IS_MACOS else "Strg"
        return "+".join([modifier] + [str(key) for key in keys])

    SIDEBAR_RAIL_WIDTH = 64

    def sidebar_narrow(self):
        """Zeigt die Seitenleiste die schmale Symbolleiste (OB05)?"""
        return bool(self.settings.get("sidebar_visible", True) and self.settings.get("sidebar_narrow", False))

    def _apply_sidebar_visibility(self):
        visible = self.settings.get("sidebar_visible", True)
        schmal = self.sidebar_narrow()
        rail = getattr(self, "sidebar_rail", None)
        if visible and not schmal:
            if rail is not None:
                rail.pack_forget()
            self.sidebar_shell.pack(side="left", fill="y", padx=(0, 18), pady=(0, self.PAGE_BOTTOM_GAP),
                                    before=self.content_frame)
        else:
            self.sidebar_shell.pack_forget()
            if rail is not None:
                if schmal:
                    rail.pack(side="left", fill="y", padx=(0, 12), pady=(0, self.PAGE_BOTTOM_GAP),
                              before=self.content_frame)
                    self.refresh_sidebar_rail()
                else:
                    rail.pack_forget()
        if visible:
            self.sidebar_toggle_button.set_active(None)
        else:
            self.sidebar_toggle_button.set_active(self.theme["active"], self.theme["active_text"])

    def toggle_sidebar_narrow(self, event=None):
        """Schmale Seitenleiste ein- oder ausschalten (OB05); blendet sie dabei ein."""
        vorher = (self.settings.get("sidebar_visible", True), bool(self.settings.get("sidebar_narrow", False)))
        self.settings["sidebar_narrow"] = not self.sidebar_narrow()
        self.settings["sidebar_visible"] = True
        if not self.save_settings(show_error=True):
            self.settings["sidebar_visible"], self.settings["sidebar_narrow"] = vorher
            return "break"
        self._apply_sidebar_visibility()
        return "break"

    def refresh_sidebar_rail(self):
        """Baut die schmale Leiste aus den Systemzeilen und angehefteten Seiten (OB05).

        Je Eintrag ein Symbol mit dem Titel als Hinweis; die geöffnete
        Ansicht trägt die Auswahlfarbe wie in der breiten Leiste. Tab und
        Pfeil auf/ab wandern durch die Einträge, Return oder Leertaste öffnen.
        """
        rahmen = getattr(self, "sidebar_rail_frame", None)
        if rahmen is None or not self.sidebar_narrow():
            return
        for kind in rahmen.winfo_children():
            kind.destroy()
        theme = self.theme
        knoepfe = []

        def eintrag(text, titel, befehl, aktiv=False, bild=None):
            grund = theme["selection" if aktiv else "card"]
            schrift = theme["selection_text" if aktiv else "text"]
            knopf = tk.Label(rahmen, text="" if bild else text, image=bild or "", width=40 if bild else 2,
                             height=36 if bild else 1, bg=grund, fg=schrift, font=app_font(15), cursor="hand2",
                             takefocus=1, highlightthickness=2, highlightbackground=grund,
                             highlightcolor=theme["ui_accent"])
            knopf.pack(fill="x", pady=1)
            for sequenz in ("<Button-1>", "<Return>", "<space>"):
                knopf.bind(sequenz, lambda _event: befehl() or "break")
            knopf.bind("<Enter>", lambda _event, k=knopf, a=aktiv: None if a else k.configure(bg=theme["hover"]))
            knopf.bind("<Leave>", lambda _event, k=knopf, g=grund: k.configure(bg=g))
            self.add_tooltip(knopf, titel)
            knopf.rail_title = titel
            knoepfe.append(knopf)
            return knopf

        baum = self.system_listbox
        gewaehlt = set(baum.selection())
        for iid in baum.get_children(""):
            werte = baum.item(iid, "values") or ("",)
            titel = " ".join(str(baum.item(iid, "text")).split())

            def oeffnen(iid=iid):
                baum.selection_set(iid)
                baum.focus(iid)
                self.on_system_select()
            eintrag(str(werte[0] or "•"), titel, oeffnen, aktiv=iid in gewaehlt)
        seiten = self.pinned_pages()
        if seiten:
            tk.Frame(rahmen, bg=theme["line"], height=1).pack(fill="x", pady=6)
            offen = ("folder", self.active_folder_id) if self.view_mode == "folder" else (
                ("list", self.active_list_id) if self.view_mode in ("list", self.TABLE_VIEW) else None)
            for art, holder in seiten:
                symbol = self.ICONS["folder" if art == "folder" else "drawing" if self.is_drawing_list(holder) else "list"]
                titel = str(holder.get("title") or ("Ordner" if art == "folder" else "Liste"))
                eintrag(symbol, titel, lambda a=art, i=holder.get("id"): self.open_pinned_page(a, i),
                        aktiv=offen == (art, holder.get("id")), bild=self.page_icon_image(holder))
        breit = eintrag("»", "Seitenleiste breit zeigen · Ansicht › Seitenleiste schmal", self.toggle_sidebar_narrow)
        breit.pack_forget()
        breit.pack(side="bottom", fill="x", pady=(6, 0))
        for index, knopf in enumerate(knoepfe):
            knopf.bind("<Down>", lambda _event, i=index: knoepfe[(i + 1) % len(knoepfe)].focus_set() or "break")
            knopf.bind("<Up>", lambda _event, i=index: knoepfe[i - 1].focus_set() or "break")
        self.sidebar_rail_buttons = knoepfe

    def toggle_sidebar(self):
        old = self.settings.get("sidebar_visible", True)
        self.settings["sidebar_visible"] = not old
        if not self.save_settings(show_error=True):
            self.settings["sidebar_visible"] = old
            return "break"
        if old:
            self.tree.focus_set()
        self._apply_sidebar_visibility()
        return "break"

    def app_action_entries(self):
        """Menübaum einmal auslesen; App und Systemmenü führen dieselben Befehle aus."""
        entries = []
        seen = set()
        def visit(menu, path):
            for index in range((menu.index("end") if menu.index("end") is not None else -1) + 1):
                kind = menu.type(index)
                if kind == "cascade":
                    child = menu.nametowidget(menu.entrycget(index, "menu"))
                    visit(child, path + [menu.entrycget(index, "label")])
                elif kind == "command":
                    label = menu.entrycget(index, "label")
                    action_id = menu._glide_action_ids[index]
                    if action_id in seen:
                        continue
                    seen.add(action_id)
                    entries.append({"category": path[0], "path": " › ".join(path),
                                    "id": action_id,
                                    "label": label,
                                    "group": glide_actions.group_for(action_id),
                                    "shortcut": menu.entrycget(index, "accelerator"),
                                    "menu": menu, "index": index})
        for title, menu in self.action_menus:
            visit(menu, [title])
        return entries

    @classmethod
    def app_action_group(cls, label):
        """Kompatible Beschriftungsabfrage für ältere Prüfwerkzeuge."""
        return glide_actions.legacy_group(label)

    def invoke_app_action(self, action, previous_focus=None):
        # Ein geöffnetes Suchergebnis darf nach Menüneuaufbau keinen anderen
        # Befehl am alten Index ausführen. Die ID wird frisch aufgelöst.
        action_id = action.get("id")
        current = next((entry for entry in self.app_action_entries() if entry["id"] == action_id), None)
        if current is None:
            return False
        if previous_focus is not None and previous_focus.winfo_exists():
            previous_focus.focus_set()
            virtual = glide_actions.editor_event(action_id)
            if isinstance(previous_focus, (tk.Entry, tk.Text, ttk.Entry)) and virtual:
                previous_focus.event_generate(virtual)
                return
        current["menu"].invoke(current["index"])

    def open_history_view(self, event=None):
        """Öffnet den Änderungsverlauf als Seite (Kopfzeilenknopf, Strg+H)."""
        if self.view_mode != self.HISTORY_VIEW:
            self._activate_system_view(self.HISTORY_VIEW)
        return "break"

    def show_history_dialog(self, event=None, embedded=False):
        """Änderungsverlauf ansehen, filtern, ausgeben und leeren."""
        # Als Seite steht der Verlauf auf einer Karte wie jede andere Ansicht.
        # Bis 26.09.2026 lag er in der Fenstergrundfarbe direkt auf der Seite;
        # mit Hintergrundverlauf standen Titel, Beschriftungen und Knopfleiste
        # dann als dunkle Kästen auf dem Verlauf.
        if embedded:
            karte = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                                radius=18, padding=10, register=False)
            karte.pack(fill="both", expand=True)
            dialog = karte.inner
            grund = self.theme["card"]
        else:
            dialog = tk.Toplevel(self.root)
            dialog.title("Änderungsverlauf")
            dialog.transient(self.root)
            grund = self.theme["bg"]
        dialog.configure(bg=grund)
        if not embedded:
            dialog.minsize(560, 440)
        body = tk.Frame(dialog, bg=grund)
        body.pack(fill="both", expand=True, padx=24 if not embedded else 14, pady=20 if not embedded else 12)
        tk.Label(body, text="Änderungsverlauf", bg=grund, fg=self.theme["text"],
                 font=app_font(16, "bold"), anchor="w").pack(fill="x")
        kopf = tk.Label(body, text="", bg=grund, fg=self.theme["muted"],
                        font=app_font(10), anchor="w", justify="left", wraplength=700)
        kopf.pack(fill="x", pady=(4, 14))
        suche = tk.StringVar()
        self._make_field_label(body, "Suchen · Objekt, Vorgang, Liste oder Feld").pack(anchor="w", pady=(0, 5))
        feld = tk.Entry(body, textvariable=suche, name="history_search", bg=self.theme["input"],
                        fg=self.theme["text"], insertbackground=self.theme["text"], font=app_font(12),
                        relief="flat", bd=0, highlightthickness=1,
                        highlightbackground=self.theme["input_border"], highlightcolor=self.theme["ui_accent"])
        feld.pack(fill="x", ipady=8, pady=(0, 12))
        auswahl = tk.Frame(body, bg=grund)
        auswahl.pack(fill="x", pady=(0, 12))
        auswahl.columnconfigure((0, 1), weight=1, uniform="verlauf")
        zeit_namen = dict(self.HISTORY_RANGE_CHOICES)
        art_namen = dict(self.HISTORY_FILTER_CHOICES)
        zeit_var = tk.StringVar(value=zeit_namen["all"])
        art_var = tk.StringVar(value=art_namen["all"])
        links = tk.Frame(auswahl, bg=grund)
        links.grid(row=0, column=0, sticky="new", padx=(0, 10))
        rechts = tk.Frame(auswahl, bg=grund)
        rechts.grid(row=0, column=1, sticky="new", padx=(10, 0))
        self._make_field_label(links, "Zeitraum").pack(anchor="w", pady=(0, 5))
        zeit_feld, _knopf = self._make_option_menu(links, zeit_var,
                                                   [text for _key, text in self.HISTORY_RANGE_CHOICES])
        zeit_feld.pack(fill="x")
        self._make_field_label(rechts, "Art").pack(anchor="w", pady=(0, 5))
        art_feld, _knopf = self._make_option_menu(rechts, art_var,
                                                  [text for _key, text in self.HISTORY_FILTER_CHOICES])
        art_feld.pack(fill="x")
        fuss = tk.Frame(body, bg=grund)
        fuss.pack(side="bottom", fill="x", pady=(14, 0))
        flaeche = tk.Frame(body, bg=self.theme["card"])
        flaeche.pack(fill="both", expand=True)
        # Der Verlauf zeigte vier Spalten ohne Überschrift.
        # Wer die Reihenfolge nicht kannte, musste raten, was in welcher Spalte
        # steht – und ohne Überschriftenzeile gibt es auch keine Trennlinien
        # zum Ziehen. Beides ist jetzt da.
        baum = ttk.Treeview(flaeche, name="history_tree", columns=("aktion", "objekt", "liste"),
                            show="tree headings", selectmode="browse", style="Dialog.Treeview", height=12)
        self.prepare_table(baum, (("#0", "Zeitpunkt", 200), ("aktion", "Vorgang", 170),
                                  ("objekt", "Betroffenes Objekt", 270), ("liste", "Liste", 140)),
                           stretch="objekt")
        scroll = ThemedAutoScrollbar(flaeche, self.theme["card"], self.theme["card"],
                                     self.theme["input_border"], self.theme["muted"])
        scroll.pack(side="right", fill="y")
        scroll.set_command(baum.yview)
        baum.configure(yscrollcommand=scroll.set)
        baum.pack(fill="both", expand=True)
        self.bind_mousewheel(baum)
        sichtbar = []

        def schluessel(var, choices, namen):
            return next(key for key, text in choices if text == var.get())

        def aktualisiere(*_args):
            sichtbar.clear()
            sichtbar.extend(self.filtered_history(
                suche.get(),
                schluessel(zeit_var, self.HISTORY_RANGE_CHOICES, zeit_namen),
                schluessel(art_var, self.HISTORY_FILTER_CHOICES, art_namen),
            ))
            baum.delete(*baum.get_children())
            for index, entry in enumerate(sichtbar[:self.MAX_HISTORY_ENTRIES]):
                vorgang = (f"  {self.HISTORY_KIND_NAMES.get(entry.get('kind'), 'Objekt')} "
                           f"{self.HISTORY_ACTION_NAMES.get(entry.get('action'), 'geändert')}")
                objekt = str(entry.get("target") or "")
                if entry.get("fields"):
                    objekt = f"{objekt} ({', '.join(entry['fields'])})"
                baum.insert("", "end", iid=str(index),
                            text=self.format_history_time(entry.get("at")),
                            values=(vorgang, objekt, entry.get("list") or ""))
            gesamt = len(getattr(self, "history", []) or [])
            zusatz = "" if self.history_enabled() else "  ·  Protokollierung ist ausgeschaltet"
            kopf.configure(text=f"{len(sichtbar)} von {gesamt} Einträgen{zusatz}")

        def speichern():
            if not sichtbar:
                self.show_warning("Änderungsverlauf", "Zu dieser Auswahl gibt es keine Einträge.")
                return "break"
            ziel = filedialog.asksaveasfilename(
                title="Änderungsverlauf speichern", defaultextension=".txt",
                initialfile=f"glide_verlauf_{datetime.now().strftime('%Y-%m-%d')}.txt",
                filetypes=[("Textdatei", "*.txt"), ("Alle Dateien", "*.*")], parent=dialog,
            )
            if not ziel:
                return "break"
            try:
                self.validate_backup_target(ziel)
                with open(ziel, "w", encoding="utf-8") as datei:
                    datei.write(f"{APP_NAME} – Änderungsverlauf\n")
                    datei.write(f"Ausgegeben am {datetime.now().strftime('%d.%m.%Y um %H:%M Uhr')}\n")
                    datei.write(f"{len(sichtbar)} Einträge\n\n")
                    for entry in sichtbar:
                        datei.write(self.history_entry_line(entry) + "\n")
            except Exception as fehler:
                self.show_error("Änderungsverlauf", str(fehler))
                return "break"
            self.show_info("Änderungsverlauf gespeichert", f"Gespeichert nach:\n{ziel}")
            return "break"

        def leeren():
            gesamt = len(getattr(self, "history", []) or [])
            if not gesamt:
                self.show_warning("Änderungsverlauf", "Es sind keine Einträge vorhanden.")
                return "break"
            if not self.ask_yes_no("Verlauf leeren",
                                   f"{gesamt} Verlaufseinträge endgültig entfernen?\n\n"
                                   "Aufgaben, Listen und Ordner bleiben unverändert."):
                return "break"
            self.clear_history()
            aktualisiere()
            return "break"

        suche.trace_add("write", aktualisiere)
        zeit_var.trace_add("write", aktualisiere)
        art_var.trace_add("write", aktualisiere)
        flow = ButtonFlow(fuss, bg=grund, gap=8)
        flow.pack(fill="x")
        flow.add(self._make_dialog_button(flow, "Zur Startseite" if embedded else "Schließen", self.set_home_view if embedded else dialog.destroy, "muted"))
        flow.add(self._make_dialog_button(flow, "Verlauf leeren", leeren, "delete", width=150))
        flow.add(self._make_dialog_button(flow, "Als TXT speichern", speichern, "export", width=178))
        dialog.bind("<Escape>", lambda _event: self.set_home_view() if embedded else dialog.destroy())
        aktualisiere()
        if not embedded:
            self._center_dialog(dialog, min_width=860, min_height=640)
            self._schedule_windows_chrome_theme(dialog)
            feld.focus_set()
            self.run_modal(dialog)
        return "break"

    # -----------------------------
    # Seiten- und Befehlssuche (3.30, Strg/Cmd+O)
    # -----------------------------
    MAX_RECENT_PAGES = 20
    QUICK_OPEN_LIMIT = 60

    @staticmethod
    def search_key(text):
        """Vergleichsform: Groß/Klein egal, Umlaute gleichwertig zu ae/oe/ue/ss."""
        return glide_search.search_key(text)

    def note_page_opened(self, kind, identity):
        """Merkt zuletzt geöffnete Seiten – lokal, höchstens 20, ohne Verlaufseintrag."""
        if not isinstance(getattr(self, "settings", None), dict) or not identity:
            return
        recent = [value for value in self.settings.get("recent_pages", [])
                  if not (value.get("kind") == kind and value.get("id") == identity)]
        recent.insert(0, {"kind": kind, "id": identity,
                          "opened_at": datetime.now().astimezone().isoformat(timespec="seconds")})
        self.settings["recent_pages"] = recent[:self.MAX_RECENT_PAGES]
        job = getattr(self, "_recent_pages_job", None)
        if job is None:
            try:
                self._recent_pages_job = self.root.after(1500, self._save_recent_pages)
            except tk.TclError:
                self._recent_pages_job = None
            if self._recent_pages_job is not None and not getattr(self, "_recent_pages_cleanup", False):
                # Schließt sich das Fenster vorher, fällt der Auftrag weg, statt
                # später auf ein nicht mehr vorhandenes Tk-Kommando zu treffen.
                self._recent_pages_cleanup = True
                self.root.bind("<Destroy>", self._cancel_recent_pages_job, add="+")

    def _cancel_recent_pages_job(self, event=None):
        if event is not None and event.widget is not self.root:
            return
        job = getattr(self, "_recent_pages_job", None)
        self._recent_pages_job = None
        if job is not None:
            try:
                self.root.after_cancel(job)
            except tk.TclError:
                pass

    def _save_recent_pages(self):
        self._recent_pages_job = None
        self.save_settings()

    def recent_pages(self):
        """Zuletzt geöffnete, noch vorhandene Seiten als (Art, Objekt)."""
        result = []
        for value in self.settings.get("recent_pages", []) if isinstance(getattr(self, "settings", None), dict) else []:
            if value.get("kind") == "folder":
                holder = self.get_folder(value.get("id"))
            else:
                holder = next((entry for entry in self.lists if entry.get("id") == value.get("id")), None)
            if holder is not None:
                result.append((value.get("kind"), holder))
        return result

    def quick_open_views(self):
        return (
            ("Startseite", self.ICONS["home"], self.set_home_view),
            ("Heute", self.ICONS["today"], self.set_today_view),
            ("Demnächst", self.ICONS["in_progress"], self.set_in_progress_view),
            ("Verspätet", self.ICONS["overdue"], self.set_overdue_view),
            ("Labels", self.ICONS["labels"], self.set_labels_view),
            ("Listen und Ordner", self.ICONS["list"], self.set_library_view),
            ("Globale Pinnwand", self.ICONS["board"], self.open_global_board),
            ("Vorlagen", self.ICONS["templates"], self.set_template_view),
            ("Kalender", self.ICONS["calendar"], self.open_calendar_view),
            ("Wochenrückblick", self.ICONS["calendar"], self.show_week_review),
            ("Tagesbeginn", self.ICONS["today"], self.start_day_review),
            ("Tagesabschluss", self.ICONS["check"], self.start_day_close),
            ("Papierkorb", self.ICONS["trash"], self.set_trash_view),
        )

    def quick_open_results(self, query):
        """Treffer als Wörterbücher: Gruppe, Symbol, Titel, Pfad, Ziel.

        Reihenfolge je Gruppe: Titel beginnt mit der Eingabe, dann ein Wort
        beginnt damit, dann enthält der Titel sie irgendwo.
        """
        query, actions_only = glide_interaction.palette_query(query)
        key = self.search_key(query)
        if actions_only:
            return [{"group": action["group"], "symbol": self.ICONS["actions"],
                     "title": action["label"], "path": action["path"],
                     "shortcut": action.get("shortcut", ""), "target": ("action", action)}
                    for action in self.app_action_entries()
                    if not key or key in self.search_key(action["label"] + " " + action["path"])]

        def rank(text):
            return glide_search.title_rank(text, key)

        results = []
        if not key:
            for kind, holder in self.recent_pages()[:8]:
                results.append(self._quick_page_result(kind, holder, "Zuletzt geöffnet"))
            for title, symbol, command in self.quick_open_views():
                results.append({"group": "Ansichten", "symbol": symbol, "title": title, "path": "",
                                "target": ("view", command)})
            return results[:self.QUICK_OPEN_LIMIT]
        pages = []
        for entry in self.lists:
            score, excerpt = glide_search.match_content(
                entry.get("title", ""), glide_search.list_content(entry), key)
            if score is not None:
                result = self._quick_page_result("list", entry, "Seiten")
                if excerpt:
                    result["path"] = (result["path"] + " · " if result["path"] else "") + excerpt
                    # G14h: Nach dem Öffnen werden die Fundstellen im Text markiert.
                    result["highlight"] = key
                pages.append((score, result))
        for folder in self.folders:
            score = rank(folder.get("title", ""))
            if score is not None:
                pages.append((score, self._quick_page_result("folder", folder, "Seiten")))
        for title, symbol, command in self.quick_open_views():
            score = rank(title)
            if score is not None:
                pages.append((score, {"group": "Seiten", "symbol": symbol, "title": title, "path": "Ansicht",
                                      "target": ("view", command)}))
        for saved in self.settings.get("saved_filters", []):
            score = rank(saved.get("name", ""))
            if score is not None:
                pages.append((score, {"group": "Seiten", "symbol": self.ICONS["labels"], "title": saved["name"],
                                      "path": "Gespeicherter Filter", "target": ("filter", saved["id"])}))
        pages.sort(key=lambda value: (value[0], self.search_key(value[1]["title"])))
        results.extend(result for _score, result in pages[:30])
        if len(key) >= 2:
            items = []
            for entry in self.lists:
                if self.is_archived_entry(entry):
                    continue
                for item in self.walk_items(entry.get("items", [])):
                    score, excerpt = glide_search.match_content(
                        item.get("text", ""), (item.get("description", ""),), key)
                    if score is None:
                        continue
                    items.append((score, {"group": "Punkte", "symbol": self.ICONS["check"] if item.get("done")
                                          else self.ICONS["task_open"],
                                          "title": self.normalize_item_text(item.get("text", ""), self.ITEM_KIND_TASK),
                                          "path": self.list_path_title(entry) + (" · " + excerpt if excerpt else ""),
                                          "target": ("item", entry.get("id"), item.get("id"))}))
            items.sort(key=lambda value: value[0])
            results.extend(result for _score, result in items[:15])
        actions = []
        for action in self.app_action_entries():
            score = rank(action["label"])
            if score is None:
                score = 3 if key in self.search_key(action["path"] + " " + action["group"]) else None
            if score is not None:
                actions.append((score, {"group": "Aktionen", "symbol": self.ICONS["actions"],
                                        "title": action["label"], "path": action["path"],
                                        "shortcut": action.get("shortcut", ""), "target": ("action", action)}))
        actions.sort(key=lambda value: value[0])
        results.extend(result for _score, result in actions[:15])
        return results[:self.QUICK_OPEN_LIMIT]

    def _quick_page_result(self, kind, holder, group):
        if kind == "folder":
            symbol = self.ICONS["folder"]
            path = " › ".join(self.folder_path_titles(holder.get("parent_id"))) if holder.get("parent_id") else ""
        else:
            symbol = self.ICONS["drawing"] if self.is_drawing_list(holder) else (
                self.ICONS["pages"] if self.is_page_list(holder) else
                self.ICONS["description"] if holder.get("list_kind") == self.LIST_KIND_NOTE else self.ICONS["list"])
            path = " › ".join(self.folder_path_titles(holder.get("folder_id"))) if holder.get("folder_id") else ""
        if holder.get("archived") or (kind == "list" and self.is_archived_entry(holder)):
            path = (path + " · " if path else "") + "im Archiv"
        return {"group": group, "symbol": symbol, "title": str(holder.get("title") or ""), "path": path,
                "target": (kind, holder.get("id")), "icon": self.page_icon_image(holder)}

    def open_quick_result(self, result, previous_focus=None):
        target = result.get("target") or ()
        if not target:
            return
        kind = target[0]
        if kind == "list":
            self.set_active_list(target[1])
            if result.get("highlight"):
                editor = getattr(self, "rich_note_editor", None)
                if isinstance(editor, PageEditor) and editor.winfo_exists():
                    editor.highlight_matches(result["highlight"])
        elif kind == "folder":
            self.set_active_folder(target[1])
        elif kind == "view":
            target[1]()
        elif kind == "filter":
            self.saved_filters.open(target[1])
        elif kind == "item":
            self.set_active_list(target[1])
            try:
                self.root.update_idletasks()
                if self.tree.exists(target[2]):
                    self.tree.selection_set(target[2])
                    self.tree.focus(target[2])
                    self.tree.see(target[2])
                    self.tree.focus_set()
            except tk.TclError:
                pass
        elif kind == "action":
            self.invoke_app_action(target[1], previous_focus)

    def show_quick_open(self, event=None, actions_only=False):
        """Eingebettete Suche über Seiten, Punkte und Aktionen (kein Zusatzfenster)."""
        if getattr(self, "_quick_open", None) is not None:
            self.close_quick_open()
            return "break"
        previous_focus = getattr(self, "_actions_source_focus", None) or self.current_focus_widget()
        self._actions_source_focus = None
        theme = self.theme
        # Eingebettet, kein eigenes Fenster; Rahmen und Fläche siehe
        # quick_open_stage.
        breite = min(680, max(420, self.root.winfo_width() - 80))
        buehne, panel = self.quick_open_stage(breite)
        flaeche = self.quick_open_surface()
        tk.Label(panel, text="Suchen und Aktionen · > zeigt nur Aktionen", bg=flaeche, fg=theme["muted"],
                 font=app_font(9), anchor="w").pack(fill="x", padx=4, pady=(2, 6))
        query = tk.StringVar(value="> " if actions_only else "")
        feld = self.make_rounded_container(panel, fill_key="input", outline_key="input_border", radius=14,
                                           padding=1, height=40, inner_pad_x=10, inner_pad_y=4, register=False)
        feld.glass_mode = False
        feld.set_theme(flaeche, theme["input"], theme["input_border"])
        feld.pack(fill="x")
        feld.pack_propagate(False)
        entry = tk.Entry(feld.inner, textvariable=query, name="quick_open_entry", bg=theme["input"],
                         fg=theme["text"], insertbackground=theme["text"], font=app_font(13), relief="flat",
                         bd=0, highlightthickness=0)
        entry.pack(fill="both", expand=True)
        tree = ttk.Treeview(panel, name="quick_open_tree", columns=("path",), show="tree", selectmode="browse",
                            style="QuickOpen.Treeview", height=12)
        tree.column("#0", width=380, stretch=True)
        tree.column("path", width=220, stretch=False, anchor="e")
        tree.tag_configure("group", foreground=theme["accent"], font=app_font(10, "bold"))
        tree.pack(fill="both", expand=True, pady=(10, 2))
        results = []
        images = []
        panel.bind("<Configure>", lambda _event: self.size_quick_open_stage(), add="+")

        def refresh(*_args):
            tree.delete(*tree.get_children())
            results[:] = self.quick_open_results(query.get())
            images.clear()
            current_group = None
            for index, result in enumerate(results):
                if result["group"] != current_group:
                    current_group = result["group"]
                    tree.insert("", "end", iid=f"group:{index}", text=current_group, values=("",), tags=("group",))
                options = {"text": f"   {result['symbol']}  {result['title']}",
                           "values": (result.get("path") or result.get("shortcut") or "",)}
                if result.get("icon") is not None:
                    images.append(result["icon"])
                    options.update(text=f"   {result['title']}", image=result["icon"])
                tree.insert("", "end", iid=str(index), **options)
            first = next((row for row in tree.get_children() if not row.startswith("group:")), None)
            if first:
                tree.selection_set(first)
                tree.focus(first)
                tree.see(first)

        def move(step):
            rows = [row for row in tree.get_children() if not row.startswith("group:")]
            if not rows:
                return "break"
            current = tree.selection()[0] if tree.selection() else rows[0]
            position = rows.index(current) if current in rows else 0
            target = rows[max(0, min(len(rows) - 1, position + step))]
            tree.selection_set(target)
            tree.focus(target)
            tree.see(target)
            return "break"

        def submit(_event=None):
            selected = [row for row in tree.selection() if not row.startswith("group:")]
            if not selected:
                return "break"
            result = results[int(selected[0])]
            self.close_quick_open()
            self.open_quick_result(result, previous_focus)
            return "break"

        query.trace_add("write", refresh)
        entry.bind("<Down>", lambda _event: move(1))
        entry.bind("<Up>", lambda _event: move(-1))
        entry.bind("<Return>", submit)
        entry.bind("<Escape>", lambda _event: self.close_quick_open() or "break")
        tree.bind("<Return>", submit)
        tree.bind("<Double-Button-1>", submit)
        tree.bind("<ButtonRelease-1>", lambda event: submit() if tree.identify_row(event.y) and not
                  tree.identify_row(event.y).startswith("group:") else None)
        tree.bind("<Escape>", lambda _event: self.close_quick_open() or "break")
        self._quick_open = {"panel": panel, "stage": buehne, "entry": entry, "tree": tree, "results": results,
                            "images": images, "previous_focus": previous_focus}
        # Ein Klick auf die übrige Fläche schließt die Suche (R3, 29.09.2026).
        self._quick_open["click"] = self.root.bind_all("<ButtonPress-1>", self.close_quick_open_outside, add="+")
        refresh()
        self.size_quick_open_stage()
        entry.focus_set()
        return "break"

    # Seit 29.09.2026 ohne Schatten: ein Rand in der Akzentfarbe (R3).
    QUICK_OPEN_PAD = 16
    QUICK_OPEN_BORDER = 3

    def quick_open_stage(self, breite):
        """Rahmen der Suche mit Rand in der Akzentfarbe; liefert (Rahmen, Inhaltsrahmen).

        Bis 29.09.2026 lag die Suche auf einer Zeichenfläche, die Schatten und
        Untergrund nachmalte. Auf Verläufen und in dunklen Designs versank sie
        darin, und unter macOS saß der gemalte Rand versetzt zum Inhalt
        (Befund R3). Jetzt ein einfacher Rahmen: nichts wird nachgemalt, nichts
        kann verrutschen.
        """
        theme = self.theme
        flaeche = self.quick_open_surface()
        buehne = tk.Frame(self.root, name="quick_open_stage", bg=flaeche,
                          highlightthickness=self.QUICK_OPEN_BORDER, highlightbackground=theme["ui_accent"],
                          highlightcolor=theme["ui_accent"], bd=0)
        panel = tk.Frame(buehne, bg=flaeche, name="quick_open_panel")
        panel.pack(fill="both", expand=True, padx=self.QUICK_OPEN_PAD, pady=self.QUICK_OPEN_PAD)
        # Unter der Kopfzeile, damit ihre Knöpfe nicht angeschnitten werden.
        kopf = getattr(self, "header_frame", None)
        oben = 64
        try:
            if kopf is not None and kopf.winfo_ismapped():
                oben = kopf.winfo_rooty() - self.root.winfo_rooty() + kopf.winfo_height() + 6
        except tk.TclError:
            pass
        buehne.place(x=(self.root.winfo_width() - breite) // 2, y=oben, width=breite)
        buehne.tk.call("raise", buehne._w)
        return buehne, panel

    QUICK_OPEN_SURFACE_MIX = 0.07

    def quick_open_surface(self):
        """Eigene, vom Design abgesetzte Fläche der Suche (R3, 29.09.2026).

        Die Kartenfarbe, 7 % zur Schriftfarbe gemischt: im hellen Design etwas
        dunkler, im dunklen etwas heller. So hebt sich die Suche von Karten und
        Verlauf ab, ohne Schatten. Die Ergebnisliste bekommt dieselbe Fläche
        (Stil „QuickOpen.Treeview“, abgeleitet von „Dialog.Treeview“).
        """
        theme = self.theme
        flaeche = mix_hex_colors(theme["card"], theme["text"], self.QUICK_OPEN_SURFACE_MIX)
        try:
            self.style.configure("QuickOpen.Treeview", background=flaeche, fieldbackground=flaeche,
                                 foreground=theme["text"], borderwidth=0, relief="flat", font=app_font(11),
                                 rowheight=38)
            self.style.layout("QuickOpen.Treeview", [("Treeview.treearea", {"sticky": "nswe"})])
            self.style.map("QuickOpen.Treeview", background=[("selected", theme["selection"])],
                           foreground=[("selected", theme["selection_text"])])
        except (AttributeError, tk.TclError):
            pass
        return flaeche

    def size_quick_open_stage(self):
        """Hält die Suche über allem; die Höhe folgt dem Inhalt von selbst."""
        state = getattr(self, "_quick_open", None)
        if not state:
            return
        try:
            state["stage"].tk.call("raise", state["stage"]._w)
        except tk.TclError:
            pass

    def theme_is_dark(self):
        try:
            return self.design_info().get("base") == "dark"
        except (AttributeError, KeyError, TypeError):
            return False

    def close_quick_open_outside(self, event=None):
        """Schließt die Suche, wenn außerhalb ihrer Karte geklickt wird."""
        state = getattr(self, "_quick_open", None)
        widget = getattr(event, "widget", None)
        if not state or widget is None:
            return None
        buehne = state.get("stage")
        try:
            pfad = str(widget)
            if buehne is not None and (pfad == str(buehne) or pfad.startswith(str(buehne) + ".")):
                return None
        except tk.TclError:
            return None
        # Die Lupe schaltet selbst um; ein Schließen hier öffnete die Suche sofort wieder.
        if widget is getattr(self, "search_button", None) or str(widget).startswith(
                str(getattr(self, "search_button", "")) + "."):
            return None
        self.root.after_idle(self.close_quick_open)
        return None

    def close_quick_open(self):
        state = getattr(self, "_quick_open", None)
        self._quick_open = None
        if state and state.get("click"):
            try:
                self.root.unbind_all("<ButtonPress-1>")
            except tk.TclError:
                pass
        if state:
            for teil in ("panel", "stage"):
                try:
                    if state.get(teil) is not None:
                        state[teil].destroy()
                except tk.TclError:
                    pass

    def show_actions_dialog(self):
        """Kompatibler Aktionseinstieg in dieselbe eingebettete Palette."""
        return self.show_quick_open(actions_only=True)

    def build_menu(self, parent, eintraege, tearoff=0):
        """Baut ein Menü aus einer Beschreibung und meldet es dem Theme an.

        Die Menüzeile wurde Eintrag für Eintrag von Hand
        zusammengesetzt – jede Zeile ein Aufruf, jedes Untermenü zusätzlich ein
        eigener Name, der am Ende in `self.menus` nachgetragen werden musste.
        Wurde das vergessen, blieb genau dieses Untermenü ungefärbt. Die
        Beschreibung nennt nur noch Struktur und Befehl; Anlegen, Verschachteln
        und Anmelden erledigt diese Stelle.

        Eintragsformen: `None` für eine Trennlinie, `(Beschriftung, Befehl)`,
        `(Beschriftung, Befehl, Tastenkürzel)` und `(Beschriftung, Liste)` für
        ein Untermenü.
        """
        menu = tk.Menu(parent, tearoff=tearoff)
        menu._glide_action_ids = {}
        self.menus.append(menu)
        for eintrag in eintraege:
            if eintrag is None:
                menu.add_separator()
                continue
            beschriftung, ziel = eintrag[0], eintrag[1]
            if isinstance(ziel, str):
                # Ein Untermenü, das sich selbst füllt (etwa „Hintergrund“ je
                # Design): Der Name wird zum Attribut der App.
                untermenue = tk.Menu(menu, tearoff=0)
                self.menus.append(untermenue)
                setattr(self, ziel, untermenue)
                menu.add_cascade(label=beschriftung, menu=untermenue)
            elif isinstance(ziel, (list, tuple)):
                menu.add_cascade(label=beschriftung, menu=self.build_menu(menu, ziel))
            else:
                menu.add_command(label=beschriftung, command=ziel,
                                 accelerator=eintrag[2] if len(eintrag) > 2 else "")
                menu._glide_action_ids[menu.index("end")] = (
                    eintrag[3] if len(eintrag) > 3 else glide_actions.method_id(ziel))
        return menu

