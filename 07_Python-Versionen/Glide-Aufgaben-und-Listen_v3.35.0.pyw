def rounded_rect_points(x1, y1, x2, y2, radius):
    """Stützpunkte eines abgerundeten Rechtecks für `create_polygon`.

    Dieselbe Punktliste stand dreimal im
    Quelltext – in `RoundedButton`, `RoundedContainer` und
    `ThemedAutoScrollbar`. Unterschiedlich war an den drei Stellen nur, was
    danach mit den Punkten geschieht: Umriss ja oder nein, wie fein die Kurve
    unterteilt wird, welche Marke das Element trägt. Die Geometrie selbst ist
    überall dieselbe – eine Ecke, die in drei Fassungen existiert, ist eine
    Ecke, die in drei Fassungen falsch werden kann.

    `smooth=True` zieht durch diese zwölf Punkte eine Bézierkurve; die
    doppelten Eckpunkte sind die Steuerpunkte, die aus der Kurve eine
    Rundung mit dem gewünschten Radius machen.
    """
    return [
        x1 + radius, y1,
        x2 - radius, y1,
        x2, y1,
        x2, y1 + radius,
        x2, y2 - radius,
        x2, y2,
        x2 - radius, y2,
        x1 + radius, y2,
        x1, y2,
        x1, y2 - radius,
        x1, y1 + radius,
        x1, y1,
    ]


def root_after(root, delay, callback):
    """`after` ohne Ausnahme, wenn das Fenster gerade verschwindet."""
    try:
        return root.after(delay, callback)
    except tk.TclError:
        return None


_APP_FONT_CACHE = weakref.WeakKeyDictionary()


def app_font(size=11, *styles, root=None):
    """Konkrete Familie statt des als Arial interpretierten Tupelnamens TkDefaultFont."""
    root = root or getattr(tk, "_default_root", None)
    if root is None:
        return ("TkDefaultFont", size, *styles)
    root = root._root()
    try:
        family_delta = _APP_FONT_CACHE.get(root)
        if family_delta is None:
            named = tkfont.nametofont("TkDefaultFont", root=root)
            family_delta = (named.actual("family"), max(-1, min(1, named.actual("size") - 11)))
            _APP_FONT_CACHE[root] = family_delta
        family, delta = family_delta
        return (family, int(size) + delta, *styles)
    except (tk.TclError, RuntimeError):
        return ("TkDefaultFont", size, *styles)


def bind_theme_hover(widget, theme_getter, base_bg, fg_hover=None):
    """Datums- und Labelauswahl verwenden denselben Hover mit aktuellem Theme."""
    base_fg = widget.cget("fg")
    widget.bind("<Enter>", lambda _e: widget.configure(
        bg=theme_getter()["hover"], fg=fg_hover or base_fg), add="+")
    widget.bind("<Leave>", lambda _e: widget.configure(bg=base_bg, fg=base_fg), add="+")


