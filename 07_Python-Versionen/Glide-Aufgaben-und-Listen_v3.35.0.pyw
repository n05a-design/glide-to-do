        tree_area = tk.Frame(area, bg=self.theme["card"])
        tree_area.pack(fill="both", expand=True)
        # App.Treeview liefert die bestehenden Listenfarben und Auswahlzustände.
        # Nur die Zeilenhöhe wird für die einfache Vorlagenzeile festgelegt.
