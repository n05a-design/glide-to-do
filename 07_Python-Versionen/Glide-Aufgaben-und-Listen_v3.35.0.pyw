        dialog.title("Kalenderdatei (ICS)")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Kalenderdatei (ICS)", font=app_font(15, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        tk.Label(outer, text="Glide schreibt die Fälligkeiten als ICS-Datei. Apple Kalender, Outlook, "
                 "Thunderbird und Google Kalender lesen sie ein – ohne Konto und ohne Synchronisierung.",
                 font=app_font(10), bg=self.theme["bg"], fg=self.theme["muted"],
                 justify="left", wraplength=620, anchor="w").pack(anchor="w", pady=(4, 16))
        namen = dict(self.ICS_SCOPES)
        start = scope if scope in namen else (
            "planday" if self.view_mode == self.PLAN_DAY_VIEW else
            "list" if self.view_mode in ("list", self.TABLE_VIEW, "folder") else "all")
        auswahl = tk.StringVar(value=namen[start])
        self._make_field_label(outer, "Was soll in den Kalender?").pack(anchor="w", pady=(0, 5))
        feld, _knopf = self._make_option_menu(outer, auswahl, [text for _key, text in self.ICS_SCOPES])
        feld.pack(fill="x", pady=(0, 14))
        tk.Label(outer, text="Inhalt", font=app_font(11, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w", pady=(0, 6))
        vorgaben = self.ics_default_options()
        variablen = {}
        for key, text in self.ICS_OPTION_LABELS:
            variablen[key] = tk.BooleanVar(value=vorgaben[key])
            tk.Checkbutton(
                outer, name="ics_" + key, text=text, variable=variablen[key],
                bg=self.theme["bg"], fg=self.theme["text"], selectcolor=self.theme["input"],
                activebackground=self.theme["bg"], activeforeground=self.theme["text"],
                anchor="w", justify="left", wraplength=620, font=app_font(10), highlightthickness=0,
            ).pack(fill="x", pady=2)
        hinweis = tk.Label(outer, text="", bg=self.theme["bg"], fg=self.theme["muted"],
                           font=app_font(10), justify="left", wraplength=620, anchor="w")
        hinweis.pack(anchor="w", pady=(12, 0))

        def gewaehlter_umfang():
            return next(key for key, text in self.ICS_SCOPES if text == auswahl.get())

        def optionen():
            return {key: bool(var.get()) for key, var in variablen.items()}

        def vorschau(*_args):
            try:
                _text, bericht = self.build_ics_document(gewaehlter_umfang(), optionen())
            except Exception as fehler:
                hinweis.configure(text=str(fehler), fg=self.theme["delete"])
                return
            teile = [f"{bericht['events']} Termin(e)"]
            if bericht["skipped"]:
                teile.append(f"{bericht['skipped']} ohne Fälligkeit übersprungen")
            if bericht["truncated"]:
                teile.append("abgeschnitten")
            hinweis.configure(text=" · ".join(teile), fg=self.theme["muted"])

        def ausgeben(oeffnen):
            key = gewaehlter_umfang()
            ziel = filedialog.asksaveasfilename(
                title="Kalenderdatei speichern", defaultextension=self.ICS_EXTENSION,
                initialfile=f"glide_{key}_{datetime.now().strftime('%Y-%m-%d')}{self.ICS_EXTENSION}",
                filetypes=[("Kalenderdatei", "*.ics"), ("Alle Dateien", "*.*")], parent=dialog,
            )
            if not ziel:
                return "break"
            try:
                pfad, bericht = self.write_ics_document(ziel, key, optionen())
            except Exception as fehler:
                hinweis.configure(text=str(fehler), fg=self.theme["delete"])
                return "break"
            self.record_data_operation("exported", pfad)
            dialog.destroy()
            if oeffnen:
                self.open_external_path(pfad)
            self.show_info("Kalenderdatei geschrieben", self.ics_summary(bericht, pfad))
            return "break"

        for var in variablen.values():
            var.trace_add("write", vorschau)
        auswahl.trace_add("write", vorschau)
        vorschau()
        footer = ButtonFlow(outer, bg=self.theme["bg"], gap=10)
        footer.pack(fill="x", pady=(18, 0))
        footer.add(self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted"))
        footer.add(self._make_dialog_button(footer, "Speichern", lambda: ausgeben(False), "export"))
        footer.add(self._make_dialog_button(footer, "Speichern und öffnen",
                                            lambda: ausgeben(True), "confirm", width=186))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=700)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return "break"

    # --- Kalenderimport (ICS lesen) -----------------------------------------

    @staticmethod
    def unescape_ics_text(value):
        """Textwert entschlüsseln – die Umkehrung von escape_ics_text."""
        text = str(value if value is not None else "")
        ergebnis = []
        index = 0
        while index < len(text):
            zeichen = text[index]
            if zeichen == "\\" and index + 1 < len(text):
                folge = text[index + 1]
                ergebnis.append({"n": "\n", "N": "\n"}.get(folge, folge))
                index += 2
                continue
            ergebnis.append(zeichen)
            index += 1
        return "".join(ergebnis)

    @classmethod
    def unfold_ics_lines(cls, text):
        """Gefaltete Zeilen zusammenfügen; CRLF, LF und BOM werden gelesen."""
        roh = str(text or "").lstrip("﻿").replace("\r\n", "\n").replace("\r", "\n")
        zeilen = []
        for zeile in roh.split("\n"):
            if zeile[:1] in (" ", "\t") and zeilen:
                zeilen[-1] += zeile[1:]
            elif zeile.strip() or zeilen:
                zeilen.append(zeile)
        return [zeile for zeile in zeilen if zeile.strip()]

    @classmethod
    def parse_ics_property(cls, line):
        """Eine Zeile in (Name, Parameter, Wert) zerlegen.

        Parameterwerte dürfen Doppelpunkte in Anführungszeichen enthalten;
        deshalb wird zeichenweise bis zum ersten freien Doppelpunkt gelesen.
        """
        in_quotes = False
        for index, zeichen in enumerate(line):
            if zeichen == '"':
                in_quotes = not in_quotes
            elif zeichen == ":" and not in_quotes:
                kopf, wert = line[:index], line[index + 1:]
                break
        else:
            return None, {}, ""
        teile = kopf.split(";")
        name = teile[0].strip().upper()
        parameter = {}
        for stueck in teile[1:]:
            if "=" in stueck:
                schluessel, roh = stueck.split("=", 1)
                parameter[schluessel.strip().upper()] = roh.strip().strip('"')
        return name, parameter, wert

    @classmethod
    def parse_ics_events(cls, text):
        """VEVENT-Blöcke als Liste von Eigenschaftslisten.

        Jeder Block ist eine Liste von (Name, Parameter, Wert); mehrfach
        vorkommende Eigenschaften bleiben erhalten. VALARM-Blöcke werden
        eingebettet als ("VALARM", {}, [Eigenschaften]) geführt.
        """
        ereignisse = []
        block = None
        alarm = None
        for zeile in cls.unfold_ics_lines(text):
            name, parameter, wert = cls.parse_ics_property(zeile)
            if name is None:
                continue
            marke = wert.strip().upper()
            if name == "BEGIN" and marke == "VEVENT":
                block = []
                continue
            if name == "END" and marke == "VEVENT":
                if block is not None:
                    ereignisse.append(block)
                block = None
                alarm = None
                continue
            if block is None:
                continue
            if name == "BEGIN" and marke == "VALARM":
                alarm = []
                continue
            if name == "END" and marke == "VALARM":
                if alarm is not None:
                    block.append(("VALARM", {}, alarm))
                alarm = None
                continue
            (alarm if alarm is not None else block).append((name, parameter, wert))
        return ereignisse

    @staticmethod
    def ics_property(block, name):
        for eintrag in block or ():
            if eintrag[0] == name:
                return eintrag
        return None

    @classmethod
    def parse_ics_moment(cls, parameter, wert):
        """Zeitangabe lesen: (Datum, Uhrzeit oder None, Hinweis oder None)."""
        text = str(wert or "").strip()
        if not text:
            return None, None, None
        hinweis = None
        if parameter.get("VALUE", "").upper() == "DATE" or (len(text) == 8 and text.isdigit()):
            try:
                tag = datetime.strptime(text[:8], "%Y%m%d").date()
            except ValueError:
                return None, None, None
            return tag.isoformat(), None, None
        roh = text.rstrip("Z")
        try:
            moment = datetime.strptime(roh[:15], "%Y%m%dT%H%M%S")
        except ValueError:
            try:
                moment = datetime.strptime(roh[:13], "%Y%m%dT%H%M")
            except ValueError:
                return None, None, None
        if text.endswith("Z"):
            # UTC in die Zone des Geräts holen.
            moment = moment.replace(tzinfo=timezone.utc).astimezone().replace(tzinfo=None)
        elif parameter.get("TZID"):
            # Die Zeitzonendatenbank der Standardbibliothek nutzen, wenn das
            # System sie mitbringt; sonst bleibt die Angabe Ortszeit.
            try:
                from zoneinfo import ZoneInfo  # stdlib; Datenbank kann fehlen
                zone = ZoneInfo(parameter["TZID"])
                moment = moment.replace(tzinfo=zone).astimezone().replace(tzinfo=None)
            except Exception:
                hinweis = "tzid"
        return moment.date().isoformat(), moment.strftime("%H:%M"), hinweis

    @classmethod
    def parse_ics_duration(cls, wert):
        """ISO-8601-Dauer in Minuten; None bei unlesbarem Wert."""
        text = str(wert or "").strip().upper()
        treffer = re.fullmatch(r"(-)?P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?", text)
        if not treffer or text in ("P", "PT"):
            return None
        vorzeichen = -1 if treffer.group(1) else 1
        wochen, tage, stunden, minuten, sekunden = (int(wert or 0) for wert in treffer.groups()[1:])
        gesamt = wochen * 10080 + tage * 1440 + stunden * 60 + minuten + (1 if sekunden >= 30 else 0)
        return vorzeichen * gesamt

    @classmethod
    def ics_repeat_from_rule(cls, wert):
        """RRULE auf eine Glide-Regel abbilden; None wenn nicht abbildbar.

        Bewusst streng: Was Glide nicht genauso wiederholen kann, wird
        verworfen. Eine still vereinfachte Regel wäre schlimmer als keine.
        """
        teile = {}
        for stueck in str(wert or "").split(";"):
            if "=" in stueck:
                schluessel, roh = stueck.split("=", 1)
                teile[schluessel.strip().upper()] = roh.strip().upper()
        freq = teile.get("FREQ")
        if not freq or "COUNT" in teile or "BYSETPOS" in teile or "BYMONTHDAY" in teile \
                or "BYMONTH" in teile or "BYWEEKNO" in teile or "BYYEARDAY" in teile:
            return None
        intervall = teile.get("INTERVAL", "1")
        if not intervall.isdigit() or int(intervall) < 1:
            return None
        intervall = int(intervall)
        tage = [cls.ICS_WEEKDAYS.index(kuerzel) for kuerzel in teile.get("BYDAY", "").split(",")
                if kuerzel in cls.ICS_WEEKDAYS] if teile.get("BYDAY") else []
        if teile.get("BYDAY") and len(tage) != len([k for k in teile["BYDAY"].split(",") if k]):
            return None  # etwa „2MO" – eine Position im Monat kennt Glide nicht
        if freq == "DAILY" and not tage:
            regel = {"art": cls.REPEAT_DAILY} if intervall == 1 else \
                {"art": cls.REPEAT_EVERY_N_DAYS, "abstand": intervall}
        elif freq == "WEEKLY" and intervall == 1:
            regel = {"art": cls.REPEAT_WEEKDAYS, "tage": tage} if tage else {"art": cls.REPEAT_WEEKLY}
        elif freq == "MONTHLY" and intervall == 1 and not tage:
            regel = {"art": cls.REPEAT_MONTHLY}
        elif freq == "YEARLY" and intervall == 1 and not tage:
            regel = {"art": cls.REPEAT_YEARLY}
        else:
            return None
        ende = teile.get("UNTIL")
        if ende:
            tag = cls.parse_ics_until(ende)
            if not tag:
                return None
            regel["ende"] = tag
        return regel

    @classmethod
    def parse_ics_until(cls, wert):
        """Enddatum einer RRULE als ISO-Datum; None bei unlesbarem Wert.

        Bewusst ohne Zeitzonenumrechnung, anders als bei DTSTART. UNTIL ist
        die Obergrenze einer Terminreihe, kein Zeitpunkt, den jemand abliest,
        und Glide merkt sich davon nur den Tag. Fremde Programme schreiben
        das Tagesende üblicherweise als „...T235959Z"; wer das als Zeitpunkt
        in Ortszeit holt, bekommt östlich von Greenwich den Folgetag und
        verlängert die Reihe um einen Tag – westlich verkürzt er sie. Der
        Kalendertag der Angabe selbst ist die stabile und gemeinte Lesart.
        """
        text = str(wert or "").strip()
        if not re.fullmatch(r"\d{8}(T\d{4,6}Z?)?", text):
            return None
        try:
            return datetime.strptime(text[:8], "%Y%m%d").date().isoformat()
        except ValueError:
            return None

    @classmethod
    def ics_importance_from_priority(cls, wert):
        text = str(wert or "").strip()
        if not text.isdigit():
            return 0
        zahl = int(text)
        if zahl == 0:
            return 0
        return 3 if zahl <= 4 else (2 if zahl == 5 else 1)

    def ics_import_default_options(self):
        return {key: True for key, _text in self.ICS_IMPORT_OPTION_LABELS}

    def read_ics_file(self, path):
        """Datei lesen und in Kalenderkopf plus Termine zerlegen."""
        groesse = os.path.getsize(path)
        if groesse > self.MAX_ICS_IMPORT_BYTES:
            raise ValueError(
                f"Die Datei ist {groesse / (1024 * 1024):.1f} MB groß. Der Import liest höchstens "
                f"{self.MAX_ICS_IMPORT_BYTES // (1024 * 1024)} MB."
            )
        with open(path, "rb") as datei:
            roh = datei.read()
        for kodierung in ("utf-8-sig", "utf-8", "cp1252"):
            try:
                text = roh.decode(kodierung)
                break
            except UnicodeDecodeError:
                continue
        else:
            text = roh.decode("latin-1")
        if "BEGIN:VCALENDAR" not in text.upper():
            raise ValueError("Die Datei enthält keinen Kalender (BEGIN:VCALENDAR fehlt).")
        ereignisse = self.parse_ics_events(text)
        if len(ereignisse) > self.MAX_ICS_IMPORT_EVENTS:
            raise ValueError(
                f"Die Datei enthält {len(ereignisse)} Termine. Der Import liest höchstens "
                f"{self.MAX_ICS_IMPORT_EVENTS}."
            )
        kopf = {"path": path, "name": "", "prodid": ""}
        for zeile in self.unfold_ics_lines(text):
            name, _parameter, wert = self.parse_ics_property(zeile)
            if name == "X-WR-CALNAME" and not kopf["name"]:
                kopf["name"] = self.unescape_ics_text(wert).strip()
            elif name == "PRODID" and not kopf["prodid"]:
                kopf["prodid"] = self.unescape_ics_text(wert).strip()
            elif name == "BEGIN" and wert.strip().upper() == "VEVENT":
                break
        if not ereignisse:
            raise ValueError("Die Datei enthält keine Termine (VEVENT).")
        return kopf, ereignisse

    def known_glide_item_ids(self):
        """Alle Punkt-IDs des Bestands – für die Duplikaterkennung."""
        return {item.get("id") for item in self.walk_items(
            [punkt for entry in self.lists for punkt in entry.get("items", [])])
            if isinstance(item, dict) and item.get("id")}

    def ics_events_to_items(self, ereignisse, options=None, zeitraum="all", dry_run=False):
        """Termine in Punkte umwandeln; liefert (Punkte, Bericht)."""
        options = options if isinstance(options, dict) else self.ics_import_default_options()
        bekannt = self.known_glide_item_ids()
        grenze = None
        if zeitraum == "today":
            grenze = date.today()
        elif zeitraum == "year":
            grenze = date.today() - timedelta(days=365)
        bericht = {"items": 0, "skipped": {}, "dropped": {}, "notes": []}

        def ueberspringe(grund):
            bericht["skipped"][grund] = bericht["skipped"].get(grund, 0) + 1

        def verwerfe(feld, hinweis):
            bericht["dropped"][feld] = bericht["dropped"].get(feld, 0) + 1
            if hinweis and len(bericht["notes"]) < 3 and hinweis not in bericht["notes"]:
                bericht["notes"].append(hinweis)

        punkte = []
        for block in ereignisse:
            if len(punkte) >= self.MAX_ICS_IMPORT_EVENTS:
                ueberspringe("limit")
                continue
            titel_eintrag = self.ics_property(block, "SUMMARY")
            titel = " ".join(self.unescape_ics_text(titel_eintrag[2]).split()) if titel_eintrag else ""
            start_eintrag = self.ics_property(block, "DTSTART")
            if not titel:
                ueberspringe("no_summary")
                continue
            if not start_eintrag:
                ueberspringe("no_start")
                continue
            status = self.ics_property(block, "STATUS")
            if options.get("skip_cancelled") and status and status[2].strip().upper() == "CANCELLED":
                ueberspringe("cancelled")
                continue
            tag, zeit, hinweis = self.parse_ics_moment(start_eintrag[1], start_eintrag[2])
            if not tag:
                ueberspringe("no_start")
                continue
            if hinweis == "tzid":
                verwerfe("tzid", "Zeitzone der Datei unbekannt – als Ortszeit gelesen")
            if grenze and datetime.fromisoformat(tag).date() < grenze:
                ueberspringe("out_of_range")
                continue
            uid_eintrag = self.ics_property(block, "UID")
            uid = uid_eintrag[2].strip() if uid_eintrag else ""
            treffer = re.fullmatch(r"glide-([0-9a-f]+)(?:-plan)?@" + re.escape(self.ICS_UID_DOMAIN), uid)
            if treffer and treffer.group(1) in bekannt:
                ueberspringe("duplicate")
                continue

            minuten = None
            if options.get("effort"):
                dauer_eintrag = self.ics_property(block, "DURATION")
                ende_eintrag = self.ics_property(block, "DTEND")
                if dauer_eintrag:
                    minuten = self.parse_ics_duration(dauer_eintrag[2])
                elif ende_eintrag and zeit:
                    ende_tag, ende_zeit, _hinweis = self.parse_ics_moment(ende_eintrag[1], ende_eintrag[2])
                    if ende_tag and ende_zeit:
                        abstand = datetime.fromisoformat(f"{ende_tag}T{ende_zeit}") - \
                            datetime.fromisoformat(f"{tag}T{zeit}")
                        minuten = int(abstand.total_seconds() // 60)
                if minuten is not None and not 1 <= minuten <= self.MAX_ESTIMATED_MINUTES:
                    minuten = None

            beschreibung = []
            if options.get("description"):
                eintrag = self.ics_property(block, "DESCRIPTION")
                if eintrag:
                    text = self.unescape_ics_text(eintrag[2]).strip()
                    if text:
                        beschreibung.append(text)
            if options.get("location"):
                eintrag = self.ics_property(block, "LOCATION")
                if eintrag:
                    ort = " ".join(self.unescape_ics_text(eintrag[2]).split())
                    if ort:
                        beschreibung.append("Ort: " + ort)

            regel = None
            regel_eintrag = self.ics_property(block, "RRULE")
            if regel_eintrag:
                regel = self.ics_repeat_from_rule(regel_eintrag[2])
                if regel is None:
                    verwerfe("rrule", "Wiederholungsregel nicht abbildbar – ohne Wiederholung angelegt")

            erinnerung = None
            if options.get("alarms"):
                for eintrag in block:
                    if eintrag[0] != "VALARM":
                        continue
                    trigger = self.ics_property(eintrag[2], "TRIGGER")
                    if not trigger:
                        continue
                    parameter, roh = trigger[1], trigger[2].strip()
                    if parameter.get("VALUE", "").upper() == "DATE-TIME" or roh.endswith("Z"):
                        alarm_tag, alarm_zeit, _hinweis = self.parse_ics_moment(parameter, roh)
                        if alarm_tag and alarm_zeit:
                            try:
                                erinnerung = {"mode": "fixed",
                                              "at": self.local_reminder_time(alarm_tag, alarm_zeit, strict=False)}
                            except (ValueError, OverflowError, OSError):
                                verwerfe("alarm", "Erinnerungszeitpunkt unlesbar")
                        else:
                            verwerfe("alarm", "Erinnerungszeitpunkt unlesbar")
                        break
                    if parameter.get("RELATED", "START").upper() != "START":
                        verwerfe("alarm", "Erinnerung bezog sich auf das Ende – verworfen")
                        break
                    minuten_vorher = self.parse_ics_duration(roh)
                    if minuten_vorher is None or minuten_vorher > 0:
                        verwerfe("alarm", "Erinnerung lag nach dem Beginn – verworfen")
                        break
                    erinnerung = {"mode": "relative", "minutes": min(abs(minuten_vorher), 525600)}
                    break

            label_ids = []
            if options.get("labels") and not dry_run:
                namen = []
                for eintrag in block:
                    if eintrag[0] != "CATEGORIES":
                        continue
                    namen.extend(self.unescape_ics_text(teil).strip()
                                 for teil in eintrag[2].split(",") if teil.strip())
                for name in namen[:self.MAX_LABELS_PER_ITEM]:
                    label = self.ensure_label_by_name(name)
                    if isinstance(label, dict) and label.get("id"):
                        label_ids.append(label["id"])

            prioritaet = self.ics_property(block, "PRIORITY")
            try:
                punkt = self.new_item(
                    titel,
                    due=tag,
                    due_time=zeit,
                    description="\n".join(beschreibung),
                    importance=self.ics_importance_from_priority(prioritaet[2] if prioritaet else ""),
                    labels=label_ids,
                    estimated_minutes=minuten,
                    repeat=regel,
                    reminder=erinnerung,
                )
            except ValueError as fehler:
                verwerfe("item", str(fehler))
                continue
            punkte.append(punkt)
            bericht["items"] += 1
        return punkte, bericht

    def ics_preview_text(self, ereignisse, options=None, zeitraum="all"):
        """Die ersten Termine so, wie Glide sie anlegen würde."""
        punkte, _bericht = self.ics_events_to_items(
            ereignisse[:self.ICS_PREVIEW_ROWS], options, zeitraum, dry_run=True)
        if not punkte:
            return "Mit diesen Einstellungen entsteht kein Punkt."
        zeilen = []
        for punkt in punkte:
            teile = [self.format_due_full(punkt.get("due"), punkt.get("due_time"))]
            if punkt.get("estimated_minutes"):
                teile.append(self.format_estimated_minutes(punkt["estimated_minutes"]))
            if punkt.get("importance"):
                teile.append(self.IMPORTANCE_NAMES.get(punkt["importance"], ""))
            if punkt.get("repeat"):
                teile.append(self.describe_repeat(punkt["repeat"]))
            if punkt.get("reminder"):
                teile.append("Erinnerung")
            if str(punkt.get("description") or "").strip():
                teile.append("mit Beschreibung")
            schwanz = " · ".join(teil for teil in teile if teil)
            zeilen.append(f"☐ {punkt.get('text')}   ({schwanz})" if schwanz else f"☐ {punkt.get('text')}")
        if len(ereignisse) > self.ICS_PREVIEW_ROWS:
            zeilen.append(f"… und {len(ereignisse) - self.ICS_PREVIEW_ROWS} weitere Termine")
        return "\n".join(zeilen)

    def import_ics_events(self, kopf, ereignisse, options=None, zeitraum="all", append_to_current=False):
        """Termine übernehmen – ein Schritt, vollständig zurücknehmbar."""
        self.sync_current_list_reference()
        self.snapshot_undo()
        labels_vorher = copy.deepcopy(self.labels)

        def zurueck():
            self.labels = labels_vorher
            if self.undo_stack:
                self.undo_stack.pop()

        try:
            punkte, bericht = self.ics_events_to_items(ereignisse, options, zeitraum)
        except Exception:
            zurueck()
            raise
        if not punkte:
            zurueck()
            return None, bericht
        if (append_to_current and self.view_mode in ("list", self.TABLE_VIEW)
                and self.list_accepts_items(self.current_list())):
            self.items.extend(punkte)
            ziel = self.current_list()
        else:
            titel = str(kopf.get("name") or "").strip()
            if not titel:
                titel = os.path.splitext(os.path.basename(kopf.get("path") or ""))[0]
            titel = " ".join(titel.replace("_", " ").split())[:80] or "Kalenderimport"
            ordner = self.active_folder_id if self.view_mode == "folder" else None
            ziel = self.new_list_object(titel, punkte, folder_id=ordner)
            self.lists.append(ziel)
        if not self.save_items():
            zurueck()
            raise ValueError("Der Bestand konnte nicht gespeichert werden; es wurde nichts übernommen.")
        if append_to_current and ziel is self.current_list():
            self.update_page_labels()
            self.refresh_tree(selected_id=punkte[-1]["id"])
        else:
            self.set_active_list(ziel["id"])
        return ziel, bericht

    def ics_import_summary(self, bericht, ziel=None):
        anzahl = bericht.get("items", 0)
        teile = [f"{anzahl} {'Punkt' if anzahl == 1 else 'Punkte'} übernommen"]
        if ziel is not None:
            teile[0] += f" in „{ziel.get('title', 'Liste')}“"
        for grund, zahl in sorted(bericht.get("skipped", {}).items()):
            teile.append(f"{zahl} × übersprungen ({self.ICS_SKIP_REASONS.get(grund, grund)})")
        if bericht.get("dropped"):
            gesamt = sum(bericht["dropped"].values())
            teile.append(f"{gesamt} Angabe(n) nicht übernommen")
        text = ".\n".join(teile) + "."
        if bericht.get("notes"):
            text += "\n\n" + "\n".join(bericht["notes"])
        return text

    def show_ics_import_dialog(self, event=None, path=None, append_to_current=None):
        """Kalenderdatei wählen, Vorschau prüfen, Termine übernehmen."""
        path = path or filedialog.askopenfilename(
            title="Kalenderdatei importieren",
            filetypes=[("Kalenderdatei", "*.ics"), ("Alle Dateien", "*.*")],
        )
        if not path:
            return "break"
        try:
            kopf, ereignisse = self.read_ics_file(path)
        except Exception as fehler:
            self.show_error("Kalenderimport", str(fehler))
            return "break"

        dialog = tk.Toplevel(self.root)
        dialog.title("Kalenderdatei importieren")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.resizable(True, True)
        fuss = tk.Frame(dialog, bg=self.theme["bg"])
        fuss.pack(side="bottom", fill="x", padx=self.DIALOG_PAD_X, pady=12)
        canvas = tk.Canvas(dialog, bg=self.theme["bg"], highlightthickness=0)
        scroll = ThemedAutoScrollbar(dialog, self.theme["bg"], self.theme["bg"],
                                     self.theme["input_border"], self.theme["muted"])
        scroll.set_command(canvas.yview)
        scroll.pack(side="right", fill="y")
        canvas.pack(side="top", fill="both", expand=True)
        canvas.configure(yscrollcommand=scroll.set)
        body = tk.Frame(canvas, bg=self.theme["bg"],
                        padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        fenster = canvas.create_window(0, 0, window=body, anchor="nw")
        body.bind("<Configure>", lambda _event: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda ereignis: canvas.itemconfigure(fenster, width=ereignis.width))
        self.bind_mousewheel(dialog, target=canvas)
        tk.Label(body, text="Kalenderdatei importieren", font=app_font(15, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        beschriftung = [os.path.basename(path), f"{len(ereignisse)} Termine"]
        if kopf.get("name"):
            beschriftung.insert(1, "Kalender: " + kopf["name"])
        if kopf.get("prodid"):
            beschriftung.append("Erzeuger: " + kopf["prodid"])
        tk.Label(body, text=" · ".join(beschriftung), font=app_font(10), bg=self.theme["bg"],
                 fg=self.theme["muted"], justify="left", wraplength=700, anchor="w").pack(anchor="w", pady=(4, 14))
        zeit_namen = dict(self.ICS_RANGE_CHOICES)
        zeit_var = tk.StringVar(value=zeit_namen["all"])
        self._make_field_label(body, "Zeitraum").pack(anchor="w", pady=(0, 5))
        zeit_feld, _knopf = self._make_option_menu(body, zeit_var,
                                                   [text for _key, text in self.ICS_RANGE_CHOICES])
        zeit_feld.pack(fill="x", pady=(0, 14))
        tk.Label(body, text="Übernehmen", font=app_font(11, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w", pady=(0, 6))
        vorgaben = self.ics_import_default_options()
        variablen = {}
        for key, text in self.ICS_IMPORT_OPTION_LABELS:
            variablen[key] = tk.BooleanVar(value=vorgaben[key])
            tk.Checkbutton(
                body, name="icsimp_" + key, text=text, variable=variablen[key],
                bg=self.theme["bg"], fg=self.theme["text"], selectcolor=self.theme["input"],
                activebackground=self.theme["bg"], activeforeground=self.theme["text"],
                anchor="w", justify="left", wraplength=700, font=app_font(10), highlightthickness=0,
            ).pack(fill="x", pady=2)
        liste_offen = self.view_mode in ("list", self.TABLE_VIEW)
        anhaengen_var = tk.BooleanVar(value=bool(append_to_current))
        tk.Checkbutton(
            body, name="icsimp_append",
            text=(f"An die geöffnete Liste „{self.app_title}“ anhängen (sonst als neue Liste)"
                  if liste_offen else "An die geöffnete Liste anhängen (keine Liste geöffnet)"),
            variable=anhaengen_var, state="normal" if liste_offen else "disabled",
            bg=self.theme["bg"], fg=self.theme["text"] if liste_offen else self.theme["muted"],
            selectcolor=self.theme["input"], activebackground=self.theme["bg"],
            activeforeground=self.theme["text"], anchor="w", font=app_font(10),
            highlightthickness=0, disabledforeground=self.theme["muted"],
        ).pack(fill="x", pady=(10, 14))
        tk.Label(body, text="Vorschau", font=app_font(11, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w", pady=(0, 6))
        vorschau = tk.Text(body, name="icsimp_preview", height=9, wrap="none", relief="flat",
                           bg=self.theme["input"], fg=self.theme["text"],
                           insertbackground=self.theme["text"], font=app_font(10),
                           highlightthickness=1, highlightbackground=self.theme["input_border"],
                           highlightcolor=self.theme["input_border"])
        vorschau.pack(fill="both", expand=True)
        hinweis = tk.Label(body, text="", bg=self.theme["bg"], fg=self.theme["muted"],
                           font=app_font(10), justify="left", wraplength=700, anchor="w")
        hinweis.pack(anchor="w", pady=(10, 0))

        def optionen():
            return {key: bool(var.get()) for key, var in variablen.items()}

        def zeitraum():
            return next(key for key, text in self.ICS_RANGE_CHOICES if text == zeit_var.get())

        def aktualisiere(*_args):
            vorschau.configure(state="normal")
            vorschau.delete("1.0", "end")
            vorschau.insert("1.0", self.ics_preview_text(ereignisse, optionen(), zeitraum()))
            vorschau.configure(state="disabled")
            _punkte, bericht = self.ics_events_to_items(ereignisse, optionen(), zeitraum(), dry_run=True)
            teile = [f"{bericht['items']} Punkt(e)"]
            for grund, zahl in sorted(bericht["skipped"].items()):
                teile.append(f"{zahl} × {self.ICS_SKIP_REASONS.get(grund, grund)}")
            hinweis.configure(text=" · ".join(teile))

        def importiere():
            try:
                ziel, bericht = self.import_ics_events(
                    kopf, ereignisse, optionen(), zeitraum(),
                    append_to_current=bool(anhaengen_var.get()) and liste_offen)
            except Exception as fehler:
                hinweis.configure(text=str(fehler), fg=self.theme["delete"])
                return "break"
            dialog.destroy()
            if ziel is None:
                self.show_warning("Kalenderimport", "Mit diesen Einstellungen entstand kein Punkt.\n"
                                                    + self.ics_import_summary(bericht))
            else:
                self.record_data_operation("imported", path)
                self.show_info("Import erfolgreich", self.ics_import_summary(bericht, ziel))
            return "break"

        for var in list(variablen.values()) + [zeit_var]:
            var.trace_add("write", aktualisiere)
        aktualisiere()
        flow = ButtonFlow(fuss, bg=self.theme["bg"], gap=10)
        flow.pack(fill="x")
        flow.add(self._make_dialog_button(flow, "Abbrechen", dialog.destroy, "muted"))
        flow.add(self._make_dialog_button(flow, "Importieren", importiere, "confirm"))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.minsize(700, 560)
        self._center_dialog(dialog, min_width=820, min_height=620)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return "break"

    def ics_import_into_list(self, list_id):
        """Kalenderimport in eine bestimmte Liste – sie wird zuerst geöffnet."""
        if not any(entry.get("id") == list_id for entry in self.lists):
            return "break"
        self.set_active_list(list_id)
        return self.show_ics_import_dialog(append_to_current=True)

    # --- Vollständiges App-Sicherung -------------------------------------------

    def app_backup_payload(self):
        """Aufgabenbackup plus Einstellungen, Vorlagen und Aktivitätsdaten.

        Der Zusatzabschnitt liegt neben den Aufgabenfeldern, nicht in ihnen:
        Ältere Glide-Fassungen lesen dieselbe Datei weiterhin als
        Aufgabenbackup und ignorieren, was sie nicht kennen.
        """
        payload = self.complete_backup_payload()
        settings = self.normalize_personal_settings(getattr(self, "settings", {}))
        activity = {key: copy.deepcopy(settings.get(key, {})) for key in self.APP_BACKUP_ACTIVITY_KEYS}
        for key in self.APP_BACKUP_ACTIVITY_KEYS:
            settings.pop(key, None)
        settings["theme"] = self.theme_name
        payload["app_backup"] = {
            "format_version": self.APP_BACKUP_FORMAT_VERSION,
            "settings": settings,
            "templates": {
                "format_version": self.TEMPLATE_FORMAT_VERSION,
                "templates": self.normalize_template_records(getattr(self, "templates", [])),
            },
            "activity": activity,
        }
        return payload

    def app_backup_section(self, data):
        """Zusatzabschnitt eines App-Sicherungs, streng geprüft."""
        if not isinstance(data, dict):
            return None
        section = data.get("app_backup")
        if not isinstance(section, dict):
            return None
        version = section.get("format_version")
        if not isinstance(version, int) or isinstance(version, bool) or not 1 <= version <= self.APP_BACKUP_FORMAT_VERSION:
            raise ValueError("Der Zusatzteil dieses App-Sicherungs stammt aus einer nicht unterstützten Fassung.")
        for key in ("settings", "templates", "activity"):
            value = section.get(key)
            if value is not None and not isinstance(value, dict):
                raise ValueError(f"Der Abschnitt „{key}“ im App-Sicherung ist ungültig.")
        templates = section.get("templates") or {}
        records = templates.get("templates", [])
        if not isinstance(records, list):
            raise ValueError("Der Vorlagenkatalog im App-Sicherung ist ungültig.")
        activity = section.get("activity") or {}
        for key in self.APP_BACKUP_ACTIVITY_KEYS:
            history = activity.get(key, {})
            if not isinstance(history, dict):
                raise ValueError("Die Aktivitätsdaten im App-Sicherung sind ungültig.")
        return section

    def describe_app_backup(self, data, section=None):
        """Zählwerte für die Inhaltsvorschau; verändert nichts am Bestand."""
        lists = data.get("lists", []) if isinstance(data, dict) else []
        folders = data.get("folders", []) if isinstance(data, dict) else []
        trash = data.get("trash", []) if isinstance(data, dict) else []
        tasks = structural = attachments = 0
        for entry in lists:
            if not isinstance(entry, dict):
                continue
            attachments += len(entry.get("attachments", []) or [])
            for item in self.walk_items(entry.get("items", []) or []):
                if self.is_schedulable_item(item):
                    tasks += 1
                else:
                    structural += 1
                attachments += len(item.get("attachments", []) or [])
        for folder in folders:
            if isinstance(folder, dict):
                attachments += len(folder.get("attachments", []) or [])
        section = section if section is not None else (data.get("app_backup") if isinstance(data, dict) else None)
        section = section if isinstance(section, dict) else {}
        settings = section.get("settings") or {}
        templates = (section.get("templates") or {}).get("templates", [])
        activity = section.get("activity") or {}
        activity_days = 0
        for key in self.APP_BACKUP_ACTIVITY_KEYS:
            history = activity.get(key)
            if isinstance(history, dict):
                activity_days = max(activity_days, len(history))
        return {
            "app_version": str(data.get("app_version") or "unbekannt") if isinstance(data, dict) else "unbekannt",
            "schema": data.get("version") if isinstance(data, dict) else None,
            "exported_at": str(data.get("exported_at") or "") if isinstance(data, dict) else "",
            "lists": len([entry for entry in lists if isinstance(entry, dict)]),
            "folders": len([entry for entry in folders if isinstance(entry, dict)]),
            "tasks": tasks,
            "structural": structural,
            "labels": len(data.get("labels", []) or []) if isinstance(data, dict) else 0,
            "trash": len([entry for entry in trash if isinstance(entry, dict)]),
            "attachments": attachments,
            "templates": len([entry for entry in templates if isinstance(entry, dict)]),
            "settings": len(settings) if isinstance(settings, dict) else 0,
            "activity_days": activity_days,
            "has_settings": bool(settings),
            "has_templates": bool(templates),
            "has_activity": activity_days > 0,
        }

    def format_app_backup_preview(self, summary):
        """Klartext der Inhaltsvorschau; nennt Herkunft, Menge und Grenzen."""
        stamp = summary.get("exported_at") or ""
        when = stamp.replace("T", " um ")[:19] if stamp else "ohne Zeitstempel"
        zeilen = [
            f"Erzeugt von Glide {summary['app_version']} · Datenformat {summary['schema']} · {when}",
            f"Aufgaben: {summary['tasks']} in {summary['lists']} Liste(n) und {summary['folders']} Ordner(n)",
            f"Zusätzlich: {summary['structural']} Gruppen/Überschriften · {summary['labels']} Labels · "
            f"{summary['trash']} Papierkorbeinträge · {summary['attachments']} Anhänge",
            f"Vorlagen im Archiv: {summary['templates']}",
            f"Persönliche Einstellungen: {'enthalten' if summary['has_settings'] else 'nicht enthalten'}",
            f"Aktivitätsdaten: {summary['activity_days']} erfasste Tage"
            if summary["has_activity"] else "Aktivitätsdaten: nicht enthalten",
        ]
        return "\n".join(zeilen)

    def export_app_backup(self):
        """Schreibt Aufgaben, Anhänge, Einstellungen, Vorlagen und Aktivität."""
        self.flush_rich_note()
        self.sync_current_list_reference()
        default_filename = f"glide_app_{datetime.now().strftime('%Y-%m-%d_%H-%M')}{self.APP_BACKUP_EXTENSION}"
        path = filedialog.asksaveasfilename(
            title="Vollständiges App-Sicherung speichern",
            defaultextension=self.APP_BACKUP_EXTENSION,
            initialfile=default_filename,
            filetypes=[("Glide-App-Sicherung", "*" + self.APP_BACKUP_EXTENSION),
                       ("Glide-Aufgabensicherung", "*.glidebackup"), ("Alle Dateien", "*.*")],
        )
        if not path:
            return
        try:
            payload = self.app_backup_payload()
            count = self.write_complete_backup(path, payload)
            summary = self.describe_app_backup(payload)
            self.record_data_operation("backup", path)
            self.show_info(
                "App-Sicherung erstellt",
                f"Gespeichert nach:\n{path}\n\n{self.format_app_backup_preview(summary)}\n\n"
                f"Enthaltene Anhangsdateien: {count}",
            )
            return True
        except Exception as exc:
            self.show_error("Fehler beim App-Sicherung", str(exc))

    def read_app_backup_file(self, path):
        """Liest Daten und Zusatzabschnitt eines Archivs ohne Änderung am Bestand."""
        if not zipfile.is_zipfile(path):
            raise ValueError("Ein App-Sicherung ist eine Archivdatei. Bitte eine "
                             f"{self.APP_BACKUP_EXTENSION}- oder .glidebackup-Datei wählen.")
        with zipfile.ZipFile(path, "r") as archive:
            data_info, _attachments = self.inspect_backup_archive(archive)
            raw = self.read_zip_member_limited(archive, data_info, self.MAX_BACKUP_DATA_BYTES)
        data = json.loads(raw.decode("utf-8"))
        self.validate_backup_schema(data, portable=True)
        section = self.app_backup_section(data)
        return data, section

    def restore_app_backup_extras(self, section, *, settings=False, templates=False,
                                  activity=False, with_tasks=False):
        """Übernimmt Einstellungen, Vorlagen und Aktivität aus einem App-Sicherung.

        Ohne die Aufgaben desselben Archivs werden Ansichtsverweise verworfen:
        Reiter, Pinnwände, Tagesauswahl, gespeicherte Filter und Spaltenlisten
        zeigen sonst auf Punkte, die es hier nicht gibt.
        """
        section = section if isinstance(section, dict) else {}
        angewendet = []
        os.makedirs(BACKUP_DIR, exist_ok=True)
        stempel = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        if settings or activity:
            vorher = copy.deepcopy(getattr(self, "settings", {}))
            vorher_theme = self.theme_name
            neu = copy.deepcopy(vorher)
            if settings:
                quelle = copy.deepcopy(section.get("settings") or {})
                for key in self.APP_BACKUP_ACTIVITY_KEYS:
                    quelle.pop(key, None)
                if not with_tasks:
                    for key in self.APP_BACKUP_REFERENCE_KEYS:
                        quelle.pop(key, None)
                neu.update(quelle)
            if activity:
                quelle = section.get("activity") or {}
                for key in self.APP_BACKUP_ACTIVITY_KEYS:
                    history = quelle.get(key)
                    if isinstance(history, dict):
                        neu[key] = copy.deepcopy(history)
            if os.path.isfile(SETTINGS_FILE):
                try:
                    shutil.copy2(SETTINGS_FILE, os.path.join(BACKUP_DIR, f"settings_vor_restore_{stempel}.json"))
                except OSError as exc:
                    raise OSError(f"Die Einstellungen konnten nicht gesichert werden: {exc}")
            self.settings = self.normalize_personal_settings(neu)
            if settings and isinstance(section.get("settings"), dict):
                gespeichertes_theme = section["settings"].get("theme")
                if gespeichertes_theme in ("light", "dark"):
                    self.theme_name = gespeichertes_theme
            if not self.save_settings(show_error=True):
                self.settings = vorher
                self.theme_name = vorher_theme
                raise OSError("Die Einstellungen konnten nicht geschrieben werden.")
            angewendet.append("Einstellungen" if settings else "Aktivitätsdaten")
            if settings and activity:
                angewendet[-1] = "Einstellungen und Aktivitätsdaten"
        if templates:
            vorher = copy.deepcopy(getattr(self, "templates", []))
            records = (section.get("templates") or {}).get("templates", [])
            if os.path.isfile(TEMPLATES_FILE):
                try:
                    shutil.copy2(TEMPLATES_FILE, os.path.join(BACKUP_DIR, f"vorlagen_vor_restore_{stempel}.json"))
                except OSError as exc:
                    raise OSError(f"Der Vorlagenkatalog konnte nicht gesichert werden: {exc}")
            self.templates = self.normalize_template_records(copy.deepcopy(records))
            if not self.save_templates():
                self.templates = vorher
                raise OSError("Der Vorlagenkatalog konnte nicht geschrieben werden.")
            angewendet.append("Vorlagenkatalog")
        return angewendet

    def restore_app_backup(self, path=None, sections=None, show_success=True):
        """Stellt gewählte Bereiche eines App-Sicherungs wieder her.

        Die Aufgaben laufen durch denselben geprüften Importpfad wie ein
        Aufgabensicherung, einschließlich Sicherung des vorherigen Stands. Die
        Zusatzbereiche folgen erst danach.
        """
        path = path or filedialog.askopenfilename(
            title="App-Sicherung wiederherstellen",
            filetypes=[("Glide-App-Sicherung", "*" + self.APP_BACKUP_EXTENSION),
                       ("Glide-Aufgabensicherung", "*.glidebackup"), ("Alle Dateien", "*.*")],
        )
        if not path:
            return
        try:
            data, section = self.read_app_backup_file(path)
        except (json.JSONDecodeError, UnicodeDecodeError):
            self.show_error("Fehler", "Die Datei ist kein gültiges Glide-Backup.")
            return
        except Exception as exc:
            self.show_error("Fehler beim Lesen", str(exc))
            return
        summary = self.describe_app_backup(data, section)
        if sections is None:
            sections = self.ask_app_backup_sections(summary, path)
            if not sections:
                return
        gewaehlt = {name: bool(sections.get(name)) for name in self.APP_BACKUP_SECTIONS}
        if not any(gewaehlt.values()):
            self.show_warning("App-Sicherung", "Es wurde kein Bereich zum Wiederherstellen ausgewählt.")
            return
        angewendet = []
        if gewaehlt["tasks"]:
            if not self.import_full_backup(path=path, show_success=False, confirm=False):
                return
            angewendet.append(f"{summary['tasks']} Aufgabe(n) in {summary['lists']} Liste(n)")
        try:
            angewendet += self.restore_app_backup_extras(
                section,
                settings=gewaehlt["settings"], templates=gewaehlt["templates"],
                activity=gewaehlt["activity"], with_tasks=gewaehlt["tasks"],
            )
        except Exception as exc:
            self.show_error("Fehler beim Wiederherstellen", str(exc))
            return
        if gewaehlt["settings"] or gewaehlt["activity"] or gewaehlt["templates"]:
            self._ui_font_family = None
            self._font_families = None
            self.apply_ui_font()
            self.apply_theme()
            self.update_header_title()
            self.update_sidebar_list()
            self.refresh_tree()
        if show_success:
            self.show_info("Wiederhergestellt", "Übernommen: " + ", ".join(angewendet) + ".")
        return True

    def ask_app_backup_sections(self, summary, path):
        """Inhaltsvorschau mit einzeln zuschaltbaren Bereichen."""
        dialog = tk.Toplevel(self.root)
        dialog.title("App-Sicherung wiederherstellen")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Das steckt in diesem Archiv", font=app_font(15, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        tk.Label(outer, text=os.path.basename(path), font=app_font(10),
                 bg=self.theme["bg"], fg=self.theme["muted"], justify="left",
                 wraplength=620, anchor="w").pack(anchor="w", pady=(2, 12))
        border, field = self._make_field(outer)
        border.pack(fill="x")
        field.pack(fill="x", padx=self.FIELD_BORDER_WIDTH, pady=self.FIELD_BORDER_WIDTH)
        tk.Label(field, name="app_backup_preview", text=self.format_app_backup_preview(summary),
                 font=app_font(10), bg=self.theme["input"], fg=self.theme["text"],
                 justify="left", anchor="w", wraplength=600).pack(fill="x", padx=10, pady=8)
        tk.Label(outer, text="Zu übernehmende Bereiche", font=app_font(11, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w", pady=(16, 6))
        verfuegbar = {
            "tasks": summary["lists"] > 0,
            "settings": summary["has_settings"],
            "templates": summary["has_templates"],
            "activity": summary["has_activity"],
        }
        beschriftung = {
            "tasks": "Aufgaben, Listen, Ordner, Labels, Papierkorb und Anhänge – ersetzt den vorhandenen Bestand",
            "settings": "Persönliche Einstellungen – ersetzt Profil, Darstellung und Ansichtsoptionen",
            "templates": "Vorlagenkatalog – ersetzt den vorhandenen Katalog",
            "activity": "Aktivitätsdaten – ersetzt die erfassten Tageswerte der Jahresanzeige",
        }
        variablen = {}
        for name in self.APP_BACKUP_SECTIONS:
            variablen[name] = tk.BooleanVar(value=verfuegbar[name])
            check = tk.Checkbutton(
                outer, name="section_" + name, text=beschriftung[name], variable=variablen[name],
                bg=self.theme["bg"], fg=self.theme["text"], selectcolor=self.theme["input"],
                activebackground=self.theme["bg"], activeforeground=self.theme["text"],
                anchor="w", justify="left", wraplength=620, font=app_font(10), highlightthickness=0,
            )
            check.pack(fill="x", pady=3)
            if not verfuegbar[name]:
                check.configure(state="disabled")
        tk.Label(outer, text="Vom aktuellen Stand wird vorher gesichert: Aufgaben als Aufgabensicherung im "
                 "Sicherungsordner, Einstellungen und Vorlagen als eigene Kopien. Ohne die Aufgaben dieses "
                 "Archivs werden Reiter, Pinnwände, Tagesauswahl, gespeicherte Filter und Tabellenspalten "
                 "nicht übernommen, weil sie auf dessen Punkte verweisen.",
                 bg=self.theme["bg"], fg=self.theme["muted"], font=app_font(9), justify="left",
                 wraplength=620, anchor="w").pack(anchor="w", pady=(12, 0))
        ergebnis = {"value": None}

        def submit(event=None):
            gewaehlt = {name: bool(variablen[name].get()) for name in self.APP_BACKUP_SECTIONS}
            if not any(gewaehlt.values()):
                self.show_warning("App-Sicherung", "Bitte mindestens einen Bereich auswählen.", parent=dialog)
                return "break"
            ergebnis["value"] = gewaehlt
            dialog.destroy()
            return "break"

        footer = ButtonFlow(outer, bg=self.theme["bg"], gap=10)
        footer.pack(fill="x", pady=(20, 0))
        footer.add(self._make_dialog_button(footer, "Abbrechen", dialog.destroy, "muted"))
        footer.add(self._make_dialog_button(footer, "Wiederherstellen", submit, "confirm"))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.bind("<Return>", submit)
        self._center_dialog(dialog, min_width=720)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return ergebnis["value"]

    def import_full_backup(self, additive=False, path=None, show_success=True, confirm=True, target_folder_id=None):
        """Ersetzt den Bestand erst nach vollständiger Prüfung und Sicherung."""
        if target_folder_id and (not additive or not self.get_folder(target_folder_id) or self.is_archived_folder(target_folder_id)):
            return None
        path = path or filedialog.askopenfilename(
            title="Listen/Ordner hinzufügen" if additive else "Aufgabensicherung laden (ersetzt alle Listen)",
            filetypes=[
                ("Glide-Aufgabensicherung", "*.glidebackup"),
                ("Frühere JSON-Backups", "*.json"),
                ("Alle Dateien", "*.*"),
            ],
        )
        if not path:
            return
        if not additive and confirm and not self.ask_yes_no(
            "Backup importieren",
            "Beim Import werden alle aktuell vorhandenen Listen ersetzt.\n\n"
            "Vom aktuellen Stand wird vorher automatisch ein vollständiges Sicherungsbackup angelegt.\n\n"
            "Fortfahren?",
        ):
            return

        archive = None
        staging_dir = None
        created_paths = []
        undo_size = len(self.undo_stack)
        committed = False
        try:
            is_portable = zipfile.is_zipfile(path)
            attachment_infos = {}
            if is_portable:
                archive = zipfile.ZipFile(path, "r")
                data_info, attachment_infos = self.inspect_backup_archive(archive)
                raw_json = self.read_zip_member_limited(archive, data_info, self.MAX_BACKUP_DATA_BYTES)
                data = json.loads(raw_json.decode("utf-8"))
            else:
                if os.path.getsize(path) > self.MAX_BACKUP_DATA_BYTES:
                    raise ValueError("Die JSON-Backupdatei ist zu groß.")
                with open(path, "rb") as file:
                    raw_json = file.read(self.MAX_BACKUP_DATA_BYTES + 1)
                if len(raw_json) > self.MAX_BACKUP_DATA_BYTES:
                    raise ValueError("Die JSON-Backupdatei ist zu groß.")
                data = json.loads(raw_json.decode("utf-8-sig"))

            referenced = self.validate_backup_schema(data, portable=is_portable)
            if is_portable and set(attachment_infos) != referenced:
                missing = sorted(referenced - set(attachment_infos))
                extra = sorted(set(attachment_infos) - referenced)
                details = []
                if missing:
                    details.append("fehlend: " + ", ".join(missing[:5]))
                if extra:
                    details.append("nicht referenziert: " + ", ".join(extra[:5]))
                raise ValueError("Die Anhänge im Backup sind unvollständig oder unerwartet (" + "; ".join(details) + ").")

            # normalize_lists_data setzt folders, labels und trash; der aktuelle
            # Zustand wird bis zum erfolgreichen Commit unverändert bewahrt.
            previous_folders = self.folders
            previous_labels = self.labels
            previous_trash = self.trash
            try:
                new_lists, active_from_file = self.normalize_lists_data(data)
                new_folders = self.folders
                new_labels = self.labels
                new_trash = self.trash
            finally:
                self.folders = previous_folders
                self.labels = previous_labels
                self.trash = previous_trash
            if not new_lists and not (additive and new_folders):
                raise ValueError("In der Datei wurden keine Listen gefunden.")
            if additive:
                raw_ids = {entry.get("id") for entry in data.get("lists", [])}
                new_lists = [entry for entry in new_lists if entry.get("id") in raw_ids]
                new_lists, new_folders, new_labels = self.prepare_additive_import(new_lists, new_folders, new_labels)
                glide_pages.place_roots(new_lists, new_folders, target_folder_id)
                zuordnung = getattr(self, "_additive_import_maps", None) or {}
                # Die Pinnwände der Datei ziehen mit den
                # neuen Kennungen um und treten neben die vorhandenen.
                neue_pinnwaende = self.pinboards_from_backup(
                    data, zuordnung.get("containers"), zuordnung.get("items"))
                new_trash = []
                active_from_file = new_lists[0]["id"] if new_lists else self.active_list_id
            else:
                new_lists = self.ensure_inbox_in_collection(new_lists)
                # Ein vollständiger Import ersetzt den Bestand – und damit auch
                # die Anordnung, die zu ihm gehört.
                neue_pinnwaende = self.pinboards_from_backup(data)

            storage_map = {}
            staged_files = {}
            if is_portable:
                storage_map = self.remap_import_attachments(new_lists, new_trash, new_folders)
                staging_dir = tempfile.TemporaryDirectory(prefix=".glide-import-", dir=BASE_DIR)
                total_written = 0
                for old_storage, new_storage in storage_map.items():
                    info = attachment_infos[old_storage]
                    staged_path = os.path.join(staging_dir.name, os.path.basename(new_storage))
                    written = self.copy_zip_member_limited(
                        archive, info, staged_path, self.MAX_BACKUP_ATTACHMENT_BYTES
                    )
                    total_written += written
                    if total_written > self.MAX_BACKUP_TOTAL_BYTES:
                        raise ValueError("Die extrahierten Anhänge überschreiten die zulässige Gesamtgröße.")
                    staged_files[new_storage] = staged_path
            elif referenced:
                missing_local = [
                    storage
                    for storage in referenced
                    if not os.path.isfile(self.resolve_attachment_path({"storage": storage}) or "")
                ]
                if missing_local:
                    raise ValueError(
                        "Dieses JSON verweist auf Anhänge, enthält die Dateien aber nicht. "
                        "Bitte stattdessen das zugehörige .glidebackup verwenden."
                    )

            # Der aktuelle Zustand muss speicherbar sein, bevor er als vollständige
            # Rückfallebene gesichert und anschließend ersetzt wird.
            if not self.save_items():
                return
            pre_import_path = os.path.join(
                BACKUP_DIR,
                f"vor_import_{datetime.now().strftime('%Y%m%d_%H%M%S_%f')}.glidebackup",
            )
            self.write_complete_backup(pre_import_path, self.complete_backup_payload())
            self.snapshot_undo()

            for new_storage, staged_path in staged_files.items():
                final_path = self.resolve_attachment_path({"storage": new_storage})
                if not final_path or os.path.exists(final_path):
                    raise OSError("Ein sicherer Zielpfad für einen importierten Anhang konnte nicht erstellt werden.")
                os.replace(staged_path, final_path)
                created_paths.append(final_path)

            imported_count = len(new_lists)
            if additive:
                new_lists = self.lists + new_lists
                new_folders = self.folders + new_folders
                new_trash = self.trash
            existing_ids = [entry.get("id") for entry in new_lists]
            preferred = active_from_file if active_from_file in existing_ids else new_lists[0]["id"]
            requested_folder_id = data.get("active_folder_id") if isinstance(data, dict) and not additive else None
            folder_ids = {folder.get("id") for folder in new_folders}
            requested_folder_id = requested_folder_id if requested_folder_id in folder_ids else None
            # Format 15: Ein vollständiger Import übernimmt den Verlauf des
            # Archivs; beim Hinzufügen bleibt der eigene Verlauf stehen, denn
            # er beschreibt diesen Bestand und nicht den fremden.
            new_history = (getattr(self, "history", []) or []) if additive else list(
                getattr(self, "_loaded_history", []) or [])
            imported_payload = {
                "version": self.DATA_SCHEMA_VERSION,
                "active_list_id": preferred,
                "active_folder_id": requested_folder_id,
                "folders": new_folders,
                "labels": new_labels,
                "lists": new_lists,
                "trash": new_trash,
                "history": new_history,
            }
            self.write_json_atomic(SAVE_FILE, imported_payload)
            committed = True

            self.lists = new_lists
            self.folders = new_folders
            self.labels = new_labels
            self.trash = new_trash
            self.history = new_history
            self.active_list_id = None
            self.active_folder_id = None
            self.items = []
            self.view_mode = "list"
            self.set_active_list(preferred, refresh=False)
            if requested_folder_id:
                self.set_active_folder(requested_folder_id, refresh=False)
            self.dirty = False
            if additive:
                # Der Vergleichsstand von vorher gilt weiter: Die neuen Listen
                # erscheinen dadurch als angelegt, statt den Bestand zu ersetzen.
                self._history_replacement = None
            else:
                self._history_baseline = None
                self._history_replacement = f"Backup {os.path.basename(path)}"
            self.save_items(show_error=False)
            # Erst nachdem die Aufgaben stehen, bekommen die
            # Pinnwände ihre Karten – vorher gäbe es nichts, worauf sie zeigen
            # könnten, und `prune` würde sie sofort wieder leeren.
            if neue_pinnwaende:
                vorhandene = self.settings.get("pinboards")
                self.settings["pinboards"] = ({**vorhandene, **neue_pinnwaende}
                                              if additive and isinstance(vorhandene, dict)
                                              else neue_pinnwaende)
                werkstatt = getattr(self, "workspace", None)
                if werkstatt is not None:
                    werkstatt.prune()
            self.update_sidebar_list()
            self.refresh_tree()
            self.save_settings()
            self.record_data_operation("imported", path)
            if show_success:
                self.show_info(
                    "Import erfolgreich",
                    f"{imported_count} Liste(n) {'hinzugefügt' if additive else 'importiert'}.\n\n"
                    f"Sicherung des vorherigen Stands:\n{pre_import_path}",
                )
            return True
        except (json.JSONDecodeError, UnicodeDecodeError):
            self.show_error("Fehler", "Die Datei ist kein gültiges Glide-Backup.")
        except Exception as e:
            if not committed:
                for created_path in reversed(created_paths):
                    try:
                        os.remove(created_path)
                    except OSError:
                        pass
                while len(self.undo_stack) > undo_size:
                    self.undo_stack.pop()
            self.show_error("Fehler beim Import", str(e))
        finally:
            if archive:
                archive.close()
            if staging_dir:
                staging_dir.cleanup()

    def sort_current_list(self, key="due"):
        """Sortiert die aktive Liste rekursiv nach Fälligkeit, Wichtigkeit oder Alphabet."""
        if not self.require_list_view():
            return
        if not self.items:
            return
        self.snapshot_undo()
        self._sort_items_recursive(self.items, key)
        self.save_items()
        self.refresh_tree()

    def _sort_items_recursive(self, items, key):
        if key == "due":
            def sort_key(it):
                iso = it.get("due")
                try:
                    parsed_date = datetime.strptime(iso, "%Y-%m-%d").date() if iso else None
                except ValueError:
                    parsed_date = None
                # Am selben Tag entscheidet die Uhrzeit. Ganztägige Punkte
                # stehen vorn, weil sie den ganzen Tag über offen sind.
                time_text = self.normalize_due_time(it.get("due_time")) or ""
                return (
                    1 if it.get("done") else 0,
                    parsed_date is None,
                    parsed_date or datetime.max.date(),
                    time_text or "00:00",
                )
            items.sort(key=sort_key)
        elif key == "importance":
            items.sort(key=lambda it: (1 if it.get("done") else 0, -self.clamp_importance(it.get("importance", 0))))
        elif key == "alpha":
            items.sort(key=lambda it: str(it.get("text", "")).lower())
        for it in items:
            self._sort_items_recursive(it.get("children", []), key)

    def import_from_txt(self):
        if not self.require_list_view():
            return
        path = filedialog.askopenfilename(
            title="Liste aus TXT laden",
            filetypes=[("Textdatei", "*.txt"), ("Alle Dateien", "*.*")],
        )
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8") as file:
                lines = file.readlines()

            # Der Schnappschuss entsteht vor dem Auswerten, weil beim Lesen der
            # Labelzeilen bereits neue Labels angelegt werden können. Rückgängig
            # nimmt dadurch auch diese Labels wieder zurück.
            self.snapshot_undo()
            labels_before_import = copy.deepcopy(self.labels)
            imported = self.parse_txt_items(lines)
            note = self.extract_txt_note(lines)
            if imported or note:
                self.items.extend(imported)
                if note:
                    current_note = str(self.current_list().get("note") or "").strip()
                    self.current_list()["note"] = (
                        f"{current_note}\n\n{note}" if current_note and note != current_note else note or current_note
                    )
                self.save_items()
                self.update_page_note_preview()
                self.update_page_labels()
                self.refresh_tree(selected_id=imported[-1]["id"] if imported else None)
                self.record_data_operation("imported", path)
                self.show_info(
                    "Import erfolgreich",
                    f"{self.count_items(imported)} Punkte und "
                    f"{'ein Beschreibungstext' if note else 'kein Beschreibungstext'} importiert.",
                )
            else:
                self.labels = labels_before_import
                if self.undo_stack:
                    self.undo_stack.pop()
                self.show_warning(
                    "Import",
                    "Die Datei enthält weder erkennbare Aufgaben noch einen Beschreibungstext.",
                )
        except Exception as e:
            self.show_error("Fehler beim Import", str(e))

    def parse_txt_items(self, lines):
        imported_root = []
        level_stack = {-1: imported_root}
        pattern = re.compile(r"^(?P<number>\d+(?:\.\d+)*)\.\s+(?P<text>.*)$")

        # Eigene Exporte beginnen mit Titel + Trennlinie. Den Kopf robust überspringen,
        # auch wenn der Listentitel vom aktuellen App-Titel abweicht.
        nonempty = [(idx, line.strip()) for idx, line in enumerate(lines) if line.strip()]
        skip_indices = set()
        if len(nonempty) >= 2 and nonempty[1][1] and set(nonempty[1][1]) <= {"="}:
            skip_indices.update({nonempty[0][0], nonempty[1][0]})

        inside_note_block = False
        last_item = None
        for line_index, raw_line in enumerate(lines):
            if line_index in skip_indices:
                continue
            stripped = raw_line.strip()
            if stripped == self.TXT_NOTE_BLOCK_START:
                inside_note_block = True
                continue
            if stripped == self.TXT_NOTE_BLOCK_END:
                inside_note_block = False
                continue
            if inside_note_block:
                continue
            if stripped.startswith(self.TXT_TEXT_CONTINUATION):
                # Fortsetzung eines mehrzeiligen Aufgabentexts: der Punkt wird
                # dadurch zum Langtext, denn nur der trägt Zeilenumbrüche.
                if last_item is not None:
                    text_line = stripped.split(":", 1)[1].lstrip()
                    previous = str(last_item.get("text") or "")
                    last_item["kind"] = self.ITEM_KIND_LONG
                    last_item["text"] = self.normalize_item_text(
                        f"{previous}\n{text_line}", self.ITEM_KIND_LONG
                    )
                    self.sync_item_kind_label(last_item)
                continue
            if stripped.startswith("Beschreibung:"):
                if last_item is not None:
                    description_line = stripped.split(":", 1)[1].lstrip()
                    previous = str(last_item.get("description") or "")
                    last_item["description"] = f"{previous}\n{description_line}".strip("\n")
                continue
            if stripped.startswith("Fällig:"):
                if last_item is not None:
                    # „30.09.2026“ oder „30.09.2026, 14:30“ – die Uhrzeit ist
                    # freiwillig und steht hinter dem Komma.
                    raw_due = stripped.split(":", 1)[1].strip()
                    raw_time = ""
                    if "," in raw_due:
                        raw_due, raw_time = (part.strip() for part in raw_due.split(",", 1))
                    parsed_due = self.parse_due_input(raw_due)
                    if parsed_due:
                        last_item["due"] = parsed_due
                        last_item["due_time"] = self.normalize_due_time(raw_time)
                continue
            if stripped.startswith(("Bearbeitungstag:", "Aufwand:")):
                if last_item is not None and self.is_schedulable_item(last_item):
                    name, raw = stripped.split(":", 1)
                    raw = raw.strip()
                    if name == "Bearbeitungstag":
                        parsed = self.parse_due_input(raw)
                        if parsed is None:
                            raise ValueError("Ungültiger Bearbeitungstag im TXT-Import.")
                        last_item.update(self.normalize_planning(parsed or None, last_item.get("estimated_minutes")))
                    else:
                        raw = raw.removesuffix(" min")
                        if len(raw) > 5 or not raw.isascii() or not raw.isdigit():
                            raise ValueError("Ungültiger Aufwand im TXT-Import.")
                        last_item.update(self.normalize_planning(last_item.get("planned_date"), int(raw)))
                continue
            if stripped.startswith("Wiederholung:"):
                # Der Klartext der Ausgabe wird wieder in eine Regel übersetzt.
                # Was sich nicht zuordnen lässt, wird stillschweigend verworfen:
                # Eine falsch geratene Regel erzeugte Termine, die niemand
                # gesetzt hat – schlimmer als gar keine Wiederholung.
                if last_item is not None and last_item.get("due"):
                    regel = self.parse_repeat_text(stripped.split(":", 1)[1])
                    if regel:
                        last_item["repeat"] = self.normalize_repeat(
                            regel, default_start=last_item.get("due")
                        )
                continue
            if stripped.startswith("Labels:"):
                # Labels werden über den Namen aufgelöst; unbekannte Namen legen
                # ein neues Label an, solange die Obergrenze das zulässt.
                if last_item is not None:
                    for name in stripped.split(":", 1)[1].split(","):
                        label = self.ensure_label_by_name(name)
                        if label is None:
                            continue
                        assigned = last_item.setdefault("labels", [])
                        if label["id"] not in assigned and len(assigned) < self.MAX_LABELS_PER_ITEM:
                            assigned.append(label["id"])
                continue
            if stripped.startswith("Anhang:"):
                # Textimporte transportieren nur den Namen, nicht die Binärdatei.
                continue
            if (
                not stripped
                or stripped == self.app_title
                or stripped.startswith("Meine Liste")
                or stripped.startswith("===")
                or stripped.startswith("Exportiert am:")
            ):
                continue

            done = False
            importance = 0
            kind = self.ITEM_KIND_TASK
            level = 0
            text = stripped
            match = pattern.match(stripped)
            if match:
                number = match.group("number")
                level = number.count(".")
                text = match.group("text").strip()
            elif ". " in stripped:
                # Abwärtskompatibilität für einfache alte Exporte.
                text = stripped.split(". ", 1)[1].strip()

            group_marker = next((marker.strip() for marker in
                (self.GROUP_MARKER, self.LEGACY_GROUP_MARKER)
                if text.startswith(marker.strip())), None)
            if group_marker:
                kind = self.ITEM_KIND_GROUP
                text = text[len(group_marker):].strip()
            elif text.startswith(self.HEADING_MARKER.strip()):
                kind = self.ITEM_KIND_HEADING
                text = text[len(self.HEADING_MARKER.strip()):].strip()
            elif text.startswith(self.LONG_MARKER.strip()):
                kind = self.ITEM_KIND_LONG
                text = text[len(self.LONG_MARKER.strip()):].strip()

            for marker, marker_importance in self.IMPORTANCE_PARSE_MARKERS:
                if text.startswith(marker):
                    importance = marker_importance
                    text = text[len(marker):].strip()
                    break

            if text.startswith("✓ "):
                done = True
                text = text[2:].strip()
            if text.startswith("✅ "):
                done = True
                text = text[2:].strip()

            if not text:
                continue

            new = self.new_item(text, done, importance=importance, kind=kind)
            parent_level = level - 1
            if parent_level not in level_stack:
                level = 0
                parent_level = -1

            level_stack[parent_level].append(new)
            level_stack[level] = new["children"]
            last_item = new

            # Tiefere Stack-Ebenen entfernen, damit folgende Zeilen sauber einsortiert werden.
            for stack_level in list(level_stack.keys()):
                if stack_level > level:
                    del level_stack[stack_level]

        return imported_root

    def ensure_label_by_name(self, name):
        """Vorhandenes Label mit diesem Namen oder ein neu angelegtes Label."""
        clean = str(name or "").strip()[: self.MAX_LABEL_NAME_LENGTH]
        if not clean:
            return None
        existing = self.get_label_by_name(clean)
        if existing is not None:
            return existing
        if len(self.labels) >= self.MAX_LABELS:
            return None
        # Die Farbe rotiert über die Palette, damit importierte Labels
        # unterscheidbar bleiben, ohne den Nutzer zu fragen.
        color = self.LABEL_COLOR_KEYS[len(self.labels) % len(self.LABEL_COLOR_KEYS)]
        label = self.new_label_object(clean, None, color)
        self.labels.append(label)
        return label

    def count_items(self, items, include_groups=False):
        """Zählt Punkte. Gruppen sind Behälter und zählen standardmäßig nicht mit."""
        total = 0
        for item in items:
            if include_groups or self.is_schedulable_item(item):
                total += 1
            total += self.count_items(item.get("children", []), include_groups)
        return total

