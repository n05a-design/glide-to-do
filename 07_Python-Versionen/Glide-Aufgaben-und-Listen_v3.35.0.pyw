    def _attach_field_scrollbar(self, field, widget, pad_y=None):
        """Hängt eine themenkonforme Bildlaufleiste rechts an ein Dialogfeld.

        Ohne sie ist längerer Inhalt zwar mit Rad und Tastatur erreichbar, aber
        nicht als solcher erkennbar. Der Balken wird vor dem Widget gepackt,
        damit er seine Breite behält, wenn der Text die Fläche füllt.
        """
        bar = ThemedAutoScrollbar(
            field,
            bg_color=self.theme["input"],
            track_color=self.theme["input"],
            thumb_color=self.theme["input_border"],
            active_thumb_color=self.theme["muted"],
            width=10,
            radius=5,
        )
        # Eine tk.Canvas fordert ohne Angabe rund 260 Pixel Höhe an und würde
        # das Feld auseinanderziehen. Sie soll die Höhe des Textfelds
        # übernehmen, nicht bestimmen.
        bar.configure(height=1)
        bar.pack(
            side="right",
            fill="y",
            padx=(0, 6),
            pady=self.FIELD_PAD_Y if pad_y is None else pad_y,
        )
        bar.set_command(widget.yview)
        try:
            widget.configure(yscrollcommand=bar.set)
        except tk.TclError:
            pass
        self.bind_mousewheel(widget)
        return bar

    def _make_scroll_area(self, field, height=200):
        """Scrollbare Fläche für Chip-Listen innerhalb eines Dialogfelds.

        Liefert (canvas, inner): in `inner` werden Zeilen gepackt, der Canvas
        übernimmt Bildlauf und Mausrad. Eine reine `tk.Listbox` käme hier nicht
        infrage – sie kann nur Text darstellen, keine eingefärbten Flächen.
        """
        canvas = tk.Canvas(
            field,
            bg=self.theme["input"],
            highlightthickness=0,
            bd=0,
            height=height,
        )
        bar = ThemedAutoScrollbar(
            field,
            bg_color=self.theme["input"],
            track_color=self.theme["input"],
            thumb_color=self.theme["input_border"],
            active_thumb_color=self.theme["muted"],
            width=10,
            radius=5,
        )
        bar.configure(height=1)
        bar.pack(side="right", fill="y", padx=(0, 6), pady=self.FIELD_PAD_Y)
        canvas.pack(side="left", fill="both", expand=True, padx=(self.FIELD_PAD_X, 0),
                    pady=self.FIELD_PAD_Y)
        bar.set_command(canvas.yview)
        canvas.configure(yscrollcommand=bar.set)
        inner = tk.Frame(canvas, bg=self.theme["input"])
        window = canvas.create_window((0, 0), window=inner, anchor="nw")

        def sync(_event=None):
            try:
                canvas.configure(scrollregion=canvas.bbox("all"))
                canvas.itemconfigure(window, width=canvas.winfo_width())
            except tk.TclError:
                pass

        inner.bind("<Configure>", sync)
        canvas.bind("<Configure>", sync)
        self.bind_mousewheel(canvas)
        return canvas, inner


    MONTHS_DE = ["Januar", "Februar", "März", "April", "Mai", "Juni",
                 "Juli", "August", "September", "Oktober", "November", "Dezember"]
    WEEKDAYS_DE = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]

    # `themed_date_picker` ist mit 2.11.0 entfallen. Datum und Uhrzeit
    # setzt jetzt `DueField`, damit Anlegen, Bearbeiten und das Menü
    # „Fälligkeit“ dieselbe Auswahl zeigen – siehe `themed_due_dialog`.

    # -----------------------------
    # Kalenderansicht
    # -----------------------------
    def calendar_week_start(self, reference=None):
        """Montag der Woche, in der das Referenzdatum liegt."""
        day = reference or date.today()
        first = 6 if self.settings.get("week_start") == "sunday" else 0
        return day - timedelta(days=(day.weekday() - first) % 7)

    def calendar_month_grid(self, year, month):
        """Erster und letzter Tag des montagsausgerichteten Rasters eines Monats.

        Das Raster beginnt am Montag der Woche, in der der Monatserste liegt,
        und endet am Sonntag der Woche des Monatsletzten. Für September 2026
        ergibt das genau fünf Wochen vom 31.08. bis zum 04.10.
        """
        first_of_month = date(year, month, 1)
        last_day_number = calendar.monthrange(year, month)[1]
        last_of_month = date(year, month, last_day_number)
        first_day = self.calendar_week_start(first_of_month)
        last_day = self.calendar_week_start(last_of_month) + timedelta(days=6)
        return first_day, last_day

    @staticmethod
    def shift_month(year, month, delta):
        index = (year * 12 + month - 1) + delta
        return index // 12, index % 12 + 1

    def collect_due_tasks_by_date(self, first_day, last_day):
        """Alle Aufgaben mit Fälligkeit im Zeitraum, gruppiert nach Tag.

        Rückgabe: {date: [(Aufgabe, Quellliste), …]} – sortiert nach Wichtigkeit
        (absteigend) und Titel, damit die Tageszelle stabil bleibt.
        """
        buckets = {}
        for entry in self.planning_lists():
            for item in self.walk_items(entry.get("items", [])):
                if not self.is_schedulable_item(item):
                    continue
                iso_value = self.normalize_due(item.get("due"))
                if not iso_value:
                    continue
                try:
                    due_date = date.fromisoformat(iso_value)
                except ValueError:
                    continue
                if due_date < first_day or due_date > last_day:
                    continue
                buckets.setdefault(due_date, []).append((item, entry))
        for tasks in buckets.values():
            tasks.sort(
                key=lambda pair: (
                    1 if pair[0].get("done") else 0,
                    -self.clamp_importance(pair[0].get("importance", 0)),
                    str(pair[0].get("text", "")).lower(),
                )
            )
        return buckets

    def object_graph(self):
        index, outgoing, incoming = glide_objects.graph(self.lists, self.trash)
        for key, (state, holder, entry) in list(index.items()):
            if state != 'trash' and entry and self.is_archived_entry(entry):
                index[key] = ('archived', holder, entry)
        return index, outgoing, incoming

    def current_object_key(self):
        if self.view_mode == self.HOME_VIEW and self.home_mode() == 'calendar':
            pool = getattr(self, '_calendar_pool', None)
            selected = pool.selection() if pool and pool.winfo_exists() else ()
            return ('item', selected[-1]) if selected else None
        selected = self.selected_items_for_change(warn=False, view_message=False)
        if selected:
            return ('item', selected[-1])
        if any(entry['id'] == self.active_list_id for entry in self.lists):
            return ('list', self.active_list_id)
        return None

    def object_reference_choices(self, source=None):
        index, _, _ = self.object_graph()
        choices = []
        for key, (state, holder, entry) in index.items():
            if state != 'active' or key == source or (key[0] == 'item' and not self.is_schedulable_item(holder)):
                continue
            try:
                value = glide_objects.uri(*key)
            except ValueError:
                continue
            kind = 'Aufgabe' if key[0] == 'item' else self.LIST_KINDS.get(holder.get('list_kind'), {}).get('label', 'Liste')
            label = kind + ' · ' + glide_objects.caption(key, index)[1]
            if entry and entry.get('folder_id'):
                label += ' · ' + self.list_path_title(entry)
            choices.append((value, label))
        return sorted(choices, key=lambda pair: pair[1].casefold())

    def open_object_reference(self, value):
        key = glide_objects.parse(value)
        index, _, _ = self.object_graph()
        state, label = glide_objects.caption(key, index) if key else ('missing', 'Ungültiger Verweis')
        if state in ('missing', 'trash'):
            self.show_warning('Verweis', label)
            return False
        _, _, entry = index[key]
        if key[0] == 'list':
            self.set_active_list(key[1])
            return True
        return self.open_task_in_source_list(entry['id'], key[1])

    def change_object_reference(self, source, value=None, remove=False):
        index, _, _ = self.object_graph()
        if getattr(self, '_data_read_only', False) or source not in index or index[source][0] != 'active':
            return False
        if value is None:
            value = self.themed_choice_dialog('Verknüpfen', 'Seite, Liste oder Aufgabe auswählen:',
                                             self.object_reference_choices(source))
        if value is None:
            return False
        target = glide_objects.parse(value)
        index, _, _ = self.object_graph()
        if source not in index or index[source][0] != 'active' or target is None:
            return False
        if not remove and (target == source or target not in index or index[target][0] != 'active'):
            self.show_warning('Verweis', 'Das Ziel ist inzwischen nicht mehr verfügbar.')
            return False
        value = glide_objects.uri(*target)
        holder = index[source][1]
        old = list(holder.get('references', []))
        if not remove and len(old) >= 200 and value not in old:
            self.show_warning('Verweis', 'Maximal 200 Verweise je Objekt.')
            return False
        new = [entry for entry in old if entry != value] if remove else glide_objects.normalize(old + [value])
        if new == old:
            return False
        before = copy.deepcopy(self.lists)
        manager = self.item_change([source[1]], local=True) if source[0] == 'item' else self.sidebar_change(refresh_tree=True)
        with manager as change:
            holder['references'] = new
            change.mark()
        if not change.saved:
            self.lists = before
            self.sync_current_list_reference()
            self.refresh_tree(); self.update_sidebar_list()
            if self.undo_stack:
                self.undo_stack.pop()
            return False
        return True

    def build_object_reference_menu(self, source, parent=None):
        menu = self._new_themed_popup_menu(parent or self.root)
        index, outgoing, incoming = self.object_graph()
        if source not in index:
            menu.add_command(label='Kein Objekt ausgewählt', state='disabled')
            return menu
        if index[source][0] == 'active':
            menu.add_command(label='Verknüpfen …', command=lambda: self.change_object_reference(source))
        for label, keys in [('Verweise', outgoing.get(source, set())), ('Rückverweise', incoming.get(source, set()))]:
            sub = self._new_themed_popup_menu(menu)
            for key in sorted(keys, key=lambda key: glide_objects.caption(key, index)[1].casefold()):
                state, title = glide_objects.caption(key, index)
                sub.add_command(label=title, state='disabled' if state in ('trash', 'missing') else 'normal',
                                command=lambda target=key: self.open_object_reference(glide_objects.uri(*target)))
            if not keys:
                sub.add_command(label='Keine', state='disabled')
            menu.add_cascade(label=f'{label} ({len(keys)})', menu=sub)
        explicit = index[source][1].get('references', [])
        if explicit and index[source][0] == 'active':
            remove = self._new_themed_popup_menu(menu)
            for value in explicit:
                remove.add_command(label=glide_objects.caption(glide_objects.parse(value), index)[1],
                                   command=lambda value=value: self.change_object_reference(source, value, remove=True))
            menu.add_cascade(label='Verweis entfernen', menu=remove)
        return menu

    def show_object_references(self, event=None):
        source = self.current_object_key()
        menu = self.build_object_reference_menu(source)
        self._popup_at_widget(menu, self.search_button)
        return 'break'

    def open_calendar_view(self, event=None):
        self._calendar_anchor = getattr(self, '_calendar_anchor', date.today())
        self._calendar_mode = getattr(self, '_calendar_mode', 'week')
        self._calendar_selected_day = getattr(self, '_calendar_selected_day', date.today().isoformat())
        self._open_home_mode('calendar')
        return 'break'

    def calendar_change_view(self, offset=0, mode=None, today=False):
        anchor = getattr(self, '_calendar_anchor', date.today())
        current = mode or getattr(self, '_calendar_mode', 'week')
        if today:
            anchor = date.today()
        elif current == 'week':
            anchor += timedelta(days=7 * offset)
        else:
            month = anchor.year * 12 + anchor.month - 1 + offset
            anchor = date(month // 12, month % 12 + 1, 1)
        self._calendar_anchor, self._calendar_mode = anchor, current
        self.refresh_home()

    def calendar_choose_day(self, day):
        changed = day != getattr(self, '_calendar_selected_day', None)
        self._calendar_selected_day = day
        for value, cell in getattr(self, '_calendar_day_cells', {}).items():
            if cell.winfo_exists():
                cell.configure(highlightbackground=self.theme['accent'] if value == day else self.theme['line'],
                               highlightthickness=2 if value == day else 1)
        status = getattr(self, '_calendar_status', None)
        if status and status.winfo_exists():
            status.configure(text='Bearbeitungstag: ' + self.format_due_display(day) + ' · Fälligkeit bleibt erhalten')
        if changed:
            self.refresh_page_actions(self.calendar_footer_actions())

    def calendar_footer_actions(self):
        day = self.format_due_display(self._calendar_selected_day)
        return (('Einplanen · ' + day, self.calendar_plan_selection, 'accent', 190),
                ('Freies Zeitfenster …', self.calendar_free_slot, 'muted', 190),
                ('Zur Startseite', self.set_home_view, 'muted', 150))

    def calendar_plan_selection(self, item_ids=None, day=None):
        if item_ids is None:
            tree = getattr(self, '_calendar_pool', None)
            item_ids = list(tree.selection()) if tree and tree.winfo_exists() else []
        day = day or getattr(self, '_calendar_selected_day', date.today().isoformat())
        if getattr(self, '_data_read_only', False):
            return 0
        old_lists = copy.deepcopy(self.lists)
        undo_count = len(self.undo_stack)
        allowed = {item['id'] for entry in self.planning_lists() for item in self.walk_items(entry.get('items', []))}
        count = self.apply_quick_plan([identity for identity in item_ids if identity in allowed], day)
        if not count and self.lists != old_lists:
            self.lists = old_lists
            self.sync_current_list_reference(); self.refresh_tree()
            del self.undo_stack[undo_count:]
        if count:
            self.refresh_home()
        return count

    def calendar_stop_drag_scroll(self):
        job = getattr(self, '_calendar_drag_job', None)
        if job:
            try:
                self.root.after_cancel(job)
            except tk.TclError:
                pass
            self._after_ids.discard(job)
        self._calendar_drag_job = None

    def calendar_drag_start(self, event, item_ids=None):
        self.calendar_stop_drag_scroll()
        self._calendar_drag_target = None
        self._calendar_drag = dict(ids=list(item_ids or getattr(self, '_calendar_pool').selection()),
                                   x=event.x_root, y=event.y_root, moved=False)

    def calendar_drag_motion(self, event, scroll=True):
        self.calendar_stop_drag_scroll()
        drag = getattr(self, '_calendar_drag', None)
        if not drag:
            return
        drag['moved'] |= abs(event.x_root - drag['x']) + abs(event.y_root - drag['y']) >= 6
        self._calendar_drag_target = None
        if not drag['moved']:
            return
        canvas = self.home_canvas
        left, top = canvas.winfo_rootx(), canvas.winfo_rooty()
        right, bottom = left + canvas.winfo_width(), top + canvas.winfo_height()
        if not (left <= event.x_root < right and top <= event.y_root < bottom):
            return
        first, last = canvas.yview()
        direction = -1 if event.y_root < top + 24 and first > 0 else 1 if event.y_root > bottom - 24 and last < 1 else 0
        if scroll and direction:
            canvas.yview_scroll(direction, 'units')
            x, y = event.x_root, event.y_root
            def again():
                self._after_ids.discard(self._calendar_drag_job)
                self._calendar_drag_job = None
                if self.view_mode == self.HOME_VIEW and self.home_mode() == 'calendar' and self._calendar_drag:
                    self.calendar_drag_motion(types.SimpleNamespace(x_root=x, y_root=y))
            self._calendar_drag_job = self._register_after(self.root.after(60, again))
            return
        for day, cell in getattr(self, '_calendar_day_cells', {}).items():
            if cell.winfo_exists() and (cell.winfo_rootx() <= event.x_root < cell.winfo_rootx() + cell.winfo_width()
                    and cell.winfo_rooty() <= event.y_root < cell.winfo_rooty() + cell.winfo_height()):
                self.calendar_choose_day(day)
                self._calendar_drag_target = day
                return

    def calendar_drag_end(self, event):
        drag = getattr(self, '_calendar_drag', None)
        if drag and drag['moved']:
            self.calendar_drag_motion(event, scroll=False)
        target = getattr(self, '_calendar_drag_target', None)
        self.calendar_stop_drag_scroll()
        self._calendar_drag = self._calendar_drag_target = None
        if drag and drag['moved'] and target:
            return self.calendar_plan_selection(drag['ids'], target)
        return 0

    def calendar_free_slot(self):
        if getattr(self, '_data_read_only', False):
            return False
        tree = getattr(self, '_calendar_pool', None)
        selected = list(tree.selection()) if tree and tree.winfo_exists() else []
        if len(selected) != 1:
            self.show_warning('Zeitfenster', 'Eine Aufgabe aus der Planungsauswahl markieren.')
            return False
        identity = selected[0]
        found = self.find_item_in_lists(identity)
        duration = found[0].get('estimated_minutes') if found else None
        if not duration:
            self.show_warning('Zeitfenster', 'Zuerst den Aufwand der Aufgabe schätzen. Ohne Schätzung gibt es keinen Zeitvorschlag.')
            return False
        day = self._calendar_selected_day
        items = [item for entry in self.planning_lists() for item in self.walk_items(entry.get('items', [])) if item['id'] != identity]
        slots = glide_week.free_slots(items, day, duration)
        clock = self.themed_choice_dialog('Freie Zeitfenster',
            '08:00–18:00 · nur Glide-Zeitblöcke mit Schätzung belegen Zeit.\n'
            'Externe Termine und Aufgaben ohne Schätzung sind nicht berücksichtigt.\n'
            f'{self.format_due_display(day)} · {duration} Minuten · Auswählen plant die Aufgabe ein.',
            [(start, f'{start}–{end} · Vorschlag: {start} für {duration} Minuten') for start, end in slots])
        if clock is None:
            return False
        # Die modale Vorschau darf keine veraltete Belegung überschreiben.
        found = self.find_item_in_lists(identity)
        active_ids = {item['id'] for entry in self.planning_lists() for item in self.walk_items(entry.get('items', []))}
        current_items = [item for entry in self.planning_lists() for item in self.walk_items(entry.get('items', [])) if item['id'] != identity]
        current_slots = glide_week.free_slots(current_items, day, duration)
        if not found or identity not in active_ids or found[0].get('done') or found[0].get('estimated_minutes') != duration or (clock, next((end for start,end in slots if start == clock), '')) not in current_slots:
            self.show_warning('Zeitfenster', 'Die Planung hat sich geändert. Bitte den Vorschlag neu öffnen.')
            return False
        item = found[0]
        previous = (item.get('planned_date'), item.get('planned_time'))
        with self.item_change([identity], local=True) as change:
            item['planned_date'], item['planned_time'] = day, clock
            change.mark()
        if not change.saved:
            item['planned_date'], item['planned_time'] = previous
            if self.undo_stack:
                self.undo_stack.pop()
            self.refresh_tree()
            return False
        self.refresh_home()
        return True

    def calendar_open_week_review(self):
        first = self.week_days(reference=self._calendar_anchor)[0]
        base = self.week_days()[0]
        self.show_week_review(offset=(first - base).days // 7)

    def calendar_from_week_review(self):
        self._calendar_anchor = self.week_days(getattr(self, '_week_offset', 0))[0]
        self._calendar_mode = 'week'
        self.open_calendar_view()

    def render_calendar(self):
        self.calendar_stop_drag_scroll()
        self._calendar_drag = None
        theme = self.theme
        anchor = getattr(self, '_calendar_anchor', date.today())
        mode = getattr(self, '_calendar_mode', 'week')
        week = glide_week.days(anchor, self.settings.get('week_start', 'monday'))
        first, last = self.calendar_month_grid(anchor.year, anchor.month)
        dates = week if mode == 'week' else [first + timedelta(days=n) for n in range((last-first).days + 1)]
        entries = [(entry, item) for entry in self.planning_lists() for item in self.walk_items(entry.get('items', [])) if self.is_schedulable_item(item)]
        items = [item for _, item in entries]
        buckets = glide_week.calendar_buckets(entries, dates, self.normalize_due)
        moon_events = calendar_moon_phases(dates[0], dates[-1])
        self._calendar_summaries = glide_week.summarize(items, dates, self.settings, self.is_schedulable_item)
        self._calendar_day_cells = {}
        self._calendar_task_widgets = {}
        panel = tk.Frame(self.home_content, bg=theme['bg'])
        panel.pack(fill='x')

        def label(parent, value, size=10, bold=False, color='text', surface='bg'):
            widget = tk.Label(parent, text=value, bg=theme[surface], fg=theme[color], justify='left',
                              anchor='w', font=app_font(size, 'bold' if bold else 'normal'))
            widget.pack(fill='x', pady=(0, 5))
            def wrap(event, target=widget):
                width = max(100, event.width - 8)
                if int(target.cget('wraplength')) != width:
                    target.configure(wraplength=width)
            widget.bind('<Configure>', wrap)
            return widget

        title = f'{week[0]:%d.%m.}–{week[-1]:%d.%m.%Y}' if mode == 'week' else f'{self.MONTH_NAMES[anchor.month-1]} {anchor.year}'
        label(panel, title, 15, True)
        nav = ButtonFlow(panel, bg=theme['bg']); nav.pack(fill='x', pady=(0, 10))
        for text, command in [('Vorherige', lambda: self.calendar_change_view(-1)), ('Heute', lambda: self.calendar_change_view(today=True)),
                              ('Nächste', lambda: self.calendar_change_view(1)), ('Woche', lambda: self.calendar_change_view(mode='week')),
                              ('Monat', lambda: self.calendar_change_view(mode='month')), ('Wochenrückblick', self.calendar_open_week_review)]:
            nav.add(self._make_dialog_button(nav, text, command, 'muted', width=130, height=32))
        self._calendar_status = label(panel, 'Bearbeitungstag: ' + self.format_due_display(getattr(self, '_calendar_selected_day', date.today().isoformat())) + ' · Fälligkeit bleibt erhalten', 9, color='muted')
        days_panel = tk.Frame(panel, bg=theme['bg']); days_panel.pack(fill='x', pady=(0, 12))
        if mode == 'month':
            for column in range(7):
                days_panel.columnconfigure(column, weight=1, uniform='calendar')
                tk.Label(days_panel, text=self.WEEKDAY_NAMES[dates[column].weekday()][:2], bg=theme['bg'],
                         fg=theme['muted'], font=app_font(9, 'bold')).grid(row=0, column=column, sticky='ew')
        for number, day in enumerate(dates):
            iso = day.isoformat()
            card = tk.Frame(days_panel, bg=theme['card'], highlightbackground=theme['line'], highlightthickness=1)
            self._calendar_day_cells[iso] = card
            if iso == self._calendar_selected_day:
                card.configure(highlightbackground=theme['accent'], highlightthickness=2)
            if mode == 'week':
                card.pack(fill='x', pady=(0, 6))
            else:
                card.grid(row=1+number//7, column=number%7, sticky='nsew', padx=2, pady=2)
            header = tk.Frame(card, bg=theme['card']); header.pack(fill='x', padx=8, pady=(6, 2))
            day_label = f'{self.WEEKDAY_NAMES[day.weekday()][:2]} {day:%d.%m.}' if mode == 'week' else f'{day:%d.}'
            button = self._make_dialog_button(header, day_label,
                lambda day=iso: self.calendar_choose_day(day), 'accent' if iso == date.today().isoformat() else 'muted', width=100 if mode == 'week' else 60, height=30)
            button.pack(side='left')
            button.bind('<Double-Button-1>', lambda event,day=iso: self.calendar_show_day(day))
            button.bind('<Button-3>', lambda event,day=iso: self.calendar_day_menu(day,event))
            if IS_MACOS:
                button.bind('<Button-2>', lambda event,day=iso: self.calendar_day_menu(day,event))
            summary = self._calendar_summaries[iso]
            if mode == 'week':
                text = label(header, glide_planning.available_text(summary), 9, color='muted', surface='card')
                if summary['capacity']:
                    ProgressBar(card, value=summary['minutes'], maximum=summary['capacity'],
                        bg_color=theme['card'], track_color=theme['input'], fill_color=theme['delete'] if summary['remaining'] < 0 else theme['accent'], height=6).pack(fill='x', padx=10, pady=(2, 4))
                else:
                    label(card, 'Kapazität unbekannt', 8, color='muted', surface='card')
            day_items = buckets[iso]
            if mode == 'month':
                planned = sum(item.get('planned_date') == iso for _,item in day_items)
                due = sum(self.normalize_due(item.get('due')) == iso for _,item in day_items)
                label(card, f'{planned} geplant\n{due} fällig', 8, color='muted', surface='card')
                tk.Frame(card, bg=theme['card'], height=18).pack(fill='x')
                moon = moon_events.get(day)
                if moon:
                    marker = tk.Label(card, text=self.ICONS[moon['icon']], bg=theme['card'], fg=theme['muted'], font=app_font(10))
                    marker.place(relx=1, rely=1, x=-5, y=-5, anchor='se')
                    marker.moon_day, marker.moon_name = day, moon['name']
                    self.add_tooltip(marker, moon['name'] + ' · berechneter lokaler Kalendertag')
            else:
                for entry, item in day_items[:5]:
                    fields = ('Geplant ' + (item.get('planned_time') or '') if item.get('planned_date') == iso else '')
                    if self.normalize_due(item.get('due')) == iso:
                        fields += (' · ' if fields else '') + 'Fällig ' + (item.get('due_time') or '')
                    title = ('Erledigt · ' if item.get('done') else '') + item['text'].splitlines()[0] + ' · ' + fields.strip()
                    widget = label(card, title, 9, surface='card')
                    widget.configure(cursor='hand2', takefocus=True)
                    self._calendar_task_widgets[(iso,item['id'])] = widget
                    widget.bind('<Double-Button-1>', lambda event,lid=entry['id'],iid=item['id']: self.open_task_in_source_list(lid,iid))
                    widget.bind('<Return>', lambda event,lid=entry['id'],iid=item['id']: self.open_task_in_source_list(lid,iid))
                    widget.bind('<ButtonPress-1>', lambda event,iid=item['id']: self.calendar_drag_start(event,[iid]))
                    widget.bind('<B1-Motion>', self.calendar_drag_motion)
                    widget.bind('<ButtonRelease-1>', self.calendar_drag_end)
                if len(day_items) > 5:
                    more = self._make_dialog_button(card, f'Alle {len(day_items)} Aufgaben …', lambda day=iso: self.calendar_show_day(day), 'muted', width=180, height=30)
                    more.pack(anchor='w', padx=8, pady=4)
        label(panel, 'Planungsauswahl · markieren, Tag wählen und einplanen; oder auf einen Tag ziehen.', 10, True)
        pool_frame = tk.Frame(panel, bg=theme['bg']); pool_frame.pack(fill='x', pady=(0, 8))
        pool = ttk.Treeview(pool_frame, columns=('date',), show='tree headings', height=5, selectmode='extended', style=self.tree.cget('style'))
        self._calendar_pool = pool
        self._calendar_pool_bar = self._attach_field_scrollbar(pool_frame, pool, pad_y=0)
        pool.heading('#0', text='Offene Aufgabe'); pool.heading('date', text='Bearbeitungstag')
        pool.column('#0', width=260, minwidth=130, stretch=True); pool.column('date', width=130, minwidth=100, stretch=False)
        pool.pack(side='left', fill='x', expand=True)
        for entry,item in entries:
            if not item.get('done'):
                pool.insert('', 'end', iid=item['id'], text=item['text'].splitlines()[0] + ' · ' + entry['title'], values=(self.format_due_display(item.get('planned_date')) if item.get('planned_date') else 'Ohne Tag',))
        pool.bind('<Return>', lambda event: self.calendar_plan_selection())
        pool.bind('<ButtonPress-1>', self.calendar_pool_press)
        pool.bind('<B1-Motion>', self.calendar_drag_motion); pool.bind('<ButtonRelease-1>', self.calendar_drag_end)
        self.refresh_page_actions(self.calendar_footer_actions())
        return panel


    def calendar_show_day(self, day):
        values = [(entry, item) for entry in self.planning_lists() for item in self.walk_items(entry.get('items', []))
                  if self.is_schedulable_item(item) and (item.get('planned_date') == day or self.normalize_due(item.get('due')) == day)]
        choices = [(item['id'], item['text'].splitlines()[0] + ' · ' + entry['title'] + ' · '
                    + ('geplant' if item.get('planned_date') == day else 'fällig')) for entry,item in values]
        identity = self.themed_choice_dialog('Aufgaben am ' + self.format_due_display(day), 'Aufgabe auswählen und öffnen:', choices)
        if identity:
            self.open_object_reference(glide_objects.uri('item', identity))

    def calendar_add_task(self, day, due=False):
        if getattr(self, '_data_read_only', False):
            return False
        target = self.calendar_target_list()
        if target is None:
            return False
        details = self.new_item_dialog('Neue Aufgabe am ' + self.format_due_display(day),
            'Fälligkeit und Bearbeitungstag sind unabhängig.', allow_list_choice=True,
            default_list_id=target['id'], default_due=day if due else None,
            default_planned=None if due else day)
        if details is None:
            return False
        target = next((entry for entry in self.planning_lists() if entry['id'] == (details.get('list_id') or target['id'])), None)
        if target is None:
            self.show_warning('Neue Aufgabe', 'Die Zielliste ist inzwischen nicht mehr verfügbar.')
            return False
        old = copy.deepcopy(self.lists)
        created = self.build_item_from_dialog(details)
        with self.guarded_structural_change('Kalenderaufgabe anlegen'):
            with self.item_change([], update_sidebar=True) as change:
                target.setdefault('items', []).append(created)
                change.mark(created['id'])
        if not change.saved:
            self.lists = old
            self.sync_current_list_reference(); self.refresh_tree(); self.update_sidebar_list()
            if self.undo_stack:
                self.undo_stack.pop()
            return False
        self.refresh_home()
        return True

    def calendar_day_menu(self, day, event):
        self.calendar_choose_day(day)
        menu = self._new_themed_popup_menu()
        menu.add_command(label='Aufgaben dieses Tages …', command=lambda: self.calendar_show_day(day))
        menu.add_command(label='Aufgabe für diesen Bearbeitungstag …', command=lambda: self.calendar_add_task(day))
        menu.add_command(label='Aufgabe mit dieser Fälligkeit …', command=lambda: self.calendar_add_task(day, due=True))
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            menu.grab_release()

    def calendar_pool_press(self, event):
        pool = self._calendar_pool
        def capture():
            if pool.winfo_exists() and self.home_mode() == 'calendar':
                self.calendar_drag_start(event, pool.selection())
        self.root.after_idle(capture)
    def add_task_with_due(self, day, parent_dialog=None, restore_grab=None):
        """Legt eine Aufgabe mit fester Fälligkeit an; Rückgabe: wurde etwas angelegt.

        Wird vom Kalender genutzt und ist bewusst eine eigene Methode, damit der
        Weg unabhängig vom Dialog geprüft werden kann.
        """
        target = self.calendar_target_list()
        if target is None:
            self.show_info(
                "Neue Aufgabe",
                "Es gibt noch keine Liste, in der die Aufgabe angelegt werden könnte.",
            )
            return False
        if parent_dialog is not None:
            try:
                parent_dialog.grab_release()
            except tk.TclError:
                pass
        try:
            details = self.new_item_dialog(
                f"Neue Aufgabe am {day.strftime('%d.%m.%Y')}",
                "Die Fälligkeit ist bereits eingetragen. Zielliste, Wichtigkeit, "
                "Farbe und Labels lassen sich hier gleich mitgeben.",
                allow_list_choice=True,
                default_list_id=target.get("id"),
                default_due=day.isoformat(),
            )
        finally:
            if callable(restore_grab):
                restore_grab()
        if details is None:
            return False
        chosen_id = details.get("list_id") or target.get("id")
        target = next(
            (entry for entry in self.lists if entry.get("id") == chosen_id), target
        )
        self.snapshot_undo()
        if not details.get("due"):
            details["due"] = day.isoformat()
        new_entry = self.build_item_from_dialog(details)
        target.setdefault("items", []).append(new_entry)
        if target.get("id") == self.active_list_id:
            self.items = target["items"]
        self.save_items()
        self.update_sidebar_list()
        self.refresh_tree()
        return True

    def calendar_target_list(self):
        """Liste, in der eine im Kalender angelegte Aufgabe entsteht.

        Das ist die geöffnete Liste; steht gerade eine Ordnerübersicht, „In
        Bearbeitung“ oder der Papierkorb im Hauptbereich, übernimmt der Eingang.
        """
        if self.view_mode == "list":
            current = next((entry for entry in self.lists if entry.get("id") == self.active_list_id), None)
            if current is not None:
                return current
        inbox = next((entry for entry in self.lists if self.is_inbox_list(entry)), None)
        if inbox is not None:
            return inbox
        return self.lists[0] if self.lists else None

    def open_task_in_source_list(self, list_id, item_id):
        """Öffnet eine Aufgabe in ihrer Quellliste und klappt den Pfad dorthin auf."""
        if not any(entry.get("id") == list_id for entry in self.lists):
            return False
        self.set_active_list(list_id, refresh=False)
        self.update_sidebar_list()
        self.refresh_tree(selected_id=item_id)
        self.reveal_tree_row(item_id)
        self.save_settings()
        return True

