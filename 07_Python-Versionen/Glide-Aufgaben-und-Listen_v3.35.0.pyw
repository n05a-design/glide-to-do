def register_private_fonts(font_dir=None):
    """Registriert optionale TTF-Schriften nur für den laufenden Prozess.

    Die Anwendung bleibt ohne Font-Datei vollständig funktionsfähig. Unter
    Windows wird ``FR_PRIVATE`` verwendet; macOS erhält denselben
    Prozessumfang über CoreText, Linux über Fontconfig als Anwendungsschriften.
    Andere Plattformen greifen auf Tk-Systemfonts zurück. Die Funktion liefert
    die Pfade der registrierten Schriftdateien zurück.
    """
    font_dir = font_dir or os.path.join(os.path.dirname(__file__), "resources", "fonts")
    if not os.path.isdir(font_dir):
        return []
    if IS_LINUX:
        return register_fontconfig_dir(font_dir)
    registered = []
    for path in sorted(os.listdir(font_dir)):
        if not path.lower().endswith((".ttf", ".otf")):
            continue
        full_path = os.path.join(font_dir, path)
        try:
            if IS_WINDOWS:
                add_font = ctypes.windll.gdi32.AddFontResourceExW
                add_font.argtypes = [ctypes.c_wchar_p, ctypes.c_uint, ctypes.c_void_p]
                if add_font(full_path, 0x10, 0):
                    registered.append(full_path)
            elif IS_MACOS:
                core_text = ctypes.CDLL("/System/Library/Frameworks/CoreText.framework/CoreText")
                foundation = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
                foundation.CFURLCreateFromFileSystemRepresentation.argtypes = [
                    ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long, ctypes.c_bool,
                ]
                foundation.CFURLCreateFromFileSystemRepresentation.restype = ctypes.c_void_p
                foundation.CFRelease.argtypes = [ctypes.c_void_p]
                core_text.CTFontManagerRegisterFontsForURL.argtypes = [
                    ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p),
                ]
                core_text.CTFontManagerRegisterFontsForURL.restype = ctypes.c_bool
                encoded = os.fsencode(full_path)
                url = foundation.CFURLCreateFromFileSystemRepresentation(
                    None, encoded, len(encoded), False,
                )
                if url:
                    try:
                        if core_text.CTFontManagerRegisterFontsForURL(url, 1, None):
                            registered.append(full_path)
                    finally:
                        foundation.CFRelease(url)
        except (AttributeError, OSError, TypeError):
            continue
    return registered


def register_fontconfig_dir(font_dir):
    """Nimmt einen Schriftordner prozessweit in Fontconfig auf (Linux).

    ``FcConfigAppFontAddDir`` ändert weder ``~/.fonts`` noch den Schriftcache
    des Systems. Tk mit Xft findet die Familien danach über dieselbe
    Konfiguration; ein Tk ohne Xft behält die Systemschriften.
    """
    try:
        fontconfig = ctypes.CDLL("libfontconfig.so.1")
        add_dir = fontconfig.FcConfigAppFontAddDir
        add_dir.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
        add_dir.restype = ctypes.c_int
        if not add_dir(None, os.fsencode(font_dir)):
            return []
    except (AttributeError, OSError, TypeError):
        return []
    return [
        os.path.join(font_dir, name) for name in sorted(os.listdir(font_dir))
        if name.lower().endswith((".ttf", ".otf"))
    ]


def moon_phase_info(day=None):
    """Liefert Phasenname, Beleuchtungsanteil und Zyklusanteil für einen Tag."""
    day = day or date.today()
    if isinstance(day, datetime):
        day = day.date()
    epoch = date(2000, 1, 6)
    cycle = 29.530588853
    age = ((day - epoch).days % cycle)
    fraction = age / cycle
    illumination = (1.0 - math.cos(2.0 * math.pi * fraction)) / 2.0
    names = (
        (0.0625, "Neumond"), (0.1875, "Zunehmende Sichel"),
        (0.3125, "Erstes Viertel"), (0.4375, "Zunehmender Dreiviertelmond"),
        (0.5625, "Vollmond"), (0.6875, "Abnehmender Dreiviertelmond"),
        (0.8125, "Letztes Viertel"), (0.9375, "Abnehmende Sichel"),
    )
    name = next((label for upper, label in names if fraction < upper), "Neumond")
    return {"name": name, "illumination": round(illumination, 4), "percent": round(illumination * 100), "age": round(age, 2), "fraction": fraction}


def principal_moon_phase_utc(lunation, quarter):
    """Hauptphase als UTC-Näherung, nach John Walkers gemeinfreiem Moontool.

    Quelle: https://www.fourmilab.ch/moontool/moontool.shar.gz, truephase.
    Zyklus mit periodischen Korrekturen statt bloßem mittleren Mondalter.
    Für Kalenderdaten gedacht; keine astronomische Präzisionszeitangabe.
    """
    if quarter not in (0, 1, 2, 3):
        raise ValueError("Mondphase muss zwischen 0 und 3 liegen.")
    k = lunation + quarter / 4
    t = k / 1236.85
    def sin(angle):
        return math.sin(math.radians(angle % 360))
    def cos(angle):
        return math.cos(math.radians(angle % 360))
    jde = (2415020.75933 + 29.53058868 * k + .0001178 * t**2 - .000000155 * t**3
           + .00033 * sin(166.56 + 132.87 * t - .009173 * t**2))
    m = 359.2242 + 29.10535608 * k - .0000333 * t**2 - .00000347 * t**3
    mp = 306.0253 + 385.81691806 * k + .0107306 * t**2 + .00001236 * t**3
    f = 21.2964 + 390.67050646 * k - .0016528 * t**2 - .00000239 * t**3
    if quarter in (0, 2):
        correction = ((.1734 - .000393 * t) * sin(m) + .0021 * sin(2*m)
            - .4068 * sin(mp) + .0161 * sin(2*mp) - .0004 * sin(3*mp)
            + .0104 * sin(2*f) - .0051 * sin(m+mp) - .0074 * sin(m-mp)
            + .0004 * sin(2*f+m) - .0004 * sin(2*f-m) - .0006 * sin(2*f+mp)
            + .0010 * sin(2*f-mp) + .0005 * sin(m+2*mp))
    else:
        correction = ((.1721 - .0004 * t) * sin(m) + .0021 * sin(2*m)
            - .6280 * sin(mp) + .0089 * sin(2*mp) - .0004 * sin(3*mp)
            + .0079 * sin(2*f) - .0119 * sin(m+mp) - .0047 * sin(m-mp)
            + .0003 * sin(2*f+m) - .0004 * sin(2*f-m) - .0006 * sin(2*f+mp)
            + .0021 * sin(2*f-mp) + .0003 * sin(m+2*mp) + .0004 * sin(m-2*mp)
            - .0003 * sin(2*m+mp))
        correction += (1 if quarter == 1 else -1) * (.0028 - .0004*cos(m) + .0003*cos(mp))
    return datetime(2000, 1, 1, 12, tzinfo=timezone.utc) + timedelta(days=jde + correction - 2451545)


def calendar_moon_phases(first_day, last_day, tz=None):
    """Vier Hauptphasen, jeweils am lokalen Kalendertag; ohne Netzwerkzugriff."""
    phases = (("Neumond", "moon_new"), ("Erstes Viertel", "moon_first"),
              ("Vollmond", "moon_full"), ("Letztes Viertel", "moon_last"))
    first_k = math.floor((first_day.year + (first_day.month - 1) / 12 - 1900) * 12.3685) - 1
    cycles = math.ceil((last_day - first_day).days / 29.53058868) + 4
    result = {}
    for lunation in range(first_k, first_k + cycles):
        for quarter, (name, icon) in enumerate(phases):
            instant = principal_moon_phase_utc(lunation, quarter)
            local = instant.astimezone(tz)
            if first_day <= local.date() <= last_day:
                result[local.date()] = {"name": name, "icon": icon, "utc": instant, "local": local}
    return result


def contrast_ratio(first, second):
    """Kontrastverhältnis zweier Farben nach WCAG, von 1 bis 21."""
    werte = sorted((relative_luminance(first), relative_luminance(second)))
    return (werte[1] + 0.05) / (werte[0] + 0.05)


@functools.lru_cache(maxsize=4096)
def _parse_iso_date(value):
    """Prüft ein ISO-Datum und liefert es zurück – oder None.

    Der Profilerlauf über einen Bestand von rund 1.600
    Punkten zeigte 347.000 Aufrufe von `normalize_due` für zwanzig
    Ansichtswechsel – etwa 17.000 je Wechsel, 2,9 von 11,3 Sekunden. Jeder
    davon baute mit `strptime` ein `datetime`-Objekt auf, nur um eine
    Zeichenkette zu prüfen, die sich nicht geändert hatte. Die Datumswerte
    eines Bestands wiederholen sich stark; ein Zwischenspeicher über den
    Eingabetext trifft deshalb fast immer. Er darf unbegrenzt leben, weil
    dieselbe Zeichenkette immer dasselbe Ergebnis hat.
    """
    parsed = glide_metrics.parsed_date(value)
    return parsed.strftime("%Y-%m-%d") if parsed is not None else None


def readable_text_color(background, dark="#15171C", light="#FFFFFF"):
    """Schrift, die auf dieser Fläche lesbar bleibt.

    Wo eine Fläche zur Laufzeit gemischt wird – eine
    Hover-Farbe, ein Labelchip, eine Auswahl in der Akzentfarbe –, kann die
    Schriftfarbe nicht fest im Theme stehen. Entschieden wird nicht nach einer
    Helligkeitsschwelle, sondern nach dem tatsächlich gemessenen Kontrast:
    Eine Schwelle liegt bei gesättigten Tönen regelmäßig daneben. Auf dem
    Lila der Auswahl etwa trägt dunkle Schrift messbar weiter als weiße,
    obwohl die Fläche dunkel wirkt.
    """
    return light if contrast_ratio(light, background) >= contrast_ratio(dark, background) else dark


def ensure_contrast(surface, text_color, minimum=4.5, steps=14):
    """Zieht eine Fläche nach, bis die vorgegebene Schrift darauf lesbar ist.

    Die Auswahl trägt weiße Schrift, weil das zur Marke
    gehört – aber Weiß auf dem hellen Lila der Standardpalette kam nur auf
    4,1:1 und blieb damit unter dem, was WCAG für normalen Text verlangt.
    Statt die Schrift zu wechseln und damit die Optik umzuwerfen, wird die
    Fläche schrittweise von der Schrift weggezogen: heller Text bekommt eine
    dunklere Fläche, dunkler Text eine hellere. Der Farbton bleibt dabei
    erhalten, weil nur gegen Schwarz beziehungsweise Weiß gemischt wird.
    """
    if contrast_ratio(surface, text_color) >= minimum:
        return surface
    ziel = "#000000" if relative_luminance(text_color) >= 0.5 else "#FFFFFF"
    ergebnis = surface
    for schritt in range(1, steps + 1):
        ergebnis = mix_hex_colors(surface, ziel, schritt / steps * 0.9)
        if contrast_ratio(ergebnis, text_color) >= minimum:
            return ergebnis
    return ergebnis


def legible_on(color, surfaces, minimum=4.5, steps=100):
    """Zieht eine Schriftfarbe im eigenen Farbton nach, bis sie auf allen Flächen trägt.

    Das Gegenstück zu `ensure_contrast`: Dort weicht die Fläche, hier die
    Schrift. Auf hellen Flächen wird gegen Schwarz gemischt, auf dunklen gegen
    Weiß – das Grün bleibt grün, nur tiefer beziehungsweise heller.
    """
    flaechen = [flaeche for flaeche in surfaces if flaeche]
    if not color or not flaechen:
        return color
    if min(contrast_ratio(color, flaeche) for flaeche in flaechen) >= minimum:
        return color
    hell = sum(relative_luminance(flaeche) for flaeche in flaechen) / len(flaechen) >= 0.18
    ziel = "#000000" if hell else "#FFFFFF"
    kandidat = color
    for schritt in range(1, steps + 1):
        kandidat = mix_hex_colors(color, ziel, schritt / steps)
        if min(contrast_ratio(kandidat, flaeche) for flaeche in flaechen) >= minimum:
            return kandidat
    return kandidat


def is_neutral_color(color, spread=40):
    """Grau, Weiß oder Schwarz – ohne erkennbaren Farbton."""
    text = str(color or "").lstrip("#")
    if len(text) != 6:
        return True
    try:
        kanaele = [int(text[index:index + 2], 16) for index in (0, 2, 4)]
    except ValueError:
        return True
    return max(kanaele) - min(kanaele) < spread


def mix_hex_colors(first, second, ratio):
    """Mischt zwei Hex-Farben; ratio 0 liefert first, ratio 1 liefert second."""
    def parse(value):
        text = str(value or "#000000").strip()
        if text.startswith("#"):
            text = text[1:]
        if len(text) == 3:
            text = "".join(char * 2 for char in text)
        if len(text) != 6:
            return (0, 0, 0)
        try:
            return tuple(int(text[index:index + 2], 16) for index in (0, 2, 4))
        except ValueError:
            return (0, 0, 0)

    left = parse(first)
    right = parse(second)
    weight = max(0.0, min(1.0, float(ratio)))
    blended = tuple(
        int(round(left[index] + (right[index] - left[index]) * weight))
        for index in range(3)
    )
    return "#%02X%02X%02X" % blended


def relative_luminance(hex_color):
    """Relative Helligkeit nach WCAG – Grundlage jeder Kontrastrechnung."""
    text = str(hex_color or "#000000").lstrip("#")
    if len(text) == 3:
        text = "".join(char * 2 for char in text)
    if len(text) != 6:
        return 0.0
    channels = []
    for index in (0, 2, 4):
        try:
            value = int(text[index:index + 2], 16) / 255.0
        except ValueError:
            value = 0.0
        channels.append(value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]


def mix_to_luminance(base, towards, target_luminance, steps=24):
    """Mischt base Richtung towards, bis die Zielhelligkeit erreicht ist.

    Ein fester Mischanteil taugt hier nicht: Gelb ist von Haus aus dreimal so
    hell wie Lila. Mit demselben Anteil Weiß verschwindet der eine Chip im
    Hintergrund, während der andere noch kräftig ist. Gesucht wird deshalb nicht
    ein Anteil, sondern eine Helligkeit – dann sitzen alle Farben gleich.
    """
    low, high = 0.0, 1.0
    base_luminance = relative_luminance(base)
    towards_luminance = relative_luminance(towards)
    if towards_luminance == base_luminance:
        return mix_hex_colors(base, towards, 0.5)
    rising = towards_luminance > base_luminance
    result = mix_hex_colors(base, towards, 1.0 if rising else 0.0)
    for _step in range(steps):
        middle = (low + high) / 2
        candidate = mix_hex_colors(base, towards, middle)
        luminance = relative_luminance(candidate)
        result = candidate
        if (luminance < target_luminance) == rising:
            low = middle
        else:
            high = middle
    return result


class PackedState:
    """Ein Datenstand für den Rückgängig-Speicher – als komprimiertes JSON.

    Vorher lag jeder der bis zu 20 Schritte als vollständige Tiefenkopie aller
    Listen, Ordner, Labels und des Papierkorbs im Speicher (Beispieldaten:
    4,6 MB für 20 Schritte, mit Zeichnungen deutlich mehr). Gepackt sind es
    rund 10 %, bei gleichem Zeitaufwand. `unpack` liefert jedes Mal einen
    frischen, unabhängigen Stand – eine Tiefenkopie ist nicht mehr nötig.
    """

    __slots__ = ("data",)

    def __init__(self, value):
        self.data = zlib.compress(json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8"), 1)

    def unpack(self):
        return json.loads(zlib.decompress(self.data).decode("utf-8"))


def unpack_state(value, default=None):
    """Wert aus einem Rückgängig-Schnappschuss – gepackt oder (ältere Form) roh."""
    if isinstance(value, PackedState):
        return value.unpack()
    if value is None:
        return [] if default is None else default
    return copy.deepcopy(value)


def bind_resize(widget, callback, add=None):
    """Ruft `callback(event)` nur, wenn sich die Größe des Widgets geändert hat.

    Tk meldet <Configure> auch bei reinen Verschiebungen – beim Scrollen der
    Startseite für jeden eingebetteten Knopf und jede Karte bei jedem Schritt.
    Bis 26.09.2026 zeichneten sie sich dabei jedes Mal vollständig neu
    (Messung: 20 Scrollschritte 2,8 s, mit Verlauf 10,5 s).
    """
    def bei_groesse(event):
        groesse = (event.width, event.height)
        if getattr(widget, "_resize_seen", None) == groesse:
            return None
        widget._resize_seen = groesse
        return callback(event)

    return widget.bind("<Configure>", bei_groesse, add=add)


class LabelChip(tk.Canvas):
    """Label als abgerundete Fläche mit dunklem Text auf der Labelfarbe.

    Ein farbiger Punkt oder reiner farbiger Text sagt nur „irgendwas ist hier
    markiert“. Eine Fläche mit lesbarem Text sagt, welches Label es ist – das
    ist der eigentliche Zweck. Tk kann eine Treeview-Zelle nicht einfärben,
    deshalb steht dieser Chip überall dort, wo ein echtes Widget möglich ist.
    """

    RADIUS = 9
    PAD_X = 9
    PAD_TOP = 2
    PAD_BOTTOM = 4

    @classmethod
    def measure(cls, text, font):
        """Breite und Höhe, die ein Chip mit diesem Text einnehmen würde."""
        try:
            measure_font = tkfont.Font(font=font)
            text_width = measure_font.measure(str(text or ""))
            text_height = measure_font.metrics("linespace")
        except tk.TclError:
            text_width = 8 * max(1, len(str(text or "")))
            text_height = 14
        return text_width + 2 * cls.PAD_X, text_height + cls.PAD_TOP + cls.PAD_BOTTOM

    def __init__(self, master, text, fill, text_color, bg_color,
                 font=app_font(9, "bold"), outline=None):
        self.chip_text = str(text or "")
        self.fill = fill
        self.text_color = text_color
        self.bg_color = bg_color
        self.chip_font = font
        self.outline = outline
        width, height = self.measure(self.chip_text, font)
        super().__init__(
            master,
            width=width,
            height=height,
            bg=bg_color,
            highlightthickness=0,
            bd=0,
        )
        self.chip_width = width
        self.chip_height = height
        self._draw()

    def set_colors(self, fill=None, text_color=None, bg_color=None, outline=None):
        if fill is not None:
            self.fill = fill
        if text_color is not None:
            self.text_color = text_color
        if bg_color is not None:
            self.bg_color = bg_color
            self.configure(bg=bg_color)
        self.outline = outline
        self._draw()

    def _draw(self):
        self.delete("all")
        # Die Fläche rechnet in Pixelkoordinaten, also bis Breite-1 und Höhe-1:
        # Eine Form, die exakt auf chip_width endet, liegt mit ihrer letzten
        # Spalte außerhalb der Zeichenfläche und wurde an der Kante beschnitten.
        right = max(0, self.chip_width - 1)
        bottom = max(0, self.chip_height - 1)
        radius = max(0, min(self.RADIUS, bottom // 2, right // 2))
        size = 2 * radius
        # Vier Kreisviertel und zwei Rechtecke statt eines geglätteten Polygons:
        # Bei der geringen Chiphöhe zog die Spline die Ecken beinahe gerade, und
        # ihre Außenkante fiel mit der Schnittkante der Fläche zusammen.
        if radius:
            for x, y, start in (
                (0, 0, 90),
                (right - size, 0, 0),
                (0, bottom - size, 180),
                (right - size, bottom - size, 270),
            ):
                self.create_arc(
                    x, y, x + size, y + size,
                    start=start, extent=90, style="pieslice",
                    fill=self.fill, outline=self.fill,
                )
        self.create_rectangle(
            radius, 0, right - radius, bottom, fill=self.fill, outline=self.fill,
        )
        self.create_rectangle(
            0, radius, right, bottom - radius, fill=self.fill, outline=self.fill,
        )
        if self.outline:
            # Auswahlrahmen: dieselbe Kontur als Linie, damit die Markierung in
            # der Labelauswahl sichtbar bleibt.
            if radius:
                for x, y, start in (
                    (0, 0, 90),
                    (right - size, 0, 0),
                    (0, bottom - size, 180),
                    (right - size, bottom - size, 270),
                ):
                    self.create_arc(
                        x, y, x + size, y + size,
                        start=start, extent=90, style="arc", outline=self.outline,
                    )
            self.create_line(radius, 0, right - radius, 0, fill=self.outline)
            self.create_line(radius, bottom, right - radius, bottom, fill=self.outline)
            self.create_line(0, radius, 0, bottom - radius, fill=self.outline)
            self.create_line(right, radius, right, bottom - radius, fill=self.outline)
        # Der Text sitzt oben zwei Pixel enger als unten: Großbuchstaben tragen
        # oben mehr Luft mit sich, optisch steht er damit mittig.
        self.create_text(
            self.PAD_X,
            self.PAD_TOP,
            text=self.chip_text,
            anchor="nw",
            fill=self.text_color,
            font=self.chip_font,
        )


class ProgressBar(tk.Canvas):
    """Schmaler Fortschrittsbalken mit abgerundeten Enden."""

    def __init__(self, master, value, maximum, bg_color, track_color, fill_color, height=10):
        super().__init__(master, height=height, bg=bg_color, highlightthickness=0, bd=0)
        self.value = max(0, value)
        self.maximum = max(1, maximum)
        self.bg_color = bg_color
        self.track_color = track_color
        self.fill_color = fill_color
        self.bar_height = height
        bind_resize(self, lambda _event: self._draw())

    def _kapsel(self, x1, x2, farbe):
        # Unter einer Kapselbreite bliebe von der Rundung nur ein Klecks; dann
        # ist ein Rechteck ehrlicher als ein verzerrter Kreis.
        r = self.bar_height / 2
        if x2 - x1 < self.bar_height:
            if x2 > x1:
                self.create_rectangle(x1, 0, x2, self.bar_height, fill=farbe, outline=farbe)
            return
        self.create_oval(x1, 0, x1 + 2 * r, self.bar_height, fill=farbe, outline=farbe)
        self.create_oval(x2 - 2 * r, 0, x2, self.bar_height, fill=farbe, outline=farbe)
        self.create_rectangle(x1 + r, 0, x2 - r, self.bar_height, fill=farbe, outline=farbe)

    def _draw(self):
        self.delete("all")
        breite = max(1, self.winfo_width())
        self._kapsel(0, breite, self.track_color)
        self._kapsel(0, breite * min(1.0, self.value / self.maximum), self.fill_color)

    def set_value(self, value):
        """Aktualisiert nur den Balken, ohne den umgebenden Bereich neu aufzubauen."""
        try:
            self.value = max(0, float(value))
        except (TypeError, ValueError):
            self.value = 0
        self._draw()


class CompletionChart(tk.Canvas):
    """Erledigte Aufgaben je Tag als stehende Balken.

    Bewusst ohne Achsen und Gitter: Sieben Werte brauchen keine Skala, sondern
    einen Vergleich untereinander. Unter jedem Balken steht der Wochentag, über
    dem Balken die Zahl – damit ist die Grafik auch ohne Achse eindeutig.
    """

    WEEKDAYS = ("Mo", "Di", "Mi", "Do", "Fr", "Sa", "So")

    def __init__(self, master, days, bg_color, bar_color, track_color, text_color,
                 today_color, height=96):
        super().__init__(master, height=height, bg=bg_color, highlightthickness=0, bd=0)
        self.days = list(days)
        self.bg_color = bg_color
        self.bar_color = bar_color
        self.track_color = track_color
        self.text_color = text_color
        self.today_color = today_color
        self.chart_height = height
        bind_resize(self, lambda _event: self._draw())

    def _draw(self):
        self.delete("all")
        if not self.days:
            return
        breite = max(1, self.winfo_width())
        beschriftung = 16
        grundlinie = self.chart_height - beschriftung
        # Gleiche Zeichenbreite wie das Jahresraster, einschließlich Platz
        # für dessen Wochentage am linken Rand.
        links, rechts = 20, breite - 2
        spalte = max(1, rechts - links) / len(self.days)
        balken = max(10, min(44, spalte * 0.55))
        hoechster = max((anzahl for _tag, anzahl in self.days), default=0)
        heute = date.today()
        # Eine durchgehende Grundlinie statt einer Spur je Balken: Die Spur sah
        # aus wie ein zweiter, hellerer Balken und verdoppelte jeden Wert
        # optisch. Die Linie trägt dieselbe Aussage – hier ist die Null.
        self.create_line(links, grundlinie, rechts, grundlinie, fill=self.track_color, width=1)
        for index, (tag, anzahl) in enumerate(self.days):
            mitte = links + spalte * (index + 0.5)
            x1, x2 = mitte - balken / 2, mitte + balken / 2
            ist_heute = tag == heute
            hoehe = 0 if hoechster == 0 else (anzahl / hoechster) * (grundlinie - 16)
            if anzahl:
                farbe = self.today_color if ist_heute else self.bar_color
                self.create_rectangle(x1, grundlinie - hoehe, x2, grundlinie,
                                      fill=farbe, outline=farbe)
            else:
                # Ein Tag ohne Erledigtes bekommt einen flachen Stummel: Sonst
                # bliebe die Spalte leer und wäre von „kein Tag" nicht zu
                # unterscheiden.
                self.create_rectangle(x1, grundlinie - 2, x2, grundlinie,
                                      fill=self.track_color, outline=self.track_color)
            self.create_text(mitte, grundlinie - hoehe - 8, text=str(anzahl),
                             fill=self.today_color if ist_heute else self.text_color,
                             font=("TkDefaultFont", 8, "bold" if ist_heute else "normal"))
            self.create_text(mitte, grundlinie + beschriftung / 2,
                             text=self.WEEKDAYS[tag.weekday()],
                             fill=self.today_color if ist_heute else self.text_color,
                             font=("TkDefaultFont", 8, "bold" if ist_heute else "normal"))


class MoonPhase(tk.Canvas):
    """Kleine Mondphasenanzeige aus Tk-Grundformen."""

    def __init__(self, master, info=None, size=46, bg_color="#FFFFFF", light_color="#F4D35E",
                 dark_color="#4B4B63", outline_color="#888888"):
        super().__init__(master, width=size, height=size, bg=bg_color,
                         highlightthickness=0, bd=0)
        self.info = info or moon_phase_info()
        self.size = size
        self.bg_color = bg_color
        self.light_color = light_color
        self.dark_color = dark_color
        self.outline_color = outline_color
        bind_resize(self, lambda _event: self._draw())
        self._draw()

    def _draw(self):
        self.delete("all")
        radius = max(4, self.size * 0.38)
        cx = cy = self.size / 2
        self.create_oval(cx - radius, cy - radius, cx + radius, cy + radius,
                         fill=self.dark_color, outline=self.outline_color, width=1)
        fraction = float(self.info.get("fraction", 0.0)) % 1.0
        waxing = fraction <= 0.5
        terminator = math.cos(2 * math.pi * fraction)
        # Beide Konturen liegen in derselben Kreisscheibe; die helle Fläche
        # kann deshalb weder seitlich herausragen noch eine volle Ellipse vortäuschen.
        ys = [-radius + 2 * radius * index / 64 for index in range(65)]
        side = 1 if waxing else -1
        contour = []
        for y in ys:
            contour.extend((cx + side * math.sqrt(max(0, radius * radius - y * y)), cy + y))
        for y in reversed(ys):
            contour.extend((cx + side * terminator * math.sqrt(max(0, radius * radius - y * y)), cy + y))
        if float(self.info.get("illumination", 0)) > 0.005:
            self.create_polygon(contour, fill=self.light_color, outline="")
        self.create_oval(cx-radius, cy-radius, cx+radius, cy+radius, outline=self.outline_color)



class YearHeatmap(tk.Canvas):
    """Jahresanzeige im Stil eines ruhigen Aktivitätskalenders."""

    def __init__(self, master, history, today=None, bg_color="#FFFFFF", empty_color="#E5E5EA",
                 accent_color="#7B61FF", text_color="#777777", width=640, height=132):
        super().__init__(master, height=height, bg=bg_color, highlightthickness=0, bd=0)
        self.history = dict(history or {})
        self.today = today or date.today()
        self.bg_color = bg_color
        self.empty_color = empty_color
        self.accent_color = accent_color
        self.text_color = text_color
        self.heatmap_width = width
        self.heatmap_height = height
        bind_resize(self, lambda _event: self._draw())

    @staticmethod
    def statistics(history, today=None):
        today = today or date.today()
        values = {str(key): int(value) for key, value in (history or {}).items()
                  if isinstance(value, int) and not isinstance(value, bool) and value > 0}
        active = len(values)
        total = sum(values.values())
        best = max(values.values(), default=0)
        streak = 0
        cursor = today
        while values.get(cursor.isoformat(), 0):
            streak += 1
            cursor -= timedelta(days=1)
        return {"active_days": active, "total": total, "best_day": best, "streak": streak}

    def hover_text_at(self, x, y):
        for item in self.find_overlapping(x, y, x, y):
            tags = self.gettags(item)
            if "day" in tags:
                day = date.fromisoformat(tags[1])
                weekday = ("Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag")[day.weekday()]
                count = int(self.history.get(day.isoformat(), 0))
                return f"{weekday}, {day:%d.%m.%Y} · {count} Bearbeitungen"
        return ""

    def _draw(self):
        self.delete("all")
        width = max(260, self.winfo_width() or self.heatmap_width)
        gap = 2
        cell = max(2, (width - 22 - 52 * gap) / 53)
        top = 4
        needed_height = math.ceil(top + 7 * cell + 6 * gap + 8)
        if int(self.cget("height")) != needed_height:
            self.configure(height=needed_height)
        start = self.today - timedelta(days=364 + self.today.weekday())
        values = [int(self.history.get((start + timedelta(days=i)).isoformat(), 0))
                  for i in range(371 + start.weekday())]
        maximum = max(values, default=0)
        for index in range(53 * 7):
            day = start + timedelta(days=index // 7 * 7 + index % 7)
            x = 20 + (index // 7) * (cell + gap)
            y = top + (index % 7) * (cell + gap)
            count = int(self.history.get(day.isoformat(), 0))
            ratio = count / maximum if maximum else 0
            if day > self.today:
                continue
            fill = self.empty_color if not count else mix_hex_colors(self.empty_color, self.accent_color, 0.25 + ratio * 0.75)
            self.create_rectangle(x, y, x + cell, y + cell, fill=fill, outline=fill,
                                  tags=("day", day.isoformat()))
        for row, name in ((0, "Mo"), (3, "Do"), (6, "So")):
            self.create_text(1, top + row * (cell + gap) + cell / 2,
                             text=name, anchor="w", fill=self.text_color, font=app_font(7))


class AnalogClock(tk.Canvas):
    """Analoge Uhr aus Tk-Grundformen – kein Bild, keine zusätzliche Bibliothek.

    Zifferblatt und Zeiger sind getrennt: Der Sekundentakt zeichnet nur die
    Zeiger neu. Der Zeitgeber hängt am Widget selbst und endet mit ihm; die
    Startseite baut ihre Kacheln bei jedem Aufbau neu, ein weiterlaufender
    Zeitgeber würde sonst auf ein zerstörtes Widget zeichnen.
    """

    def __init__(self, master, size=64, bg_color="#FFFFFF", face_color="#FFFFFF",
                 rim_color="#888888", mark_color="#888888", hand_color="#000000",
                 second_color="#CC0000"):
        super().__init__(master, width=size, height=size, bg=bg_color,
                         highlightthickness=0, bd=0)
        self.size = size
        self.bg_color = bg_color
        self.face_color = face_color
        self.rim_color = rim_color
        self.mark_color = mark_color
        self.hand_color = hand_color
        self.second_color = second_color
        self._tick_id = None
        self.bind("<Destroy>", self._on_destroy, add="+")
        self._draw_face()
        self._tick()

    def set_colors(self, bg_color=None, face_color=None, rim_color=None,
                   mark_color=None, hand_color=None, second_color=None):
        for name, value in (("bg_color", bg_color), ("face_color", face_color),
                            ("rim_color", rim_color), ("mark_color", mark_color),
                            ("hand_color", hand_color), ("second_color", second_color)):
            if value is not None:
                setattr(self, name, value)
        self.configure(bg=self.bg_color)
        self._draw_face()
        self._draw_hands()

    def _on_destroy(self, event):
        if event.widget is not self:
            return
        if self._tick_id is not None:
            try:
                self.after_cancel(self._tick_id)
            except tk.TclError:
                pass
            self._tick_id = None

    def _draw_face(self):
        self.delete("face")
        rand = 2
        self.create_oval(rand, rand, self.size - rand, self.size - rand,
                         outline=self.rim_color, fill=self.face_color, width=1, tags=("face",))
        mitte = self.size / 2
        radius = mitte - rand
        for stunde in range(12):
            winkel = math.radians(stunde * 30)
            lang = stunde % 3 == 0
            aussen = radius - 3
            innen = aussen - (5 if lang else 3)
            self.create_line(
                mitte + innen * math.sin(winkel), mitte - innen * math.cos(winkel),
                mitte + aussen * math.sin(winkel), mitte - aussen * math.cos(winkel),
                fill=self.mark_color, width=2 if lang else 1, tags=("face",),
            )

    def _draw_hands(self, jetzt=None):
        self.delete("hands")
        jetzt = jetzt or datetime.now()
        mitte = self.size / 2
        radius = mitte - 2
        stunde = (jetzt.hour % 12 + jetzt.minute / 60) * 30
        minute = (jetzt.minute + jetzt.second / 60) * 6
        sekunde = jetzt.second * 6

        def zeiger(grad, laenge, farbe, breite):
            winkel = math.radians(grad)
            self.create_line(
                mitte, mitte,
                mitte + laenge * math.sin(winkel), mitte - laenge * math.cos(winkel),
                fill=farbe, width=breite, capstyle="round", tags=("hands",),
            )

        zeiger(stunde, radius * 0.50, self.hand_color, 3)
        zeiger(minute, radius * 0.72, self.hand_color, 2)
        zeiger(sekunde, radius * 0.78, self.second_color, 1)
        self.create_oval(mitte - 2, mitte - 2, mitte + 2, mitte + 2,
                         fill=self.hand_color, outline=self.hand_color, tags=("hands",))

    def _tick(self):
        try:
            if not self.winfo_exists():
                return
            self._draw_hands()
            self._tick_id = self.after(1000, self._tick)
        except tk.TclError:
            self._tick_id = None


class MonogramTile(tk.Canvas):
    """Das persönliche Textlogo als farbige Fläche – dieselbe Anmutung wie ein Label.

    Ein Label ist eine aufgehellte Fläche mit sehr dunklem Text derselben
    Farbfamilie; genau diese Rechnung benutzt auch das Monogramm. Vorher war es
    farbiger Text ohne Fläche und stand damit als einziges Element der Oberfläche
    außerhalb dieser Systematik.
    """

    def __init__(self, master, text, fill, text_color, bg_color, size=64,
                 radius=16, font=app_font(22, "bold")):
        super().__init__(master, width=size, height=size, bg=bg_color,
                         highlightthickness=0, bd=0)
        self.tile_text = str(text or "G")
        self.fill = fill
        self.text_color = text_color
        self.bg_color = bg_color
        self.size = size
        self.radius = radius
        self.tile_font = app_font(font[1], *font[2:])
        bind_resize(self, lambda _event: self._draw())
        self._draw()

    def set_colors(self, fill=None, text_color=None, bg_color=None):
        if fill is not None:
            self.fill = fill
        if text_color is not None:
            self.text_color = text_color
        if bg_color is not None:
            self.bg_color = bg_color
            self.configure(bg=bg_color)
        self._draw()

    def set_text(self, text):
        self.tile_text = str(text or "G")
        self._draw()

    def _draw(self):
        self.delete("all")
        # Wie beim Labelchip in Pixelkoordinaten rechnen: Eine Form, die exakt
        # auf size endet, läge mit ihrer letzten Spalte außerhalb der Fläche.
        end = max(0, self.size - 1)
        r = min(self.radius, self.size // 2)
        punkte = [
            r, 0, end - r, 0, end, 0, end, r, end, end - r, end, end,
            end - r, end, r, end, 0, end, 0, end - r, 0, r, 0, 0,
        ]
        self.create_polygon(punkte, smooth=True, splinesteps=24,
                            fill=self.fill, outline=self.fill)
        # Die Schriftgröße folgt der Kachel und der Zeichenzahl: Drei Zeichen
        # in der Größe eines einzelnen liefen sonst über den Rand hinaus.
        familie, groesse, stil = self.tile_font
        passend = max(9, int(self.size * (0.46 if len(self.tile_text) <= 1 else
                                          0.34 if len(self.tile_text) == 2 else 0.26)))
        metrics = tkfont.Font(self, font=(familie, min(groesse, passend), stil))
        width = self.winfo_width() if self.winfo_width() > 1 else self.size
        height = self.winfo_height() if self.winfo_height() > 1 else self.size
        self.create_text(width / 2, height / 2 - 2,
                         text=self.tile_text, fill=self.text_color, font=metrics)


class DeferredDrawCanvas(tk.Canvas):
    """Canvas, die sich einmal je Leerlauf statt bei jeder Zwischengröße zeichnet.

    Beim Aufbau der Startseite meldet jede gerundete Fläche ihre Größe rund
    ein Dutzend Mal, bis das Layout steht, und jede Meldung zeichnete sie
    vollständig neu (P03, 02.10.2026). Gezeichnet wird jetzt mit der Größe,
    die im Leerlauf gilt; `_draw()` bleibt für sofortige Änderungen wie Design
    oder Hover direkt aufrufbar.
    """

    _draw_pending = None

    def _draw(self):
        """Unterklassen zeichnen hier ihre Fläche."""

    def _schedule_draw(self, _event=None):
        if self._draw_pending is None:
            self._draw_pending = self.after_idle(self._draw_scheduled)
            if not getattr(self, "_draw_cancel_bound", False):
                self.bind("<Destroy>", self._cancel_draw, add="+")
                self._draw_cancel_bound = True

    def _draw_scheduled(self):
        self._draw_pending = None
        self._draw()

    def _cancel_draw(self, event=None):
        if event is not None and event.widget is not self:
            return
        if self._draw_pending is not None:
            try:
                self.after_cancel(self._draw_pending)
            except tk.TclError:
                pass
            self._draw_pending = None


class RoundedButton(DeferredDrawCanvas):
    """Nativer Tkinter-Button mit abgerundeter Outline und Hover-Fill."""

    def __init__(
        self,
        master,
        text,
        command,
        border_color,
        hover_fill,
        text_color,
        hover_text_color="#FFFFFF",
        bg_color="#FFFFFF",
        height=42,
        radius=18,
        width=132,
        font=app_font(10, "bold"),
        fit_text=True,
        outline=True,
    ):
        super().__init__(
            master,
            height=height,
            width=width,
            bg=bg_color,
            highlightthickness=0,
            bd=0,
            cursor="hand2",
            takefocus=1,
        )
        self.text = self.action_text(text)
        self.command = command
        self.border_color = border_color
        self.hover_fill = hover_fill
        self.text_color = text_color
        self.hover_text_color = hover_text_color
        self.bg_color = bg_color
        self.height = height
        self.radius = radius
        self.font = app_font(font[1], *font[2:])
        self.is_hovered = False
        self.is_pressed = False
        # Dauerhafte Füllung für Schaltflächen, die einen aktiven Zustand
        # anzeigen – etwa der gewählte Kalendermodus. None bedeutet: nur beim
        # Überfahren gefüllt, wie bisher.
        self.active_fill = None
        self.active_text_color = None
        self.text_anchor = "center"
        self.wrap_text = False
        # Die Breite stand bisher als Zahl im Aufruf. Wurde
        # die Beschriftung länger als diese Zahl – oder die Oberflächenschrift
        # größer –, lief der Text über die Fläche hinaus und wurde an beiden
        # Enden abgeschnitten („s HTML speicher“, „ffnen und drucke“). Eine
        # Schaltfläche misst ihre Beschriftung deshalb selbst und wächst, wenn
        # sie muss. `fit_text=False` schaltet das für Flächen ab, deren Breite
        # von außen gesetzt wird.
        self.fit_text = bool(fit_text)
        self.outline = bool(outline)
        self.min_width = int(width)
        self._fit_width()

        bind_resize(self, self._schedule_draw)
        self.bind("<Enter>", self._on_enter)
        self.bind("<Leave>", self._on_leave)
        self.bind("<ButtonPress-1>", self._on_press)
        self.bind("<ButtonRelease-1>", self._on_release)
        self.bind("<space>", self._on_keyboard_activate)
        self.bind("<Return>", self._on_keyboard_activate)
        self.bind("<FocusIn>", lambda _event: self._draw())
        self.bind("<FocusOut>", lambda _event: self._draw())

        self._draw()

    def set_theme(self, bg_color, text_color, border_color=None, hover_fill=None, hover_text_color=None):
        self.bg_color = bg_color
        self.text_color = text_color
        if border_color is not None:
            self.border_color = border_color
        if hover_fill is not None:
            self.hover_fill = hover_fill
        if hover_text_color is not None:
            self.hover_text_color = hover_text_color
        self.configure(bg=bg_color)
        self._draw()

    def set_active(self, fill=None, text_color=None):
        """Markiert die Schaltfläche dauerhaft als aktiv (oder hebt das auf)."""
        self.active_fill = fill
        self.active_text_color = text_color
        self._draw()

    @staticmethod
    def action_text(text):
        text = str(text)
        if text.strip() in ("…", "..."):
            return "Mehr"
        text = re.sub(r"\s*(?:…|\.\.\.)$", "", text) if text.endswith((" …", " ...")) else text
        return {"Punkte anheften": "Anheften", "Weitere Aktionen": "Aktionen"}.get(text, text)

    def set_text(self, text):
        self.text = self.action_text(text)
        self._fit_width()
        self._draw()

    def state_colors(self, state):
        """(Füllung, Schrift) für „ruhend“, „hover“ oder „aktiv“ – wie gezeichnet."""
        if state == "hover":
            return self.hover_fill, self.legible_text(self.hover_text_color, self.hover_fill)
        if state == "aktiv" and self.active_fill:
            schrift = self.active_text_color or self.hover_text_color
            return self.active_fill, self.legible_text(schrift, self.active_fill)
        return self.bg_color, self.legible_text(self.border_color, self.bg_color)

    @staticmethod
    def legible_text(text_color, fill):
        """Schrift, die auf dieser Füllung mindestens 4,5:1 erreicht.

        Beim Überfahren stand in den dunklen und bunten Designs weiße Schrift
        auf hellen Füllungen – auf Neongrün 1,3:1. Neutrale Schrift wechselt
        dann zur lesbaren Gegenfarbe, farbige wird im eigenen Ton nachgezogen.
        """
        try:
            if contrast_ratio(text_color, fill) >= 4.5:
                return text_color
            return readable_text_color(fill) if is_neutral_color(text_color) else legible_on(text_color, [fill])
        except (TypeError, ValueError):
            return text_color

    TEXT_INSET = 30

    def text_width(self):
        """Breite der Beschriftung in Pixeln – gemessen, nicht geschätzt."""
        try:
            return int(self.tk.call("font", "measure", self.font, self.text))
        except (tk.TclError, RuntimeError, ValueError):
            return 0

    def _fit_width(self):
        """Hält die Fläche mindestens so breit wie ihre Beschriftung."""
        if not getattr(self, "fit_text", False) or self.wrap_text:
            return
        noetig = self.text_width() + self.TEXT_INSET + (14 if self.text_anchor == "w" else 0)
        if noetig <= self.min_width:
            return
        self.min_width = noetig
        try:
            if int(self.cget("width")) < noetig:
                self.configure(width=noetig)
        except (tk.TclError, ValueError):
            pass

    def _rounded_rect(self, x1, y1, x2, y2, radius, fill, outline, width=1):
        return self.create_polygon(
            rounded_rect_points(x1, y1, x2, y2, radius),
            smooth=True, splinesteps=24, fill=fill, outline=outline, width=width,
        )

    def _draw(self):
        self.delete("all")
        w = max(self.winfo_width(), 30)
        h = self.winfo_height() if self.winfo_height() > 1 else self.height
        pad = 2

        if self.is_hovered:
            fill = self.hover_fill
            text_color = self.hover_text_color
        elif self.active_fill:
            fill = self.active_fill
            text_color = self.active_text_color or self.hover_text_color
        else:
            fill = self.bg_color
            text_color = self.border_color
        text_color = self.legible_text(text_color, fill)
        focused = self.focus_get() is self
        border_width = 2 if focused else 1.4

        if self.is_pressed and self.is_hovered:
            pad = 3
            border_width = 1.8

        self._rounded_rect(
            pad,
            pad,
            w - pad,
            h - pad,
            self.radius,
            fill=fill,
            outline=(self.border_color if focused else fill) if not self.outline
                    else (fill if (self.active_fill or self.is_hovered) else self.border_color),
            width=border_width if self.outline or focused else 0,
        )
        text_id = self.create_text(
            14 if self.text_anchor == "w" else w / 2,
            h / 2,
            text=self.text,
            fill=text_color,
            font=self.font,
            anchor=self.text_anchor,
            justify="left" if self.text_anchor == "w" else "center",
            width=max(20, w - 28) if self.wrap_text else 0,
        )
        if self.wrap_text and self.winfo_width() > 1:
            bounds = self.bbox(text_id)
            needed = max(self.height, bounds[3] - bounds[1] + 16)
            if int(self.cget("height")) != needed:
                self.configure(height=needed)
        paint_canvas_backdrop(self)

    def _on_enter(self, _event):
        self.is_hovered = True
        self._draw()

    def _on_leave(self, _event):
        self.is_hovered = False
        self.is_pressed = False
        self._draw()

    def _on_press(self, _event):
        self.is_pressed = True
        self._draw()

    def _on_keyboard_activate(self, _event):
        if callable(self.command):
            self.command()
        return "break"

    def _on_release(self, event):
        was_pressed = self.is_pressed
        self.is_pressed = False
        inside = 0 <= event.x <= self.winfo_width() and 0 <= event.y <= self.winfo_height()
        self._draw()
        if was_pressed and inside and callable(self.command):
            self.command()


class ButtonFlow(tk.Frame):
    """Behält lesbare Buttonbreiten und bricht bei Bedarf in neue Zeilen um."""

    def __init__(self, master, bg, gap=8, align="w"):
        super().__init__(master, bg=bg)
        self.gap = gap
        # „e“ setzt die Knopfreihe rechts wie in den übrigen Dialogen (W05).
        self.align = align
        self.columnconfigure(0, weight=1)
        self.entries = []
        self.compact_keys = None
        self.compact_below = 0
        self._rows = []
        self._reflow_pending = None
        self._layout_signature = None
        bind_resize(self, self.schedule_reflow)
        self.bind("<Destroy>", self.cancel_reflow, add="+")

    def add(self, button, key=None):
        self.entries.append((button, key))
        self.schedule_reflow()
        return button

    def schedule_reflow(self, _event=None):
        """Mehrere neue Knöpfe und Größenmeldungen ergeben einen Layoutdurchlauf."""
        if self._reflow_pending is None:
            self._reflow_pending = self.after_idle(self.reflow)

    def cancel_reflow(self, event=None):
        if event is not None and event.widget is not self:
            return
        if self._reflow_pending is not None:
            self.after_cancel(self._reflow_pending)
            self._reflow_pending = None

    def reflow(self, _event=None):
        self.cancel_reflow()
        width = max(1, self.winfo_width())
        compact = self.compact_keys is not None and width < self.compact_below
        bg = self.cget("bg")
        visible, hidden = [], []
        for button, key in self.entries:
            try:
                if not button.winfo_exists():
                    continue
            except tk.TclError:
                continue
            if compact and key not in self.compact_keys:
                hidden.append(button)
                continue
            visible.append((button, button.winfo_reqwidth() + self.gap))
        signature = (width, bg, self.gap, tuple(visible), tuple(hidden))
        if signature == self._layout_signature:
            return
        self._layout_signature = signature
        for button in hidden:
            button.grid_remove()
        row, column, used = 0, 0, 0
        for button, needed in visible:
            if used and used + needed > width:
                row, column, used = row + 1, 0, 0
            try:
                while len(self._rows) <= row:
                    self._rows.append(tk.Frame(self, bg=bg))
                frame = self._rows[row]
                if column == 0:
                    frame.configure(bg=bg)
                    frame.grid(row=row, column=0, sticky=self.align)
                button.grid(in_=frame, row=0, column=column, sticky="w", padx=(0, self.gap), pady=(3, 3))
                button.tk.call("raise", button._w)
            except tk.TclError:
                continue
            used += needed
            column += 1
        for frame in self._rows[row + 1 if visible else 0:]:
            frame.grid_remove()


class ResponsiveColumns(tk.Frame):
    """Zwei Spalten, die bei zu wenig Platz untereinander rutschen.

    Die Punktmaske ist über die Versionen gewachsen –
    Titel, Art, Farbe, Wichtigkeit, Fälligkeit, Wiederholung, Erinnerung,
    Bearbeitungstag, Aufwand, Labels, Beschreibung, Checkliste und Anhänge.
    Untereinander ergibt das ein Fenster, das auf jedem Bildschirm scrollt,
    obwohl daneben die halbe Breite leer bleibt. Die Einstellungen lösen das
    seit 3.7 mit Abschnitten nebeneinander; diese Klasse bringt dasselbe in
    jede andere Maske.

    Die Schwelle ist keine Fenstergröße, sondern die Summe dessen, was eine
    Spalte braucht, um lesbar zu bleiben: zweimal `min_column_width` plus der
    Zwischenraum. Darunter steht alles wieder untereinander – und zwar
    vollständig, nicht gequetscht.
    """

    # Eine Spalte trägt ein Aufklappfeld samt Beschriftung
    # und zwei Felder nebeneinander. 330 Pixel reichten dafür nicht: Bei genau
    # dieser Breite standen zwei Spalten so eng, dass Beschriftungen umbrachen
    # und Datumsfelder auf zwei Zeilen fielen.
    # 380 reichte, damit nichts abbricht – aber nicht, damit
    # eine Spalte lesbar bleibt: Beschriftungen wie „Farbe des Listenpunkts“
    # oder „Geschätzter Aufwand in Minuten“ füllten die Zeile bis zum Rand, und
    # das Fenster öffnete an seiner eigenen Untergrenze. 440 ist die Breite,
    # bei der Beschriftung und Feldinhalt nebeneinander Luft behalten.
    MIN_COLUMN_WIDTH = 440

    @classmethod
    def required_width(cls, gap=24, chrome=0, min_column_width=None):
        """Die Fensterbreite, ab der zwei Spalten nebeneinander stehen.

        Die Masken setzten ihre Mindestbreite vorher als
        Zahl – 760 hier, 700 dort. Lag sie knapp über der Umbruchschwelle,
        öffnete das Fenster zweispaltig und gequetscht zugleich. Wer die
        Schwelle kennt, rechnet die Breite aus ihr aus, statt sie zu raten.
        `chrome` ist, was neben den Spalten liegt: Ränder und Bildlaufleiste.
        """
        return (min_column_width or cls.MIN_COLUMN_WIDTH) * 2 + gap + chrome

    def __init__(self, master, bg, gap=24, min_column_width=MIN_COLUMN_WIDTH):
        super().__init__(master, bg=bg)
        self.gap = gap
        self.min_column_width = min_column_width
        self.left = tk.Frame(self, bg=bg)
        self.right = tk.Frame(self, bg=bg)
        self._wide = None
        bind_resize(self, self.reflow)
        self.reflow()

    def wide_enough(self, width=None):
        if width is None:
            width = self.winfo_width()
        if width <= 1:
            return True
        return width >= self.min_column_width * 2 + self.gap

    def reflow(self, event=None):
        breit = self.wide_enough(event.width if event is not None else None)
        if breit == self._wide:
            return
        self._wide = breit
        for spalte in (self.left, self.right):
            spalte.grid_forget()
        if breit:
            self.columnconfigure(0, weight=1, uniform="spalte")
            self.columnconfigure(1, weight=1, uniform="spalte")
            self.left.grid(row=0, column=0, sticky="new")
            self.right.grid(row=0, column=1, sticky="new", padx=(self.gap, 0))
        else:
            self.columnconfigure(0, weight=1, uniform="")
            self.columnconfigure(1, weight=0, uniform="")
            self.left.grid(row=0, column=0, columnspan=2, sticky="ew")
            self.right.grid(row=1, column=0, columnspan=2, sticky="ew", pady=(self.gap, 0))


class BoardPreview(tk.Canvas):
    """Skaliert Vorschaugeometrie; leere Bestände bleiben leer.

    Eine vom Aufrufer ausdrücklich verdichtete Übersicht verändert niemals
    gespeicherte Positionen. Innenlinien würden kleine Karten verdecken.
    """

    def __init__(self, master, bg_color, card_color, line_color, border_color,
                 height=132, radius=5):
        super().__init__(master, bg=bg_color, height=height, bd=0,
                         highlightthickness=0, takefocus=0, cursor="hand2")
        self.bg_color = bg_color
        self.card_color = card_color
        self.line_color = line_color
        self.border_color = border_color
        self.radius = radius
        self._boxes = []
        self._links = []
        bind_resize(self, lambda _event: self.redraw())

    def set_content(self, boxes, links):
        """`boxes` sind (x, y, Breite, Höhe) in Flächenkoordinaten."""
        self._boxes = list(boxes or [])
        self._links = [(a, b) for a, b in (links or ())
                       if 0 <= a < len(self._boxes) and 0 <= b < len(self._boxes)]
        self.redraw()

    def _fitted(self, breite, hoehe):
        """Rechnet die Flächenkoordinaten in die Kachelfläche um."""
        rand = 8
        nutz_b, nutz_h = max(1, breite - 2 * rand), max(1, hoehe - 2 * rand)
        if not self._boxes:
            return []
        links = min(box[0] for box in self._boxes)
        oben = min(box[1] for box in self._boxes)
        rechts = max(box[0] + box[2] for box in self._boxes)
        unten = max(box[1] + box[3] for box in self._boxes)
        skala = min(nutz_b / max(1.0, rechts - links), nutz_h / max(1.0, unten - oben))
        versatz_x = rand + (nutz_b - (rechts - links) * skala) / 2
        versatz_y = rand + (nutz_h - (unten - oben) * skala) / 2
        return [((box[0] - links) * skala + versatz_x, (box[1] - oben) * skala + versatz_y,
                 box[2] * skala, box[3] * skala) for box in self._boxes]

    def redraw(self):
        self.delete("all")
        breite, hoehe = self.winfo_width(), self.winfo_height()
        if breite <= 1 or hoehe <= 1:
            return
        self.configure(bg=self.bg_color)
        if not self._boxes:
            return
        for x in range(10, breite, 18):
            for y in range(10, hoehe, 18):
                self.create_oval(x, y, x + 1, y + 1, fill=self.border_color,
                                 outline="")
        flaechen = self._fitted(breite, hoehe)
        verbindungen = self._links
        for a, b in verbindungen:
            if a >= len(flaechen) or b >= len(flaechen):
                continue
            x1 = flaechen[a][0] + flaechen[a][2] / 2
            y1 = flaechen[a][1] + flaechen[a][3] / 2
            x2 = flaechen[b][0] + flaechen[b][2] / 2
            y2 = flaechen[b][1] + flaechen[b][3] / 2
            self.create_line(x1, y1, x2, y2, fill=self.line_color, width=1.6,
                             arrow="last")
        for index, (x, y, w, h) in enumerate(flaechen):
            # Mindestgröße: Eine auf Bruchteile eines Pixels geschrumpfte Karte
            # wäre ein Punkt und keine Karte mehr.
            w, h = max(6.0, w), max(4.0, h)
            self.create_rectangle(x + 2, y + 2, x + w + 2, y + h + 2,
                                  fill=self.border_color, outline="")
            self.create_rectangle(x, y, x + w, y + h, fill=self.card_color,
                                  outline=self.line_color, width=1)
            band = max(2.0, min(6.0, h * 0.16))
            self.create_rectangle(x, y, x + w, y + band,
                                  fill=self.line_color, outline="")
            if w >= 18 and h >= 10:
                inset = max(2.0, w * 0.09)
                line_y = y + band + max(2.0, h * 0.18)
                self.create_line(x + inset, line_y, x + w * 0.72, line_y,
                                 fill=self.line_color, width=1)
                self.create_line(x + inset, line_y + max(2.0, h * 0.18),
                                 x + w * (0.48 + (index % 3) * 0.08),
                                 line_y + max(2.0, h * 0.18),
                                 fill=self.border_color, width=1)


class MascotCanvas(tk.Canvas):
    """Der Arbeitsbegleiter, gezeichnet statt geladen.

    Die Entscheidung
    `docs/decisions/ARBEITSBEGLEITER.md` hält fest, wie die Figur später
    geliefert wird – PNG in festen Größen, je Zustand ein Satz, Vektorquelle im
    Grafikmaster. Diese Dateien gibt es noch nicht, und bis sie da sind, wäre
    eine leere Kachel die schlechtere Antwort als eine gezeichnete Figur: Sie
    braucht keine Datei, keine neue Abhängigkeit und kein Farbprofil, sie folgt
    jedem Design von selbst – auch den beiden Minimaldesigns – und sie
    verschwindet rückstandslos, sobald echte Bilder da sind. Die Zustände sind
    dieselben fünf wie im Entscheidungsdokument; wer die PNG nachliefert,
    tauscht die Zeichenbefehle gegen `tk.PhotoImage` und lässt alles Übrige
    stehen.

    Die Figur ist eine eigene Erfindung: ein rundes Wesen mit Antenne, ohne
    Vorbild und ohne Namen. Den Namen vergibt, wer will, in der Kachel.
    """

    STATES = ("ruhig", "winkt", "freut", "sorgt", "schlaeft")
    BLINK_PERIOD = 4200
    BLINK_LENGTH = 140

    def __init__(self, master, app, size=104, bg_key="card"):
        super().__init__(master, width=size, height=size, bd=0, highlightthickness=0,
                         takefocus=1, cursor="hand2")
        self.app = app
        self.size = int(size)
        self.bg_key = bg_key
        self.state_name = "ruhig"
        self._blink = False
        self._hop = 0.0
        self._jobs = []
        bind_resize(self, lambda _event: self.redraw())
        self.bind("<Destroy>", self._stop, add="+")

    def _stop(self, event=None):
        if event is not None and event.widget is not self:
            return
        for job in self._jobs:
            try:
                self.after_cancel(job)
            except tk.TclError:
                pass
        self._jobs = []

    def _later(self, delay, callback):
        try:
            self._jobs.append(self.after(delay, callback))
        except tk.TclError:
            pass

    def set_state(self, name):
        self.state_name = name if name in self.STATES else "ruhig"
        self.redraw()

    def start(self):
        """Beginnt das Blinzeln – die einzige Bewegung im Ruhezustand."""
        if not self.app.animations_enabled() or not self.app.settings.get("mascot_playful", True):
            return
        self._schedule_blink()

    def _schedule_blink(self):
        def zu():
            if not self.winfo_exists():
                return
            self._blink = self.state_name != "schlaeft"
            self.redraw()
            self._later(self.BLINK_LENGTH, auf)

        def auf():
            if not self.winfo_exists():
                return
            self._blink = False
            self.redraw()
            self._later(self.BLINK_PERIOD, zu)

        self._later(self.BLINK_PERIOD, zu)

    def react(self, state="winkt", schritte=10):
        """Kurze Regung auf eine Berührung: ein Hüpfer und ein Zustand."""
        self.set_state(state)
        if not self.app.animations_enabled():
            return

        def schritt(index=0):
            if not self.winfo_exists():
                return
            if index >= schritte:
                self._hop = 0.0
                self.redraw()
                return
            self._hop = math.sin(index / schritte * math.pi) * 0.09
            self.redraw()
            self._later(34, lambda: schritt(index + 1))

        schritt()

    def redraw(self):
        if not self.winfo_exists():
            return
        self.delete("all")
        theme = self.app.theme
        # Der Grund ist die Farbe der Fläche darunter, nicht die Themenfarbe:
        # Auf getönten Kacheln (Milchglas, Akzentkacheln) stand Gismo sonst in
        # einem sichtbaren Rechteck, das bei jeder Animation neu aufblitzte
        # (Rückmeldung 27.09.2026).
        try:
            grund_farbe = str(self.master.cget("bg")) or theme[self.bg_key]
        except (tk.TclError, AttributeError):
            grund_farbe = theme[self.bg_key]
        self.configure(bg=grund_farbe)
        breite = max(self.winfo_width(), self.size)
        hoehe = max(self.winfo_height(), self.size)
        einheit = min(breite, hoehe) / 100.0
        mitte_x = breite / 2.0
        grund = hoehe - 10 * einheit - self._hop * hoehe
        koerper = theme["ui_accent"]
        kante = theme["line"]
        auge = theme["card"]
        pupille = theme["text"]
        zustand = self.state_name

        def e(wert):
            return wert * einheit

        # Füße
        for seite in (-1, 1):
            self.create_oval(mitte_x + seite * e(20) - e(11), grund - e(7),
                             mitte_x + seite * e(20) + e(11), grund + e(7),
                             fill=koerper, outline=kante)
        # Körper
        oben = grund - e(64)
        self.create_oval(mitte_x - e(34), oben, mitte_x + e(34), grund + e(2),
                         fill=koerper, outline=kante, width=1.4)
        # Antenne – ihre Neigung erzählt den Zustand mit
        neigung = {"ruhig": 0, "winkt": -14, "freut": 6, "sorgt": 16, "schlaeft": 22}[zustand]
        spitze_x = mitte_x + e(neigung)
        spitze_y = oben - e(20)
        self.create_line(mitte_x, oben + e(4), spitze_x, spitze_y, fill=kante, width=max(1.5, e(2)))
        self.create_oval(spitze_x - e(6), spitze_y - e(6), spitze_x + e(6), spitze_y + e(6),
                         fill=theme["confirm"] if zustand == "freut" else theme["flag"]
                         if zustand == "sorgt" else theme["card"], outline=kante)
        # Augen
        augen_y = oben + e(26)
        for seite in (-1, 1):
            x = mitte_x + seite * e(13)
            if zustand == "schlaeft" or self._blink:
                self.create_line(x - e(7), augen_y, x + e(7), augen_y, fill=pupille, width=max(1.5, e(2)))
                continue
            self.create_oval(x - e(9), augen_y - e(9), x + e(9), augen_y + e(9),
                             fill=auge, outline=kante)
            versatz = e(3) if zustand == "winkt" else 0
            self.create_oval(x - e(4) + versatz, augen_y - e(4), x + e(4) + versatz, augen_y + e(4),
                             fill=pupille, outline="")
        # Mund – ein Bogen, dessen Richtung den Zustand trägt
        mund_y = oben + e(44)
        if zustand == "sorgt":
            self.create_arc(mitte_x - e(13), mund_y, mitte_x + e(13), mund_y + e(16),
                            start=0, extent=180, style="arc", outline=pupille, width=max(1.5, e(2)))
        elif zustand == "schlaeft":
            self.create_line(mitte_x - e(7), mund_y + e(6), mitte_x + e(7), mund_y + e(6),
                             fill=pupille, width=max(1.5, e(2)))
        else:
            weite = e(19) if zustand == "freut" else e(13)
            self.create_arc(mitte_x - weite, mund_y - e(10), mitte_x + weite, mund_y + e(8),
                            start=200, extent=140, style="arc", outline=pupille, width=max(1.5, e(2)))
        # Winkende Hand
        if zustand == "winkt":
            self.create_oval(mitte_x + e(30), oben + e(12), mitte_x + e(46), oben + e(28),
                             fill=koerper, outline=kante)


class FieldPairGrid(tk.Frame):
    """Gleich breite Feldspalten, deren Eingabefelder auf einer Linie stehen.

    Zwei Felder nebeneinander bekamen bis 3.24 je eine Zelle,
    in der Beschriftung und Feld untereinander gepackt wurden. Bricht eine
    Beschriftung auf zwei Zeilen um – „Tagesziel · erledigte Aufgaben (0 = aus)“
    tut das in halber Spaltenbreite –, rutscht das Feld darunter eine Zeilenhöhe
    tiefer als sein Nachbar. Das Raster trennt deshalb beides: Beschriftungen
    stehen in einer eigenen Rasterzeile und werden an ihrer Unterkante
    ausgerichtet, die Felder in der nächsten. Ein Umbruch verschiebt dann nur
    noch die Beschriftung, nie das Feld.

    Nebenbei fällt damit auch die zweite Fehlerquelle weg: Beide Spalten
    bekommen denselben halben Zwischenraum, statt ihn einseitig zu tragen –
    sonst wäre die linke Spalte um den ganzen Zwischenraum schmaler als die
    rechte und die Feldkanten stünden versetzt.
    """

    def __init__(self, master, bg, columns=2, gap=16, uniform="feldpaar", responsive=False):
        super().__init__(master, bg=bg)
        self._bg = bg
        self._columns = max(1, int(columns))
        self._half = max(0, int(gap) // 2)
        self.columnconfigure(tuple(range(self._columns)), weight=1, uniform=uniform)
        self._cells = {}
        self._cell_padding = {}
        self._hidden_cells = set()
        self._responsive = responsive
        self._stacked = False
        self._uniform = uniform
        self.bind("<Configure>", self._resize_cells, add="+")

    def _resize_cells(self, event=None):
        stacked = self._responsive and self.winfo_width() < 720
        if stacked != self._stacked:
            self._stacked = stacked
            self.columnconfigure(0, weight=1, uniform="" if stacked else self._uniform)
            self.columnconfigure(1, weight=0 if stacked else 1, uniform="" if stacked else self._uniform)
        for (column, row), (label, field) in self._cells.items():
            if (column, row) in self._hidden_cells:
                label.grid_remove(); field.grid_remove()
                continue
            target_row = (row * self._columns + column) * 2 if stacked else row * 2
            target_column = 0 if stacked else column
            padding = (0, 0) if stacked else self._padx(column)
            top, bottom = self._cell_padding[(column, row)]
            label.grid(row=target_row, column=target_column, padx=padding, pady=(top, 0))
            field.grid(row=target_row + 1, column=target_column, padx=padding, pady=(0, bottom))

    def set_cell_visible(self, column, row, visible):
        key = (column, row)
        if visible:
            self._hidden_cells.discard(key)
        else:
            self._hidden_cells.add(key)
        self._resize_cells()

    def _padx(self, column):
        return (0 if column == 0 else self._half,
                0 if column == self._columns - 1 else self._half)

    def cell(self, column, row=0, pady=(0, 0)):
        """Gibt (Beschriftungsfläche, Feldfläche) einer Zelle zurück.

        In die Beschriftungsfläche gehört die Beschriftung mit
        `pack(side="bottom", fill="x")`, in die Feldfläche das Feld.
        """
        schluessel = (int(column), int(row))
        if schluessel not in self._cells:
            spalte, zeile = schluessel
            padx = self._padx(spalte)
            oben = tk.Frame(self, bg=self._bg)
            oben.grid(row=zeile * 2, column=spalte, sticky="sew", padx=padx, pady=(pady[0], 0))
            unten = tk.Frame(self, bg=self._bg)
            unten.grid(row=zeile * 2 + 1, column=spalte, sticky="new", padx=padx, pady=(0, pady[1]))
            self._cells[schluessel] = (oben, unten)
            self._cell_padding[schluessel] = pady
            self._resize_cells()
        return self._cells[schluessel]


class RoundedContainer(DeferredDrawCanvas):
    """Runde, themebare Box mit innenliegendem Frame für normale Tkinter-Widgets.

    Hinweis: Normale Tkinter-Widgets sind rechteckig. Damit sie die gerundeten Ecken
    nicht optisch überdecken, kann der innenliegende Frame zusätzlich eingerückt werden.
    """

    def __init__(self, master, bg_color, fill_color, outline_color=None, radius=18, padding=1, width=None, height=None, inner_pad_x=None, inner_pad_y=None, auto_height=False):
        kwargs = {
            "bg": bg_color,
            "highlightthickness": 0,
            "bd": 0,
        }
        if width is not None:
            kwargs["width"] = width
        if height is not None:
            kwargs["height"] = height
        super().__init__(master, **kwargs)
        self.bg_color = bg_color
        self.fill_color = fill_color
        self.outline_color = outline_color or fill_color
        self.radius = radius
        self.padding = padding
        self.inner_pad_x = padding if inner_pad_x is None else inner_pad_x
        self.inner_pad_y = padding if inner_pad_y is None else inner_pad_y
        self.auto_height = auto_height
        self.glass_mode = False
        self.glass_highlight = outline_color or fill_color
        self.glass_shadow = bg_color
        self.glass_gradient = ""
        self._auto_height_value = None
        self.inner = tk.Frame(self, bg=fill_color, bd=0, highlightthickness=0)
        self._window_id = self.create_window(
            self.inner_pad_x,
            self.inner_pad_y,
            anchor="nw",
            window=self.inner,
        )
        bind_resize(self, self._on_configure)
        if auto_height:
            self.inner.bind("<Configure>", self._sync_auto_height)
        self._draw()

    def _sync_auto_height(self, _event=None):
        """Lässt die Box in der Höhe ihrem Inhalt folgen.

        Eine Canvas hat keine automatische Größe – ohne diesen Abgleich bliebe
        eine Kachel auf der Standardhöhe stehen und schnitte ihren Inhalt ab.
        Der zwischengespeicherte Wert beendet die Kette: Das Setzen der Höhe
        löst selbst wieder ein <Configure> aus.
        """
        if not self.auto_height:
            return
        try:
            needed = max(1, self.inner.winfo_reqheight() + self.inner_pad_y * 2)
        except tk.TclError:
            return
        if needed == self._auto_height_value:
            return
        self._auto_height_value = needed
        try:
            self.configure(height=needed)
        except tk.TclError:
            pass

    def set_theme(self, bg_color, fill_color, outline_color=None,
                  glass_mode=None, glass_highlight=None, glass_shadow=None,
                  glass_gradient=None):
        self.bg_color = bg_color
        self.fill_color = fill_color
        self.outline_color = outline_color or fill_color
        if glass_mode is not None:
            self.glass_mode = bool(glass_mode)
        if glass_highlight is not None:
            self.glass_highlight = glass_highlight
        if glass_shadow is not None:
            self.glass_shadow = glass_shadow
        if glass_gradient is not None:
            self.glass_gradient = glass_gradient
        self.configure(bg=bg_color)
        self.inner.configure(bg=fill_color)
        self._draw()

    def _rounded_rect(self, x1, y1, x2, y2, radius, fill, outline, width=1):
        return self.create_polygon(
            rounded_rect_points(x1, y1, x2, y2, radius),
            smooth=True, splinesteps=24, fill=fill, outline=outline, width=width,
            tags=("surface",),
        )

    def _on_configure(self, _event=None):
        pad_x = self.inner_pad_x
        pad_y = self.inner_pad_y
        w = max(self.winfo_width(), pad_x * 2 + 2)
        h = max(self.winfo_height(), pad_y * 2 + 2)
        self.coords(self._window_id, pad_x, pad_y)
        if self.auto_height:
            # Höhe 0 heißt in Tk: Der eingebettete Frame bestimmt sie selbst.
            self.itemconfigure(self._window_id, width=max(1, w - pad_x * 2), height=0)
            self._sync_auto_height()
        else:
            self.itemconfigure(
                self._window_id,
                width=max(1, w - pad_x * 2),
                height=max(1, h - pad_y * 2),
            )
        self._schedule_draw()

    def _draw(self):
        self.delete("surface")
        w = max(self.winfo_width(), 4)
        h = max(self.winfo_height(), 4)
        pad = 1
        if self.glass_mode:
            # Eine zweite, dunkle Außenkante und eine helle Innenkante geben
            # der Fläche Tiefe, ohne einen plattformabhängigen Bildfilter zu
            # benötigen. Der Effekt bleibt auch im soliden Fallback lesbar.
            self._rounded_rect(
                pad, pad + 1, w - pad, h - pad + 1, self.radius,
                fill="", outline=self.glass_shadow, width=2,
            )
        self._rounded_rect(
            pad,
            pad,
            w - pad,
            h - pad,
            self.radius,
            fill=self.fill_color,
            outline=self.outline_color,
            width=1,
        )
        if self.glass_mode:
            self._draw_gradient(pad, h)
            self._rounded_rect(
                pad + 1, pad + 1, w - pad - 1, h - pad - 1,
                max(1, self.radius - 1), fill="", outline=self.glass_highlight, width=1,
            )
        self.tag_lower("surface")
        # Der Hintergrundverlauf liegt noch unter der Fläche: Er füllt die
        # Ecken außerhalb der Rundung.
        if self.find_withtag("backdrop"):
            self.tag_lower("backdrop")

    # Tiefe ohne Bildfilter.
    #
    # Tk zeichnet keine Verläufe. Ein Verlauf entsteht hier aus waagerechten
    # Linien mit schrittweise gemischter Farbe – der klassische Weg auf einer
    # Canvas. Zwei Vorkehrungen halten ihn billig: Es sind höchstens
    # GLASS_GRADIENT_STEPS Streifen, unabhängig von der Kartenhöhe, und sie
    # liegen nur im oberen Drittel, wo eine gewölbte Fläche das Licht fängt.
    # Darunter bleibt die volle Flächenfarbe stehen, sodass Text überall auf
    # demselben Grund sitzt und der Kontrast nicht wandert.
    GLASS_GRADIENT_STEPS = 12
    GLASS_GRADIENT_SHARE = 0.34

    def _draw_gradient(self, pad, height):
        farbe = getattr(self, "glass_gradient", "")
        if not farbe:
            return
        breite = max(self.winfo_width(), 4)
        # Der Glanz bleibt im oberen Innenrand. Bis 26.09.2026 reichte er über
        # ein Drittel der Karte – hinter die Beschriftungen, die als deckende
        # Tk-Labels in der Kartenfarbe darauf standen und so als helle Kästen
        # auf dem Glanz erschienen.
        hoehe = max(2, min(int((height - pad * 2) * self.GLASS_GRADIENT_SHARE), self.inner_pad_y + 1))
        stufen = min(self.GLASS_GRADIENT_STEPS, hoehe)
        if stufen < 2:
            return
        # Die Ecken bleiben frei: Der Verlauf wird nach oben hin schmaler, damit
        # er die gerundete Kante nicht als Treppe überzeichnet.
        for schritt in range(stufen):
            anteil = 1.0 - (schritt / (stufen - 1))
            oben = pad + 1 + int(schritt * hoehe / stufen)
            unten = pad + 1 + int((schritt + 1) * hoehe / stufen)
            einzug = max(0, int(self.radius * (1.0 - (schritt / max(1, stufen - 1))) * 0.45))
            self.create_rectangle(
                pad + 1 + einzug, oben, breite - pad - 1 - einzug, max(oben + 1, unten),
                fill=mix_hex_colors(self.fill_color, farbe, anteil * 0.9),
                outline="", tags=("surface",),
            )


def paint_canvas_backdrop(canvas):
    """Legt den Hintergrundverlauf als unterste Ebene in eine Canvas-Fläche.

    `canvas._backdrop` ist eine Folge von Stücken (Bild, x, y) oder None – nur
    die sichtbaren Teile der Fläche, bei Karten etwa nur die Ecken. Flächen, die
    beim Neuzeichnen alles löschen (Knöpfe, Scrollleisten), rufen das am Ende
    ihres Zeichnens.
    """
    try:
        canvas.delete("backdrop")
        info = getattr(canvas, "_backdrop", None)
        if not info:
            return
        for bild, x, y in info:
            canvas.create_image(x, y, image=bild, anchor="nw", tags=("backdrop",))
        canvas.tag_lower("backdrop")
    except tk.TclError:
        pass


class CanvasLabel(tk.Canvas):
    """Beschriftung ohne eigene Fläche: Text auf einer Canvas statt in einem Label.

    Ein Tk-Label malt immer ein deckendes Rechteck. Auf dem Hintergrundverlauf
    stünde der Seitentitel dann in einem Kasten. Diese Klasse zeichnet nur den
    Text; darunter liegt der Verlauf (`paint_canvas_backdrop`). Sie versteht die
    Label-Optionen, die Glide für Titel, Unterzeile, Kennzahlen und Hinweise
    benutzt: text, font, fg, bg, anchor, justify, wraplength, padx, pady.

    Reicht der Kontrast auf dem Verlauf unter dem Text nicht, legt
    `set_halo` eine Milchglas-Pille darunter.

    Gemessen wird wie bei einem Label (Rand 2 plus padx/pady um die
    Schrift). Die Textbox der Canvas ist waagrecht 1 Pixel je Seite breiter
    als die Schrift, senkrecht genau eine Zeilenhöhe; daher die Zuschläge
    `LABEL_INSET_X` und `LABEL_INSET_Y`. So bleiben Kopfzeile und Mindestgrößen
    so groß wie mit den früheren Labels.
    """

    LABEL_INSET_X = 1
    LABEL_INSET_Y = 2
    TEXT_OPTIONS = ("text", "font", "fg", "foreground", "anchor", "justify", "wraplength", "padx", "pady")

    def __init__(self, master, text="", font=None, fg=None, foreground=None, bg=None, background=None,
                 anchor="center", justify="left", wraplength=0, padx=1, pady=1, cursor="", takefocus=0,
                 **kwargs):
        farbe = bg or background
        if farbe is None:
            try:
                farbe = master.cget("bg")
            except tk.TclError:
                farbe = "#FFFFFF"
        optionen = {"highlightthickness": 0, "bd": 0, "bg": farbe, "cursor": cursor, "takefocus": takefocus,
                    "width": 1, "height": 1}
        optionen.update(kwargs)
        super().__init__(master, **optionen)
        self._opts = {"text": str(text), "font": font or "TkDefaultFont", "fg": fg or foreground or "#000000",
                      "anchor": anchor, "justify": justify, "wraplength": wraplength, "padx": padx, "pady": pady}
        self._halo = None
        self._fg_override = None
        self._text_ids = []
        self.bind("<Configure>", lambda _event: self._place_text(), add="+")
        self._render()

    # --- Label-Schnittstelle ---------------------------------------------
    def configure(self, cnf=None, **kwargs):
        if isinstance(cnf, dict):
            kwargs = {**cnf, **kwargs}
        elif isinstance(cnf, str) and not kwargs:
            if cnf in self.TEXT_OPTIONS:
                return (cnf, cnf, cnf, None, self.cget(cnf))
            return super().configure(cnf)
        eigene = {key: kwargs.pop(key) for key in list(kwargs) if key in self.TEXT_OPTIONS}
        if "background" in kwargs:
            kwargs["bg"] = kwargs.pop("background")
        if kwargs:
            super().configure(**kwargs)
        if eigene:
            if "foreground" in eigene:
                eigene["fg"] = eigene.pop("foreground")
            if "text" in eigene:
                eigene["text"] = str(eigene["text"])
            self._opts.update(eigene)
            self._render()
        return None

    config = configure

    def cget(self, key):
        if key == "foreground":
            key = "fg"
        if key in self._opts:
            return self._opts[key]
        if key == "background":
            key = "bg"
        return super().cget(key)

    def __getitem__(self, key):
        return self.cget(key)

    def __setitem__(self, key, value):
        self.configure(**{key: value})

    # --- Zeichnen --------------------------------------------------------
    def set_halo(self, farbe):
        """Farbe einer dezenten Glas-Pille hinter dem Text – oder None.

        Eine Kontur um jeden Buchstaben wirkte fett und unruhig. Die Pille
        liegt wie ein Stück Milchglas unter der Zeile.
        """
        if farbe != self._halo:
            self._halo = farbe
            self._render()

    def set_contrast_fg(self, farbe):
        """Schriftfarbe für den Verlauf darunter – oder None für die Farbe des Designs.

        Die Rolle (etwa „muted“) bleibt in `cget("fg")` erhalten; nur die
        Darstellung weicht im eigenen Farbton so weit aus, wie der Verlauf an
        dieser Stelle es für 4,5:1 verlangt.
        """
        if farbe != self._fg_override:
            self._fg_override = farbe
            try:
                self.itemconfigure("text", fill=farbe or self._opts["fg"])
            except tk.TclError:
                pass

    def text_size(self):
        """(Breite, Höhe) des Texts einschließlich Innenabstand – wie `winfo_reqwidth` eines Labels."""
        return self._required

    def _render(self):
        self.delete("text")
        o = self._opts
        breite = int(float(o["wraplength"] or 0))
        gemeinsam = {"text": o["text"], "font": o["font"], "justify": o["justify"], "anchor": "nw",
                     "tags": ("text",)}
        if breite > 0:
            gemeinsam["width"] = breite
        self._text_ids = []
        haupt = self.create_text(0, 0, fill=self._fg_override or o["fg"], **gemeinsam)
        self._text_ids.append((haupt, 0, 0))
        box = self.bbox(haupt) or (0, 0, 0, 0)
        padx = int(float(o["padx"] or 0)) + self.LABEL_INSET_X
        pady = int(float(o["pady"] or 0)) + self.LABEL_INSET_Y
        self._text_w, self._text_h = box[2] - box[0], box[3] - box[1]
        self._required = (self._text_w + 2 * padx, self._text_h + 2 * pady)
        super().configure(width=max(1, self._required[0]), height=max(1, self._required[1]))
        self._place_text()
        paint_canvas_backdrop(self)

    def _place_text(self):
        o = self._opts
        breite = self.winfo_width() if self.winfo_width() > 1 else self._required[0]
        hoehe = self.winfo_height() if self.winfo_height() > 1 else self._required[1]
        padx = int(float(o["padx"] or 0)) + self.LABEL_INSET_X
        pady = int(float(o["pady"] or 0)) + self.LABEL_INSET_Y
        anker = str(o["anchor"] or "center")
        if "w" in anker:
            x = padx
        elif "e" in anker:
            x = breite - padx - self._text_w
        else:
            x = (breite - self._text_w) / 2
        if anker.startswith("n"):
            y = pady
        elif anker.startswith("s"):
            y = hoehe - pady - self._text_h
        else:
            y = (hoehe - self._text_h) / 2
        for kennung, dx, dy in self._text_ids:
            self.coords(kennung, x + dx, y + dy)
        self.delete("pill")
        if self._halo:
            rand_x, rand_y = 6, 2
            self.create_polygon(
                rounded_rect_points(x - rand_x, y - rand_y, x + self._text_w + rand_x, y + self._text_h + rand_y, 8),
                smooth=True, splinesteps=16, fill=self._halo, outline="", tags=("pill", "text"))
            self.tag_lower("pill", "text")


class ThemedAutoScrollbar(tk.Canvas):
    """Themebare Canvas-Scrollbar ohne native weiße Windows-/Tk-Hintergründe.

    „Auto“ heißt seit 3.0 auch: Sie zeigt sich nur, wenn es etwas zu scrollen
    gibt. Vorher zeichnete sie bei vollständig sichtbarem Inhalt einen Regler
    über die ganze Höhe – optisch eine Leiste, die nichts tat.
    """

    # Ab diesem sichtbaren Anteil gilt der Inhalt als vollständig sichtbar.
    # Knapp unter 1, weil Tk gerundete Gleitkommawerte liefert.
    FULLY_VISIBLE_RATIO = 0.999

    def __init__(
        self,
        master,
        bg_color,
        track_color,
        thumb_color,
        active_thumb_color,
        width=14,
        radius=7,
        orient="vertical",
    ):
        # 3.22.0: dieselbe Leiste auch waagerecht. „width" bleibt die Dicke der
        # Leiste – quer ist das ihre Höhe. Die Pinnwand hatte als einzige
        # Fläche der App noch eine native ttk-Leiste im Systemstil.
        self.orient = "horizontal" if orient == "horizontal" else "vertical"
        super().__init__(
            master,
            bg=bg_color,
            highlightthickness=0,
            bd=0,
            cursor="hand2",
            **({"width": width} if self.orient == "vertical" else {"height": width}),
        )
        self.bg_color = bg_color
        self.track_color = track_color
        self.thumb_color = thumb_color
        self.active_thumb_color = active_thumb_color
        self.bar_width = width
        self.radius = radius
        self.command = None
        self.first = 0.0
        self.last = 1.0
        self.dragging = False
        self.drag_offset = 0
        self.is_hovered = False

        bind_resize(self, lambda _event: self._draw())
        self.bind("<Enter>", self._on_enter)
        self.bind("<Leave>", self._on_leave)
        self.bind("<ButtonPress-1>", self._on_press)
        self.bind("<B1-Motion>", self._on_motion)
        self.bind("<ButtonRelease-1>", self._on_release)

    def set_command(self, command):
        self.command = command

    def set_theme(self, bg_color, track_color, thumb_color, active_thumb_color):
        self.bg_color = bg_color
        self.track_color = track_color
        self.thumb_color = thumb_color
        self.active_thumb_color = active_thumb_color
        self.configure(bg=bg_color)
        self._draw()

    def set(self, first, last):
        try:
            self.first = max(0.0, min(1.0, float(first)))
            self.last = max(0.0, min(1.0, float(last)))
        except (TypeError, ValueError):
            self.first = 0.0
            self.last = 1.0
        self._draw()

    def _rounded_rect(self, x1, y1, x2, y2, radius, fill):
        return self.create_polygon(
            rounded_rect_points(x1, y1, x2, y2, radius),
            smooth=True, splinesteps=18, fill=fill, outline="",
        )

    def _metrics(self):
        """Maße der Leiste: quer (Dicke) und längs (Laufrichtung).

        Die Rückgabe heißt weiterhin x/y, meint aber „quer/längs". Waagerecht
        tauscht `_draw` beide Achsen; alles andere bleibt gleich.
        """
        if self.orient == "vertical":
            quer = max(self.winfo_width(), self.bar_width)
            laengs = max(self.winfo_height(), 30)
        else:
            quer = max(self.winfo_height(), self.bar_width)
            laengs = max(self.winfo_width(), 30)
        track_pad_x = max(3, int(quer * 0.28))
        track_pad_y = 4
        track_x1 = track_pad_x
        track_x2 = quer - track_pad_x
        track_y1 = track_pad_y
        track_y2 = laengs - track_pad_y
        track_h = max(1, track_y2 - track_y1)
        visible_ratio = max(0.05, min(1.0, self.last - self.first))
        thumb_h = max(28, int(track_h * visible_ratio))
        thumb_h = min(thumb_h, track_h)
        max_y = max(track_y1, track_y2 - thumb_h)
        thumb_y1 = track_y1 + int((track_h - thumb_h) * self.first / max(0.0001, 1.0 - visible_ratio)) if visible_ratio < 1 else track_y1
        thumb_y1 = max(track_y1, min(max_y, thumb_y1))
        thumb_y2 = thumb_y1 + thumb_h
        return track_x1, track_y1, track_x2, track_y2, thumb_y1, thumb_y2

    def _along(self, event):
        """Position eines Ereignisses in Laufrichtung."""
        return event.y if self.orient == "vertical" else event.x

    def _place(self, quer1, laengs1, quer2, laengs2, radius, fill):
        if self.orient == "vertical":
            self._rounded_rect(quer1, laengs1, quer2, laengs2, radius, fill)
        else:
            self._rounded_rect(laengs1, quer1, laengs2, quer2, radius, fill)

    def is_scrollable(self):
        """Gibt es überhaupt etwas zu scrollen?

        Tk meldet über set() den sichtbaren Anteil. Deckt er den ganzen Inhalt
        ab, gibt es nichts zu bewegen – dann bleibt die Leiste leer.
        """
        return (self.last - self.first) < self.FULLY_VISIBLE_RATIO

    def _draw(self):
        self.delete("all")
        paint_canvas_backdrop(self)
        # Nichts zu scrollen: nur die Fläche, keine Leiste. Der Platz bleibt
        # reserviert, damit der Inhalt daneben nicht springt, sobald er wächst.
        if not self.is_scrollable():
            return
        track_x1, track_y1, track_x2, track_y2, thumb_y1, thumb_y2 = self._metrics()
        track_radius = max(2, (track_x2 - track_x1) / 2)
        self._place(track_x1, track_y1, track_x2, track_y2, track_radius, self.track_color)
        thumb_color = self.active_thumb_color if self.is_hovered or self.dragging else self.thumb_color
        self._place(track_x1, thumb_y1, track_x2, thumb_y2, track_radius, thumb_color)

    def _on_enter(self, _event):
        if not self.is_scrollable():
            return
        self.is_hovered = True
        self._draw()

    def _on_leave(self, _event):
        self.is_hovered = False
        if not self.dragging:
            self._draw()

    def _on_press(self, event):
        if not self.is_scrollable():
            return
        _tx1, track_y1, _tx2, track_y2, thumb_y1, thumb_y2 = self._metrics()
        position = self._along(event)
        if thumb_y1 <= position <= thumb_y2:
            self.dragging = True
            self.drag_offset = position - thumb_y1
        else:
            thumb_h = thumb_y2 - thumb_y1
            self._moveto_from_thumb_y(position - thumb_h / 2, track_y1, track_y2, thumb_h)
        self._draw()

    def _on_motion(self, event):
        if not self.dragging:
            return
        _tx1, track_y1, _tx2, track_y2, thumb_y1, thumb_y2 = self._metrics()
        thumb_h = thumb_y2 - thumb_y1
        self._moveto_from_thumb_y(self._along(event) - self.drag_offset, track_y1, track_y2, thumb_h)

    def _on_release(self, _event):
        self.dragging = False
        self._draw()

    def _moveto_from_thumb_y(self, proposed_y, track_y1, track_y2, thumb_h):
        available = max(1, (track_y2 - track_y1) - thumb_h)
        fraction = (proposed_y - track_y1) / available
        fraction = max(0.0, min(1.0, fraction))
        if callable(self.command):
            self.command("moveto", fraction)


class DueField(tk.Frame):
    """Fälligkeit als eine Einheit: Datum, Uhrzeit und Zugang zum Kalender.

    Ein Datum lässt sich tippen oder anklicken – beide Wege schreiben in
    dasselbe Feld, sodass immer eine einzige Wahrheit gilt. Die Uhrzeit ist
    freiwillig und hängt am Datum: Ohne Tag gibt es keine Uhrzeit.

    Zwei Ausprägungen, eine Klasse:

    - kompakt (``compact=True``): Datum, Uhrzeit und ein Kalenderknopf. Der
      Monatskalender öffnet sich als eigenes Fenster. So sieht die Eingabemaske
      aus, in der neben der Frist auch Titel, Art, Farbe, Labels, Beschreibung
      und Anhänge Platz finden müssen.
    - vollständig: zusätzlich der eingebettete Monatskalender. So sieht das
      Kalenderfenster selbst aus, in dem der Kalender der Zweck ist.

    Bewusst eine eigene Klasse statt Code in jedem Dialog: Anlegen, Bearbeiten
    und jede spätere Stelle sollen sich hier gleich verhalten, und eine Änderung
    an der Fälligkeit soll nur an einer Stelle nötig sein.
    """

    def __init__(self, parent, app, due=None, due_time=None, on_change=None,
                 compact=False, dialog_parent=None, show_time=True):
        super().__init__(parent, bg=app.theme["bg"])
        self.app = app
        # Monats- und Wochentagsnamen kommen aus der App: Der Kalender im
        # Dialog und der große Kalender sollen dieselben Bezeichnungen zeigen.
        self.WEEKDAYS = tuple(app.WEEKDAYS_DE[-1:] + app.WEEKDAYS_DE[:-1] if app.settings.get("week_start") == "sunday" else app.WEEKDAYS_DE)
        self.MONTHS = tuple(app.MONTHS_DE)
        self.theme = app.theme
        self.on_change = on_change
        self.compact = bool(compact)
        self.show_time = bool(show_time)
        # Fenster, das den Grab zurückbekommt, wenn der Kalender sich schließt.
        self.dialog_parent = dialog_parent
        # Im kompakten Zustand gibt es keine Kalenderflächen. Die Attribute
        # bleiben trotzdem gesetzt, damit _render_month eine Bedingung prüft
        # statt jeder Aufrufer eine.
        self.month_label = None
        self.grid_frame = None
        self.calendar_button = None
        self._day_cells = []
        self._selected = app.normalize_due(due)
        reference = self._selected_date() or date.today()
        self._year, self._month = reference.year, reference.month

        self._build_inputs(app.normalize_due_time(due_time))
        if not self.compact:
            self._build_calendar()
            self._render_month()

    # --- Aufbau ---------------------------------------------------------
    def _build_inputs(self, time_value):
        row = tk.Frame(self, bg=self.theme["bg"])
        row.pack(fill="x")

        date_block = tk.Frame(row, bg=self.theme["bg"])
        date_block.pack(side="left", fill="x", expand=True)
        self.app._make_field_label(date_block, "Datum (TT.MM.JJJJ)").pack(
            anchor="w", pady=(0, self.app.FIELD_LABEL_GAP)
        )
        date_border, date_field = self.app._make_field(date_block)
        date_border.pack(fill="x")
        date_field.pack(fill="x", padx=self.app.FIELD_BORDER_WIDTH, pady=self.app.FIELD_BORDER_WIDTH)
        # Zehn Zeichen reichen für „TT.MM.JJJJ“; das Feld wächst trotzdem mit.
        # Mit der Tk-Vorgabe von 20 Zeichen verlangte es so viel Breite, dass
        # der Kalenderknopf daneben in der schmalen Maskenspalte auf 8 Pixel
        # schrumpfte.
        self.date_entry = self._entry(date_field, width=10)
        self.date_entry.pack(fill="x", padx=self.app.FIELD_PAD_X, pady=self.app.FIELD_PAD_Y)
        if self._selected:
            self.date_entry.insert(0, self.app.format_due_display(self._selected))

        if self.compact:
            # Der Knopf sitzt zwischen Datum und Uhrzeit, weil er das Datum
            # setzt. Die leere Beschriftung darüber hält ihn auf einer Linie
            # mit den beiden Feldern.
            picker_block = tk.Frame(row, bg=self.theme["bg"])
            picker_block.pack(side="left", padx=(8, 0))
            self.app._make_field_label(picker_block, " ").pack(
                anchor="w", pady=(0, self.app.FIELD_LABEL_GAP)
            )
            self.calendar_button = self._build_calendar_button(picker_block)
            self.calendar_button.pack()

        # Datum, Kalenderknopf und Uhrzeit nebeneinander
        # brauchen rund 330 Pixel. In der zweispaltigen Punktmaske kann die
        # Spalte schmaler sein; dann wandert die Uhrzeit unter das Datum,
        # statt auf vierzig Pixel zusammenzuschrumpfen, in denen „14:30“ nicht
        # mehr steht.
        self.time_block = time_block = tk.Frame(row, bg=self.theme["bg"], width=110)
        self.time_row = row
        time_block.pack(side="left", padx=(10, 0))
        if not self.show_time:
            time_block.pack_forget()
        else:
            self._time_below = None
            self.bind("<Configure>", self._sync_time_placement, add="+")
        self.app._make_field_label(time_block, "Uhrzeit (optional)").pack(
            anchor="w", pady=(0, self.app.FIELD_LABEL_GAP)
        )
        time_border, time_field = self.app._make_field(time_block)
        time_border.pack(fill="x")
        time_field.pack(fill="x", padx=self.app.FIELD_BORDER_WIDTH, pady=self.app.FIELD_BORDER_WIDTH)
        self.time_entry = self._entry(time_field, width=8)
        self.time_entry.pack(fill="x", padx=self.app.FIELD_PAD_X, pady=self.app.FIELD_PAD_Y)
        if time_value:
            self.time_entry.insert(0, time_value)

        # Eine Eingabe von Hand springt im Kalender auf den passenden Monat.
        self.date_entry.bind("<KeyRelease>", self._on_typed_date)
        self.date_entry.bind("<FocusOut>", self._on_typed_date)

    MIN_INLINE_TIME_WIDTH = 380

    def _sync_time_placement(self, event=None):
        """Legt die Uhrzeit neben oder unter das Datum – je nach Platz."""
        if not self.show_time or not hasattr(self, "time_block"):
            return
        breite = event.width if event is not None else self.winfo_width()
        if breite <= 1:
            return
        darunter = breite < self.MIN_INLINE_TIME_WIDTH
        if darunter == getattr(self, "_time_below", None):
            return
        self._time_below = darunter
        try:
            self.time_block.pack_forget()
            if darunter:
                self.time_block.pack(in_=self, fill="x", pady=(8, 0))
            else:
                self.time_block.pack(in_=self.time_row, side="left", padx=(10, 0))
        except tk.TclError:
            pass

    def _entry(self, field, width=None):
        entry = tk.Entry(
            field,
            bg=self.theme["input"], fg=self.theme["text"],
            insertbackground=self.theme["text"],
            selectbackground=self.theme["selection"], selectforeground=self.theme["selection_text"],
            relief="flat", bd=0, highlightthickness=0, font=app_font(11),
        )
        if width:
            entry.configure(width=width)
        return entry

    def _build_calendar_button(self, parent):
        return self.app._make_dialog_button(parent, self.app.ICONS["calendar"],
                                             self.open_calendar_dialog, "import", width=44, height=40)

    def open_calendar_dialog(self):
        """Öffnet den Monatskalender als eigenes Fenster und übernimmt das Ergebnis.

        Was gerade in den Feldern steht, ist der Ausgangswert – auch dann, wenn
        es von Hand getippt und noch nicht übernommen wurde.
        """
        typed_due = self.app.parse_due_input(self.date_entry.get())
        start_due = self._selected if typed_due is None else (typed_due or None)
        typed_time = self.app.parse_due_time_input(self.time_entry.get())
        start_time = (typed_time or None) if typed_time is not None else None
        chosen = self.app.themed_due_dialog(
            start_due, start_time,
            parent=self.dialog_parent or self.winfo_toplevel(),
            **({"title": "Bearbeitungstag", "show_time": False} if not self.show_time else {}),
        )
        if chosen is None:
            return
        due_value, time_value = chosen
        self.set_due(due_value)
        self.time_entry.delete(0, tk.END)
        if due_value and time_value:
            self.time_entry.insert(0, time_value)

    def _build_calendar(self):
        border, frame = self.app._make_calendar_surface(self)
        border.pack(fill="x", pady=(10, 0))
        frame.pack(fill="both", expand=True,
                   padx=self.app.FIELD_BORDER_WIDTH, pady=self.app.FIELD_BORDER_WIDTH)

        header = tk.Frame(frame, bg=self.theme["card"])
        header.pack(fill="x", padx=8, pady=(8, 4))
        self._nav_button(header, "‹", -1).pack(side="left")
        self.month_label = tk.Label(
            header, text="", bg=self.theme["card"], fg=self.theme["text"],
            font=app_font(11, "bold"),
        )
        self.month_label.pack(side="left", expand=True)
        self._nav_button(header, "›", 1).pack(side="right")

        weekday_row = tk.Frame(frame, bg=self.theme["card"])
        weekday_row.pack(fill="x", padx=8)
        for index, name in enumerate(self.WEEKDAYS):
            weekday_row.columnconfigure(index, weight=1, uniform="due_days")
            tk.Label(
                weekday_row, text=name, bg=self.theme["card"], fg=self.theme["muted"],
                font=app_font(8, "bold"),
            ).grid(row=0, column=index, sticky="ew", pady=(0, 2))

        self.grid_frame = tk.Frame(frame, bg=self.theme["card"])
        self.grid_frame.pack(fill="x", padx=8, pady=(0, 4))
        for index in range(7):
            self.grid_frame.columnconfigure(index, weight=1, uniform="due_days")

        actions = tk.Frame(frame, bg=self.theme["card"])
        actions.pack(fill="x", padx=8, pady=(0, 8))
        self._text_button(actions, "Heute", lambda: self.set_due(date.today().isoformat())).pack(side="left")
        self._text_button(actions, "Morgen", lambda: self.set_due((date.today() + timedelta(days=1)).isoformat())).pack(
            side="left", padx=(8, 0)
        )
        self._text_button(actions, "Keine Fälligkeit", lambda: self.set_due(None)).pack(side="right")

    def _nav_button(self, parent, label, delta):
        return self.app._make_dialog_button(parent, label, lambda: self._shift_month(delta),
                                             "muted", width=34, height=32)

    def _text_button(self, parent, label, command):
        width = tkfont.Font(font=app_font(10, "bold")).measure(label) + 26
        return self.app._make_dialog_button(parent, label, command, "import", width=width, height=34)

    def _add_hover(self, widget, base_bg, fg_hover=None):
        bind_theme_hover(widget, lambda: self.theme, base_bg, fg_hover)

    # --- Darstellung ----------------------------------------------------
    def _selected_date(self):
        if not self._selected:
            return None
        try:
            return datetime.strptime(self._selected, "%Y-%m-%d").date()
        except ValueError:
            return None

    def _shift_month(self, delta):
        self._year, self._month = self.app.shift_month(self._year, self._month, delta)
        self._render_month()

    def _render_month(self):
        # Im kompakten Zustand gibt es keinen eingebetteten Kalender. Der Guard
        # sitzt hier, damit set_due und _on_typed_date beide Ausprägungen
        # unverändert bedienen können.
        if self.month_label is None or self.grid_frame is None:
            return
        self.month_label.configure(text=f"{self.MONTHS[self._month - 1]} {self._year}")
        for cell in self._day_cells:
            cell.destroy()
        self._day_cells = []
        first_day, _last_day = self.app.calendar_month_grid(self._year, self._month)
        today = date.today()
        selected = self._selected_date()
        for offset in range(42):
            day = first_day + timedelta(days=offset)
            if offset >= 35 and day.month != self._month:
                break
            in_month = day.month == self._month
            if day == selected:
                bg, fg = self.theme["selection"], self.theme["selection_text"]
            elif day == today:
                bg, fg = self.theme["card"], self.theme["ui_accent"]
            else:
                bg = self.theme["card"]
                fg = self.theme["text"] if in_month else self.theme["placeholder"]
            if day == selected:
                cell = LabelChip(self.grid_frame, str(day.day), bg, fg, self.theme["card"],
                                 font=app_font(10, "bold" if day == today else "normal"))
                cell.configure(cursor="hand2")
            else:
                cell = tk.Label(
                    self.grid_frame, text=str(day.day), bg=bg, fg=fg,
                    font=app_font(10, "bold" if day == today else "normal"),
                    padx=2, pady=3, cursor="hand2",
                )
            cell.grid(row=offset // 7, column=offset % 7, sticky="ew", padx=1, pady=1)
            cell.bind("<Button-1>", lambda _event, chosen=day: self.set_due(chosen.isoformat()))
            if day != selected:
                self._add_hover(cell, bg)
            self._day_cells.append(cell)

    # --- Schnittstelle --------------------------------------------------
    def _on_typed_date(self, _event=None):
        parsed = self.app.parse_due_input(self.date_entry.get())
        if not parsed:
            return
        self._selected = parsed
        typed = self._selected_date()
        if typed:
            self._year, self._month = typed.year, typed.month
        self._render_month()

    def set_due(self, iso_value):
        """Setzt das Datum aus dem Kalender heraus und hält das Feld gleich."""
        self._selected = self.app.normalize_due(iso_value)
        self.date_entry.delete(0, tk.END)
        if self._selected:
            self.date_entry.insert(0, self.app.format_due_display(self._selected))
            chosen = self._selected_date()
            self._year, self._month = chosen.year, chosen.month
        else:
            # Ohne Datum ergibt eine Uhrzeit keinen Sinn.
            self.time_entry.delete(0, tk.END)
        self._render_month()
        if callable(self.on_change):
            self.on_change(self._selected)

    def read(self):
        """Liefert (due, due_time) oder None, wenn eine Eingabe unlesbar ist.

        Die Prüfung sitzt hier und nicht im Dialog, damit jede Verwendung
        dieselbe Fehlermeldung und dieselben zulässigen Schreibweisen bekommt.
        """
        parsed_due = self.app.parse_due_input(self.date_entry.get())
        if parsed_due is None:
            return None, "Bitte ein Datum im Format TT.MM.JJJJ eingeben."
        parsed_time = self.app.parse_due_time_input(self.time_entry.get()) if self.show_time else ""
        if parsed_time is None:
            return None, "Bitte eine Uhrzeit im Format HH:MM eingeben."
        if not parsed_due:
            return (None, None), None
        return (parsed_due, parsed_time or None), None


class DropdownPopup(tk.Frame):
    """Auswahlfläche im Elternfenster: kein Extra-Fenster und kein eigener Grab.

    Ein vorangestelltes Bindtag schließt auch dann, wenn das angeklickte Widget
    sein Ereignis selbst beendet. Alle temporären Bindings werden wieder gelöst.
    """

    def __init__(self, anchor, app, close):
        self.anchor, self.app, self.close = anchor, app, close
        self.owner = anchor.winfo_toplevel()
        previous = getattr(app, "_active_dropdown", None)
        if previous is not None:
            previous.close()
        super().__init__(self.owner, bg=app.theme["input_border"], bd=0, takefocus=True)
        app._active_dropdown = self
        self._tag = f"GlideDropdown{id(self)}"
        self._tagged = []
        self._bindings = []
        self._focus_job = None
        self.bind("<Destroy>", self._cleanup, add="+")

    def show(self, width, height, align="left"):
        """Öffnet die Fläche unter dem Auslöser.

        `align="right"` legt die rechte Kante der Fläche auf
        die rechte Kante des Auslösers. Ein Schalter am rechten Rand der
        Kopfleiste öffnete seine Auswahl sonst nach rechts und wurde dort an
        den Fensterrand geschoben – sie stand dann neben ihrem Auslöser statt
        unter ihm. `align="auto"` entscheidet danach, in welcher Fensterhälfte
        der Auslöser steht.
        """
        self.owner.update_idletasks()
        self._owner_geometry = self.owner.geometry()
        margin = 8
        width = max(1, min(width, self.owner.winfo_width() - 2 * margin))
        height = max(1, min(height, self.owner.winfo_height() - 2 * margin))
        x = self.anchor.winfo_rootx() - self.owner.winfo_rootx()
        if align == "auto":
            mitte = x + self.anchor.winfo_width() / 2
            align = "right" if mitte > self.owner.winfo_width() / 2 else "left"
        if align == "right":
            x = x + self.anchor.winfo_width() - width
        below = self.anchor.winfo_rooty() - self.owner.winfo_rooty() + self.anchor.winfo_height() + 2
        above = below - self.anchor.winfo_height() - height - 4
        y = below if below + height <= self.owner.winfo_height() - margin else above
        self.place(x=max(margin, min(x, self.owner.winfo_width() - width - margin)),
                   y=max(margin, min(y, self.owner.winfo_height() - height - margin)),
                   width=width, height=height)
        self.lift()
        self.focus_set()

        def tag(widget):
            if widget is self or (widget is not self.owner and isinstance(widget, (tk.Menu, tk.Toplevel))):
                return
            widget.bindtags((self._tag,) + widget.bindtags())
            self._tagged.append(widget)
            for child in widget.winfo_children():
                tag(child)
        tag(self.owner)
        for sequence in ("<ButtonPress-1>", "<ButtonPress-2>", "<ButtonPress-3>"):
            self.bind_class(self._tag, sequence, self._outside)
        self.bind_class(self._tag, "<Escape>", self._cancel)
        self.bind_class(self._tag, "<FocusOut>", self._focus_out)
        key = self.owner.bind("<FocusOut>", self._focus_out, add="+")
        self._bindings.append(("<FocusOut>", key))
        for sequence in ("<Configure>", "<Unmap>"):
            key = self.owner.bind(sequence, self._owner_changed, add="+")
            self._bindings.append((sequence, key))
        self.bind("<Escape>", self._cancel)
        self.bind("<FocusOut>", self._focus_out)

    def _outside(self, event):
        if not (self.winfo_rootx() <= event.x_root < self.winfo_rootx() + self.winfo_width()
                and self.winfo_rooty() <= event.y_root < self.winfo_rooty() + self.winfo_height()):
            self.close()
            # Der erste Klick schließt, ohne eine Aktion darunter auszulösen.
            return "break"

    def _cancel(self, _event=None):
        self.close()
        return "break"

    def _focus_out(self, _event=None):
        if self._focus_job is None:
            self._focus_job = self.after_idle(self._check_focus)

    def _check_focus(self):
        self._focus_job = None
        focused = self.app.current_focus_widget()
        if focused is None or focused.winfo_toplevel() is not self.owner:
            self.close(restore_focus=False)

    def _owner_changed(self, event):
        if event.widget is self.owner and (event.type == tk.EventType.Unmap
                                               or self.owner.geometry() != self._owner_geometry):
            self.close(restore_focus=False)

    def _cleanup(self, event):
        if event.widget is not self:
            return
        if getattr(self.app, "_active_dropdown", None) is self:
            self.app._active_dropdown = None
        if self._focus_job is not None:
            self.after_cancel(self._focus_job)
            self._focus_job = None
        for widget in self._tagged:
            try:
                widget.bindtags(tuple(tag for tag in widget.bindtags() if tag != self._tag))
            except tk.TclError:
                pass
        for sequence in ("<ButtonPress-1>", "<ButtonPress-2>", "<ButtonPress-3>", "<Escape>", "<FocusOut>"):
            self.unbind_class(self._tag, sequence)
        for sequence, key in self._bindings:
            self.owner.unbind(sequence, key)
        self._tagged.clear()
        self._bindings.clear()


class OptionRows(tk.Canvas):
    """Scrollbare Auswahlzeilen mit Chips und getrenntem Auswahlhaken."""

    def __init__(self, parent, app, options, menu, font, height):
        super().__init__(parent, bg=app.theme["input"], bd=0, highlightthickness=0,
                         height=height, takefocus=True, yscrollincrement=30)
        self.app, self.options = app, options
        self._selected = 0
        self.rows = []
        self.inner = tk.Frame(self, bg=app.theme["input"])
        self.window = self.create_window(0, 0, window=self.inner, anchor="nw")
        for index, value in enumerate(options):
            row = tk.Frame(self.inner, bg=app.theme["input"], cursor="hand2")
            row.pack(fill="x", pady=1)
            color = menu.entrycget(index, "foreground") or app.theme["text"]
            fill = mix_hex_colors(app.theme["input"], color, 0.22)
            chip = LabelChip(row, value, fill, app.theme["text"], app.theme["input"], font=font)
            chip.pack(side="left", padx=(6, 10), pady=4)
            mark = tk.Label(row, text="", bg=app.theme["input"], fg=app.theme["ui_accent"], font=font, width=2)
            mark.pack(side="right", padx=8)
            self.rows.append((row, chip, mark))
            for widget in (row, chip, mark):
                widget.bind("<Enter>", lambda e, i=index: self.paint(i, True))
                widget.bind("<Leave>", lambda e, i=index: self.paint(i))
                app._bind_canvas_wheel(widget, self)
        self.bind("<Configure>", self._layout)
        self.inner.bind("<Configure>", self._layout)

    def _layout(self, _event=None):
        self.itemconfigure(self.window, width=self.winfo_width())
        self.configure(scrollregion=super().bbox("all"))
        # Lange Namen bleiben vollständig lesbar, auch auf kleinen Dialogen.
        measure = tkfont.Font(font=self.rows[0][1].chip_font) if self.rows else None
        for index, (row, chip, mark) in enumerate(self.rows):
            text = self.options[index]
            available = max(50, self.winfo_width() - 65)
            while text and measure.measure(text) > available:
                text = text[:-1]
            shown = text + "…" if text != self.options[index] else text
            if shown != chip.chip_text:
                chip.chip_text = shown
                chip.chip_width, chip.chip_height = LabelChip.measure(shown, chip.chip_font)
                chip.configure(width=chip.chip_width)
                chip._draw()

    def paint(self, index, hover=False):
        row, chip, mark = self.rows[index]
        theme = self.app.theme
        bg = theme["hover"] if hover or index == self._selected else theme["input"]
        row.configure(bg=bg)
        chip.set_colors(bg_color=bg)
        mark.configure(bg=bg, text=self.app.ICONS["check"] if index == self._selected else "")

    def curselection(self):
        return (self._selected,)

    def selection_clear(self, *_args):
        pass

    def selection_set(self, index):
        old, self._selected = self._selected, index
        self.paint(old)
        self.paint(index)

    def activate(self, _index):
        pass

    def see(self, index):
        self.update_idletasks()
        row = self.rows[index][0]
        total = max(1, self.inner.winfo_height())
        first, last = self.yview()
        top, bottom = row.winfo_y(), row.winfo_y() + row.winfo_height()
        if top < first * total:
            self.yview_moveto(top / total)
        elif bottom > last * total:
            self.yview_moveto((bottom - self.winfo_height()) / total)

    def bbox(self, index):
        if not isinstance(index, int):
            return super().bbox(index)
        row = self.rows[index][0]
        return (0, row.winfo_rooty() - self.winfo_rooty(), row.winfo_width(), row.winfo_height())

    def nearest(self, y):
        return min(range(len(self.rows)), key=lambda i: abs(self.bbox(i)[1] + self.bbox(i)[3] / 2 - y))


class AppOptionMenu(tk.Label):
    """Plattformübergreifendes Auswahlfeld mit App-Farben und Tastaturbedienung."""

    def __init__(self, parent, app, variable, options):
        super().__init__(parent, textvariable=variable, takefocus=True, cursor="hand2")
        self.app, self.variable, self.options = app, variable, list(options)
        self._popup = None
        self._search_text, self._search_time = "", 0
        self.menu = tk.Menu(self, tearoff=False)
        for value in self.options:
            self.menu.add_command(label=value, command=lambda value=value: variable.set(value))
        self.arrow = tk.Label(self, text=app.ICONS["dropdown_closed"], bg=app.theme["input"], fg=app.theme["muted"],
                              font=app_font(11), cursor="hand2", padx=5, pady=0)
        # Genau so hoch wie das Feld: Mittig platziert war der Pfeil 4 Pixel
        # höher und stand oben und unten über den Feldrand hinaus.
        self.arrow.place(relx=1, rely=0, relheight=1, anchor="ne")
        self.arrow.bind("<Button-1>", self._toggle_popup)
        self.bind("<Button-1>", self._toggle_popup)
        for key in ("<space>", "<Return>", "<Down>", "<Up>"):
            self.bind(key, self._open_popup)
        self.bind("<FocusIn>", lambda e: self._paint_focus(True))
        self.bind("<FocusOut>", lambda e: self._paint_focus(False))
        self.bind("<Destroy>", self._on_destroy, add="+")
        self.bind("<Unmap>", lambda e: self._close_popup(restore_focus=False), add="+")

    def __getitem__(self, key):
        return self.menu if key == "menu" else super().__getitem__(key)

    def _paint_focus(self, focused):
        self.master.master.configure(bg=self.app.theme["selection" if focused else "input_border"])

    def _toggle_popup(self, _event=None):
        if self._popup is None:
            return self._open_popup()
        self._close_popup()
        return "break"

    def _open_popup(self, _event=None):
        if self._popup is not None or self.cget("state") == "disabled" or not self.options:
            return "break"
        self.focus_set()
        theme = self.app.theme
        popup = self._popup = DropdownPopup(self, self.app, self._close_popup)
        surface = tk.Frame(popup, bg=theme["input"])
        surface.pack(fill="both", expand=True, padx=1, pady=1)
        font = tkfont.Font(font=self.cget("font"))
        row_height = font.metrics("linespace") + 16
        choices = self._choices = OptionRows(surface, self.app, self.options, self.menu,
                                             self.cget("font"), min(7, len(self.options)) * row_height)
        scrollbar = ThemedAutoScrollbar(surface, theme["input"], theme["input"],
                                       theme["input_border"], theme["muted"])
        scrollbar.pack(side="right", fill="y")
        scrollbar.set_command(choices.yview)
        choices.configure(yscrollcommand=scrollbar.set)
        choices.pack(fill="both", expand=True, padx=6, pady=6)
        for index, parts in enumerate(choices.rows):
            for widget in parts:
                widget.bind("<ButtonRelease-1>", lambda e, i=index: self._choose_index(i))
            self.app.add_tooltip(parts[1], self.options[index])
        index = self.options.index(self.variable.get()) if self.variable.get() in self.options else 0
        self._highlight(index)
        choices.bind("<ButtonRelease-1>", self._choose_mouse)
        for sequence, delta in (("<Up>", -1), ("<Down>", 1)):
            choices.bind(sequence, lambda e, delta=delta: self._move(delta))
        choices.bind("<Home>", lambda e: self._highlight(0))
        choices.bind("<End>", lambda e: self._highlight(len(self.options) - 1))
        for sequence in ("<Return>", "<KP_Enter>", "<space>"):
            choices.bind(sequence, self._commit)
        choices.bind("<KeyPress>", self._type_ahead, add="+")
        choices.bind("<Escape>", self._cancel)
        choices.bind("<Tab>", lambda e: self._tab(False))
        choices.bind("<Shift-Tab>", lambda e: self._tab(True))
        choices.bind("<ISO_Left_Tab>", lambda e: self._tab(True))
        self.app.bind_mousewheel(choices)
        popup.update_idletasks()
        width = max(self.master.winfo_width(), min(580, max(font.measure(v) for v in self.options) + 80))
        popup.show(width, popup.winfo_reqheight())
        choices.focus_set()
        # Tk kann den Fokus in einer frisch geöffneten, modal gebundenen
        # Fläche auf macOS zunächst ablehnen. Die Auswahl muss trotzdem
        # unmittelbar per Pfeiltasten und Return bedienbar sein.
        try:
            choices.focus_force()
        except tk.TclError:
            pass
        self.arrow.configure(text=self.app.ICONS["dropdown_open"])
        self._search_text, self._search_time = "", 0
        return "break"

    def _highlight(self, index):
        self._choices.selection_clear(0, "end")
        self._choices.selection_set(index)
        self._choices.activate(index)
        self._choices.see(index)
        return "break"

    def _move(self, delta):
        selected = self._choices.curselection()
        index = selected[0] if selected else 0
        return self._highlight(max(0, min(len(self.options) - 1, index + delta)))

    def _type_ahead(self, event):
        if event.char and event.char.isprintable() and not event.char.isspace():
            now = time.monotonic()
            self._search_text = (self._search_text if now - self._search_time < 1 else "") + event.char.casefold()
            self._search_time = now
            for index, value in enumerate(self.options):
                if value.casefold().startswith(self._search_text):
                    return self._highlight(index)

    def _choose_index(self, index):
        self._highlight(index)
        return self._commit()

    def _choose_mouse(self, event):
        index = self._choices.nearest(event.y)
        box = self._choices.bbox(index)
        if box and 0 <= event.x < self._choices.winfo_width() and box[1] <= event.y < box[1] + box[3]:
            self._highlight(index)
            return self._commit()
        return "break"

    def _commit(self, _event=None):
        selected = self._choices.curselection()
        index = selected[0] if selected else None
        # Erst die Auswahlfläche schließen: StringVar-Beobachter können
        # unmittelbar einen weiteren Dialog (z. B. Wiederholung) öffnen.
        self._close_popup()
        if index is not None and self.winfo_exists():
            self.menu.invoke(index)
        return "break"

    def _cancel(self, _event=None):
        self._close_popup()
        return "break"

    def _tab(self, backwards):
        self._close_popup()
        target = self.tk_focusPrev() if backwards else self.tk_focusNext()
        if target is not None:
            target.focus_set()
        return "break"

    def _outside_click(self, event):
        popup = self._popup
        if popup is not None and not (
            popup.winfo_rootx() <= event.x_root < popup.winfo_rootx() + popup.winfo_width()
            and popup.winfo_rooty() <= event.y_root < popup.winfo_rooty() + popup.winfo_height()
        ):
            return self._cancel()

    def _close_popup(self, restore_focus=True):
        popup, self._popup = self._popup, None
        if popup is None:
            return
        try:
            popup.destroy()
            if self.winfo_exists():
                self.arrow.configure(text=self.app.ICONS["dropdown_closed"])
                if restore_focus:
                    self.focus_set()
        except tk.TclError:
            pass

    def destroy(self):
        self._close_popup(restore_focus=False)
        super().destroy()

    def _on_destroy(self, event):
        if event.widget is self:
            self._close_popup(restore_focus=False)


MacOptionMenu = AppOptionMenu  # Kompatibilität für bestehende interne Aufrufer.


class LabelDropdown(tk.Frame):
    """Labelauswahl als Aufklappfeld mit Mehrfachauswahl.

    Vorher lag die Auswahl als Chipfläche in der Maske und belegte gut 130
    Pixel – auch dann, wenn gar kein Label vergeben wurde. Geschlossen ist es
    jetzt eine Zeile wie jedes andere Feld; die Liste klappt darunter auf und
    bleibt für mehrere Klicks offen, weil ein Punkt selten genau ein Label
    bekommt.

    Die Farben gehen dabei nicht verloren: In der aufgeklappten Liste steht
    neben jedem Haken der echte Chip. Geschlossen zeigt das Feld die Namen im
    Klartext, weil dort eine Zeile Höhe zur Verfügung steht und nicht mehr.
    """

    VISIBLE_ROWS = 7
    ROW_HEIGHT = 30
    SUMMARY_MAX_NAMES = 3
    MIN_POPUP_WIDTH = 240

    def __init__(self, parent, app, labels, selected_ids=None,
                 empty_text="Keine Labels ausgewählt", dialog_parent=None,
                 allow_create=False, on_change=None):
        super().__init__(parent, bg=app.theme["bg"])
        self.app = app
        self.theme = app.theme
        self.labels = list(labels)
        known_ids = {label.get("id") for label in self.labels}
        # Nur bekannte Labels übernehmen: Ein Punkt kann eine Zuordnung tragen,
        # deren Label inzwischen gelöscht wurde.
        self.selected_ids = [
            label_id for label_id in (selected_ids or []) if label_id in known_ids
        ]
        self.empty_text = empty_text
        self.dialog_parent = dialog_parent
        self.allow_create = bool(allow_create)
        self.on_change = on_change
        self._rows = {}
        self._popup = None
        self._build()
        self.bind("<Destroy>", self._on_destroy, add="+")

    # --- Aufbau ---------------------------------------------------------
    def _build(self):
        border, field = self.app._make_field(self)
        border.pack(fill="x")
        field.pack(fill="x", padx=self.app.FIELD_BORDER_WIDTH, pady=self.app.FIELD_BORDER_WIDTH)
        inner = tk.Frame(field, bg=self.theme["input"])
        inner.pack(fill="x", padx=self.app.FIELD_PAD_X, pady=self.app.FIELD_PAD_Y - 1)

        self.summary_label = tk.Label(
            inner, text="", bg=self.theme["input"], fg=self.theme["text"],
            font=app_font(11), anchor="w", justify="left", takefocus=True,
        )
        self.summary_label.pack(side="left", fill="x", expand=True)
        self.arrow_label = tk.Label(
            inner, text="▾", bg=self.theme["input"], fg=self.theme["muted"],
            font=app_font(11),
        )
        self.arrow_label.pack(side="right")

        for widget in (field, inner, self.summary_label, self.arrow_label):
            widget.configure(cursor="hand2")
            widget.bind("<Button-1>", self._toggle_popup)
        for sequence in ("<space>", "<Return>", "<Down>", "<Up>"):
            self.summary_label.bind(sequence, self._toggle_popup)
        self.summary_label.bind("<FocusIn>", lambda e: border.configure(bg=self.theme["selection"]))
        self.summary_label.bind("<FocusOut>", lambda e: border.configure(bg=self.theme["input_border"]))
        self.bind("<Unmap>", lambda e: self._close_popup(restore_focus=False), add="+")
        self._update_summary()

    def _update_summary(self):
        names = [
            str(label.get("name", ""))
            for label in self.labels
            if label.get("id") in self.selected_ids
        ]
        if not names:
            self.summary_label.configure(text=self.empty_text, fg=self.theme["placeholder"])
            return
        if len(names) > self.SUMMARY_MAX_NAMES:
            shown = names[: self.SUMMARY_MAX_NAMES]
            text = ", ".join(shown) + f"  +{len(names) - len(shown)}"
        else:
            text = ", ".join(names)
        self.summary_label.configure(text=text, fg=self.theme["text"])

    # --- Aufklappen -----------------------------------------------------
    def _toggle_popup(self, _event=None):
        if self._popup is not None:
            self._close_popup()
        else:
            self._open_popup()
        return "break"

    def _open_popup(self):
        # Auch ohne vorhandene Labels aufklappbar – sonst wäre „Neues Label“
        # nicht erreichbar, solange noch keines angelegt ist.
        if self._popup is not None or not (self.labels or self.allow_create):
            return
        popup = self._popup = DropdownPopup(self, self.app, self._close_popup)
        surface = tk.Frame(popup, bg=self.theme["input"])
        surface.pack(fill="both", expand=True, padx=1, pady=1)

        # Die Bestätigung bekommt zuerst ihren festen Platz am unteren Rand.
        footer = tk.Frame(surface, bg=self.theme["input"])
        footer.pack(side="bottom", fill="x", padx=8, pady=8)
        done = self.app._make_dialog_button(footer, "Fertig", self._close_popup, "confirm", width=96, height=36)
        done.pack(side="right")
        if self.allow_create:
            create = self.app._make_dialog_button(footer, "+ Neues Label", self._create_label, "accent", width=150, height=36)
            create.pack(side="left", padx=(0, 8))
        list_area = tk.Frame(surface, bg=self.theme["input"])
        list_area.pack(fill="both", expand=True)

        scrolled = len(self.labels) > self.VISIBLE_ROWS
        if scrolled:
            self._labels_canvas, rows_frame = self.app._make_scroll_area(
                list_area, height=self.VISIBLE_ROWS * self.ROW_HEIGHT
            )
            self.app._bind_canvas_wheel(rows_frame, self._labels_canvas)
        else:
            self._labels_canvas = None
            rows_frame = tk.Frame(list_area, bg=self.theme["input"])
            rows_frame.pack(fill="both", expand=True, padx=6, pady=6)

        self._rows = {}
        for label in self.labels:
            self._build_row(rows_frame, label)

        popup.bind("<Return>", lambda event: self._finish())
        popup.bind("<space>", self._toggle_focused)
        popup.bind("<Up>", lambda event: self._move_focus(-1))
        popup.bind("<Down>", lambda event: self._move_focus(1))
        popup.bind("<Home>", lambda event: self._move_focus(-len(self.labels)))
        popup.bind("<End>", lambda event: self._move_focus(len(self.labels)))
        popup.bind("<Tab>", lambda event: self._tab(False))
        popup.bind("<Shift-Tab>", lambda event: self._tab(True))
        popup.bind("<ISO_Left_Tab>", lambda event: self._tab(True))
        self._focus_index = 0
        self._place_popup(popup)
        self.arrow_label.configure(text=self.app.ICONS["dropdown_open"])

    def _finish(self):
        self._close_popup()
        return "break"

    def _tab(self, backwards):
        self._close_popup()
        target = self.summary_label.tk_focusPrev() if backwards else self.summary_label.tk_focusNext()
        if target is not None:
            target.focus_set()
        return "break"

    def _move_focus(self, delta):
        if not self.labels:
            return "break"
        old = self._focus_index
        self._focus_index = max(0, min(len(self.labels) - 1, old + delta))
        self._paint_row(self.labels[old]["id"])
        key = self.labels[self._focus_index]["id"]
        self._paint_row(key, hover=True)
        if self._labels_canvas is not None:
            row = self._rows[key]["frame"]
            total = max(1, row.master.winfo_height())
            top, bottom = row.winfo_y(), row.winfo_y() + row.winfo_height()
            first, last = self._labels_canvas.yview()
            if top < first * total:
                self._labels_canvas.yview_moveto(top / total)
            elif bottom > last * total:
                self._labels_canvas.yview_moveto((bottom - self._labels_canvas.winfo_height()) / total)
        return "break"

    def _toggle_focused(self, _event=None):
        if self.labels:
            self.toggle_label(self.labels[self._focus_index]["id"])
        return "break"

    def _build_row(self, parent, label):
        row = tk.Frame(parent, bg=self.theme["input"], cursor="hand2")
        row.pack(fill="x", pady=1)
        chip = self.app.make_label_chip(row, label, bg_key="input")
        chip.pack(side="left", padx=(6, 10), pady=3)
        # Die Auswahlfläche beginnt hinter dem Chip. Dessen eigene Farbe und
        # runde Kante bleiben bei Auswahl und Hover unverändert sichtbar.
        mark = LabelChip(row, "✓", self.theme["input"], self.theme["input"], self.theme["input"],
                         font=app_font(10, "bold"))
        mark.pack(side="left", padx=5)
        label_id = label.get("id")
        self._rows[label_id] = {"frame": row, "chip": chip, "mark": mark}
        self._paint_row(label_id)

        def toggle(_event=None):
            self.toggle_label(label_id)
            return "break"

        parts = (row, mark, chip)
        for widget in parts:
            if self._labels_canvas is not None:
                self.app._bind_canvas_wheel(widget, self._labels_canvas)
            widget.bind("<Button-1>", toggle)
            widget.bind("<Enter>", lambda _e, key=label_id: self._paint_row(key, hover=True), add="+")
            widget.bind("<Leave>", lambda _e, key=label_id: self._paint_row(key), add="+")

    def _paint_row(self, label_id, hover=False):
        row = self._rows.get(label_id)
        if row is None:
            return
        selected = label_id in self.selected_ids
        try:
            surface = self.theme["hover"] if hover else self.theme["input"]
            row["frame"].configure(bg=surface)
            row["chip"].set_colors(bg_color=surface)
            row["mark"].set_colors(
                fill=self.theme["selection"] if selected else surface,
                text_color=self.theme["selection_text"] if selected else surface,
                outline=self.theme["selection"] if selected else surface,
                bg_color=surface,
            )
        except tk.TclError:
            pass

    def set_selected_ids(self, selected_ids):
        known = {label.get("id") for label in self.labels}
        self.selected_ids = list(dict.fromkeys(value for value in selected_ids if value in known))
        self._update_summary()
        for label_id in self._rows:
            self._paint_row(label_id)

    def toggle_label(self, label_id):
        label = next((value for value in self.labels if value.get("id") == label_id), None)
        if label is None:
            return False
        selected = label_id not in self.selected_ids
        chosen = [value for value in self.selected_ids if value != label_id]
        if selected:
            if self.app.is_system_label(label):
                # Die beiden Artlabels schließen sich gegenseitig aus.
                system_ids = {value.get("id") for value in self.labels if self.app.is_system_label(value)}
                chosen = [value for value in chosen if value not in system_ids]
            chosen.append(label_id)
        if len(chosen) > self.app.MAX_LABELS_PER_ITEM:
            self.app.show_warning(
                "Labels", f"Ein Punkt kann höchstens {self.app.MAX_LABELS_PER_ITEM} Labels tragen. "
                "Bitte zuerst ein anderes Label abwählen.", parent=self.dialog_parent or self.winfo_toplevel(),
            )
            return False
        self.set_selected_ids(chosen)
        if self.on_change is not None:
            self.on_change(label_id, selected)
        return True

    def _place_popup(self, popup):
        self.update_idletasks()
        popup.update_idletasks()
        popup.show(max(self.winfo_width(), self.MIN_POPUP_WIDTH), popup.winfo_reqheight())

    def _on_popup_click(self, event):
        if self._popup is not None:
            return self._popup._outside(event)

    def _close_popup(self, _event=None, restore_grab=True, restore_focus=True):
        popup, self._popup = self._popup, None
        if popup is None:
            return
        try:
            popup.destroy()
            self.arrow_label.configure(text=self.app.ICONS["dropdown_closed"])
            if restore_focus and restore_grab and self.winfo_exists():
                self.summary_label.focus_set()
        except tk.TclError:
            pass

    def _on_destroy(self, event=None):
        if event is not None and event.widget is not self:
            return
        self._close_popup(restore_grab=False, restore_focus=False)

    # --- Optik ----------------------------------------------------------
    def _hover(self, widget, base_bg, fg_hover=None):
        bind_theme_hover(widget, lambda: self.theme, base_bg, fg_hover)

    def _hover_group(self, widgets):
        """Zeile, Haken und Chip wechseln gemeinsam die Fläche."""
        def enter(_event=None):
            for widget in widgets:
                try:
                    widget.configure(bg=self.theme["hover"])
                except tk.TclError:
                    pass

        def leave(_event=None):
            for widget in widgets:
                try:
                    widget.configure(bg=self.theme["input"])
                except tk.TclError:
                    pass

        for widget in widgets:
            widget.bind("<Enter>", enter, add="+")
            widget.bind("<Leave>", leave, add="+")

    def _create_label(self):
        """Legt ein Label an und wählt es gleich aus.

        Das Aufklappfeld schließt vorher: Zwei ineinander verschachtelte Griffe
        – hier die Liste, dort die Namensabfrage – enden sonst damit, dass
        keiner von beiden die Eingabe bekommt.
        """
        self._close_popup()
        label = self.app.create_label_interactively(
            parent=self.dialog_parent or self.winfo_toplevel()
        )
        if label is None:
            return
        self.labels.append(label)
        self.toggle_label(label.get("id"))

    # --- Schnittstelle --------------------------------------------------
    def read(self):
        """Gewählte Label-IDs in der Reihenfolge der Labelverwaltung."""
        chosen = set(self.selected_ids)
        return [label["id"] for label in self.labels if label.get("id") in chosen]


# Datumseingabe, „/“-Befehle und die deutsche Schnelleingabe (G01) stehen
# Tk-frei in capture_parser.py.


class FilterSelection(LabelDropdown):
    """Die vorhandene Chipauswahl, ohne Vergaberegeln für Labels an Aufgaben."""

    def toggle_label(self, identity):
        if not any(value.get("id") == identity for value in self.labels):
            return False
        selected = identity not in self.selected_ids
        values = [value for value in self.selected_ids if value != identity]
        if selected:
            values.append(identity)
        self.set_selected_ids(values)
        if self.on_change:
            self.on_change(identity, selected)
        return True


class SavedFilters:
    MAX_FILTERS = 100
    STATUS = {"Alle Aufgaben": "all", "Nur offene Aufgaben": "open", "Nur erledigte Aufgaben": "done"}
    IMPORTANCE = {"Jede Wichtigkeit": "all", "Keine Wichtigkeit": "0", "Niedrig": "1", "Mittel": "2", "Hoch": "3"}
    DUE = {"Jede Fälligkeit": "any", "Ohne Fälligkeit": "none", "Überfällig": "overdue",
           "Heute": "today", "Morgen": "tomorrow", "Nächste 7 Tage (ab heute)": "next7",
           "Nächste 30 Tage (ab heute)": "next30"}
    LABEL_MODE = {"Mindestens eines der Labels": "any", "Alle ausgewählten Labels": "all"}
    SOURCE = {"Alle Aufgabenquellen": "all", "Aus Seiten": "pages"}

    def __init__(self, app):
        self.app = app

    @classmethod
    def normalize_settings(cls, result):
        cleaned, seen = [], set()
        raw = result.get("saved_filters", [])
        for value in raw if isinstance(raw, list) else []:
            if not isinstance(value, dict):
                continue
            identity, name = value.get("id"), value.get("name")
            if (not isinstance(identity, str) or not identity or len(identity) > 120
                    or identity in seen or not isinstance(name, str) or not name.strip()):
                continue
            entry = {"id": identity, "name": " ".join(name.split())[:80]}
            query = value.get("query", "")
            entry["query"] = query.strip()[:500] if isinstance(query, str) else ""
            for key in ("list_ids", "label_ids"):
                values = value.get(key, [])
                entry[key] = list(dict.fromkeys(item for item in values
                    if isinstance(item, str) and item and len(item) <= 120))[:1000] if isinstance(values, list) else []
            for key, choices, default in (("status", cls.STATUS, "open"), ("importance", cls.IMPORTANCE, "all"),
                                          ("due", cls.DUE, "any"), ("label_mode", cls.LABEL_MODE, "any"),
                                          ("source", cls.SOURCE, "all")):
                option = value.get(key)
                entry[key] = option if isinstance(option, str) and option in choices.values() else default
            cleaned.append(entry)
            seen.add(identity)
            if len(cleaned) >= cls.MAX_FILTERS:
                break
        result["saved_filters"] = cleaned
        active = result.get("active_saved_filter")
        result["active_saved_filter"] = active if isinstance(active, str) and active in seen else None
        if result.get("view_mode") == "saved_filter" and result["active_saved_filter"] is None:
            result["view_mode"] = "home"
        return result

    def current(self):
        identity = self.app.settings.get("active_saved_filter")
        return next((value for value in self.app.settings.get("saved_filters", []) if value["id"] == identity), None)

    def entries(self, criteria=None, apply_filters=False, today=None):
        """Passende Aufgaben eines Filters; die Bedingungen wertet `filter_explain` aus (D-03)."""
        app = self.app
        criteria = criteria if criteria is not None else self.current()
        if criteria is None:
            return []
        today = today or date.today()
        results = []
        lists = set(criteria.get("list_ids", []))
        page_ids = glide_task_refs.sources(app.planning_lists(), pages_only=True) if criteria.get('source') == 'pages' else None
        # Archivierte Seiten sind aus der Planung heraus (3.30) – auch hier.
        for list_index, source in enumerate(app.planning_lists()):
            if lists and source.get("id") not in lists:
                continue
            for item_index, item in enumerate(app.walk_items(source.get("items", []))):
                if not app.is_schedulable_item(item):
                    continue
                if not glide_filter_explain.matches(self.conditions(criteria, source, item, page_ids, today)):
                    continue
                if apply_filters and (not app.item_text_matches_query(item, app.current_search_query())
                                      or not app.item_matches_status_filter(item)):
                    continue
                due = app.normalize_due(item.get("due"))
                results.append((due, list_index, item_index, source, item))
        results.sort(key=lambda value: (value[0] or "9999-12-31", value[1], value[2]))
        return results

    def item_facts(self, criteria, source, item, page_ids=None):
        """Die Fakten eines Punkts für `filter_explain` – ohne Daten zu ändern."""
        app = self.app
        due = app.normalize_due(item.get("due"))
        query = str(criteria.get("query") or "").lower()
        return {"list_id": source.get("id"),
                "from_pages": page_ids is not None and item.get("id") in page_ids,
                "done": bool(item.get("done")),
                "importance": app.clamp_importance(item.get("importance", 0)),
                "labels": set(item.get("labels") or ()),
                "due": date.fromisoformat(due) if due else None,
                "query_match": app.item_text_matches_query(item, query) if query else True}

    def conditions(self, criteria, source, item, page_ids=None, today=None, names=None):
        return glide_filter_explain.conditions(criteria, self.item_facts(criteria, source, item, page_ids),
                                               today or date.today(), names)

    def names(self):
        werte = {entry.get("id"): str(entry.get("title") or "Liste") for entry in self.app.lists}
        werte.update({label.get("id"): str(label.get("name") or "Label") for label in self.app.labels})
        return werte

    def page_ids(self, criteria):
        return (glide_task_refs.sources(self.app.planning_lists(), pages_only=True)
                if criteria.get('source') == 'pages' else None)

    def explain_item(self, list_id, item_id):
        """Bedingungen des aktuellen Filters für einen Punkt mit erfüllt/verfehlt (D-03)."""
        criteria = self.current()
        source = next((entry for entry in self.app.lists if entry.get("id") == list_id), None)
        found = self.app.find_item_in_lists(item_id)
        if criteria is None or source is None or not found:
            return None
        return self.conditions(criteria, source, found[0], self.page_ids(criteria), names=self.names())

    def hidden_reasons(self, criteria=None):
        """(Zahl passend, Zahl ausgeblendet, [(Bedingung, Anzahl)]) über alle planbaren Aufgaben."""
        app = self.app
        criteria = criteria if criteria is not None else self.current()
        if criteria is None:
            return 0, 0, []
        page_ids, today = self.page_ids(criteria), date.today()
        passend, verfehlt = 0, []
        for source in app.planning_lists():
            for item in app.walk_items(source.get("items", [])):
                if not app.is_schedulable_item(item):
                    continue
                bedingungen = self.conditions(criteria, source, item, page_ids, today)
                if glide_filter_explain.matches(bedingungen):
                    passend += 1
                else:
                    verfehlt.append(bedingungen)
        return passend, len(verfehlt), glide_filter_explain.hidden_reasons(verfehlt)

    def summary(self, criteria):
        if not criteria:
            return "Gespeicherte Filter öffnen und eine Ansicht auswählen."
        parts = [next(name for name, key in self.STATUS.items() if key == criteria["status"]),
                 next(name for name, key in self.DUE.items() if key == criteria["due"])]
        parts.append(f"{len(criteria['list_ids'])} ausgewählte Listen" if criteria["list_ids"] else "Alle Listen")
        if criteria["label_ids"]:
            parts.append(f"{len(criteria['label_ids'])} Labels ({'alle' if criteria['label_mode'] == 'all' else 'mindestens eines'})")
        if criteria["importance"] != "all":
            parts.append("Wichtigkeit: " + next(name for name, key in self.IMPORTANCE.items() if key == criteria["importance"]))
        if criteria.get('source') == 'pages':
            parts.append('Aus Seiten (Heimat oder Textverweis)')
        if criteria["query"]:
            parts.append("Suchtext: " + criteria["query"])
        existing_lists = {entry["id"] for entry in self.app.lists}
        existing_labels = {entry["id"] for entry in self.app.labels}
        missing_lists = set(criteria["list_ids"]) - existing_lists
        missing_labels = set(criteria["label_ids"]) - existing_labels
        if missing_lists:
            parts.append("Enthält entfernte Listen – Filter bei Bedarf bearbeiten")
        if missing_labels:
            parts.append("Enthält entfernte Labels – Filter bei Bedarf bearbeiten")
        return " · ".join(parts)

    def save(self, criteria):
        app = self.app
        before = copy.deepcopy(app.settings)
        values = app.settings.setdefault("saved_filters", [])
        index = next((index for index, entry in enumerate(values) if entry["id"] == criteria["id"]), None)
        if index is None and len(values) >= self.MAX_FILTERS:
            app.show_warning("Gespeicherte Filter", f"Es sind maximal {self.MAX_FILTERS} Filter möglich.")
            return False
        if index is None:
            values.append(criteria)
        else:
            values[index] = criteria
        if not self._persist(before):
            return False
        if app.view_mode == "saved_filter":
            app.update_window_title(); app.update_header_title(); app.update_page_note_preview(); app.refresh_tree()
        return True

    def _persist(self, before):
        app = self.app
        if app.save_settings(show_error=True):
            return True
        app.settings = before
        if getattr(app, "_data_read_only", False):
            app.show_warning("Filter nicht gespeichert", "Die Datenablage ist schreibgeschützt.")
        return False

    def delete(self, identity):
        app = self.app
        before = copy.deepcopy(app.settings)
        app.settings["saved_filters"] = [entry for entry in before["saved_filters"] if entry["id"] != identity]
        if not self._persist(before):
            return False
        if app.view_mode == "saved_filter" and self.current() is None:
            app.set_home_view()
        return True

    def open(self, identity):
        app = self.app
        if not any(entry["id"] == identity for entry in app.settings["saved_filters"]):
            return False
        app.settings["active_saved_filter"] = identity
        # Ein gespeicherter Erledigt-Filter darf nicht unsichtbar durch den
        # zuletzt verwendeten Offen-Schalter oder Suchtext ausgehebelt werden.
        app.hide_done_var.set(False)
        app.clear_search()
        app._activate_system_view("saved_filter")
        return True

    def show_manager(self):
        app, theme = self.app, self.app.theme
        dialog = tk.Toplevel(app.root)
        dialog.title("Gespeicherte Filter")
        dialog.configure(bg=theme["bg"]); dialog.transient(app.root)
        dialog.minsize(560, 420)
        body = tk.Frame(dialog, bg=theme["bg"], padx=24, pady=18)
        body.pack(fill="both", expand=True)
        tk.Label(body, text="Gespeicherte Filter", bg=theme["bg"], fg=theme["text"], font=app_font(16, "bold")).pack(anchor="w")
        tk.Label(body, text="Eigene Ansichten über alle Listen. Die Aufgaben bleiben an ihrem Platz.",
                 bg=theme["bg"], fg=theme["muted"], wraplength=540, justify="left", anchor="w").pack(anchor="w", pady=(6, 14))
        actions = ButtonFlow(body, bg=theme["bg"], gap=8)
        actions.pack(side="bottom", fill="x", pady=(14, 0))
        info = tk.Label(body, text="", bg=theme["bg"], fg=theme["muted"], justify="left", anchor="w", wraplength=540)
        info.pack(side="bottom", fill="x", pady=(10, 0))
        area = tk.Frame(body, bg=theme["card"])
        area.pack(fill="both", expand=True)
        tree = ttk.Treeview(area, columns=("count",), show="tree headings", selectmode="browse", height=7, style="Dialog.Treeview")
        # auch der Zähler steht links. Eine rechtsbündige
        # Zahl neben linksbündigem Text erzeugt eine zweite Flucht, ohne dass
        # sie etwas erklärt.
        app.prepare_table(tree, (("#0", "Filter", 370), ("count", "Aufgaben", 110)), stretch="#0")
        app._attach_field_scrollbar(area, tree)
        tree.pack(fill="both", expand=True)
        app.bind_mousewheel(tree)
        def selected():
            return next((value for value in app.settings["saved_filters"] if value["id"] in tree.selection()), None)
        def selection_changed(_event=None):
            value = selected()
            info.configure(text=self.summary(value) if value else "Noch kein Filter ausgewählt. Mit „Neu“ eine Ansicht anlegen.")
        def refresh(identity=None):
            tree.delete(*tree.get_children())
            for entry in app.settings["saved_filters"]:
                tree.insert("", "end", iid=entry["id"], text=entry["name"], values=(len(self.entries(entry)),))
            target = identity or app.settings.get("active_saved_filter")
            if target and tree.exists(target):
                tree.selection_set(target); tree.focus(target)
            selection_changed()
        def edit(new=False):
            value = None if new else selected()
            if not new and value is None:
                return
            result = self.edit_dialog(value, parent=dialog)
            if result and self.save(result):
                refresh(result["id"])
        def remove():
            value = selected()
            if value and app.ask_yes_no("Filter entfernen", f"„{value['name']}“ entfernen? Die Aufgaben bleiben erhalten.", parent=dialog):
                if self.delete(value["id"]):
                    refresh()
        def open_selected(_event=None):
            value = selected()
            if value:
                dialog.destroy()
                self.open(value["id"])
            return "break"
        for title, command, color in (("Neu", lambda: edit(True), "accent"), ("Bearbeiten", edit, "accent"),
                                      ("Entfernen", remove, "delete"), ("Öffnen", open_selected, "confirm"),
                                      ("Schließen", dialog.destroy, "muted")):
            actions.add(app._make_dialog_button(actions, title, command, color, width=110))
        tree.bind("<<TreeviewSelect>>", selection_changed)
        tree.bind("<Return>", open_selected); tree.bind("<Double-Button-1>", open_selected)
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        body.bind("<Configure>", lambda e: info.configure(wraplength=max(200, e.width-48)))
        refresh()
        app._center_dialog(dialog, min_width=680, min_height=500)
        app._schedule_windows_chrome_theme(dialog)
        tree.focus_set(); app.run_modal(dialog)

    def edit_dialog(self, criteria=None, parent=None):
        app, theme = self.app, self.app.theme
        initial = criteria or {"id": uuid.uuid4().hex, "name": "Neuer Filter", "query": "", "list_ids": [], "label_ids": [],
                               "status": "open", "importance": "all", "due": "any", "label_mode": "any"}
        dialog = tk.Toplevel(parent or app.root)
        dialog.title("Filter bearbeiten" if criteria else "Neuer Filter")
        dialog.configure(bg=theme["bg"]); dialog.transient(parent or app.root)
        # Zwei Spalten mit Aufklappfeldern brauchen die
        # Breite zweier Spalten, sonst brechen ihre Beschriftungen um.
        dialog.minsize(ResponsiveColumns.required_width(gap=12, chrome=88), 440)
        actions = tk.Frame(dialog, bg=theme["bg"])
        actions.pack(side="bottom", fill="x", padx=24, pady=14)
        area = tk.Frame(dialog, bg=theme["bg"])
        area.pack(fill="both", expand=True)
        canvas = tk.Canvas(area, bg=theme["bg"], highlightthickness=0, height=470)
        app._attach_field_scrollbar(area, canvas)
        canvas.pack(fill="both", expand=True)
        body = tk.Frame(canvas, bg=theme["bg"], padx=24, pady=18)
        window = canvas.create_window((0, 0), window=body, anchor="nw")
        body.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        tk.Label(body, text=dialog.title(), bg=theme["bg"], fg=theme["text"], font=app_font(16, "bold")).pack(anchor="w", pady=(0, 10))
        fields, pickers = {}, {}
        fields["name"] = tk.StringVar(value=initial["name"])
        name_entry = app._capture_text_field(body, "Name der Ansicht", fields["name"])
        fields["query"] = tk.StringVar(value=initial["query"])
        app._capture_text_field(body, "Suchtext (optional)", fields["query"])
        columns = tk.Frame(body, bg=theme["bg"]); columns.pack(fill="x")
        left, right = tk.Frame(columns, bg=theme["bg"]), tk.Frame(columns, bg=theme["bg"])
        left.grid(row=0, column=0, sticky="new", padx=(0, 12)); right.grid(row=0, column=1, sticky="new")
        columns.columnconfigure((0, 1), weight=1, uniform="filters")
        mappings = {"status": self.STATUS, "importance": self.IMPORTANCE, "due": self.DUE, "label_mode": self.LABEL_MODE, "source": self.SOURCE}
        for key, title, panel in (("status", "Status", left), ("importance", "Wichtigkeit", left),
                                  ("due", "Fälligkeit", left), ("source", "Aufgabenquelle", left), ("label_mode", "Labels verknüpfen", right)):
            choices = mappings[key]
            fields[key] = tk.StringVar(value=next(name for name, value in choices.items() if value == initial.get(key, "all")))
            app._make_field_label(panel, title).pack(anchor="w", pady=(10, 5))
            border, _ = app._make_option_menu(panel, fields[key], list(choices))
            border.pack(fill="x")
        lists = [{"id": entry["id"], "name": app.list_path_title(entry), "color": app.inherited_list_color(entry)} for entry in app.lists]
        labels = [dict(label) for label in app.labels if not app.is_system_label(label)]
        for key, title, values, empty in (("label_ids", "Labels (Mehrfachauswahl)", labels, "Alle Labels / auch ohne Label"),
                                          ("list_ids", "Listen (Mehrfachauswahl)", lists, "Alle Listen")):
            known = {value["id"] for value in values}
            values += [{"id": identity, "name": f"Entfernt ({identity[:12]})", "color": "muted"}
                       for identity in initial[key] if identity not in known]
            app._make_field_label(right, title).pack(anchor="w", pady=(10, 5))
            picker = FilterSelection(right, app, values, initial[key], empty_text=empty, dialog_parent=dialog)
            picker.pack(fill="x"); pickers[key] = picker
        preview = tk.Label(body, text="", bg=theme["bg"], fg=theme["muted"], anchor="w", justify="left")
        preview.pack(fill="x", pady=(16, 4))
        error = tk.Label(body, text="", bg=theme["bg"], fg=theme["delete"], anchor="w", justify="left")
        error.pack(fill="x")
        def read():
            result = {"id": initial["id"], "name": fields["name"].get().strip(), "query": fields["query"].get().strip()}
            result.update({key: mapping[fields[key].get()] for key, mapping in mappings.items()})
            result.update({key: picker.read() for key, picker in pickers.items()})
            return result
        def update(*_args):
            value = read()
            preview.configure(text=f"{len(self.entries(value))} passende Aufgaben · Gruppen und Überschriften werden nicht mitgezählt.\n"
                                   "Leere Auswahl bedeutet alle Listen bzw. keine Einschränkung nach Label.")
        traces = [(var, var.trace_add("write", update)) for var in fields.values()]
        for picker in pickers.values():
            picker.on_change = update
        result = {"value": None}
        def submit(_event=None):
            value = read()
            if not value["name"] or len(value["name"]) > 80:
                error.configure(text="Bitte einen Namen mit 1 bis 80 Zeichen eingeben."); return "break"
            if any(entry["id"] != value["id"] and entry["name"].casefold() == value["name"].casefold()
                   for entry in app.settings["saved_filters"]):
                error.configure(text="Dieser Name ist bereits vergeben."); return "break"
            result["value"] = value; dialog.destroy(); return "break"
        app._make_dialog_button(actions, "Speichern", submit, "confirm").pack(side="right")
        app._make_dialog_button(actions, "Abbrechen", dialog.destroy, "muted").pack(side="right", padx=(0, 8))
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        dialog.bind("<Control-Return>", submit)
        if IS_MACOS:
            dialog.bind("<Command-Return>", submit)
        def layout(event):
            canvas.itemconfigure(window, width=event.width)
            two = event.width >= 660
            columns.columnconfigure(1, weight=1 if two else 0)
            right.grid_configure(row=0 if two else 1, column=1 if two else 0)
            left.grid_configure(padx=(0, 12) if two else 0)
            preview.configure(wraplength=max(180, event.width-48)); error.configure(wraplength=max(180, event.width-48))
        canvas.bind("<Configure>", layout)
        app._bind_canvas_wheel(body, canvas)
        update()
        app._center_dialog(dialog, min_width=ResponsiveColumns.required_width(gap=12, chrome=88),
                           min_height=600)
        app._schedule_windows_chrome_theme(dialog)
        name_entry.focus_set(); name_entry.selection_range(0, tk.END)
        try:
            app.run_modal(dialog, parent=parent)
        finally:
            for var, trace in traces:
                var.trace_remove("write", trace)
        return result["value"]


class SystemNavigation(ttk.Treeview):
    """Native Navigation mit separat um zwei Pixel angehobenen Textsymbolen."""

    ICON_RISE = 2

    def __init__(self, master, app, **kwargs):
        super().__init__(master, **kwargs)
        self.app = app
        self._icon_job = None
        self.icon_canvas = tk.Canvas(self, width=28, bd=0, highlightthickness=0,
                                     bg=app.theme["card"], takefocus=0)
        self.icon_canvas.place(x=0, y=0, width=28, relheight=1)
        for sequence in ("<Configure>", "<Expose>", "<<TreeviewSelect>>", "<Motion>", "<Leave>"):
            self.bind(sequence, self.schedule_icons, add="+")
        for sequence in ("<ButtonPress-1>", "<ButtonRelease-1>", "<ButtonPress-2>", "<ButtonPress-3>", "<Motion>"):
            self.icon_canvas.bind(sequence, lambda event, seq=sequence: self.event_generate(
                seq, x=event.x, y=event.y, state=event.state))
        self.icon_canvas.bind("<Leave>", lambda event: self.app.set_hover_rows(self, ()))
        self.bind("<Destroy>", self._stop_icons, add="+")

    def _stop_icons(self, event):
        if event.widget is self and self._icon_job is not None:
            self.after_cancel(self._icon_job)
            self._icon_job = None

    def schedule_icons(self, _event=None):
        if self._icon_job is None:
            self._icon_job = self.after_idle(self.draw_icons)

    def item(self, item, option=None, **kwargs):
        result = super().item(item, option, **kwargs)
        if kwargs and hasattr(self, "icon_canvas"):
            self.schedule_icons()
        return result

    def draw_icons(self):
        self._icon_job = None
        canvas = self.icon_canvas
        theme = self.app.theme
        # Grund wie die Liste selbst – auf Milchglas ist das die Tönung der
        # Kachel (abgeleiteter Stil), nicht die allgemeine Kartenfarbe.
        try:
            grund = self.app.style.lookup(str(self.cget("style")), "background") or theme["card"]
        except tk.TclError:
            grund = theme["card"]
        canvas.configure(bg=grund)
        canvas.delete("all")
        selected = self.selection()
        for iid in self.get_children():
            bounds = self.bbox(iid, "icon")
            if not bounds:
                continue
            x, y, width, height = bounds
            tags = self.item(iid, "tags")
            fill = theme["selection"] if iid in selected else theme["hover"] if "hover" in tags else grund
            foreground = theme["selection_text"] if iid in selected else theme["text"]
            canvas.create_rectangle(0, y, width, y + height, fill=fill, outline=fill)
            canvas.create_text(width / 2, y + height / 2 - self.ICON_RISE,
                               text=self.set(iid, "icon"), fill=foreground,
                               font=self.app.sidebar_section_font())


class ItemWorkspace:
    """Reiter und Pinnwände referenzieren ausschließlich bestehende Punktkennungen."""

    MAX_TABS = 12
    MAX_CARDS = 500
    # Ein Reiter trug bis 3.24 zwanzig Zeichen und dreizehn
    # Pixel Innenabstand je Seite. Beides zusammen ergab breite Schaltflächen,
    # in denen der Text am Rand klebte – „Anstehende Aufgaben …“ füllte die
    # halbe Zeile und sagte trotzdem nicht, worum es geht. Vierzehn Zeichen
    # reichen, um einen Reiter wiederzuerkennen; den vollständigen Titel zeigt
    # ohnehin der Tooltip.
    TAB_LABEL_CHARS = 14
    TAB_TEXT_INSET = 44
    TAB_MAX_WIDTH = 210
    # Die globale Pinnwand ist kein zweiter Kartenspeicher,
    # sondern eine Pinnwand wie jede andere – nur mit dem gesamten Bestand als
    # Bereich. Deshalb ein eigener Bereichsschlüssel neben „list:" und
    # „folder:" und kein Sonderweg im Aufbau.
    GLOBAL_SCOPE = "global"
    # Eine Verbindung sagt seit 3.24, in welche Richtung sie
    # gelesen wird. Bis 3.23 war sie ungerichtet und wurde als sortiertes Paar
    # gespeichert; bestehende Verbindungen bleiben genau das und tragen die
    # Art „Linie". Gespeichert wird die Art, nicht die gezeichnete Spitze –
    # eine Austauschdatei kann sie damit auch ohne Zeichenfläche auswerten.
    CONNECTION_STYLES = (
        ("line", "Linie ohne Richtung"),
        ("forward", "Pfeil: von der ersten zur zweiten Karte"),
        ("backward", "Pfeil: von der zweiten zur ersten Karte"),
        ("both", "Pfeil in beide Richtungen"),
    )
    CONNECTION_STYLE_KEYS = tuple(schluessel for schluessel, _name in CONNECTION_STYLES)
    CONNECTION_STYLE_DEFAULT = "line"
    # Hierarchie auf einer Fläche entsteht über Größe, nicht
    # über Einrückung. Drei Stufen reichen: Überschrift, Normalfall, Randnotiz.
    # Der Faktor wirkt auf Kartenbreite und Titelgröße gemeinsam, damit eine
    # große Karte auch mehr Text zeigt statt nur mehr Rand.
    CARD_SCALES = (
        ("large", "Groß · Hauptgedanke", 1.30),
        ("normal", "Normal", 1.00),
        ("small", "Klein · Randnotiz", 0.78),
    )
    CARD_SCALE_FACTORS = {schluessel: faktor for schluessel, _name, faktor in CARD_SCALES}
    CARD_SCALE_DEFAULT = "normal"
    # Obergrenze für Verbindungen je Pinnwand. Über etwa
    # zweihundert Linien ist keine Fläche mehr lesbar, und jede Linie kostet
    # beim Zeichnen Zeit.
    MAX_CONNECTIONS = 200
    # 3.30 (Etappe C): Spaltenboard, Karteninhalt, Bereiche, Verbindungen mit
    # Text und Strich, Flächenhintergrund. Alles additiv im Abschnitt
    # `pinboards`; eine ältere Fassung liest die Pinnwand weiter als freie
    # Fläche mit einfachen Linien.
    # Seit 3.33.5 (G02, D13) auch Eisenhower als Gruppierung statt eigener Ansicht.
    BOARD_GROUP_FIELDS = (("due", "Fälligkeit"), ("planned", "Bearbeitungstag"),
                          ("importance", "Wichtigkeit"), ("eisenhower", "Dringlichkeit × Wichtigkeit"),
                          ("label", "Label"), ("done", "Erledigt"), ("list", "Liste"))
    BOARD_GROUP_KEYS = tuple(key for key, _name in BOARD_GROUP_FIELDS)
    # Von streng nach frei; „Frei anordnen“ bleibt wie bis 3.29 der letzte Eintrag.
    BOARD_LAYOUTS = (("grid", "Geordnete Karten"), ("columns", "Spalten"), ("free", "Frei anordnen"))
    CARD_SHOW_KEYS = ("description", "checklist", "image")
    CARD_COLOR_MODES = (("stripe", "Streifen"), ("header", "Kopf"), ("fill", "Ganze Karte"))
    CARD_COLOR_SOURCES = (("item", "Punktfarbe"), ("label", "Erstes Label"))
    AREA_COLORS = (("Blau", "clear"), ("Lila", "accent"), ("Türkis", "due_action"), ("Grün", "export"),
                   ("Gelb", "flag"), ("Rot", "delete"), ("Braun", "import"))
    AREA_COLOR_KEYS = tuple(key for _name, key in AREA_COLORS)
    MAX_AREAS = 50
    AREA_HEADER = 30
    CONNECTION_COLORS = (("Standard", "muted"), ("Akzent", "ui_accent"), ("Blau", "clear"),
                         ("Grün", "export"), ("Gelb", "flag"), ("Rot", "delete"))
    CONNECTION_COLOR_KEYS = tuple(key for _name, key in CONNECTION_COLORS)
    CONNECTION_LABEL_MAX = 40
    BOARD_BACKGROUNDS = (("none", "Leer"), ("dots", "Punkte"), ("lines", "Linien"), ("grid", "Karo"))
    BOARD_BACKGROUND_KEYS = tuple(key for key, _name in BOARD_BACKGROUNDS)
    # Eine Zeichnung auf der Pinnwand ist ein Verweis auf ihre Seite (ZF-100),
    # keine Kopie. Die Karte trägt die Seitenkennung mit diesem Vorsatz.
    PAGE_CARD_PREFIX = "page:"
    PAGE_PREVIEW_MAX = 160
    VIEW_UNDO_LIMIT = 20

    @staticmethod
    def normalize_settings(data):
        def identity(value):
            return value if isinstance(value, str) and 0 < len(value) <= 200 else None

        def number(value, default, minimum, maximum):
            if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value):
                return max(minimum, min(maximum, int(value)))
            return default

        tabs, seen = [], set()
        for raw in data.get("open_tabs", []) if isinstance(data.get("open_tabs"), list) else []:
            if not isinstance(raw, dict):
                continue
            list_id, item_id = identity(raw.get("list_id")), identity(raw.get("item_id"))
            if list_id and item_id and item_id not in seen:
                tabs.append({"list_id": list_id, "item_id": item_id,
                             "used": number(raw.get("used"), 0, 0, 10**15)})
                seen.add(item_id)
            if len(tabs) == ItemWorkspace.MAX_TABS:
                break
        data["open_tabs"] = tabs
        active = data.get("active_tab")
        data["active_tab"] = {key: value for key, value in active.items()
                              if identity(key) and identity(value)} if isinstance(active, dict) else {}
        boards = {}
        for key, raw in (data.get("pinboards") or {}).items() if isinstance(data.get("pinboards"), dict) else []:
            if not identity(key) or not isinstance(raw, dict):
                continue
            if not key.startswith(("list:", "folder:")) and key != ItemWorkspace.GLOBAL_SCOPE:
                continue
            cards, seen = [], set()
            for card in raw.get("cards", []) if isinstance(raw.get("cards"), list) else []:
                if not isinstance(card, dict):
                    continue
                item_id, list_id = identity(card.get("item_id")), identity(card.get("list_id"))
                if not item_id or not list_id or item_id in seen:
                    continue
                skala = card.get("scale")
                cards.append({"list_id": list_id, "item_id": item_id,
                              "x": number(card.get("x"), 16, 0, 20000),
                              "y": number(card.get("y"), 16, 0, 20000),
                              # additiv – ein fehlender Wert
                              # bedeutet „Normal" und damit genau die Karte
                              # aus 3.23.
                              "scale": skala if skala in ItemWorkspace.CARD_SCALE_FACTORS
                              else ItemWorkspace.CARD_SCALE_DEFAULT})
                # 3.30 (PW-020): Eine Karte kann den Inhalt der Pinnwand
                # übersteuern – nur die Schlüssel, die sie selbst setzt.
                zeigen = card.get("show")
                if isinstance(zeigen, dict):
                    eigen = {schluessel: wert for schluessel, wert in zeigen.items()
                             if schluessel in ItemWorkspace.CARD_SHOW_KEYS and isinstance(wert, bool)}
                    if eigen:
                        cards[-1]["show"] = eigen
                seen.add(item_id)
                if len(cards) == ItemWorkspace.MAX_CARDS:
                    break
            # Frei anordnen ist der Standard. Wer ordnen
            # will, stellt um; wer frei arbeitet, muss nicht jedes Mal
            # umstellen. Ältere Pinnwände behalten ihre gespeicherte Wahl.
            # Verbindungen zwischen zwei angehefteten
            # Punkten. Bewusst als Beziehung zwischen Punkt-IDs gespeichert
            # und nicht als gezeichnete Linie: Eine Linie mit festen
            # Koordinaten wäre falsch, sobald eine Karte verschoben wird, und
            # bedeutungslos für jede andere Ansicht. So wandert sie beim
            # Verschieben mit, übersteht den Neustart und lässt sich später
            # auslesen – von einer Abhängigkeitsansicht ebenso wie von einer
            # Austauschdatei.
            #
            # Eine Verbindung ist ungerichtet: „A hängt mit B zusammen“ ist
            # dasselbe wie umgekehrt. Eine verbindliche Reihenfolge wäre eine
            # Aufgabenabhängigkeit und damit eine eigene Funktion mit eigener
            # Prüfung auf Kreise – nicht etwas, das nebenbei aus einer Linie
            # entsteht.
            kartenkennungen = {card["item_id"] for card in cards}
            verbindungen, gesehene_paare = [], set()
            for roh in raw.get("connections", []) if isinstance(raw.get("connections"), list) else []:
                if not isinstance(roh, dict):
                    continue
                von, nach = identity(roh.get("from")), identity(roh.get("to"))
                if not von or not nach or von == nach:
                    continue
                if von not in kartenkennungen or nach not in kartenkennungen:
                    # Eine Verbindung zu einer Karte, die es nicht mehr gibt,
                    # verschwindet mit ihr statt als Rest liegen zu bleiben.
                    continue
                paar = tuple(sorted((von, nach)))
                if paar in gesehene_paare:
                    continue
                gesehene_paare.add(paar)
                # Die Reihenfolge bleibt so, wie sie
                # gespeichert wurde – sie ist bei einem Pfeil die Aussage
                # selbst. Doppelt bleibt sie trotzdem ausgeschlossen: Zwei
                # Karten tragen höchstens eine Verbindung.
                art = roh.get("style")
                verbindungen.append({
                    "from": von, "to": nach,
                    "style": art if art in ItemWorkspace.CONNECTION_STYLE_KEYS
                    else ItemWorkspace.CONNECTION_STYLE_DEFAULT,
                })
                # 3.30 (PW-060): Beschriftung, Strichart und Farbe. `style`
                # trägt seit 3.24 die Richtung; die Strichart heißt deshalb
                # `dash`. Eine ältere Fassung zeichnet eine einfache Linie.
                beschriftung = roh.get("label")
                if isinstance(beschriftung, str) and beschriftung.strip():
                    verbindungen[-1]["label"] = " ".join(beschriftung.split())[:ItemWorkspace.CONNECTION_LABEL_MAX]
                if roh.get("dash") is True:
                    verbindungen[-1]["dash"] = True
                if roh.get("color") in ItemWorkspace.CONNECTION_COLOR_KEYS and roh.get("color") != "muted":
                    verbindungen[-1]["color"] = roh["color"]
                if len(verbindungen) == ItemWorkspace.MAX_CONNECTIONS:
                    break
            verbindungsart = raw.get("connection_style")
            bereiche, gesehene_bereiche = [], set()
            for roh in raw.get("areas", []) if isinstance(raw.get("areas"), list) else []:
                if not isinstance(roh, dict):
                    continue
                kennung = identity(roh.get("id"))
                if not kennung or kennung in gesehene_bereiche:
                    continue
                name = roh.get("name")
                bereiche.append({
                    "id": kennung,
                    "name": " ".join(name.split())[:60] if isinstance(name, str) and name.strip() else "Bereich",
                    "color": roh.get("color") if roh.get("color") in ItemWorkspace.AREA_COLOR_KEYS else "clear",
                    "x": number(roh.get("x"), 16, 0, 20000), "y": number(roh.get("y"), 16, 0, 20000),
                    "w": number(roh.get("w"), 480, 120, 20000), "h": number(roh.get("h"), 320, 80, 20000)})
                gesehene_bereiche.add(kennung)
                if len(bereiche) == ItemWorkspace.MAX_AREAS:
                    break
            eingeklappt = raw.get("collapsed")
            eingeklappt = list(dict.fromkeys(
                wert for wert in (eingeklappt if isinstance(eingeklappt, list) else [])
                if isinstance(wert, str) and 0 < len(wert) <= 200))[:100]
            boards[key] = {"cards": cards, "connections": verbindungen,
                           # Die zuletzt gewählte Verbindungsart gilt für die
                           # nächste Verbindung dieser Pinnwand.
                           "connection_style": verbindungsart
                           if verbindungsart in ItemWorkspace.CONNECTION_STYLE_KEYS
                           else ItemWorkspace.CONNECTION_STYLE_DEFAULT,
                           # „columns“ (3.30) liest eine ältere Fassung als
                           # „free“ – sie fällt auf „Frei anordnen“ zurück.
                           "layout": raw.get("layout") if raw.get("layout") in ("grid", "columns") else "free",
                           "snap": raw.get("snap") is not False,
                           "object_snap": raw.get("object_snap") is True,
                           "navigator": raw.get("navigator") is True,
                           "zoom": raw.get("zoom") if raw.get("zoom") in (50,75,100,125,150,200) else 100,
                           # Bildvorschau und automatisches
                           # Anheften. Beide sind additiv; fehlende Werte
                           # bedeuten „Vorschau ein, Auto aus".
                           "preview": raw.get("preview") is not False,
                           "auto": raw.get("auto") is True,
                           "width": number(raw.get("width"), 300, 240, 420),
                           # 3.30: Spaltenboard (PW-010).
                           "group_by": raw.get("group_by") if raw.get("group_by") in ItemWorkspace.BOARD_GROUP_KEYS
                           else "due",
                           "collapsed": eingeklappt,
                           "hide_empty": raw.get("hide_empty") is True,
                           "only_open": raw.get("only_open") is True,
                           # Karteninhalt und Kartenfarbe (PW-020).
                           "show_description": raw.get("show_description") is not False,
                           "show_checklist": raw.get("show_checklist") is True,
                           "color_mode": raw.get("color_mode")
                           if raw.get("color_mode") in dict(ItemWorkspace.CARD_COLOR_MODES) else "stripe",
                           "color_source": "label" if raw.get("color_source") == "label" else "item",
                           # Bereiche (PW-030), neue Karte verbinden (PW-050).
                           "areas": bereiche,
                           "auto_connect": raw.get("auto_connect") is True,
                           # Flächenhintergrund (PW-070).
                           "background": raw.get("background")
                           if raw.get("background") in ItemWorkspace.BOARD_BACKGROUND_KEYS else "none",
                           "print_background": raw.get("print_background") is True}
        data["pinboards"] = boards
        return data

    def __init__(self, app):
        self.app = app
        self.selected_id = None
        # Die Pinnwand kannte bis 3.23 genau eine
        # ausgewählte Karte. Für „diese drei gehören zusammen" braucht es eine
        # Auswahl aus mehreren – geführt als Reihenfolge, nicht als Menge: Die
        # zuerst gewählte Karte ist der Anker, von dem aus verbunden wird.
        # `selected_id` bleibt die zuletzt angefasste Karte und damit das, was
        # Tastatur, Detailansicht und Fokus weiterhin meinen.
        self.selected_ids = []
        self.visible = False
        self.mode = "list"
        self.scope = None
        self.filter_label = ""
        self._saved_chrome = []
        self._signature = None
        self._drag = None
        self.card_boxes = {}
        self.card_ids = []
        self.tab_buttons = {}
        self.bar = tk.Frame(app.list_frame_outer.inner, bg=app.theme["card"])
        self.body = tk.Frame(app.list_frame_outer.inner, bg=app.theme["card"])

    def context(self):
        app = self.app
        if app.view_mode == app.GLOBAL_BOARD_VIEW:
            return self.GLOBAL_SCOPE
        if app.view_mode == "list" and app.current_list():
            if app.is_surface_list(app.current_list()):
                # Zeichnung und Galerie besitzen weder Pinnwand noch Tabelle.
                return None
            return "list:" + app.active_list_id
        if app.view_mode == "folder" and app.get_folder(app.active_folder_id):
            return "folder:" + app.active_folder_id
        return None

    def eligible_lists(self, scope=None):
        scope = scope or self.context()
        if not scope:
            return []
        if scope == self.GLOBAL_SCOPE:
            # Der Bereich der globalen Pinnwand ist der
            # gesamte Bestand – jede Liste mit Punkten, gleich in welchem Ordner.
            return [entry for entry in self.app.lists if self.app.list_accepts_items(entry)]
        kind, identity = scope.split(":", 1)
        if kind == "list":
            return [entry for entry in self.app.lists
                    if entry.get("id") == identity and self.app.list_accepts_items(entry)]
        folder_ids = {identity}
        changed = True
        while changed:
            previous = set(folder_ids)
            folder_ids.update(folder["id"] for folder in self.app.folders
                              if folder.get("parent_id") in folder_ids)
            changed = previous != folder_ids
        return [entry for entry in self.app.lists
                if entry.get("folder_id") in folder_ids and self.app.list_accepts_items(entry)]

    def valid_items(self, scope=None):
        return {item["id"]: (entry, item) for entry in self.eligible_lists(scope)
                for item in self.app.walk_items(entry.get("items", []))
                if not self.app.is_heading_item(item)}

    @classmethod
    def is_page_card(cls, identity):
        return isinstance(identity, str) and identity.startswith(cls.PAGE_CARD_PREFIX)

    def page_card_pseudo(self, entry):
        """Die Zeichnungsseite in der Form, die Filter und Kartenaufbau erwarten."""
        return {"id": self.PAGE_CARD_PREFIX + entry["id"], "text": str(entry.get("title") or "Zeichnung"),
                "description": str(entry.get("description") or ""), "labels": [], "done": False,
                "kind": "task", "page": True}

    def valid_pages(self, scope=None):
        """Zeichnungsseiten, die als Karte auf jeder Pinnwand liegen dürfen (ZF-100)."""
        return {self.PAGE_CARD_PREFIX + entry["id"]: (entry, self.page_card_pseudo(entry))
                for entry in self.app.lists
                if entry.get("id") and self.app.is_drawing_list(entry) and not entry.get("archived")}

    def valid_cards(self, scope=None):
        return {**self.valid_items(scope), **self.valid_pages(scope)}

    def prune(self):
        app = self.app
        before = copy.deepcopy({key: app.settings.get(key) for key in ("open_tabs", "active_tab", "pinboards")})
        lookup = {item["id"]: (entry, item) for entry in app.lists
                  for item in app.walk_items(entry.get("items", [])) if not app.is_heading_item(item)}
        tabs = app.settings["open_tabs"]
        # Ein Punkt, der seine Liste wechselt, nimmt die Sicht mit. Kopien haben neue IDs.
        tabs[:] = [tab for tab in tabs if tab["item_id"] in lookup]
        for tab in tabs:
            tab["list_id"] = lookup[tab["item_id"]][0]["id"]
        for key, board in list(app.settings["pinboards"].items()):
            if key == self.GLOBAL_SCOPE:
                valid = self.valid_cards(key)
                board["cards"][:] = [card for card in board["cards"] if card["item_id"] in valid]
                for card in board["cards"]:
                    card["list_id"] = valid[card["item_id"]][0]["id"]
                board["connections"] = [eintrag for eintrag in board.get("connections", [])
                                        if eintrag["from"] in valid and eintrag["to"] in valid]
                continue
            if not self.eligible_lists(key) and not (key.startswith("folder:") and app.get_folder(key[7:])):
                del app.settings["pinboards"][key]
                continue
            valid = self.valid_cards(key)
            board["cards"][:] = [card for card in board["cards"] if card["item_id"] in valid]
            for card in board["cards"]:
                card["list_id"] = valid[card["item_id"]][0]["id"]
            gueltig = {card["item_id"] for card in board["cards"]}
            board["connections"] = [eintrag for eintrag in board.get("connections", [])
                                    if eintrag["from"] in gueltig and eintrag["to"] in gueltig]
        for key, value in list(app.settings["active_tab"].items()):
            if value not in ("list", "board") and not any(
                    key == "list:" + tab["list_id"] and value == tab["item_id"] for tab in tabs):
                app.settings["active_tab"][key] = "list"
        after = {key: app.settings.get(key) for key in before}
        if before != after:
            app.save_settings()

    def save_view_change(self, operation):
        app = self.app
        before = copy.deepcopy(app.settings)
        operation()
        if app.save_settings(show_error=not getattr(app, "_data_read_only", False)):
            return True
        app.settings = before
        if getattr(app, "_data_read_only", False):
            app.show_warning("Ansicht nicht gespeichert", "Die Datenablage ist schreibgeschützt.")
        return False

    def board(self, scope=None):
        leer = {"cards": [], "connections": [], "layout": "free", "snap": True,
                "preview": True, "auto": False, "width": 300,
                "connection_style": self.CONNECTION_STYLE_DEFAULT,
                "group_by": "due", "collapsed": [], "hide_empty": False, "only_open": False,
                "show_description": True, "show_checklist": False, "color_mode": "stripe",
                "color_source": "item", "areas": [], "auto_connect": False,
                "background": "none", "print_background": False}
        gespeichert = self.app.settings["pinboards"].get(scope or self.context())
        if not isinstance(gespeichert, dict):
            return leer
        # Ältere Einstellungsdateien kennen die Schalter aus 3.22 noch nicht.
        return {**leer, **gespeichert}

    def open_tab(self, item_id=None):
        app = self.app
        item_id = item_id or (self.selected_id if self.visible else app.get_selected_item_id())
        found = app.find_item_in_lists(item_id)
        if not found or app.is_heading_item(found[0]):
            app.show_warning("Reiter öffnen", "Zuerst eine Aufgabe, einen Langtext oder eine Gruppe auswählen.")
            return "break"
        source_id = found[3]["id"]
        evicted = []

        def change():
            tabs = app.settings["open_tabs"]
            tab = next((tab for tab in tabs if tab["item_id"] == item_id), None)
            if tab is None:
                if len(tabs) >= self.MAX_TABS:
                    oldest = min(tabs, key=lambda tab: tab["used"])
                    evicted.append(oldest["item_id"])
                    tabs.remove(oldest)
                tab = {"list_id": source_id, "item_id": item_id}
                tabs.append(tab)
            tab["used"] = max([value.get("used", 0) for value in tabs] + [0]) + 1
            app.settings["active_tab"]["list:" + source_id] = item_id

        if self.save_view_change(change):
            if app.view_mode != "list" or app.active_list_id != source_id:
                app.set_active_list(source_id)
            else:
                app.refresh_tree()
            self.focus_active_tab()
            if evicted:
                self.notice.configure(text="Der am längsten unbenutzte Reiter wurde geschlossen (maximal 12).")
        return "break"

    def set_mode(self, mode):
        scope = self.context()
        if not scope:
            if self.app.view_mode == "list" and self.app.is_surface_list(self.app.current_list()):
                if mode != "list":
                    self.app.show_info("Pinnwand", "Zeichnungen und Galerien haben keine Pinnwand und keine Reiter.")
                return "break"
            self.app.show_warning("Pinnwand", "Zuerst eine Liste oder einen Ordner öffnen.")
            return "break"
        if self.save_view_change(lambda: self.app.settings["active_tab"].__setitem__(scope, mode)):
            self.selected_id = mode if mode not in ("board", "list") else None
            self.app.refresh_tree()
            if mode == "list":
                self.app.tree.focus_set()
            else:
                self.focus_active_tab()
        return "break"

    def close_tab(self, item_id=None):
        item_id = item_id or (self.mode if self.mode not in ("list", "board") else None)
        if not item_id:
            return "break"
        def change():
            self.app.settings["open_tabs"][:] = [tab for tab in self.app.settings["open_tabs"] if tab["item_id"] != item_id]
            for key, value in self.app.settings["active_tab"].items():
                if value == item_id:
                    self.app.settings["active_tab"][key] = "list"
        if self.save_view_change(change):
            self.app.refresh_tree()
            self.app.tree.focus_set()
        return "break"

    def cycle_tabs(self, direction):
        scope = self.context()
        if not scope or not scope.startswith("list:"):
            return "break"
        choices = ["list"] + [tab["item_id"] for tab in self.app.settings["open_tabs"]
                               if tab["list_id"] == scope[5:]]
        current = self.mode if self.mode in choices else "list"
        target = choices[(choices.index(current) + direction) % len(choices)]
        return self.set_mode("list") if target == "list" else self.open_tab(target)

    def reorder_tab(self, direction):
        tabs = self.app.settings["open_tabs"]
        current = next((i for i, tab in enumerate(tabs) if tab["item_id"] == self.mode), None)
        if current is not None:
            neighbors = [i for i, tab in enumerate(tabs) if tab["list_id"] == tabs[current]["list_id"]]
            target = neighbors.index(current) + direction
            if 0 <= target < len(neighbors):
                def change():
                    other = neighbors[target]
                    tabs[current], tabs[other] = tabs[other], tabs[current]
                if self.save_view_change(change):
                    self.app.refresh_tree()
                    self.focus_active_tab()
        return "break"

    def pin(self, item_ids=None, scope=None):
        scope = scope or self.context()
        valid = self.valid_cards(scope)
        if item_ids is None:
            item_ids = [self.selected_id] if self.visible else self.app.get_selected_item_ids()
        item_ids = [identity for identity in item_ids if identity in valid]
        if not item_ids:
            return self.choose_cards(scope)
        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            existing = {card["item_id"] for card in board["cards"]}
            for identity in item_ids:
                if identity not in existing and len(board["cards"]) < self.MAX_CARDS:
                    index = len(board["cards"])
                    board["cards"].append({"list_id": valid[identity][0]["id"], "item_id": identity,
                                           "x": 16 + (index % 3) * (board["width"] + 16),
                                           "y": 16 + (index // 3) * 260,
                                           "scale": self.CARD_SCALE_DEFAULT})
                    existing.add(identity)
            self.app.settings["active_tab"][scope] = "board"
        if self.save_view_change(change):
            self.selected_id = item_ids[-1]
            self.app.refresh_tree()
            self.focus_card(self.selected_id)
            self.app.feedback("pinned", len(item_ids))
        return "break"

    def connections(self, scope=None):
        """Die Verbindungen der Pinnwand als (von, nach, Art)."""
        return [(eintrag["from"], eintrag["to"],
                 eintrag.get("style") if eintrag.get("style") in self.CONNECTION_STYLE_KEYS
                 else self.CONNECTION_STYLE_DEFAULT)
                for eintrag in self.board(scope).get("connections", [])]

    def toggle_connection(self, erste, zweite, umschalten=True):
        """Legt eine Verbindung an oder nimmt sie zurück.

        Die Richtung ist die Reihenfolge der Argumente. Sie
        wird mitgespeichert, weil sie bei einem Pfeil die Aussage selbst ist;
        ob eine Verbindung schon besteht, entscheidet weiterhin das ungeordnete
        Paar – zwischen zwei Karten liegt höchstens eine Linie.
        """
        if not erste or not zweite or erste == zweite:
            return False
        paar = tuple(sorted((erste, zweite)))
        art = self.connection_style()
        ergebnis = {"angelegt": None}

        def change():
            board = self.app.settings["pinboards"].setdefault(
                self.context(), copy.deepcopy(self.board()))
            vorhandene = board.setdefault("connections", [])
            fuer_paar = [eintrag for eintrag in vorhandene
                         if tuple(sorted((eintrag["from"], eintrag["to"]))) == paar]
            if fuer_paar and umschalten:
                for eintrag in fuer_paar:
                    vorhandene.remove(eintrag)
                ergebnis["angelegt"] = False
            elif fuer_paar:
                ergebnis["angelegt"] = None
            elif len(vorhandene) >= self.MAX_CONNECTIONS:
                ergebnis["angelegt"] = None
            else:
                vorhandene.append({"from": erste, "to": zweite, "style": art})
                ergebnis["angelegt"] = True

        if ergebnis["angelegt"] is None and len(self.board().get("connections", [])) >= self.MAX_CONNECTIONS:
            self.app.show_warning("Pinnwand",
                                  f"Je Pinnwand sind höchstens {self.MAX_CONNECTIONS} Verbindungen möglich.")
            return False
        if not self.save_view_change(change):
            return False
        self.draw_board()
        if ergebnis["angelegt"] is True:
            self.app.feedback("connected")
        elif ergebnis["angelegt"] is False:
            self.app.feedback("disconnected")
        return ergebnis["angelegt"] is not None

    def connection_style(self, scope=None):
        """Die Verbindungsart, die für die nächste Verbindung gilt."""
        wert = self.board(scope).get("connection_style")
        return wert if wert in self.CONNECTION_STYLE_KEYS else self.CONNECTION_STYLE_DEFAULT

    def connection_style_name(self, key=None):
        schluessel = key or self.connection_style()
        return next((name for wert, name in self.CONNECTION_STYLES if wert == schluessel),
                    self.CONNECTION_STYLES[0][1])

    def start_connect_mode(self):
        """Verbindet die Auswahl – oder wartet auf die zweite Karte.

        Sind mehrere Karten ausgewählt, ist die Frage schon
        beantwortet: Die zuerst gewählte Karte wird mit jeder weiteren
        verbunden. Das ist der Sternfall, der eine Hierarchie abbildet – eine
        Kette entsteht, indem man die Schritte einzeln verbindet. Bei genau
        einer Karte bleibt es beim bisherigen Weg: erste Karte, dann zweite.
        """
        auswahl = self.selection()
        if len(auswahl) > 1:
            anker, ziele = auswahl[0], auswahl[1:]
            gesetzt = sum(1 for ziel in ziele if self.toggle_connection(anker, ziel, umschalten=False))
            if not gesetzt:
                self.app.show_info("Verbinden", "Diese Verbindungen bestehen bereits.")
            return "break"
        if not self.selected_id:
            self.app.show_warning("Verbinden", "Zuerst eine Karte auswählen.")
            return "break"
        self._connect_from = self.selected_id
        self.draw_board()
        return "break"

    def cancel_connect_mode(self):
        if getattr(self, "_connect_from", None) is not None:
            self._connect_from = None
            self.draw_board()
            return True
        return False

    def unpin(self):
        kennungen = set(self.active_ids())
        if not kennungen:
            return "break"
        scope = self.context()
        vorher = copy.deepcopy(self.app.settings["pinboards"].get(scope))

        def zurueck():
            def wiederherstellen():
                self.app.settings["pinboards"][scope] = copy.deepcopy(vorher)
            if self.save_view_change(wiederherstellen):
                self.draw_board()
        def change():
            board = self.app.settings["pinboards"].get(self.context())
            if board:
                board["cards"][:] = [card for card in board["cards"]
                                     if card["item_id"] not in kennungen]
                # Punkt 13: Verbindungen gehören zu zwei Karten. Fällt eine
                # weg, hat die Linie kein Ende mehr und verschwindet mit ihr.
                board["connections"] = [eintrag for eintrag in board.get("connections", [])
                                        if not kennungen & {eintrag["from"], eintrag["to"]}]
        if self.save_view_change(change):
            self.selected_id = None
            self.selected_ids = []
            self.app.refresh_tree()
            self.focus_card(self.card_ids[0] if self.card_ids else None)
            self.app.feedback("unpinned", len(kennungen))
            self.app.show_undo_toast(f"{len(kennungen)} Karte(n) von der Pinnwand gelöst", restore=zurueck)
        return "break"

    # Die Gliederung der Pinnwandaktionen an einer Stelle.
    # Jede Aktion steht in genau einer Gruppe, und die Reihenfolge der Gruppen
    # ist die Reihenfolge im Menü: erst was auf die Fläche kommt, dann was mit
    # der ausgewählten Karte geschieht, zuletzt die Fläche selbst.
    BOARD_ACTION_GROUPS = ("Inhalt", "Ausgewählte Karte", "Fläche")

    def board_action_groups(self):
        """Die Aktionen je Gruppe als (Beschriftung, Befehl)."""
        app = self.app
        board = self.board()
        auswahl = len(self.selection())
        zusatz = f" ({auswahl} Karten)" if auswahl > 1 else ""
        return {
            "Inhalt": [
                ("Anheften", self.choose_cards),
                ("Alle Punkte anheften", self.pin_all),
                ("Neue Aufgabe", lambda: self.create_card_item(24, 24)),
                ("Neue Notiz", lambda: self.create_card_item(24, 24, app.ITEM_KIND_LONG)),
                ("Neuer Bereich", self.create_area),
            ],
            "Ausgewählte Karte": [
                ("Bearbeiten" + zusatz.replace(f" ({auswahl} Karten)", ""), self.edit),
                ("Erledigt umschalten" + zusatz, self.toggle),
                ("Verbinden" + zusatz, self.start_connect_mode),
                ("Kartengröße" + zusatz, self.show_card_scale_menu),
                ("Auf dieser Karte zeigen …", self.show_card_show_menu),
                ("Aufräumen" + zusatz, self.tidy_selection),
                ("Neue Karte daneben", self.quick_next_card),
                ("Als Reiter öffnen", self.open_tab),
                ("In Liste zeigen", self.open_source),
                ("Von Pinnwand entfernen" + zusatz, self.unpin),
            ],
            "Fläche": [
                (("Raster aus" if board["snap"] else "Raster ein"),
                 lambda: self.configure_board("snap", not self.board()["snap"])),
                (("Bildvorschau aus" if board["preview"] else "Bildvorschau ein"),
                 lambda: self.configure_board("preview", not self.board()["preview"])),
                (("Automatisch anheften aus" if board["auto"] else "Automatisch anheften ein"),
                 lambda: self.configure_board("auto", not self.board()["auto"])),
                ("Alle Karten finden", self.find_cards),
                ("Karteninhalt …", self.show_card_content_menu),
                ("Kartenfarbe …", self.show_card_color_menu),
                ("Hintergrund …", self.show_background_menu),
                ("Zu Bereich springen …", self.show_area_jump_menu),
                ("Präsentieren (Bereiche als Folien)", self.start_presentation),
                ("Präsentation als PDF …", self.print_presentation),
                (("Neue Karten verbinden aus" if board.get("auto_connect") else "Neue Karten verbinden ein"),
                 lambda: self.configure_board("auto_connect", not self.board().get("auto_connect"))),
                (("Vollbild beenden" if self.board_focus_active() else "Vollbild"),
                 self.toggle_board_focus),
                ("Drucken und PDF …", self.print_board),
            ],
        }

    def show_card_context_menu(self, event=None):
        """Rechtsklick auf der Pinnwand: die Aktionen der getroffenen Karte.

        Eine Karte ließ sich bis 3.24 nur über die
        Schalterzeile oder per Doppelklick bearbeiten – auf einer Fläche, auf
        der man mit der Maus arbeitet, war das der weiteste Weg. Der
        Rechtsklick wählt die getroffene Karte aus, falls sie nicht ohnehin
        schon zur Auswahl gehört, und zeigt genau die Aktionen, die es für sie
        gibt. Auf freier Fläche zeigt er stattdessen, was man dort anlegen
        oder einstellen kann.
        """
        app = self.app
        if event is not None:
            x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
            getroffen = self.card_at(x, y)
            if not getroffen and self.board()["layout"] == "columns":
                treffer = self.column_hit(x, y)
                getroffen = treffer[0] if treffer else None
            if not getroffen and self.board()["layout"] != "columns":
                verbindung = self.connection_at(x, y)
                if verbindung is not None:
                    return self.show_connection_menu(event, verbindung)
                bereich, _teil = self.area_at(x, y)
                if bereich is not None and _teil in ("header", "grip"):
                    return self.show_area_menu(event, bereich)
            if getroffen and getroffen not in self.selected_ids:
                self.select_card(getroffen)
            elif not getroffen:
                self._context_point = (x / self.zoom_factor(), y / self.zoom_factor())
        gruppen = self.board_action_groups()
        menu = app._new_themed_popup_menu()
        if self.selection():
            titel = "AUSGEWÄHLTE KARTE" if len(self.selection()) == 1 else f"{len(self.selection())} KARTEN"
            menu.add_command(label=titel, state="disabled")
            for beschriftung, befehl in gruppen.get("Ausgewählte Karte", ()):
                menu.add_command(label="   " + beschriftung, command=befehl)
            menu.add_separator()
        stelle = getattr(self, "_context_point", None) or (24, 24)
        menu.add_command(label="FLÄCHE", state="disabled")
        menu.add_command(label="   Neue Aufgabe hier",
                         command=lambda: self.create_card_item(*stelle))
        menu.add_command(label="   Neue Notiz hier",
                         command=lambda: self.create_card_item(*stelle, app.ITEM_KIND_LONG))
        menu.add_command(label="   Anheften", command=self.choose_cards)
        if self.areas_visible():
            menu.add_command(label="   Neuer Bereich hier",
                             command=lambda: self.create_area(around_selection=False, point=stelle))
        menu.add_separator()
        menu.add_command(label="An Karten ausrichten: " + ("Ein" if self.board().get("object_snap") else "Aus"),
                             command=lambda: self.configure_board("object_snap", not self.board().get("object_snap", False)))
        menu.add_command(label="   Aktionen", command=self.show_board_actions_menu)
        try:
            if event is not None:
                menu.tk_popup(event.x_root, event.y_root)
            else:
                menu.tk_popup(app.root.winfo_pointerx(), app.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def show_board_actions_menu(self, event=None):
        """Alle Pinnwandaktionen, nach Gruppen getrennt."""
        app = self.app
        menu = app._new_themed_popup_menu()
        gruppen = self.board_action_groups()
        for index, name in enumerate(self.BOARD_ACTION_GROUPS):
            if index:
                menu.add_separator()
            menu.add_command(label=name.upper(), state="disabled")
            for beschriftung, befehl in gruppen.get(name, ()):
                menu.add_command(label="   " + beschriftung, command=befehl)
        try:
            menu.tk_popup(app.root.winfo_pointerx(), app.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def show_card_scale_menu(self, event=None):
        """Die drei Stufen der Kartengröße als Menü an der Schaltfläche."""
        app = self.app
        if not self.selection():
            app.show_warning("Kartengröße", "Zuerst eine Karte auswählen.")
            return "break"
        aktuelle = {card["item_id"]: card.get("scale", self.CARD_SCALE_DEFAULT)
                    for card in self.board()["cards"]}
        gewaehlt = {aktuelle.get(identity, self.CARD_SCALE_DEFAULT) for identity in self.selection()}
        menu = app._new_themed_popup_menu()
        for schluessel, name, _faktor in self.CARD_SCALES:
            marke = "\u2713 " if gewaehlt == {schluessel} else "    "
            menu.add_command(label=f"{marke}{name}",
                             command=lambda wert=schluessel: self.set_card_scale(wert))
        try:
            menu.tk_popup(app.root.winfo_pointerx(), app.root.winfo_pointery())
        finally:
            menu.grab_release()
        return "break"

    def set_card_scale(self, key):
        """Setzt den Maßstab der ausgewählten Karten.

        Größe ist auf einer Fläche das, was Einrückung in
        einer Liste ist. Sie hängt deshalb an der Karte und nicht am Punkt:
        Derselbe Punkt kann auf der Listenpinnwand ein Hauptgedanke und auf
        der globalen eine Randnotiz sein.
        """
        if key not in self.CARD_SCALE_FACTORS:
            return "break"
        kennungen = set(self.selection())
        if not kennungen:
            self.app.show_warning("Kartengröße", "Zuerst eine Karte auswählen.")
            return "break"
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for card in board["cards"]:
                if card["item_id"] in kennungen:
                    card["scale"] = key
        if self.save_view_change(change):
            self.draw_board()
        return "break"

    def choose_cards(self, scope=None):
        scope = scope or self.context()
        if not scope:
            return self.set_mode("board")
        app = self.app
        valid = self.valid_cards(scope)
        already = {card["item_id"] for card in self.board(scope)["cards"]}
        dialog = tk.Toplevel(app.root)
        dialog.title("Punkte anheften")
        dialog.configure(bg=app.theme["bg"])
        dialog.transient(app.root)
        dialog.minsize(460, 360)
        outer = tk.Frame(dialog, bg=app.theme["bg"])
        outer.pack(fill="both", expand=True, padx=24, pady=24)
        self.label(outer, "Vorhandene Punkte anheften", bold=True, size=16, bg="bg")
        self.label(outer, f"Mehrere Punkte mit {app.selection_modifier_name()} oder Shift auswählen. Bis zu {self.MAX_CARDS} Karten je Pinnwand.", bg="bg")
        query = tk.StringVar()
        entry = tk.Entry(outer, textvariable=query, font=app_font(11), bg=app.theme["input"],
                         fg=app.theme["text"], insertbackground=app.theme["text"], relief="flat",
                         highlightthickness=1, highlightbackground=app.theme["input_border"],
                         highlightcolor=app.theme["selection"])
        entry.pack(fill="x", pady=12)
        frame = tk.Frame(outer, bg=app.theme["bg"])
        frame.pack(fill="both", expand=True)
        tree = ttk.Treeview(frame, columns=("source",), show="tree headings", selectmode="extended", style="Dialog.Treeview", height=12)
        app.prepare_table(tree, (("#0", "Punkt", 340), ("source", "Liste", 180)), stretch="#0")
        scroll = app._attach_field_scrollbar(frame, tree)
        tree.pack(fill="both", expand=True)
        def render(*_):
            tree.delete(*tree.get_children())
            for identity, (source, item) in valid.items():
                if identity not in already and app.item_text_matches_query(item, query.get().strip().lower()):
                    if self.is_page_card(identity):
                        # Zeichnungen stehen als Seite in der Auswahl, nicht als Punkt.
                        tree.insert("", "end", iid=identity, text=f"{app.ICONS['drawing']}  {item['text']}",
                                    values=("Zeichnung",))
                        continue
                    tree.insert("", "end", iid=identity, text=app.item_display_text(item), values=(source.get("title", ""),))
        query.trace_add("write", render)
        render()
        chosen = []
        def accept(*_):
            chosen.extend(tree.selection())
            dialog.destroy()
            return "break"
        buttons = ButtonFlow(outer, bg=app.theme["bg"])
        buttons.pack(fill="x", pady=(16, 0))
        for label, command, color in (("Alle auswählen", lambda: tree.selection_set(tree.get_children()), "due_action"), ("Anheften", accept, "confirm"), ("Abbrechen", dialog.destroy, "muted")):
            buttons.add(app._make_dialog_button(buttons, label, command, color))
        tree.bind("<Return>", accept)
        dialog.bind("<Escape>", lambda e: dialog.destroy())
        app._center_dialog(dialog, min_width=650)
        app._schedule_windows_chrome_theme(dialog)
        entry.focus_set()
        app.run_modal(dialog)
        if chosen:
            available = self.MAX_CARDS - len(already)
            self.pin(chosen[:max(0, available)], scope) if available else None
            if len(chosen) > available:
                app.show_warning("Pinnwand voll", f"Pro Pinnwand sind höchstens {self.MAX_CARDS} Karten möglich.")
        return "break"

    def before_refresh(self):
        # Die Startseitenlogik erhält immer die ursprüngliche Pack-Reihenfolge.
        for widget, _info in self._saved_chrome:
            widget.pack_forget()
        for widget, info in self._saved_chrome:
            widget.pack(**info)
        self._saved_chrome = []

    def refresh(self):
        app = self.app
        # Nach dem Aufbau Fuß und Werkzeugleiste abgleichen (feste Fläche).
        app.schedule_fixed_layout_sync()
        self.prune()
        if self.auto_pin():
            self.prune()
        scope = self.context()
        if scope != self.scope:
            self.filter_label = ""
            self.selected_id = None
        self.scope = scope
        self.mode = app.settings["active_tab"].get(scope, "list")
        if not scope:
            self.mode = "list"
        if scope == self.GLOBAL_SCOPE:
            # Die globale Pinnwand hat keine Liste, in die sie zurückfallen
            # könnte: Ihre Ansicht ist die Fläche.
            self.mode = "board"
        self.visible = bool(scope and self.mode != "list")
        app.view_switch.pack_forget()
        app.table_columns_button.pack_forget()
        app.detail_button.pack_forget()
        journal_button = getattr(app, "journal_filter_button", None)
        if journal_button is not None:
            journal_button.pack_forget()
        app.plan_day_prev_button.pack_forget()
        app.plan_day_next_button.pack_forget()
        for name in ("plan_day_grid_button", "plan_day_mode_button"):
            knopf = getattr(app, name, None)
            if knopf is not None:
                knopf.pack_forget()
        # Der Zwischenraum sitzt links von jeder Schaltfläche.
        # Dadurch endet die Zeile immer bündig mit der Eingabezeile darüber –
        # gleichgültig, wie viele Schalter gerade sichtbar sind. Vorher trug
        # jede Schaltfläche ihren Abstand rechts; die äußerste stand dadurch
        # acht Pixel vor der Flucht, und zwischen „Suche löschen“ und
        # „Tabelle“ fehlte er ganz.
        # Der Umfang gilt für jede Ansicht, die Punkte als Zeilen zeigt –
        # Liste, Ordner und die abgeleiteten Übersichten. Die Tabelle hat
        # eigene Spalten und braucht ihn nicht.
        # Eine Bibliothek ist immer eine Tabelle (27.09.2026): kein
        # Informationsumfang und kein Ansichtsumschalter.
        bibliothek = app.is_library_view()
        if app.view_mode != app.TABLE_VIEW and not bibliothek and (
                self.mode == "list" or not scope) and app.view_mode not in (
                app.HOME_VIEW, app.HISTORY_VIEW, app.PAGES_VIEW, app.NOTES_VIEW, app.DRAWINGS_VIEW, app.TEMPLATE_VIEW, app.LIBRARY_VIEW, "trash"):
            app.pack_relative(app.detail_button, app.search_row_anchor(), side="right", padx=(8, 0))
        ordner = app.get_folder(app.active_folder_id) if app.view_mode == "folder" else None
        if journal_button is not None and ordner is not None and ordner.get("folder_kind") == "journal" \
                and self.mode == "list":
            app.sync_journal_filter_button()
            app.pack_relative(journal_button, app.detail_button, side="right", padx=(8, 0))
        if ((scope and scope != self.GLOBAL_SCOPE) or app.view_mode == app.TABLE_VIEW) and not bibliothek:
            # Liste · Tabelle · Pinnwand: ein fester Umschalter (27.09.2026).
            app.pack_relative(app.view_switch, app.search_row_anchor(), side="right", padx=(8, 0))
            if app.view_mode == app.TABLE_VIEW and self.mode != "board":
                app.pack_relative(app.table_columns_button, app.view_switch, side="right", padx=(8, 0))
        elif app.view_mode == app.PLAN_DAY_VIEW:
            # Die Tagesplanung gehört zu keiner Liste; ihre Tagesschalter
            # stehen deshalb an der Stelle, an der sonst Tabelle und Pinnwand
            # liegen.
            # „◀“ links, „▶“ rechts. Bei `side="right"`
            # steht das zuerst gepackte Widget am weitesten rechts – die
            # bisherige Reihenfolge drehte die Pfeile deshalb um und ließ den
            # Rückwärtspfeil rechts vom Vorwärtspfeil stehen.
            app.pack_relative(app.plan_day_prev_button, app.search_row_anchor(), side="right", padx=(8, 0))
            app.pack_relative(app.plan_day_next_button, app.plan_day_prev_button, side="right", padx=(8, 0))
            if getattr(app, "plan_day_grid_button", None) is not None:
                app.pack_relative(app.plan_day_grid_button, app.plan_day_next_button, side="right", padx=(8, 0))
                if getattr(app, "plan_day_mode_button", None) is not None:
                    app.pack_relative(app.plan_day_mode_button, app.plan_day_grid_button, side="right", padx=(8, 0))
        app.sync_view_switch_buttons()
        app.sync_detail_button()
        if self.visible:
            # Nur beim ersten Mal merken: Ein zweiter Durchlauf ohne
            # `before_refresh` fände die Zeilen bereits ausgeblendet vor und
            # verlöre damit die Reihenfolge für den Rückweg zur Liste.
            if not self._saved_chrome:
                self._saved_chrome = [(widget, widget.pack_info()) for widget in app.content_frame.pack_slaves()]
            # Hinweis und Auswahlleiste stehen im Kartenfuß; ihn regelt
            # `sync_card_foot` (29.09.2026).
            app.input_frame.pack_forget()
            app.list_frame.pack_forget()
            self.body.pack(fill="both", expand=True)
        else:
            self.body.pack_forget()
            note_visible = app.view_mode == "list" and app.current_list().get("list_kind") == "note"
            app.list_frame.pack(fill="x" if note_visible else "both", expand=not note_visible)
        self.render_tabs()
        if not self.visible:
            self._signature = None
            return
        # Beim Neuzeichnen Fokus und Scrollposition erhalten, Filtereingaben nicht zerstören.
        signature = (scope, self.mode, app.theme_name, app.settings.get("ui_font_size"),
                     json.dumps(app.theme, sort_keys=True), json.dumps(app.settings["pinboards"].get(scope), sort_keys=True),
                     json.dumps(self.eligible_lists(), sort_keys=True),
                     json.dumps(app.labels, sort_keys=True))
        if signature != self._signature:
            focus_inside = self.contains(app.current_focus_widget(), self.body)
            for child in self.body.winfo_children():
                child.destroy()
            self.body.configure(bg=app.theme["card"])
            self._signature = signature
            if self.mode == "board":
                self.render_board()
            else:
                self.selected_id = self.mode
                self.render_detail()
            if focus_inside:
                self.focus_card(self.selected_id) if self.mode == "board" else self.focus_active_tab()
        elif self.mode == "board":
            self.draw_board()
        # Verdeckte Baumzeilen dürfen nie versehentlich als Auswahl dienen.
        app.tree.selection_remove(app.tree.selection())
        if app.view_mode == "list" and self.selected_id and app.tree.exists(self.selected_id):
            app.tree.selection_set(self.selected_id)
            app.tree.focus(self.selected_id)

    @staticmethod
    def contains(widget, parent):
        return widget is not None and (widget is parent or str(widget).startswith(str(parent) + "."))

    def label(self, parent, text, bold=False, size=10, bg="card", color="text"):
        widget = tk.Label(parent, text=text, bg=self.app.theme[bg], fg=self.app.theme[color],
                          font=app_font(size, *(('bold',) if bold else ())), anchor="w", justify="left")
        widget.pack(fill="x", pady=(0, 10))
        widget.bind("<Configure>", lambda e: widget.configure(wraplength=max(100, e.width - 12)))
        return widget

    def group_caption(self, parent, text):
        """Überschrift einer Aktionsgruppe – klein, ruhig, links bündig.

        Elf Schaltflächen in einer einzigen Reihe sind
        keine Ordnung, sondern eine Aufzählung. Die Gruppen benennen, worauf
        eine Aktion wirkt: auf den Inhalt der Fläche, auf die ausgewählte
        Karte oder auf die Fläche selbst.
        """
        widget = tk.Label(parent, text=text.upper(), bg=self.app.theme["card"],
                          fg=self.app.theme["muted"], font=app_font(8, "bold"),
                          anchor="w", justify="left")
        widget.pack(fill="x", pady=(6, 2))
        return widget

    def action_row(self, parent, specs):
        row = ButtonFlow(parent, bg=self.app.theme["card"], gap=8)
        row.pack(fill="x", pady=(4, 10))
        for text, command, color in specs:
            width = tkfont.Font(font=app_font(10, "bold")).measure(text) + 26
            button = self.app._make_dialog_button(row, text, command, color, width=min(360, width), height=36)
            if width > 360:
                button.set_text(self.truncate_lines(text, tkfont.Font(font=app_font(10, "bold")), 334, 1))
                self.app.add_tooltip(button, text)
            row.add(button)
        return row

    def render_tabs(self):
        app = self.app
        tabs = [tab for tab in app.settings["open_tabs"] if self.scope == "list:" + tab["list_id"]]
        board = self.board() if self.mode == "board" else {}
        signature = (self.scope, self.mode, app.theme_name, app.settings.get("ui_font_size"),
                     app.theme["selection"], app.theme.get("active"), app.height_density() == "full",
                     # Anordnung und Labelfilter stehen seit 3.33.21 (U09) in dieser Zeile.
                     tuple(board.get(key) for key in ("snap", "preview", "auto", "layout")),
                     getattr(self, "filter_label", "") if self.mode == "board" else "",
                     tuple((tab["item_id"], app.item_display_text(app.find_item_in_lists(tab["item_id"])[0])) for tab in tabs))
        if getattr(self, "_tab_signature", None) == signature:
            return
        focused = self.contains(app.current_focus_widget(), self.bar)
        self._tab_signature = signature
        for child in self.bar.winfo_children():
            child.destroy()
        self.tab_buttons = {}
        self.bar.configure(bg=app.theme["card"])
        self.bar.pack_forget()
        if not self.scope or not (tabs or self.mode == "board"):
            return
        self.bar.pack(fill="x", before=self.body if self.visible else app.list_frame)
        line = tk.Frame(self.bar, bg=app.theme["card"])
        line.pack(fill="x")
        # Zweite Zeile nur, wenn Aktionen und Schalter nicht nebeneinander
        # passen. Alle Knöpfe gehören zu `self.bar` und werden mit `in_` in
        # eine der beiden Zeilen gepackt – Tk kann Widgets nicht umhängen.
        zeile2 = tk.Frame(self.bar, bg=app.theme["card"])
        overview = app._make_dialog_button(self.bar, "Reiter", self.tab_overview, "muted", width=100, height=34)
        # Alles in der Pinnwandzeile steht links bündig (Rückmeldung 26.09.2026);
        # „Reiter“ folgt als Letztes. Gepackt wird in `pinnwand_dichte`.
        if self.mode != "board":
            overview.pack(in_=line, side="right", padx=(8, 0))
        zurueck = None
        # Die globale Pinnwand gehört zu keiner Liste und
        # hatte deshalb auch keinen Reiter, der zurückführt. Escape brachte
        # zwar in die Übersicht, aber nichts sagte das. Der Rückweg steht jetzt
        # dort, wo man ihn sucht: als erste Fläche der Reiterzeile.
        if self.scope == self.GLOBAL_SCOPE:
            zurueck = app._make_dialog_button(
                line, f"{app.ICONS['back']}  Übersicht", app.set_library_view, "muted",
                width=118, height=34)
            zurueck.pack(side="left", padx=(0, 10))
            app.add_tooltip(zurueck, "Zurück zu Listen und Ordnern · Escape")
        # Die Pinnwandschalter stehen in derselben Zeile wie
        # „Liste" und „Pinnwand". Damit entfällt unter der Auswahl eine ganze
        # Schaltflächenreihe und die Fläche beginnt weiter oben.
        if self.mode == "board":
            aktionen = self.board_action_buttons(self.bar)
            schalter = self.board_controls(self.bar)
            # Nach den Zeilen erzeugt stehen sie ohnehin darüber; `raise` hält
            # das auch für „Reiter“ fest (`Canvas.lift` hebt nur Zeichenelemente).
            for button in aktionen + schalter + [overview]:
                button.tk.call("raise", button._w)
            # Bei schmaler Zeile bleiben nur die beiden
            # Schalter stehen, die man beim Arbeiten anfasst.
            wichtig = {"Raster", "Finden", "Vollbild", "Vollbild beenden", "Mehr"}
            zweitrangig = [b for b in schalter if getattr(b, "text", "") not in wichtig]

            zurueck_text = zurueck.text if zurueck is not None else ""
            zurueck_breite = int(zurueck.cget("width")) if zurueck is not None else 0

            def zurueck_kurz(kurz):
                # `set_text` lässt eine Schaltfläche nur wachsen; für den Pfeil
                # wird die Breite ausdrücklich zurückgenommen.
                if zurueck is None:
                    return
                if kurz:
                    zurueck.set_text(app.ICONS["back"])
                    zurueck.min_width = 44
                    zurueck.configure(width=44)
                else:
                    zurueck.min_width = zurueck_breite
                    zurueck.configure(width=zurueck_breite)
                    zurueck.set_text(zurueck_text)

            def pinnwand_dichte(event=None):
                """Gemessen statt geschätzt: Bei großer Schrift reichte die
                feste Schwelle nicht, und „Raster“ wurde gequetscht.

                Stufe 1 blendet die Nebenschalter aus, Stufe 2 zusätzlich
                „Reiter“ (Ansicht › Reiter), Stufe 3 kürzt „Übersicht“ auf den
                Pfeil (Escape führt ebenfalls zurück).
                """
                breite = event.width if event is not None else line.winfo_width()
                if breite <= 1:
                    return
                zurueck_kurz(False)
                haupt = [b for b in schalter if b not in zweitrangig]
                # „Bearbeiten“ und „Verbinden“ weichen bei Mindestbreite
                # zuerst; beide stehen auch unter „Aktionen“.
                sichtbare_aktionen = list(aktionen)
                if breite < sum(b.winfo_reqwidth() + 6 for b in aktionen) + 12 + (
                        zurueck.winfo_reqwidth() + 10 if zurueck is not None else 0):
                    sichtbare_aktionen = [b for b in aktionen if b.text not in ("Bearbeiten", "Verbinden")]
                bedarf_aktionen = sum(b.winfo_reqwidth() + 6 for b in sichtbare_aktionen) + 12
                bedarf_haupt = sum(b.winfo_reqwidth() + 6 for b in haupt)
                bedarf_neben = sum(b.winfo_reqwidth() + 6 for b in zweitrangig)
                bedarf_reiter = overview.winfo_reqwidth() + 8
                bedarf_zurueck = zurueck.winfo_reqwidth() + 10 if zurueck is not None else 0
                # Eine Zeile, solange neben den Aktionen wenigstens die
                # Hauptschalter und „Reiter“ Platz haben; sonst stehen die
                # Schalter in einer zweiten Zeile mit voller Breite.
                einzeilig = breite >= bedarf_zurueck + bedarf_aktionen + bedarf_haupt + bedarf_reiter
                rest = breite - bedarf_zurueck - bedarf_aktionen if einzeilig else breite
                if rest >= bedarf_haupt + bedarf_neben + bedarf_reiter:
                    stufe = 0
                elif rest >= bedarf_haupt + bedarf_reiter:
                    stufe = 1
                elif rest >= bedarf_haupt:
                    stufe = 2
                else:
                    stufe = 3
                kurz = breite < bedarf_zurueck + bedarf_aktionen
                zustand = (stufe, einzeilig, kurz, len(sichtbare_aktionen))
                if zustand == getattr(self, "_board_controls_narrow", None):
                    zurueck_kurz(kurz)
                    return
                self._board_controls_narrow = zustand
                ziel = line if einzeilig else zeile2
                try:
                    overview.pack_forget()
                    for knopf in aktionen + schalter:
                        knopf.pack_forget()
                    for index, knopf in enumerate(sichtbare_aktionen):
                        knopf.pack(in_=line, side="left",
                                   padx=(0, 16 if einzeilig and index == len(sichtbare_aktionen) - 1 else 6))
                    for knopf in schalter:
                        if stufe == 0 or knopf not in zweitrangig:
                            knopf.pack(in_=ziel, side="left", padx=(0, 6))
                    if stufe < 2:
                        overview.pack(in_=ziel, side="left", padx=(2, 0))
                    if einzeilig:
                        zeile2.pack_forget()
                    else:
                        zeile2.pack(fill="x", pady=(6, 0), after=line)
                    zurueck_kurz(kurz)
                except tk.TclError:
                    pass

            self._board_controls_narrow = None
            line.bind("<Configure>", pinnwand_dichte, add="+")
            line.after_idle(pinnwand_dichte)
        # Die drei Darstellungen Liste/Tabelle/Pinnwand werden ausschließlich
        # in der gemeinsamen Suchzeile geschaltet. In dieser Reiterzeile stehen
        # nur tatsächlich geöffnete Punkt-Reiter – dadurch erscheint „Pinnwand“
        # nicht mehr doppelt und die aktive Ansicht wird nicht wiederholt.
        if tabs:
            canvas = tk.Canvas(line, bg=app.theme["card"], height=40, highlightthickness=0)
            canvas.pack(fill="x", expand=True)
            frame = tk.Frame(canvas, bg=app.theme["card"])
            canvas.create_window((0, 0), window=frame, anchor="nw")
            specs = []
            for tab in tabs:
                found = app.find_item_in_lists(tab["item_id"])
                title = app.item_display_text(found[0])
                specs.append((tab["item_id"], title, lambda identity=tab["item_id"]: self.open_tab(identity)))
            for identity, title, command in specs:
                short = self.tab_label(title)
                button = app._make_dialog_button(
                    frame, short, command, "accent" if identity == self.mode else "muted",
                    width=min(self.TAB_MAX_WIDTH, tkfont.Font(font=app_font(10, "bold")).measure(short)
                              + self.TAB_TEXT_INSET), height=34)
                if identity == self.mode:
                    button.configure(bg=app.theme["active"])
                    button.set_theme(bg_color=app.theme["card"], text_color=app.theme["active_text"],
                                     border_color=app.theme["active"], hover_fill=app.theme["active"],
                                     hover_text_color=app.theme["active_text"])
                    button.set_active(app.theme["active"], app.theme["active_text"])
                button.pack(side="left", padx=(0, 6))
                app.add_tooltip(button, title)
                self.tab_buttons[identity] = button
            def layout(_event=None):
                canvas.configure(scrollregion=canvas.bbox("all"))
            frame.bind("<Configure>", layout)
            canvas.bind("<Configure>", layout)
        hinweis = f"Strg+Bild↑/Bild↓: Reiter wechseln · {app.accel('Shift', 'W')}: Reiter schließen"
        if self.mode == "board":
            # Seit dem 29.09.2026 steht hier auch, was vorher als eigene Zeile
            # unter der Fläche stand: Die Pinnwand reicht jetzt bis unten.
            hinweis = ("Karten ziehen: verschieben · Doppelklick: öffnen · Rechtsklick: Karte, Bereich und "
                       "Fläche · vom Kartenrand ziehen: verbinden · "
                       f"Pfeiltasten: Auswahl · {app.selection_modifier_name()}+Klick: mehrere auswählen · "
                       "Auswahlrechteck: ganze Karten einschließen · Alt+Pfeiltasten: verschieben · "
                       "Enter: bearbeiten · Entf: von Pinnwand nehmen · Shift+Rad: quer · "
                       "gedrücktes Mausrad: Fläche ziehen")
            if app.height_density() != "full":
                # Bei niedrigem Fenster eine Zeile statt drei; die vollständige
                # Liste steht in der Hilfe und hinter „Aktionen“.
                hinweis = "Pfeiltasten: Auswahl · Enter: bearbeiten · Entf: von Pinnwand nehmen"
        self._board_notice_text = hinweis
        self.notice = self.label(self.bar, hinweis, size=8, color="muted")
        self.update_selection_notice()
        if focused:
            self.focus_active_tab()

    @classmethod
    def tab_label(cls, title):
        """Reiterbeschriftung: erkennbar kurz, am Wortende geschnitten.

        Ein Schnitt mitten im Wort („Anstehende Au…“) ist
        schwerer zu lesen als ein kürzerer am Wortende („Anstehende…“). Bleibt
        dabei weniger als die Hälfte übrig, bringt der Wortschnitt nichts mehr
        und der harte Schnitt gilt.
        """
        text = " ".join(str(title or "").split())
        if len(text) <= cls.TAB_LABEL_CHARS:
            return text or "Ohne Titel"
        schnitt = text[:cls.TAB_LABEL_CHARS]
        luecke = schnitt.rfind(" ")
        if luecke >= cls.TAB_LABEL_CHARS // 2:
            schnitt = schnitt[:luecke]
        return schnitt.rstrip(" ,.;:-–—") + "…"

    def tab_overview(self):
        choices = []

        for index, tab in enumerate(self.app.settings["open_tabs"], 1):
            found = self.app.find_item_in_lists(tab["item_id"])
            if found:
                label = f"{index}. {found[3].get('title', '')} · {self.app.item_display_text(found[0])}"
                choices.append((tab["item_id"], label))
        if not choices:
            return self.app.show_info("Reiter", "Noch keine Punktreiter geöffnet. Einen Punkt auswählen und „Als Reiter öffnen“ benutzen.")
        chosen = self.app.themed_choice_dialog("Offene Reiter", "Reiter auswählen", choices)
        if chosen:
            self.open_tab(chosen)

    def focus_active_tab(self):
        target = self.tab_buttons.get(self.mode)
        if target:
            target.focus_set()

    def render_detail(self):
        app = self.app
        found = app.find_item_in_lists(self.mode)
        if not found:
            return
        item = found[0]
        self.action_row(self.body, [("Bearbeiten", lambda: self.edit(item["id"]), "accent"),
                                   ("In Liste zeigen", lambda: self.open_source(item["id"]), "muted"),
                                   ("Anheften", lambda: self.pin([item["id"]]), "due_action"),
                                   ("Reiter schließen", self.close_tab, "muted")])
        canvas = tk.Canvas(self.body, bg=app.theme["card"], highlightthickness=0)
        scrollbar = app._attach_field_scrollbar(self.body, canvas)
        canvas.pack(fill="both", expand=True)
        content = tk.Frame(canvas, bg=app.theme["card"])
        window = canvas.create_window((12, 12), window=content, anchor="nw")
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(window, width=max(100, e.width-32)))
        content.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        self.detail_title = self.label(content, item.get("text", ""), bold=True, size=18)
        kind = app.ITEM_KIND_LABELS.get(app.item_kind(item), "Aufgabe")
        self.label(content, kind, color=app.kind_color_key(app.item_kind(item)))
        if app.is_schedulable_item(item):
            self.action_row(content, [("Als offen markieren" if item.get("done") else "Als erledigt markieren",
                                       lambda: self.toggle(item["id"]), "confirm")])
            self.label(content, "Wichtigkeit: " + ("Keine", "Niedrig", "Mittel", "Hoch")[app.clamp_importance(item.get("importance", 0))])
            self.label(content, "Bearbeitungstag: " + (app.format_due_display(item.get("planned_date")) or "Nicht geplant"))
            self.label(content, "Geschätzter Aufwand: " + (app.format_estimated_minutes(item.get("estimated_minutes")) or "Nicht geschätzt"))
            self.label(content, "Fälligkeit: " + (app.format_due_full(item.get("due"), item.get("due_time")) if item.get("due") else "Ohne Termin"))
            self.label(content, "Wiederholung: " + (app.describe_repeat(item.get("repeat")) or "Keine"))
            reminder = app.normalize_reminder(item.get("reminder"))
            if reminder:
                event = app.reminder_event(item)
                stamp = datetime.fromisoformat(event["at"]).astimezone().strftime("%d.%m.%Y, %H:%M") if event else "Ohne nächsten Zeitpunkt"
                self.label(content, "Benachrichtigung: " + stamp)
            else:
                self.label(content, "Benachrichtigung: Keine")
        labels = app.item_labels(item)
        self.label(content, "Labels", bold=True)
        if labels:
            chips = tk.Frame(content, bg=app.theme["card"])
            chips.pack(fill="x", pady=(0, 14))
            app.pack_label_chips(chips, labels, bg_key="card", max_width=max(220, app.list_frame_outer.winfo_width()-60))
        else:
            self.label(content, "Keine Labels.", color="muted")
        fortschritt = app.checklist_progress(item)
        if fortschritt["total"]:
            self.label(content, f"Checkliste · {fortschritt['done']} von {fortschritt['total']} erledigt", bold=True)
            for eintrag in item.get("checklist", []):
                marke = app.ICONS["check"] if eintrag.get("done") else app.ICONS["task_open"]
                self.label(content, f"{marke}  {eintrag.get('text', '')}",
                           color="muted" if eintrag.get("done") else "text")
        self.label(content, "Beschreibung", bold=True)
        self.label(content, item.get("description") or "Noch keine Beschreibung.")
        self.label(content, "Anhänge", bold=True)
        if not item.get("attachments"):
            self.label(content, "Keine Anhänge.", color="muted")
        for attachment in item.get("attachments", []):
            self.action_row(content, [(f"{app.ICONS['attachment']} {attachment.get('name', 'Anhang')}",
                                       lambda attachment=attachment: self.open_attachment(attachment), "import")])
        if item.get("children"):
            self.label(content, "Unterpunkte", bold=True)
            def children_with_depth(items, depth=0):
                for child in items:
                    yield child, depth
                    yield from children_with_depth(child.get("children", []), depth+1)
            for child, depth in children_with_depth(item["children"]):
                panel = tk.Frame(content, bg=app.theme["card"])
                panel.pack(fill="x", padx=(min(80, depth*20), 0), pady=(0, 8))
                if app.is_heading_item(child):
                    self.label(panel, app.item_display_text(child), bold=True)
                    continue
                text = app.item_display_text(child)
                self.label(panel, text, bold=app.is_group_item(child))
                specs = [("Bearbeiten", lambda identity=child["id"]: self.edit(identity), "accent"),
                         ("Als Reiter öffnen", lambda identity=child["id"]: self.open_tab(identity), "muted")]
                if app.is_schedulable_item(child):
                    specs.insert(0, (f"{app.ICONS['check']} Erledigt" if child.get("done") else "Erledigen",
                                     lambda identity=child["id"]: self.toggle(identity), "confirm"))
                self.action_row(panel, specs)
        self.bind_scrolling(content, canvas)

    def bind_scrolling(self, widget, canvas):
        self.app._bind_canvas_wheel(widget, canvas)
        for child in widget.winfo_children():
            self.bind_scrolling(child, canvas)

    def edit(self, item_id=None):
        identity = item_id or self.selected_id
        if self.is_page_card(identity):
            return self.open_page_card(identity)
        if identity:
            self.app.edit_in_progress_item(identity)
        return "break"

    def open_page_card(self, identity):
        """Öffnet die Originalzeichnung; der Rückweg führt auf diese Pinnwand."""
        app = self.app
        page_id = identity[len(self.PAGE_CARD_PREFIX):]
        if not any(entry.get("id") == page_id for entry in app.lists):
            return "break"
        app._board_return = {"scope": self.context(), "page_id": page_id}
        app.set_active_list(page_id)
        return "break"

    def toggle(self, item_id=None):
        app = self.app
        kennungen = [item_id] if item_id else self.active_ids()
        betroffen = [identity for identity in kennungen
                     if (lambda gefunden: gefunden and app.is_schedulable_item(gefunden[0]))(
                         app.find_item_in_lists(identity))]
        if not betroffen:
            return "break"
        offen = [app.find_item_in_lists(identity)[0] for identity in betroffen
                 if not app.find_item_in_lists(identity)[0].get("done")]
        if offen and not app.confirm_complete_blocked(offen):
            return "break"
        with app.item_change(betroffen, restore=False) as change:
            erledigt = []
            for identity in betroffen:
                item = app.find_item_in_lists(identity)[0]
                item["done"] = not item.get("done", False)
                if item["done"]:
                    erledigt.append(identity)
            if erledigt:
                advanced = app.advance_repeating_items(erledigt)
                if advanced:
                    app.book_completions(advanced)
            change.mark()
        return "break"

    def open_attachment(self, attachment):
        path = self.app.resolve_attachment_path(attachment)
        if path and os.path.isfile(path):
            self.app.open_external_path(path)
        else:
            self.app.show_warning("Anhang nicht gefunden", "Die Datei ist in der Datenablage nicht verfügbar.")

    def open_source(self, item_id=None):
        app = self.app
        identity = item_id or self.selected_id
        found = app.find_item_in_lists(identity)
        if found:
            scope = "list:" + found[3]["id"]
            if self.save_view_change(lambda: app.settings["active_tab"].__setitem__(scope, "list")):
                app.search_var.set("")
                app.hide_done_var.set(False)
                app.set_active_list(found[3]["id"])
                app.refresh_tree(selected_id=identity)
                app.tree.focus_set()
        return "break"

    def render_board(self):
        app = self.app
        board = self.board()
        # Bildvorschauen halten ihre PhotoImage-Objekte; ohne eigene Referenz
        # räumt Python sie ab und die Fläche bliebe leer.
        self._card_images = []
        self._preview_cache = getattr(self, "_preview_cache", {})
        # Elf gleich aussehende Schaltflächen in einer Reihe
        # sind keine Ordnung, sondern eine Aufzählung – und sie kosteten vier
        # Zeilen Höhe, die der Fläche fehlten. Sichtbar bleibt, was man beim
        # Arbeiten anfasst; alles Übrige steht unter „Weitere Aktionen …“ in
        # benannten Gruppen: Inhalt, Karte, Fläche. Die Trennung ist keine
        # Optik, sondern die Frage, worauf eine Aktion wirkt.
        # Die Aktionen (Anheften, Neue Aufgabe, Bearbeiten, Verbinden,
        # Aktionen) stehen seit dem 27.09.2026 in der Schalterzeile darüber
        # (`board_action_buttons`): Zwei halbvolle Reihen waren eine zu viel.
        # Seit 3.33.21 (U09) keine eigene Einstellungszeile mehr: „Anordnung“
        # steht in der Schalterzeile, Labelfilter, Kartengröße, Verbindungsart,
        # Zoom, Navigator, Vorschau und Auto-Anheften im Menü „…“ daneben
        # (`board_settings_menu`). Die Fläche beginnt eine Zeile höher.
        if board["layout"] == "columns":
            self.render_column_options()
        frame = tk.Frame(self.body, bg=app.theme["card"])
        frame.pack(fill="both", expand=True)
        self.canvas = tk.Canvas(frame, bg=app.theme["bg"], highlightthickness=1,
                                highlightbackground=app.theme["line"], highlightcolor=app.theme["selection"],
                                takefocus=True, xscrollincrement=12, yscrollincrement=12)
        vertical = app._attach_field_scrollbar(frame, self.canvas)
        # dieselbe gezeichnete Leiste wie überall sonst.
        # Vorher stand hier eine native ttk.Scrollbar, die unter Windows im
        # Systemstil erschien und weder Theme noch Rundung übernahm.
        horizontal = ThemedAutoScrollbar(
            frame, bg_color=app.theme["card"], track_color=app.theme["card"],
            thumb_color=app.theme["input_border"], active_thumb_color=app.theme["muted"],
            width=10, radius=5, orient="horizontal",
        )
        horizontal.configure(width=1)
        horizontal.pack(side="bottom", fill="x", pady=(4, 0))
        horizontal.set_command(self.canvas.xview)
        self.canvas.configure(xscrollcommand=horizontal.set)
        self.horizontal_scrollbar = horizontal
        self.canvas.pack(fill="both", expand=True)
        self.navigator = tk.Canvas(frame, width=170, height=110, bg=app.theme["card"],
                                   highlightthickness=1, highlightbackground=app.theme["line"])
        self.navigator.bind("<Button-1>", self.navigate_board)
        self.navigator.bind("<B1-Motion>", self.navigate_board)
        self.canvas.configure(
            xscrollcommand=lambda first, last: (horizontal.set(first, last), self.draw_navigator(),
                                                self.schedule_background(), self.follow_presentation_overlay()),
            yscrollcommand=lambda first, last: (vertical.set(first, last), self.draw_navigator(),
                                                self.schedule_background(), self.follow_presentation_overlay()))
        self.canvas.bind("<Configure>", lambda e: self.draw_board())
        self.canvas.bind("<FocusIn>", lambda e: self.draw_board())
        # Escape verlässt zuerst das, was gerade
        # „darüberliegt“ – erst das Verbinden, dann den Fokusmodus, dann die
        # Pinnwand. Sonst führte eine einzige Taste je nach Zustand an drei
        # verschiedene Orte.
        self.canvas.bind("<Escape>", self.board_escape)
        self.canvas.bind("<F11>", self.toggle_board_focus)
        self.canvas.bind("<ButtonPress-1>", self.card_press)
        self.canvas.bind("<B1-Motion>", self.card_motion)
        self.canvas.bind("<ButtonRelease-1>", self.card_release)
        self.canvas.bind("<Double-Button-1>", self.card_double_click)
        self.canvas.bind("<Button-3>", self.show_card_context_menu)
        self.canvas.bind("<Button-2>", self.show_card_context_menu)
        self.canvas.bind("<Return>", lambda e: self.edit())
        self.canvas.bind("<space>", lambda e: self.presentation_step(1) if self.presentation_active() else self.toggle())
        self.canvas.bind("<Next>", lambda e: self.presentation_step(1) if self.presentation_active() else None)
        self.canvas.bind("<Prior>", lambda e: self.presentation_step(-1) if self.presentation_active() else None)
        # Ist ein Bereich gewählt und keine Karte, meinen F2 und Entfernen den Bereich.
        self.canvas.bind("<F2>", lambda e: self.rename_area() if self.area_selected_only() else self.edit())
        self.canvas.bind("<Delete>", lambda e: self.delete_area() if self.area_selected_only() else self.unpin())
        self.canvas.bind("<BackSpace>", lambda e: self.delete_area() if self.area_selected_only() else self.unpin())
        # Schnell weiterdenken (PW-050): neue Karte rechts daneben.
        self.canvas.bind("<Control-Return>", self.quick_next_card)
        if IS_MACOS:
            self.canvas.bind("<Command-Return>", self.quick_next_card)
        for key, delta in (("Left", -1), ("Right", 1), ("Up", -1), ("Down", 1)):
            self.canvas.bind(f"<{key}>", lambda e, step=delta: self.next_card(step))
        for key, delta in (("Left", (-1, 0)), ("Right", (1, 0)), ("Up", (0, -1)), ("Down", (0, 1))):
            self.canvas.bind(f"<Alt-{key}>", lambda e, delta=delta: self.move_card(*delta))
        self.canvas.bind("<Home>", lambda e: self.focus_card(self.card_ids[0] if self.card_ids else None))
        self.canvas.bind("<End>", lambda e: self.focus_card(self.card_ids[-1] if self.card_ids else None))
        app.bind_mousewheel(self.canvas, target=self.canvas)
        # Shift und Rad schieben quer, das gedrückte Rad
        # zieht die Fläche wie in einer Karten- oder Notizanwendung.
        app.bind_horizontal_wheel(self.canvas, self.canvas)
        app.bind_drag_scroll(self.canvas, canvas=self.canvas)
        self.draw_board()

    # ------------------------------------------------------------------
    # Die Pinnwand als Druckseite.
    #
    # Gedruckt wird nicht der Bildschirmausschnitt, sondern die Fläche, auf
    # der tatsächlich etwas liegt: Aus den Kartenpositionen entsteht ein
    # umschließendes Rechteck, dessen linke obere Ecke als Nullpunkt dient.
    # Leerraum ringsum fällt damit weg, und das Papierformat folgt dem
    # Seitenverhältnis dieses Rechtecks statt einer festen Vorgabe.
    #
    # Der Weg ist derselbe wie bei jeder anderen Druckausgabe in Glide: eine
    # eigenständige HTML-Seite ohne externe Verweise, die das Standardprogramm
    # druckt oder als PDF sichert. Eine eigene PDF-Bibliothek würde eine neue
    # Laufzeitabhängigkeit bedeuten – und die Regel, dass Glide ohne
    # Zusatzinstallation läuft, wiegt schwerer als ein selbst erzeugtes PDF.
    BOARD_PRINT_MARGIN = 24
    BOARD_PRINT_MAX_WIDTH_MM = 900
    BOARD_PRINT_SCALE = 0.26  # Bildschirmpixel zu Millimeter

    def logical_card_boxes(self):
        """Druck und Modellberechnungen verwenden unskalierte Geometrie."""
        factor = self.zoom_factor()
        return {identity: tuple(value / factor for value in box)
                for identity, box in self.card_boxes.items()}

    def board_print_geometry(self):
        """Das benutzte Rechteck der Fläche als (x, y, breite, hoehe)."""
        boxes = dict(self.logical_card_boxes())
        if self.areas_visible():
            for area in self.area_list():
                boxes["area:" + area["id"]] = (area["x"], area["y"], area["w"], area["h"])
        if not boxes:
            return None
        links = min(box[0] for box in boxes.values())
        oben = min(box[1] for box in boxes.values())
        rechts = max(box[0] + box[2] for box in boxes.values())
        unten = max(box[1] + box[3] for box in boxes.values())
        rand = self.BOARD_PRINT_MARGIN
        return (links - rand, oben - rand,
                (rechts - links) + rand * 2, (unten - oben) + rand * 2)

    # Gemeinsame Druckstile der Pinnwand- und der Folienausgabe.
    BOARD_PRINT_CSS = (
        "* { box-sizing: border-box; }",
        "body { margin: 0; font-family: 'DejaVu Sans', 'Helvetica Neue', Arial, sans-serif;"
        " color: #111; background: #fff; }",
        "div.card { position: absolute; border: 0.6pt solid #666; border-radius: 2mm;"
        " padding: 1.6mm 2mm; overflow: hidden; background: #fff; }",
        "div.card b { display: block; font-size: 8.5pt; line-height: 1.25; }",
        "div.card span { display: block; font-size: 7pt; color: #444; margin-top: 0.8mm; }",
        "div.card.done b { text-decoration: line-through; color: #555; }",
        "svg.links { position: absolute; left: 0; top: 0; overflow: visible; }",
        "div.area { position: absolute; border: 1pt solid #888; border-radius: 1mm; }",
        "div.area b { display: block; font-size: 8pt; padding: 1mm 2mm; }",
        "div.colhead { position: absolute; font-size: 8.5pt; font-weight: bold;"
        " border-bottom: 0.6pt solid #666; }",
        # Pixel bleiben Pixel: keine Glättung beim Vergrößern.
        "div.card img.pixel { display: block; width: 100%; max-height: calc(100% - 7mm); object-fit: contain;"
        " margin-top: 1mm; image-rendering: pixelated; image-rendering: crisp-edges; }",
    )

    def drawing_data_uri(self, entry, kante=160):
        """Die Zeichnung einer Seite als PNG-Data-URI für Druckseiten – oder None."""
        try:
            modell = glide_drawing.DrawingModel.from_document((entry or {}).get("drawing"))
            daten = modell.to_png(scale=max(1, kante // max(1, modell.width)))
        except (ValueError, TypeError, KeyError, AttributeError):
            return None
        return "data:image/png;base64," + base64.b64encode(daten).decode("ascii")
    # Nutzfläche einer Folie in mm: A4 quer abzüglich Rand und Kopfzeile.
    PRESENTATION_PAGE_MM = (273, 158)

    def build_board_print_html(self):
        """Erzeugt die Druckseite der aktuellen Pinnwand."""
        app = self.app
        boxes = self.logical_card_boxes()
        geometrie = self.board_print_geometry()
        if geometrie is None:
            raise ValueError("Auf dieser Pinnwand liegt noch keine Karte.")
        ursprung_x, ursprung_y, breite, hoehe = geometrie
        titel = app.get_display_title()
        skala = self.BOARD_PRINT_SCALE
        seiten_breite = min(self.BOARD_PRINT_MAX_WIDTH_MM, max(120, breite * skala))
        seiten_hoehe = max(120, hoehe * skala)
        esc = app.escape_print_text
        zeilen = [
            "<!DOCTYPE html>", '<html lang="de">', "<head>", '<meta charset="utf-8">',
            f"<title>{esc(titel)} · Pinnwand · {APP_NAME}</title>", "<style>",
            # Das Papier bekommt die Form der Fläche. Wer lieber auf A4
            # druckt, stellt das im Druckdialog um; der Inhalt skaliert mit.
            f"@page {{ size: {seiten_breite:.0f}mm {seiten_hoehe + 24:.0f}mm; margin: 10mm; }}",
            *self.BOARD_PRINT_CSS,
            "header { margin-bottom: 6mm; }",
            "h1 { font-size: 15pt; margin: 0 0 1mm; }",
            "p.subtitle { margin: 0; font-size: 9pt; color: #444; }",
            f"div.board {{ position: relative; width: {breite * skala:.1f}mm;"
            f" height: {hoehe * skala:.1f}mm; }}",
            "footer { margin-top: 5mm; font-size: 8pt; color: #555; }",
            self.print_background_css(skala),
            "</style>", "</head>", "<body>", "<header>",
            f"<h1>{esc(titel)} · Pinnwand</h1>",
            f'<p class="subtitle">{len(boxes)} Karten · '
            f'{len(self.connections())} Verbindungen · '
            f'{esc(datetime.now().strftime("%d.%m.%Y, %H:%M"))}</p>',
            "</header>", '<div class="board">',
        ]
        zeilen.extend(self.board_region_lines(ursprung_x, ursprung_y, breite, hoehe, skala))
        zeilen.extend([
            "</div>",
            f"<footer>{esc(APP_PRODUCT_NAME)} {APP_VERSION} · gedruckt wird die belegte Fläche, "
            "nicht der Bildschirmausschnitt.</footer>",
            "</body>", "</html>",
        ])
        return "\n".join(zeilen)

    def board_region_lines(self, ursprung_x, ursprung_y, breite, hoehe, skala, nur=None):
        """Bereiche, Spaltenköpfe, Verbindungen und Karten eines Flächenausschnitts als HTML.

        `nur` beschränkt Karten und Verbindungen auf diese Kennungen und lässt
        Bereiche und Spaltenköpfe weg – so zeigt jede Folie genau ihren Bereich.
        """
        app = self.app
        esc = app.escape_print_text
        boxes = self.logical_card_boxes()
        if nur is not None:
            boxes = {key: box for key, box in boxes.items() if key in nur}
        gueltig = self.valid_cards()
        zeilen = []
        # Bereiche liegen wie am Bildschirm unter allem anderen (PW-030).
        if nur is None and self.areas_visible():
            for area in self.area_list():
                farbe = app.theme.get(area["color"], app.theme["clear"])
                zeilen.append(
                    f'<div class="area" style="left:{(area["x"] - ursprung_x) * skala:.1f}mm;'
                    f'top:{(area["y"] - ursprung_y) * skala:.1f}mm;width:{area["w"] * skala:.1f}mm;'
                    f'height:{area["h"] * skala:.1f}mm;border-color:{farbe};'
                    f'background:{mix_hex_colors("#FFFFFF", farbe, 0.08)}"><b>{esc(area["name"])}</b></div>')
        # Spaltenköpfe des Spaltenboards (PW-010).
        if nur is None and self.board()["layout"] == "columns":
            faktor = self.zoom_factor()
            for spalte in getattr(self, "column_order", []):
                box = getattr(self, "column_boxes", {}).get(spalte["key"])
                if not box:
                    continue
                x, y, w = box[0] / faktor, box[1] / faktor, box[2] / faktor
                zeilen.append(f'<div class="colhead" style="left:{(x - ursprung_x) * skala:.1f}mm;'
                              f'top:{(y - ursprung_y) * skala:.1f}mm;width:{w * skala:.1f}mm">'
                              f'{esc(spalte["title"])}</div>')
        # Die Verbindungen zuerst: Sie liegen wie am Bildschirm unter den Karten.
        if self.connections():
            zeilen.append(f'<svg class="links" width="{breite * skala:.1f}mm"'
                          f' height="{hoehe * skala:.1f}mm"'
                          f' viewBox="0 0 {breite:.0f} {hoehe:.0f}">')
            # Die Pfeilspitzen gehören zur Aussage und
            # gehören deshalb auch aufs Papier. Zwei Marker reichen: einer je
            # Richtung, beide aus derselben Definition.
            zeilen.append('<defs>'
                          '<marker id="pfeil" viewBox="0 0 10 10" refX="9" refY="5"'
                          ' markerWidth="6" markerHeight="6" orient="auto-start-reverse">'
                          '<path d="M 0 0 L 10 5 L 0 10 z" fill="#888" /></marker>'
                          '</defs>')
            gestaltung = {tuple(sorted((entry["from"], entry["to"]))): entry for entry in self.connection_entries()}
            for erste, zweite, art in self.connections():
                links_box = boxes.get(erste)
                rechts_box = boxes.get(zweite)
                if not links_box or not rechts_box:
                    continue
                eintrag = gestaltung.get(tuple(sorted((erste, zweite))), {})
                strichfarbe = app.theme.get(eintrag.get("color", ""), "#888") if eintrag.get("color") else "#888"
                strichart = ' stroke-dasharray="6 4"' if eintrag.get("dash") else ""
                # Dieselbe Randgeometrie wie auf der Fläche –
                # gedruckt sähe eine Linie von Mittelpunkt zu Mittelpunkt
                # anders aus als die, die man auf dem Schirm gezogen hat.
                mitte_links = (links_box[0] + links_box[2] / 2.0, links_box[1] + links_box[3] / 2.0)
                mitte_rechts = (rechts_box[0] + rechts_box[2] / 2.0, rechts_box[1] + rechts_box[3] / 2.0)
                roh_x1, roh_y1 = self.border_point(links_box, *mitte_rechts, abstand=self.CONNECTION_GAP)
                roh_x2, roh_y2 = self.border_point(rechts_box, *mitte_links, abstand=self.CONNECTION_GAP)
                if math.hypot(roh_x2 - roh_x1, roh_y2 - roh_y1) < self.CONNECTION_MIN_LENGTH:
                    continue
                x1, y1 = roh_x1 - ursprung_x, roh_y1 - ursprung_y
                x2, y2 = roh_x2 - ursprung_x, roh_y2 - ursprung_y
                spitzen = ""
                if art in ("forward", "both"):
                    spitzen += ' marker-end="url(#pfeil)"'
                if art in ("backward", "both"):
                    spitzen += ' marker-start="url(#pfeil)"'
                zeilen.append(f'<line x1="{x1:.0f}" y1="{y1:.0f}" x2="{x2:.0f}" y2="{y2:.0f}"'
                              f' stroke="{strichfarbe}" stroke-width="2"{strichart}{spitzen} />')
                if eintrag.get("label"):
                    zeilen.append(f'<text x="{(x1 + x2) / 2:.0f}" y="{(y1 + y2) / 2 - 4:.0f}" font-size="11"'
                                  f' text-anchor="middle" fill="#222" stroke="#fff" stroke-width="3"'
                                  f' paint-order="stroke">{esc(eintrag["label"])}</text>')
            zeilen.append("</svg>")
        for identity, box in boxes.items():
            quelle_und_item = gueltig.get(identity)
            if not quelle_und_item:
                continue
            _quelle, item = quelle_und_item
            if item.get("page"):
                # Zweiter Ausbau: die Zeichnung selbst statt nur ihres Titels.
                bild = self.drawing_data_uri(_quelle)
                inhalt = (f'<img class="pixel" alt="" src="{bild}">' if bild else "<span>Zeichnung</span>")
                zeilen.append(
                    f'<div class="card" style="left:{(box[0] - ursprung_x) * skala:.1f}mm;'
                    f'top:{(box[1] - ursprung_y) * skala:.1f}mm;width:{box[2] * skala:.1f}mm;'
                    f'height:{box[3] * skala:.1f}mm"><b>{esc(item["text"])}</b>{inhalt}</div>')
                continue
            x = (box[0] - ursprung_x) * skala
            y = (box[1] - ursprung_y) * skala
            b = box[2] * skala
            h = box[3] * skala
            erledigt = " done" if item.get("done") else ""
            teile = []
            frist = app.format_due_full(item.get("due"), item.get("due_time"))
            if frist:
                teile.append("Fällig: " + frist)
            fortschritt = app.format_checklist_progress(item)
            if fortschritt:
                teile.append("Checkliste: " + fortschritt)
            namen = [str(label.get("name") or "") for label in app.item_labels(item)]
            if any(namen):
                teile.append(", ".join(name for name in namen if name))
            zeilen.append(
                f'<div class="card{erledigt}" style="left:{x:.1f}mm;top:{y:.1f}mm;'
                f'width:{b:.1f}mm;height:{h:.1f}mm">'
                f"<b>{esc(app.item_display_text(item))}</b>"
                + (f"<span>{esc(' · '.join(teile))}</span>" if teile else "")
                + "</div>")
        return zeilen

    def build_presentation_print_html(self):
        """Die Bereiche als Folien zum Drucken oder Sichern als PDF (MO-080, zweite Stufe).

        Jede Folie zeigt ihren Bereich mit Karten und Verbindungen, auf eine
        A4-Seite quer eingepasst. Die Schrift wächst mit, damit eine kleine
        Fläche auf der Folie nicht winzig beschriftet bleibt.
        """
        app = self.app
        bereiche = self.area_list()
        if self.board()["layout"] != "free" or not bereiche:
            raise ValueError("Die Präsentation zeigt die Bereiche der Pinnwand als Folien. "
                             "Zuerst in der Anordnung „Frei anordnen“ einen Bereich anlegen.")
        titel = app.get_display_title()
        skala = self.BOARD_PRINT_SCALE
        esc = app.escape_print_text
        seite_b, seite_h = self.PRESENTATION_PAGE_MM
        zeilen = [
            "<!DOCTYPE html>", '<html lang="de">', "<head>", '<meta charset="utf-8">',
            f"<title>{esc(titel)} · Präsentation · {APP_NAME}</title>", "<style>",
            "@page { size: A4 landscape; margin: 12mm; }",
            *self.BOARD_PRINT_CSS,
            "section.slide { break-after: page; page-break-after: always; }",
            "section.slide:last-of-type { break-after: auto; page-break-after: auto; }",
            "section.slide header { display: flex; justify-content: space-between;"
            " align-items: baseline; margin-bottom: 5mm; }",
            "section.slide h1 { font-size: 20pt; margin: 0; }",
            "section.slide p { font-size: 9pt; color: #555; margin: 0; }",
            "div.frame { position: relative; overflow: hidden; border-radius: 2mm;"
            " -webkit-print-color-adjust: exact; print-color-adjust: exact; }",
            "div.board { position: absolute; left: 0; top: 0; transform-origin: 0 0; }",
            "</style>", "</head>", "<body>",
        ]
        for nummer, area in enumerate(bereiche, 1):
            breite_mm, hoehe_mm = area["w"] * skala, area["h"] * skala
            faktor = min(seite_b / breite_mm, seite_h / hoehe_mm)
            farbe = app.theme.get(area["color"], app.theme["clear"])
            zeilen.extend([
                '<section class="slide"><header>',
                f"<h1>{esc(area['name'])}</h1>",
                f"<p>Folie {nummer} / {len(bereiche)} · {esc(titel)}</p>",
                "</header>",
                f'<div class="frame" style="width:{breite_mm * faktor:.1f}mm;height:{hoehe_mm * faktor:.1f}mm;'
                f'border:1pt solid {farbe};background:{mix_hex_colors("#FFFFFF", farbe, 0.06)}">',
                f'<div class="board" style="width:{breite_mm:.1f}mm;height:{hoehe_mm:.1f}mm;'
                f'transform:scale({faktor:.4f})">',
            ])
            zeilen.extend(self.board_region_lines(area["x"], area["y"], area["w"], area["h"], skala,
                                                  nur=set(self.cards_in_area(area))))
            zeilen.extend(["</div>", "</div>", "</section>"])
        zeilen.extend(["</body>", "</html>"])
        return "\n".join(zeilen)

    def print_presentation(self):
        """Folien der Bereiche als Druckseite öffnen – dort drucken oder als PDF sichern."""
        try:
            html_text = self.build_presentation_print_html()
        except ValueError as fehler:
            self.app.show_info("Präsentation als PDF", str(fehler))
            return "break"
        return self.app.open_print_html(html_text, "glide_praesentation", "Präsentation als PDF")

    def print_background_css(self, skala):
        """Der Flächenhintergrund auf Papier – nur, wenn er mitgedruckt werden soll."""
        board = self.board()
        art = board.get("background", "none")
        if not board.get("print_background") or art == "none" or board["layout"] == "columns":
            return ""
        abstand = 24 * skala
        farbe = "#C8C8C8"
        if art == "dots":
            bild = f"radial-gradient(circle, {farbe} 0.25mm, transparent 0.3mm)"
            groesse = f"{abstand:.2f}mm {abstand:.2f}mm"
        elif art == "lines":
            bild = f"linear-gradient(to bottom, {farbe} 0.15mm, transparent 0.15mm)"
            groesse = f"100% {abstand:.2f}mm"
        else:
            bild = (f"linear-gradient(to bottom, {farbe} 0.15mm, transparent 0.15mm), "
                    f"linear-gradient(to right, {farbe} 0.15mm, transparent 0.15mm)")
            groesse = f"{abstand:.2f}mm {abstand:.2f}mm"
        return (f"div.board {{ background-image: {bild}; background-size: {groesse};"
                " -webkit-print-color-adjust: exact; print-color-adjust: exact; }")

    def print_board(self):
        """Erzeugt die Druckseite der Pinnwand und öffnet sie."""
        app = self.app
        if self.mode != "board":
            return "break"
        try:
            html_text = self.build_board_print_html()
        except ValueError as fehler:
            app.show_warning("Pinnwand drucken", str(fehler))
            return "break"
        return app.open_print_html(html_text, "glide_pinnwand", "Pinnwand drucken")

    def area_selected_only(self):
        return bool(getattr(self, "selected_area", None)) and not self.selection() and self.areas_visible() \
            and self.area_by_id(self.selected_area) is not None

    def render_column_options(self):
        """Zusatzzeile des Spaltenboards: Gruppieren nach, leere Spalten, nur offene."""
        app = self.app
        board = self.board()
        zeile = tk.Frame(self.body, bg=app.theme["card"])
        zeile.pack(fill="x", pady=(0, 6))
        felder = [(key, name) for key, name in self.BOARD_GROUP_FIELDS
                  if key != "list" or not (self.context() or "").startswith("list:")]
        namen = {name: key for key, name in felder}
        aktuell = next((name for key, name in felder if key == self.effective_group_field()), felder[0][1])
        gruppe = tk.StringVar(value=f"Gruppieren: {aktuell}")
        rand, _feld = app._make_option_menu(zeile, gruppe, [f"Gruppieren: {name}" for _key, name in felder])
        rand.pack(side="left", padx=(0, 8))
        gruppe.trace_add("write", lambda *_: self.set_board_group_field(
            namen.get(gruppe.get().split(": ", 1)[-1], "due")))
        for text, key in (("Leere Spalten ausblenden", "hide_empty"), ("Nur offene", "only_open")):
            aktiv = bool(board.get(key))
            knopf = app._make_dialog_button(zeile, text, lambda k=key: self.configure_board(k, not self.board().get(k)),
                                            "muted",
                                            width=tkfont.Font(font=app_font(10, "bold")).measure(text) + 30, height=34)
            if aktiv:
                knopf.set_active(app.theme["active"], app.theme["active_text"])
            knopf.pack(side="left", padx=(0, 8))
        self.group_choice = gruppe
        hinweis = tk.Label(zeile, text="Ziehen setzt das Feld · Alt+Pfeil links/rechts verschiebt die Karte",
                           bg=app.theme["card"], fg=app.theme["muted"], font=app_font(9), anchor="w")
        hinweis.pack(side="left", fill="x", expand=True)

    def board_escape(self, event=None):
        """Eine Taste, vier Ebenen – von innen nach außen."""
        if self.presentation_active():
            return self.end_presentation()
        if getattr(self, "_lasso", None) is not None:
            self._lasso = None
            self.canvas.delete("layer:interaction")
            return "break"
        if getattr(self, "selected_area", None):
            self.selected_area = None
            self.draw_board()
            return "break"
        if self.cancel_connect_mode():
            return "break"
        if len(self.selection()) > 1:
            # Eine Mehrfachauswahl liegt „über" der Fläche;
            # sie wird zuerst aufgelöst, bevor die Taste weiterführt.
            self.select_card(self.selected_id)
            return "break"
        if self.board_focus_active():
            return self.exit_board_focus()
        if self.scope == self.GLOBAL_SCOPE:
            # Die globale Pinnwand hat keine Liste hinter sich; sie führt
            # zurück in die Listen- und Ordnerübersicht.
            self.app.set_library_view()
            return "break"
        return self.set_mode("list")

    def board_action_buttons(self, parent):
        """Die Aktionen der Pinnwand für die gemeinsame Zeile mit den Schaltern."""
        app = self.app
        knoepfe = []
        schrift = tkfont.Font(font=app_font(10, "bold"))
        for text, befehl, farbe in (("Anheften", self.choose_cards, "confirm"),
                                    ("Neue Aufgabe", lambda: self.create_card_item(24, 24), "confirm"),
                                    ("Bearbeiten", self.edit, "muted"),
                                    ("Verbinden", self.start_connect_mode, "muted"),
                                    ("Aktionen", self.show_board_actions_menu, "muted")):
            knoepfe.append(app._make_dialog_button(parent, text, befehl, farbe,
                                                   width=schrift.measure(text) + 26, height=34))
        return knoepfe

    def board_controls(self, parent):
        """Kompakte Pinnwandschalter für die Zeile „Liste · Pinnwand“."""
        app = self.app
        board = self.board()
        specs = (
            ("Raster", board["snap"], lambda: self.configure_board("snap", not self.board()["snap"]),
             "Karten beim Ablegen am 24-Pixel-Raster ausrichten"),
        )
        buttons = []
        # Anordnung als Auswahlfeld in der Zeile (U09, 3.33.21); die frühere
        # zweite Zeile mit fünf Auswahlfeldern entfällt.
        anordnungen = dict(self.BOARD_LAYOUTS)
        layout = tk.StringVar(value=anordnungen.get(board["layout"], "Frei anordnen"))
        self.layout_choice = layout
        layout_border, _feld = app._make_option_menu(parent, layout, [name for _key, name in self.BOARD_LAYOUTS])
        layout.trace_add("write", lambda *_: self.configure_board(
            "layout", next((key for key, name in self.BOARD_LAYOUTS if name == layout.get()), "free")))
        layout_border.text = "Anordnung"
        buttons.append(layout_border)
        for text, active, command, hint in specs:
            # Ein eingeschalteter Schalter trägt die neutrale Rolle „active“
            # (U15, 3.33.21). Bis 27.09.2026 war er grün, danach in der
            # Auswahlfarbe – in der Vorgabe dasselbe Lila wie „Hinzufügen“.
            button = app._make_dialog_button(parent, text, command, "muted", width=92, height=34)
            if active:
                button.set_active(app.theme["active"], app.theme["active_text"])
            app.add_tooltip(button, f"{hint} · zurzeit {'ein' if active else 'aus'}")
            buttons.append(button)
        finder = app._make_dialog_button(parent, "Finden", self.find_cards, "due_action", width=92, height=34)
        app.add_tooltip(finder, "Filter aufheben und alle Karten in den sichtbaren Bereich holen")
        buttons.append(finder)
        # Der Vollbildschalter steht bei den übrigen
        # Flächenschaltern und bleibt auch bei schmalem Fenster sichtbar –
        # dort ist er am nützlichsten.
        # Der Schalter hieß „Fläche" – ein Wort, das
        # in dieser Zeile auch die Arbeitsfläche selbst meinen konnte. Er
        # heißt jetzt „Vollbild" und trägt im eingeschalteten Zustand dieselbe
        # dauerhafte Füllung wie „Raster", „Vorschau" und „Auto"; vorher
        # wechselte nur die Randfarbe, und der aktive Zustand war auf einer
        # vollen Fläche nicht zu erkennen.
        aktiv = self.board_focus_active()
        vollbild = app._make_dialog_button(
            parent, "Vollbild beenden" if aktiv else "Vollbild",
            self.toggle_board_focus,
            "muted", width=132 if aktiv else 92, height=34)
        if aktiv:
            vollbild.set_active(app.theme["active"], app.theme["active_text"])
        app.add_tooltip(vollbild, "Pinnwand über das ganze Fenster · F11, Escape zurück")
        buttons.append(vollbild)
        mehr = app._make_dialog_button(parent, "…", lambda: self.show_board_settings_menu(mehr), "muted",
                                       width=56, height=34)
        filter_name = next((label.get("name") for label in app.labels if label.get("id") == self.filter_label), None)
        if filter_name:
            # Ein aktiver Labelfilter bleibt sichtbar, auch wenn er im Menü steht.
            mehr.set_active(app.theme["active"], app.theme["active_text"])
        app.add_tooltip(mehr, "Pinnwand: Anordnung, Labelfilter, Kartengröße, Verbindungsart, Zoom, Navigator, "
                              "Vorschau, Auto-Anheften" + (f" · gefiltert nach „{filter_name}“" if filter_name else ""))
        buttons.append(mehr)
        # Nicht alles passt in jede Reiterzeile. „Raster“, „Finden“, „Vollbild“
        # und „…“ bleiben immer stehen; „Anordnung“ weicht zuerst und ist dann
        # über „…“ erreichbar. „Vorschau“ und „Auto“ stellt man einmal ein –
        # sie stehen seit 3.33.21 (U09) nur noch im Menü „…“.
        return buttons

    def board_settings_menu(self, parent=None):
        """Seltene Pinnwandeinstellungen in einem Menü (U09 seit 3.33.21).

        Jede Wahl wirkt wie bisher über `configure_board` bzw.
        `set_label_filter`; ein Häkchen zeigt den aktuellen Wert.
        """
        app = self.app
        board = self.board()
        menu = app._new_themed_popup_menu(parent)

        def wahl(titel, optionen, aktuell, setzen):
            unter = app._new_themed_popup_menu(menu)
            for name, wert in optionen:
                unter.add_command(label=("✓ " if wert == aktuell else "    ") + name,
                                  command=lambda w=wert: setzen(w))
            menu.add_cascade(label=titel, menu=unter)

        wahl("Anordnung", [(name, key) for key, name in self.BOARD_LAYOUTS], board.get("layout", "free"),
             lambda wert: self.configure_board("layout", wert))
        def filtern(wert):
            self.set_label_filter(wert)
            self.render_tabs()  # „…“ zeigt einen aktiven Filter an
        wahl("Labelfilter", [("Alle Labels", "")] + [(label.get("name", ""), label.get("id")) for label in app.labels],
             self.filter_label or "", filtern)
        breite = board.get("width", 300)
        wahl("Kartengröße", [("Kleine Karten", 240), ("Mittlere Karten", 300), ("Große Karten", 420)],
             240 if breite < 280 else 420 if breite > 360 else 300, lambda wert: self.configure_board("width", wert))
        wahl("Verbindungsart", [(name, key) for key, name in self.CONNECTION_STYLES],
             board.get("connection_style", self.CONNECTION_STYLE_DEFAULT),
             lambda wert: self.configure_board("connection_style", wert))
        wahl("Zoom", [(f"{wert} %", wert) for wert in (50, 75, 100, 125, 150, 200)], board.get("zoom", 100),
             lambda wert: self.configure_board("zoom", wert))
        menu.add_separator()
        for titel, key in (("Navigator", "navigator"), ("Bildvorschau auf Karten", "preview"),
                           ("Neue Punkte automatisch anheften", "auto")):
            menu.add_command(label=("✓ " if board.get(key) else "    ") + titel,
                             command=lambda k=key: self.configure_board(k, not self.board().get(k)))
        return menu

    def show_board_settings_menu(self, widget=None):
        menu = self.board_settings_menu(self.app.root)
        if widget is not None and widget.winfo_exists():
            self.app._popup_at_widget(menu, widget)
        return menu

    def configure_board(self, key, value):
        scope = self.context()
        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board[key] = value
            if key == "connection_style":
                selected = set(self.selection())
                for connection in board.get("connections", []):
                    if connection.get("from") in selected and connection.get("to") in selected:
                        connection["style"] = value
        if self.save_view_change(change):
            # Eine Pinnwandeinstellung ist eine Sache der
            # Pinnwand. Der frühere Vollaufbau der gesamten Oberfläche ließ bei
            # jedem Umschalten Seitenleiste, Kopfzeile und Liste aufblitzen.
            self._signature = None
            self.refresh()

    # ------------------------------------------------------------------
    # Vollbild für die Pinnwand.
    #
    # Die Fläche teilt sich das Fenster mit Seitenleiste, Kopfzeile,
    # Eingabezeile, Filterzeile und zwei Aktionsreihen. Wer auf ihr arbeitet,
    # braucht keine davon – aber jede kostet Höhe, und die Höhe ist genau das,
    # was einer Pinnwand fehlt. Der Fokusmodus blendet sie aus und gibt der
    # Fläche das ganze Fenster.
    #
    # Was erhalten bleibt: die Scrollposition. Ein Modus, der beim Betreten
    # und Verlassen an den Anfang springt, ist unbrauchbar für eine Fläche,
    # auf der man gerade an einer bestimmten Stelle arbeitet.
    def board_focus_active(self):
        return bool(getattr(self, "_focus_mode", False))

    def toggle_board_focus(self, event=None):
        if self.board_focus_active():
            return self.exit_board_focus()
        return self.enter_board_focus()

    def enter_board_focus(self, event=None):
        if self.mode != "board" or not self.visible:
            return "break"
        app = self.app
        self._focus_mode = True
        self._focus_scroll = (self.canvas.xview()[0], self.canvas.yview()[0]) if getattr(
            self, "canvas", None) else (0.0, 0.0)
        self._focus_sidebar = app.settings.get("sidebar_visible", True)
        # `pack_info()` beschreibt Seite, Füllung und
        # Abstände – aber nicht die Stelle in der Packreihenfolge. Ein später
        # wieder gepacktes Widget landet deshalb am Ende seines Elternteils:
        # Kopfzeile und Eingabezeile standen nach dem Rückweg aus dem Vollbild
        # unter der Liste statt über ihr. Gemerkt wird deshalb zusätzlich der
        # erste nachfolgende Nachbar, der sichtbar bleibt; an ihm richtet sich
        # der Rückweg wieder aus.
        auszublenden = [widget for widget in (
            getattr(app, "header_frame", None), getattr(app, "input_frame", None),
            getattr(app, "search_frame", None))
            if widget is not None]
        versteckt = set(auszublenden)
        self._focus_hidden = []
        for widget in auszublenden:
            try:
                if widget.winfo_manager() != "pack":
                    continue
                geschwister = widget.master.pack_slaves()
                nachfolger = next(
                    (nachbar for nachbar in geschwister[geschwister.index(widget) + 1:]
                     if nachbar not in versteckt), None)
                self._focus_hidden.append((widget, widget.pack_info(), nachfolger))
                widget.pack_forget()
            except (tk.TclError, ValueError):
                continue
        if self._focus_sidebar:
            app.settings["sidebar_visible"] = False
            app._apply_sidebar_visibility()
        self.refresh()
        self.restore_board_scroll()
        return "break"

    def exit_board_focus(self, event=None):
        if not self.board_focus_active():
            return None
        app = self.app
        self._focus_mode = False
        merker = (self.canvas.xview()[0], self.canvas.yview()[0]) if getattr(
            self, "canvas", None) else (0.0, 0.0)
        # In der ursprünglichen Reihenfolge und jeweils vor den gemerkten
        # Nachbarn: Zwei Widgets mit demselben Nachfolger behalten dadurch
        # auch untereinander ihre Abfolge.
        for widget, info, nachfolger in self._focus_hidden:
            angaben = {key: value for key, value in info.items() if key != "in"}
            try:
                app.pack_relative(widget, nachfolger, **angaben)
            except tk.TclError:
                continue
        self._focus_hidden = []
        if getattr(self, "_focus_sidebar", True):
            app.settings["sidebar_visible"] = True
            app._apply_sidebar_visibility()
        self._focus_scroll = merker
        self.refresh()
        self.restore_board_scroll()
        return "break"

    def restore_board_scroll(self):
        """Stellt die Scrollposition nach einem Moduswechsel wieder her."""
        position = getattr(self, "_focus_scroll", None)
        if not position or not getattr(self, "canvas", None):
            return
        def anwenden():
            try:
                self.canvas.xview_moveto(position[0])
                self.canvas.yview_moveto(position[1])
            except tk.TclError:
                pass
        try:
            self.canvas.after_idle(anwenden)
        except tk.TclError:
            pass

    def set_label_filter(self, identity):
        self.filter_label = identity
        self.draw_board()


    # ------------------------------------------------------------------
    # Rückgängig für Flächenänderungen (3.30)
    #
    # Aufräumen und Bereiche verschieben verändern viele Kartenpositionen
    # auf einmal. Sie sind je ein Rückgängig-Schritt – über den Hinweis und
    # über Strg/Cmd+Z, solange danach keine Punktänderung kam.
    # ------------------------------------------------------------------
    def board_view_change(self, operation, label):
        scope = self.context()
        vorher = copy.deepcopy(self.app.settings["pinboards"].get(scope))
        if not self.save_view_change(operation):
            return False
        stapel = getattr(self, "_view_undo", None)
        if stapel is None:
            stapel = self._view_undo = []
        stapel.append({"scope": scope, "board": vorher, "depth": len(self.app.undo_stack), "label": label})
        del stapel[:-self.VIEW_UNDO_LIMIT]
        self._signature = None
        self.app.show_undo_toast(label, restore=self.undo_view_change)
        return True

    def view_undo_pending(self):
        stapel = getattr(self, "_view_undo", None) or []
        return bool(stapel) and stapel[-1]["depth"] == len(self.app.undo_stack) \
            and stapel[-1]["scope"] == self.context() and self.visible and self.mode == "board"

    def undo_view_change(self):
        stapel = getattr(self, "_view_undo", None) or []
        if not stapel:
            return False
        eintrag = stapel.pop()

        def change():
            if eintrag["board"] is None:
                self.app.settings["pinboards"].pop(eintrag["scope"], None)
            else:
                self.app.settings["pinboards"][eintrag["scope"]] = copy.deepcopy(eintrag["board"])
        if not self.save_view_change(change):
            return False
        self._signature = None
        self.refresh()
        return True

    # ------------------------------------------------------------------
    # Benannte Bereiche (3.30, PW-030)
    #
    # Ein Bereich ist ein Rechteck mit Name und Farbe unter den Karten. Er
    # besitzt keine Karten: Welche Karten mitwandern, entscheidet beim
    # Anfassen, wessen Mittelpunkt darin liegt.
    # ------------------------------------------------------------------
    AREA_GRIP = 16

    def area_list(self, scope=None):
        return list(self.board(scope).get("areas", []))

    def area_by_id(self, area_id):
        return next((area for area in self.area_list() if area["id"] == area_id), None)

    def areas_visible(self):
        return self.board()["layout"] == "free"

    def draw_areas(self):
        if not self.areas_visible():
            return
        app, canvas = self.app, self.canvas
        ausgewaehlt = getattr(self, "selected_area", None)
        for area in self.area_list():
            farbe = app.theme.get(area["color"], app.theme["clear"])
            x, y, w, h = area["x"], area["y"], area["w"], area["h"]
            tags = ("area", "area:" + area["id"])
            canvas.create_rectangle(x, y, x + w, y + h, fill=mix_hex_colors(app.theme["bg"], farbe, 0.08),
                                    outline=farbe, width=3 if area["id"] == ausgewaehlt else 2, tags=tags)
            canvas.create_rectangle(x, y, x + w, y + self.AREA_HEADER,
                                    fill=mix_hex_colors(app.theme["bg"], farbe, 0.22), outline="", tags=tags)
            canvas.create_text(x + 12, y + self.AREA_HEADER / 2, anchor="w", font=app_font(10, "bold"),
                               fill=app.theme["text"], tags=tags,
                               text=self.truncate_lines(area["name"], tkfont.Font(font=app_font(10, "bold")),
                                                        max(40, w - 24), 1))
            canvas.create_rectangle(x + w - self.AREA_GRIP, y + h - self.AREA_GRIP, x + w - 3, y + h - 3,
                                    fill=farbe, outline="", tags=tags)

    def area_at(self, x, y, part="any"):
        """Bereich unter dem Zeiger (Canvaskoordinaten): (Bereich, Teil) mit Teil header, grip oder body."""
        if not self.areas_visible():
            return None, None
        faktor = self.zoom_factor()
        for area in reversed(self.area_list()):
            left, top = area["x"] * faktor, area["y"] * faktor
            right, bottom = left + area["w"] * faktor, top + area["h"] * faktor
            if not (left <= x <= right and top <= y <= bottom):
                continue
            if right - self.AREA_GRIP * faktor <= x and bottom - self.AREA_GRIP * faktor <= y:
                return area, "grip"
            if y <= top + self.AREA_HEADER * faktor:
                return area, "header"
            return area, "body"
        return None, None

    def cards_in_area(self, area):
        """Karten, deren Mittelpunkt im Bereich liegt (logische Koordinaten)."""
        result = []
        for identity, (x, y, w, h) in self.logical_card_boxes().items():
            mitte_x, mitte_y = x + w / 2, y + h / 2
            if area["x"] <= mitte_x <= area["x"] + area["w"] and area["y"] <= mitte_y <= area["y"] + area["h"]:
                result.append(identity)
        return result

    def create_area(self, around_selection=True, point=None):
        app = self.app
        if not self.areas_visible():
            app.show_info("Bereich", "Bereiche gibt es in der Anordnung „Frei anordnen“.")
            return "break"
        if len(self.area_list()) >= self.MAX_AREAS:
            app.show_warning("Bereich", f"Je Pinnwand sind höchstens {self.MAX_AREAS} Bereiche möglich.")
            return "break"
        boxes = self.logical_card_boxes()
        auswahl = [boxes[identity] for identity in self.selection() if identity in boxes] if around_selection else []
        if auswahl:
            links = min(box[0] for box in auswahl) - 24
            oben = min(box[1] for box in auswahl) - 24 - self.AREA_HEADER
            rechts = max(box[0] + box[2] for box in auswahl) + 24
            unten = max(box[1] + box[3] for box in auswahl) + 24
        else:
            links, oben = point or getattr(self, "_context_point", None) or (24, 24)
            rechts, unten = links + 480, oben + 320
        name = app.themed_input_dialog("Neuer Bereich", "Name des Bereichs:",
                                       f"Bereich {len(self.area_list()) + 1}", ok_text="Anlegen")
        if name is None:
            return "break"
        neu = {"id": uuid.uuid4().hex, "name": " ".join(str(name).split())[:60] or "Bereich",
               "color": self.AREA_COLOR_KEYS[len(self.area_list()) % len(self.AREA_COLOR_KEYS)],
               "x": max(0, int(links)), "y": max(0, int(oben)),
               "w": max(120, int(rechts - links)), "h": max(80, int(unten - oben))}
        scope = self.context()

        def change():
            board = app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board.setdefault("areas", []).append(neu)
        if self.board_view_change(change, f"Bereich „{neu['name']}“ angelegt"):
            self.selected_area = neu["id"]
            self.draw_board()
        return "break"

    def update_area(self, area_id, label=None, **values):
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for area in board.get("areas", []):
                if area["id"] == area_id:
                    area.update(values)
        if label:
            ok = self.board_view_change(change, label)
        else:
            ok = self.save_view_change(change)
            self._signature = None
        if ok:
            self.draw_board()
        return ok

    def rename_area(self, area_id=None):
        app = self.app
        area = self.area_by_id(area_id or getattr(self, "selected_area", None))
        if area is None:
            return "break"
        name = app.themed_input_dialog("Bereich umbenennen", "Name des Bereichs:", area["name"],
                                       ok_text="Übernehmen")
        if name is not None and " ".join(str(name).split()):
            self.update_area(area["id"], name=" ".join(str(name).split())[:60])
        return "break"

    def set_area_color(self, area_id, color):
        if color in self.AREA_COLOR_KEYS:
            self.update_area(area_id, color=color)
        return "break"

    def delete_area(self, area_id=None):
        area = self.area_by_id(area_id or getattr(self, "selected_area", None))
        if area is None:
            return "break"
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board["areas"] = [value for value in board.get("areas", []) if value["id"] != area["id"]]
        # Die Karten bleiben liegen – ein Bereich besitzt sie nicht.
        if self.board_view_change(change, f"Bereich „{area['name']}“ entfernt"):
            self.selected_area = None
            self.draw_board()
        return "break"

    def jump_to_area(self, area_id):
        area = self.area_by_id(area_id)
        if area is None or not getattr(self, "canvas", None):
            return "break"
        self.selected_area = area_id
        self.select_card(None)
        self.draw_board()
        faktor = self.zoom_factor()
        region = tuple(map(float, self.canvas.tk.splitlist(self.canvas.cget("scrollregion")))) or (0, 0, 1, 1)
        breite, hoehe = max(1.0, region[2]), max(1.0, region[3])
        self.canvas.xview_moveto(max(0.0, (area["x"] * faktor - 24) / breite))
        self.canvas.yview_moveto(max(0.0, (area["y"] * faktor - 24) / hoehe))
        self.canvas.focus_set()
        return "break"

    def show_area_jump_menu(self, event=None):
        app = self.app
        menu = app._new_themed_popup_menu()
        bereiche = self.area_list()
        if not bereiche:
            menu.add_command(label="Noch keine Bereiche – „Neuer Bereich“ legt einen an.", state="disabled")
        for area in bereiche:
            menu.add_command(label=area["name"], command=lambda value=area["id"]: self.jump_to_area(value))
        self._popup(menu, event)
        return "break"

    def show_area_menu(self, event, area):
        app = self.app
        self.selected_area = area["id"]
        menu = app._new_themed_popup_menu()
        menu.add_command(label=f"BEREICH „{area['name'][:30]}“", state="disabled")
        menu.add_command(label="   Umbenennen …", command=lambda: self.rename_area(area["id"]))
        farben = app._new_themed_popup_menu(menu)
        for name, key in self.AREA_COLORS:
            marke = "✓ " if area["color"] == key else "    "
            farben.add_command(label=marke + name, command=lambda value=key: self.set_area_color(area["id"], value))
        menu.add_cascade(label="   Farbe", menu=farben)
        menu.add_command(label="   Bereich entfernen (Karten bleiben)", command=lambda: self.delete_area(area["id"]))
        self._popup(menu, event)
        return "break"

    def _popup(self, menu, event=None):
        app = self.app
        try:
            if event is not None and hasattr(event, "x_root"):
                menu.tk_popup(event.x_root, event.y_root)
            else:
                menu.tk_popup(app.root.winfo_pointerx(), app.root.winfo_pointery())
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    def area_press(self, event, area, part):
        """Kopf zieht den Bereich samt Karten, der Griff ändert die Größe."""
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        self.selected_area = area["id"]
        self.select_card(None)
        karten = self.cards_in_area(area) if part == "header" else []
        self._area_drag = {"id": area["id"], "part": part, "x": x, "y": y, "orig": dict(area),
                           "cards": karten, "dx": 0.0, "dy": 0.0, "moved": False}
        self.canvas.focus_set()
        self.draw_board()
        return "break"

    def area_motion(self, event):
        drag = self._area_drag
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        dx, dy = x - drag["x"], y - drag["y"]
        if not drag["moved"] and abs(dx) + abs(dy) < 4:
            return "break"
        drag["moved"] = True
        if drag["part"] == "grip":
            faktor = self.zoom_factor()
            area = drag["orig"]
            self.canvas.delete("layer:interaction")
            self.canvas.create_rectangle(area["x"] * faktor, area["y"] * faktor,
                                         (area["x"] + max(120, area["w"] + dx / faktor)) * faktor,
                                         (area["y"] + max(80, area["h"] + dy / faktor)) * faktor,
                                         outline=self.app.theme["ui_accent"], dash=(6, 4), width=2,
                                         tags=("layer:interaction",))
            drag["dx"], drag["dy"] = dx, dy
            return "break"
        schritt_x, schritt_y = dx - drag["dx"], dy - drag["dy"]
        self.canvas.move("area:" + drag["id"], schritt_x, schritt_y)
        for identity in drag["cards"]:
            self.canvas.move("card:" + identity, schritt_x, schritt_y)
            if identity in self.card_boxes:
                bx, by, bw, bh = self.card_boxes[identity]
                self.card_boxes[identity] = (bx + schritt_x, by + schritt_y, bw, bh)
        drag["dx"], drag["dy"] = dx, dy
        self.draw_connections(scaled=True)
        return "break"

    def area_release(self, event):
        drag = self._area_drag
        self._area_drag = None
        self.canvas.delete("layer:interaction")
        if not drag or not drag["moved"]:
            return "break"
        faktor = self.zoom_factor()
        dx, dy = drag["dx"] / faktor, drag["dy"] / faktor
        area = drag["orig"]
        schritt = 24 if self.board()["snap"] else 1
        scope = self.context()
        if drag["part"] == "grip":
            breite = max(120, round((area["w"] + dx) / schritt) * schritt)
            hoehe = max(80, round((area["h"] + dy) / schritt) * schritt)

            def change():
                board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
                for value in board.get("areas", []):
                    if value["id"] == area["id"]:
                        value["w"], value["h"] = int(breite), int(hoehe)
            self.board_view_change(change, f"Bereich „{area['name']}“ verändert")
            self.draw_board()
            return "break"
        ziel_x = max(0, min(20000, round((area["x"] + dx) / schritt) * schritt))
        ziel_y = max(0, min(20000, round((area["y"] + dy) / schritt) * schritt))
        versatz_x, versatz_y = ziel_x - area["x"], ziel_y - area["y"]
        karten = set(drag["cards"])

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for value in board.get("areas", []):
                if value["id"] == area["id"]:
                    value["x"], value["y"] = int(ziel_x), int(ziel_y)
            for card in board["cards"]:
                if card["item_id"] in karten:
                    card["x"] = max(0, min(20000, int(card["x"] + versatz_x)))
                    card["y"] = max(0, min(20000, int(card["y"] + versatz_y)))
        # Bereich und Karten wandern in einem Rückgängig-Schritt.
        self.board_view_change(change, f"Bereich „{area['name']}“ verschoben")
        self.draw_board()
        return "break"

    # ------------------------------------------------------------------
    # Auswahl aufräumen (3.30, PW-040)
    # ------------------------------------------------------------------
    def tidy_selection(self):
        app = self.app
        if self.board()["layout"] != "free":
            app.show_info("Aufräumen", "Aufräumen ordnet frei angeordnete Karten.")
            return "break"
        boxes = self.logical_card_boxes()
        karten = [(identity, boxes[identity]) for identity in self.selection() if identity in boxes]
        if len(karten) < 2:
            app.show_warning("Aufräumen", "Zuerst mindestens zwei Karten auswählen.")
            return "break"
        # Reihenfolge nach bisheriger Lage: Zeilen von oben, darin von links.
        karten.sort(key=lambda value: (value[1][1], value[1][0]))
        zeilen = []
        for identity, box in karten:
            if zeilen and abs(box[1] - zeilen[-1][0][1][1]) < min(box[3], zeilen[-1][0][1][3]) / 2:
                zeilen[-1].append((identity, box))
            else:
                zeilen.append([(identity, box)])
        geordnet = [eintrag for zeile in zeilen for eintrag in sorted(zeile, key=lambda value: value[1][0])]
        spalten = max(1, math.ceil(math.sqrt(len(geordnet))))
        links = min(box[0] for _identity, box in geordnet)
        oben = min(box[1] for _identity, box in geordnet)
        breite = max(box[2] for _identity, box in geordnet) + self.CARD_GAP
        schritt = 24 if self.board()["snap"] else 1
        if schritt > 1:
            # Der Fang bleibt beachtet: Zellen auf das Raster gerundet – nach
            # oben, damit sich keine Karten überlappen.
            links, oben = round(links / schritt) * schritt, round(oben / schritt) * schritt
            breite = math.ceil(breite / schritt) * schritt
        zeilenhoehen = []
        for start in range(0, len(geordnet), spalten):
            hoehe = max(box[3] for _identity, box in geordnet[start:start + spalten]) + self.CARD_GAP
            zeilenhoehen.append(math.ceil(hoehe / schritt) * schritt)
        positionen = {}
        y = oben
        for zeile_index, start in enumerate(range(0, len(geordnet), spalten)):
            for spalte, (identity, _box) in enumerate(geordnet[start:start + spalten]):
                positionen[identity] = (int(links + spalte * breite), int(y))
            y += zeilenhoehen[zeile_index]
        scope = self.context()

        def change():
            board = app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for card in board["cards"]:
                if card["item_id"] in positionen:
                    card["x"], card["y"] = (max(0, min(20000, value)) for value in positionen[card["item_id"]])
        if self.board_view_change(change, f"{len(positionen)} Karten aufgeräumt"):
            self.draw_board()
        return "break"

    # ------------------------------------------------------------------
    # Schnell weiterdenken (3.30, PW-050)
    # ------------------------------------------------------------------
    def quick_next_card(self, event=None):
        """Strg/Cmd+Enter: eine neue Karte rechts neben der ausgewählten, Titel direkt auf der Karte."""
        app = self.app
        quelle = self.selected_id
        if not quelle or self.board()["layout"] == "columns" or quelle not in self.card_boxes:
            return "break"
        scope = self.context()
        erlaubte = self.eligible_lists(scope)
        gefunden = app.find_item_in_lists(quelle) if not self.is_page_card(quelle) else None
        ziel = gefunden[3] if gefunden and any(entry is gefunden[3] for entry in erlaubte) else None
        if ziel is None and scope and scope.startswith("list:"):
            ziel = next((entry for entry in erlaubte if entry["id"] == scope.split(":", 1)[1]), None)
        if ziel is None:
            ziel = next((entry for entry in erlaubte if app.is_inbox_list(entry)), None) or (
                erlaubte[0] if erlaubte else None)
        if ziel is None or len(self.board()["cards"]) >= self.MAX_CARDS:
            return "break"
        self.cancel_quick_card()
        x, y, w, _h = self.card_boxes[quelle]
        faktor = self.zoom_factor()
        eingabe = tk.Entry(self.canvas, font=app_font(11, "bold"), bg=app.theme["input"], fg=app.theme["text"],
                           insertbackground=app.theme["text"], relief="flat", highlightthickness=2,
                           highlightbackground=app.theme["selection"], highlightcolor=app.theme["selection"])
        fenster = self.canvas.create_window(x + w + self.CARD_GAP * faktor, y, anchor="nw", window=eingabe,
                                            width=max(160, int(self.board()["width"] * faktor)),
                                            tags=("layer:quickcard",))
        self._quick_card = {"entry": eingabe, "window": fenster, "source": quelle, "list": ziel,
                            "x": (x + w) / faktor + self.CARD_GAP, "y": y / faktor}
        eingabe.bind("<Return>", lambda _event: self.confirm_quick_card())
        eingabe.bind("<KP_Enter>", lambda _event: self.confirm_quick_card())
        eingabe.bind("<Escape>", lambda _event: self.cancel_quick_card(refocus=True))
        eingabe.focus_set()
        return "break"

    def cancel_quick_card(self, refocus=False):
        entwurf = getattr(self, "_quick_card", None)
        self._quick_card = None
        if entwurf:
            try:
                self.canvas.delete(entwurf["window"])
                entwurf["entry"].destroy()
            except tk.TclError:
                pass
            if refocus:
                self.canvas.focus_set()
        return "break"

    def confirm_quick_card(self):
        """Enter legt den Punkt an – ein normaler Punkt seiner Liste, ein Rückgängig-Schritt."""
        app = self.app
        entwurf = getattr(self, "_quick_card", None)
        if not entwurf:
            return "break"
        text = " ".join(entwurf["entry"].get().split())
        self.cancel_quick_card()
        if not text:
            # Leer bestätigt ist wie Escape: kein leerer Punkt bleibt zurück.
            self.canvas.focus_set()
            return "break"
        neu = app.new_item(text)
        ziel = entwurf["list"]
        scope = self.context()
        with app.item_change((), restore=False, update_sidebar=True) as change:
            ziel.setdefault("items", []).append(neu)
            change.mark()
        if change.saved is False:
            return "break"
        schritt = 24 if self.board()["snap"] else 1
        x = max(0, min(20000, round(entwurf["x"] / schritt) * schritt))
        y = max(0, min(20000, round(entwurf["y"] / schritt) * schritt))

        def anheften():
            board = app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board.setdefault("cards", []).append({"list_id": ziel["id"], "item_id": neu["id"], "x": int(x),
                                                  "y": int(y), "scale": self.CARD_SCALE_DEFAULT})
        self.save_view_change(anheften)
        if self.board().get("auto_connect"):
            self.toggle_connection(entwurf["source"], neu["id"], umschalten=False)
        self.selected_id = neu["id"]
        self.selected_ids = [neu["id"]]
        self._signature = None
        self.refresh()
        self.focus_card(neu["id"])
        return "break"

    CONNECT_HANDLE = 7

    def draw_connect_handles(self):
        """Ein Ziehpunkt am rechten Rand jeder ausgewählten Karte (PW-050)."""
        canvas = self.canvas
        canvas.delete("connecthandle")
        self._connect_handles = []
        if self.board()["layout"] == "columns":
            return
        radius = self.CONNECT_HANDLE * self.zoom_factor()
        for identity in self.selection():
            box = self.card_boxes.get(identity)
            if not box:
                continue
            mitte_x, mitte_y = box[0] + box[2], box[1] + box[3] / 2
            canvas.create_oval(mitte_x - radius, mitte_y - radius, mitte_x + radius, mitte_y + radius,
                               fill=self.app.theme["ui_accent"], outline=self.app.theme["card"], width=2,
                               tags=("connecthandle",))
            self._connect_handles.append(((mitte_x - radius - 2, mitte_y - radius - 2, radius * 2 + 4,
                                           radius * 2 + 4), identity))

    def connect_handle_at(self, x, y):
        for box, identity in getattr(self, "_connect_handles", []):
            if box[0] <= x <= box[0] + box[2] and box[1] <= y <= box[1] + box[3]:
                return identity
        return None

    def connect_drag_motion(self, event):
        drag = self._connect_drag
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        self.canvas.delete("layer:interaction")
        self.canvas.create_line(drag["x"], drag["y"], x, y, fill=self.app.theme["ui_accent"], width=2,
                                dash=(6, 4), arrow="last", tags=("layer:interaction",))
        ziel = self.card_at(x, y)
        if ziel and ziel != drag["from"]:
            bx, by, bw, bh = self.card_boxes[ziel]
            self.canvas.create_rectangle(bx - 3, by - 3, bx + bw + 3, by + bh + 3, outline=self.app.theme["ui_accent"],
                                         width=2, dash=(4, 3), tags=("layer:interaction",))
        return "break"

    def connect_drag_release(self, event):
        drag = self._connect_drag
        self._connect_drag = None
        self.canvas.delete("layer:interaction")
        ziel = self.card_at(self.canvas.canvasx(event.x), self.canvas.canvasy(event.y))
        if ziel and ziel != drag["from"]:
            if not self.toggle_connection(drag["from"], ziel, umschalten=False):
                self.app.show_info("Verbinden", "Diese Verbindung besteht bereits.")
        return "break"

    # ------------------------------------------------------------------
    # Verbindungen beschriften und gestalten (3.30, PW-060)
    # ------------------------------------------------------------------
    def connection_entries(self, scope=None):
        return [dict(entry) for entry in self.board(scope).get("connections", [])]

    def connection_at(self, x, y):
        """Die Verbindung unter dem Zeiger (Canvaskoordinaten) als (von, nach)."""
        items = getattr(self, "_connection_items", {})
        for element in reversed(self.canvas.find_overlapping(x - 5, y - 5, x + 5, y + 5)):
            if element in items:
                return items[element]
        return None

    def update_connection(self, pair, **values):
        scope = self.context()
        paar = tuple(sorted(pair))

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for entry in board.get("connections", []):
                if tuple(sorted((entry["from"], entry["to"]))) != paar:
                    continue
                for key, value in values.items():
                    if value in (None, "", False) or (key == "color" and value == "muted"):
                        entry.pop(key, None)
                    else:
                        entry[key] = value
        if self.save_view_change(change):
            self._signature = None
            self.draw_board()
        return "break"

    def label_connection(self, pair):
        app = self.app
        entry = next((value for value in self.connection_entries()
                      if tuple(sorted((value["from"], value["to"]))) == tuple(sorted(pair))), None)
        if entry is None:
            return "break"
        text = app.themed_input_dialog("Verbindung beschriften",
                                       f"Beschriftung (bis {self.CONNECTION_LABEL_MAX} Zeichen, leer entfernt sie):",
                                       entry.get("label", ""), ok_text="Übernehmen")
        if text is None:
            return "break"
        return self.update_connection(pair, label=" ".join(str(text).split())[:self.CONNECTION_LABEL_MAX])

    def show_connection_menu(self, event, pair):
        app = self.app
        entry = next((value for value in self.connection_entries()
                      if tuple(sorted((value["from"], value["to"]))) == tuple(sorted(pair))), None)
        if entry is None:
            return "break"
        menu = app._new_themed_popup_menu()
        menu.add_command(label="VERBINDUNG", state="disabled")
        menu.add_command(label="   Beschriften …", command=lambda: self.label_connection(pair))
        menu.add_command(label="   " + ("Durchgezogen" if entry.get("dash") else "Gestrichelt"),
                         command=lambda: self.update_connection(pair, dash=not entry.get("dash")))
        farben = app._new_themed_popup_menu(menu)
        for name, key in self.CONNECTION_COLORS:
            marke = "✓ " if entry.get("color", "muted") == key else "    "
            farben.add_command(label=marke + name, command=lambda value=key: self.update_connection(pair, color=value))
        menu.add_cascade(label="   Farbe", menu=farben)
        richtungen = app._new_themed_popup_menu(menu)
        for key, name in self.CONNECTION_STYLES:
            marke = "✓ " if entry.get("style") == key else "    "
            richtungen.add_command(label=marke + name, command=lambda value=key: self.update_connection(pair, style=value))
        menu.add_cascade(label="   Richtung", menu=richtungen)
        menu.add_separator()
        menu.add_command(label="   Verbindung entfernen", command=lambda: self.toggle_connection(*pair))
        self._popup(menu, event)
        return "break"

    # ------------------------------------------------------------------
    # Flächenhintergrund (3.30, PW-070)
    # ------------------------------------------------------------------
    BACKGROUND_MAX_MARKS = 2500

    def draw_background(self):
        """Punkte, Linien oder Karo im sichtbaren Ausschnitt – der Abstand ist das Fangraster."""
        canvas = getattr(self, "canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("background")
        self._background_job = None
        art = self.board().get("background", "none")
        if art == "none" or self.board()["layout"] == "columns":
            return
        abstand = 24 * self.zoom_factor()
        links, oben = canvas.canvasx(0), canvas.canvasy(0)
        breite, hoehe = max(1, canvas.winfo_width()), max(1, canvas.winfo_height())
        # Gezählt wird, was tatsächlich entsteht – samt Randreihen links, rechts,
        # oben und unten. Vorher zählte nur die Fläche; bei einer schmalen,
        # hohen Pinnwand lagen dann einige hundert Punkte über der Grenze.
        def reihen(a):
            return (math.floor((breite + a) / a) + 2) * (math.floor((hoehe + a) / a) + 2)
        while art == "dots" and reihen(abstand) > self.BACKGROUND_MAX_MARKS:
            abstand *= 2
        farbe = mix_hex_colors(self.app.theme["bg"], self.app.theme["muted"], 0.35)
        start_x = math.floor(links / abstand) * abstand
        start_y = math.floor(oben / abstand) * abstand
        rechts, unten = links + breite + abstand, oben + hoehe + abstand
        if art == "dots":
            y = start_y
            while y <= unten:
                x = start_x
                while x <= rechts:
                    canvas.create_rectangle(x - 1, y - 1, x + 1, y + 1, fill=farbe, outline="", tags=("background",))
                    x += abstand
                y += abstand
        else:
            y = start_y
            while y <= unten:
                canvas.create_line(start_x, y, rechts, y, fill=farbe, tags=("background",))
                y += abstand
            if art == "grid":
                x = start_x
                while x <= rechts:
                    canvas.create_line(x, start_y, x, unten, fill=farbe, tags=("background",))
                    x += abstand
        canvas.tag_lower("background")

    def schedule_background(self):
        canvas = getattr(self, "canvas", None)
        if canvas is None or not canvas.winfo_exists() or self.board().get("background", "none") == "none":
            return
        if getattr(self, "_background_job", None) is None:
            self._background_job = canvas.after_idle(self.draw_background)

    # ------------------------------------------------------------------
    # Menüs für Karteninhalt, Kartenfarbe und Hintergrund
    # ------------------------------------------------------------------
    def show_card_content_menu(self, event=None):
        app = self.app
        board = self.board()
        menu = app._new_themed_popup_menu()
        menu.add_command(label="AUF KARTEN ZEIGEN", state="disabled")
