                ProgressBar(tile, value=belegt, maximum=kapazitaet, bg_color=theme["card"],
                            track_color=theme["input"], fill_color=theme["flag"]).pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[4]))
