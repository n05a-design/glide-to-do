        def kachel_templates(parent):
            templates = card(parent, "Mit einer Vorlage starten")
            label(templates, "Jede Vorlage legt eine neue, frei bearbeitbare Liste an.", color="muted")
            for key in self.home_template_keys():
                record = self.template_by_id(key)
                if record is not None:
                    titel, beschreibung = record.get("title", "Vorlage"), record.get("note", "")
                else:
                    titel, beschreibung, _tasks = self.LIST_TEMPLATES[key]
                action(templates, f"{titel} – {beschreibung}",
                       lambda value=key: self.create_list_from_template(value), "confirm")

        def kachel_impulse(parent):
            tile = card(parent, "Impuls für den Tag")
            label(tile, self.home_impulse(), 11, color="text", pady=(glide_design.SPACING[0], glide_design.SPACING[0]))

        def kachel_calendar(parent):
            """Die Kalendervorschau in drei Darstellungen.

            Alle drei lesen dieselben Felder – Fälligkeit und Bearbeitungstag
            offener Punkte. Sie unterscheiden sich in der Reichweite, nicht im
            Bestand: Monat, laufende Woche oder die nächsten Termine.
            """
            modus = self.home_calendar_mode()
            titel = self.MONTH_NAMES[date.today().month - 1] if modus == "month" else dict(self.HOME_CALENDAR_CHOICES).get(modus, "Kalendervorschau")
            tile = card(parent, f"{self.ICONS['calendar']}  Kalender \u00b7 {titel}")
            zaehler = self.home_calendar_days()
            heute = date.today()
            if modus == "next":
                termine = self.home_next_events(self.home_row_limit() + 1)
                if not termine:
                    label(tile, "Kein offener Punkt trägt einen Termin in der Zukunft.", color="muted")
                for tag, uhrzeit, quelle, item in termine:
                    beschriftung = self.format_due_full(tag, uhrzeit or None)
                    action(tile, f"{beschriftung}  \u00b7  {self.item_display_text(item).splitlines()[0]}",
                           lambda lid=quelle["id"], iid=item["id"]: self.open_task_in_source_list(lid, iid),
                           list_color(quelle))
            elif modus == "week":
                erster = heute - timedelta(days=(heute.weekday() if self.settings.get("week_start") != "sunday"
                                                 else (heute.weekday() + 1) % 7))
                for schritt in range(7):
                    tag = erster + timedelta(days=schritt)
                    anzahl = zaehler.get(tag.isoformat(), 0)
                    zeile = tk.Frame(tile, bg=theme["card"])
                    zeile.pack(fill="x", pady=glide_design.SPACING[2])
                    self._bind_home_wheel(zeile)
                    ist_heute = tag == heute
                    tk.Label(zeile, text=f"{self.WEEKDAY_NAMES[tag.weekday()]} {tag.strftime('%d.%m.')}",
                             bg=theme["card"], fg=theme["text"] if ist_heute else theme["muted"],
                             font=app_font(9, "bold") if ist_heute else app_font(9),
                             anchor="w").pack(side="left")
                    tk.Label(zeile, text=str(anzahl) if anzahl else "–", bg=theme["card"],
                             fg=theme["ui_accent"] if anzahl else theme["muted"],
                             font=app_font(9, "bold"), anchor="e").pack(side="right")
            else:
                raster = tk.Frame(tile, bg=theme["card"])
                raster.pack(fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[6]))
                self._bind_home_wheel(raster)
                sonntag_zuerst = self.settings.get("week_start") == "sunday"
                namen = ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"] if sonntag_zuerst else [
                    "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
                for spalte, name in enumerate(namen):
                    raster.columnconfigure(spalte, weight=1, uniform="homecal")
                    kopf = tk.Label(raster, text=name, bg=theme["card"], fg=theme["muted"],
                                    font=app_font(8, "bold"))
                    kopf.grid(row=0, column=spalte, sticky="ew", pady=(glide_design.SPACING[0], glide_design.SPACING[2]))
                    self._bind_home_wheel(kopf)
                erster_im_monat = heute.replace(day=1)
                versatz = (erster_im_monat.weekday() + 1) % 7 if sonntag_zuerst else erster_im_monat.weekday()
                tage_im_monat = calendar.monthrange(heute.year, heute.month)[1]
                for position in range(versatz + tage_im_monat):
                    zeile_nr, spalte = divmod(position, 7)
                    if position < versatz:
                        continue
                    tag = erster_im_monat + timedelta(days=position - versatz)
                    anzahl = zaehler.get(tag.isoformat(), 0)
                    ist_heute = tag == heute
                    if ist_heute:
                        grund, schrift = theme["ui_accent"], theme["selection_text"]
                    elif anzahl:
                        grund, schrift = theme["input"], theme["text"]
                    else:
                        grund, schrift = theme["card"], theme["muted"]
                    zelle = tk.Label(raster, text=f"{tag.day}" + (f"\u00b7{anzahl}" if anzahl and not ist_heute else ""),
                                     bg=grund, fg=schrift,
                                     font=app_font(8, "bold") if (ist_heute or anzahl) else app_font(8))
                    zelle.grid(row=zeile_nr + 1, column=spalte, sticky="ew", padx=glide_design.SPACING[1], pady=glide_design.SPACING[1], ipady=glide_design.SPACING[2])
                    self._bind_home_wheel(zelle)
                    if anzahl:
                        self.add_tooltip(zelle, f"{tag.strftime('%d.%m.%Y')}: {anzahl} offene(r) Punkt(e)")
                label(tile, f"{sum(zaehler.get((heute.replace(day=1) + timedelta(days=schritt)).isoformat(), 0) for schritt in range(tage_im_monat))} "
                            "offene Punkte mit Termin in diesem Monat", color="muted")
            action(tile, f"{self.ICONS['calendar']}  Kalender öffnen", self.open_calendar_view, "import")

