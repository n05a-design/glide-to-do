    def build_sidebar_section(self, key, titel, oeffnen, titel_hinweis, plus_befehl, plus_hinweis, abstand):
        """Überschrift mit Klapppfeil, Titel und „+“, darunter ein eigener Baum.

        Der Pfeil klappt den Baum ein, der Titel öffnet die Übersicht, „+“
        legt an – wie beim Listenbereich. Ergebnis: Zeile, Kopf, Pfeil, Titel,
        „+“ und Baum.
        """
        theme = self.theme
        zeile = self.register_theme_widget(tk.Frame(self.sidebar_frame, bg=theme["card"]), "card")
        zeile.pack(fill="x", pady=(abstand, 8))
        kopf = tk.Frame(zeile, bg=theme["card"], cursor="hand2")
        kopf.pack(side="left", fill="both", expand=True, padx=(0, 6))
        platz = tk.Frame(kopf, width=28, bg=theme["card"])
        platz.pack(side="left", fill="y")
        platz.pack_propagate(False)
        pfeil = tk.Label(platz, text=self.SIDEBAR_SECTION_ARROWS[True], font=app_font(9),
                         bg=theme["card"], fg=theme["text"], cursor="hand2", takefocus=True)
        pfeil.pack(fill="both", expand=True, pady=(4, 0))
        beschriftung = tk.Label(kopf, text=titel, font=self.sidebar_section_font(), bg=theme["card"],
                                fg=theme["text"], anchor="w", cursor="hand2", takefocus=True)
        beschriftung.pack(side="left", fill="x", expand=True, padx=(5, 0),
                          pady=(self.SIDEBAR_TITLE_BASELINE_SHIFT, 0))
        for widget in (kopf, platz, pfeil, beschriftung):
            if widget in (platz, pfeil):
                widget.bind("<Button-1>", lambda _event: self.toggle_sidebar_section(key) or "break")
            else:
                widget.bind("<Button-1>", lambda _event: oeffnen())
            widget.bind("<Enter>", lambda _event: self.update_section_heading(key, hover=True))
            widget.bind("<Leave>", lambda _event: self.update_section_heading(key, hover=False))
        self.add_tooltip(pfeil, f"{titel} ein- oder ausklappen")
        for sequence in ("<Return>", "<space>"):
            pfeil.bind(sequence, lambda _event: self.toggle_sidebar_section(key))
        pfeil.bind("<FocusIn>", lambda _event: self.update_section_heading(key, hover=True))
        pfeil.bind("<FocusOut>", lambda _event: self.update_section_heading(key, hover=False))
        for sequence in ("<Return>", "<space>"):
            beschriftung.bind(sequence, lambda _event: oeffnen())
        self.add_tooltip(beschriftung, titel_hinweis)
        plus = self.make_button(zeile, text="+", command=plus_befehl, color_key="accent", width=42, height=32,
                                radius=14, bg_key="card", font=app_font(13, "bold"))
        plus.pack(side="right")
        self.add_tooltip(plus, plus_hinweis)
        baum = ttk.Treeview(
            self.sidebar_frame, columns=("icon", "count"), displaycolumns=("count",), show="tree",
            selectmode="browse", style="Sidebar.Treeview", takefocus=True, height=1)
        baum.heading("#0", text="")
        baum.column("icon", anchor="center", stretch=False, width=28, minwidth=28)
        baum.column("#0", anchor="w", stretch=True, width=192)
        baum.column("count", anchor="e", stretch=False, width=self.SIDEBAR_COUNT_MIN_WIDTH, minwidth=0)
        baum.pack(fill="x")
        baum.bind("<<TreeviewSelect>>", lambda _event, ziel=baum: self.on_section_select(ziel))
        baum.bind("<Double-Button-1>", self.edit_selected_sidebar_title)
        baum.bind("<Button-3>", self.show_sidebar_context_menu)
        if IS_MACOS:
            baum.bind("<Button-2>", self.show_sidebar_context_menu)
            baum.bind("<BackSpace>", self.delete_selected_sidebar_entry)
        self.bind_context_menu_modifier(baum, self.show_sidebar_context_menu)
        baum.bind("<Delete>", self.delete_selected_sidebar_entry)
        # H-02r (3.34.0): dieselben Tastenwege wie im Listenbaum, mit sichtbarer Wirkung.
        baum.bind("<Alt-Up>", lambda _event: self.keyboard_sidebar_move(self.move_sidebar_selection, -1))
        baum.bind("<Alt-Down>", lambda _event: self.keyboard_sidebar_move(self.move_sidebar_selection, 1))
        baum.bind("<Alt-Right>", lambda _event: self.keyboard_sidebar_move(self.toggle_sidebar_indent))
        baum.bind("<Alt-Left>", lambda _event: self.keyboard_sidebar_move(self.outdent_selected_sidebar_list))
        self.bind_sidebar_drag(baum)
        baum.bind("<Configure>", self.refresh_sidebar_row_texts, add="+")
        baum.bind("<<TreeviewOpen>>", lambda _event: self.root.after_idle(self.sync_pages_sidebar_height), add="+")
        baum.bind("<<TreeviewClose>>", lambda _event: self.root.after_idle(self.sync_pages_sidebar_height), add="+")
        self.bind_hover_highlight(baum)
        self.bind_mousewheel(baum)
        self.build_sidebar_quick_actions(baum)
        return zeile, kopf, pfeil, beschriftung, plus, baum

    def is_pages_sidebar_entry(self, entry):
        """Steht diese Liste im Seitenbereich statt im Listenbaum?"""
        return bool(isinstance(entry, dict) and not entry.get("folder_id") and self.is_page_list(entry))

    def is_pages_sidebar_folder(self, folder):
        """Bibliotheken der obersten Ebene stehen mit ihrem Inhalt im Seitenbereich."""
        return bool(isinstance(folder, dict) and not folder.get("parent_id")
                    and folder.get("folder_kind") == "library")

    def is_notes_sidebar_entry(self, entry):
        """Steht diese Liste im Notizbereich? Notizen ohne Ordner (29.09.2026)."""
        return bool(isinstance(entry, dict) and not entry.get("folder_id")
                    and entry.get("list_kind") == self.LIST_KIND_NOTE and not self.is_inbox_list(entry))

    def is_notes_sidebar_folder(self, folder):
        """Notizbücher der obersten Ebene stehen mit ihrem Inhalt im Notizbereich."""
        return bool(isinstance(folder, dict) and not folder.get("parent_id")
                    and folder.get("folder_kind") == "journal")

    def sidebar_tree_for_entry(self, entry):
        key = self.sidebar_section_for("list", entry.get("id"))
        return getattr(self, {"pages": "pages_listbox", "notes": "notes_listbox", "drawings": "drawings_listbox"}.get(
            key, "sidebar_listbox"), getattr(self, "sidebar_listbox", None))

    def sidebar_tree_for_folder(self, folder):
        key = self.sidebar_section_for("folder", folder.get("id"))
        return getattr(self, {"pages": "pages_listbox", "notes": "notes_listbox", "drawings": "drawings_listbox"}.get(
            key, "sidebar_listbox"), getattr(self, "sidebar_listbox", None))

    SIDEBAR_LISTS_MIN_ROWS = 5

    def sidebar_section_trees(self):
        """Bereiche mit eigener Überschrift und begrenzter Höhe: Seiten und Notizen."""
        return [(schluessel, baum, zeile) for schluessel, baum, zeile in (
            ("pages", getattr(self, "pages_listbox", None), getattr(self, "pages_title_row", None)),
            ("notes", getattr(self, "notes_listbox", None), getattr(self, "notes_title_row", None)),
            ("drawings", getattr(self, "drawings_listbox", None), getattr(self, "drawings_title_row", None)))
            if baum is not None and zeile is not None]

    @staticmethod
    def visible_tree_rows(baum):
        """Zahl der sichtbaren Zeilen: Kinder zählen nur unter offenen Ordnern."""
        sichtbar, offen = 0, list(baum.get_children(""))
        while offen:
            iid = offen.pop()
            sichtbar += 1
            if baum.item(iid, "open"):
                offen.extend(baum.get_children(iid))
        return sichtbar

    def sidebar_tree_row_budget(self):
        """Wie viele Baumzeilen neben Überschriften und Systemzeilen Platz haben – oder None."""
        rahmen = getattr(self, "sidebar_frame", None)
        if rahmen is None:
            return None
        try:
            hoehe = rahmen.winfo_height()
            if hoehe <= 1:
                return None
            baeume = self.sidebar_trees()
            belegt = 0
            for widget in rahmen.pack_slaves():
                abstand = widget.pack_info().get("pady", 0)
                teile = abstand if isinstance(abstand, (list, tuple)) else str(abstand).split()
                abstand = sum(int(str(teil)) for teil in teile)
                belegt += abstand if widget in baeume else widget.winfo_reqheight() + abstand
            zeile = int(self.style.lookup("Sidebar.Treeview", "rowheight") or 24)
        except (tk.TclError, ValueError, TypeError):
            return None
        # Jeder Baum braucht zusätzlich ein paar Pixel Rand.
        return max(0, (hoehe - belegt - 4 * len(baeume)) // max(1, zeile))

    def sync_pages_sidebar_height(self):
        """Seiten- und Notizbaum sind so hoch wie ihre sichtbaren Zeilen, höchstens acht.

        Reicht die Höhe der Seitenleiste nicht, geben beide Zeilen ab – zuerst
        der längere –, damit der Listenbaum seine Mindesthöhe behält. Ohne
        Einträge bleibt nur die Überschrift mit „+“: Eine leere Baumzeile wäre
        eine Form ohne Inhalt.
        """
        # Bei Mindesthöhe kosten die vier Überschriften sonst unter Windows
        # mehr Platz als die Listen selbst. Kompakte Abstände geben die Fläche
        # den Baumzeilen zurück; größere Fenster erhalten die normalen Werte.
        minimal = self.height_density() == "minimal"
        for key, row in (("pages", getattr(self, "pages_title_row", None)),
                         ("lists", getattr(self, "sidebar_title_row", None)),
                         ("notes", getattr(self, "notes_title_row", None)),
                         ("drawings", getattr(self, "drawings_title_row", None))):
            if row is not None and row.winfo_manager():
                gap = self.SIDEBAR_SECTION_GAP if key == "pages" else self.SIDEBAR_LISTS_GAP
                padding = (4, 4) if minimal else (gap, 8)
                current = row.pack_info().get("pady", 0)
                current = tuple(int(value) for value in (current if isinstance(current, (tuple, list)) else str(current).split()))
                if current != padding:
                    row.pack_configure(pady=padding)
        bereiche = self.sidebar_section_trees()
        if not bereiche:
            return
        bedarf = {schluessel: (self.visible_tree_rows(baum) if self.sidebar_section_open(schluessel) and self.sidebar_section_visible(schluessel) else 0)
                  for schluessel, baum, _zeile in bereiche}
        zeilen = {schluessel: min(self.PAGES_SIDEBAR_MAX_ROWS, anzahl) for schluessel, anzahl in bedarf.items()}
        budget = self.sidebar_tree_row_budget()
        listen = getattr(self, "sidebar_listbox", None)
        if budget is not None:
            reserve = 0
            try:
                if listen is not None and listen.winfo_manager():
                    reserve = min(self.SIDEBAR_LISTS_MIN_ROWS,
                                  max(1, budget - sum(1 for count in bedarf.values() if count)))
                    if int(listen.cget("height")) != reserve:
                        listen.configure(height=reserve)
            except (tk.TclError, ValueError):
                reserve = self.SIDEBAR_LISTS_MIN_ROWS
            while sum(zeilen.values()) > max(0, budget - reserve):
                laengster = max(zeilen, key=zeilen.get)
                if zeilen[laengster] <= 1:
                    break
                zeilen[laengster] -= 1
        for schluessel, baum, zeile in bereiche:
            try:
                if int(baum.cget("height")) != max(1, zeilen[schluessel]):
                    baum.configure(height=max(1, zeilen[schluessel]))
                if not bedarf[schluessel] and baum.winfo_manager():
                    # Das „…“ beim Überfahren liegt über dem Baum; es blieb nach
                    # dem Einklappen samt Zeilenbild stehen (Rückmeldung 30.09.2026).
                    if getattr(self, "sidebar_quick_tree", None) is baum:
                        self.hide_sidebar_quick_actions()
                    self.set_hover_rows(baum, ())
                    baum.pack_forget()
                    self.repaint_sidebar()
                elif bedarf[schluessel] and not baum.winfo_manager():
                    baum.pack(fill="x", after=zeile)
            except (tk.TclError, ValueError):
                pass

    def repaint_sidebar(self):
        """Malt die Seitenleiste nach dem Auspacken eines Baums neu (R1, 29.09.2026).

        macOS malte die frei gewordene Fläche nicht nach: Unter „Notizen ▷“
        stand weiter die letzte Zeile des eingeklappten Baums. Ein erneutes
        Setzen des Hintergrunds lässt Tk den Rahmen vollständig neu zeichnen.
        """
        rahmen = getattr(self, "sidebar_frame", None)
        if rahmen is None:
            return
        try:
            rahmen.configure(bg=self.theme["card"])
            rahmen.after_idle(lambda: rahmen.winfo_exists() and rahmen.configure(bg=self.theme["card"]))
        except tk.TclError:
            pass

    def schedule_sidebar_heights(self, _event=None):
        """Gleicht die Baumhöhen im nächsten Leerlauf ab – einmal, egal wie oft gerufen."""
        if getattr(self, "_sidebar_heights_pending", False):
            return
        self._sidebar_heights_pending = True

        def ausfuehren():
            self._after_ids.discard(getattr(self, "_sidebar_heights_after", None))
            self._sidebar_heights_after = None
            self._sidebar_heights_pending = False
            self.sync_pages_sidebar_height()
        try:
            self._sidebar_heights_after = self._register_after(self.root.after_idle(ausfuehren))
        except tk.TclError:
            self._sidebar_heights_after = None
            self._sidebar_heights_pending = False

    def update_section_heading(self, key, hover=False):
        if key == "drawings":
            return self.update_drawings_heading(hover=hover)
        if key == "notes":
            return self.update_notes_heading(hover=hover)
        return self.update_pages_heading(hover=hover)

    def update_pages_heading(self, hover=False):
        self._paint_section_heading("pages", self.view_mode == self.PAGES_VIEW, hover)

    def update_drawings_heading(self, hover=False):
        self._paint_section_heading("drawings", self.view_mode == self.DRAWINGS_VIEW, hover)

    def update_notes_heading(self, hover=False):
        self._paint_section_heading("notes", self.view_mode == self.NOTES_VIEW, hover)

    def _paint_section_heading(self, key, gewaehlt, hover):
        kopf = getattr(self, f"{key}_heading_frame", None)
        if kopf is None:
            return
        bg = self.theme["selection" if gewaehlt else "hover" if hover else "card"]
        fg = self.theme["selection_text" if gewaehlt else "text"]
        kopf.configure(bg=bg)
        pfeil = getattr(self, f"{key}_heading_icon")
        pfeil.master.configure(bg=bg)
        for widget in (pfeil, getattr(self, f"{key}_title")):
            widget.configure(bg=bg, fg=fg)

    def show_pages_add_menu(self, event=None):
        """„+“ neben „Seiten“: neue Seite, Bibliothek oder Import."""
        aktiv = self.get_folder(self.active_folder_id) if self.view_mode == "folder" else None
        ordner = aktiv.get("id") if aktiv and self.sidebar_section_for("folder", aktiv["id"]) == "pages" else None
        menu = self._new_themed_popup_menu()
        menu.add_command(label="Neue Seite", command=lambda: self.create_in_sidebar_section("page", ordner, "pages"))
        menu.add_cascade(label="Aus Vorlage", menu=self.page_template_menu(menu, ordner))
        menu.add_command(label="Neuer Ordner …", command=lambda: self.create_container_dialog("folder", sidebar_section="pages"))
        menu.add_command(label="Neues Buch …", command=lambda: self.create_container_dialog(
            "folder", parent_id=None, folder_kind="library", sidebar_section="pages"))
        menu.add_separator()
        menu.add_command(label="Seite aus Zwischenablage", command=self.new_page_from_clipboard)
        menu.add_command(label="Markdown als Seite …", command=self.import_markdown_page)
        menu.add_command(label="Glide-Seiten importieren …", command=self.import_glide_pages)
        self._popup_at_widget(menu, self.add_pages_button)
        return "break"

    def page_template_menu(self, menu, ordner=None, sidebar_section=None):
        """Untermenü „Aus Vorlage“ für Seiten: mitgelieferte und eigene Vorlagen."""
        section = sidebar_section or (self.sidebar_section_for("folder", ordner) if ordner else "pages")
        vorlagen = self._new_themed_popup_menu(menu)
        for schluessel, titel, _markdown in self.PAGE_TEMPLATES:
            vorlagen.add_command(label=titel, command=lambda key=schluessel: self.run_sidebar_creation(lambda: self.create_page_from_template(key, ordner), section))
        eigene = self.page_templates()
        if eigene:
            vorlagen.add_separator()
            for vorlage in eigene:
                vorlagen.add_command(label=str(vorlage.get("title") or "Vorlage"),
                                     command=lambda key=vorlage["id"]: self.create_template_in_section(key, ordner, section))
        vorlagen.add_separator()
        vorlagen.add_command(label="Geöffnete Seite als Vorlage speichern",
                             command=self.save_list_as_template,
                             state="normal" if self.view_mode == "list" and self.lists
                             and self.is_page_list(self.current_list()) else "disabled")
        return vorlagen

    # --- Notizbereich (29.09.2026) -------------------------------------------
    def active_journal_folder_id(self):
        """Das geöffnete Notizbuch – als Ordner oder als Ort der geöffneten Liste."""
        if self.view_mode == "folder":
            ordner = self.get_folder(self.active_folder_id)
        elif self.view_mode in ("list", self.TABLE_VIEW) and self.lists:
            ordner = self.get_folder((self.current_list() or {}).get("folder_id"))
        else:
            ordner = None
        return ordner.get("id") if ordner and ordner.get("folder_kind") == "journal" else None

    def note_templates(self):
        """Vorlagen, die eine Notiz anlegen – mitgelieferte und eigene."""
        return self.templates_of_list_kind(self.LIST_KIND_NOTE)

    def show_notes_add_menu(self, event=None):
        """„+“ neben „Notizen“: Tagesnotiz, neue Notiz, Vorlage oder Notizbuch."""
        menu = self._new_themed_popup_menu()
        notizbuch = self.active_journal_folder_id()
        if notizbuch:
            titel = str((self.get_folder(notizbuch) or {}).get("title") or "Notizbuch")
            menu.add_command(label=f"Tagesnotiz in „{self.ellipsize_sidebar_title(titel)}“",
                             command=lambda: self.create_journal_entry(notizbuch))
        menu.add_command(label="Neue Notiz", command=self.create_new_note)
        vorlagen = self._new_themed_popup_menu(menu)
        for vorlage in self.note_templates():
            vorlagen.add_command(label=str(vorlage.get("title") or "Vorlage"),
                                 command=lambda key=vorlage["id"]: self.create_list_from_template(key))
        jahresordner = self.template_by_id("journal-folder")
        if jahresordner:
            if self.note_templates():
                vorlagen.add_separator()
            vorlagen.add_command(label=str(jahresordner.get("title") or "Notizbuch – Jahresordner"),
                                 command=lambda: self.create_list_from_template("journal-folder"))
        menu.add_cascade(label="Aus Vorlage", menu=vorlagen)
        menu.add_command(label="Neuer Ordner …", command=lambda: self.create_container_dialog("folder", sidebar_section="notes"))
        menu.add_command(label="Neues Notizbuch …", command=lambda: self.create_container_dialog(
            "folder", parent_id=None, folder_kind="journal", sidebar_section="notes"))
        self._popup_at_widget(menu, self.add_notes_button)
        return "break"

    def create_new_note(self, folder_id=None, event=None):
        """Neue, leere Notiz – direkt geöffnet, Schreibmarke im Text (29.09.2026).

        In einem Notizbuch entsteht wie bisher ein datierter Eintrag.
        """
        if folder_id and not glide_sidebar.accepts(self.sidebar_section_for("folder", folder_id), "list", "note"):
            self.show_info("Anlegen", "Diese Dokumentart gehört nicht in diesen Bereich.")
            return "break"
        self.flush_rich_note()
        ordner = self.get_folder(folder_id) if folder_id else None
        if ordner is not None and ordner.get("folder_kind") == "journal":
            return self.create_journal_entry(folder_id)
        entry = self.new_list_object("Neue Notiz", [], folder_id=folder_id if ordner else None,
                                     list_kind=self.LIST_KIND_NOTE)
        with self.sidebar_change(refresh_tree=True) as change:
            self.lists.append(entry)
            change.mark()
        self.set_active_list(entry["id"])
        editor = getattr(self, "rich_note_editor", None)
        try:
            if editor is not None:
                editor.text.focus_set()
        except (AttributeError, tk.TclError):
            pass
        return "break"

    def note_entries(self):
        """Alle Notizen außer archivierten – auch die in Ordnern und Notizbüchern."""
        return [entry for entry in getattr(self, "lists", []) if isinstance(entry, dict)
                and entry.get("list_kind") == self.LIST_KIND_NOTE and not self.is_archived_entry(entry)]

    def notebook_folders(self):
        """Notizbücher, die nicht selbst in einem Notizbuch liegen (Quartale zählen zum Buch)."""
        return [folder for folder in self.folders if isinstance(folder, dict)
                and folder.get("folder_kind") == "journal" and not self.is_archived_folder(folder.get("id"))
                and (self.get_folder(folder.get("parent_id")) or {}).get("folder_kind") != "journal"]

    def set_notes_view(self, refresh=True):
        self._activate_system_view(self.NOTES_VIEW, refresh=refresh)
        return "break"

    NOTES_RECENT_LIMIT = 6

    def render_notes_page(self):
        """Notizübersicht: zuletzt bearbeitet, Notizbücher und alle Notizen (29.09.2026)."""
        for widget in self.home_content.winfo_children():
            widget.destroy()
        theme = self.theme
        karte = self.make_rounded_container(self.home_content, fill_key="card", outline_key="line",
                                            radius=18, padding=10, register=False, auto_height=True)
        karte.pack(fill="x")
        innen = tk.Frame(karte.inner, bg=theme["card"])
        innen.pack(fill="both", expand=True, padx=14, pady=12)
        leiste = ButtonFlow(innen, bg=theme["card"], gap=8)
        leiste.pack(fill="x", pady=(0, 12))
        leiste.add(self._make_dialog_button(leiste, "Neue Notiz", self.create_new_note, "confirm", width=128))
        leiste.add(self._make_dialog_button(leiste, "Neues Notizbuch …", lambda: self.create_container_dialog(
            "folder", parent_id=None, folder_kind="journal"), "muted", width=176))
        notizen = self.note_entries()
        zuletzt = sorted(notizen, key=lambda entry: str(entry.get("updated_at") or ""),
                         reverse=True)[:self.NOTES_RECENT_LIMIT]
        alle = sorted(notizen, key=lambda entry: str(entry.get("title") or "").casefold())

        def notizzeile(entry):
            pfad = " › ".join(self.folder_path_titles(entry.get("folder_id"))) if entry.get("folder_id") else ""
            stand = self.format_due_display(str(entry.get("updated_at") or "")[:10])
            return (None, str(entry.get("title") or "Notiz"), lambda lid=entry["id"]: self.set_active_list(lid),
                    " · ".join(teil for teil in (pfad, stand) if teil))

        def buchzeile(folder):
            zweig = {value["id"] for value in self.iter_folder_subtree(folder["id"])}
            anzahl = sum(1 for entry in self.lists if entry.get("folder_id") in zweig and not entry.get("archived"))
            return (None, str(folder.get("title") or "Notizbuch"),
                    lambda fid=folder["id"]: self.set_active_folder(fid),
                    "1 Eintrag" if anzahl == 1 else f"{anzahl} Einträge")

        abschnitte = []
        # „Zuletzt bearbeitet“ erst, wenn es mehr Notizen gibt, als der
        # Abschnitt zeigt – sonst stünden dieselben Zeilen zweimal da.
        if len(notizen) > self.NOTES_RECENT_LIMIT:
            abschnitte.append(("Zuletzt bearbeitet", [notizzeile(entry) for entry in zuletzt], ""))
        abschnitte.append(("Notizbücher", [buchzeile(folder) for folder in self.notebook_folders()],
                           "Noch kein Notizbuch. Ein Notizbuch sammelt datierte Einträge – „Neues Notizbuch …“."))
        abschnitte.append(("Alle Notizen", [notizzeile(entry) for entry in alle],
                           "Noch keine Notizen. „Neue Notiz“ legt eine an."))
        self.render_overview_sections(innen, abschnitte)
        self._bind_home_wheel(karte)

    # Mitgelieferte Seitenvorlagen als Markdown: Dieselbe Umwandlung wie für
    # KI-Berichte macht daraus Seiten mit echten Aufgaben. {Datum} wird beim
    # Anlegen ersetzt.
    PAGE_TEMPLATES = (
        ("bericht", "Bericht",
         "# Bericht\n\n**Stand:** {Datum}\n\n## Zusammenfassung\n\nWorum es geht, in zwei Sätzen.\n\n"
         "## Ergebnisse\n\n- Erste Erkenntnis\n\n## Nächste Schritte\n\n- [ ] Ersten Schritt festlegen\n"),
        ("besprechung", "Besprechung",
         "# Besprechung {Datum}\n\n**Teilnehmende:** \n\n## Themen\n\n1. Erstes Thema\n\n"
         "## Beschlüsse\n\n- \n\n## Aufgaben\n\n- [ ] Protokoll verschicken\n"),
        ("projekt", "Projektseite",
         "# Projekt\n\n> Ziel in einem Satz.\n\n## Hintergrund\n\nWarum es das Projekt gibt.\n\n"
         "## Meilensteine\n\n- [ ] Erster Meilenstein\n\n## Offene Fragen\n\n- \n"),
    )

    def page_templates(self):
        """Eigene Vorlagen, die eine Seite anlegen."""
        return self.templates_of_list_kind(self.LIST_KIND_PAGE)

    def templates_of_list_kind(self, list_kind):
        """Listenvorlagen, die eine Liste dieser Art anlegen."""
        ergebnis = []
        for vorlage in getattr(self, "templates", []) or []:
            if not isinstance(vorlage, dict) or vorlage.get("kind") == "folder":
                continue
            wurzeln = ((vorlage.get("payload") or {}).get("lists") or [])
            art = vorlage.get("list_kind") or (wurzeln[0].get("list_kind") if wurzeln else None)
            if art == list_kind:
                ergebnis.append(vorlage)
        return ergebnis

    def create_page_from_template(self, key, folder_id=None):
        """Neue Seite aus einer mitgelieferten Seitenvorlage."""
        self.refresh_data_lock()
        if getattr(self, '_data_read_only', False): return None
        reference_time = datetime.now()
        markdown = next((text for schluessel, _titel, text in self.PAGE_TEMPLATES if schluessel == key), None)
        if markdown is None:
            return None
        # {{Wochentag}}, {{KW}} usw. füllen sich auch in Seitenvorlagen (G11).
        markdown = self.TEMPLATE_FIELD_PATTERN.sub(
            lambda match: self.template_auto_value(match.group(1), reference_time) or match.group(0), markdown)
        markdown = markdown.replace("{Datum}", reference_time.strftime("%d.%m.%Y"))
        document = glide_page_markdown.markdown_to_page(markdown)
        first = next((line.strip() for line in markdown.splitlines() if line.strip()), 'Neue Seite')
        title = self.clip_container_title(re.sub(r'^#{1,6}\s+', '', first))
        if not self.confirm_template_preview({'title': title,
                                             'rich_note': document, 'items': []}):
            return None
        seite = self.new_page_from_markdown(markdown, folder_id=folder_id)
        return seite

    # Eigenes Austauschformat für Seiten (27.09.2026): dieselbe Zip-Struktur
    # wie ein Teilbackup, aber nur Seiten und Bibliotheken, gekennzeichnet mit
    # "content": "pages". Aufgaben, Labels und Anhänge reisen mit; beim Import
    # werden Labels zusammengeführt und Kennungen neu vergeben.
    PAGE_FILE_EXTENSION = ".glidepage"

    def export_glide_pages(self, list_ids=None, folder_ids=None):
        """Seiten oder eine Bibliothek als `.glidepage` speichern."""
        if list_ids is None and folder_ids is None:
            if self.view_mode == "folder" and self.active_folder_id:
                folder_ids, list_ids = [self.active_folder_id], []
            else:
                list_ids, folder_ids = ([self.active_list_id] if self.active_list_id else []), []
        list_ids, folder_ids = list(list_ids or []), list(folder_ids or [])
        seiten = [entry for entry in self.lists if entry.get("id") in list_ids]
        bibliotheken = [self.get_folder(value) for value in folder_ids]
        if (not seiten and not bibliotheken) or any(not self.is_page_list(entry) for entry in seiten) \
                or any(folder is None or folder.get("folder_kind") != "library" for folder in bibliotheken):
            self.show_info("Seite exportieren", "Wähle zuerst eine Seite oder ein Buch aus.")
            return "break"
        titel = (seiten[0] if seiten else bibliotheken[0]).get("title") or "Seite"
        path = filedialog.asksaveasfilename(
            title="Als Glide-Seite exportieren", defaultextension=self.PAGE_FILE_EXTENSION,
            initialfile=self.safe_filename(titel) + self.PAGE_FILE_EXTENSION,
            filetypes=[("Glide-Seite", "*" + self.PAGE_FILE_EXTENSION), ("Alle Dateien", "*.*")])
        if not path:
            return "break"
        try:
            payload = self.partial_backup_payload(list_ids, folder_ids)
            payload["content"] = "pages"
            self.write_complete_backup(path, payload)
            self.record_data_operation("exported", path)
            anzahl = len(payload["lists"])
            self.show_info("Seite exportiert", "1 Seite gespeichert." if anzahl == 1 else f"{anzahl} Seiten gespeichert.")
        except Exception as exc:
            self.show_error("Seite exportieren", str(exc))
        return "break"

    def read_glide_page_file(self, path):
        """Liest den Inhalt einer `.glidepage` und prüft, dass sie nur Seiten enthält."""
        if not zipfile.is_zipfile(path):
            raise ValueError("Das ist keine Glide-Seitendatei.")
        with zipfile.ZipFile(path, "r") as archiv:
            info, _anhaenge = self.inspect_backup_archive(archiv)
            daten = json.loads(self.read_zip_member_limited(archiv, info, self.MAX_BACKUP_DATA_BYTES).decode("utf-8"))
        if not isinstance(daten, dict) or daten.get("content") != "pages":
            raise ValueError("Die Datei enthält keine Glide-Seiten. Listen und Ordner kommen über "
                             "„Listen/Ordner hinzufügen …“.")
        if any(not self.is_page_list(entry) for entry in daten.get("lists") or []) or any(
                (folder or {}).get("folder_kind") != "library" for folder in daten.get("folders") or []):
            raise ValueError("Die Seitendatei enthält etwas anderes als Seiten und Bücher.")
        return daten

    def import_glide_pages(self, path=None):
        """`.glidepage` hinzufügen – der Bestand bleibt, neue Seiten kommen dazu."""
        path = path or filedialog.askopenfilename(
            title="Glide-Seiten importieren",
            filetypes=[("Glide-Seite", "*" + self.PAGE_FILE_EXTENSION), ("Alle Dateien", "*.*")])
        if not path:
            return None
        try:
            daten = self.read_glide_page_file(path)
        except (OSError, ValueError, KeyError, zipfile.BadZipFile) as exc:
            self.show_error("Glide-Seiten importieren", str(exc))
            return None
        vorher = {entry.get("id") for entry in self.lists}
        if not self.import_full_backup(additive=True, path=path, show_success=False):
            return None
        neu = [entry for entry in self.lists if entry.get("id") not in vorher]
        if neu and not daten.get("folders"):
            self.set_active_list(neu[0]["id"])
        anzahl = len(neu)
        self.show_info("Glide-Seiten importiert", "1 Seite hinzugefügt." if anzahl == 1 else f"{anzahl} Seiten hinzugefügt.")
        return neu

    def on_pages_select(self, event=None):
        """Eine Zeile im Seitenbereich öffnet ihre Seite oder Bibliothek."""
        return self.on_section_select(self.pages_listbox)

    def on_section_select(self, baum):
        """Eine Zeile im Seiten- oder Notizbereich öffnet ihre Liste oder ihren Ordner."""
        if getattr(self, "_updating_sidebar", False):
            return
        auswahl = baum.selection()
        if not auswahl:
            return
        for anderer in [getattr(self, "system_listbox", None)] + self.sidebar_trees():
            if anderer is not None and anderer is not baum and anderer.selection():
                anderer.selection_remove(*anderer.selection())
        row = self.sidebar_iid_to_row.get(auswahl[0])
        if not row:
            return
        art, kennung = row
        if art == "list" and (kennung != self.active_list_id or self.view_mode not in ("list", self.TABLE_VIEW)):
            self.set_active_list(kennung)
        elif art == "folder" and (kennung != self.active_folder_id or self.view_mode != "folder"):
            self.set_active_folder(kennung)

    def update_sidebar_heading(self, hover=False):
        if not hasattr(self, "sidebar_heading_frame"):
            return
        selected = self.view_mode == self.LIBRARY_VIEW
        bg = self.theme["selection" if selected else "hover" if hover else "card"]
        fg = self.theme["selection_text" if selected else "text"]
        self.sidebar_heading_frame.configure(bg=bg)
        self.sidebar_heading_icon.master.configure(bg=bg)
        for widget in (self.sidebar_heading_icon, self.sidebar_title):
            widget.configure(bg=bg, fg=fg)

    def _insert_sidebar_folder_rows(self, parent_folder_id, parent_iid, depth, tree=None):
        """Zeichnet einen Ordnerzweig mit Unterordnern und Listen.

        Die Rekursion ist durch MAX_FOLDER_DEPTH und durch die Kreisbereinigung
        in normalize_folder_parents doppelt abgesichert. `tree` ist der
        Seiten- oder Notizbereich: Auf oberster Ebene nimmt der eine nur
        Bibliotheken, der andere nur Notizbücher, der Listenbaum alle übrigen
        Ordner.
        """
        if depth > self.MAX_FOLDER_DEPTH:
            return
        ziel = tree or self.sidebar_listbox
        for folder in self.get_child_folders(parent_folder_id):
            folder_id = folder.get("id")
            if not folder_id or folder.get("archived"):
                continue
            if parent_folder_id is None and self.sidebar_tree_for_folder(folder) is not ziel:
                continue
            folder_title = str(folder.get("title") or "Ordner").strip() or "Ordner"
            # Der Zähler nennt Aufgaben aller enthaltenen Listen und Unterordner.
            child_count = self.folder_task_count(folder_id)
            iid = f"folder:{folder_id}"
            preview = self.sidebar_row_text(
                folder_title, child_count, tree=self.sidebar_listbox, depth=depth
            )
            folder_color = folder.get("color") if folder.get("color") in self.LIST_COLOR_KEYS else None
            folder_tags = (f"listcolor_{folder_color}",) if folder_color else ("folder",)
            ziel.insert(
                parent_iid,
                "end",
                iid=iid,
                text=preview,
                values=(self.sidebar_row_icon(("folder", folder_id)), f"({child_count})"),
                open=self.sidebar_folder_open_states.get(folder_id, True),
                tags=folder_tags,
                image=self.page_icon_image(folder) or "",
            )
            self.sidebar_rows.append(("folder", folder_id))
            self.sidebar_iid_to_row[iid] = ("folder", folder_id)
            # Erst die Unterordner, dann die eigenen Listen – so bleibt die
            # Struktur oben und der Inhalt darunter.
            self._insert_sidebar_folder_rows(folder_id, iid, depth + 1, tree=ziel)
            for entry in self.lists:
                if entry.get("folder_id") == folder_id and not self.is_inbox_list(entry) and not entry.get("archived"):
                    self._insert_sidebar_list_row(entry, parent=iid, depth=depth + 1, tree=ziel)

    def _insert_sidebar_list_row(self, entry, parent="", tree=None, depth=None):
        target_tree = tree or self.sidebar_listbox
        title = entry.get("title", "Meine Liste").strip() or "Meine Liste"
        item_count = self.count_items(entry.get("items", []))
        item_id = entry.get("id")
        if not item_id:
            item_id = uuid.uuid4().hex
            entry["id"] = item_id
        if self.is_gallery_list(entry):
            # Eine Galerie zählt ihre Bilder.
            item_count = len(entry.get("attachments") or [])
        is_inbox = self.is_inbox_list(entry)
        if depth is None:
            depth = 1 if parent else 0
        row_title = self.sidebar_display_title(("list", item_id), title)
        preview = self.sidebar_row_text(row_title, item_count, tree=target_tree, depth=depth)
        iid = f"list:{item_id}"
        if is_inbox:
            tags = ("system",)
        else:
            color_key = entry.get("color") if entry.get("color") in self.LIST_COLOR_KEYS else None
            tags = (f"listcolor_{color_key}",) if color_key else ("list",)
        target_tree.insert(parent, "end", iid=iid, text=preview,
                           values=(self.sidebar_row_icon(("list", item_id)), f"({item_count})"), tags=tags,
                           image=self.page_icon_image(entry) or "")
        self.sidebar_rows.append(("list", item_id))
        self.sidebar_iid_to_row[iid] = ("list", item_id)

    def get_selected_sidebar_row(self):
        rows = self.get_selected_sidebar_rows()
        return rows[0] if rows else None

    def get_selected_sidebar_rows(self):
        """Alle markierten Seitenleistenzeilen in Anzeigereihenfolge.

        Der Systembereich kennt nur Einfachauswahl; der Listenbaum erlaubt seit
        2.7.0 Shift- und Strg-Mehrfachauswahl.
        """
        if not hasattr(self, "sidebar_listbox"):
            return []
        if hasattr(self, "system_listbox"):
            system_selection = self.system_listbox.selection()
            if system_selection:
                row = self.sidebar_iid_to_row.get(system_selection[0])
                return [row] if row else []
        for bereich in (getattr(self, "pages_listbox", None), getattr(self, "notes_listbox", None),
                        getattr(self, "drawings_listbox", None)):
            if bereich is not None and bereich.selection():
                row = self.sidebar_iid_to_row.get(bereich.selection()[0])
                return [row] if row else []
        selection = set(self.sidebar_listbox.selection())
        if not selection:
            return []
        rows = []
        for iid in self.get_sidebar_visible_iids():
            if iid in selection:
                row = self.sidebar_iid_to_row.get(iid)
                if row:
                    rows.append(row)
        if rows:
            return rows
        # Rückfallebene, falls eine markierte Zeile gerade zugeklappt ist.
        return [row for row in (self.sidebar_iid_to_row.get(iid) for iid in selection) if row]

    def get_selected_sidebar_list_ids(self, include_inbox=False):
        """IDs aller markierten Listen; Ordner und Systemzeilen bleiben außen vor."""
        ids = []
        for row_type, row_id in self.get_selected_sidebar_rows():
            if row_type != "list":
                continue
            if not include_inbox and self.is_inbox_list(row_id):
                continue
            if row_id not in ids:
                ids.append(row_id)
        return ids

    def select_all_sidebar_lists(self, event=None):
        """Markiert alle sichtbaren Zeilen des Listenbaums."""
        tree = getattr(self, "sidebar_listbox", None)
        if tree is None:
            return "break"
        visible = self.get_sidebar_visible_iids()
        if not visible:
            return "break"
        tree.selection_set(visible)
        return "break"

    # Zuordnung Zeilenart -> IID der Systemzeile. Eine Tabelle statt einer
    # if-Kette, damit eine neue Systemansicht an genau einer Stelle entsteht.
    SYSTEM_VIEW_ROW_IDS = {
        "home": "smart:home",
        "history": "smart:history",
        "templates": "smart:templates",
        "pages": PAGES_ROW_ID,
        "in_progress": IN_PROGRESS_ROW_ID,
        PLAN_DAY_VIEW: PLAN_DAY_ROW_ID,
        LABELS_VIEW: LABELS_ROW_ID,
        "overdue": OVERDUE_ROW_ID,
        "trash": TRASH_ROW_ID,
    }

    def get_sidebar_iid_for_row(self, row):
        """IID der Seitenleistenzeile zu einer Zeilenart."""
        if not row:
            return None
        row_type, row_id = row
        if row_type == "view":
            return self.SYSTEM_VIEW_ROW_IDS.get(row_id)
        return f"{row_type}:{row_id}"

    def get_sidebar_tree_for_iid(self, iid):
        if not iid:
            return None
        for tree_name in ("system_listbox", "pages_listbox", "notes_listbox", "drawings_listbox", "sidebar_listbox"):
            tree = getattr(self, tree_name, None)
            try:
                if tree is not None and tree.exists(iid):
                    return tree
            except tk.TclError:
                continue
        return None

    def on_system_select(self, event=None):
        if getattr(self, "_updating_sidebar", False):
            return
        selection = self.system_listbox.selection()
        if not selection:
            return
        for baum in self.sidebar_trees():
            if baum.selection():
                baum.selection_remove(*baum.selection())
        row = self.sidebar_iid_to_row.get(selection[0])
        if row == ("view", self.HOME_VIEW) and self.view_mode != self.HOME_VIEW:
            self.set_home_view()
        elif row == ("view", self.HISTORY_VIEW) and self.view_mode != self.HISTORY_VIEW:
            self._activate_system_view(self.HISTORY_VIEW)
        elif row == ("view", self.PAGES_VIEW) and self.view_mode != self.PAGES_VIEW:
            self.set_pages_view()
        elif row == ("view", self.TEMPLATE_VIEW) and self.view_mode != self.TEMPLATE_VIEW:
            self.set_template_view()
        elif row and row[0] == "list" and (row[1] != self.active_list_id or self.view_mode != "list"):
            self.set_active_list(row[1])
        elif row == ("view", "in_progress") and self.view_mode != "in_progress":
            self.set_in_progress_view()
        elif row == ("view", self.PLAN_DAY_VIEW) and self.view_mode != self.PLAN_DAY_VIEW:
            self.set_plan_day_view()
        elif row == ("view", self.LABELS_VIEW) and self.view_mode != self.LABELS_VIEW:
            self.set_labels_view()
        elif row == ("view", "overdue") and self.view_mode != "overdue":
            self.set_overdue_view()
        elif row == ("view", "trash") and self.view_mode != "trash":
            self.set_trash_view()

    def on_sidebar_select(self, event=None):
        if getattr(self, "_updating_sidebar", False):
            return
        selection = self.sidebar_listbox.selection()
        if selection and hasattr(self, "system_listbox"):
            system_selection = self.system_listbox.selection()
            if system_selection:
                self.system_listbox.selection_remove(*system_selection)
        for bereich in (getattr(self, "pages_listbox", None), getattr(self, "notes_listbox", None)):
            if selection and bereich is not None and bereich.selection():
                bereich.selection_remove(*bereich.selection())
        # Bei Mehrfachauswahl bleibt die geöffnete Seite unverändert; sonst
        # würde jede Bereichsauswahl ungewollt die Ansicht umschalten.
        if len(selection) > 1:
            return
        row = self.get_selected_sidebar_row()
        if not row:
            return
        row_type, row_id = row
        if row_type == "list":
            if row_id != self.active_list_id or self.view_mode not in ("list", self.TABLE_VIEW):
                self.set_active_list(row_id)
        elif row_type == "folder":
            if row_id != self.active_folder_id or self.view_mode != "folder":
                self.set_active_folder(row_id)

    def edit_selected_sidebar_title(self, event=None):
        """Doppelklick und Titel-Schaltfläche öffnen den gemeinsamen Bearbeiten-Dialog."""
        # Der Doppelklick gewinnt gegen das Umbenennen an Ort und Stelle.
        self.cancel_sidebar_rename()
        row = self.get_selected_sidebar_row()
        if row and row[0] == "folder":
            return self.edit_folder_details(row[1])
        if row and row[0] == "list":
            return self.edit_list_details(row[1])
        return self.edit_title()

    # -----------------------------
    # Umbenennen an Ort und Stelle
    # -----------------------------
    def sidebar_rename_row(self, iid):
        """Liste oder Ordner hinter einer Zeile – oder None, wenn nicht umbenennbar."""
        row = self.sidebar_iid_to_row.get(iid)
        if not row:
            return None
        row_type, row_id = row
        if row_type == "folder":
            return row if self.get_folder(row_id) is not None else None
        if row_type == "list":
            entry = next((item for item in self.lists if item.get("id") == row_id), None)
            # Der Eingang trägt einen festen Systemnamen und bleibt außen vor.
            if entry is None or self.is_inbox_list(entry):
                return None
            return row
        return None

    def sidebar_row_title(self, row):
        row_type, row_id = row
        if row_type == "folder":
            folder = self.get_folder(row_id)
            return str((folder or {}).get("title") or "Ordner")
        entry = next((item for item in self.lists if item.get("id") == row_id), None)
        return str((entry or {}).get("title") or "Liste")

    def find_sidebar_iid(self, row):
        """Zeilen-ID zu einer (Art, ID)-Zuordnung."""
        for iid, mapped in self.sidebar_iid_to_row.items():
            if mapped == tuple(row):
                return iid
        return None

    def cancel_item_rename(self):
        timer = getattr(self, "_item_rename_timer", None)
        if timer:
            self.root.after_cancel(timer)
            self._item_rename_timer = None
        editor = getattr(self, "_item_rename_entry", None)
        self._item_rename_entry = None
        if editor and editor.winfo_exists():
            editor.destroy()

    def begin_item_rename(self, item_id):
        self._item_rename_timer = None
        found = self.find_item(item_id)
        if self.view_mode != "list" or not found or self.is_long_item(found[0]):
            return
        if tuple(self.tree.selection()) != (item_id,):
            return
        box = self.tree.bbox(item_id, "#0")
        if not box:
            return
        item = found[0]
        x, y, width, height = box
        editor = tk.Entry(self.tree, font=self.tree_font(), bg=self.theme["input"],
                          fg=self.theme["text"], insertbackground=self.theme["text"])
        editor.insert(0, item.get("text", ""))
        editor.place(x=x + 24, y=y, width=max(80, width - 24), height=height)
        self._item_rename_entry = editor
        def finish(commit=True):
            value = editor.get().strip() if editor.winfo_exists() else ""
            self.cancel_item_rename()
            if commit and value and value != item.get("text"):
                with self.item_change([item_id], local=True) as change:
                    item["text"] = self.normalize_item_text(value, self.item_kind(item))
                    change.mark(item_id)
        editor.bind("<Return>", lambda event: finish())
        editor.bind("<FocusOut>", lambda event: finish())
        editor.bind("<Escape>", lambda event: finish(False))
        editor.focus_set()
        editor.select_range(0, "end")

    def begin_sidebar_rename(self, iid=None, event=None):
        """Legt ein Eingabefeld über die Zeile, statt einen Dialog zu öffnen.

        Der Bearbeiten-Dialog bleibt für Titel und Beschreibungstext zuständig;
        wer nur den Namen ändern will, soll dafür kein Fenster brauchen.
        """
        self.cancel_sidebar_rename()
        tree = getattr(self, "sidebar_listbox", None)
        if tree is None:
            return "break"
        if iid is None:
            selection = tree.selection()
            iid = selection[0] if selection else None
        if not iid:
            return "break"
        row = self.sidebar_rename_row(iid)
        if row is None:
            return "break"
        try:
            tree.see(iid)
            tree.update_idletasks()
            bbox = tree.bbox(iid, "#0")
        except tk.TclError:
            bbox = None
        # Ein nicht gemapptes Fenster (z. B. im Kopf eines automatisierten
        # Tests) liefert für Treeview.bbox() eine leere Antwort. Das darf die
        # eigentliche Umbenennungslogik nicht aushebeln: Das Eingabefeld wird
        # beim nächsten Mapping an derselben Zeile sichtbar und erhält bis
        # dahin eine sichere Fallback-Geometrie.
        if not bbox:
            try:
                width = max(self.SIDEBAR_RENAME_MIN_WIDTH, int(tree.column("#0", "width")))
            except (tk.TclError, ValueError):
                width = self.SIDEBAR_RENAME_MIN_WIDTH
            x, y, height = self.SIDEBAR_ITEM_LEFT_PADDING, 0, 24
        else:
            x, y, width, height = bbox
        entry = tk.Entry(
            tree,
            bg=self.theme["input"], fg=self.theme["text"],
            insertbackground=self.theme["text"],
            selectbackground=self.theme["selection"], selectforeground=self.theme["selection_text"],
            relief="flat", bd=0,
            highlightthickness=1,
            highlightbackground=self.theme["ui_accent"], highlightcolor=self.theme["ui_accent"],
            font=app_font(10),
        )
        entry.insert(0, self.sidebar_row_title(row))
        self.limit_title_entry(entry)
        entry.select_range(0, tk.END)
        entry.place(x=x, y=y, width=max(self.SIDEBAR_RENAME_MIN_WIDTH, width), height=height)
        entry.focus_set()
        entry.bind("<Return>", lambda _event: self.finish_sidebar_rename(commit=True))
        entry.bind("<Escape>", lambda _event: self.finish_sidebar_rename(commit=False))
        entry.bind("<FocusOut>", lambda _event: self.finish_sidebar_rename(commit=True))
        self._sidebar_rename = {"entry": entry, "row": row}
        return "break"

    def finish_sidebar_rename(self, commit=True):
        """Schließt das Eingabefeld und übernimmt den Namen, sofern gewollt."""
        state = getattr(self, "_sidebar_rename", None)
        self._sidebar_rename = None
        if not state:
            return "break"
        entry = state["entry"]
        try:
            new_title = entry.get().strip()
        except tk.TclError:
            new_title = ""
        try:
            entry.destroy()
        except tk.TclError:
            pass
        # Ein leerer Name wird verworfen: Eine Liste ohne Titel wäre in der
        # Seitenleiste nicht mehr auffindbar.
        if commit and new_title:
            self.apply_sidebar_rename(state["row"], new_title)
        return "break"

    def cancel_sidebar_rename(self, event=None):
        self._cancel_sidebar_rename_timer()
        if getattr(self, "_sidebar_rename", None):
            self.finish_sidebar_rename(commit=False)
        return None

    def apply_sidebar_rename(self, row, new_title):
        """Übernimmt einen neuen Titel für eine Liste oder einen Ordner."""
        row_type, row_id = tuple(row)
        holder = (
            self.get_folder(row_id) if row_type == "folder"
            else next((item for item in self.lists if item.get("id") == row_id), None)
        )
        if holder is None:
            return
        new_title = self.clip_container_title(new_title)
        if str(holder.get("title") or "") == new_title:
            return
        self.snapshot_undo()
        holder["title"] = new_title
        open_list = row_type == "list" and row_id == self.active_list_id and self.view_mode == "list"
        open_folder = row_type == "folder" and row_id == self.active_folder_id and self.view_mode == "folder"
        if open_list:
            self.app_title = new_title
        if open_list or open_folder:
            self.update_header_title()
            self.update_window_title()
        # Erfolgreiches Speichern baut die Seitenleiste bereits neu auf (P06r).
        if not self.save_items():
            self.update_sidebar_list()
        self.refresh_tree()

    def _cancel_sidebar_rename_timer(self):
        timer = getattr(self, "_sidebar_rename_timer", None)
        self._sidebar_rename_timer = None
        if timer is None:
            return
        try:
            self.root.after_cancel(timer)
        except (tk.TclError, ValueError):
            pass

    def on_sidebar_release_for_rename(self, event):
        """Klick auf eine bereits ausgewählte Zeile startet das Umbenennen.

        Bewusst verzögert: Ein Doppelklick öffnet weiterhin den Bearbeiten-Dialog
        und bricht diesen Zeitgeber ab. Nach einem Zug passiert nichts.
        """
        self._cancel_sidebar_rename_timer()
        tree = getattr(self, "sidebar_listbox", None)
        if tree is None or event.widget is not tree:
            return
        if getattr(self, "_sidebar_release_moved", False):
            return
        if event.state & 0x0005:  # Shift oder Strg erweitern die Auswahl
            return
        iid = tree.identify_row(event.y)
        if not iid or iid not in getattr(self, "_sidebar_preselected", ()):
            return
        # Ein Klick auf das Klappdreieck eines Ordners öffnet und schließt ihn –
        # und tut sonst nichts. Wer auf- und zuklappt, will nicht umbenennen.
        try:
            element = str(tree.identify_element(event.x, event.y))
        except tk.TclError:
            element = ""
        if "indicator" in element:
            return
        if len(tree.selection()) != 1:
            return
        if self.sidebar_rename_row(iid) is None:
            return
        self._sidebar_rename_timer = self.root.after(
            self.SIDEBAR_RENAME_DELAY_MS, lambda: self.begin_sidebar_rename(iid)
        )

    def _add_color_menu(self, menu, heading, current, setter, target_id):
        """Farbauswahl als Untermenü – identisch für Listen und Ordner."""
        color_menu = self._new_themed_popup_menu(menu)
        for label, color_key in self.LIST_COLOR_CHOICES:
            prefix = "\u2713 " if current == color_key else "      "
            color_menu.add_command(
                label=f"{prefix}{label}",
                foreground=self.theme[color_key],
                command=lambda c=color_key: setter(target_id, c),
            )
        color_menu.add_separator()
        prefix = "\u2713 " if not current else "      "
        color_menu.add_command(label=f"{prefix}Keine Farbe", command=lambda: setter(target_id, None))
        menu.add_cascade(label=heading, menu=color_menu)
        return color_menu

    def _add_page_label_menu(self, menu, holder, kind):
        """Labels einer Liste oder eines Ordners zuweisen und lösen."""
        label_menu = self._new_themed_popup_menu(menu)
        assigned = list((holder or {}).get("labels") or [])
        holder_id = (holder or {}).get("id")
        # Die festen Labels tragen die Art eines Punkts und stehen deshalb bei
        # Listen und Ordnern nicht zur Auswahl.
        available = [label for label in self.labels if not self.is_system_label(label)]
        if not available:
            label_menu.add_command(label="Noch keine Labels angelegt", state="disabled")
        else:
            for label in available:
                label_id = label.get("id")
                prefix = "\u2713 " if label_id in assigned else "     "
                label_menu.add_command(
                    label=f"{prefix}{label.get('name', '')}",
                    foreground=self.label_color(label),
                    command=lambda selected=label_id: self.toggle_page_label(kind, holder_id, selected),
                )
            label_menu.add_separator()
            label_menu.add_command(
                label="Alle Labels entfernen",
                command=lambda: self.clear_page_labels(kind, holder_id),
            )
        label_menu.add_separator()
        label_menu.add_command(label="Labels verwalten …", command=self.open_label_manager)
        menu.add_cascade(label="Labels", menu=label_menu)
        return label_menu

    def find_label_holder(self, kind, holder_id):
        collection = self.lists if kind == "list" else self.folders
        return next((entry for entry in collection if entry.get("id") == holder_id), None)

    def toggle_page_label(self, kind, holder_id, label_id):
        holder = self.find_label_holder(kind, holder_id)
        label = self.get_label(label_id)
        if holder is None or label is None:
            return "break"
        if self.is_system_label(label):
            # Die festen Labels beschreiben die Art eines Punkts. Auf einer
            # Liste oder einem Ordner hätten sie keine Bedeutung.
            self.show_info(
                "Festes Label",
                f"„{label.get('name', '')}“ gilt nur für Punkte innerhalb einer Liste.",
            )
            return "break"
        assigned = list(holder.get("labels") or [])
        if label_id in assigned:
            assigned = [value for value in assigned if value != label_id]
        elif len(assigned) < self.MAX_LABELS_PER_ITEM:
            assigned.append(label_id)
        else:
            return "break"
        self.snapshot_undo()
        holder["labels"] = assigned
        self.save_items()
        self.update_page_labels()
        self.refresh_tree()
        return "break"

    def clear_page_labels(self, kind, holder_id):
        holder = self.find_label_holder(kind, holder_id)
        if holder is None or not holder.get("labels"):
            return "break"
        self.snapshot_undo()
        holder["labels"] = []
        self.save_items()
        self.update_page_labels()
        self.refresh_tree()
        return "break"

    def build_sidebar_context_menu(self, row, rows=None):
        """Vollständiges Kontextmenü für eine Liste, einen Ordner oder eine Systemzeile."""
        if rows and len(rows) > 1:
            return self.build_sidebar_multi_menu(rows)
        if not row:
            return None
        row_type, row_id = row
        if row_type == "view":
            menu = self.build_smart_view_menu(row_id)
            if menu is not None:
                menu.add_separator()
                menu.add_command(label="Ansichten einklappen",
                                 command=lambda: self.set_sidebar_section_open("views", False))
            return menu
        if row_type == "folder":
            return self.build_folder_menu(row_id)
        if row_type == "list":
            return self.build_list_menu(row_id)
        return None

    def build_sidebar_multi_menu(self, rows):
        """Kontextmenü für eine Mehrfachauswahl aus Listen und Ordnern."""
        list_ids = [row_id for row_type, row_id in rows if row_type == "list" and not self.is_inbox_list(row_id)]
        folder_ids = [row_id for row_type, row_id in rows if row_type == "folder"]
        menu = self._new_themed_popup_menu()
        menu.add_command(label=f"Auswahl: {len(list_ids)} Liste(n), {len(folder_ids)} Ordner", state="disabled")
        menu.add_separator()

        move_menu = self._new_themed_popup_menu(menu)
        for folder in self.folders:
            folder_id = folder.get("id")
            indent = "   " * self.folder_depth(folder_id)
            move_menu.add_command(
                label=f"{indent}{str(folder.get('title') or 'Ordner').strip() or 'Ordner'}",
                command=lambda target=folder_id: self.move_selected_lists_to_folder(target),
            )
        if not self.folders:
            move_menu.add_command(label="Kein Ordner vorhanden", state="disabled")
        menu.add_cascade(
            label="Listen in Ordner verschieben",
            menu=move_menu,
            state="normal" if list_ids and self.folders else "disabled",
        )
        menu.add_command(
            label="Listen aus Ordner herauslösen",
            command=lambda: self.move_selected_lists_to_folder(None),
            state="normal" if list_ids else "disabled",
        )

        # Ordner lassen sich genauso verschieben wie Listen – auch mehrere auf
        # einmal. Unzulässige Ziele bleiben sichtbar, aber gesperrt.
        folder_move_menu = self._new_themed_popup_menu(menu)
        folder_move_menu.add_command(
            label="Oberste Ebene",
            command=lambda: self.move_selected_folders_to_folder(None),
        )
        candidates = [
            folder for folder in self.folders if folder.get("id") not in set(folder_ids)
        ]
        if candidates:
            folder_move_menu.add_separator()
        for folder in candidates:
            target_id = folder.get("id")
            indent = "   " * self.folder_depth(target_id)
            allowed = any(
                self.can_move_folder_into(folder_id, target_id) for folder_id in folder_ids
            )
            folder_move_menu.add_command(
                label=f"{indent}{str(folder.get('title') or 'Ordner').strip() or 'Ordner'}",
                command=lambda target=target_id: self.move_selected_folders_to_folder(target),
                state="normal" if allowed else "disabled",
            )
        menu.add_cascade(
            label="Ordner verschieben",
            menu=folder_move_menu,
            state="normal" if folder_ids else "disabled",
        )
        menu.add_separator()

        color_menu = self._new_themed_popup_menu(menu)
        for label, color_key in self.LIST_COLOR_CHOICES:
            color_menu.add_command(
                label=label,
                foreground=self.theme[color_key],
                command=lambda selected=color_key: self.set_selected_sidebar_color(selected),
            )
        color_menu.add_separator()
        color_menu.add_command(label="Keine Farbe", command=lambda: self.set_selected_sidebar_color(None))
        menu.add_cascade(label="Farbe der Auswahl", menu=color_menu)
        menu.add_separator()
        menu.add_command(
            label="In den Papierkorb",
            command=self.trash_selected_sidebar_entries,
            foreground=self.theme["delete"],
            state="normal" if (list_ids or folder_ids) else "disabled",
        )
        return menu

    def build_list_menu(self, list_id):
        entry = next((item for item in self.lists if item.get("id") == list_id), None)
        if entry is None:
            return None
        is_inbox = self.is_inbox_list(entry)
        title = str(entry.get("title") or "Liste").strip() or "Liste"
        in_folder = bool(entry.get("folder_id"))

        menu = self._new_themed_popup_menu()
        menu.add_command(label=self.ellipsize_sidebar_title(title), state="disabled")
        menu.add_separator()
        menu.add_command(label="Öffnen", command=lambda: self.set_active_list(list_id))
        menu.add_command(
            label="Umbenennen",
            command=lambda: self.begin_sidebar_rename(self.find_sidebar_iid(("list", list_id))),
            state="disabled" if is_inbox else "normal",
        )
        menu.add_command(
            label="Bearbeiten (Titel, Beschreibungstext) …",
            command=lambda: self.edit_list_details(list_id),
        )
        self._add_color_menu(menu, "Listenfarbe", entry.get("color"), self.set_list_color, list_id)
        self._add_page_label_menu(menu, entry, "list")
        menu.add_cascade(label="Verweise und Rückverweise", menu=self.build_object_reference_menu(("list", list_id), menu))
        if self.is_page_list(entry):
            menu.add_command(label='Live-Liste einbetten …', command=lambda: self.choose_live_list(list_id))
            menu.add_cascade(label='Titelbild', menu=self.page_cover_menu(list_id, menu))
        if entry.get("list_kind", self.LIST_KIND_TASKS) == self.LIST_KIND_TASKS and not is_inbox:
            wiederkehrend = entry.get("recurring_checklist") is True
            menu.add_command(
                label=("✓ " if wiederkehrend else "") + "Wiederkehrende Checkliste",
                command=lambda: self.set_recurring_checklist(list_id, not wiederkehrend))
            if wiederkehrend:
                routine = list_id in (self.settings.get("today_routines") or [])
                menu.add_command(label=("✓ " if routine else "") + "In Heute als Routine zeigen",
                                 command=lambda: self.toggle_today_routine(list_id))
            menu.add_command(label="Alle Punkte wieder öffnen", command=lambda: self.reset_checklist(list_id))
        menu.add_separator()

        create_menu = self.folder_quick_add_menu(entry.get("folder_id")) if entry.get("folder_id") else self._new_themed_popup_menu(menu)
        if not entry.get("folder_id"):
            section = self.sidebar_section_for("list", list_id)
            for key, info in self.LIST_KINDS.items():
                if glide_sidebar.accepts(section, "list", key):
                    create_menu.add_command(label=f"Neue {info['label']} …", command=lambda k=key: self.create_container_dialog(
                        "list", list_kind=k, sidebar_section=section))
            create_menu.add_command(label="Neuer Ordner …", command=lambda: self.create_container_dialog(
                "folder", sidebar_section=section))
        menu.add_cascade(label="Neu anlegen", menu=create_menu)

        move_menu = self._new_themed_popup_menu(menu)
        move_menu.add_command(
            label="In Ordner verschieben …",
            command=lambda: self.move_list_to_folder_dialog(list_id),
            state="disabled" if is_inbox or not self.folders else "normal",
        )
        move_menu.add_command(
            label="Aus Ordner herauslösen",
            command=lambda: self.detach_list_from_folder(list_id),
            state="normal" if in_folder and not is_inbox else "disabled",
        )
        menu.add_cascade(label="Verschieben", menu=move_menu, state="disabled" if is_inbox else "normal")

        menu.add_command(
            label="Duplizieren",
            command=lambda: self.duplicate_list(list_id),
            state="disabled" if is_inbox else "normal",
        )

        export_menu = self._new_themed_popup_menu(menu)
        export_menu.add_command(label="Als TXT …", command=lambda: self.export_list_as(list_id, "txt"))
        export_menu.add_command(label="Als Markdown …", command=lambda: self.export_list_as(list_id, "md"))
