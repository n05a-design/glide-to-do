    def table_columns_for_list(self, list_id=None):
        """Sichtbare Tabellenspalten der Liste, mit stabilen Defaults."""
        list_id = list_id or self.active_list_id
        configured = self.settings.get("table_columns", {}).get(list_id)
        if not isinstance(configured, list):
            return list(self.TABLE_COLUMN_KEYS)
        columns = [value for value in configured if value in self.TABLE_COLUMN_KEYS]
        if "title" not in columns:
            columns.insert(0, "title")
        return list(dict.fromkeys(columns)) or ["title"]

    def table_widths_for_list(self, list_id=None):
        """Selbst gezogene Spaltenbreiten der Liste; sonst ein leeres Wörterbuch."""
        list_id = list_id or self.active_list_id
        stored = self.settings.get("table_column_widths", {}).get(list_id)
        return dict(stored) if isinstance(stored, dict) else {}

    def note_table_separator_press(self, event=None):
        """Merkt sich, ob ein Klick auf einer Spaltentrennlinie begann.

        Bis 3.22 prüfte Glide erst beim Loslassen, ob der
        Zeiger über einer Trennlinie steht. Nach dem Ziehen steht er dort aber
        fast nie mehr – die Linie ist ja mitgewandert, und wer schnell zieht,
        lässt sie ohnehin hinter sich. Die Breite wurde deshalb praktisch nie
        gespeichert und beim nächsten Aufbau der Tabelle wieder überschrieben.
        Entscheidend ist, wo der Klick begann, nicht wo er endet.
        """
        try:
            self._table_separator_drag = self.tree.identify_region(event.x, event.y) == "separator"
        except (tk.TclError, AttributeError):
            self._table_separator_drag = False

    def remember_table_column_widths(self, event=None):
        """Sichert die Spaltenbreiten, nachdem eine Trennlinie gezogen wurde.

        Nur nach einem Zug an einer Trennlinie: Ein gewöhnlicher Klick auf eine
        Überschrift sortiert und darf keine Breite festschreiben.
        """
        gezogen = getattr(self, "_table_separator_drag", False)
        self._table_separator_drag = False
        if self.view_mode != self.TABLE_VIEW or not self.active_list_id:
            return
        if event is not None and not gezogen:
            return
        widths = {}
        for key in self.table_columns_for_list():
            try:
                widths[key] = max(self.TABLE_COLUMN_MIN_WIDTH,
                                  min(self.TABLE_COLUMN_MAX_WIDTH, int(self.tree.column(key, "width"))))
            except (tk.TclError, TypeError, ValueError):
                continue
        if not widths:
            return
        stored = self.settings.setdefault("table_column_widths", {})
        if stored.get(self.active_list_id) == widths:
            return
        before = copy.deepcopy(stored)
        stored[self.active_list_id] = widths
        if not self.save_settings():
            self.settings["table_column_widths"] = before

    def reset_table_columns(self):
        """Nimmt Breiten und Sortierung der aktiven Liste zurück."""
        if not self.active_list_id:
            return "break"
        before = (copy.deepcopy(self.settings.get("table_column_widths", {})),
                  copy.deepcopy(self.settings.get("table_sort", {})))
        self.settings.setdefault("table_column_widths", {}).pop(self.active_list_id, None)
        self.settings.setdefault("table_sort", {}).pop(self.active_list_id, None)
        if not self.save_settings():
            self.settings["table_column_widths"], self.settings["table_sort"] = before
            return "break"
        self.refresh_tree()
        return "break"

    def table_sort_for_list(self, list_id=None):
        """(Spalte, Richtung) der Tabellensortierung; ohne Regel (None, "asc")."""
        list_id = list_id or self.active_list_id
        rule = self.settings.get("table_sort", {}).get(list_id)
        if not isinstance(rule, dict) or rule.get("column") not in self.TABLE_COLUMN_KEYS:
            return None, "asc"
        return rule["column"], "desc" if rule.get("direction") == "desc" else "asc"

    def sort_table_by(self, column):
        """Schaltet eine Spalte durch aufsteigend, absteigend und Listenreihenfolge.

        Drei Zustände statt zwei: Ohne den dritten gäbe es keinen Weg zurück zu
        der Reihenfolge, in der die Punkte tatsächlich in der Liste stehen.
        """
        if column not in self.TABLE_COLUMN_KEYS or not self.active_list_id:
            return "break"
        current, direction = self.table_sort_for_list()
        before = copy.deepcopy(self.settings.get("table_sort", {}))
        rules = self.settings.setdefault("table_sort", {})
        if current != column:
            rules[self.active_list_id] = {"column": column, "direction": "asc"}
        elif direction == "asc":
            rules[self.active_list_id] = {"column": column, "direction": "desc"}
        else:
            rules.pop(self.active_list_id, None)
        if not self.save_settings():
            self.settings["table_sort"] = before
            return "break"
        self.refresh_tree()
        return "break"

    def table_sort_value(self, item, column):
        """Vergleichswert und „fehlt“-Kennzeichen eines Punkts für eine Spalte."""
        if column == "title":
            text = str(self.item_display_text(item) or "").strip().casefold()
            return text, not text
        if column == "type":
            return str(self.ITEM_KIND_LABELS.get(self.item_kind(item), "")).casefold(), False
        if column == "due":
            due = self.normalize_due(item.get("due"))
            return (due or "") + " " + str(item.get("due_time") or ""), not due
        if column == "planned_date":
            planned = self.normalize_due(item.get("planned_date"))
            return planned or "", not planned
        if column == "estimated_minutes":
            minutes = item.get("estimated_minutes")
            valid = isinstance(minutes, int) and not isinstance(minutes, bool)
            return (minutes if valid else 0), not valid
        if column == "importance":
            return self.clamp_importance(item.get("importance", 0)), False
        if column == "labels":
            names = self.format_item_label_names(item)
            return str(names or "").casefold(), not names
        if column == "checklist":
            fortschritt = self.checklist_progress(item)
            # Sortiert wird nach dem Anteil; ohne Checkliste zählt der Punkt
            # als „fehlt" und bleibt am Ende stehen.
            anteil = fortschritt["done"] / fortschritt["total"] if fortschritt["total"] else 0
            return anteil, not fortschritt["total"]
        if column == "status":
            return 1 if item.get("done") else 0, False
        return "", True

    def table_entries(self, apply_filters=True):
        """Flache Tabellenzeilen als Referenzen auf die echten Punktobjekte."""
        query = self.current_search_query() if apply_filters else ""
        entries = []
        for order, item in enumerate(self.walk_items(self.items)):
            if not self.is_schedulable_item(item):
                continue
            if apply_filters and (
                not self.item_text_matches_query(item, query)
                or not self.item_matches_status_filter(item)
            ):
                continue
            entries.append((order, item))
        column, direction = self.table_sort_for_list()
        if column:
            # Zwei stabile Durchgänge: erst der Wert in der gewählten Richtung,
            # danach die leeren Zellen ans Ende. Leere Werte wandern sonst beim
            # Umschalten auf absteigend nach oben und verdecken den Bestand.
            entries.sort(key=lambda pair: self.table_sort_value(pair[1], column)[0],
                         reverse=direction == "desc")
            entries.sort(key=lambda pair: 1 if self.table_sort_value(pair[1], column)[1] else 0)
        return entries

    def table_column_values(self, item, columns):
        """Werte für die Spaltenfolge der Tabellenansicht."""
        values = []
        for column in columns:
            if column == "title":
                values.append(self.item_display_text(item))
            elif column == "type":
                values.append(self.ITEM_KIND_LABELS.get(self.item_kind(item), "Aufgabe"))
            elif column == "due":
                due = self.format_due_full(item.get("due"), item.get("due_time"))
                values.append(due or "—")
            elif column == "importance":
                values.append(self.IMPORTANCE_NAMES.get(self.clamp_importance(item.get("importance")), "keine"))
            elif column == "planned_date":
                values.append(self.format_due_display(item.get("planned_date")) or "—")
            elif column == "estimated_minutes":
                values.append(self.format_estimated_minutes(item.get("estimated_minutes")) or "—")
            elif column == "labels":
                values.append(self.format_item_labels(item) or "—")
            elif column == "checklist":
                values.append(self.format_checklist_progress(item) or "—")
            elif column == "status":
                values.append("Erledigt" if item.get("done") else "Offen")
        return tuple(values)

    DIALOG_TEXT_WIDTH = 460

    def dialog_label(self, parent, text, bold=False, size=10, bg="bg", color="text",
                     pady=(0, 10), wrap=True):
        """Eine linksbündige, umbrechende Beschriftung für Dialoge.

        Der Spaltendialog rief `self.label(...)` auf – eine
        Methode, die es nur in `ItemWorkspace` gibt, nicht in `ListApp`. Der
        Aufruf endete in einem AttributeError, den Tk als Callback-Fehler
        verschluckte: Das Fenster war bereits erzeugt, der Inhalt wurde nie
        gebaut, und der Nutzer sah ein leeres Fenster ohne Fehlermeldung.
        Seit 3.23 gibt es die Beschriftung auch hier – und `tests/tools/
        attributpruefung.py` findet einen solchen Aufruf künftig vor dem
        Ausliefern.

        `justify="left"` richtet nur mehrere Zeilen
        zueinander aus. Wo der Textblock im Widget sitzt, entscheidet
        `anchor`; ohne ihn zentriert Tk ihn. Genau daran lag es, dass der
        Hinweistext der Benachrichtigungen nicht auf der linken Flucht begann.
        """
        widget = tk.Label(parent, text=text, bg=self.theme[bg], fg=self.theme[color],
                          font=app_font(size, *(("bold",) if bold else ())),
                          anchor="w", justify="left",
                          # Ohne Anfangsbreite forderte ein langer Hinweis seine
                          # ganze Textlänge an, und der Dialog wurde so breit
                          # (W05: 1317 und 1705 px unter Windows). Die Breite
                          # folgt danach dem Fenster.
                          wraplength=self.DIALOG_TEXT_WIDTH if wrap else 0)
        widget.pack(fill="x", pady=pady)
        if wrap:
            widget.bind("<Configure>",
                        lambda event, w=widget: w.configure(wraplength=max(120, event.width - 12)))
        return widget

    def show_table_columns_dialog(self, event=None):
        """Lässt die sichtbaren Tabellenspalten pro Liste auswählen."""
        if self.view_mode != self.TABLE_VIEW:
            # Bis 29.09.2026 blieb der Menüeintrag außerhalb der Tabelle still
            # (R11). Jetzt wechselt er in die Tabelle und öffnet das Fenster.
            if self.view_mode != "list" or not self.lists or not self.list_accepts_items(self.current_list()):
                self.show_info("Tabellenspalten", "Öffne zuerst eine Aufgaben- oder Notizliste.")
                return "break"
            self.set_table_view()
            if self.view_mode != self.TABLE_VIEW:
                return "break"
        dialog = tk.Toplevel(self.root)
        dialog.title("Tabellenspalten")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=24, pady=22)
        self.register_theme_widget(outer, "bg")
        self.dialog_label(outer, "Tabellenspalten", bold=True, size=16)
        self.dialog_label(outer, "Die Auswahl gilt nur für die aktuell geöffnete Liste. "
                                 "Spaltenbreiten lassen sich in der Tabelle an den Trennlinien ziehen; "
                                 "ein Klick auf eine Überschrift sortiert auf-, ab- und wieder in Listenreihenfolge.",
                          color="muted", pady=(4, 14))
        selected = set(self.table_columns_for_list())
        variables = {}
        for key in self.TABLE_COLUMN_KEYS:
            variable = tk.BooleanVar(value=key in selected)
            variables[key] = variable
            check = tk.Checkbutton(
                outer, text=self.TABLE_COLUMN_LABELS[key], variable=variable,
                bg=self.theme["bg"], fg=self.theme["text"], activebackground=self.theme["bg"],
                activeforeground=self.theme["text"], selectcolor=self.theme["input"],
                relief="flat", bd=0, highlightthickness=0, anchor="w", takefocus=1,
                font=app_font(11),
            )
            check.pack(fill="x", pady=3)
            if key == "title":
                check.configure(state="disabled")
        buttons = ButtonFlow(outer, bg=self.theme["bg"], align="e")
        buttons.pack(fill="x", pady=(18, 0))
        def submit():
            columns = [key for key in self.TABLE_COLUMN_KEYS if variables[key].get()]
            if "title" not in columns:
                columns.insert(0, "title")
            before = copy.deepcopy(self.settings.get("table_columns", {}))
            self.settings.setdefault("table_columns", {})[self.active_list_id] = columns
            if not self.save_settings():
                self.settings["table_columns"] = before
                return
            dialog.destroy()
            self.refresh_tree()
        def reset_and_close():
            dialog.destroy()
            self.reset_table_columns()
        buttons.add(self._make_dialog_button(buttons, "Breiten und Sortierung zurücksetzen",
                                             reset_and_close, "clear", width=280))
        buttons.add(self._make_dialog_button(buttons, "Abbrechen", dialog.destroy, "muted"))
        buttons.add(self._make_dialog_button(buttons, "Speichern", submit, "confirm"))
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        self._center_dialog(dialog, min_width=520, min_height=320)
        self._schedule_windows_chrome_theme(dialog)
        self.run_modal(dialog)
        return "break"

    def finish_page_switch(self, refresh=True):
        """Schließt jeden Seitenwechsel gleich ab.

        Dieselben zwölf Zeilen standen an vier
        Stellen – am Ende von `_set_active_list`, `set_table_view`,
        `_set_active_folder` und `__activate_system_view`. Sie haben nichts
        damit zu tun, welche Seite geöffnet wird, sondern nur damit, dass eine
        geöffnet wurde: Aufklappzustand und Auswahlanker gehören zur vorherigen
        Seite und verfallen, Titel, Notiz, Labels und Eingabezeile richten sich
        neu aus, und wenn gewünscht folgen Seitenleiste, Baum und Einstellungen.

        Vier Kopien heißt: Wer einen Schritt ergänzt, ergänzt ihn drei Mal –
        oder eben nicht, und dann verhält sich eine der vier Ansichten anders
        als die übrigen, ohne dass jemand es beabsichtigt hätte.
        """
        self.flush_rich_note()
        self.expanded_ids = set()
        self.restore_note_chrome()
        self.collapsed_item_ids = set()
        self.selection_anchor_id = None
        self.update_window_title()
        self.update_header_title()
        self.update_page_note_preview()
        self.update_page_labels()
        self.update_entry_mode()
        if refresh:
            self.update_sidebar_list()
            self.refresh_tree()
            self.save_settings()

    def set_active_folder(self, folder_id, refresh=True):
        with self.render_pass():
            return self._set_active_folder(folder_id, refresh=refresh)

    def _set_active_folder(self, folder_id, refresh=True):
        folder = self.get_folder(folder_id)
        if not folder:
            return
        if self.active_list_id and self.lists:
            self.sync_current_list_reference()
        self.view_mode = "folder"
        self.active_folder_id = folder_id
        self.note_page_opened("folder", folder_id)
        self.finish_page_switch(refresh=refresh)

    def today_plan_ids(self, day=None):
        """IDs der Aufgaben, die auf dem betrachteten Tag eingeplant sind.

        Seit 3.22 liest die Auswahl das Feld `planned_date` am Punkt. Der
        frühere Eintrag in den Einstellungen ist entfallen; er verfiel um
        Mitternacht und stand in keinem Backup.
        """
        return [entry[4].get("id") for entry in self.plan_day_entries(apply_filters=False, day=day)]

    def today_plan_entries(self, apply_filters=True, day=None):
        """Die eingeplanten Aufgaben als Referenzen auf die Quellobjekte."""
        return self.plan_day_entries(apply_filters=apply_filters, day=day)

    def count_today_plan(self):
        return self.count_plan_day()

    def set_today_view(self, refresh=True):
        """Öffnet „Heute“ beim heutigen Tag."""
        return self.set_plan_day_view(refresh=refresh, day=date.today().isoformat())

    def plan_inbox_items(self, apply_filters=True):
        """Offene Aufgaben des Eingangs ohne Bearbeitungstag.

        Neu erfasste Aufgaben landen im Eingang und tragen
        noch keinen Tag. Damit sie nicht unbemerkt liegen bleiben, stehen sie
        als eigener Block in „Mein Tag“ und lassen sich von dort mit einem
        Befehl auf den gezeigten Tag setzen.
        """
        inbox = next((entry for entry in self.lists if self.is_inbox_list(entry)), None)
        if not isinstance(inbox, dict):
            return []
        query = self.current_search_query() if apply_filters else ""
        treffer = []
        for item in self.walk_items(inbox.get("items", [])):
            if not self.is_schedulable_item(item) or item.get("done"):
                continue
            if self.normalize_due(item.get("planned_date")):
                continue
            if apply_filters and (
                not self.item_text_matches_query(item, query)
                or not self.item_matches_status_filter(item)
            ):
                continue
            treffer.append((inbox, item))
        return treffer

    def today_view_pool(self, apply_filters=True):
        """Offene Aufgaben mit Fälligkeit oder Bearbeitungstag, chronologisch.

        Aus ihnen nimmt „Heute“ (D14) Verspätetes, Liegengebliebenes und heute
        Fälliges; was davon wohin gehört, entscheidet `today_view.py`.
        """
        return self.render_cached(
            ("today_pool", bool(apply_filters),
             self.current_search_query() if apply_filters else "",
             self.get_filter_mode() if apply_filters and hasattr(self, "hide_done_var") else ""),
            lambda: self._collect_today_view_pool(apply_filters))

    def _collect_today_view_pool(self, apply_filters):
        query = self.current_search_query() if apply_filters else ""
        results = []
        for list_index, entry in enumerate(self.planning_lists()):
            for item_index, item in enumerate(self.walk_items(entry.get("items", []))):
                if not self.is_schedulable_item(item) or item.get("done"):
                    continue
                due_value = self.normalize_due(item.get("due"))
                if not due_value and not self.normalize_due(item.get("planned_date")):
                    continue
                if apply_filters and (
                    not self.item_text_matches_query(item, query)
                    or not self.item_matches_status_filter(item)
                ):
                    continue
                results.append((due_value or "", list_index, item_index, entry, item))
        results.sort(key=lambda value: (value[0] or "9999-12-31", value[1], value[2]))
        return results

    def plan_day_sections(self, geplant=None, apply_filters=True, day=None):
        """Die Abschnitte von „Heute“ für den gezeigten Tag (D14).

        Am heutigen Tag: nächste Aufgabe, Verspätet, Liegen geblieben,
        Tagesplan, Heute fällig und Eingang; an jedem anderen Tag nur der
        Tagesplan, was an diesem Tag fällig ist, und der Eingang. Die nächste
        Aufgabe folgt derselben Rangfolge und Grenze wie die Startseite.
        """
        tag = self.normalize_due(day) or self.plan_day()
        if geplant is None:
            geplant = self.plan_day_entries(apply_filters=apply_filters, day=tag)
        return glide_today.abschnitte(
            geplant, self.today_view_pool(apply_filters=apply_filters),
            self.plan_inbox_items(apply_filters=apply_filters), tag, date.today().isoformat(),
            rang=self.task_urgency_rank, hoechste_stufe=self.NEXT_TASK_TODAY_RANK)

    def update_today_plan(self, item_ids, add=None, day=None):
        """Trägt den Bearbeitungstag ein oder nimmt ihn weg.

        Der Tag ist der gerade betrachtete; außerhalb der Ansicht ist es heute.
        Fälligkeit, Wiederholung und Erinnerung bleiben unberührt – geplant
        wird, wann gearbeitet wird, nicht wann etwas fällig ist.
        """
        ziel = self.normalize_due(day) or (
            self.plan_day() if self.view_mode == self.PLAN_DAY_VIEW else date.today().isoformat())
        candidates = []
        for item_id in item_ids or ():
            found = self.find_item_in_lists(item_id)
            if found and self.is_schedulable_item(found[0]) and item_id not in candidates:
                candidates.append(item_id)
        if not candidates:
            return "break"
        geplant = {item_id for item_id in candidates
                   if self.normalize_due(self.find_item_in_lists(item_id)[0].get("planned_date")) == ziel}
        if add is None:
            add = len(geplant) < len(candidates)
        wert = ziel if add else None
        betroffen = [item_id for item_id in candidates
                     if (item_id in geplant) != bool(add)]
        if not betroffen:
            return "break"
        with self.item_change(betroffen, restore=False, update_sidebar=True, local=True) as change:
            for item_id in betroffen:
                found = self.find_item_in_lists(item_id)
                if found:
                    found[0]["planned_date"] = wert
            change.mark()
        return "break"

    def clear_today_plan(self, day=None):
        """Nimmt allen Aufgaben des betrachteten Tages den Bearbeitungstag."""
        betroffen = self.today_plan_ids(day=day)
        if not betroffen:
            return "break"
        with self.item_change(betroffen, restore=False, update_sidebar=True, local=True) as change:
            for item_id in betroffen:
                found = self.find_item_in_lists(item_id)
                if found:
                    found[0]["planned_date"] = None
            change.mark()
        return "break"

    def migrate_today_plan_setting(self):
        """Überträgt eine noch gültige 3.21-Tagesauswahl auf den Bearbeitungstag.

        Läuft genau einmal. Ohne sie verlöre eine am selben Tag zusammengestellte
        Auswahl beim Versionswechsel ihren Inhalt – sichtbar für die Person,
        die Glide gerade benutzt hat.
        """
        if self.settings.get("today_plan_migrated"):
            return False
        plan = self.settings.get("today_plan")
        heute = date.today().isoformat()
        ids = plan.get("item_ids") if isinstance(plan, dict) and plan.get("date") == heute else []
        uebernommen = 0
        for item_id in ids if isinstance(ids, list) else []:
            found = self.find_item_in_lists(item_id)
            if found and self.is_schedulable_item(found[0]) and not found[0].get("planned_date"):
                found[0]["planned_date"] = heute
                uebernommen += 1
        self.settings["today_plan_migrated"] = True
        self.settings.pop("today_plan", None)
        self.save_settings()
        if uebernommen:
            self.save_items(show_error=False, record_activity=False)
        return bool(uebernommen)

    def plan_day(self):
        """Der gerade betrachtete Planungstag; ohne Auswahl ist es heute."""
        value = self.normalize_due(getattr(self, "plan_day_value", None))
        return value or date.today().isoformat()

    def plan_day_entries(self, apply_filters=True, day=None):
        """Aufgaben mit Bearbeitungstag am gewählten Tag als Referenzen.

        Maßgeblich ist `planned_date`, nicht die Fälligkeit. Sortiert wird nach
        Wichtigkeit, dann Fälligkeit, dann Titel – die Reihenfolge der
        Übersichten bleibt dieselbe Tupelform wie bei „In Bearbeitung“.
        """
        target = self.normalize_due(day) or self.plan_day()
        return self.render_cached(
            ("plan_day", target, bool(apply_filters),
             self.current_search_query() if apply_filters else "",
             self.get_filter_mode() if apply_filters and hasattr(self, "hide_done_var") else ""),
            lambda: self._collect_plan_day_entries(apply_filters, target),
        )

    def _collect_plan_day_entries(self, apply_filters, target):
        query = self.current_search_query() if apply_filters else ""
        results = []
        for list_index, entry in enumerate(self.planning_lists()):
            for item_index, item in enumerate(self.walk_items(entry.get("items", []))):
                if not self.is_schedulable_item(item):
                    continue
                if self.normalize_due(item.get("planned_date")) != target:
                    continue
                if apply_filters and (
                    not self.item_text_matches_query(item, query)
                    or not self.item_matches_status_filter(item)
                ):
                    continue
                results.append((self.normalize_due(item.get("due")) or "9999-12-31",
                                list_index, item_index, entry, item))
        results.sort(key=lambda value: (
            -self.clamp_importance(value[4].get("importance", 0)),
            value[0],
            str(value[4].get("text") or "").lower(),
        ))
        return results

    def count_plan_day(self):
        return len(self.plan_day_entries(apply_filters=False))

    def plan_day_items(self, apply_filters=False, day=None):
        """Nur die Punktobjekte des Planungstags – Grundlage jeder Summe."""
        return [entry[4] for entry in self.plan_day_entries(apply_filters=apply_filters, day=day)]

    def format_plan_day(self, day=None):
        """Wochentag und Datum des Planungstags, mit Hinweis auf heute."""
        target = self.normalize_due(day) or self.plan_day()
        try:
            parsed = date.fromisoformat(target)
        except ValueError:
            return target
        text = f"{self.WEEKDAY_NAMES[parsed.weekday()]}, {parsed.strftime('%d.%m.%Y')}"
        if target == date.today().isoformat():
            text += " · heute"
        return text

    def plan_day_title(self, day=None):
        """Titel der Tagesansicht: „Heute“ am heutigen Tag, sonst der Tagesplan des Tags (D14)."""
        target = self.normalize_due(day) or self.plan_day()
        if target != date.today().isoformat():
            return f"Tagesplan · {self.format_plan_day(target)}"
        parsed = date.today()
        return f"Heute · {self.WEEKDAY_NAMES[parsed.weekday()]}, {parsed.strftime('%d.%m.%Y')}"

    def count_today_view(self):
        """Zahl hinter „Heute“: alle Aufgaben, die „Heute“ ohne Filter zeigt – ohne den Eingang."""
        heute = date.today().isoformat()
        teile = self.plan_day_sections(apply_filters=False, day=heute)
        return (len(teile.plan) + len(teile.verspaetet) + len(teile.liegen) + len(teile.faellig)
                + (1 if teile.naechste is not None else 0))

    def show_plan_day_mode_menu(self, event=None):
        """„Tag …“ in „Heute“: Tagesbeginn und Tagesabschluss sind Modi dieser Ansicht (D14)."""
        knopf = getattr(self, "plan_day_mode_button", None)
        if knopf is None or not knopf.winfo_exists():
            return "break"
        modi = {"review": self.start_day_review, "close": self.start_day_close,
                "proposal": self.start_day_proposal, "focus": self.start_focus_selected}
        return self.show_option_panel(
            knopf,
            (("review", "Tagesbeginn …", "Überfälliges, Liegengebliebenes und den Eingang Punkt für Punkt entscheiden"),
             ("proposal", "Was passt heute?", "Begründeten Vorschlag für die freie Tageskapazität auswählen"),
             ("focus", "Fokus starten", "Auswahl oder nächste Aufgabe mit pausierbarer Zeiterfassung"),
             ("close", "Tagesabschluss …", "Offen Gebliebenes weitergeben und den Tag in die Tagesnotiz übernehmen")),
            None, lambda schluessel: modi[schluessel]())

    def set_plan_day_view(self, refresh=True, day=None):
        """Öffnet die Tagesplanung; ohne Angabe beim heutigen Tag."""
        self.plan_day_value = self.normalize_due(day) or date.today().isoformat()
        self._activate_system_view(self.PLAN_DAY_VIEW, refresh=refresh)

    def shift_plan_day(self, delta):
        """Schaltet die Tagesplanung um ganze Tage weiter oder zurück."""
        try:
            parsed = date.fromisoformat(self.plan_day())
        except ValueError:
            parsed = date.today()
        self.plan_day_value = (parsed + timedelta(days=int(delta))).isoformat()
        if self.view_mode != self.PLAN_DAY_VIEW:
            return self.set_plan_day_view(day=self.plan_day_value) or "break"
        self.update_window_title()
        self.update_header_title()
        self.update_sidebar_list()
        self.refresh_tree()
        return "break"

    def plan_day_backward(self, event=None):
        return self.shift_plan_day(-1)

    def plan_day_forward(self, event=None):
        return self.shift_plan_day(1)

