        def kachel_mascot(parent):
            """Der Begleiter: ein Blick auf den Tag, keine Bewertung."""
            zustand, satz = self.mascot_state()
            name = self.mascot_name()
            tile = card(parent, name or "Begleiter")
            figur = MascotCanvas(tile, self, size=112)
            figur.pack(pady=(glide_design.SPACING[0], glide_design.SPACING[8]))
            figur.set_state(zustand)
            figur.start()
            self._bind_home_wheel(figur)
            hinweis = label(tile, satz, color="muted")
            self.add_tooltip(figur, satz)
            care = self.mascot_care()
            care_bars = {}
            for key, title, color in (("satiety", "Satt", "confirm"),
                                      ("energy", "Energie", "due_action"),
                                      ("affection", "Vertrauen", "ui_accent")):
                line = tk.Frame(tile, bg=theme["card"])
                line.pack(fill="x", pady=(glide_design.SPACING[2], glide_design.SPACING[0]))
                self._bind_home_wheel(line)
                tk.Label(line, text=title, width=9, anchor="w", bg=theme["card"],
                         fg=theme["muted"], font=app_font(8)).pack(side="left")
                bar = ProgressBar(line, value=care[key], maximum=100, bg_color=theme["card"],
                                  track_color=theme["input"], fill_color=theme[color],
                                  height=7)
                bar.pack(side="left", fill="x", expand=True)
                care_bars[key] = bar

            def react(feed=False, care_action=None):
                if not self.settings.get("mascot_playful", True):
                    return "break"
                figur.react("freut" if feed else "winkt")
                pool = [satz, "Ein Schritt nach dem anderen.", "Ich bin hier, wenn du eine Pause brauchst."]
                if zustand == "sorgt":
                    pool += ["Du entscheidest, was heute dran ist.", "Auch Umplanen ist erlaubt."]
                elif zustand == "freut":
                    pool += ["Zeit, kurz durchzuatmen.", "Das darf sich gut anfühlen."]
                elif zustand == "schlaeft":
                    pool += ["Heute darf es ruhig sein.", "Ich halte hier die Stellung."]
                care_message = self.care_for_mascot(care_action) if care_action else ""
                # Ohne Rahmen: Ein Kasten um den Satz war eine Form ohne
                # Funktion (Aufräumen 27.09.2026).
                hinweis.configure(text=care_message or ("Danke für den kleinen Snack!" if feed else random.choice(pool)))
                if care_action:
                    # Bis 3.28 wurde nach jeder Pflegeaktion die gesamte
                    # Startseite zerstört und neu aufgebaut. Besonders im
                    # Dopamin-Design legte das während der vielen Canvas-
                    # Animationen kurz die native Fensterfläche frei: ein
                    # sichtbarer weißer Blitz. Nur die drei tatsächlich
                    # geänderten Balken werden jetzt aktualisiert; Gismo geht
                    # nach der Reaktion lokal in seinen Ausgangszustand zurück.
                    for key, value in self.mascot_care().items():
                        bar = care_bars.get(key)
                        if bar is not None and bar.winfo_exists():
                            bar.set_value(value)

                    def settle_reaction():
                        try:
                            if figur.winfo_exists():
                                figur.set_state(zustand)
                        except tk.TclError:
                            pass

                    self.root.after(900, settle_reaction)
                return "break"

            def beruehren(_event=None):
                return react()

            def streicheln(_event=None):
                if self.settings.get("mascot_playful", True):
                    figur.react("freut", schritte=5)

            for sequenz in ("<Button-1>", "<Return>", "<space>"):
                figur.bind(sequenz, beruehren)
            figur.bind("<Enter>", streicheln)
            figur.bind("<Leave>", lambda _event: figur.set_state(zustand))

            def toggle_play():
                before = self.settings.get("mascot_playful", True)
                self.settings["mascot_playful"] = not before
                if self.save_settings():
                    self.refresh_home()
                else:
                    self.settings["mascot_playful"] = before

            # U05r (3.33.21): Pflege und Einstellungen erscheinen beim
            # Überfahren der Kachel oder wenn die Tastatur in ihr steht; in Ruhe
            # zeigt sie nur Figur, Satz und Balken. Die Leiste liegt über den
            # Balken: Die Kachel behält ihre Höhe, nichts springt, und die
            # Startseite baut dafür nicht neu.
            pflege = ButtonFlow(tile, bg=theme["card"])
            self._bind_home_wheel(pflege)
            if self.settings.get("mascot_playful", True):
                action(pflege, "Füttern", lambda: react(feed=True, care_action="feed"), "muted")
                action(pflege, "Spielen", lambda: react(care_action="play"), "muted")
                action(pflege, "Ruhen", lambda: react(care_action="rest"), "muted")
            action(pflege, "Spielereien aus" if self.settings.get("mascot_playful", True) else "Spielereien an",
                   toggle_play, "muted")
            action(pflege, "Benennen …", self.rename_mascot, "muted")
            self._mascot_care_bar = pflege

            def in_kachel(widget):
                while widget is not None:
                    if widget is tile:
                        return True
                    widget = getattr(widget, "master", None)
                return False

            def zeigen(_event=None):
                try:
                    if pflege.winfo_exists() and pflege.winfo_manager() != "place":
                        pflege.place(in_=tile, relx=0, rely=1, anchor="sw", relwidth=1)
                        pflege.lift()
                except tk.TclError:
                    pass

            def verbergen_pruefen():
                try:
                    if not pflege.winfo_exists():
                        return
                    unter = tile.winfo_containing(*tile.winfo_pointerxy())
                    fokus = tile.focus_get()
                except (tk.TclError, KeyError):
                    unter = fokus = None
                if not in_kachel(unter) and not in_kachel(fokus):
                    pflege.place_forget()

            def verbergen(_event=None):
                self._register_after(self.root.after(80, verbergen_pruefen))

            def anbinden(widget):
                widget.bind("<Enter>", zeigen, add="+")
                widget.bind("<Leave>", verbergen, add="+")
                widget.bind("<FocusIn>", zeigen, add="+")
                widget.bind("<FocusOut>", verbergen, add="+")
                for kind in widget.winfo_children():
                    anbinden(kind)
            anbinden(tile)

