def defer_window_menu_commands():
    """Jeder Menübefehl läuft erst, wenn das Menü geschlossen ist.

    Befund R11 (29.09.2026): Unter macOS führt Tk einen Menübefehl aus, während
    das Menü noch verfolgt wird. Öffnet der Befehl dann die Dateiauswahl oder
    einen Dialog, kann das still scheitern. Damals wurden nur Einträge mit „…“
    verschoben.

    Hänger vom 29. und 30.09.2026 (macOS-Berichte, 8,5 s ohne Rückmeldung, dann
    Zwangsbeenden): „Hilfe › Über Glide“ trägt kein „…“, öffnet aber ein
    modales Fenster. Dessen `wait_window` lief innerhalb der Menüverfolgung
    von macOS (`NSMenuTrackingSession … _performPostTrackingDismissalActions`)
    und bekam nie wieder Ereignisse, weil macOS auf die Rückkehr des
    Menübefehls wartete. Deshalb gilt die Regel seit 3.32.0 für jeden Befehl
    (`add_command`, `insert_command`), in der Menüleiste wie in Kontextmenüs:
    Er kehrt sofort zurück, die Arbeit folgt im nächsten Leerlauf. Häkchen und
    Auswahlpunkte bleiben unmittelbar: Sie setzen nur Werte, und die
    Auswahlfelder der Dialoge (`tk.OptionMenu`) verlassen sich darauf.
    """
    if getattr(tk.Menu, "_glide_defers_windows", False):
        return

    def aufschieben(menu, optionen):
        befehl = optionen.get("command")
        if callable(befehl) and not getattr(befehl, "_glide_aufgeschoben", False):
            # Am Hauptfenster aufhängen: Kontextmenüs werden oft direkt nach
            # dem Klick zerstört, und mit ihnen ihre ausstehenden Aufrufe.
            def spaeter(b=befehl, m=menu):
                m._root().after_idle(b)
            spaeter._glide_aufgeschoben = True
            optionen["command"] = spaeter
        return optionen

    def huelle(original):
        def hinzufuegen(self, cnf=None, **kw):
            return original(self, aufschieben(self, dict(cnf or {}, **kw)))
        return hinzufuegen

    def huelle_einfuegen(original):
        def einfuegen(self, index, cnf=None, **kw):
            return original(self, index, aufschieben(self, dict(cnf or {}, **kw)))
        return einfuegen

    tk.Menu.add_command = huelle(tk.Menu.add_command)
    tk.Menu.insert_command = huelle_einfuegen(tk.Menu.insert_command)
    tk.Menu._glide_defers_windows = True

defer_window_menu_commands()


def bytecode_cache_dir():
    """Bytecode-Cache im Cacheordner des Systems – derselbe wie im Schnellstart.

    Seit 29.09.2026 (Entscheidung 9 der Prüfung vom 28.09.2026) setzt Glide ihn
    auch beim direkten Start von `app.pyw` selbst. Vorher legte Python dann
    `__pycache__` neben die Module – in den synchronisierten Ablageordner und
    in ein signiertes Bundle, wo nichts hinzukommen darf. Ein gepacktes
    Programm (PyInstaller) bringt seinen Bytecode mit und braucht das nicht.
    """
    if sys.platform == "darwin":
        basis = os.path.expanduser("~/Library/Caches/Glide")
    elif os.name == "nt":
        basis = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"), "Glide", "Cache")
    else:
        basis = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "glide")
    return os.path.join(basis, "bytecode")


if not sys.pycache_prefix and not getattr(sys, "frozen", False):
    sys.pycache_prefix = bytecode_cache_dir()
