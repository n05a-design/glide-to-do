    def action_feedback_level(self):
        """Wie viel Rückmeldung gerade erwünscht ist: „milestones“ oder „all“."""
        wert = self.settings.get("action_feedback", self.ACTION_FEEDBACK_DEFAULT)
        if wert not in self.ACTION_FEEDBACK_KEYS:
            wert = self.ACTION_FEEDBACK_DEFAULT
        if wert == "auto":
            return "all" if self.arcade_mode() else "milestones"
        return wert

    def feedback(self, key, count=1, milestone=False):
        """Kurze Rückmeldung zu einer abgeschlossenen Aktion.

        `milestone=True` steht für das, was auch bisher immer gemeldet wurde –
        Erledigtes und erreichte Ziele. Alles andere hängt an der Stufe.
        Unbekannte Schlüssel bleiben still, statt einen Fehler zu werfen: Eine
        Rückmeldung darf eine Aktion nie scheitern lassen.
        """
        if not self.animations_enabled():
            return
        if not milestone and self.action_feedback_level() != "all":
            return
        eintrag = self.ACTION_FEEDBACK_TEXTS.get(key)
        if not eintrag:
            return
        symbol, einzahl, mehrzahl = eintrag
        anzahl = max(1, int(count or 1))
        text = einzahl if anzahl == 1 else mehrzahl.format(n=anzahl)
        self.play_celebration(f"{self.ICONS.get(symbol, self.ICONS['check'])}  {text}")

    UNDO_TOAST_MS = 6000

    def show_undo_toast(self, text, restore=None):
        """Hinweis mit „Rückgängig“ nach einer Aktion, die man leicht bereut.

        Unabhängig von Animationen: Er ist Bedienung, nicht Dekoration. Er
        nimmt nur zurück, was er meldet – ist inzwischen eine weitere Änderung
        erfolgt, verschwindet er, statt eine andere Aktion rückgängig zu machen.
        """
        if not hasattr(self, "main_area") or (restore is None and not self.undo_stack):
            return None
        self.hide_undo_toast()
        depth = len(self.undo_stack)
        toast = tk.Frame(self.main_area, bg=self.theme["card"], highlightthickness=1,
                         highlightbackground=self.theme["line"])
        tk.Label(toast, text=text, bg=self.theme["card"], fg=self.theme["text"], font=app_font(10)).pack(
            side="left", padx=(14, 10), pady=8)

        def undo():
            # Eine eigene Wiederherstellung gilt für Ansichtsänderungen, die
            # nicht im Rückgängig-Stapel stehen (etwa Pinnwandkarten).
            self.hide_undo_toast()
            if restore is not None:
                restore()
            elif len(self.undo_stack) == depth:
                self.undo_last_change()

        button = self._make_dialog_button(toast, "Rückgängig", undo, "accent", width=110, height=30)
        button.pack(side="left", padx=(0, 8), pady=6)
        toast.place(relx=0.5, rely=1.0, anchor="s", y=-14)
        toast.lift()
        self._undo_toast = {"frame": toast, "depth": depth, "button": button, "job": None}
        paused = {"on": False}

        def expire():
            state = getattr(self, "_undo_toast", None)
            if state is None or state["frame"] is not toast:
                return
            if paused["on"]:
                state["job"] = self.root.after(1000, expire)
                return
            self.hide_undo_toast()

        toast.bind("<Enter>", lambda _event: paused.update(on=True))
        toast.bind("<Leave>", lambda _event: paused.update(on=False))
        self._undo_toast["job"] = self.root.after(self.UNDO_TOAST_MS, expire)
        return toast

    def hide_undo_toast(self):
        state = getattr(self, "_undo_toast", None)
        self._undo_toast = None
        if not state:
            return
        if state.get("job") is not None:
            try:
                self.root.after_cancel(state["job"])
            except tk.TclError:
                pass
        try:
            state["frame"].destroy()
        except tk.TclError:
            pass

    def undo_toast_valid(self):
        """Solange nichts Neues dazukam, gilt der Hinweis."""
        state = getattr(self, "_undo_toast", None)
        return bool(state) and len(self.undo_stack) == state["depth"]

    def feedback_for_changes(self, before):
        """Gemeinsame Mutationswege geben auch über unterschiedliche UI-Zugänge dieselbe Rückmeldung."""
        if self.action_feedback_level() != "all" or not self.animations_enabled():
            return
        events = self.history_events(before, getattr(self, "_history_baseline", None))
        if any(event['action'] == 'done' for event in events):
            return  # Erledigungen werden bereits einmal durch record_completions gemeldet.
        keys = []
        for event in events:
            action = event['action']
            if action in ('moved', 'restored', 'reopened'):
                keys.append(action)
            elif action in ('updated', 'renamed'):
                fields = set(event.get('fields', []))
                key = 'edited'
                for field, candidate in (('labels', 'labelled'), ('due', 'due_set'), ('planned_date', 'planned')):
                    if self.HISTORY_FIELD_NAMES.get(field, field) in fields:
                        key = candidate
                        break
                keys.append(key)
        if keys:
            self.feedback(keys[0] if len(set(keys)) == 1 else 'edited', len(keys))

    # Die Rückmeldung im Dopamin-Design. Gestapelt heißt:
    # mehrere Fahnen gleichzeitig, leicht versetzt gestartet und versetzt
    # gestellt, sodass sie sich überlagern und nacheinander verschwinden –
    # der Arcade-Eindruck entsteht aus der Wiederholung, nicht aus einer
    # einzelnen, größeren Fahne. Die Zahl ist bewusst begrenzt: Jede Fahne
    # ist ein Tk-Widget mit eigener Zeitschleife.
    CELEBRATION_STACK = 5
    CELEBRATION_STACK_DELAY = 70
    CELEBRATION_ARCADE_COLORS = ("confirm", "flag", "ui_accent", "due_action", "accent")

    def play_celebration(self, text):
        """Kurze, sich auflösende Rückmeldung über dem Arbeitsbereich.

        . Bewusst schmal gehalten: ein Wort, eine halbe
        Sekunde, keine Interaktion. Die Anzeige liegt als `place`-Element über
        dem vorhandenen Aufbau und ändert weder Größe noch Reihenfolge eines
        Fensters.

        Sie läuft in jedem Design, sofern die
        Einstellung sie erlaubt. Im Dopamin-Design wird aus der einen Fahne
        ein Stapel aus mehreren, die versetzt starten, in wechselnden Farben
        stehen und nach oben davonziehen.
        """
        if not self.animations_enabled() or not hasattr(self, "shell"):
            return
        arcade = self.arcade_mode()
        anzahl = self.CELEBRATION_STACK if arcade else 1
        for lauf in range(anzahl):
            verzoegerung = lauf * self.CELEBRATION_STACK_DELAY
            if not verzoegerung:
                self._draw_celebration(text, lauf, arcade)
                continue
            try:
                self._register_after(self.root.after(
                    verzoegerung,
                    lambda nummer=lauf: self._draw_celebration(text, nummer, arcade)))
            except tk.TclError:
                return

    def _draw_celebration(self, text, nummer=0, arcade=False):
        """Eine einzelne Fahne des Stapels.

        Sie steigt seit dem 27.09.2026 vom unteren Rand des Arbeitsbereichs
        auf, über dem Rückgängig-Hinweis. Vorher stand sie oben mittig – genau
        über dem Suchfeld: macOS zeichnete das Eingabefeld samt Schreibmarke
        darüber, und die Fahne erschien abgeschnitten und durchgestrichen.
        """
        flaeche = getattr(self, "main_area", None)
        if flaeche is None or not flaeche.winfo_exists():
            return
        grundfarbe = self.theme[self.CELEBRATION_ARCADE_COLORS[
            nummer % len(self.CELEBRATION_ARCADE_COLORS)]] if arcade else self.theme["confirm"]
        # Jede weitere Fahne des Stapels ist etwas kleiner und steht etwas
        # weiter außen: So bleibt die erste lesbar und die übrigen wirken als
        # Nachhall statt als Verdeckung.
        groesse = 15 - nummer if arcade else 13
        try:
            banner = tk.Label(flaeche, text=text, bg=self.theme["card"],
                              fg=grundfarbe, font=app_font(max(10, groesse), "bold"),
                              padx=16, pady=8, bd=0, highlightthickness=2 if arcade else 1,
                              highlightbackground=grundfarbe)
        except tk.TclError:
            return
        schritte = 18 if arcade else 14
        versatz = ((nummer % 2) * 2 - 1) * 0.045 * nummer if arcade else 0.0
        strecke = 60 if arcade else 36
        hinweis = (getattr(self, "_undo_toast", None) or {}).get("frame")
        try:
            sockel = 14 + (hinweis.winfo_reqheight() + 10 if hinweis is not None and hinweis.winfo_exists() else 0)
        except tk.TclError:
            sockel = 14

        def zeichnen(schritt=0):
            if not banner.winfo_exists():
                return
            if schritt >= schritte:
                banner.destroy()
                return
            anteil = schritt / schritte
            banner.place(relx=max(0.08, min(0.92, 0.5 + versatz)), rely=1.0,
                         y=-(sockel + round(anteil * strecke)), anchor="s")
            banner.lift()
            # Die Farbe wandert zur Flächenfarbe hin: ein Ausblenden ohne
            # echte Transparenz, die Tk auf allen Plattformen nicht bietet.
            banner.configure(fg=mix_hex_colors(grundfarbe, self.theme["card"], anteil ** 2))
            if arcade:
                # Der Rand pulst gegenläufig zur Schrift: Das ist die
                # Blinkfrequenz, die eine Arcade-Anzeige ausmacht.
                puls = self.CELEBRATION_ARCADE_COLORS[(nummer + schritt // 2) % len(self.CELEBRATION_ARCADE_COLORS)]
                try:
                    banner.configure(highlightbackground=mix_hex_colors(
                        self.theme[puls], self.theme["card"], anteil))
                except tk.TclError:
                    pass
            try:
                self._register_after(self.root.after(34 if arcade else 38,
                                                     lambda: zeichnen(schritt + 1)))
            except tk.TclError:
                banner.destroy()

        zeichnen()

    @staticmethod
    def default_template_records():
        resource = os.path.join(os.path.dirname(__file__), "resources", "templates", "glide_vorlagen.glidetemplates")
        try:
            with open(resource, "r", encoding="utf-8") as file:
                records = ListApp.normalize_template_records(json.load(file))
            ids = {entry.get("id") for entry in records}
            for entry in ListApp.legacy_template_records():
                if str(entry.get("id") or "").startswith("journal-") and entry.get("id") not in ids:
                    records.append(copy.deepcopy(entry))
            return records
        except (OSError, ValueError, TypeError):
            pass
        return ListApp.legacy_template_records()

