    # ------------------------------------------------------------------
    # Präsentationsmodus (3.30, MO-080 – erste Stufe)
    #
    # Die Bereiche der Pinnwand werden zu Folien, im Vollbild der Seiten-
    # anzeige. Pfeiltasten, Leertaste und Bild auf/ab blättern, Escape endet.
    # Der Zoom der Pinnwand wird nur geliehen und danach zurückgegeben.
    # ------------------------------------------------------------------
    PRESENTATION_ZOOMS = (50, 75, 100, 125, 150, 200)

    def presentation_active(self):
        return bool(getattr(self, "_presentation", None))

    def start_presentation(self):
        app = self.app
        if self.board()["layout"] != "free" or not self.area_list():
            app.show_info("Präsentieren", "Die Präsentation zeigt die Bereiche der Pinnwand als Folien. "
                                          "Zuerst in der Anordnung „Frei anordnen“ einen Bereich anlegen.")
            return "break"
        eigener_fokus = not self.board_focus_active()
        if eigener_fokus:
            self.enter_board_focus()
        self._presentation = {"index": 0, "zoom": self.board().get("zoom", 100), "own_focus": eigener_fokus}
        self.show_presentation_slide(0)
        return "break"

    def presentation_fit_zoom(self, area):
        canvas = self.canvas
        breite, hoehe = max(200, canvas.winfo_width() - 64), max(160, canvas.winfo_height() - 96)
        passend = [zoom for zoom in self.PRESENTATION_ZOOMS
                   if area["w"] * zoom / 100 <= breite and area["h"] * zoom / 100 <= hoehe]
        return max(passend) if passend else self.PRESENTATION_ZOOMS[0]

    def show_presentation_slide(self, index):
        zustand = getattr(self, "_presentation", None)
        bereiche = self.area_list()
        if not zustand or not bereiche:
            return "break"
        index = max(0, min(len(bereiche) - 1, index))
        zustand["index"] = index
        area = bereiche[index]
        zoom = self.presentation_fit_zoom(area)
        if self.board().get("zoom", 100) != zoom:
            scope = self.context()

            def change():
                board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
                board["zoom"] = zoom
            self.save_view_change(change)
        self.selected_area = area["id"]
        self.selected_ids, self.selected_id = [], None
        self._signature = None
        self.refresh()
        self.draw_board()
        canvas = self.canvas
        canvas.update_idletasks()
        faktor = zoom / 100
        region = tuple(map(float, canvas.tk.splitlist(canvas.cget("scrollregion")))) or (0, 0, 1, 1)
        gesamt_b, gesamt_h = max(1.0, region[2]), max(1.0, region[3])
        mitte_x = (area["x"] + area["w"] / 2) * faktor - canvas.winfo_width() / 2
        mitte_y = (area["y"] + area["h"] / 2) * faktor - canvas.winfo_height() / 2
        canvas.xview_moveto(max(0.0, mitte_x / gesamt_b))
        canvas.yview_moveto(max(0.0, mitte_y / gesamt_h))
        self.draw_presentation_overlay()
        canvas.focus_set()
        return "break"

    def draw_presentation_overlay(self):
        """Die Folienangabe oben rechts im sichtbaren Ausschnitt.

        Gehört zu jedem Aufbau der Fläche: Fokuswechsel und Größenänderung
        zeichnen die Pinnwand neu, und eine nur einmal gezeichnete Angabe
        verschwände dabei.
        """
        canvas = getattr(self, "canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("presentation")
        zustand = getattr(self, "_presentation", None)
        bereiche = self.area_list()
        if not zustand or not bereiche:
            return
        index = max(0, min(len(bereiche) - 1, zustand["index"]))
        canvas.create_text(canvas.canvasx(canvas.winfo_width()) - 18, canvas.canvasy(0) + 16, anchor="ne",
                           text=f"Folie {index + 1} / {len(bereiche)} · {bereiche[index]['name']} · Escape beendet",
                           font=app_font(10, "bold"), fill=self.app.theme["muted"], tags=("presentation",))

    def follow_presentation_overlay(self):
        if self.presentation_active():
            self.draw_presentation_overlay()

    def presentation_step(self, schritt):
        zustand = getattr(self, "_presentation", None)
        if not zustand:
            return "break"
        return self.show_presentation_slide(zustand["index"] + schritt)

    def end_presentation(self):
        zustand = getattr(self, "_presentation", None)
        self._presentation = None
        if not zustand:
            return "break"
        if getattr(self, "canvas", None) is not None and self.canvas.winfo_exists():
            self.canvas.delete("presentation")
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board["zoom"] = zustand["zoom"]
        self.save_view_change(change)
        self.selected_area = None
        self._signature = None
        if zustand.get("own_focus") and self.board_focus_active():
            self.exit_board_focus()
        else:
            self.refresh()
        return "break"

    # ------------------------------------------------------------------
    # Spaltenboard (3.30, PW-010)
    #
    # Eine dritte Anordnung neben „Frei“ und „Geordnet“. Sie zeigt alle
    # Punkte des Bereichs (E-16), nicht nur angeheftete Karten, und ordnet sie
    # nach einem Feld. Ziehen in eine andere Spalte setzt genau dieses Feld –
    # über dieselbe Funktion wie das Gruppieren in Liste und Tabelle.
    # ------------------------------------------------------------------
    COLUMN_HEADER_HEIGHT = 40
    COLUMN_COLLAPSED_WIDTH = 46

    def effective_group_field(self, scope=None):
        scope = scope or self.context() or ""
        field = self.board(scope).get("group_by", "due")
        if field not in self.BOARD_GROUP_KEYS or (field == "list" and scope.startswith("list:")):
            return "due"
        return field

    def column_entries(self, scope=None):
        """Die Punkte des Spaltenboards in Listenreihenfolge, gefiltert wie die Fläche."""
        app = self.app
        board = self.board(scope)
        query = app.current_search_query()
        result = []
        for entry in self.eligible_lists(scope):
            for item in app.walk_items(entry.get("items", [])):
                if not app.is_schedulable_item(item):
                    continue
                if board.get("only_open") and item.get("done"):
                    continue
                if not app.item_text_matches_query(item, query) or not app.item_matches_status_filter(item):
                    continue
                if self.filter_label and self.filter_label not in item.get("labels", []):
                    continue
                result.append((entry, item))
                if len(result) >= self.MAX_CARDS:
                    return result
        return result

    def board_columns(self, scope=None):
        """(Feld, [(Spalte, [(Liste, Punkt)])]) – die Spalten mit ihren Karten."""
        app = self.app
        board = self.board(scope)
        field = self.effective_group_field(scope)
        spalten = app.group_columns(field, self.eligible_lists(scope))
        faecher = {spalte["key"]: [] for spalte in spalten}
        bekannt = app.regular_label_ids()
        for entry, item in self.column_entries(scope):
            # Ein Punkt mit mehreren Labels steht in jeder seiner Labelspalten.
            for key in app.item_group_keys(item, field, entry, known_labels=bekannt):
                if key in faecher:
                    faecher[key].append((entry, item))
        result = [(spalte, faecher[spalte["key"]]) for spalte in spalten]
        if board.get("hide_empty"):
            result = [(spalte, karten) for spalte, karten in result if karten]
        return field, result

    def draw_column_header(self, x, y, width, column, count, closed):
        app, canvas = self.app, self.canvas
        tag = "colhead:" + column["key"]
        hoehe = self.COLUMN_HEADER_HEIGHT
        canvas.create_polygon(rounded_rect_points(x, y, x + width, y + hoehe, 10), smooth=True,
                              fill=app.theme["card"], outline=app.theme["input_border"], width=1,
                              tags=(tag, "columnhead"))
        # Die Farbe der Spalte – aus Label, Wichtigkeit, Fälligkeitszustand
        # oder Liste – als blockiger Balken links, wie ein Kartenstreifen.
        canvas.create_rectangle(x + 6, y + 8, x + 11, y + hoehe - 8, fill=column["color"], outline="",
                                tags=(tag, "columnhead"))
        pfeil = app.ICONS["group"] if closed else app.ICONS["dropdown_closed"]
        if closed:
            canvas.create_text(x + width / 2, y + hoehe / 2, text=str(count), font=app_font(9, "bold"),
                               fill=app.theme["muted"], tags=(tag, "columnhead"))
            return
        canvas.create_text(x + 18, y + hoehe / 2, anchor="w", font=app_font(10, "bold"),
                           fill=app.theme["text"], tags=(tag, "columnhead"),
                           text=self.truncate_lines(column["title"], tkfont.Font(font=app_font(10, "bold")),
                                                    max(40, width - 90), 1))
        canvas.create_text(x + width - 30, y + hoehe / 2, anchor="e", font=app_font(9),
                           fill=app.theme["muted"], text=str(count), tags=(tag, "columnhead"))
        canvas.create_text(x + width - 12, y + hoehe / 2, anchor="e", font=app_font(9),
                           fill=app.theme["muted"], text=pfeil, tags=(tag, "columnhead"))

    COLUMN_STRETCH_MAX = 1.5
    COLUMN_MIN_WIDTH = 220
    COLUMN_SCROLL_RESERVE = 16

    def draw_columns(self):
        app, canvas = self.app, self.canvas
        board = self.board()
        field, spalten = self.board_columns()
        canvas.delete("all")
        self._card_images = []
        self._checklist_hits = []
        self.card_boxes = {}
        self.column_hits = []
        self.column_boxes = {}
        self.column_order = [spalte for spalte, _karten in spalten]
        self._column_field = field
        eingeklappt = set(board.get("collapsed", []))
        gap = self.CARD_GAP
        breite = board["width"]
        # Die offenen Spalten teilen sich die sichtbare Breite: breiter bis
        # zum Anderthalbfachen der Kartenbreite, schmaler bis zur lesbaren
        # Mindestbreite. Vorher stand bei fünf Spalten die letzte halb
        # abgeschnitten am Rand (Rückmeldung 27.09.2026). Erst wenn auch die
        # Mindestbreite nicht reicht, wird quer gescrollt.
        offen = [spalte for spalte, _karten in spalten if spalte["key"] not in eingeklappt]
        try:
            sichtbar = canvas.winfo_width() / max(0.1, self.zoom_factor())
        except tk.TclError:
            sichtbar = 0
        if offen and sichtbar > 1:
            frei = (sichtbar - gap - (len(spalten) - len(offen)) * (self.COLUMN_COLLAPSED_WIDTH + gap)
                    - len(offen) * gap - self.COLUMN_SCROLL_RESERVE)
            anteil = int(frei / len(offen))
            if anteil >= self.COLUMN_MIN_WIDTH:
                breite = min(anteil, int(breite * self.COLUMN_STRETCH_MAX))
        x = gap
        reihenfolge = []
        vorschau = 0
        for spalte, karten in spalten:
            key = spalte["key"]
            zu = key in eingeklappt
            spaltenbreite = self.COLUMN_COLLAPSED_WIDTH if zu else breite
            self.draw_column_header(x, gap, spaltenbreite, spalte, len(karten), zu)
            y = gap + self.COLUMN_HEADER_HEIGHT + 10
            if zu:
                # Eingeklappt bleibt der Name lesbar – Buchstabe für Buchstabe
                # untereinander, wie bei Trello; Tk 8.6 dreht Text nicht überall.
                canvas.create_text(x + spaltenbreite / 2, y + 8, anchor="n",
                                   text="\n".join(spalte["title"][:14]), font=app_font(8, "bold"),
                                   fill=app.theme["muted"], tags=("colhead:" + key, "columnhead"))
                y += 14 * min(14, len(spalte["title"])) + 16
            else:
                for entry, item in karten:
                    identity = item["id"]
                    blocks, hoehe = self.card_blocks(item, entry, spaltenbreite,
                                                     preview_allowed=vorschau < self.PREVIEW_LIMIT)
                    vorschau += 1
                    vorkommen = f"occ:{len(self.column_hits)}"
                    self.draw_card(x, y, spaltenbreite, hoehe, blocks, item, identity in self.selected_ids,
                                   extra_tag=vorkommen)
                    box = (x, y, spaltenbreite, hoehe)
                    self.column_hits.append((box, identity, key, vorkommen))
                    self.card_boxes.setdefault(identity, box)
                    if identity not in reihenfolge:
                        reihenfolge.append(identity)
                    y += hoehe + gap
                if not karten:
                    grund = spalte.get("reason") if not spalte.get("settable") else None
                    canvas.create_text(x + 12, y, anchor="nw", width=spaltenbreite - 24, font=app_font(9),
                                       fill=app.theme["muted"],
                                       text=grund or "Keine Karten. Hierher ziehen setzt „" + spalte["title"] + "“.")
                    y += 48
            self.column_boxes[key] = (x, gap, spaltenbreite, max(y, gap + 240) - gap)
            x += spaltenbreite + gap
        self.card_ids = reihenfolge
        self.selected_ids = [identity for identity in self.selected_ids if identity in self.card_ids]
        if self.selected_id not in self.card_ids:
            self.selected_id = self.selected_ids[-1] if self.selected_ids else None
        if self.selected_id and not self.selected_ids:
            self.selected_ids = [self.selected_id]
        if not spalten:
            canvas.create_text(24, 24, anchor="nw", font=app_font(12), fill=app.theme["muted"],
                               width=max(200, canvas.winfo_width() - 48),
                               text="Keine Spalten – „Leere Spalten ausblenden“ ist an und nichts passt zum Filter.")
        for element in canvas.find_all():
            tags = canvas.gettags(element)
            layer = "labels" if canvas.type(element) == "text" else "cards"
            canvas.addtag_withtag("layer:" + layer, element)
        self.scale_board_view()
        faktor = self.zoom_factor()
        if faktor != 1:
            self.column_hits = [(tuple(value * faktor for value in box), identity, key, tag)
                                for box, identity, key, tag in self.column_hits]
            self.column_boxes = {key: tuple(value * faktor for value in box)
                                 for key, box in self.column_boxes.items()}
        self.update_scrollregion()
        self.draw_navigator()

    def column_hit(self, x, y):
        for box, identity, key, tag in reversed(getattr(self, "column_hits", [])):
            if box[0] <= x <= box[0] + box[2] and box[1] <= y <= box[1] + box[3]:
                return identity, key, box, tag
        return None

    def column_key_at(self, x):
        halb = self.CARD_GAP * self.zoom_factor() / 2
        for key, (left, _top, width, _height) in getattr(self, "column_boxes", {}).items():
            if left - halb <= x <= left + width + halb:
                return key
        return None

    def column_header_at(self, x, y):
        hoehe = self.COLUMN_HEADER_HEIGHT * self.zoom_factor()
        for key, (left, top, width, _height) in getattr(self, "column_boxes", {}).items():
            if left <= x <= left + width and top <= y <= top + hoehe:
                return key
        return None

    def column_spec(self, key):
        return next((spalte for spalte in getattr(self, "column_order", []) if spalte["key"] == key), None)

    def toggle_column(self, key):
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            zu = list(board.get("collapsed", []))
            if key in zu:
                zu.remove(key)
            else:
                zu.append(key)
            board["collapsed"] = zu[-100:]
        if self.save_view_change(change):
            self._signature = None
            self.draw_board()
        return "break"

    def column_press(self, event):
        app = self.app
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        self._column_drag = None
        kopf = self.column_header_at(x, y)
        if kopf is not None:
            return self.toggle_column(kopf)
        treffer = self.column_hit(x, y)
        self.canvas.focus_set()
        if not treffer:
            self.select_card(None)
            return "break"
        identity, key, box, tag = treffer
        self._selected_column = key
        if app.selection_modifier_pressed(event):
            self.select_card(identity, additive=True)
            return "break"
        if identity not in self.selected_ids:
            self.select_card(identity)
        else:
            self.selected_id = identity
        self._column_drag = {"identity": identity, "source": key, "x": x, "y": y, "tag": tag,
                             "dx": 0.0, "dy": 0.0, "moved": False}
        return "break"

    def column_motion(self, event):
        drag = getattr(self, "_column_drag", None)
        if not drag:
            return "break"
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        dx, dy = x - drag["x"], y - drag["y"]
        if not drag["moved"] and abs(dx) + abs(dy) < 5:
            return "break"
        drag["moved"] = True
        self.canvas.move(drag["tag"], dx - drag["dx"], dy - drag["dy"])
        self.canvas.tag_raise(drag["tag"])
        drag["dx"], drag["dy"] = dx, dy
        self.canvas.delete("layer:dropcolumn")
        ziel = self.column_key_at(x)
        if ziel is not None and ziel != drag["source"]:
            left, top, width, height = self.column_boxes[ziel]
            spalte = self.column_spec(ziel) or {}
            farbe = self.app.theme["ui_accent"] if spalte.get("settable", True) else self.app.theme["delete"]
            self.canvas.create_rectangle(left - 4, top - 4, left + width + 4, top + height + 4, outline=farbe,
                                         width=2, dash=(6, 4), tags=("layer:dropcolumn",))
        return "break"

    def column_release(self, event):
        drag = getattr(self, "_column_drag", None)
        self._column_drag = None
        self.canvas.delete("layer:dropcolumn")
        if not drag or not drag["moved"]:
            return "break"
        ziel = self.column_key_at(self.canvas.canvasx(event.x))
        if ziel is None or ziel == drag["source"]:
            self.draw_board()
            return "break"
        self.move_to_column(drag["identity"], drag["source"], ziel)
        return "break"

    def move_to_column(self, identity, source, target):
        """Setzt das Gruppierungsfeld – für die Auswahl, wenn die Karte dazugehört."""
        app = self.app
        kennungen = self.selection() if identity in self.selection() and len(self.selection()) > 1 else [identity]
        spalte = self.column_spec(target)
        if spalte is not None and not spalte.get("settable", True):
            app.show_info("Spaltenboard", spalte.get("reason") or "Diese Spalte nimmt keine Karten an.")
            self.draw_board()
            return False
        geaendert, grund = app.set_group_value(kennungen, self.effective_group_field(), target, source)
        if grund:
            app.show_info("Spaltenboard", grund)
        self._selected_column = target
        self._signature = None
        self.refresh()
        return geaendert

    def move_card_to_neighbour_column(self, step):
        """Alt+Links/Rechts: die Karte in die nächste Spalte, die sie annimmt."""
        if not self.selected_id or not getattr(self, "column_order", None):
            return "break"
        schluessel = [spalte["key"] for spalte in self.column_order]
        quelle = getattr(self, "_selected_column", None)
        eigene = [key for box, identity, key, tag in self.column_hits if identity == self.selected_id]
        if quelle not in eigene:
            quelle = eigene[0] if eigene else None
        if quelle not in schluessel:
            return "break"
        index = schluessel.index(quelle) + step
        while 0 <= index < len(schluessel):
            spalte = self.column_order[index]
            if spalte.get("settable", True):
                feld = self.effective_group_field()
                if self.move_to_column(self.selected_id, quelle, spalte["key"]) and feld != "eisenhower":
                    # H-02r (3.34.0): Ziel und Wirkung sichtbar, ein Rückgängig.
                    # Die Eisenhower-Matrix meldet ihre Felder bereits selbst.
                    gefunden = self.app.find_item_in_lists(self.selected_id)
                    name = dict(self.BOARD_GROUP_FIELDS).get(feld, "Feld")
                    titel = str(gefunden[0].get("text") or "Karte") if gefunden else "Karte"
                    titel = titel if len(titel) <= 40 else titel[:39] + "…"
                    self.app.show_undo_toast(f"„{titel}“ → Spalte „{spalte.get('title', '')}“ · {name} gesetzt")
                self.focus_card(self.selected_id)
                return "break"
            index += step
        return "break"

    def set_board_group_field(self, field):
        if field not in self.BOARD_GROUP_KEYS:
            return "break"
        self.configure_board("group_by", field)
        return "break"

    def create_column_item(self, column_key):
        """Doppelklick in eine Spalte: neuer Punkt mit dem Wert dieser Spalte."""
        app = self.app
        scope = self.context()
        erlaubte = self.eligible_lists(scope)
        spalte = self.column_spec(column_key)
        if not erlaubte or spalte is None:
            return "break"
        feld = self.effective_group_field(scope)
        if feld == "list":
            vorgabe = column_key
        elif scope.startswith("list:"):
            vorgabe = scope.split(":", 1)[1]
        else:
            eingang = next((entry for entry in erlaubte if app.is_inbox_list(entry)), None)
            vorgabe = (eingang or erlaubte[0]).get("id")
        with app.modal_over(None):
            details = app.new_item_dialog(
                "Neuer Punkt im Spaltenboard",
                f"Der Punkt entsteht in der Spalte „{spalte['title']}“.",
                allow_list_choice=feld != "list" and not scope.startswith("list:"),
                default_list_id=vorgabe, allowed_list_ids={entry["id"] for entry in erlaubte})
        if details is None:
            return "break"
        neu = app.build_item_from_dialog(details)
        ziel = next((entry for entry in erlaubte if entry.get("id") == (details.get("list_id") or vorgabe)), None)
        if neu is None or ziel is None:
            return "break"
        with app.item_change((), restore=False, update_sidebar=True) as change:
            ziel.setdefault("items", []).append(neu)
            change.mark()
        if change.saved is False:
            return "break"
        if feld != "list" and spalte.get("settable", True):
            aktuell = app.item_group_keys(neu, feld, ziel)
            if column_key not in aktuell:
                app.set_group_value([neu["id"]], feld, column_key, aktuell[0] if aktuell else None)
        self.selected_id = neu["id"]
        self.selected_ids = [neu["id"]]
        self._signature = None
        self.refresh()
        return "break"

    # ------------------------------------------------------------------
    # Karteninhalt (3.30, PW-020) und Zeichnungskarten (ZF-100)
    # ------------------------------------------------------------------
    CARD_DESCRIPTION_CHARS = 160
    CARD_CHECKLIST_STEPS = 5
    CARD_HEADER_BAND = 14

    def card_show(self, card, key):
        board = self.board()
        vorgabe = {"description": board.get("show_description", True),
                   "checklist": board.get("show_checklist", False),
                   "image": board.get("preview", True)}[key]
        eigen = card.get("show", {}) if isinstance(card, dict) else {}
        return eigen.get(key, vorgabe) if isinstance(eigen, dict) else vorgabe

    def set_card_show(self, key, value):
        """Übersteuert den Inhalt der ausgewählten Karten (None = wie die Pinnwand)."""
        kennungen = set(self.selection())
        if not kennungen or key not in self.CARD_SHOW_KEYS:
            return "break"
        scope = self.context()

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            for card in board["cards"]:
                if card["item_id"] not in kennungen:
                    continue
                eigen = dict(card.get("show") or {})
                if value is None:
                    eigen.pop(key, None)
                else:
                    eigen[key] = bool(value)
                if eigen:
                    card["show"] = eigen
                else:
                    card.pop("show", None)
        if self.save_view_change(change):
            self._signature = None
            self.draw_board()
        return "break"

    def card_accent(self, item):
        """Farbschlüssel oder Farbwert des Kartenakzents nach Kartenfarbquelle."""
        app = self.app
        if self.board().get("color_source") == "label":
            bekannt = app.regular_label_ids()
            erstes = next((app.get_label(value) for value in item.get("labels", []) or [] if value in bekannt), None)
            if erstes is not None:
                return app.label_color(erstes)
        schluessel = item.get("color") if item.get("color") in app.ITEM_COLOR_KEYS else app.kind_color_key(
            app.item_kind(item))
        return app.theme[schluessel]

    def page_preview(self, entry, width):
        """Miniatur einer Zeichnungsseite mit fester Obergrenze und Revisionsschlüssel."""
        app = self.app
        ziel = max(32, min(self.PAGE_PREVIEW_MAX, int(width)))
        schluessel = ("page", entry.get("id"), app.drawing_history_hash(entry), ziel)
        cache = self._preview_cache
        if schluessel in cache:
            return cache[schluessel]
        try:
            modell = glide_drawing.DrawingModel.from_document(entry.get("drawing"))
            bild = glide_drawing_image.thumbnail_photo(modell, ziel, master=app.root)
        except (glide_drawing.DrawingFormatError, tk.TclError, ValueError):
            return None
        if len(cache) > 120:
            cache.clear()
        cache[schluessel] = bild
        return bild

    def page_card_blocks(self, entry, width, faktor=1.0):
        app = self.app
        inner = max(60, width - 2 * self.CARD_PAD)
        titel_font = tkfont.Font(font=app_font(max(9, min(16, int(round(11 * faktor)))), "bold"))
        klein = tkfont.Font(font=app_font(8))
        blocks = []
        titel = self.truncate_lines(f"{app.ICONS['drawing']}  {entry.get('title') or 'Zeichnung'}",
                                    titel_font, inner, 2)
        blocks.append({"art": "text", "text": titel, "font": titel_font, "farbe": app.theme["text"],
                       "hoehe": titel_font.metrics("linespace") * (titel.count("\n") + 1), "abstand": 6})
        bild = self.page_preview(entry, inner)
        if bild is not None:
            blocks.append({"art": "bild", "bild": bild, "hoehe": bild.height(), "abstand": 6, "rahmen": True})
        groesse = (entry.get("drawing") or {}).get("width") or 128
        blocks.append({"art": "text", "text": f"Zeichnung · {groesse} × {groesse}", "font": klein,
                       "farbe": app.theme["muted"], "hoehe": klein.metrics("linespace"), "abstand": 0})
        hoehe = 2 * self.CARD_PAD + 6 + sum(block["hoehe"] + block["abstand"] for block in blocks)
        return blocks, max(self.CARD_MIN_HEIGHT, int(hoehe))

    def toggle_card_checklist(self, item_id, index):
        """Abhaken auf der Karte schreibt in die Checkliste des Punkts."""
        app = self.app
        found = app.find_item_in_lists(item_id)
        if not found:
            return False
        item = found[0]
        schritte = item.get("checklist") or []
        if not 0 <= index < len(schritte):
            return False
        with app.item_change([item_id], restore=False) as change:
            schritte[index]["done"] = not schritte[index].get("done")
            change.mark()
        self._signature = None
        self.draw_board()
        return True

    # --- Karteninhalt ------------------------------------------------------
    CARD_PAD = 14
    CARD_GAP = 16
    CARD_MIN_HEIGHT = 96
    PREVIEW_MAX_HEIGHT = 130
    PREVIEW_LIMIT = 60

    def card_preview(self, item, width):
        """Vorschaubild des ersten Bildanhangs oder None.

        Seit 27.09.2026 über `image_preview.py`: unter macOS auch JPEG, HEIC
        und WebP (Tk 9, `nsimage`), überall SVG. Braucht ein Format erst eine
        Umwandlung, zeigt die Karte vorerst nur die Anzahl der Anhänge – die
        Pinnwand wartet nicht auf einen Unterprozess.
        """
        app = self.app
        for attachment in item.get("attachments", []) or []:
            if not glide_image_preview.is_image_name(attachment.get("name")):
                continue
            path = app.resolve_attachment_path(attachment)
            if not path or not os.path.isfile(path) or app.previews.needs_conversion(app.root, path):
                continue
            key = (path, width)
            if key in self._preview_cache:
                return self._preview_cache[key]
            image = app.previews.image(app.root, path, fit=(width, self.PREVIEW_MAX_HEIGHT))
            if image is None:
                continue
            if len(self._preview_cache) > 120:
                self._preview_cache.clear()
            self._preview_cache[key] = image
            return image
        return None

    def card_scale_factor(self, card):
        """Der Größenfaktor einer Karte; unbekannte Werte gelten als „Normal"."""
        wert = card.get("scale") if isinstance(card, dict) else None
        return self.CARD_SCALE_FACTORS.get(wert, 1.0)

    def card_blocks(self, item, source, width, preview_allowed, faktor=1.0, card=None):
        """Beschreibt den Inhalt einer Karte als Folge von Blöcken.

        Die Höhe entsteht aus dem, was tatsächlich auf der Karte steht. Vorher
        war sie fest – eine Aufgabe ohne Beschreibung, Labels und Termin ergab
        dieselbe hohe Fläche wie eine vollständig ausgefüllte.

        Seit 3.30 bestimmt die Pinnwand, was auf ihren Karten steht
        (Beschreibung, Checkliste, Bild); eine Karte kann das übersteuern.
        """
        if item.get("page"):
            return self.page_card_blocks(source, width, faktor)
        app = self.app
        inner = max(60, width - 2 * self.CARD_PAD)
        # Der Maßstab wirkt auf Breite und Titelgröße
        # gemeinsam. Nur die Titelzeile wächst mit – Status, Beschreibung und
        # Fußzeile bleiben lesbar gleich groß, sonst würde eine große Karte
        # bloß grob statt wichtig.
        titelgroesse = max(9, min(16, int(round(11 * faktor))))
        title_font = tkfont.Font(font=app_font(titelgroesse, "bold"))
        small_font = tkfont.Font(font=app_font(9))
        chip_font = tkfont.Font(font=app_font(8, "bold"))
        blocks = []

        def zeile(text, font, farbe, lines=1, abstand=4):
            gekuerzt = self.truncate_lines(text, font, inner, lines)
            if not gekuerzt:
                return
            hoehe = font.metrics("linespace") * (gekuerzt.count("\n") + 1)
            blocks.append({"art": "text", "text": gekuerzt, "font": font, "farbe": farbe,
                           "hoehe": hoehe, "abstand": abstand})

        zeile(app.item_display_text(item), title_font, app.theme["text"], lines=4, abstand=6)
        status = "Gruppe" if app.is_group_item(item) else "Erledigt" if item.get("done") else "Offen"
        importance = app.clamp_importance(item.get("importance", 0))
        status += ("", " · Niedrige Priorität", " · Mittlere Priorität", " · Hohe Priorität")[importance]
        if item.get("due"):
            status += " · " + app.format_due_full(item.get("due"), item.get("due_time"))
        zeile(status, small_font, app.theme["muted"])
        fortschritt = app.checklist_progress(item)
        if fortschritt["total"] and self.card_show(card, "checklist"):
            # Bis zu fünf Schritte, abhakbar wie im Anzeigemodus „Checklisten“.
            zeilen = []
            for index, eintrag in list(enumerate(item.get("checklist") or []))[:self.CARD_CHECKLIST_STEPS]:
                zeilen.append((index, self.truncate_lines(str(eintrag.get("text", "")), small_font, inner - 24, 1),
                               bool(eintrag.get("done"))))
            rest = fortschritt["total"] - len(zeilen)
            blocks.append({"art": "schritte", "zeilen": zeilen, "font": small_font, "rest": rest,
                           "hoehe": 19 * len(zeilen) + (16 if rest > 0 else 0), "abstand": 4})
        elif fortschritt["total"]:
            blocks.append({"art": "fortschritt", "erledigt": fortschritt["done"],
                           "gesamt": fortschritt["total"], "hoehe": 20, "abstand": 4})
        note = " ".join((item.get("description") or "").split())
        if note and self.card_show(card, "description"):
            if len(note) > self.CARD_DESCRIPTION_CHARS:
                note = note[:self.CARD_DESCRIPTION_CHARS - 1].rstrip() + "…"
            zeile(note, small_font, app.theme["text"], lines=3)
        if preview_allowed and self.card_show(card, "image"):
            image = self.card_preview(item, inner)
            if image is not None:
                blocks.append({"art": "bild", "bild": image,
                               "hoehe": image.height(), "abstand": 6})
        labels = app.item_labels(item)
        if labels:
            blocks.append({"art": "labels", "labels": labels[:3], "font": chip_font,
                           "hoehe": 22, "abstand": 4})
        fuss = app.item_display_text(source) if isinstance(source, str) else str(source.get("title", ""))
        if item.get("attachments"):
            fuss = f"{fuss}  ·  {app.ICONS['attachment']} {len(item['attachments'])}"
        zeile(fuss, tkfont.Font(font=app_font(8)), app.theme["muted"], abstand=0)
        band = self.CARD_HEADER_BAND if self.board().get("color_mode") == "header" else 0
        hoehe = 2 * self.CARD_PAD + 6 + band + sum(block["hoehe"] + block["abstand"] for block in blocks)
        return blocks, max(self.CARD_MIN_HEIGHT, int(hoehe))

    def draw_color_marker(self, x, y, color, tags):
        """Kontrastdesigns: zusätzlich zur Farbe eine Form je Farbe (PW-020)."""
        canvas = self.canvas
        form = int(color[1:7], 16) % 6 if isinstance(color, str) and color.startswith("#") else 0
        umriss = self.app.theme["text"]
        punkte = {
            1: (x, y, x + 10, y, x + 10, y + 10, x, y + 10),
            2: (x + 5, y, x + 10, y + 10, x, y + 10),
            3: (x + 5, y, x + 10, y + 5, x + 5, y + 10, x, y + 5),
            4: (x, y, x + 10, y, x + 5, y + 10),
            5: (x, y + 3, x + 10, y + 3, x + 10, y + 7, x, y + 7),
        }.get(form)
        if punkte is None:
            canvas.create_oval(x, y, x + 10, y + 10, fill=color, outline=umriss, tags=tags)
        else:
            canvas.create_polygon(punkte, fill=color, outline=umriss, tags=tags)

    def draw_card(self, x, y, width, height, blocks, item, selected, anker=False, faktor=1.0, extra_tag=None):
        app, canvas = self.app, self.canvas
        tag = "card:" + item["id"]
        # Ein Punkt kann im Spaltenboard mehrfach stehen (mehrere Labels). Die
        # Zusatzmarke meint genau dieses Vorkommen, die Rahmenmarke jeden Rahmen.
        tags = (tag, "card") + ((extra_tag,) if extra_tag else ())
        radius = 14
        modus = self.board().get("color_mode", "stripe")
        akzent = app.theme["ui_accent"] if item.get("page") else self.card_accent(item)
        color = app.theme["selection"] if selected else app.theme["input_border"]
        flaeche = mix_hex_colors(app.theme["card"], akzent, 0.16) if modus == "fill" else app.theme["card"]
        points = (x+radius, y, x+width-radius, y, x+width, y, x+width, y+radius,
                  x+width, y+height-radius, x+width, y+height, x+width-radius, y+height,
                  x+radius, y+height, x, y+height, x, y+height-radius, x, y+radius, x, y)
        canvas.create_polygon(points, smooth=True, splinesteps=24, fill=flaeche,
                              outline=color, width=4 if anker else 3 if selected else 1,
                              tags=tags + ("frame:" + item["id"],))
        band = 0
        if modus == "header":
            band = self.CARD_HEADER_BAND
            unten = y + band + 4
            kopf = (x+radius, y+1, x+width-radius, y+1, x+width-1, y+1, x+width-1, y+radius,
                    x+width-1, unten, x+width-1, unten, x+1, unten, x+1, unten, x+1, y+radius, x+1, y+1)
            canvas.create_polygon(kopf, smooth=True, splinesteps=24, fill=akzent, outline="", tags=tags)
        elif app.is_pixel_design():
            # Pixel-Design: der Akzent als Reihe quadratischer Blöcke.
            kante = max(5, int(round(6 * faktor)))
            links = x + 14
            while links + kante <= x + width - 14:
                canvas.create_rectangle(links, y + 3, links + kante, y + 3 + kante, fill=akzent, outline="",
                                        tags=tags + ("pixelblock",))
                links += kante + 3
        else:
            # Der Akzentstreifen trägt den Maßstab mit. Eine
            # große Karte ist dadurch auch aus der Entfernung als Hauptgedanke zu
            # erkennen, ohne dass Text gelesen werden muss.
            canvas.create_line(x+14, y+5, x+width-14, y+5, width=max(3, int(round(4 * faktor))),
                               capstyle="round", fill=akzent, tags=tags)
        if app.color_mode() == "contrast":
            self.draw_color_marker(x + width - 24, y + 10 + band, akzent, tags)
        cursor = y + self.CARD_PAD + 6 + band
        for block in blocks:
            if block["art"] == "text":
                canvas.create_text(x+self.CARD_PAD, cursor, text=block["text"], font=block["font"],
                                   fill=block["farbe"], anchor="nw", width=width-2*self.CARD_PAD,
                                   tags=tags)
            elif block["art"] == "bild":
                canvas.create_image(x+self.CARD_PAD, cursor, image=block["bild"], anchor="nw",
                                    tags=tags)
                if block.get("rahmen"):
                    # Pixelrahmen um Miniaturen: eine harte, eckige Kante.
                    canvas.create_rectangle(x+self.CARD_PAD-2, cursor-2,
                                            x+self.CARD_PAD+block["bild"].width()+1,
                                            cursor+block["bild"].height()+1,
                                            outline=app.theme["text"], width=2, tags=tags)
                self._card_images.append(block["bild"])
            elif block["art"] == "schritte":
                zeile_y = cursor
                for index, text, erledigt in block["zeilen"]:
                    kasten = (x+self.CARD_PAD, zeile_y+2, x+self.CARD_PAD+13, zeile_y+15)
                    canvas.create_rectangle(*kasten, outline=app.theme["muted"], width=1,
                                            fill=app.theme["confirm"] if erledigt else flaeche, tags=tags)
                    if erledigt:
                        canvas.create_text(kasten[0]+7, kasten[1]+6, text=app.ICONS["check"], font=app_font(8, "bold"),
                                           fill=app.theme["selection_text"], tags=tags)
                    canvas.create_text(x+self.CARD_PAD+20, zeile_y, anchor="nw", text=text, font=block["font"],
                                       fill=app.theme["muted"] if erledigt else app.theme["text"], tags=tags)
                    self._checklist_hits.append(((kasten[0]-2, kasten[1]-2, 18, 18), item["id"], index))
                    zeile_y += 19
                if block["rest"] > 0:
                    canvas.create_text(x+self.CARD_PAD, zeile_y, anchor="nw", font=app_font(8),
                                       fill=app.theme["muted"], text=f"… und {block['rest']} weitere", tags=tags)
            elif block["art"] == "fortschritt":
                gesamt, erledigt = block["gesamt"], block["erledigt"]
                breite = width - 2*self.CARD_PAD
                canvas.create_text(x+self.CARD_PAD, cursor, anchor="nw", font=app_font(8),
                                   fill=app.theme["muted"], tags=tags,
                                   text=f"Checkliste {erledigt} von {gesamt}")
                balken = cursor + 13
                canvas.create_rectangle(x+self.CARD_PAD, balken, x+self.CARD_PAD+breite, balken+5,
                                        fill=app.theme["input"], outline="", tags=tags)
                anteil = int(breite * erledigt / max(1, gesamt))
                if anteil:
                    canvas.create_rectangle(x+self.CARD_PAD, balken, x+self.CARD_PAD+anteil, balken+5,
                                            fill=app.theme["confirm"], outline="", tags=tags)
            elif block["art"] == "labels":
                left = x + self.CARD_PAD
                for label in block["labels"]:
                    remaining = x + width - self.CARD_PAD - left
                    if remaining < 60:
                        break
                    name = self.truncate_lines(label["name"], block["font"], min(160, remaining-18), 1)
                    chip_width = block["font"].measure(name)+16
                    fill, text_color = app.label_chip_colors(label)
                    canvas.create_oval(left, cursor, left+20, cursor+20, fill=fill, outline=fill, tags=tags)
                    canvas.create_oval(left+chip_width-20, cursor, left+chip_width, cursor+20, fill=fill, outline=fill, tags=tags)
                    canvas.create_rectangle(left+10, cursor, left+chip_width-10, cursor+20, fill=fill, outline=fill, tags=tags)
                    canvas.create_text(left+8, cursor+10, text=name, anchor="w", font=block["font"],
                                       fill=text_color, tags=tags)
                    left += chip_width+6
            cursor += block["hoehe"] + block["abstand"]

    def zoom_factor(self):
        return self.board().get("zoom", 100) / 100.0

    def scale_board_view(self):
        """Nur Darstellungsobjekte skalieren; das gespeicherte Modell bleibt logisch."""
        canvas, factor = self.canvas, self.zoom_factor()
        self._zoom_fonts = []
        if factor == 1:
            return
        canvas.scale("all", 0, 0, factor, factor)
        self.card_boxes = {identity: tuple(value*factor for value in box)
                           for identity, box in self.card_boxes.items()}
        self._checklist_hits = [(tuple(value*factor for value in box), identity, index)
                                for box, identity, index in getattr(self, "_checklist_hits", [])]
        images = {str(value): value for value in self._card_images}
        numerator = int(round(factor*4))
        for element in canvas.find_all():
            kind = canvas.type(element)
            if kind == "text":
                font = tkfont.Font(root=canvas, font=canvas.itemcget(element, "font"))
                size = font.actual("size")
                font.configure(size=(1 if size >= 0 else -1)*max(1, round(abs(size)*factor)))
                self._zoom_fonts.append(font)
                canvas.itemconfigure(element, font=font,
                                     width=float(canvas.itemcget(element, "width"))*factor)
            elif kind == "image":
                source = images.get(canvas.itemcget(element, "image"))
                if source is not None:
                    image = source.zoom(numerator).subsample(4)
                    self._card_images.append(image)
                    canvas.itemconfigure(element, image=image)
            if kind in ("line", "polygon", "rectangle", "oval"):
                canvas.itemconfigure(element, width=max(0.5, float(canvas.itemcget(element, "width"))*factor))
            if kind == "line":
                shape = canvas.tk.splitlist(canvas.itemcget(element, "arrowshape"))
                canvas.itemconfigure(element, arrowshape=tuple(float(v)*factor for v in shape))

    def draw_board(self):
        if not self.visible or self.mode != "board" or not getattr(self, "canvas", None) or not self.canvas.winfo_exists():
            return
        app, canvas = self.app, self.canvas
        board = self.board()
        if board["layout"] == "columns":
            return self.draw_columns()
        valid = self.valid_cards()
        cards = [card for card in board["cards"] if card["item_id"] in valid
                 and app.item_text_matches_query(valid[card["item_id"]][1], app.current_search_query())
                 and app.item_matches_status_filter(valid[card["item_id"]][1])
                 and (not self.filter_label or self.filter_label in valid[card["item_id"]][1].get("labels", []))]
        canvas.delete("all")
        self._card_images = []
        self._checklist_hits = []
        self.card_boxes = {}
        self.card_ids = [card["item_id"] for card in cards]
        # Eine Karte, die gerade weggefiltert ist, bleibt gespeichert, fällt
        # aber aus der Auswahl: Sonst träfe die nächste Aktion etwas, das
        # niemand sieht.
        self.selected_ids = [identity for identity in self.selected_ids if identity in self.card_ids]
        if self.selected_id not in self.card_ids:
            # Ist ein Bereich gewählt (3.30), bleibt die Kartenauswahl leer –
            # sonst meinten F2 und Entfernen wieder eine Karte.
            self.selected_id = self.selected_ids[-1] if self.selected_ids else (
                self.card_ids[0] if self.card_ids and not getattr(self, "selected_area", None) else None)
        if self.selected_id and not self.selected_ids:
            self.selected_ids = [self.selected_id]
        self.draw_areas()
        available = max(200, (canvas.winfo_width()-34) / self.zoom_factor())
        gap = self.CARD_GAP
        columns = max(1, int((available+gap) // (board["width"] * 0.9 + gap)))
        width = max(200, (available-(columns-1)*gap) // columns) if board["layout"] == "grid" else board["width"]
        # In der geordneten Ansicht füllt jede Spalte ihre
        # eigene Höhe. Bei gleich hohen Zeilen bestimmte sonst die längste
        # Karte die Höhe aller anderen.
        spalten_hoehen = [gap] * columns
        anker = self.selected_ids[0] if self.selected_ids else None
        for index, card in enumerate(cards):
            identity = card["item_id"]
            source, item = valid[identity]
            faktor = self.card_scale_factor(card)
            # In der geordneten Ansicht bestimmt die Spaltenbreite die Breite
            # aller Karten; der Maßstab wirkt dort allein über die Titelgröße,
            # sonst bräche das Raster auseinander.
            kartenbreite = width if board["layout"] == "grid" else max(160, int(round(width * faktor)))
            blocks, height = self.card_blocks(item, source, kartenbreite,
                                              preview_allowed=index < self.PREVIEW_LIMIT,
                                              faktor=faktor, card=card)
            if board["layout"] == "grid":
                spalte = spalten_hoehen.index(min(spalten_hoehen))
                x = gap + spalte * (width + gap)
                y = spalten_hoehen[spalte]
                spalten_hoehen[spalte] = y + height + gap
            else:
                x, y = card["x"], card["y"]
            self.draw_card(x, y, kartenbreite, height, blocks, item,
                           identity in self.selected_ids, anker=identity == anker, faktor=faktor)
            self.card_boxes[identity] = (x, y, kartenbreite, height)
        self.draw_connections()
        for element in canvas.find_all():
            tags = canvas.gettags(element)
            layer = ("connections" if "connection" in tags else "areas" if "area" in tags
                     else "labels" if canvas.type(element) == "text" else "cards")
            canvas.addtag_withtag("layer:" + layer, element)
        if not cards:
            canvas.create_text(24, 24, anchor="nw", width=max(200, canvas.winfo_width()-48), font=app_font(12), fill=app.theme["muted"],
                               text="Keine Karten für diesen Filter." if board["cards"] else "Die Pinnwand ist leer. Über „Anheften“ vorhandene Inhalte auswählen oder doppelt auf die Fläche klicken.")
            # Leerzustand mit einer Hauptaktion (MO-050).
            text, befehl = (("Filter aufheben", self.find_cards) if board["cards"]
                            else ("Punkte anheften", self.choose_cards))
            knopf = getattr(self, "_empty_board_button", None)
            if knopf is None or not knopf.winfo_exists() or knopf.master is not canvas:
                knopf = self._empty_board_button = app._make_dialog_button(canvas, text, befehl, "confirm",
                                                                           width=180, height=36)
            knopf.command = befehl
            knopf.set_text(text)
            canvas.create_window(24, 84, anchor="nw", window=knopf, tags=("emptyaction",))
            figur = app.empty_state_mascot(canvas, getattr(self, "_empty_board_figure", None), bg_key="bg")
            self._empty_board_figure = figur
            if figur is not None:
                canvas.create_window(24 + 180 + 16, 84 + 18 - app.EMPTY_STATE_MASCOT_SIZE // 2, anchor="nw",
                                     window=figur, tags=("emptyaction",))
        self.scale_board_view()
        # Nach dem Zoom neu rechnen: Die Linien laufen dann wieder genau von
        # Rand zu Rand, und ihre Beschriftung behält die Schriftgröße.
        if self.zoom_factor() != 1:
            self.draw_connections(scaled=True)
        self.update_scrollregion()
        self.draw_background()
        self.draw_connect_handles()
        self.draw_navigator()
        if self.presentation_active():
            self.draw_presentation_overlay()

    def draw_navigator(self):
        """Kleine Übersicht derselben Canvas-Geometrie, ohne eigene Modelldaten."""
        mini = getattr(self, "navigator", None)
        if mini is None or not mini.winfo_exists():
            return
        if not self.board().get("navigator") or not self.card_boxes:
            mini.place_forget()
            return
        mini.place(relx=1.0, rely=1.0, anchor="se", x=-22, y=-22)
        mini.tk.call("raise", mini._w)
        mini.delete("all")
        region = tuple(map(float, self.canvas.tk.splitlist(self.canvas.cget("scrollregion"))))
        if len(region) != 4:
            return
        left, top, right, bottom = region
        factor = min(158/max(1, right-left), 98/max(1, bottom-top))
        self._navigator_transform = (left, top, factor)
        if self.areas_visible():
            zoom = self.zoom_factor()
            for area in self.area_list():
                x, y, width, height = (value * zoom for value in (area["x"], area["y"], area["w"], area["h"]))
                mini.create_rectangle(6+(x-left)*factor, 6+(y-top)*factor,
                                      6+(x+width-left)*factor, 6+(y+height-top)*factor,
                                      outline=self.app.theme.get(area["color"], self.app.theme["clear"]),
                                      tags=("map:area",))
        for x, y, width, height in self.card_boxes.values():
            mini.create_rectangle(6+(x-left)*factor, 6+(y-top)*factor,
                                  6+(x+width-left)*factor, 6+(y+height-top)*factor,
                                  outline=self.app.theme["muted"], tags=("map:card",))
        x, y = self.canvas.canvasx(0), self.canvas.canvasy(0)
        mini.create_rectangle(6+(x-left)*factor, 6+(y-top)*factor,
                              6+(x+self.canvas.winfo_width()-left)*factor,
                              6+(y+self.canvas.winfo_height()-top)*factor,
                              outline=self.app.theme["ui_accent"], width=2, tags=("map:viewport",))

    def navigate_board(self, event):
        transform = getattr(self, "_navigator_transform", None)
        if transform is None:
            return "break"
        left, top, factor = transform
        region = tuple(map(float, self.canvas.tk.splitlist(self.canvas.cget("scrollregion"))))
        x = left + (event.x-6)/factor - self.canvas.winfo_width()/2
        y = top + (event.y-6)/factor - self.canvas.winfo_height()/2
        self.canvas.xview_moveto(max(0, (x-left)/max(1, region[2]-left)))
        self.canvas.yview_moveto(max(0, (y-top)/max(1, region[3]-top)))
        self.draw_navigator()
        return "break"

    # Abstand zwischen Kartenkante und Linienende. Eine
    # Pfeilspitze, die die Karte berührt, liest sich als Teil ihres Rahmens.
    CONNECTION_GAP = 3
    # Kürzer als das ist keine Linie mehr, sondern ein Fleck zwischen zwei
    # überlappenden Karten.
    CONNECTION_MIN_LENGTH = 5

    @staticmethod
    def border_point(box, ziel_x, ziel_y, abstand=0.0):
        """Schnittpunkt der Sichtlinie mit dem Kartenrand.

        Die Linie lief bis 3.24 von Mittelpunkt zu
        Mittelpunkt und lag deshalb zwangsläufig unter beiden Karten – samt
        ihrer Pfeilspitze, die genau dort sitzt. Sichtbar war nur das Stück
        dazwischen, und eine Richtung war nicht zu erkennen. Die Linie endet
        jetzt am Rand der Karte: Dort ist die Spitze frei, und die Frage, ob
        sie vor oder hinter der Karte liegt, stellt sich nicht mehr.
        """
        x, y, breite, hoehe = box
        mitte_x, mitte_y = x + breite / 2.0, y + hoehe / 2.0
        dx, dy = ziel_x - mitte_x, ziel_y - mitte_y
        if not dx and not dy:
            return mitte_x, mitte_y
        halb_x, halb_y = breite / 2.0, hoehe / 2.0
        faktoren = []
        if dx:
            faktoren.append(halb_x / abs(dx))
        if dy:
            faktoren.append(halb_y / abs(dy))
        faktor = min(faktoren)
        laenge = math.hypot(dx, dy) or 1.0
        return (mitte_x + dx * faktor + dx / laenge * abstand,
                mitte_y + dy * faktor + dy / laenge * abstand)

    def draw_connections(self, scaled=False):
        """Zeichnet die Verbindungen zwischen den Kartenrändern.

        Die Linie verbindet die beiden Karten und wird bei
        jedem Aufbau neu berechnet. Deshalb stimmt sie immer – auch nachdem
        eine Karte verschoben, gefiltert oder in der geordneten Ansicht neu
        einsortiert wurde.
        """
        canvas = self.canvas
        # Bis 3.29 blieben beim Ziehen einer Karte die alten Linien stehen:
        # Jede Mausbewegung legte eine weitere darüber. Neu gezeichnet wird
        # deshalb erst nach dem Entfernen der bisherigen.
        canvas.delete("connection")
        canvas.delete("connectsource")
        self._connection_items = {}
        zoom = self.zoom_factor() if scaled else 1.0
        farbe = self.app.theme["muted"]
        betont = self.app.theme["ui_accent"]
        # Die Art entscheidet allein über die Spitzen. Die
        # Linie selbst bleibt die Verbindung der beiden Kartenmittelpunkte und
        # wird bei jedem Aufbau neu gerechnet.
        spitzen = {"line": "none", "forward": "last", "backward": "first", "both": "both"}
        ausgewaehlt = set(self.selected_ids) | ({self.selected_id} if self.selected_id else set())
        gestaltung = {tuple(sorted((entry["from"], entry["to"]))): entry for entry in self.connection_entries()}
        for erste, zweite, art in self.connections():
            eintrag = gestaltung.get(tuple(sorted((erste, zweite))), {})
            links = self.card_boxes.get(erste)
            rechts = self.card_boxes.get(zweite)
            if not links or not rechts:
                # Eine der Karten ist gerade weggefiltert: Die Verbindung
                # bleibt gespeichert, wird aber nicht gezeichnet.
                continue
            mitte_links = (links[0] + links[2] / 2.0, links[1] + links[3] / 2.0)
            mitte_rechts = (rechts[0] + rechts[2] / 2.0, rechts[1] + rechts[3] / 2.0)
            x1, y1 = self.border_point(links, *mitte_rechts, abstand=self.CONNECTION_GAP*zoom)
            x2, y2 = self.border_point(rechts, *mitte_links, abstand=self.CONNECTION_GAP*zoom)
            # Überlappen sich die Karten, liegen beide Randpunkte ineinander.
            # Ein Strich von zwei Pixeln sagt dort nichts und verdeckt Text.
            if math.hypot(x2 - x1, y2 - y1) < self.CONNECTION_MIN_LENGTH*zoom:
                continue
            beteiligt = bool(ausgewaehlt & {erste, zweite})
            breite = 2 if beteiligt else 1
            # Die Spitze darf die Linie nicht überragen: Zwischen zwei
            # nebeneinanderliegenden Karten bleiben wenige Pixel, und eine
            # Spitze in voller Größe wäre dort größer als der Abstand, den sie
            # überbrückt. Sie schrumpft deshalb mit der Linie.
            laenge = math.hypot(x2 - x1, y2 - y1)
            spitze = max(6.0, min(12.0 + 2 * breite, laenge * 0.6))
            eigene_farbe = self.app.theme.get(eintrag.get("color", "muted"), farbe)
            linie = canvas.create_line(
                x1, y1, x2, y2, fill=betont if beteiligt else eigene_farbe,
                width=breite*zoom, smooth=True,
                arrow=spitzen.get(art, "none"),
                arrowshape=(spitze*zoom, (spitze + 2)*zoom, (4 + breite)*zoom),
                dash=(int(6*zoom) or 1, int(4*zoom) or 1) if eintrag.get("dash") else (),
                tags=("connection", f"connection:{erste}:{zweite}"),
            )
            self._connection_items[linie] = (erste, zweite)
            if eintrag.get("label"):
                # Die Beschriftung sitzt in der Linienmitte auf einer kleinen
                # Kartenfläche, damit sie auch über dem Hintergrund lesbar bleibt.
                mitte_x, mitte_y = (x1 + x2) / 2, (y1 + y2) / 2
                schrift = tkfont.Font(font=app_font(max(6, int(round(8 * zoom)))))
                text_breite = schrift.measure(eintrag["label"]) + 12 * zoom
                flaeche = canvas.create_rectangle(
                    mitte_x - text_breite / 2, mitte_y - 9 * zoom, mitte_x + text_breite / 2, mitte_y + 9 * zoom,
                    fill=self.app.theme["card"], outline=eigene_farbe, tags=("connection",))
                beschriftung = canvas.create_text(mitte_x, mitte_y, text=eintrag["label"], font=schrift,
                                                  fill=self.app.theme["text"], tags=("connection",))
                self._connection_items[flaeche] = (erste, zweite)
                self._connection_items[beschriftung] = (erste, zweite)
                self._zoom_fonts = getattr(self, "_zoom_fonts", []) + [schrift]
        # Die Linien liegen jetzt vor den Karten statt
        # darunter. Sie berühren keine Karte mehr, verdecken also nichts –
        # aber bei überlappenden Karten bleiben sie dadurch sichtbar.
        canvas.tag_raise("connection")
        # Während des Verbindens hängt eine Linie am Ausgangspunkt, damit
        # sichtbar ist, dass ein zweiter Klick erwartet wird.
        start = getattr(self, "_connect_from", None)
        if start and start in self.card_boxes:
            box = self.card_boxes[start]
            canvas.create_rectangle(
                box[0] - 3, box[1] - 3, box[0] + box[2] + 3, box[1] + box[3] + 3,
                outline=betont, width=2, dash=(4, 3), tags=("connectsource",),
            )

    def create_card_item(self, x, y, kind=None):
        """Legt einen neuen Punkt an und heftet ihn an diese Stelle.

        Ein Zettel auf der Pinnwand ist in Glide kein
        eigenes Objekt, sondern ein ganz normaler Punkt in der Quellliste.
        Das ist der Unterschied zu einem Whiteboard-Programm: Was hier
        entsteht, steht anschließend auch in der Liste, in der Tabelle, im
        Kalender und im Backup – es gibt keine zweite Datenhaltung, die
        auseinanderlaufen könnte.
        """
        app = self.app
        scope = self.context()
        if not scope:
            return "break"
        # Die Karte entsteht in einer echten Liste. Bei der
        # Listenpinnwand ist das ihre eigene; bei Ordner- und globaler
        # Pinnwand wählt die Maske sie aus – vorbelegt mit der ersten Liste des
        # Bereichs beziehungsweise dem Eingang.
        erlaubte = self.eligible_lists(scope)
        if scope.startswith("list:"):
            vorgabe_liste = scope.split(":", 1)[1]
            auswahl_erlauben = False
        else:
            eingang = next((entry for entry in erlaubte if app.is_inbox_list(entry)), None)
            vorgabe_liste = (eingang or (erlaubte[0] if erlaubte else None) or {}).get("id")
            auswahl_erlauben = True
        if not vorgabe_liste:
            app.show_warning("Pinnwand",
                             "Für diese Pinnwand gibt es keine Liste, in der ein neuer Punkt "
                             "entstehen könnte. Bitte zuerst eine Liste anlegen.")
            return "break"
        if len(self.board()["cards"]) >= self.MAX_CARDS:
            app.show_warning("Pinnwand voll",
                             f"Pro Pinnwand sind höchstens {self.MAX_CARDS} Karten möglich.")
            return "break"
        # Bis 3.23 fragte der Doppelklick nur nach einer
        # Zeile Text. Auf der Karte stehen aber Beschreibung, Labels, Termin,
        # Checkliste und Anhänge – wer sie anlegt, soll sie auch gleich
        # eintragen können. Deshalb dieselbe vollständige Maske wie „Erweitert"
        # in der Liste, statt einer zweiten, kleineren Eingabe.
        with app.modal_over(None):
            details = app.new_item_dialog(
                "Neuer Punkt auf der Pinnwand",
                "Alle Angaben außer dem Titel sind freiwillig und später änderbar.",
                kind=kind,
                allow_list_choice=auswahl_erlauben,
                default_list_id=vorgabe_liste,
                allowed_list_ids={entry["id"] for entry in erlaubte},
            )
        if details is None:
            return "break"
        neu = app.build_item_from_dialog(details)
        if neu is None:
            return "break"
        list_id = details.get("list_id") or vorgabe_liste
        ziel = next((entry for entry in erlaubte if entry.get("id") == list_id), None)
        if ziel is None:
            return "break"
        undo_vorher = len(app.undo_stack)
        with app.item_change((), restore=False, update_sidebar=True) as change:
            ziel.setdefault("items", []).append(neu)
            change.mark()
        if not change.saved:
            ziel["items"][:] = [wert for wert in ziel["items"] if wert is not neu]
            del app.undo_stack[undo_vorher:]
            app.refresh_tree()
            return "break"

        def anheften():
            board = app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            board.setdefault("cards", []).append(
                {"list_id": list_id, "item_id": neu["id"],
                 "x": max(0, int(x)), "y": max(0, int(y)),
                 "scale": self.CARD_SCALE_DEFAULT})

        self.save_view_change(anheften)
        self.selected_id = neu["id"]
        app.refresh_tree()
        self.draw_board()
        app.feedback("card_created")
        return "break"

    def update_scrollregion(self):
        canvas = self.canvas
        bounds = canvas.bbox("all") or (0, 0, 1, 1)
        canvas.configure(scrollregion=(0, 0, max(canvas.winfo_width(), bounds[2]+self.CARD_GAP),
                                       max(canvas.winfo_height(), bounds[3]+self.CARD_GAP)))

    @staticmethod
    def truncate_lines(text, font, width, lines):
        words, output, current = str(text).split(), [], ""
        for word in words:
            trial = (current + " " + word).strip()
            if font.measure(trial) > width and current:
                output.append(current)
                current = word
            else:
                current = trial
        if current:
            output.append(current)
        result = output[:lines]
        if not result:
            return ""
        for index, line in enumerate(result):
            truncated = font.measure(line) > width or (index == lines-1 and len(output) > lines)
            while line and font.measure(line + ("…" if truncated else "")) > width:
                line = line[:-1]
            result[index] = line + ("…" if truncated else "")
        return "\n".join(result)

    def focus_card(self, identity):
        self.selected_id = identity
        self.selected_ids = [identity] if identity else []
        self.draw_board()
        self.update_selection_notice()
        if getattr(self, "canvas", None) and self.canvas.winfo_exists():
            self.canvas.focus_set()
            if identity in self.card_boxes:
                x, y, width, height = self.card_boxes[identity]
                bounds = self.canvas.bbox("all") or (0, 0, 1, 1)
                self.canvas.xview_moveto(max(0, x-16) / max(1, bounds[2]+16))
                self.canvas.yview_moveto(max(0, y-16) / max(1, bounds[3]+16))
        return "break"

    def next_card(self, step):
        if self.presentation_active():
            return self.presentation_step(step)
        if self.card_ids:
            current = self.card_ids.index(self.selected_id) if self.selected_id in self.card_ids else 0
            self.focus_card(self.card_ids[(current+step) % len(self.card_ids)])
        return "break"

    def pin_all(self):
        """Hängt alle geeigneten Punkte des Bereichs an die Pinnwand."""
        scope = self.context()
        if not scope:
            return self.set_mode("board")
        angeheftet = {card["item_id"] for card in self.board(scope)["cards"]}
        offen = [identity for identity in self.valid_items(scope) if identity not in angeheftet]
        if not offen:
            self.app.show_info("Pinnwand", "Alle Punkte dieses Bereichs sind bereits angeheftet.")
            return "break"
        frei = self.MAX_CARDS - len(angeheftet)
        if frei <= 0:
            self.app.show_warning("Pinnwand voll", f"Pro Pinnwand sind höchstens {self.MAX_CARDS} Karten möglich.")
            return "break"
        self.pin(offen[:frei], scope)
        if len(offen) > frei:
            self.app.show_warning("Pinnwand voll", f"Pro Pinnwand sind höchstens {self.MAX_CARDS} Karten möglich.")
        return "break"

    def auto_pin(self):
        """Heftet neue Punkte an, solange die Pinnwand auf „Auto“ steht.

        Läuft still im Aufbau mit: keine Meldung, keine Auswahländerung und
        kein Eingriff, wenn nichts hinzugekommen ist.
        """
        scope = self.context()
        if not scope or not self.board(scope).get("auto"):
            return False
        angeheftet = {card["item_id"] for card in self.board(scope)["cards"]}
        valid = self.valid_items(scope)
        offen = [identity for identity in valid if identity not in angeheftet]
        if not offen:
            return False
        frei = self.MAX_CARDS - len(angeheftet)
        if frei <= 0:
            return False

        def change():
            board = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(self.board(scope)))
            index = len(board["cards"])
            for identity in offen[:frei]:
                board["cards"].append({"list_id": valid[identity][0]["id"], "item_id": identity,
                                       "x": 16 + (index % 3) * (board["width"] + 16),
                                       "y": 16 + (index // 3) * 260,
                                       "scale": self.CARD_SCALE_DEFAULT})
                index += 1
        return self.save_view_change(change)

    def find_cards(self):
        """Filter aufheben und alle Karten wieder in Sichtweite bringen.

        Seit 3.22 bleibt dabei die gewählte Anordnung bestehen: Eine frei
        gebaute Pinnwand fällt nicht mehr ins Raster zurück, nur weil jemand
        eine verlegte Karte sucht. Stattdessen werden die Karten an
        aufgeräumten Positionen abgelegt – gleiche Wirkung, ohne die
        Betriebsart zu wechseln.
        """
        self.filter_label = ""
        self.app.search_var.set("")
        self.app.hide_done_var.set(False)
        scope = self.context()
        board = self.board(scope)
        if board["cards"]:
            breite = board["width"]
            sichtbar = 0
            if getattr(self, "canvas", None) and self.canvas.winfo_exists():
                sichtbar = self.canvas.winfo_width() - 34
            verfuegbar = max(breite + self.CARD_GAP, sichtbar)
            spalten = max(1, int((verfuegbar + self.CARD_GAP) // (breite + self.CARD_GAP)))
            valid = self.valid_cards(scope)
            hoehen = [self.CARD_GAP] * spalten
            positionen = {}
            for card in board["cards"]:
                eintrag = valid.get(card["item_id"])
                if eintrag is None:
                    continue
                faktor = self.card_scale_factor(card)
                _blocks, hoehe = self.card_blocks(eintrag[1], eintrag[0],
                                                  max(160, int(round(breite * faktor))),
                                                  preview_allowed=False, faktor=faktor, card=card)
                spalte = hoehen.index(min(hoehen))
                positionen[card["item_id"]] = (self.CARD_GAP + spalte * (breite + self.CARD_GAP),
                                               hoehen[spalte])
                hoehen[spalte] += hoehe + self.CARD_GAP
            if positionen:
                def change():
                    aktuell = self.app.settings["pinboards"].setdefault(scope, copy.deepcopy(board))
                    for card in aktuell["cards"]:
                        if card["item_id"] in positionen:
                            card["x"], card["y"] = positionen[card["item_id"]]
                self.save_view_change(change)
        self._signature = None
        self.refresh()
        if getattr(self, "canvas", None) and self.canvas.winfo_exists():
            self.canvas.xview_moveto(0)
            self.canvas.yview_moveto(0)
        self.focus_card(self.selected_id)
        return "break"

    def card_at(self, x, y):
        for identity, (left, top, width, height) in reversed(list(self.card_boxes.items())):
            if left <= x <= left+width and top <= y <= top+height:
                return identity
        return None

    def active_ids(self):
        """Die Punkte, auf die eine Aktion der Arbeitsfläche gerade wirkt.

        Auf der Pinnwand ist das die Mehrfachauswahl, im
        Punktreiter der eine Punkt, den der Reiter zeigt. Eine Stelle für
        beides, damit „Erledigt umschalten" nicht je nach Ansicht etwas
        anderes trifft.
        """
        if self.mode == "board":
            return self.selection()
        return [self.selected_id] if self.selected_id else []

    def selection(self):
        """Die ausgewählten Karten in der Reihenfolge ihrer Auswahl.

        `selected_id` ist die zuletzt angefasste Karte und gehört im Normalfall
        zur Mehrfachauswahl. Wird sie von außen gesetzt – aus der Tastatur, aus
        einem Sprung aus der Liste heraus –, ersetzt sie die Auswahl, statt
        neben ihr zu stehen: Sonst träfe die nächste Aktion Karten, die niemand
        mehr ausgewählt hat.
        """
        vorhanden = [identity for identity in self.selected_ids if identity in self.card_boxes]
        if self.selected_id and self.selected_id not in vorhanden:
            return [self.selected_id] if self.selected_id in self.card_boxes else []
        return vorhanden

    def paint_selection(self, kennungen):
        """Zeichnet nur die Rahmen der genannten Karten neu."""
        app = self.app
        for betroffen in kennungen:
            if not betroffen or betroffen not in self.card_boxes:
                continue
            rahmen = self.canvas.find_withtag("frame:" + betroffen)
            if not rahmen:
                continue
            ausgewaehlt = betroffen in self.selected_ids
            anker = bool(self.selected_ids) and betroffen == self.selected_ids[0]
            for element in rahmen:
                try:
                    self.canvas.itemconfigure(
                        element, width=(4 if anker else 3 if ausgewaehlt else 1)*self.zoom_factor(),
                        outline=app.theme["selection"] if ausgewaehlt else app.theme["input_border"])
                except tk.TclError:
                    pass
        self.draw_connect_handles()

    def select_card(self, identity, additive=False):
        """Wechselt die Auswahl, ohne die ganze Fläche neu zu zeichnen.

        Mit der Zusatztaste kommt eine Karte zur Auswahl
        hinzu oder fällt wieder heraus; ohne sie ersetzt sie die Auswahl. Die
        Reihenfolge bleibt erhalten – die erste Karte ist beim Verbinden der
        Ausgangspunkt.
        """
        self._lasso = None
        self.canvas.delete("layer:interaction")
        betroffen = set(self.selected_ids)
        if additive and identity:
            if identity in self.selected_ids:
                self.selected_ids.remove(identity)
                self.selected_id = self.selected_ids[-1] if self.selected_ids else None
            else:
                self.selected_ids.append(identity)
                self.selected_id = identity
        else:
            self.selected_ids = [identity] if identity else []
            self.selected_id = identity
        betroffen.update(self.selected_ids)
        betroffen.add(identity)
        self.paint_selection(betroffen)
        self.update_selection_notice()

    def update_selection_notice(self):
        """Sagt in der Hinweiszeile, wie viele Karten gerade ausgewählt sind."""
        hinweis = getattr(self, "notice", None)
        if hinweis is None or not hinweis.winfo_exists():
            return
        anzahl = len(self.selection())
        grundtext = getattr(self, "_board_notice_text", "")
        try:
            hinweis.configure(text=f"{anzahl} Karten ausgewählt \u00b7 {grundtext}"
                              if anzahl > 1 else grundtext)
        except tk.TclError:
            pass

    def checklist_hit(self, x, y):
        for box, identity, index in reversed(getattr(self, "_checklist_hits", [])):
            if box[0] <= x <= box[0] + box[2] and box[1] <= y <= box[1] + box[3]:
                return identity, index
        return None

    def card_press(self, event):
        self._lasso = None
        self.canvas.delete("layer:interaction")
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        schritt = self.checklist_hit(x, y)
        if schritt is not None and getattr(self, "_connect_from", None) is None:
            self.toggle_card_checklist(*schritt)
            return "break"
        if self.board()["layout"] == "columns":
            return self.column_press(event)
        self._area_drag = None
        self._connect_drag = None
        griff = self.connect_handle_at(x, y)
        if griff is not None and getattr(self, "_connect_from", None) is None:
            self._connect_drag = {"from": griff, "x": x, "y": y}
            return "break"
        identity = self.card_at(x, y)
        if not identity and getattr(self, "_connect_from", None) is None:
            bereich, teil = self.area_at(x, y)
            if bereich is not None and teil in ("header", "grip"):
                return self.area_press(event, bereich, teil)
        if identity or not self.area_at(x, y)[0]:
            if getattr(self, "selected_area", None):
                self.selected_area = None
                self.draw_board()
        # Ist das Verbinden eingeschaltet, ist der nächste
        # Klick auf eine Karte das zweite Ende der Linie – und ein Klick auf
        # die freie Fläche bricht ab. Danach ist der Modus wieder aus: Eine
        # Betriebsart, die stillschweigend anbleibt, führt zu Linien, die
        # niemand wollte.
        start = getattr(self, "_connect_from", None)
        if start is not None:
            self._connect_from = None
            if identity and identity != start:
                self.toggle_connection(start, identity)
                self.select_card(identity)
            else:
                self.draw_board()
            return "break"
        if identity:
            self.canvas.focus_set()
            erweitern = self.app.selection_modifier_pressed(event)
            if erweitern:
                self.select_card(identity, additive=True)
                self._drag = None
                return "break"
            if identity not in self.selected_ids:
                self.select_card(identity)
            else:
                self.selected_id = identity
            left, top, _width, _height = self.card_boxes[identity]
            self._drag = (identity, x, y, left, top, False)
            return "break"
        # Ein Klick auf die freie Fläche hebt die Auswahl auf – sonst bliebe
        # eine Mehrfachauswahl unsichtbar bestehen und die nächste Aktion
        # träfe mehr Karten als gedacht.
        previous = list(self.selected_ids) if self.app.selection_modifier_pressed(event) else []
        if not previous:
            self.select_card(None)
        self._lasso = (x, y, previous)
        self._drag = None
        self.canvas.focus_set()
        return "break"

    def card_motion(self, event):
        if self.board()["layout"] == "columns":
            return self.column_motion(event)
        if getattr(self, "_connect_drag", None):
            return self.connect_drag_motion(event)
        if getattr(self, "_area_drag", None):
            return self.area_motion(event)
        # Die Karte selbst wandert mit dem Zeiger. Vorher lag
        # über der Fläche ein gestricheltes Rechteck, das bei jeder Bewegung neu
        # gezeichnet wurde – das war das Flackern beim Verschieben.
        if getattr(self, "_lasso", None) is not None:
            x, y, _previous = self._lasso
            self.canvas.delete("layer:interaction")
            self.canvas.create_rectangle(x, y, self.canvas.canvasx(event.x), self.canvas.canvasy(event.y),
                                         outline=self.app.theme["ui_accent"], dash=(4, 3), width=2,
                                         tags=("layer:interaction",))
            return "break"
        if not self._drag or self.board()["layout"] != "free":
            return "break"
        identity, x, y, left, top, _moved = self._drag
        dx, dy = self.canvas.canvasx(event.x)-x, self.canvas.canvasy(event.y)-y
        ziel_x = max(0, min(20000*self.zoom_factor(), left+dx))
        ziel_y = max(0, min(20000*self.zoom_factor(), top+dy))
        self.canvas.delete("layer:guides")
        aktuell_x, aktuell_y, breite, hoehe = self.card_boxes[identity]
        self._object_snapped = False
        if self.board().get("object_snap") and not event.state & 0x0008:
            xs, ys = [], []
            for other, (ox, oy, ow, oh) in self.card_boxes.items():
                if other == identity:
                    continue
                xs.extend((target - source, target) for target in (ox, ox+ow/2, ox+ow)
                          for source in (ziel_x, ziel_x+breite/2, ziel_x+breite))
                ys.extend((target - source, target) for target in (oy, oy+oh/2, oy+oh)
                          for source in (ziel_y, ziel_y+hoehe/2, ziel_y+hoehe))
            # Benachbarte Karten in derselben Zeile/Spalte liefern gleiche
            # Abstände, ohne alle möglichen Kartenpaare quadratisch zu prüfen.
            others = [box for key, box in self.card_boxes.items() if key != identity]
            for axis, candidates, start, size, cross, cross_size in (
                    (0, xs, ziel_x, breite, ziel_y, hoehe),
                    (1, ys, ziel_y, hoehe, ziel_x, breite)):
                aligned = sorted((box for box in others
                                  if box[1-axis] < cross+cross_size
                                  and box[1-axis]+box[3-axis] > cross), key=lambda box: box[axis])
                for first, second in zip(aligned, aligned[1:]):
                    gap = second[axis] - first[axis] - first[axis+2]
                    if gap < 0:
                        continue
                    targets = [first[axis]-gap-size, second[axis]+second[axis+2]+gap]
                    if gap >= size:
                        targets.append(first[axis]+first[axis+2]+(gap-size)/2)
                    candidates.extend((target-start, target) for target in targets)
            for axis, candidates in (("x", xs), ("y", ys)):
                if not candidates:
                    continue
                delta, guide = min(candidates, key=lambda value: abs(value[0]))
                if abs(delta) <= 6:
                    self._object_snapped = True
                    if axis == "x":
                        ziel_x += delta
                        coords = (guide, 0, guide, max(2000, ziel_y+hoehe))
                    else:
                        ziel_y += delta
                        coords = (0, guide, max(2000, ziel_x+breite), guide)
                    self.canvas.create_line(*coords, fill=self.app.theme["ui_accent"], dash=(3, 4),
                                            tags=("layer:guides",))
        self.canvas.move("card:" + identity, ziel_x-aktuell_x, ziel_y-aktuell_y)
        self.card_boxes[identity] = (ziel_x, ziel_y, breite, hoehe)
        self._drag = (identity, x, y, left, top, True)
        self.draw_connections(scaled=True)
        return "break"

    def card_release(self, event):
        if self.board()["layout"] == "columns":
            return self.column_release(event)
        if getattr(self, "_connect_drag", None):
            return self.connect_drag_release(event)
        if getattr(self, "_area_drag", None):
            return self.area_release(event)
        self.canvas.delete("layer:guides")
        if getattr(self, "_lasso", None) is not None:
            x, y, previous = self._lasso
            self._lasso = None
            self.canvas.delete("layer:interaction")
            end_x, end_y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
            if abs(end_x-x) > 3 or abs(end_y-y) > 3:
                left, right = sorted((x, end_x))
                top, bottom = sorted((y, end_y))
                selected = [key for key, (cx, cy, cw, ch) in self.card_boxes.items()
                            if left <= cx and top <= cy and cx+cw <= right and cy+ch <= bottom]
                old = set(self.selected_ids)
                self.selected_ids = list(dict.fromkeys(previous + selected))
                self.selected_id = self.selected_ids[-1] if self.selected_ids else None
                self.paint_selection(old | set(self.selected_ids))
                self.update_selection_notice()
            return "break"
        if self._drag and self._drag[5] and self.board()["layout"] == "free":
            identity = self._drag[0]
            x, y, _breite, _hoehe = self.card_boxes[identity]
            self._drag = None
            self.store_position(identity, x / self.zoom_factor(), y / self.zoom_factor(), reveal=False,
                                apply_grid=not getattr(self, "_object_snapped", False))
            return "break"
        self._drag = None
        return "break"

    def card_double_click(self, event):
        """Doppelklick auf eine Karte bearbeitet, auf die freie Fläche legt an.

        Bis 3.22 öffnete ein Doppelklick ins Leere die
        Auswahl vorhandener Punkte. Auf einer Fläche, die zum Denken da ist,
        erwartet man an dieser Stelle etwas Neues – nicht eine Liste dessen,
        was es schon gibt. Der bisherige Weg bleibt über „Punkte anheften …“.
        """
        x, y = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        if self.board()["layout"] == "columns":
            treffer = self.column_hit(x, y)
            if treffer:
                return self.edit(treffer[0])
            spalte = self.column_key_at(x)
            return self.create_column_item(spalte) if spalte is not None else "break"
        if self.card_at(x, y):
            return self.edit()
        # Auch Ordner- und globale Pinnwand legen jetzt an –
        # die Maske fragt dort nach der Zielliste, statt den Weg zu sperren.
        return self.create_card_item(x / self.zoom_factor(), y / self.zoom_factor())

    def store_position(self, identity, x, y, reveal=True, apply_grid=True):
        """Neue Position sichern; `reveal` holt die Karte anschließend ins Bild.

        Beim Ziehen mit der Maus liegt die Karte bereits unter dem Zeiger –
        dort wäre ein Nachführen der Ansicht genau das Springen, das Punkt 9
        beanstandet. Bei Alt+Pfeiltasten dagegen soll die Ansicht folgen.
        """
        step = 24 if self.board()["snap"] and apply_grid else 1
        ziel_x = max(0, min(20000, round(x/step)*step))
        ziel_y = max(0, min(20000, round(y/step)*step))

        def change():
            for card in self.board()["cards"]:
                if card["item_id"] == identity:
                    card["x"] = ziel_x
                    card["y"] = ziel_y
        # Seit 3.30 zurücknehmbar wie Bereiche und Aufräumen – vorher war
        # ausgerechnet das häufigste Verschieben der einzige Weg ohne Rückgängig.
        if self.board_view_change(change, "Karte verschoben"):
            # Kein vollständiger Aufbau der Oberfläche: Die Position einer
            # Karte betrifft ausschließlich die Pinnwand.
            self._signature = None
            if reveal:
                self.focus_card(identity)
            else:
                self.draw_board()
                self.canvas.focus_set()

    def move_card(self, dx, dy):
        if self.board()["layout"] == "columns":
            return self.move_card_to_neighbour_column(dx) if dx else "break"
        if self.board()["layout"] == "free" and self.selected_id:
            card = next((card for card in self.board()["cards"] if card["item_id"] == self.selected_id), None)
            if card:
                step = 24 if self.board()["snap"] else 10
                self.store_position(self.selected_id, card["x"] + dx*step, card["y"] + dy*step)
        return "break"

class RichNoteEditor(tk.Frame):
    """Lokaler Rich-Text-Editor; Undo umfasst Text UND Formatierung."""

    FORMATS = ('bold', 'italic', 'underline', 'strike', 'h1', 'h2', 'h3',
               'bullet', 'number', 'quote', 'code', 'codeblock', 'highlight',
               # Seit 26.09.2026 für die Seitenart „Seite“: Tabellen, Trenn-
               # linien, Einzüge und Aufgabenzeilen (`item:<id>` separat).
               'table', 'divider', 'task', 'indent1', 'indent2', 'indent3',
               # Seit 29.09.2026 (R4 c): Überschrift 4, Hinweisblock, Aufklappliste
               # und ihr Zustand. Ältere Stände verwerfen diese Formate beim
               # Laden; der Text bleibt.
               'h4', 'callout', 'toggle', 'toggle_closed')
    ITEM_TAG = glide_task_refs.TASK_TAG
    # Seitenbilder (27.09.2026): ein Ankerzeichen im Text trägt `img:<kennung>`,
    # die Angaben stehen unter `images` – Anhang, Umfluss und Breite.
    IMAGE_TAG = re.compile(r'^img:[0-9a-f]{8,32}$')
    IMAGE_MODES = ('left', 'right', 'center')
    IMAGE_WIDTH_RANGE = (24, 4000)
    MAX_IMAGES = 500
    MAX_TEXT = 1_000_000
    MAX_SPANS = 10000

    @classmethod
    def normalize_image(cls, info):
        """Ein Seitenbild: {'attachment', 'mode', 'width'} – oder None, wenn unbrauchbar."""
        if not isinstance(info, dict):
            return None
        anhang = info.get('attachment')
        if not isinstance(anhang, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', anhang):
            return None
        modus = info.get('mode') if info.get('mode') in cls.IMAGE_MODES else 'center'
        breite = info.get('width')
        if type(breite) is not int:
            breite = 320
        low, high = cls.IMAGE_WIDTH_RANGE
        return {'attachment': anhang, 'mode': modus, 'width': max(low, min(high, breite))}

    @classmethod
    def normalize(cls, value):
        if value is None:
            return {'text': '', 'spans': [], 'links': {}}
        if not isinstance(value, dict) or not isinstance(value.get('text', ''), str):
            raise ValueError('Ungültiges Notizdokument.')
        text = value.get('text', '')
        if len(text) > cls.MAX_TEXT:
            raise ValueError('Eine Notiz darf höchstens 1.000.000 Zeichen enthalten.')
        raw = value.get('spans', [])
        if not isinstance(raw, list) or len(raw) > cls.MAX_SPANS:
            raise ValueError('Zu viele oder ungültige Notizformatierungen.')
        links = value.get('links', {})
        if not isinstance(links, dict):
            raise ValueError('Ungültige Notizlinks.')
        links = {key: url for key, url in links.items()
                 if isinstance(key, str) and key.startswith('link:') and len(key) <= 80
                 and isinstance(url, str) and len(url) <= 2048
                 and (re.match(r'^(https?://|mailto:)[^\s]+$', url) or glide_objects.parse(url))}
        images = value.get('images', {})
        if not isinstance(images, dict) or len(images) > cls.MAX_IMAGES:
            raise ValueError('Ungültige Seitenbilder.')
        images = {key: cls.normalize_image(info) for key, info in images.items()
                  if isinstance(key, str) and cls.IMAGE_TAG.match(key)}
        images = {key: info for key, info in images.items() if info}
        spans = []
        for span in raw:
            if not isinstance(span, dict):
                raise ValueError('Ungültiger Formatierungsbereich.')
            tag, start, end = span.get('tag'), span.get('start'), span.get('end')
            if not isinstance(tag, str):
                raise ValueError('Ungültige Formatierung.')
            if tag not in cls.FORMATS and tag not in links and tag not in images and not cls.ITEM_TAG.match(tag):
                continue
            if type(start) is not int or type(end) is not int or not 0 <= start < end <= len(text):
                raise ValueError('Formatierungsbereich liegt außerhalb des Notiztextes.')
            spans.append({'tag': tag, 'start': start, 'end': end})
        used = {span['tag'] for span in spans}
        result = {'text': text, 'spans': sorted(spans, key=lambda s: (s['start'], s['end'], s['tag'])),
                  'links': {key: url for key, url in links.items() if key in used}}
        # Nur Seiten mit Bildern tragen den Schlüssel: Notizen und ältere Seiten
        # bleiben bytegleich.
        images = {key: info for key, info in images.items() if key in used}
        if images:
            result['images'] = images
        return result

    def __init__(self, master, app, document=None, on_change=None):
        super().__init__(master, bg=app.theme['card'])
        self.app = app
        self.on_change = on_change
        self._job = None
        self._loading = False
        self._undo, self._redo = [], []
        self._save_failed = False
        self.links = {}
        self._fonts = {}
        toolbar = ButtonFlow(self, bg=app.theme['card'])
        toolbar.pack(fill='x', pady=(0, 5))
        # Häufige Werkzeuge bleiben sichtbar; seltene Formatierungen liegen in
        # „Mehr“. Dadurch braucht der Editor an der Mindestbreite keine vier
        # Werkzeugzeilen mehr.
        specs = [('B', 'bold'), ('I', 'italic'), ('U', 'underline'),
                 ('H2', 'h2'), ('Liste', 'bullet')]
        for label, tag in specs:
            button = app._make_dialog_button(toolbar, label, lambda t=tag: self.format(t), 'muted', width=42, height=30)
            toolbar.add(button)
        for label, command in [('Link', self.insert_link), ('Mehr', self.show_more_menu)]:
            toolbar.add(app._make_dialog_button(toolbar, label, command, 'muted', width=80, height=30))
        self.status = tk.Label(self, text='', bg=app.theme['card'], fg=app.theme['muted'],
                               font=app_font(9), anchor='w')
        self.status.pack(side='bottom', fill='x')
        area = tk.Frame(self, bg=app.theme['input'])
        area.pack(fill='both', expand=True)
        self.text = tk.Text(area, name='rich_note_text', wrap='word', undo=False, exportselection=False,
                            bg=app.theme['input'], fg=app.theme['text'],
                            insertbackground=app.theme['text'], selectbackground=app.theme['selection'],
                            selectforeground=app.theme['selection_text'], relief='flat', bd=0,
                            highlightthickness=0, padx=12, pady=10, height=10, font=app_font(11))
        # Ohne `highlightthickness=0` zog macOS um den Notiztext einen dicken
        # schwarzen Fokusrahmen; die Seite hatte ihn nie (29.09.2026).
        app._attach_field_scrollbar(area, self.text)
        self.text.pack(fill='both', expand=True)
        self.text.tag_configure('underline', underline=True)
        self.text.tag_configure('strike', overstrike=True)
        self.text.tag_configure('quote', lmargin1=20, lmargin2=20, foreground=app.theme['muted'])
        self.text.tag_configure('bullet', lmargin1=8, lmargin2=24)
        self.text.tag_configure('number', lmargin1=8, lmargin2=28)
        self.text.tag_configure('highlight', background=app.theme['selection'], foreground=app.theme['selection_text'])
        for tag in ('code', 'codeblock'):
            self.text.tag_configure(tag, background=app.theme['card'])
        for tag in ('h1', 'h2', 'h3', 'codeblock'):
            self.text.tag_configure(tag, spacing1=6, spacing3=6)
        self.load(document)
        self._last = self.document()
        self.text.bind('<<Modified>>', self.modified)
        for modifier in ('Control', 'Command') if IS_MACOS else ('Control',):
            for key, tag in (('b','bold'), ('i','italic'), ('u','underline')):
                self.text.bind(f'<{modifier}-{key}>', lambda e, t=tag: self.format(t))
            self.text.bind(f'<{modifier}-k>', lambda e: self.insert_link())
            self.text.bind(f'<{modifier}-z>', self.undo)
            self.text.bind(f'<{modifier}-y>', self.redo)
            self.text.bind(f'<{modifier}-Shift-Z>', self.redo)
        self.text.bind('<Control-Button-1>', self.open_link)
        if IS_MACOS:
            self.text.bind('<Command-Button-1>', self.open_link)
        self.text.bind('<at>', self.object_at_key)
        self.text.bind('<FocusOut>', lambda e: self.flush())
        self.bind('<Destroy>', self.destroyed, add='+')

    def show_more_menu(self):
        menu = tk.Menu(self, tearoff=False, bg=self.app.theme['card'], fg=self.app.theme['text'],
                       activebackground=self.app.theme['selection'],
                       activeforeground=self.app.theme['selection_text'])
        for label, tag in (
            ('Durchstreichen', 'strike'), ('Überschrift 1', 'h1'), ('Überschrift 3', 'h3'),
            ('Nummerierte Liste', 'number'), ('Zitat', 'quote'), ('Code', 'code'),
            ('Codeblock', 'codeblock'), ('Markieren', 'highlight'),
        ):
            menu.add_command(label=label, command=lambda value=tag: self.format(value))
        self.add_object_reference_menu(menu)
        menu.add_separator()
        menu.add_command(label='Zeitstempel', command=self.timestamp)
        menu.add_command(label='Tagesabschnitt', command=lambda: self.timestamp(section=True))
        menu.add_command(label='Schreibimpuls', command=self.app.insert_journal_prompt)
        menu.add_separator()
        menu.add_command(label='Präsentieren (Überschriften als Folien)', command=self.app.start_note_presentation)
        menu.add_command(label='Folien als PDF …', command=self.app.print_note_presentation)
        menu.add_separator()
        menu.add_command(label='Rückgängig', command=self.undo)
        menu.add_command(label='Wiederholen', command=self.redo)
        x = self.winfo_pointerx()
        y = self.winfo_pointery()
        try:
            menu.tk_popup(x, y)
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    def destroyed(self, event):
        if event.widget is self and self._job is not None:
            self.after_cancel(self._job)
            self._job = None

    def offset(self, index):
        return len(self.text.get('1.0', index))

    def document(self):
        spans = []
        for tag in (*self.FORMATS, *self.links):
            positions = self.text.tag_ranges(tag)
            for start, end in zip(positions[::2], positions[1::2]):
                a, b = self.offset(start), self.offset(end)
                if a < b:
                    spans.append({'tag': tag, 'start': a, 'end': b})
        return self.normalize({'text': self.text.get('1.0', 'end-1c'), 'spans': spans, 'links': self.links})

    def load(self, document):
        value = self.normalize(document)
        self._loading = True
        try:
            self.text.delete('1.0', 'end')
            for tag in self.text.tag_names():
                if str(tag).startswith(('link:', 'font:')):
                    self.text.tag_delete(tag)
            self.links = value['links']
            self.text.insert('1.0', value['text'])
            # Tk counts non-BMP characters differently across Tk versions.
            # Build native indices by line/column from actual inserted text.
            def index(offset):
                prefix = value['text'][:offset]
                line = prefix.count('\n') + 1
                tail = prefix.rsplit('\n', 1)[-1]
                column = int(self.text.tk.call('string', 'length', tail))
                return f'{line}.{column}'
            for span in value['spans']:
                self.text.tag_add(span['tag'], index(span['start']), index(span['end']))
            for tag in self.links:
                self.text.tag_configure(tag, foreground=self.app.theme['ui_accent'], underline=True)
            self.refresh_fonts()
            self.text.edit_modified(False)
        finally:
            self._loading = False

    def refresh_fonts(self):
        for tag in self.text.tag_names():
            if str(tag).startswith('font:'):
                self.text.tag_remove(tag, '1.0', 'end')
        boundaries = {'1.0', self.text.index('end-1c')}
        font_tags = ('bold','italic','h1','h2','h3','code','codeblock')
        for tag in font_tags:
            boundaries.update(str(i) for i in self.text.tag_ranges(tag))
        ordered = sorted(boundaries, key=lambda i: tuple(map(int, i.split('.'))))
        for start, end in zip(ordered, ordered[1:]):
            active = set(self.text.tag_names(start))
            size = 20 if 'h1' in active else 16 if 'h2' in active else 13 if 'h3' in active else 11
            bold = 'bold' in active or bool(active & {'h1','h2','h3'})
            italic = 'italic' in active
            mono = bool(active & {'code','codeblock'})
            key = f'font:{size}:{int(bold)}:{int(italic)}:{int(mono)}'
            if key not in self._fonts:
                font = tkfont.Font(font=app_font(size, 'bold' if bold else 'normal'))
                font.configure(slant='italic' if italic else 'roman')
                if mono:
                    font.configure(family='Courier New')
                self._fonts[key] = font
            self.text.tag_configure(key, font=self._fonts[key])
            self.text.tag_add(key, start, end)

    def modified(self, event=None):
        if self._loading or not self.text.edit_modified():
            return
        self.text.edit_modified(False)
        if self._job is not None:
            self.after_cancel(self._job)
        self._job = self.after(400, self.flush)

    def flush(self):
        if self._job is not None:
            self.after_cancel(self._job)
            self._job = None
        if self._loading:
            return
        self.refresh_fonts()
        try:
            value = self.document()
        except ValueError as exc:
            self.status.configure(text=str(exc))
            return False
        if value != self._last:
            self._undo.append(copy.deepcopy(self._last))
            self._undo = self._undo[-100:]
            self._redo.clear()
            self._last = copy.deepcopy(value)
            return self.changed(value)
        if self._save_failed:
            return self.changed(value)
        return True

    def changed(self, value):
        ok = self.on_change(value) if self.on_change else True
        self._save_failed = ok is False
        self.status.configure(text='Gespeichert' if ok is not False else 'Nicht gespeichert – erneut versuchen')
        return ok

    def undo(self, event=None):
        self.flush()
        if self._undo:
            self._redo.append(copy.deepcopy(self._last))
            self._last = self._undo.pop()
            self.load(self._last)
            self.changed(self._last)
        return 'break'

    def redo(self, event=None):
        self.flush()
        if self._redo:
            self._undo.append(copy.deepcopy(self._last))
            self._last = self._redo.pop()
            self.load(self._last)
            self.changed(self._last)
        return 'break'

    def format(self, tag):
        self.flush()
        selection = self.text.tag_ranges('sel')
        if not selection:
            self.status.configure(text='Zuerst Text zum Formatieren markieren.')
            self.text.focus_set()
            return 'break'
        start, end = map(str, selection)
        if tag in ('h1','h2','h3','bullet','number','quote','codeblock'):
            start = self.text.index(start+' linestart')
            end = self.text.index(end+' -1c lineend')
        enabled = tag in self.text.tag_names(start)
        if tag in ('bullet','number') and not enabled:
            first, last = int(start.split('.')[0]), int(end.split('.')[0])
            other = 'number' if tag == 'bullet' else 'bullet'
            for line in range(last, first-1, -1):
                if other in self.text.tag_names(f'{line}.0'):
                    pattern = r'^\d+\. ' if other == 'number' else '^' + re.escape(self.app.ICONS['bullet']) + ' '
                    match = re.match(pattern, self.text.get(f'{line}.0', f'{line}.end'))
                    if match:
                        self.text.delete(f'{line}.0', f'{line}.{len(match.group())}')
                prefix = self.app.ICONS['bullet'] + ' ' if tag == 'bullet' else f'{line-first+1}. '
                self.text.insert(f'{line}.0', prefix)
            end = self.text.index(f'{last}.end')
            self.text.tag_remove(other, start, end)
        if enabled:
            self.text.tag_remove(tag, start, end)
            if tag in ('bullet', 'number'):
                first, last = int(start.split('.')[0]), int(end.split('.')[0])
                pattern = r'^' + re.escape(self.app.ICONS['bullet']) + r' ' if tag == 'bullet' else r'^\d+\. '
                for line in range(last, first-1, -1):
                    prefix = re.match(pattern, self.text.get(f'{line}.0', f'{line}.end'))
                    if prefix:
                        self.text.delete(f'{line}.0', f'{line}.{len(prefix.group())}')
        else:
            if tag in ('h1','h2','h3'):
                for other in ('h1','h2','h3'):
                    self.text.tag_remove(other, start, end)
            self.text.tag_add(tag, start, end)
        self.flush()
        self.text.focus_set()
        return 'break'

    def insert_object_reference(self, value=None):
        if not self.flush():
            return 'break'
        selection = self.text.tag_ranges('sel')
        self.text.mark_set('object_start', selection[0] if selection else 'insert')
        self.text.mark_set('object_end', selection[1] if selection else 'insert')
        self.text.mark_gravity('object_start', 'left')
        if value is None:
            value = self.app.themed_choice_dialog('Lokaler Verweis', 'Seite, Liste oder Aufgabe auswählen:',
                self.app.object_reference_choices(('list', getattr(self, 'entry_id', self.app.active_list_id))))
        if value is None:
            return 'break'
        key = glide_objects.parse(value)
        index, _, _ = self.app.object_graph()
        if key not in index or index[key][0] != 'active':
            self.app.show_warning('Verweis', 'Das Ziel ist inzwischen nicht mehr verfügbar.')
            return 'break'
        if self.text.compare('object_start', '==', 'object_end'):
            self.text.insert('object_start', glide_objects.caption(key, index)[1])
        tag = 'link:' + uuid.uuid4().hex
        self.links[tag] = value
        self.text.tag_configure(tag, foreground=self.app.theme['ui_accent'], underline=True)
        self.text.tag_add(tag, 'object_start', 'object_end')
        self.flush()
        self.text.focus_set()
        return 'break'

    def object_at_key(self, event=None):
        previous = self.text.get('insert -1c', 'insert')
        if previous and not previous.isspace() and not self.text.tag_ranges('sel'):
            return None
        return self.insert_object_reference()

    def add_object_reference_menu(self, menu):
        menu.add_command(label='@ Seite, Liste oder Aufgabe …', command=self.insert_object_reference)
        identity = getattr(self, 'entry_id', self.app.active_list_id)
        menu.add_cascade(label='Verweise und Rückverweise',
                         menu=self.app.build_object_reference_menu(('list', identity), menu))

    def insert_link(self):
        selection = self.text.tag_ranges('sel')
        if not selection:
            self.status.configure(text='Zuerst den Linktext markieren.')
            return 'break'
        self.flush()
        self.text.mark_set('link_start', selection[0])
        self.text.mark_set('link_end', selection[1])
        url = self.app.themed_input_dialog('Link', 'https://, http:// oder mailto:', ok_text='Übernehmen')
        if url is None:
            return 'break'
        url = url.strip()
        if not re.match(r'^(https?://|mailto:)[^\s]+$', url) or len(url) > 2048:
            self.app.show_warning('Link', 'Bitte eine gültige Web- oder E-Mail-Adresse eingeben.')
            return 'break'
        tag = 'link:' + uuid.uuid4().hex
        self.links[tag] = url
        self.text.tag_configure(tag, foreground=self.app.theme['ui_accent'], underline=True)
        self.text.tag_add(tag, 'link_start', 'link_end')
        self.flush()
        return 'break'

    def open_link(self, event):
        for tag in self.text.tag_names(f'@{event.x},{event.y}'):
            if tag in self.links:
                if glide_objects.parse(self.links[tag]):
                    self.app.open_object_reference(self.links[tag])
                    return 'break'
                import webbrowser
                webbrowser.open(self.links[tag])
                return 'break'

    def timestamp(self, section=False):
        self.flush()
        start = self.text.index('insert')
        value = datetime.now().strftime('%d.%m.%Y' if section else '%d.%m.%Y %H:%M')
        self.text.insert('insert', ('\n' + value + '\n────────────\n') if section else value)
        if section:
            self.text.tag_add('h2', start+' +1c', start+f' +{len(value)+1}c')
        self.flush()
        self.text.focus_set()
        return 'break'


# Seitenart „Seite“ (26.09.2026): Einzüge und Trennlinie teilen sich Editor und
# Markdown-Übersetzung, damit Import und Export dieselben Zeichen verwenden.
PAGE_INDENT_TAGS = glide_page_markdown.INDENT_TAGS
PAGE_DIVIDER = glide_page_markdown.DIVIDER


class PageEditor(RichNoteEditor):
    """Seitenart „Seite“: ruhiges Lesen, endloses Scrollen, Blöcke wie in Notion.

    Entscheidung des Nutzers vom 26.09.2026: Seiten sind für KI-erzeugte Berichte
    gedacht, getrennt vom Tagebuch. Es zählen ein leichtes Lesegefühl, endloses
    Scrollen und einfache Bedienung.

    - Dokumentmodell wie die Notiz (Text, Formatbereiche, Links); zusätzlich
      Tabellen, Trennlinien, Einzüge und Aufgabenzeilen.
    - Aufgaben sind echte Glide-Punkte der Seite (`item:<id>` über dem Titel).
      Sie erscheinen in „Mein Tag“, tragen Fälligkeit, Labels und alles
      Übrige; ein Doppelklick öffnet die vollen Punktdetails.
    - Schreiben wie in Notion: Markdown-Kürzel beim Tippen (`# `, `- `,
      `1. `, `[] `, `> `, ```` ``` ````, `---`), „/“ am Zeilenanfang öffnet die
      Blockauswahl, Enter setzt Listen und Aufgaben fort.
    - Eingefügtes Markdown (etwa ein KI-Bericht) wird als Seite gesetzt.
    """

    READ_WIDTH = 760
    # U18 (3.33.21): Seiten zeigen ihren Titel als erste Zeile der Lesespalte
    # und in leerem Zustand einen Schreibhinweis. Notizen stehen unter ihrem
    # Listenkopf und brauchen beides nicht.
    SHOW_TITLE = True
    PLACEHOLDER = "Schreiben oder „/“ für Blöcke"
    # Bleibt dem Text weniger Höhe, weicht der Titel; er steht auch im Kopf.
    TEXT_MIN_FOR_TITLE = 160
    # Ob Tk den Innenabstand des Textfelds beim Platzieren mitzählt: einmal
    # je Programmlauf gemessen (place_origin, Hänger vom 30.09.2026).
    _padding_counts = None
    _measuring_origin = False
    LINE_BLOCKS = ('h1', 'h2', 'h3', 'h4', 'bullet', 'number', 'quote', 'codeblock', 'table', 'divider',
                   'task', 'indent1', 'indent2', 'indent3', 'callout', 'toggle', 'toggle_closed')
    TOGGLE_OPEN = '▾ '
    TOGGLE_CLOSED = '▸ '
    CONTINUING = ('bullet', 'number', 'task')

    def __init__(self, master, app, entry, on_change=None):
        tk.Frame.__init__(self, master, bg=app.theme['card'])
        self.app = app
        self.entry_id = entry.get('id')
        self.on_change = on_change
        self._job = None
        self._loading = False
        self._undo, self._redo = [], []
        self._save_failed = False
        self.links = {}
        self._fonts = {}
        self._task_widgets = {}
        self._known_items = set()
        self._read_pad = None
        self.images = {}
        self._image_views = {}
        self._image_job = None
        self._image_drag = None
        self._image_layout_signature = None
        # B4 (3.34.0): zusätzlicher Abstand über einem Bild, das sonst ein
        # vorheriges überlappen würde (Bildkennung → Pixel).
        self._image_push = {}
        self.selected_image = None
        theme = app.theme
        # Die Werkzeuge stehen in der festen Leiste über der Fläche (27.09.2026),
        # damit die Seite dort beginnt, wo jede Liste beginnt.
        leiste_host = app.tool_band_host() if self.TOOLBAR_IN_BAND else None
        toolbar = ButtonFlow(leiste_host if leiste_host is not None else self,
                             bg=theme['bg' if leiste_host is not None else 'card'], gap=6)
        toolbar.pack(fill='x', pady=(0, 6))
        self.bind('<Destroy>', lambda e, w=toolbar: w.destroy() if e.widget is self and w.winfo_exists() else None,
                  add='+')
        self._format_bar = None
        for label, command in self.toolbar_items():
            toolbar.add(app._make_dialog_button(toolbar, label, command, 'muted', height=30,
                                                width=tkfont.Font(font=app_font(10, 'bold')).measure(label) + 26))
        self.status = tk.Label(self, text='', bg=theme['card'], fg=theme['muted'], font=app_font(9), anchor='w')
        self.status.pack(side='bottom', fill='x')
