    def create_ui(self):
        self.create_menubar()
        self.shell = self.register_theme_widget(tk.Frame(self.root, bg=self.theme["bg"]), "bg")
        self.shell.pack(fill="both", expand=True, padx=glide_design.SPACING[28], pady=(glide_design.SPACING[4], glide_design.SPACING[14]))

        # Kopfbereich über die volle Fensterbreite: Titel wieder ganz links.
        top_frame = self.register_theme_widget(tk.Frame(self.shell, bg=self.theme["bg"]), "bg")
        top_frame.pack(fill="x")
        self.header_frame = top_frame
        top_frame.bind("<Configure>", self.update_header_title, add="+")
        top_frame.bind("<Configure>", self.sync_header_density, add="+")
        # Die Höhenstufe hängt am Hauptfenster; Konfigurationsereignisse der
        # Kinder laufen über dasselbe Bindtag und werden in Tcl herausgefiltert.
        self.bind_main_window_resize(self.sync_height_density)
        # Neu gezeigte Widgets – ein Neuaufbau der Startseite, ein Dialog –
        # bekommen Verlauf und Milchglas im nächsten Leerlauf.
        self.root.bind_all("<Map>", self._on_widget_map, add="+")
        self.bind_main_window_resize(lambda event: self.schedule_backdrop_sync_soon()
                                     if getattr(self, "_backdrop", None) else None)

        # Logo links neben Titel und Unterzeile (29.09.2026, Wunsch des Nutzers
        # mit Skizze). Es erscheint ab der ersten Breitenstufe der Kopfzeile in
        # der Akzentfarbe; darunter weicht es, und Titel und Unterzeile rücken
        # wieder an den Rand. Es hängt nur an der Fensterbreite, nie an der
        # Ansicht – die Kopfzeile steht beim Wechseln still. Ein Klick öffnet
        # „Über Glide“, wo das Logo groß steht.
        self.header_logo = self.register_theme_widget(
            tk.Canvas(top_frame, bg=self.theme["bg"], highlightthickness=0, bd=0, width=1, height=1,
                      cursor="hand2", takefocus=0), "bg")
        self.header_logo.bind("<Button-1>", lambda _event: self.show_about_dialog())
        self.add_tooltip(self.header_logo, f"Über {APP_NAME}")

        title_block = self.register_theme_widget(tk.Frame(top_frame, bg=self.theme["bg"]), "bg")
        self.title_block = title_block
        title_block.pack(side="left", fill="x", expand=True)

        # Bis 27.09.2026 stand hier über dem Titel der Ordnerpfad. Er schob die
        # Ansicht von Seiten in Ordnern nach unten; der Nutzer will feste
        # Bestandteile, die sich beim Wechseln nie verschieben. Geblieben ist
        # nur der Rückweg zur Pinnwand – in der Titelzeile, die es immer gibt.
        title_row = self.register_theme_widget(tk.Frame(title_block, bg=self.theme["bg"]), "bg")
        title_row.pack(anchor="w", fill="x", pady=(glide_design.SPACING[0], glide_design.SPACING[4]))
        self.title_row = title_row
        # Rechte Kennzahlen können ihre Breite ändern, ohne dass der äußere
        # Kopf ein Configure meldet. Den Titel nach seiner echten Zuteilung
        # nachführen, damit er auch dann rechtzeitig gekürzt wird.
        title_row.bind("<Configure>", self.update_header_title, add="+")
        self.path_row = self.register_theme_widget(tk.Frame(title_row, bg=self.theme["bg"]), "bg")

        self.title_label = self.register_theme_widget(
            CanvasLabel(
                title_row,
                text=self.app_title,
                font=self.header_title_font(),
                bg=self.theme["bg"],
                fg=self.theme["text"],
                cursor="hand2",
            ),
            "bg",
            "text",
        )
        self.title_label.pack(side="left", anchor="w")
        self.title_label.bind("<Double-Button-1>", lambda event: self.edit_title())
        # U10: alle Kennzahlen und Eigenschaften in der vorhandenen Unterzeile.
