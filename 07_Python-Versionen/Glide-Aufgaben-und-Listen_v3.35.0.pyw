    @staticmethod
    def shorten_to_width(text, schrift, breite):
        """Kürzt zuerst um ganze Abschnitte hinter „ · “, dann am Wortende mit „…“."""
        teile = text.split(" · ")
        while len(teile) > 1 and schrift.measure(" · ".join(teile)) > breite:
            teile.pop()
        text = " · ".join(teile)
        if schrift.measure(text) > breite:
            while text and schrift.measure(text + "…") > breite:
                text = text[:-1]
            text = text.rstrip() + "…" if text else ""
        return text

