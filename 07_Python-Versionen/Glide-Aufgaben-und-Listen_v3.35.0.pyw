    def apply_ui_font(self):
        """Setzt die benannte Tk-Standardschrift für neu erzeugte Widgets."""
        self._measurement_fonts = {}
        self._measurement_linespaces = {}
        self._header_cap_font = None
        self._header_subtitle_font = None
        _APP_FONT_CACHE.pop(self.root, None)
        try:
            named = tkfont.nametofont("TkDefaultFont", root=self.root)
            named.configure(family=self.ui_font_family(), size=self.ui_font_size())
        except (tk.TclError, RuntimeError):
            pass

    def available_font_families(self):
        families = getattr(self, "_font_families", None)
        if families is None:
            try:
                families = {name.strip() for name in tkfont.families(root=self.root)}
            except (tk.TclError, RuntimeError):
                families = set()
            self._font_families = families
        return families

    def heaviest_font(self, size, family=None):
        """Schwerster verfügbarer Schnitt der gewählten Schriftfamilie.

        Tk kennt für 'weight' nur normal und bold. Alles darüber – Semibold,
        Black, Heavy – liegt als eigene Schriftfamilie vor. Existiert eine
        solche Familie, wird sie direkt benannt und ohne zusätzliches Bold
        gesetzt, damit Tk den Schnitt nicht künstlich verdoppelt. Andernfalls
        bleibt es beim regulären Fettschnitt.
        """
        base = family or self.HEADER_FONT_FAMILY or self.ui_font_family()
        cache_key = (base, size)
        cache = getattr(self, "_heaviest_font_cache", None)
        if cache is None:
            cache = {}
            self._heaviest_font_cache = cache
        if cache_key in cache:
            return cache[cache_key]

        # Benennt HEADER_FONT_FAMILY bereits einen schweren Schnitt – etwa
        # "Inter ExtraBold" –, wird er unverändert übernommen. Ein zusätzliches
        # Bold würde Tk sonst zu einem künstlich verdoppelten Schnitt zwingen.
        base_folded = base.casefold()
        if any(base_folded.endswith(f" {suffix}".casefold()) for suffix in self.FONT_WEIGHT_SUFFIXES):
            resolved = (base, size, "normal")
            cache[cache_key] = resolved
            return resolved

        resolved = (base, size, "bold")
        families = self.available_font_families()
        if families:
            lookup = {name.casefold(): name for name in families}
            for suffix in self.FONT_WEIGHT_SUFFIXES:
                candidate = lookup.get(f"{base} {suffix}".casefold())
                if candidate:
                    # Eigene schwere Familie: ohne zusätzliches Bold setzen,
                    # sonst verdoppelt Tk den Schnitt künstlich.
                    resolved = (candidate, size, "normal")
                    break
        cache[cache_key] = resolved
        return resolved

    def header_title_font(self):
        familie = self.pixel_heading_family()
        if familie:
            return (familie, self.HEADER_FONT_SIZE, "bold")
        return self.heaviest_font(self.HEADER_FONT_SIZE)

    PIXEL_FONT_FAMILY = "Pixelify Sans"

    def pixel_heading_family(self):
        """„Pixelify Sans“ für Überschriften im Design „Pixel“ – sonst None.

        Die Schrift liegt unter resources/fonts (SIL OFL 1.1, Herkunft in
        provenance.json) und wird wie DejaVu beim Start für diesen Prozess
        registriert (Linux: Fontconfig). Findet Tk sie nicht, bleibt die
        Oberflächenschrift.
        Nur Überschriften: Fließtext in Pixelschrift wäre schlechter lesbar.
        """
        if not self.is_pixel_design():
            return None
        if not getattr(self, "_pixel_font_found", False):
            # Direkt bei Tk nachfragen statt in der beim Aufbau gefüllten
            # Familienliste: macOS meldet privat registrierte Schriften erst
            # nach einem Durchlauf der Ereignisschleife. Gemerkt wird nur ein
            # Treffer, damit ein zu früher Fehlschlag nichts festschreibt.
            try:
                gefunden = tkfont.Font(root=self.root, family=self.PIXEL_FONT_FAMILY, size=12).actual("family")
            except (tk.TclError, RuntimeError):
                gefunden = ""
            self._pixel_font_found = str(gefunden).casefold() == self.PIXEL_FONT_FAMILY.casefold()
        return self.PIXEL_FONT_FAMILY if self._pixel_font_found else None

    def reapply_heading_fonts(self):
        """Überschriften kurz nach dem Start neu setzen, sobald die Pixelschrift bereitsteht."""
        if not self.is_pixel_design() or not self.pixel_heading_family():
            return
        titel = getattr(self, "title_label", None)
        if titel is not None and titel.winfo_exists():
            titel.configure(font=self.header_title_font())
        inhalt = getattr(self, "home_content", None)
        if inhalt is not None and inhalt.winfo_exists():
            for kopf in self.iter_descendants(inhalt):
                if getattr(kopf, "pixel_block", False):
                    kopf.configure(font=self.pixel_heading_font(12))

    def pixel_heading_font(self, size):
        """Überschriftschrift des Pixel-Designs in der skalierten Größe von `app_font`."""
        schrift = app_font(size, "bold")
        familie = self.pixel_heading_family()
        return (familie, *schrift[1:]) if familie else schrift

    def group_row_font(self):
        """Gruppen im Aufgabenbaum heben sich durch den Fettschnitt ab."""
