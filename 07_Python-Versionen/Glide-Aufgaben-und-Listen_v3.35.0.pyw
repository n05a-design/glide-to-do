    def choose_live_target(self):
        entry = self.app.page_entry(self.entry_id) or {}
        choices = [(value, glide_pages.live_rows(value, self.app.lists, self.app.trash, self.app.folders)[1])
                   for value in entry.get('live_lists', [])]
        target = self.app.themed_choice_dialog('Live-Liste anzeigen', 'Die Verknüpfungen dieser Seite:', choices)
        if target in entry.get('live_lists', []):
            self._live_target = target; self._features_signature = None; self.refresh_page_features()

    def toggle_live_selection(self, _event=None):
        selected = self.live_tree.selection() if self.live_tree is not None else ()
        if selected:
            self.app.toggle_live_task(self.entry_id, self._live_target, selected[0])
        return 'break'

    def open_live_selection(self, event=None):
        if event is not None and getattr(event, 'num', None) == 1:
            row = self.live_tree.identify_row(event.y)
            if row: self.live_tree.selection_set(row)
        selected = self.live_tree.selection() if self.live_tree is not None else ()
        if selected:
            state, _, rows = glide_pages.live_rows(self._live_target, self.app.lists, self.app.trash, self.app.folders)
            if state == 'active' and selected[0] in {row[0] for row in rows}:
                self.app.edit_page_task(selected[0])
        return 'break'

    # --- Darstellung ------------------------------------------------------
    def configure_tags(self):
        theme = self.app.theme
        text = self.text
        text.tag_configure('underline', underline=True)
        text.tag_configure('strike', overstrike=True)
        text.tag_configure('highlight', background=theme['selection'], foreground=theme['selection_text'])
        text.tag_configure('h1', spacing1=22, spacing3=10)
        text.tag_configure('h2', spacing1=18, spacing3=8)
        text.tag_configure('h3', spacing1=12, spacing3=6)
        text.tag_configure('h4', spacing1=10, spacing3=4)
        text.tag_configure('callout', background=theme['input'], lmargin1=18, lmargin2=18, rmargin=18,
                           spacing1=6, spacing3=6)
        text.tag_configure('toggle', lmargin1=4, lmargin2=26)
        text.tag_configure('folded', elide=True)
        text.tag_configure('bullet', lmargin1=8, lmargin2=26, spacing3=3)
        text.tag_configure('number', lmargin1=8, lmargin2=30, spacing3=3)
        text.tag_configure('task', lmargin1=4, lmargin2=30, spacing3=3)
        for stufe, tag in enumerate(PAGE_INDENT_TAGS, start=1):
            text.tag_configure(tag, lmargin1=8 + 24 * stufe, lmargin2=30 + 24 * stufe)
        text.tag_configure('quote', lmargin1=22, lmargin2=22, foreground=theme['muted'])
        for tag in ('code', 'codeblock', 'table'):
            text.tag_configure(tag, background=theme['input'])
        text.tag_configure('codeblock', lmargin1=14, lmargin2=14, spacing1=0, spacing3=0)
        text.tag_configure('table', lmargin1=14, lmargin2=14, spacing1=0, spacing3=0, wrap='none')
        text.tag_configure('divider', justify='center', foreground=theme['line'], spacing1=10, spacing3=10)
        text.tag_configure('task_done', overstrike=True, foreground=theme['muted'])
        text.tag_raise('task_done')
        text.tag_configure('imganchor', elide=True)

    def refresh_fonts(self):
        """Wie in der Notiz, aber mit Lesegrößen: Text 13, Überschriften 24/19/15."""
        for tag in self.text.tag_names():
            if str(tag).startswith('font:'):
                self.text.tag_remove(tag, '1.0', 'end')
        boundaries = {'1.0', self.text.index('end-1c')}
        for tag in ('bold', 'italic', 'h1', 'h2', 'h3', 'h4', 'code', 'codeblock', 'table'):
            boundaries.update(str(i) for i in self.text.tag_ranges(tag))
        ordered = sorted(boundaries, key=lambda i: tuple(map(int, i.split('.'))))
        for start, end in zip(ordered, ordered[1:]):
            active = set(self.text.tag_names(start))
            size = 24 if 'h1' in active else 19 if 'h2' in active else 15 if 'h3' in active else 13
            mono = bool(active & {'code', 'codeblock', 'table'})
            if mono:
                size = 12
            bold = 'bold' in active or bool(active & {'h1', 'h2', 'h3', 'h4'})
            italic = 'italic' in active
            key = f'font:{size}:{int(bold)}:{int(italic)}:{int(mono)}'
            if key not in self._fonts:
                font = tkfont.Font(font=app_font(size, 'bold' if bold else 'normal'))
                font.configure(slant='italic' if italic else 'roman')
                if mono:
                    font.configure(family='Menlo' if IS_MACOS else 'Consolas' if IS_WINDOWS else 'DejaVu Sans Mono')
                self._fonts[key] = font
            self.text.tag_configure(key, font=self._fonts[key])
            self.text.tag_add(key, start, end)

    def fit_read_width(self, event=None):
        """Lesespalte: höchstens READ_WIDTH breit, mittig; auf Wunsch volle Breite."""
        breite = event.width if event is not None else self.text.winfo_width()
        voll = bool(self.app.settings.get('page_full_width'))
        rand = 28 if voll else max(28, (breite - self.READ_WIDTH) // 2)
        if rand != self._read_pad:
            self._read_pad = rand
            self.text.configure(padx=rand)
            if self.title_label is not None:
                # Der Titel steht genau über der Lesespalte.
                if self.title_label.winfo_manager() == 'pack':
                    self.title_label.pack_configure(padx=rand)
                self.title_label.configure(wraplength=max(120, breite - 2 * rand))
            self.sync_placeholder()
        if self.images:
            # Beim ersten Aufbau sofort, danach gebündelt.
            self.schedule_image_layout(0 if not self._image_views else 120)

    # --- Dokument ---------------------------------------------------------
    def document(self):
        spans = []
        tags = (*self.FORMATS, *self.links, *self.images,
                *(t for t in self.text.tag_names() if glide_task_refs.task_id(str(t))))
        laenge = len(self.text.get('1.0', 'end-1c'))
        for tag in tags:
            positions = self.text.tag_ranges(tag)
            for start, end in zip(positions[::2], positions[1::2]):
                a, b = self.offset(start), min(self.offset(end), laenge)
                if a < b:
                    spans.append({'tag': str(tag), 'start': a, 'end': b})
        return self.normalize({'text': self.text.get('1.0', 'end-1c'), 'spans': spans, 'links': self.links,
                               'images': self.images})

    def load(self, document):
        wert = self.normalize(document)
        self.images = copy.deepcopy(wert.get('images', {}))
        for tag in list(self.text.tag_names()):
            if str(tag).startswith('img:') and tag not in self.images:
                self.text.tag_delete(tag)
        self.load_text(wert)
        self.mark_image_anchors()
        if self.images or self._image_views:
            self.schedule_image_layout(0)
        self.sync_placeholder()

    def sync_placeholder(self, _event=None):
        """Zeigt den Schreibhinweis nur auf einer leeren Seite (U18)."""
        hinweis = getattr(self, '_placeholder', None)
        if hinweis is None:
            return
        try:
            leer = not self.text.get('1.0', 'end-1c') and not self.images
            if leer:
                hinweis.place(x=int(float(self.text.cget('padx'))), y=int(float(self.text.cget('pady'))))
            else:
                hinweis.place_forget()
        except tk.TclError:
            pass

    def fit_title(self, event=None):
        """Titel nur, solange dem Text genug Höhe bleibt (Mindestfenster, Titelbild, Live-Liste)."""
        titel = getattr(self, 'title_label', None)
        if titel is None:
            return
        try:
            hoehe = self.text.winfo_height()
            if hoehe <= 1:
                return
            bedarf = titel.winfo_reqheight() + 18
            if titel.winfo_manager() and hoehe < self.TEXT_MIN_FOR_TITLE:
                titel.pack_forget()
            elif not titel.winfo_manager() and hoehe - bedarf >= self.TEXT_MIN_FOR_TITLE:
                titel.pack(fill='x', padx=self._read_pad or 28, pady=(18, 0), after=self._cover_host)
        except tk.TclError:
            pass

    def rename_page(self):
        """Seitentitel über denselben Weg wie in der Seitenleiste ändern (U18)."""
        if self.app.page_entry(self.entry_id) is None:
            return None
        self.flush()
        self.app.edit_list_details(self.entry_id)
        self.refresh_title()
        return None

    def refresh_title(self):
        if getattr(self, 'title_label', None) is None:
            return
        entry = self.app.page_entry(self.entry_id) or {}
        titel = str(entry.get('title') or '')
        try:
            if self.title_label.cget('text') != titel:
                self.title_label.configure(text=titel)
        except tk.TclError:
            pass

    def load_text(self, document):
        for widgets in self._task_widgets.values():
            for widget in widgets:
                try:
                    widget.destroy()
                except tk.TclError:
                    pass
        self._task_widgets = {}
        RichNoteEditor.load(self, document)
        self._loading = True
        try:
            # Zeilenformate schließen den Zeilenumbruch ein: Wer am Zeilenende
            # weitertippt, bleibt in der Überschrift oder Liste.
            zeilenweise = list(self.LINE_BLOCKS) + [t for t in self.text.tag_names() if glide_task_refs.task_id(str(t))]
            for tag in zeilenweise:
                ranges = self.text.tag_ranges(tag)
                for start, end in zip(ranges[::2], ranges[1::2]):
                    if self.text.get(end) == '\n':
                        self.text.tag_add(tag, end)
            for tag in [t for t in self.text.tag_names() if glide_task_refs.task_id(str(t))]:
                self.text.tag_configure(tag)
            self.render_tasks()
            self.apply_folds()
            self.text.edit_modified(False)
        finally:
            self._loading = False
        self._known_items = set(self.item_ids(owned=True))

    def modified(self, event=None):
        RichNoteEditor.modified(self, event)
        self.sync_placeholder()
        if self.images:
            self.schedule_image_layout()

    def item_ids(self, *, owned=False):
        return list(dict.fromkeys(glide_task_refs.task_id(str(tag), owned=owned) for tag in self.text.tag_names() if glide_task_refs.task_id(str(tag), owned=owned)
                and self.text.tag_ranges(tag)))

    # --- Aufgaben ---------------------------------------------------------
    def task_ranges(self, item_id):
        lines = {}
        for prefix in ('item:', 'taskref:'):
            values = self.text.tag_ranges(prefix + item_id)
            for start, end in zip(values[::2], values[1::2]):
                line = self.text.index(f'{start} linestart')
                while self.text.compare(line, '<', end):
                    finish = self.text.index(f'{line} lineend')
                    if self.text.get(line, finish).strip():
                        lines[line] = (line, finish)
                    following = self.text.index(f'{line} +1l linestart')
                    if following == line:
                        break
                    line = following
        return [lines[key] for key in sorted(lines, key=lambda key: tuple(map(int, key.split('.'))))]

    def render_tasks(self):
        """Ein Kästchen je Zeile, auch bei zusammenhängenden gleichen Marken."""
        for item_id in self.item_ids():
            for start, end in self.task_ranges(item_id):
                line = self.text.index(f'{start} linestart')
                if any(self.text.index(box) == line for box in self.task_boxes() if box.winfo_exists()):
                    continue
                reference = 'taskref:' + item_id in self.text.tag_names(start)
                self.attach_checkbox(line, item_id, reference=reference)
        self.refresh_tasks()

    def attach_checkbox(self, linie, item_id=None, reference=False):
        theme = self.app.theme
        box = tk.Canvas(self.text, width=18, height=18, bg=theme['card'], highlightthickness=0, bd=0,
                        cursor='hand2', takefocus=0)
        box._is_page_task = True
        box._item_id = item_id
        box._reference = reference
        box.bind('<Button-1>', lambda e, b=box: self.toggle_task(b) or 'break')
        self.text.window_create(linie, window=box, align='center', padx=4)
        self.text.tag_add('task', linie)
        if item_id:
            self.text.tag_add(('taskref:' if reference else 'item:') + item_id, linie)
            self._task_widgets.setdefault(item_id, []).append(box)
        self.draw_checkbox(box, False)
        return box

    def draw_checkbox(self, box, done):
        theme = self.app.theme
        box.delete('all')
        farbe = theme['confirm'] if done else theme['muted']
        box.create_rectangle(2, 2, 16, 16, outline=farbe, width=1.5, fill=farbe if done else '')
        if done:
            box.create_line(5, 9, 8, 12, 13, 5, fill=theme.get('selection_text', '#FFFFFF'), width=2)

    def task_boxes(self):
        attached = set(map(str, self.text.window_names()))
        boxes = []
        for widget in self.text.winfo_children():
            if getattr(widget, '_is_page_task', False):
                if str(widget) in attached:
                    boxes.append(widget)
                else:
                    widget.destroy()
        return boxes

    def refresh_tasks(self):
        """Kästchen, Erledigt-Darstellung und Hinweise aus den echten Punkten."""
        self.refresh_page_features()
        self.text.tag_remove('task_done', '1.0', 'end')
        targets = glide_task_refs.target_index(self.app.lists, self.app.trash)
        boxes = self.task_boxes()
        self._task_widgets = {}
        for box in boxes:
            if getattr(box, '_item_id', None):
                self._task_widgets.setdefault(box._item_id, []).append(box)
        for box in boxes:
            item_id = getattr(box, '_item_id', None)
            if not item_id:
                self.draw_checkbox(box, False)
                continue
            state, item, home = targets.get(item_id, ('missing', None, None))
            if state == 'trash' and not box._reference and item_id in getattr(self, '_restore_task_ids', set()):
                if self.app.restore_page_task(self.entry_id, item_id):
                    state, item, home = glide_task_refs.status(item_id, self.app.lists, self.app.trash)
            box._target_state = state
            if state != 'active':
                self.draw_checkbox(box, False)
                box.create_text(9, 9, text=self.app.ICONS['blocked'], font=app_font(9), fill=self.app.theme['muted'])
                hint = 'Im Papierkorb' if state == 'trash' else 'Ziel fehlt'
                self.app.add_tooltip(box, hint + ' · ' + str((item or {}).get('text') or item_id))
                label_font = app_font(9)
                box.configure(width=tkfont.Font(font=label_font).measure(hint) + 30)
                box.create_text(24, 9, text=hint, anchor='w', font=label_font, fill=self.app.theme['muted'])
                self.status.configure(text=hint + ' – Aufgabenzeile bleibt erhalten')
                continue
            box.configure(width=18)
            self.sync_line_title(item_id, item)
            done = bool(item.get('done'))
            self.draw_checkbox(box, done)
            if done:
                for start, end in self.task_ranges(item_id):
                    self.text.tag_add('task_done', start, end)
            self.app.add_tooltip(box, self.app.page_task_hint(item) +
                                 (' · Verweis aus ' + str(home.get('title') or 'Liste') if box._reference else ''))

    def sync_line_title(self, item_id, item):
        """Jede Zeile folgt derselben Aufgabe, aktive Eingabe bleibt unberührt."""
        title = ' '.join(str(item.get('text') or '').split())
        if not title:
            return
        for start, end in reversed(self.task_ranges(item_id)):
            line = self.text.index(f'{start} linestart')
            if not self._loading and self.text.index('insert linestart') == line and self.focus_get() is self.text:
                continue
            if ' '.join(self.text.get(start, end).split()) == title:
                continue
            self._loading = True
            try:
                first = self.text.index(f'{line} +1c') if any(
                    self.text.index(box) == line for box in self.task_boxes() if box.winfo_exists()) else line
                tags = [t for t in self.text.tag_names(start) if t in self.LINE_BLOCKS or glide_task_refs.task_id(str(t))]
                self.text.delete(first, f'{line} lineend')
                self.text.insert(first, title, tuple(tags))
                self.text.edit_modified(False)
            finally:
                self._loading = False

    def toggle_task(self, box):
        self.flush()
        item_id = getattr(box, '_item_id', None)
        if item_id and self.app.find_item_in_lists(item_id):
            self.app.toggle_item_done_anywhere(item_id)
            self.refresh_tasks()
        return 'break'

    def open_task_at_pointer(self, event):
        for tag in self.text.tag_names(f'@{event.x},{event.y}'):
            if glide_task_refs.task_id(str(tag)):
                self.flush()
                self.app.edit_page_task(glide_task_refs.task_id(str(tag)))
                return 'break'
        return None

    def bind_pending_tasks(self):
        """Aufgabenzeilen ohne Punkt bekommen ihren Punkt, sobald sie Text haben."""
        for box in self.task_boxes():
            if getattr(box, '_item_id', None):
                continue
            try:
                linie = self.text.index(box)
            except tk.TclError:
                continue
            titel = self.text.get(f'{linie} +1c', f'{linie} lineend').strip()
            if not titel:
                continue
            item_id = self.app.create_page_task(self.entry_id, titel)
            if not item_id:
                continue
            box._item_id = item_id
            self.text.tag_add('item:' + item_id, linie, f'{linie} lineend +1c')
            self._task_widgets[item_id] = [box]
            self._known_items.add(item_id)

    def sync_task_titles(self):
        titles = glide_task_refs.edited_titles(self._last, self.document())
        if titles:
            self.app.rename_page_tasks(titles)

    @contextlib.contextmanager
    def task_change(self):
        with self.app.item_change((), restore=False, update_sidebar=True) as change:
            self.app._task_editor_change = change
            try:
                yield change
                if self.app.dirty:
                    change.mark()
            finally:
                self.app._task_editor_change = None
        if change.saved is False:
            self._save_failed = True
            self.status.configure(text='Nicht gespeichert – erneut versuchen')

    def flush(self):
        if self._loading or getattr(self, '_flushing_tasks', False):
            return True
        if getattr(self.app, '_data_read_only', False):
            self.status.configure(text='Schreibgeschützter Bestand')
            return False
        self._flushing_tasks = True
        try:
            with self.task_change() as change:
                self.spread_line_tags()
                self.bind_pending_tasks()
                self.sync_task_titles()
                self.refresh_tasks()
                current = set(self.item_ids(owned=True))
                removed = self._known_items - current
                if removed:
                    self.app.remove_page_tasks(self.entry_id, removed)
                    self.refresh_tasks()
                self._known_items = current
                result = RichNoteEditor.flush(self)
            return result is not False and change.saved is not False
        finally:
            self._flushing_tasks = False

    def undo(self, event=None):
        return self.restore_text_change(False, event)

    def redo(self, event=None):
        return self.restore_text_change(True, event)

    def restore_text_change(self, redo, event=None):
        prior_document = copy.deepcopy(self._last)
        targets = glide_task_refs.target_index(self.app.lists, self.app.trash)
        prior_titles = {identity: ' '.join(str(targets[identity][1].get('text') or '').split())
                        for identity in glide_task_refs.document_ids(prior_document)
                        if identity in targets and targets[identity][0] == 'active'}
        if not self.flush():
            return 'break'
        previous = set(self.item_ids(owned=True))
        stack = self._redo if redo else self._undo
        self._restore_task_ids = glide_task_refs.document_ids(stack[-1], owned=True) - previous if stack else set()
        self._flushing_tasks = True
        try:
            with self.task_change():
                if stack:
                    target = stack[-1]
                    titles = glide_task_refs.undo_titles(self._last, target,
                              glide_task_refs.target_index(self.app.lists, self.app.trash),
                              prior_document=prior_document, prior_titles=prior_titles)
                    self.app.rename_page_tasks(titles)
                    (self._undo if redo else self._redo).append(copy.deepcopy(self._last))
                    stack.pop()
                    self.load(target)
                    # Tk verbindet benachbarte Marken beim Laden. Dieser reine
                    # Darstellungsabgleich darf den Redo-Stapel nicht leeren.
                    self._last = self.document()
                    self.changed(self._last)
                removed = previous - set(self.item_ids(owned=True))
                if removed:
                    self.app.remove_page_tasks(self.entry_id, removed)
                    self.refresh_tasks()
        finally:
            self._flushing_tasks = False
            self._restore_task_ids = set()
        return 'break'

    def insert_task_reference(self, item_id=None):
        if not self.flush():
            return 'break'
        if item_id is None:
            choices = [(item['id'], item['text'] + ' · ' + self.app.list_path_title(entry))
                       for entry in self.app.planning_lists() for item in self.app.walk_items(entry.get('items', []))
                       if self.app.is_schedulable_item(item)]
            item_id = self.app.themed_choice_dialog('Aufgabe verknüpfen', 'Welche Aufgabe soll hier erscheinen?', choices)
        found = self.app.find_item_in_lists(item_id) if item_id else None
        if not found:
            return 'break'
        line = self.text.index('insert linestart')
        if self.text.get(line, f'{line} lineend').strip():
            self.text.insert(f'{line} lineend', '\n')
            line = self.text.index(f'{line} +1l linestart')
        title = ' '.join(found[0]['text'].split())
        self.text.insert(line, title, ('task', 'taskref:' + item_id))
        end = self.text.index(f'{line} lineend')
        for tag in self.text.tag_names():
            if glide_task_refs.task_id(str(tag)):
                self.text.tag_remove(tag, line, f'{end} +1c')
        self.text.tag_add('taskref:' + item_id, line, end)
        self.render_tasks()
        self.flush()
        self.text.focus_set()
        return 'break'

    def add_task_menu(self, menu):
        writable = not getattr(self.app, '_data_read_only', False)
        menu.add_command(label='Aufgabe verknüpfen …', command=self.insert_task_reference,
                         state='normal' if writable else 'disabled')
        identity = next((glide_task_refs.task_id(str(tag)) for tag in self.text.tag_names('insert')
                         if glide_task_refs.task_id(str(tag))), None)
        found = self.app.find_item_in_lists(identity) if identity else None
        own = bool(found and found[3]['id'] == self.entry_id)
        menu.add_command(label='In Liste übernehmen …', command=self.move_task_to_list,
                         state='normal' if writable and own else 'disabled')

    def move_task_to_list(self):
        self.flush()
        identity = next((glide_task_refs.task_id(str(tag)) for tag in self.text.tag_names('insert')
                         if glide_task_refs.task_id(str(tag))), None)
        if identity:
            choices = [(entry['id'], self.app.list_path_title(entry)) for entry in self.app.lists
                       if entry.get('list_kind', 'tasks') == 'tasks' and not self.app.is_archived_entry(entry)]
            target = self.app.themed_choice_dialog('In Liste übernehmen', 'Neue Heimat der Aufgabe:', choices)
            if target:
                self.app.transfer_document_task(self.entry_id, identity, target)
        return 'break'

    # --- Blöcke -----------------------------------------------------------
    def line_bounds(self, index='insert'):
        return self.text.index(f'{index} linestart'), self.text.index(f'{index} lineend')

    def line_blocks(self, index='insert'):
        return [tag for tag in self.text.tag_names(f'{index} linestart') if tag in self.LINE_BLOCKS]

    def clear_line_block(self, index='insert'):
        start, end = self.line_bounds(index)
        self.unfold_toggle(start)
        for tag in ('h1', 'h2', 'h3', 'h4', 'bullet', 'number', 'quote', 'codeblock', 'table', 'divider', 'task',
                    'callout', 'toggle', 'toggle_closed'):
            self.text.tag_remove(tag, start, f'{end} +1c')
        zeile = self.text.get(start, end)
        praefix = re.match(r'^(' + re.escape(self.app.ICONS['bullet']) + r' |\d+\. |▾ |▸ )', zeile)
        if praefix:
            self.text.delete(start, f'{start} +{len(praefix.group())}c')
        for box in self.task_boxes():
            try:
                if self.text.index(box) == start:
                    self.text.delete(start)
                    box.destroy()
            except tk.TclError:
                continue

    def set_block(self, tag, index='insert'):
        """Macht aus der aktuellen Zeile den gewünschten Block (erneut: zurück zu Text)."""
        vorher = self.line_blocks(index)
        einzug = [t for t in vorher if t in PAGE_INDENT_TAGS]
        self.clear_line_block(index)
        if tag in vorher and tag != 'text':
            self.flush()
            return 'break'
        start, end = self.line_bounds(index)
        ueberschrift = None
        if tag.startswith('toggle_h'):
            # Aufklappüberschrift: Überschrift und Aufklappliste zugleich.
            tag, ueberschrift = 'toggle', 'h' + tag[-1]
        if tag == 'toggle':
            self.text.insert(start, self.TOGGLE_OPEN)
        if tag == 'bullet':
            self.text.insert(start, self.app.ICONS['bullet'] + ' ')
        elif tag == 'number':
            nummer = 1
            vorige = self.text.index(f'{start} -1l linestart')
            if 'number' in self.text.tag_names(vorige) and vorige != start:
                treffer = re.match(r'^(\d+)\. ', self.text.get(vorige, f'{vorige} lineend'))
                nummer = int(treffer.group(1)) + 1 if treffer else 1
            self.text.insert(start, f'{nummer}. ')
        elif tag == 'task':
            self.attach_checkbox(start)
        start, end = self.line_bounds(index)
        if tag in ('h1', 'h2', 'h3', 'h4', 'bullet', 'number', 'quote', 'codeblock', 'task', 'callout', 'toggle'):
            self.text.tag_add(tag, start, f'{end} +1c')
            if ueberschrift:
                self.text.tag_add(ueberschrift, start, f'{end} +1c')
            for t in einzug:
                self.text.tag_add(t, start, f'{end} +1c')
            self.refresh_fonts()
        self.flush()
        self.text.focus_set()
        return 'break'

    def insert_divider(self):
        start, end = self.line_bounds()
        if self.text.get(start, end).strip():
            self.text.insert(end, '\n')
            start = self.text.index(f'{end} +1c')
        self.text.insert(start, PAGE_DIVIDER, ('divider',))
        self.text.tag_add('divider', start, f'{start} lineend +1c')
        self.text.insert(f'{start} lineend +1c', '\n')
        self.text.mark_set('insert', f'{start} +1l linestart')
        self.flush()
        return 'break'

    # --- Aufklapplisten (29.09.2026, R4 c) --------------------------------
    # Eine Aufklappzeile beginnt mit „▾ “ (offen) oder „▸ “ (zu). Ihr Inhalt
    # sind die folgenden Zeilen mit tieferem Einzug. Zugeklappt blendet das
    # Ansichtsformat 'folded' sie aus; gespeichert wird nur 'toggle_closed'.

    def line_level(self, index):
        namen = self.text.tag_names(index)
        return next((stufe + 1 for stufe, tag in enumerate(PAGE_INDENT_TAGS) if tag in namen), 0)

    def toggle_children(self, index):
        """Anfang und Ende der Kindzeilen einer Aufklappzeile (oder None)."""
        start = self.text.index(f'{index} linestart')
        stufe = self.line_level(start)
        letzte = int(self.text.index('end-1c').split('.')[0])
        zeile = int(start.split('.')[0]) + 1
        ende = None
        while zeile <= letzte:
            beginn = f'{zeile}.0'
            if self.line_level(beginn) <= stufe:
                break
            ende = zeile
            zeile += 1
        if ende is None:
            return None
        return f'{int(start.split(".")[0]) + 1}.0', self.text.index(f'{ende}.0 lineend +1c')

    def set_toggle_open(self, index, offen):
        start = self.text.index(f'{index} linestart')
        if 'toggle' not in self.text.tag_names(start):
            return False
        pfeil = self.text.get(start, f'{start} +2c')
        soll = self.TOGGLE_OPEN if offen else self.TOGGLE_CLOSED
        if pfeil in (self.TOGGLE_OPEN, self.TOGGLE_CLOSED) and pfeil != soll:
            namen = [n for n in self.text.tag_names(start) if n != 'sel']
            self.text.delete(start, f'{start} +1c')
            self.text.insert(start, soll[0], tuple(namen))
        ende = f'{start} lineend +1c'
        if offen:
            self.text.tag_remove('toggle_closed', start, ende)
        else:
            self.text.tag_add('toggle_closed', start, ende)
        self.apply_folds()
        return True

    def unfold_toggle(self, index='insert'):
        start = self.text.index(f'{index} linestart')
        if 'toggle_closed' in self.text.tag_names(start):
            self.set_toggle_open(start, True)

    def apply_folds(self):
        self.text.tag_remove('folded', '1.0', 'end')
        bereiche = self.text.tag_ranges('toggle_closed')
        for start in bereiche[::2]:
            kinder = self.toggle_children(str(start))
            if kinder:
                self.text.tag_add('folded', *kinder)
        self.text.tag_raise('folded')

    def click_toggle_arrow(self, event):
        index = self.text.index(f'@{event.x},{event.y}')
        start = self.text.index(f'{index} linestart')
        if 'toggle' not in self.text.tag_names(start):
            return None
        if self.text.compare(index, '>', f'{start} +1c'):
            return None
        self.set_toggle_open(start, 'toggle_closed' in self.text.tag_names(start))
        self.text.mark_set('insert', f'{start} lineend')
        self.flush()
        return 'break'

    def newline_in_toggle(self, zeile, bloecke):
        """Enter auf einer Aufklappzeile: neue eingerückte Kindzeile."""
        inhalt = zeile[2:].strip() if zeile[:2] in (self.TOGGLE_OPEN, self.TOGGLE_CLOSED) else zeile.strip()
        if not inhalt:
            self.clear_line_block()
            self.flush()
            return 'break'
        self.unfold_toggle()
        stufe = min(len(PAGE_INDENT_TAGS), self.line_level('insert') + 1)
        self.text.mark_set('insert', 'insert lineend')
        self.text.insert('insert', '\n')
        neue = self.text.index('insert linestart')
        for tag in list(self.LINE_BLOCKS) + [t for t in self.text.tag_names() if glide_task_refs.task_id(str(t))]:
            self.text.tag_remove(tag, neue, f'{neue} lineend +1c')
        self.text.tag_add(PAGE_INDENT_TAGS[stufe - 1], neue, f'{neue} lineend +1c')
        self.text.mark_set('insert', f'{neue} lineend')
        self.text.see('insert')
        self.flush()
        return 'break'

    # --- Gliederung (29.09.2026, F1) --------------------------------------
    def outline(self):
        """Überschriften der Seite als (Stufe, Text, Index)."""
        eintraege = []
        for zeile in range(1, int(self.text.index('end-1c').split('.')[0]) + 1):
            start = f'{zeile}.0'
            namen = self.text.tag_names(start)
            stufe = next((s for s in (1, 2, 3, 4) if f'h{s}' in namen), None)
            text = self.text.get(start, f'{start} lineend').strip()
            if stufe and text:
                if text[:2] in (self.TOGGLE_OPEN, self.TOGGLE_CLOSED):
                    text = text[2:]
                eintraege.append((stufe, text, start))
        return eintraege

    def jump_to(self, index):
        # Liegt die Überschrift in einer zugeklappten Liste, erst aufklappen.
        while 'folded' in self.text.tag_names(index):
            bereiche = self.text.tag_ranges('toggle_closed')
            offen = False
            for start in bereiche[::2]:
                kinder = self.toggle_children(str(start))
                if kinder and self.text.compare(kinder[0], '<=', index) and self.text.compare(index, '<', kinder[1]):
                    self.set_toggle_open(str(start), True)
                    offen = True
                    break
            if not offen:
                break
        self.text.mark_set('insert', f'{index} lineend')
        self.text.yview(index)
        self.text.focus_set()

    def add_outline_menu(self, menu):
        eintraege = self.outline()
        gliederung = self.app._new_themed_popup_menu(menu)
        for stufe, text, index in eintraege[:40]:
            kurz = text if len(text) <= 48 else text[:47] + '…'
            gliederung.add_command(label='   ' * (stufe - 1) + kurz, command=lambda i=index: self.jump_to(i))
        menu.add_cascade(label='Gliederung', menu=gliederung, state='normal' if eintraege else 'disabled')

    def show_heading_menu(self):
        menu = self.app._new_themed_popup_menu(self)
        for label, tag in (('Text', 'text'), ('Überschrift 1', 'h1'), ('Überschrift 2', 'h2'),
                           ('Überschrift 3', 'h3'), ('Überschrift 4', 'h4')):
            menu.add_command(label=label, command=lambda t=tag: self.set_block(t) if t != 'text'
                             else (self.clear_line_block(), self.flush()))
        self.popup(menu)

    def show_page_menu(self):
        menu = self.app._new_themed_popup_menu(self)
        favorit = self.entry_id in (self.app.settings.get('page_favorites') or [])
        menu.add_command(label=('Aus Favoriten entfernen' if favorit else 'Zu Favoriten hinzufügen'),
                         command=lambda: self.app.toggle_page_favorite(self.entry_id))
        menu.add_command(label='Volle Breite' if not self.app.settings.get('page_full_width') else 'Lesebreite',
                         command=self.toggle_width)
        self.add_outline_menu(menu)
        self.add_object_reference_menu(menu)
        menu.add_separator()
        menu.add_command(label='Live-Liste einbetten …', command=lambda: self.app.choose_live_list(self.entry_id))
        menu.add_cascade(label='Titelbild', menu=self.app.page_cover_menu(self.entry_id, menu))
        menu.add_command(label='Bild einfügen …', command=self.choose_images)
        menu.add_command(label='Trennlinie', command=self.insert_divider)
        menu.add_command(label='Link …', command=self.insert_link)
        self.add_task_menu(menu)
        menu.add_command(label='Markdown aus Zwischenablage einfügen', command=self.paste_markdown)
        menu.add_separator()
        menu.add_command(label='Drucken und PDF …', command=lambda: self.app.print_page(self.entry_id))
        menu.add_command(label='Als Markdown speichern …', command=lambda: self.app.export_page_markdown(self.entry_id))
        menu.add_command(label='Markdown kopieren', command=lambda: self.app.copy_page_markdown(self.entry_id))
        menu.add_command(label='Als Glide-Seite exportieren …',
                         command=lambda: self.app.export_glide_pages([self.entry_id], []))
        menu.add_separator()
        menu.add_command(label='Rückgängig', command=self.undo)
        menu.add_command(label='Wiederholen', command=self.redo)
        self.popup(menu)

    def toggle_width(self):
        self.app.settings['page_full_width'] = not self.app.settings.get('page_full_width')
        self.app.save_settings()
        self._read_pad = None
        self.fit_read_width()

    def popup(self, menu):
        try:
            menu.tk_popup(self.winfo_pointerx(), self.winfo_pointery())
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass

    # --- Werkzeugleiste, Rechtsklick, Formatleiste (29.09.2026, R4) -------
    TOOLBAR_IN_BAND = True
    ALLOW_TASKS = True
    BLOCK_CHOICES = (('Text', 'text'), ('Überschrift 1', 'h1'), ('Überschrift 2', 'h2'),
                     ('Überschrift 3', 'h3'), ('Überschrift 4', 'h4'), ('Aufzählung', 'bullet'),
                     ('Nummerierung', 'number'), ('Aufgabe', 'task'), ('Aufklappliste', 'toggle'),
                     ('Aufklappüberschrift', 'toggle_h2'), ('Zitat', 'quote'), ('Hinweisblock', 'callout'),
                     ('Code', 'codeblock'))
    INLINE_FORMATS = (('Fett', 'bold'), ('Kursiv', 'italic'), ('Unterstrichen', 'underline'),
                      ('Durchgestrichen', 'strike'), ('Code', 'code'), ('Markieren', 'highlight'))

    def block_choices(self):
        return [(label, tag) for label, tag in self.BLOCK_CHOICES if self.ALLOW_TASKS or tag != 'task']

    def toolbar_items(self):
        eintraege = [('Überschrift', self.show_heading_menu),
                     ('Liste', lambda: self.set_block('bullet')),
                     ('Nummeriert', lambda: self.set_block('number'))]
        if self.ALLOW_TASKS:
            eintraege.append((f"{self.app.ICONS['task_open']} Aufgabe", lambda: self.set_block('task')))
        eintraege += [('Zitat', lambda: self.set_block('quote')),
                      ('Code', lambda: self.set_block('codeblock')),
                      ('Bild', self.choose_images),
                      ('Mehr', self.show_page_menu)]
        return eintraege

    def convert_block(self, tag):
        """„Umwandeln in“: Text macht die Zeile schlicht, sonst die gewählte Blockart."""
        self.hide_format_bar()
        if tag == 'text':
            self.clear_line_block()
            self.flush()
            return 'break'
        vorher = self.line_blocks()
        if tag in vorher:
            return 'break'
        return self.set_block(tag)

    def has_selection(self):
        return bool(self.text.tag_ranges('sel'))

    def copy_selection(self, cut=False):
        if not self.has_selection():
            return 'break'
        inhalt = self.text.get('sel.first', 'sel.last').replace(self.IMAGE_ANCHOR, '')
        self.text.clipboard_clear()
        self.text.clipboard_append(inhalt)
        if cut:
            self.text.delete('sel.first', 'sel.last')
            self.flush()
        return 'break'

    def paste_plain(self):
        try:
            content = self.text.clipboard_get()
        except tk.TclError:
            return 'break'
        if not self.flush():
            return 'break'
        if self.has_selection():
            self.text.delete('sel.first', 'sel.last')
        start = self.text.index('insert')
        original_tags = [tag for tag in self.text.tag_names(start) if glide_task_refs.task_id(str(tag))]
        self.text.insert('insert', content)
        if '\n' in content:
            first_end = self.text.index(f'{start} lineend')
            last_end = self.text.index('insert lineend +1c')
            for tag in self.text.tag_names():
                if tag == 'task' or glide_task_refs.task_id(str(tag)):
                    self.text.tag_remove(tag, f'{first_end} +1c', last_end)
            for tag in original_tags:
                self.text.tag_add(tag, f'{start} linestart', first_end)
        self.flush()
        return 'break'

    def select_all(self):
        self.text.tag_add('sel', '1.0', 'end -1c')
        self.text.mark_set('insert', 'end -1c')
        self.text.focus_set()
        return 'break'

    def clear_format(self):
        if not self.has_selection():
            return 'break'
        for _label, tag in self.INLINE_FORMATS:
            self.text.tag_remove(tag, 'sel.first', 'sel.last')
        for tag in [t for t in self.text.tag_names() if str(t).startswith('link')]:
            self.text.tag_remove(tag, 'sel.first', 'sel.last')
        self.flush()
        return 'break'

    def line_offsets(self, index='insert'):
        """Anfang und Ende (einschließlich Umbruch) der Zeile als Zeichenversatz im Dokument."""
        start = self.offset(self.text.index(f'{index} linestart'))
        ende = self.offset(self.text.index(f'{index} lineend'))
        return start, ende + 1

    def _line_is_movable(self, index='insert'):
        zeile = self.text.get(f'{index} linestart', f'{index} lineend')
        return self.IMAGE_ANCHOR not in zeile and 'table' not in self.line_blocks(index)

    def move_line(self, richtung):
        """Verschiebt die aktuelle Zeile samt Format um eine Zeile nach oben oder unten."""
        self.hide_format_bar()
        nachbar = 'insert -1l' if richtung < 0 else 'insert +1l'
        if (self.text.compare(nachbar + ' linestart', '==', 'insert linestart')
                or not self._line_is_movable() or not self._line_is_movable(nachbar)
                or self.text.compare(f'{nachbar} linestart', '>=', 'end -1c')):
            return 'break'
        self.flush()
        dokument = self.document()
        text = dokument['text'] if dokument['text'].endswith('\n') else dokument['text'] + '\n'
        a0, a1 = self.line_offsets('insert')
        b0, b1 = self.line_offsets(nachbar)
        if richtung < 0:
            a0, a1, b0, b1 = b0, b1, a0, a1
        # Jetzt steht Zeile A oben, B darunter; getauscht wird zu B, A.
        neu = text[:a0] + text[b0:b1] + text[a0:b0] + text[b1:]
        laenge_a, laenge_b = a1 - a0, b1 - b0

        spans = []
        for span in dokument['spans']:
            s, e = span['start'], span['end']
            if any(s < grenze < e for grenze in (a0, b0, b1)):
                return 'break'  # Formatbereich über eine Zeilengrenze: nicht zerreißen
            if a0 <= s and e <= b0:
                spans.append(dict(span, start=s + laenge_b, end=e + laenge_b))
            elif b0 <= s and e <= b1:
                spans.append(dict(span, start=s - laenge_a, end=e - laenge_a))
            else:
                spans.append(dict(span))
        links = dict(dokument.get('links') or {})
        dokument = dict(dokument, text=neu.rstrip('\n') if not dokument['text'].endswith('\n') else neu,
                        spans=spans, links=links)
        ziel = (a0 if richtung < 0 else a0 + laenge_b)
        self.load(dokument)
        self.text.mark_set('insert', f'1.0 +{ziel}c')
        self.text.see('insert')
        self.flush()
        return 'break'

    def duplicate_line(self):
        self.hide_format_bar()
        if not self._line_is_movable():
            return 'break'
        start, end = self.line_bounds()
        bloecke = [t for t in self.line_blocks() if t != 'task'] if 'task' in self.line_blocks() else self.line_blocks()
        inhalt = self.text.get(start, end)
        self.text.insert(end, '\n' + inhalt)
        neu = self.text.index(f'{end} +1c linestart')
        for tag in bloecke:
            if not glide_task_refs.task_id(str(tag)):
                self.text.tag_add(tag, neu, f'{neu} lineend +1c')
        self.flush()
        return 'break'

    def delete_line(self):
        self.hide_format_bar()
        if not self._line_is_movable():
            return 'break'
        start = self.text.index('insert linestart')
        ende = self.text.index('insert lineend +1c')
        self.text.delete(start, ende)
        self.flush()
        return 'break'

    def show_context_menu(self, event=None):
        """Rechtsklick im Text: Bearbeiten, Formatieren, Umwandeln, Block."""
        self.hide_format_bar()
        if event is not None:
            punkt = self.text.index(f'@{event.x},{event.y}')
            if not (self.has_selection() and self.text.compare('sel.first', '<=', punkt)
                    and self.text.compare(punkt, '<=', 'sel.last')):
                self.text.tag_remove('sel', '1.0', 'end')
                self.text.mark_set('insert', punkt)
        self.text.focus_set()
        markiert = self.has_selection()
        zustand = 'normal' if markiert else 'disabled'
        menu = self.app._new_themed_popup_menu(self)
        menu.add_command(label='Ausschneiden', command=lambda: self.copy_selection(cut=True), state=zustand)
        menu.add_command(label='Kopieren', command=self.copy_selection, state=zustand)
        menu.add_command(label='Einfügen', command=self.paste)
        menu.add_command(label='Als reinen Text einfügen', command=self.paste_plain)
        menu.add_command(label='Alles markieren', command=self.select_all)
        menu.add_separator()
        self.add_task_menu(menu)
        menu.add_separator()
        formate = self.app._new_themed_popup_menu(menu)
        for label, tag in self.INLINE_FORMATS:
            formate.add_command(label=label, command=lambda t=tag: self.format(t), state=zustand)
        formate.add_command(label='Link …', command=self.insert_link, state=zustand)
        formate.add_separator()
        formate.add_command(label='Formatierung entfernen', command=self.clear_format, state=zustand)
        menu.add_cascade(label='Formatieren', menu=formate)
        umwandeln = self.app._new_themed_popup_menu(menu)
        aktuell = set(self.line_blocks())
        for label, tag in self.block_choices():
            gewaehlt = (tag in aktuell) or (tag == 'text' and not aktuell & {t for _l, t in self.BLOCK_CHOICES})
            umwandeln.add_command(label=('✓ ' if gewaehlt else '   ') + label,
                                  command=lambda t=tag: self.convert_block(t))
        menu.add_cascade(label='Umwandeln in', menu=umwandeln)
        menu.add_separator()
        beweglich = 'normal' if self._line_is_movable() else 'disabled'
        menu.add_command(label='Zeile nach oben', command=lambda: self.move_line(-1), state=beweglich)
        menu.add_command(label='Zeile nach unten', command=lambda: self.move_line(1), state=beweglich)
        menu.add_command(label='Zeile duplizieren', command=self.duplicate_line, state=beweglich)
        menu.add_command(label='Zeile löschen', command=self.delete_line, state=beweglich)
        self.popup(menu)
        return 'break'

    # Schwebende Formatleiste über einer Markierung, wie in Notion.
    FORMAT_BAR_ITEMS = (('B', 'bold'), ('I', 'italic'), ('U', 'underline'), ('S', 'strike'),
                        ('Code', 'code'), ('Markieren', 'highlight'))

    def schedule_format_bar(self):
        try:
            self.after_idle(self.sync_format_bar)
        except tk.TclError:
            pass

    def hide_format_bar(self):
        leiste = getattr(self, '_format_bar', None)
        if leiste is not None:
            try:
                leiste.place_forget()
            except tk.TclError:
                pass

    def sync_format_bar(self):
        if not self.has_selection():
            self.hide_format_bar()
            return
        try:
            box = self.text.bbox('sel.first')
        except tk.TclError:
            box = None
        if not box:
            self.hide_format_bar()
            return
        theme = self.app.theme
        leiste = getattr(self, '_format_bar', None)
        if leiste is None or not leiste.winfo_exists():
            leiste = self._format_bar = tk.Frame(self.text, bg=theme['card'], highlightthickness=1,
                                                 highlightbackground=theme['ui_accent'], bd=0)
            textart = self.app._make_dialog_button(leiste, 'Text ▾', self._format_bar_block_menu, 'muted',
                                                   width=70, height=28)
            textart.pack(side='left', padx=(4, 2), pady=3)
            for label, tag in self.FORMAT_BAR_ITEMS:
                breite = tkfont.Font(font=app_font(10, 'bold')).measure(label) + 22
                knopf = self.app._make_dialog_button(leiste, label, lambda t=tag: self.format(t) or
                                                     self.schedule_format_bar(), 'muted', width=breite, height=28)
                knopf.pack(side='left', padx=2, pady=3)
            self.app._make_dialog_button(leiste, 'Link', self.insert_link, 'muted', width=52,
                                         height=28).pack(side='left', padx=(2, 4), pady=3)
        x, y, _w, _h = box
        leiste.update_idletasks()
        hoehe = leiste.winfo_reqheight()
        # `bbox` misst ab der Innenkante, `place` unter Tk 9 ab dem Rand –
        # `place_at` gleicht das aus wie bei den Bildern.
        oben = y - hoehe - 8 if y - hoehe - 8 > 0 else y + _h + 8
        links = max(0, min(x, self.text.winfo_width() - leiste.winfo_reqwidth() - 40))
        self.place_at(leiste, links, oben)
        leiste.tk.call('raise', leiste._w)

    def _format_bar_block_menu(self):
        menu = self.app._new_themed_popup_menu(self)
        for label, tag in self.block_choices():
            menu.add_command(label=label, command=lambda t=tag: self.convert_block(t))
        self.popup(menu)

    # --- Tippen wie in Notion --------------------------------------------
    KUERZEL = (('####', 'h4'), ('###', 'h3'), ('##', 'h2'), ('#', 'h1'), ('-', 'bullet'), ('*', 'bullet'),
               ('[]', 'task'), ('[ ]', 'task'), ('>', 'quote'))

    def markdown_shortcut(self, event=None):
        start = self.text.index('insert linestart')
        vorher = self.text.get(start, 'insert')
        if self.line_blocks():
            return None
        for kuerzel, tag in self.KUERZEL:
            if tag == 'task' and not self.ALLOW_TASKS:
                continue
            if vorher == kuerzel:
                self.text.delete(start, 'insert')
                return self.set_block(tag)
        if re.fullmatch(r'\d{1,3}\.', vorher):
            self.text.delete(start, 'insert')
            return self.set_block('number')
        return None

    def newline(self, event=None):
        start, end = self.line_bounds()
        zeile = self.text.get(start, end)
        bloecke = self.line_blocks()
        if not bloecke:
            if zeile == '```':
                self.text.delete(start, end)
                return self.set_block('codeblock')
            if zeile in ('---', '***', '___'):
                self.text.delete(start, end)
                return self.insert_divider()
            return None
        if 'codeblock' in bloecke:
            return None
        if 'toggle' in bloecke:
            return self.newline_in_toggle(zeile, bloecke)
        inhalt = re.sub(r'^(' + re.escape(self.app.ICONS['bullet']) + r' |\d+\. )', '', zeile).strip()
        fortsetzen = [tag for tag in bloecke if tag in self.CONTINUING]
        einzug = [t for t in bloecke if t in PAGE_INDENT_TAGS]
        if einzug and not fortsetzen and set(bloecke) <= set(PAGE_INDENT_TAGS):
            # Eingerückte Textzeile (z. B. Inhalt einer Aufklappliste): Enter
            # bleibt im Einzug, auf leerer Zeile rückt Enter aus (wie Notion).
            if not inhalt:
                start, end = self.line_bounds()
                for tag in einzug:
                    self.text.tag_remove(tag, start, f'{end} +1c')
                self.flush()
                return 'break'
            self.text.insert('insert', '\n')
            neue = self.text.index('insert linestart')
            for tag in list(self.LINE_BLOCKS):
                self.text.tag_remove(tag, neue, f'{neue} lineend +1c')
            for tag in einzug:
                self.text.tag_add(tag, neue, f'{neue} lineend +1c')
            self.text.see('insert')
            return 'break'
        if fortsetzen and not inhalt:
            # Leere Listenzeile + Enter beendet die Liste (wie in Notion).
            self.clear_line_block()
            self.flush()
            return 'break'
        self.text.insert('insert', '\n')
        neue = self.text.index('insert linestart')
        for tag in list(self.LINE_BLOCKS) + [t for t in self.text.tag_names() if glide_task_refs.task_id(str(t))]:
            self.text.tag_remove(tag, neue, f'{neue} lineend +1c')
        if fortsetzen:
            einzug = [t for t in bloecke if t in PAGE_INDENT_TAGS]
            self.set_block(fortsetzen[0], neue)
            for tag in einzug:
                self.text.tag_add(tag, neue, f'{neue} lineend +1c')
            self.text.mark_set('insert', f'{neue} lineend')
        self.text.see('insert')
        return 'break'

    def slash_menu(self, event=None):
        start = self.text.index('insert linestart')
        if self.text.get(start, 'insert').strip():
            return None
        menu = self.app._new_themed_popup_menu(self)
        for label, tag in self.block_choices():
            menu.add_command(label=label, command=lambda t=tag: self.set_block(t) if t != 'text' else None)
        menu.add_command(label='Trennlinie', command=self.insert_divider)
        menu.add_command(label='Bild …', command=self.choose_images)
        menu.add_separator()
        menu.add_command(label='Markdown einfügen', command=self.paste_markdown)
        try:
            x, y, _w, h = self.text.bbox('insert')
            menu.tk_popup(self.text.winfo_rootx() + x, self.text.winfo_rooty() + y + h)
        except (TypeError, tk.TclError):
            self.popup(menu)
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass
        return 'break'

    # --- Bilder (27.09.2026) ------------------------------------------------
    # Ein Bild ist ein Anhang der Seite. Im Text steht an seiner Stelle ein
    # unsichtbares Ankerzeichen (U+FFFC) samt Zeilenumbruch in einer eigenen
    # Zeile; das Bild selbst liegt als Fläche über dem Text. Umfluss entsteht
    # über Ränder: Links- bzw. rechtsbündige Bilder geben den Textzeilen neben
    # sich einen Rand in Bildbreite, mittige Bilder einen Abstand über der
    # folgenden Zeile. Tk kennt keinen echten Umfluss; so fügt sich der Text
    # trotzdem um das Bild, bei jeder Breite neu berechnet.
    IMAGE_ANCHOR = '￼'
    IMAGE_GAP = 16
    IMAGE_MIN_WIDTH = 48

    def mark_image_anchors(self):
        """Ankerzeichen und ihr Zeilenumbruch bleiben unsichtbar."""
        text = self.text
        text.tag_remove('imganchor', '1.0', 'end')
        start = '1.0'
        while True:
            fund = text.search(self.IMAGE_ANCHOR, start, stopindex='end')
            if not fund:
                break
            ende = f'{fund} +2c' if text.get(f'{fund} +1c') == '\n' else f'{fund} +1c'
            text.tag_add('imganchor', fund, ende)
            start = f'{fund} +1c'

    def image_keys(self):
        """Bildkennungen in Textreihenfolge."""
        orte = []
        for key in self.images:
            ranges = self.text.tag_ranges(key)
            if ranges:
                orte.append((self.text.index(ranges[0]), key))
        return [key for _ort, key in sorted(orte, key=lambda paar: tuple(map(int, paar[0].split('.'))))]

    def column_bounds(self):
        """Linke Kante und Breite der Lesespalte in Pixeln."""
        breite = max(1, self.text.winfo_width())
        rand = int(float(self.text.cget('padx')))
        return rand, max(120, breite - 2 * rand - 4)

    def image_path(self, key):
        info = self.images.get(key) or {}
        anhang = self.app.page_attachment(self.entry_id, info.get('attachment'))
        pfad = self.app.resolve_attachment_path(anhang) if anhang else None
        return pfad if pfad and os.path.isfile(pfad) else None

    def image_size(self, key, spalte):
        """Anzeigegröße: gespeicherte Breite, höchstens die Spalte, Seitenverhältnis wie das Original."""
        info = self.images.get(key) or {}
        breite = max(self.IMAGE_MIN_WIDTH, min(int(info.get('width') or 320), spalte))
        pfad = self.image_path(key)
        natur = self.app.previews.natural_size(self.text, pfad) if pfad else None
        if natur:
            return breite, max(8, round(breite * natur[1] / natur[0]))
        return breite, max(40, round(breite * 0.62))

    def schedule_image_layout(self, delay=120):
        if self._image_job is not None:
            try:
                self.after_cancel(self._image_job)
            except tk.TclError:
                pass
        self._image_job = self.after(delay, self.layout_images)

    def ypixels(self, a, b):
        try:
            return int(self.text.tk.call(self.text._w, 'count', '-update', '-ypixels', a, b) or 0)
        except (tk.TclError, ValueError):
            return 0

    def image_layout_signature(self, keys, links, spalte):
        """Alles, wovon Ränder und Bildgrößen abhängen (P04).

        Je Bild Modus, Größe und der Text im eigenen Umflussbereich: Tippen
        außerhalb dieser Bereiche ändert keine Anzeigezeile neben einem Bild.
        Dazu Spalte, Schrift, Design und Faltungen. Text vor einem Anker
        verschiebt die Bereiche nur, weil Tk-Marken mit dem Text wandern.
        """
        text = self.text
        teile = []
        for key in keys:
            kennung = key[4:]
            bereich = None
            for praefix in ('imgflow:', 'imgpad:'):
                ranges = text.tag_ranges(praefix + kennung)
                if ranges:
                    bereich = text.get(ranges[0], ranges[-1])
                    break
            ende = text.tag_ranges('imgend:' + kennung)
            if ende:
                bereich = (bereich, text.get(text.tag_ranges(key)[0], 'end'))
            teile.append((key, ((self.images.get(key) or {}).get('mode'), self.image_size(key, spalte), bereich)))
        return ((links, spalte, str(text.cget('font')), id(self.app.theme), tuple(map(str, text.tag_ranges('folded')))),
                dict(teile))

    def layout_images(self):
        """Ränder für den Umfluss setzen und die Bildflächen platzieren."""
        self._image_job = None
        if not self.winfo_exists():
            return
        text = self.text
        keys = self.image_keys()
        links, spalte = self.column_bounds()
        # Seit 08.10.2026 (P04) rechnet das Layout nur, was sich geändert hat:
        # Jede Texteingabe rief es bis dahin nach 120 ms vollständig auf –
        # Ränder aller Bilder löschen, Anzeigezeilen zählen, jedes Bild neu
        # zeichnen. Bleiben Spalte, Schrift, Design, Faltungen und Bildmenge
        # gleich, werden nur die Bilder neu umflossen, deren Größe, Modus oder
        # Umflusstext sich geändert hat. Eine laufende Bildumwandlung erzwingt
        # den vollen Lauf.
        gesamt, teile = self.image_layout_signature(keys, links, spalte)
        vorher = self._image_layout_signature
        geaendert = None
        if (vorher is not None and vorher[0] == gesamt and set(vorher[1]) == set(keys) == set(self._image_views)
                and not any(getattr(view, '_conversion_pending', False) for view in self._image_views.values())):
            geaendert = {key for key in keys if teile[key] != vorher[1][key]}
            if not geaendert:
                self.place_images()
                return
        if geaendert is None:
            for tag in [t for t in text.tag_names() if str(t).startswith(('imgflow:', 'imgpad:', 'imgend:', 'imgpush:'))]:
                text.tag_delete(tag)
            self._image_push = {}
        else:
            for key in geaendert:
                for praefix in ('imgflow:', 'imgpad:', 'imgend:', 'imgpush:'):
                    if praefix + key[4:] in text.tag_names():
                        text.tag_delete(praefix + key[4:])
        for key in list(self._image_views):
            if key not in keys:
                self._image_views.pop(key).destroy()
        if self.selected_image not in keys:
            self.selected_image = None
        for position, key in enumerate(keys):
            if geaendert is not None and key not in geaendert:
                continue
            info = self.images[key]
            breite, hoehe = self.image_size(key, spalte)
            anker = text.index(text.tag_ranges(key)[0])
            kennung = key[4:]
            schub = self.image_push(keys[:position], anker, info['mode'], breite, spalte)
            self._image_push[key] = schub
            if info['mode'] == 'center':
                abstand = 'imgpad:' + kennung
                text.tag_configure(abstand, spacing1=hoehe + 2 * 10 + schub)
                text.tag_add(abstand, anker)
                folgende = text.index(f'{anker} +1l linestart')
                if text.compare(folgende, '>', anker):
                    text.tag_add(abstand, folgende)
            else:
                fluss = 'imgflow:' + kennung
                if info['mode'] == 'left':
                    text.tag_configure(fluss, lmargin1=breite + self.IMAGE_GAP, lmargin2=breite + self.IMAGE_GAP)
                else:
                    text.tag_configure(fluss, rmargin=breite + self.IMAGE_GAP)
                if schub:
                    # Die Ankerzeile rückt unter das vorige Bild; ihr Abstand
                    # zählt im Umfluss mit.
                    text.tag_configure('imgpush:' + kennung, spacing1=schub)
                    text.tag_add('imgpush:' + kennung, anker)
                self.flow_around(fluss, anker, hoehe + 6 + schub, kennung)
            self.render_image(key, breite, hoehe)
            if geaendert is not None and position + 1 < len(keys):
                # Reicht der neue Bereich bis zum nächsten Anker, ändern sich
                # auch dessen Anzeigezeilen: dann auch ihn neu umfließen.
                bereich = text.tag_ranges('imgflow:' + kennung) or text.tag_ranges('imgpad:' + kennung)
                folgend = text.tag_ranges(keys[position + 1])
                if bereich and folgend and text.compare(bereich[-1], '>', folgend[0]):
                    geaendert.add(keys[position + 1])
                    for praefix in ('imgflow:', 'imgpad:', 'imgend:', 'imgpush:'):
                        if praefix + keys[position + 1][4:] in text.tag_names():
                            text.tag_delete(praefix + keys[position + 1][4:])
        for tag in [t for t in text.tag_names() if str(t).startswith(('imgflow:', 'imgpad:', 'imgend:', 'imgpush:'))]:
            text.tag_raise(tag)
        self._image_layout_signature = self.image_layout_signature(keys, links, spalte)
        self.place_images()

    # Bilder weiter oben als diese Pixelzahl über dem Anker können nicht mehr
    # hineinreichen; bis dahin wird rückwärts gesucht.
    IMAGE_PUSH_REACH = 1600

    def image_push(self, vorige, anker, modus, breite, spalte):
        """Abstand, damit ein Bild kein vorheriges überlappt (B4 seit 3.34.0).

        Ein Bild auf derselben Seite, ein zentriertes Bild oder zwei Bilder,
        die zusammen breiter als die Spalte sind, dürfen nicht nebeneinander
        stehen: Das spätere weicht unter das frühere aus. Gemessen wird nur
        rückwärts bis `IMAGE_PUSH_REACH` Pixel – das hält das Teil-Layout (P04)
        schnell.
        """
        text = self.text
        versatz = 10 if modus == 'center' else 2
        noetig = 0
        for frueher in reversed(vorige):
            ranges = text.tag_ranges(frueher)
            if not ranges:
                continue
            abstand = self.ypixels(ranges[0], anker)
            if abstand > self.IMAGE_PUSH_REACH:
                break
            info = self.images.get(frueher) or {}
            b, h = self.image_size(frueher, spalte)
            unten = self._image_push.get(frueher, 0) + (10 if info.get('mode') == 'center' else 2) + h + 8
            neben = (info.get('mode') == modus or 'center' in (info.get('mode'), modus)
                     or b + breite + self.IMAGE_GAP > spalte)
            if neben and unten > abstand + versatz:
                noetig = max(noetig, unten - abstand - versatz)
        return noetig

    def flow_around(self, fluss, anker, hoehe, kennung):
        """Rand für alle Anzeigezeilen neben dem Bild – nicht mehr und nicht weniger."""
        text = self.text
        grenze = text.index(f'{anker} +{max(6, hoehe // 14 + 6)} lines lineend +1c')
        for _runde in range(8):
            text.tag_add(fluss, anker, grenze)
            zeile = anker
            schnitt = None
            while True:
                naechste = text.index(f'{zeile} +1 display lines')
                naechste = text.index(f'{naechste} display linestart')
                if not text.compare(naechste, '>', zeile):
                    break
                if self.ypixels(anker, naechste) >= hoehe:
                    schnitt = naechste
                    break
                zeile = naechste
                if text.compare(naechste, '>=', grenze):
                    break
            if schnitt is not None:
                text.tag_remove(fluss, schnitt, 'end')
                return
            if text.compare(grenze, '>=', 'end -1c'):
                break
            grenze = text.index(f'{grenze} +{max(6, hoehe // 14 + 6)} lines lineend +1c')
        # Die Seite endet neben dem Bild: Die letzte Zeile bekommt so viel
        # Abstand nach unten, dass das Bild ganz auf die Seite passt.
        rest = hoehe - self.ypixels(anker, 'end -1c')
        if rest > 0:
            ende = 'imgend:' + kennung
            text.tag_configure(ende, spacing3=rest + 12)
            text.tag_add(ende, 'end -1c linestart')

    def image_view(self, key):
        view = self._image_views.get(key)
        if view is not None and view.winfo_exists():
            return view
        theme = self.app.theme
        view = tk.Canvas(self.text, highlightthickness=0, bd=0, bg=theme['card'], cursor='fleur', takefocus=1)
        view._image_key = key
        view.bind('<ButtonPress-1>', lambda e, k=key: self.image_press(k, e))
        view.bind('<B1-Motion>', lambda e, k=key: self.image_motion(k, e))
        view.bind('<ButtonRelease-1>', lambda e, k=key: self.image_release(k, e))
        view.bind('<Double-Button-1>', lambda e, k=key: self.open_image_external(k))
        for sequenz in ('<Button-3>',) + (('<Button-2>',) if IS_MACOS else ()):
            view.bind(sequenz, lambda e, k=key: self.image_menu(k, e))
        for sequenz in ('<Delete>', '<BackSpace>'):
            view.bind(sequenz, lambda e, k=key: self.remove_image(k))
        view.bind('<Escape>', lambda e: self.select_image(None))
        for sequenz, modus in (('<Left>', 'left'), ('<Right>', 'right'), ('<Up>', 'center')):
            view.bind(f'<Alt-{sequenz[1:]}', lambda e, k=key, m=modus: self.set_image_mode(k, m))
        # Das Mausrad über einem Bild scrollt die Seite, nicht das Bild.
        self.app.bind_mousewheel(view, self.text)
        self._image_views[key] = view
        return view

    def render_image(self, key, breite, hoehe):
        view = self.image_view(key)
        theme = self.app.theme
        pfad = self.image_path(key)
        # Unveränderte Darstellung nicht neu zeichnen (P04).
        darstellung = (breite, hoehe, pfad, key == self.selected_image, (self.images.get(key) or {}).get('mode'),
                       id(theme), (self.images.get(key) or {}).get('attachment'))
        if getattr(view, '_render_signature', None) == darstellung and not getattr(view, '_conversion_pending', False):
            return
        view.configure(width=breite, height=hoehe)
        view.delete('all')
        view._size = (breite, hoehe)
        view._render_signature = darstellung
        view._conversion_pending = False
        bild = None
        if pfad:
            vorschau = self.app.previews
            if vorschau.needs_conversion(view, pfad):
                view._conversion_pending = True
                self.after(40, lambda p=pfad: (vorschau.convert(p), self.schedule_image_layout(0)))
            else:
                bild = vorschau.image(view, pfad, width=breite)
        view._photo = bild
        if bild is not None:
            view.create_image(0, 0, anchor='nw', image=bild)
        else:
            view.create_rectangle(0, 0, breite - 1, hoehe - 1, fill=theme['input'], outline=theme['line'])
            name = (self.app.page_attachment(self.entry_id, (self.images.get(key) or {}).get('attachment')) or {}).get('name')
            view.create_text(breite // 2, hoehe // 2, width=breite - 16, fill=theme['muted'], font=app_font(10),
                             text=(f'{name}\nKeine Vorschau' if name else 'Bild fehlt'), justify='center')
        if key == self.selected_image:
            view.create_rectangle(1, 1, breite - 2, hoehe - 2, outline=theme['ui_accent'], width=2)
            griff_x = 0 if self.images[key]['mode'] == 'right' else breite - 12
            view.create_rectangle(griff_x, hoehe - 12, griff_x + 12, hoehe, fill=theme['ui_accent'],
                                  outline=theme['card'], tags=('griff',))

    def line_top(self, index):
        """y der Anzeigezeile von `index` im Textfeld – auch außerhalb des Sichtbereichs."""
        text = self.text
        info = text.dlineinfo(index)
        if info:
            return info[1]
        oben = text.index('@0,0')
        oben_info = text.dlineinfo(oben)
        return (oben_info[1] if oben_info else 0) + self.ypixels(f'{oben} display linestart', index)

    def place_origin(self):
        """Wo `place(x=0, y=0)` im Textfeld landet.

        Tk 9 zählt den Innenabstand (padx/pady) des Textfelds zum Rand, an dem
        `place` ansetzt; ältere Tk-Versionen nicht. Gemessen statt vermutet.

        Hänger vom 30.09.2026 (Seite mit Bildern): Bis dahin wurde je
        Innenabstand neu gemessen, mit `update_idletasks()`. Das löste den
        `yscrollcommand` aus, der `place_images` und damit wieder diese
        Messung rief – verschachtelt, bis Pythons Stapel voll war. Jetzt wird
        einmal je Programmlauf gemessen, *ob* Tk den Innenabstand mitzählt;
        danach wird nur gerechnet. Eine Messung, die sich selbst erneut
        auslösen würde, bekommt sofort die Rechnung.
        """
        padx, pady = int(float(self.text.cget('padx'))), int(float(self.text.cget('pady')))
        zaehlt = PageEditor._padding_counts
        if zaehlt is None and not PageEditor._measuring_origin:
            PageEditor._measuring_origin = True
            probe = tk.Frame(self.text, width=1, height=1, bg=self.app.theme['card'])
            probe.place(x=0, y=0)
            try:
                self.text.update_idletasks()
                x, y = probe.winfo_x(), probe.winfo_y()
                zaehlt = PageEditor._padding_counts = (x == padx and padx > 0, y == pady and pady > 0)
            except tk.TclError:
                zaehlt = None
            finally:
                PageEditor._measuring_origin = False
                try:
                    probe.destroy()
                except tk.TclError:
                    pass
        if zaehlt is None:
            # Während der Messung: Tk 9 zählt den Innenabstand, ältere nicht.
            zaehlt = (tk.TkVersion >= 9, tk.TkVersion >= 9)
        return (padx if zaehlt[0] else 0, pady if zaehlt[1] else 0)

    def place_at(self, widget, x, y, **optionen):
        dx, dy = self.place_origin()
        widget.place(x=x - dx, y=y - dy, **optionen)

    def place_images(self):
        if not self._image_views or self._image_drag is not None:
            return
        text = self.text
        links, spalte = self.column_bounds()
        hoehe_feld = text.winfo_height()
        for key, view in list(self._image_views.items()):
            ranges = text.tag_ranges(key)
            if not ranges or not hasattr(view, '_size'):
                view.place_forget()
                continue
            breite, hoehe = view._size
            modus = self.images[key]['mode']
            y = self.line_top(ranges[0]) + self._image_push.get(key, 0) + (10 if modus == 'center' else 2)
            if y > hoehe_feld or y + hoehe < 0:
                view.place_forget()
                continue
            x = links if modus == 'left' else links + spalte - breite if modus == 'right' \
                else links + (spalte - breite) // 2
            self.place_at(view, x, y)

    # Bedienung --------------------------------------------------------------
    def select_image(self, key):
        if key == self.selected_image:
            return
        vorher, self.selected_image = self.selected_image, key
        links, spalte = self.column_bounds()
        for kennung in (vorher, key):
            if kennung in self._image_views and kennung in self.images:
                self.render_image(kennung, *self.image_size(kennung, spalte))
        if key is not None:
            self._image_views[key].focus_set()

    def image_press(self, key, event):
        self.flush()
        self.select_image(key)
        view = self._image_views[key]
        breite, hoehe = view._size
        am_griff = event.y >= hoehe - 14 and (event.x <= 14 if self.images[key]['mode'] == 'right'
                                              else event.x >= breite - 14)
        self._image_drag = {'key': key, 'art': 'groesse' if am_griff else 'warten', 'x': event.x_root,
                            'y': event.y_root, 'breite': breite, 'hoehe': hoehe,
                            'dx': event.x, 'dy': event.y, 'marke': None}
        return 'break'

    def image_motion(self, key, event):
        zug = self._image_drag
        if not zug or zug['key'] != key:
            return 'break'
        view = self._image_views[key]
        links, spalte = self.column_bounds()
        dx, dy = event.x_root - zug['x'], event.y_root - zug['y']
        if zug['art'] == 'groesse':
            richtung = -1 if self.images[key]['mode'] == 'right' else 1
            if self.images[key]['mode'] == 'center':
                richtung = 2
            breite = max(self.IMAGE_MIN_WIDTH, min(spalte, zug['breite'] + richtung * dx))
            hoehe = max(8, round(breite * zug['hoehe'] / max(1, zug['breite'])))
            zug['neu'] = breite
            view.configure(width=breite, height=hoehe)
            # Beim Ziehen nur Rahmen und das zuletzt gerechnete Bild; neu
            # gerechnet wird höchstens alle IMAGE_DRAG_RENDER_MS und endgültig
            # beim Loslassen. Bis 29.09.2026 rechnete jede Mausbewegung das Bild
            # neu, und das Ziehen ruckelte (Befund R7).
            view.delete('rahmen')
            view._render_signature = None
            view.create_rectangle(1, 1, breite - 2, hoehe - 2, outline=self.app.theme['ui_accent'], width=2,
                                  tags=('rahmen',))
            if zug.get('render_job') is None:
                zug['render_job'] = self.after(self.IMAGE_DRAG_RENDER_MS,
                                               lambda k=key, v=view: self._render_drag_image(k, v))
            return 'break'
        if zug['art'] == 'warten' and abs(dx) + abs(dy) < 6:
            return 'break'
        zug['art'] = 'ziehen'
        x = event.x_root - self.text.winfo_rootx()
        y = event.y_root - self.text.winfo_rooty()
        self.place_at(view, x - zug['dx'], y - zug['dy'])
        view.tk.call('raise', view._w)  # Canvas.lift meint Canvas-Elemente
        ziel, modus = self.image_drop_target(x, y)
        zug['ziel'], zug['modus'] = ziel, modus
        marke = zug.get('marke')
        if marke is None:
            marke = zug['marke'] = tk.Frame(self.text, bg=self.app.theme['ui_accent'])
        oben = self.line_top(ziel)
        if modus == 'center':
            self.place_at(marke, links, max(0, oben - 2), width=spalte, height=3)
        else:
            self.place_at(marke, links if modus == 'left' else links + spalte - 3, max(0, oben), width=3,
                          height=max(24, zug['hoehe']))
        return 'break'

    IMAGE_DRAG_RENDER_MS = 120

    def _render_drag_image(self, key, view):
        zug = self._image_drag
        if not zug or zug.get('key') != key:
            return
        zug['render_job'] = None
        breite = zug.get('neu')
        if not breite:
            return
        try:
            hoehe = int(view.cget('height'))
            pfad = self.image_path(key)
            bild = self.app.previews.image(view, pfad, width=breite) if pfad else None
            view.delete('all')
            # Die Ziehdarstellung ersetzt die gemerkte; beim Loslassen neu zeichnen (P04).
            view._render_signature = None
            view._photo_drag = bild
            if bild is not None:
                view.create_image(0, 0, anchor='nw', image=bild)
            view.create_rectangle(1, 1, breite - 2, hoehe - 2, outline=self.app.theme['ui_accent'], width=2,
                                  tags=('rahmen',))
        except tk.TclError:
            pass

    def image_drop_target(self, x, y):
        """Zeile und Umfluss für einen Ablagepunkt: links, mittig oder rechts in der Spalte."""
        links, spalte = self.column_bounds()
        index = self.text.index(f'@{links + 4},{max(0, y)}')
        ziel = self.text.index(f'{index} linestart')
        anteil = (x - links) / max(1, spalte)
        modus = 'left' if anteil < 0.34 else 'right' if anteil > 0.66 else 'center'
        return ziel, modus

    def image_release(self, key, event):
        zug, self._image_drag = self._image_drag, None
        if not zug or zug['key'] != key:
            return 'break'
        if zug.get('render_job') is not None:
            try:
                self.after_cancel(zug['render_job'])
            except tk.TclError:
                pass
        if zug.get('marke') is not None:
            zug['marke'].destroy()
        if zug['art'] == 'groesse' and zug.get('neu'):
            self.images[key]['width'] = int(zug['neu'])
            self.flush()
            self.layout_images()
        elif zug['art'] == 'ziehen' and zug.get('ziel'):
            self.move_image(key, zug['ziel'], zug['modus'])
        else:
            self.place_images()
        return 'break'

    def anchor_range(self, key):
        """(Start, Ende) des Ankers samt unsichtbarem Zeilenumbruch."""
        ranges = self.text.tag_ranges(key)
        if not ranges:
            return None
        start = self.text.index(ranges[0])
        ende = f'{start} +2c' if self.text.get(f'{start} +1c') == '\n' else f'{start} +1c'
        return start, self.text.index(ende)

    def insert_anchor(self, key, index):
        """Setzt den Anker als eigene Zeile vor die Zeile von `index`."""
        text = self.text
        ziel = text.index(f'{index} linestart')
        if text.compare(ziel, '>', 'end -1c'):
            # Hinter dem letzten Zeichen: erst eine neue letzte Zeile, sonst
            # landete der Anker mitten in der vorhandenen.
            text.insert('end -1c', '\n')
            ziel = text.index('end -1c linestart')
        text.insert(ziel, self.IMAGE_ANCHOR, (key, 'imganchor'))
        text.insert(f'{ziel} +1c', '\n', ('imganchor',))
        # Zeilenformate der Zielzeile dürfen nicht auf den Anker übergehen.
        for tag in text.tag_names(ziel):
            if tag not in (key, 'imganchor'):
                text.tag_remove(tag, ziel, f'{ziel} +2c')

    def move_image(self, key, ziel, modus):
        text = self.text
        bereich = self.anchor_range(key)
        if bereich is None:
            return
        text.mark_set('glide_bildziel', ziel)
        text.mark_gravity('glide_bildziel', 'left')
        if not (text.compare(bereich[0], '<=', 'glide_bildziel') and text.compare('glide_bildziel', '<', bereich[1])):
            text.delete(*bereich)
            self.insert_anchor(key, 'glide_bildziel')
        text.mark_unset('glide_bildziel')
        self.images[key]['mode'] = modus
        self.flush()
        self.layout_images()
        self.select_image(key)

    def set_image_mode(self, key, modus):
        if key in self.images and self.images[key]['mode'] != modus:
            self.images[key]['mode'] = modus
            self.flush()
            self.layout_images()
        return 'break'

    def set_image_width(self, key, breite):
        if key in self.images:
            low, high = self.IMAGE_WIDTH_RANGE
            self.images[key]['width'] = max(low, min(high, int(breite)))
            self.flush()
            self.layout_images()

    def remove_image(self, key):
        bereich = self.anchor_range(key)
        if bereich is not None:
            self.text.delete(*bereich)
        self.images.pop(key, None)
        view = self._image_views.pop(key, None)
        if view is not None:
            view.destroy()
        self.selected_image = None
        self.flush()
        self.layout_images()
        self.text.focus_set()
        self.status.configure(text='Bild entfernt – Rückgängig holt es zurück.')
        return 'break'

    def open_image_external(self, key):
        pfad = self.image_path(key)
        if pfad:
            self.app.open_external_path(pfad)
        return 'break'

    def image_menu(self, key, event):
        self.select_image(key)
        menu = self.app._new_themed_popup_menu(self)
        modus = self.images[key]['mode']
        for label, wert in (('Links, Text fließt rechts vorbei', 'left'), ('Rechts, Text fließt links vorbei', 'right'),
                            ('Eigene Zeile, mittig', 'center')):
            menu.add_command(label=('✓ ' if wert == modus else '   ') + label,
                             command=lambda w=wert: self.set_image_mode(key, w))
        menu.add_separator()
        links, spalte = self.column_bounds()
        pfad = self.image_path(key)
        natur = self.app.previews.natural_size(self.text, pfad) if pfad else None
        menu.add_command(label='Spaltenbreite', command=lambda: self.set_image_width(key, spalte))
        menu.add_command(label='Halbe Breite', command=lambda: self.set_image_width(key, spalte // 2))
        if natur:
            menu.add_command(label=f'Originalgröße ({natur[0]} × {natur[1]})',
                             command=lambda: self.set_image_width(key, natur[0]))
        menu.add_separator()
        menu.add_command(label='Im System öffnen', command=lambda: self.open_image_external(key))
        menu.add_command(label='Bild entfernen', command=lambda: self.remove_image(key),
                         foreground=self.app.theme['delete'])
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            try:
                menu.grab_release()
            except tk.TclError:
                pass
        return 'break'

    def choose_images(self):
        pfade = filedialog.askopenfilenames(parent=self, title='Bild einfügen',
                                            filetypes=[('Bilder', glide_image_preview.FILE_PATTERN),
                                                       ('Alle Dateien', '*.*')])
        if pfade:
            self.insert_images(list(pfade), 'insert')
        return 'break'

    def drop_files(self, pfade, event=None):
        """Aus Finder/Explorer gezogene Bilder landen an der Zeile unter dem Zeiger."""
        bilder = [pfad for pfad in pfade if glide_image_preview.is_image_name(pfad)]
        if not bilder:
            self.status.configure(text='Nur Bilder lassen sich in eine Seite ziehen.')
            return
        index = 'insert'
        x_root, y_root = getattr(event, 'x_root', None), getattr(event, 'y_root', None)
        if isinstance(x_root, int) and isinstance(y_root, int):
            index = self.text.index(f'@{x_root - self.text.winfo_rootx()},{y_root - self.text.winfo_rooty()}')
        self.insert_images(bilder, index)

    def insert_images(self, pfade, index='insert'):
        """Bilder als Anhänge der Seite ablegen und vor der Zeile von `index` einsetzen."""
        self.flush()
        self.text.mark_set('glide_bildziel', self.text.index(f'{index} linestart'))
        self.text.mark_gravity('glide_bildziel', 'left')
        anhaenge = self.app.add_page_images(self.entry_id, pfade)
        if not anhaenge:
            return []
        links, spalte = self.column_bounds()
        neu = []
        for anhang in anhaenge:
            key = 'img:' + uuid.uuid4().hex[:16]
            pfad = self.app.resolve_attachment_path(anhang)
            natur = self.app.previews.natural_size(self.text, pfad) if pfad else None
            breite = min(natur[0], spalte) if natur else min(360, spalte)
            # Kleine Bilder stehen links im Text, große füllen die Spalte.
            modus = 'left' if breite <= spalte * 0.55 else 'center'
            self.images[key] = {'attachment': anhang['id'], 'mode': modus, 'width': max(self.IMAGE_MIN_WIDTH, breite)}
            self.insert_anchor(key, 'glide_bildziel')
            self.text.mark_set('glide_bildziel', f'glide_bildziel +2c')
            neu.append(key)
        self.text.mark_unset('glide_bildziel')
        self.flush()
        self.layout_images()
        if neu:
            self.select_image(neu[-1])
        self.status.configure(text='1 Bild eingefügt' if len(neu) == 1 else f'{len(neu)} Bilder eingefügt')
        return neu

    # --- Einfügen ---------------------------------------------------------
    def paste(self, event=None):
        try:
            inhalt = self.clipboard_get()
        except tk.TclError:
            return None
        if glide_page_markdown.looks_like_markdown(inhalt):
            self.insert_markdown(inhalt)
            return 'break'
        return self.paste_plain()

    def paste_markdown(self):
        try:
            inhalt = self.clipboard_get()
        except tk.TclError:
            inhalt = ''
        if not inhalt.strip():
            self.status.configure(text='Die Zwischenablage enthält keinen Text.')
            return 'break'
        self.insert_markdown(inhalt)
        return 'break'

    def insert_markdown(self, markdown):
        """Alle eingefügten Aufgaben und der Text sind ein gemeinsamer Schritt."""
        if not self.flush():
            return 'break'
        self._flushing_tasks = True
        try:
            with self.task_change() as change:
                neu = self.app.page_document_from_markdown(markdown, self.entry_id)
                dokument = self.document()
                mapping = {tag: 'link:' + uuid.uuid4().hex for tag in neu['links']}
                self.load(glide_page_markdown.insert_blocks(dokument, neu, self.offset('insert'), mapping))
                RichNoteEditor.flush(self)
        finally:
            self._flushing_tasks = False
        if change.saved is not False:
            self.status.configure(text='Markdown eingefügt')
        return 'break'


class NoteEditor(PageEditor):
    """Der Notiztext mit dem Seiteneditor (Entscheidung vom 29.09.2026, R5).

    Notizen schreiben sich wie Seiten: ruhige Lesespalte mit Abständen,
    Markdown-Kürzel, „/“, Bilder, Rechtsklick und Formatleiste. Zwei
    Unterschiede bleiben:

    - Aufgaben im Text sind dieselben Punkte wie in der Notizliste;
      Verweise auf fremde Aufgaben behalten deren Heimat (Format 21).
    - Die Werkzeuge stehen über dem Text in der Karte, denn über der Notiz
      stehen Eingabe- und Suchzeile. „Mehr“ bietet die Notizwerkzeuge:
      Zeitstempel, Tagesabschnitt, Schreibimpuls, Präsentieren.

    Das Dokumentformat ist dasselbe wie vorher; bestehende Notizen öffnen
    unverändert.
