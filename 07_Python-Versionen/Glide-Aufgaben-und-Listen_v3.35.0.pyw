        "restored": ("check", "Wiederhergestellt", "{n} wiederhergestellt"),
        "undone": ("repeat", "Rückgängig", "Rückgängig"),
        "grouped": ("group", "Gruppiert", "{n} Punkte gruppiert"),
        "duplicated": ("check", "Dupliziert", "{n} dupliziert"),
        "moved": ("list", "Verschoben", "{n} verschoben"),
        "pinned": ("board", "Angeheftet", "{n} angeheftet"),
        "unpinned": ("board", "Von der Pinnwand", "{n} von der Pinnwand"),
        "card_created": ("board", "Karte angelegt", "{n} Karten angelegt"),
        "connected": ("board", "Verbunden", "{n} verbunden"),
        "disconnected": ("board", "Verbindung gelöst", "{n} Verbindungen gelöst"),
        "labelled": ("labels", "Label gesetzt", "{n} Labels gesetzt"),
        "due_set": ("calendar", "Termin gesetzt", "{n} Termine gesetzt"),
        "planned": ("planday", "Eingeplant", "{n} eingeplant"),
