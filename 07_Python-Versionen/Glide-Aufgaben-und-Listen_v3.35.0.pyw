def _ensure_streams():
    """Sorgt dafür, dass `stdout` und `stderr` immer beschreibbar sind.

    Glide startet als `.pyw`, also unter
    `pythonw.exe` – und dort sind `sys.stdout` und `sys.stderr` `None`. Tkinter
    meldet jeden Fehler aus einem Callback über
    `traceback.print_exception(..., file=sys.stderr)`. Ist dieser Strom `None`,
    scheitert die Fehlermeldung selbst mit einem `AttributeError`, und zwar
    innerhalb des Tcl-Aufrufs. Der Interpreter bekommt damit einen Fehler in
    der Fehlerbehandlung; die Ereignisschleife verarbeitet nichts mehr, das
    Fenster wird nicht mehr neu gezeichnet – und Windows füllt die stehen
    gebliebene Fläche weiß. Genau das ist das Bild, das ein Benutzer als
    „obere Leiste wird weiß und die App reagiert nicht mehr" beschreibt.

    Deshalb bekommt der Prozess vor allem anderen zwei Ströme, die schlucken
    statt zu scheitern. Der eigentliche Fehler wird davon nicht verdeckt: Er
    landet über `ListApp.report_callback_exception` im Fehlerprotokoll.
    """
    for name in ("stdout", "stderr"):
        strom = getattr(sys, name, None)
        if strom is None or not hasattr(strom, "write"):
            setattr(sys, name, io.StringIO())


_ensure_streams()

