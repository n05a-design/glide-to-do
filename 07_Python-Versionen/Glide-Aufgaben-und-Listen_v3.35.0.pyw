    def sync_view_chrome(self):
        """Blendet Eingabezeile und Knopfleisten aus, wo sie keine Funktion haben.

        In den abgeleiteten Ansichten und im Papierkorb meldete die Eingabezeile
        beim Absenden nur, dass hier nichts angelegt werden kann; im Papierkorb
        standen außerdem „Wichtigkeit“, „Fällig“, „Kopieren“ und weitere Knöpfe
        ohne Wirkung (Rückmeldung 26.09.2026, Form folgt Funktion).
        """
        eingabe = getattr(self, "input_frame", None)
        if eingabe is None:
            return
        seite = bool(self.view_mode == "list" and self.lists and self.is_page_list(self.current_list()))
        ohne_eingabe = seite or self.view_mode in self.DERIVED_ITEM_VIEWS + ("trash", self.GLOBAL_BOARD_VIEW)
        suche = getattr(self, "search_frame", None)
        # Eine Seite braucht auch die Suchzeile nicht: Die Suche filtert
        # Punkte, und die stehen in der Seite selbst (27.09.2026).
        zeilen = [(eingabe, ohne_eingabe)]
        if suche is not None:
            zeilen.append((suche, seite))
        reihenfolge = [widget for widget in (eingabe, suche, getattr(self, "list_frame_outer", None))
                       if widget is not None]
        # Startseite, Verlauf, Seitenübersicht, Vorlagen und Bibliothek haben
        # die Listenoberfläche gerade ausgeblendet (`update_home_visibility`).
        # Was hier einzupacken wäre, bleibt gemerkt, bis die Liste zurückkommt.
        # Bis 29.09.2026 landete die Eingabezeile nach „Mein Tag“ sonst unter
        # der Startseite (Rückmeldung mit Bildschirmfoto).
        startrahmen = getattr(self, "home_frame", None)
        try:
            seitenansicht = startrahmen is not None and startrahmen.winfo_manager() == "pack"
        except tk.TclError:
            seitenansicht = False
        gemerkt = getattr(self, "_view_chrome_saved", None)
        if gemerkt is None:
            gemerkt = self._view_chrome_saved = {}
        try:
            for widget, weg in zeilen:
                if weg and widget.winfo_manager() == "pack":
                    gemerkt[str(widget)] = widget.pack_info()
                    widget.pack_forget()
            for widget, weg in zeilen:
                info = gemerkt.get(str(widget))
                if weg or info is None or widget.winfo_manager() or seitenansicht:
                    continue
                gemerkt.pop(str(widget), None)
                info = dict(info)
                # Vor den ersten sichtbaren Nachfolger in der festen Reihenfolge.
                nachfolger = next((nachbar for nachbar in reihenfolge[reihenfolge.index(widget) + 1:]
                                   if nachbar.winfo_manager() == "pack"
                                   and nachbar.pack_info().get("in") is info.get("in")), None)
                if nachfolger is not None:
                    info["before"] = nachfolger
                widget.pack(**info)
        except tk.TclError:
            pass
        self.sync_selection_bar()

    @staticmethod
    def safe_filename(value):
        cleaned = "".join(char if char.isalnum() or char in (" ", "-", "_") else "_" for char in value)
        cleaned = "_".join(cleaned.strip().split())
        return cleaned.lower() or "meine_liste"

    def clamp_geometry(self, geom):
        """Hält eine gespeicherte Fenstergeometrie auf dem sichtbaren Bildschirm.

        Nach einem Monitorwechsel – etwa Notebook ohne angeschlossenes Dock –
        zeigt eine gespeicherte Position sonst auf einen Bereich, den es nicht
        mehr gibt; das Fenster wäre unsichtbar.
        """
        match = re.match(r"^(\d+)x(\d+)(?:([+-]\d+)([+-]\d+))?$", str(geom or "").strip())
        if not match:
            return None
        width = int(match.group(1))
        height = int(match.group(2))
        if match.group(3) is None:
            return f"{width}x{height}"
        x = int(match.group(3))
        y = int(match.group(4))
        try:
            screen_w = self.root.winfo_screenwidth()
            screen_h = self.root.winfo_screenheight()
        except tk.TclError:
            return f"{width}x{height}"
        # Mindestens ein sichtbarer Fensterstreifen muss auf dem Bildschirm liegen.
        visible_margin = 120
        x = max(-(width - visible_margin), min(x, screen_w - visible_margin))
        y = max(0, min(y, screen_h - visible_margin))
        return f"{width}x{height}+{x}+{y}"

    def restore_window_position(self):
        geom_file = os.path.join(BASE_DIR, "window.conf")
        default_geometry = "980x740"
        min_restore_width = 820
        min_restore_height = 660
        try:
            if os.path.exists(geom_file):
                with open(geom_file, "r", encoding="utf-8") as f:
                    geom = f.read().strip()
                match = re.match(r"^(\d+)x(\d+)", geom or "")
                if match:
                    width = int(match.group(1))
                    height = int(match.group(2))
                    safe_geometry = self.clamp_geometry(geom)
                    if width >= min_restore_width and height >= min_restore_height and safe_geometry:
                        self.root.geometry(safe_geometry)
                    else:
                        # Alte, zu kleine Fenstergrößen aus früheren Versionen würden die Aktionsleisten abschneiden.
                        self.root.geometry(default_geometry)
                else:
                    self.root.geometry(default_geometry)
        except Exception:
            self.root.geometry(default_geometry)
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def on_close(self):
        # Ein zweiter Aufruf – Cmd+Q während der Speicherabfrage oder ein von
        # macOS nachgereichtes Beenden – fand bis 3.30 ein zerstörtes Fenster
        # vor: `open(…, "w")` leerte window.conf, bevor die Fenstergröße
        # scheiterte, und der nächste Start verlor die Fensterposition.
        if getattr(self, "_closing", False):
            return
        try:
            if not self.root.winfo_exists():
                return
        except tk.TclError:
            return
        self._closing = True
        closed = False
        try:
            closed = self._close_after_confirmation()
        finally:
            if not closed:
                self._closing = False

    def _close_after_confirmation(self):
        """Fragt offene Änderungen ab und schließt; False, wenn abgebrochen wurde."""
        self.flush_rich_note()
        if (getattr(self, "_templates_editing", False) and
                self.templates != getattr(self, "_templates_before_edit", self.templates)):
            answer = self.ask_yes_no_cancel("Vorlagen speichern", "Die bearbeiteten Vorlagen vor dem Schließen speichern?")
            if answer is None:
                return False
            if answer and not self.save_templates():
                self.show_error("Vorlagen speichern", "Die Vorlagen konnten nicht gespeichert werden.")
                return False
        if getattr(self, "dirty", False):
            retry = self.ask_yes_no_cancel(
                "Ungespeicherte Änderungen",
                "Die letzten Änderungen konnten noch nicht gespeichert werden.\n\n"
                "Jetzt erneut speichern?",
            )
            if retry is None:
                return False
            if retry:
                if not self.save_items():
                    return False
            elif not self.ask_yes_no(
                "Ohne Speichern schließen",
                "Glide wirklich schließen? Die ungespeicherten Änderungen gehen verloren.",
            ):
                return False
        timer = self.running_timer()
        if timer and timer.get("focus") and timer.get("started_at") and not self.settings.get("time_booking"):
            self.settings["time_tracking"] = glide_focus.pause(timer, datetime.now().astimezone())
            if not self.save_settings(show_error=True):
                self.settings["time_tracking"] = timer
                return False
        self.save_window_geometry()
        self.cancel_pending_callbacks()
        self.release_data_lock()
        self.root.destroy()
        return True

    def save_window_geometry(self):
        """Fenstergröße für den nächsten Start sichern, ohne je eine leere Datei zu hinterlassen."""
        if getattr(self, "_data_read_only", False):
            return
        try:
            geometry = self.root.geometry()
        except tk.TclError:
            return
        temporary = None
        try:
            handle, temporary = tempfile.mkstemp(prefix=".glide-window-", suffix=".tmp", dir=BASE_DIR)
            with os.fdopen(handle, "w", encoding="utf-8") as file:
                file.write(geometry)
            os.replace(temporary, os.path.join(BASE_DIR, "window.conf"))
            temporary = None
        except OSError:
            pass
        finally:
            if temporary:
                try:
                    os.remove(temporary)
                except OSError:
                    pass

    def current_focus_widget(self):
        """Fokus-Widget ohne Ausnahme.

        focus_get() wirft KeyError, sobald der Fokus auf einem Fenster liegt,
        das Tk selbst erzeugt hat (native Dialoge, gepostete Menüs).
        """
        try:
            return self.root.focus_get()
        except (KeyError, tk.TclError):
            return None

    # Fehlerbericht statt Stillstand.
    #
    # Beobachtet wurde: Die App reagiert nicht mehr, die Kopfleiste bleibt im
    # Dunkelmodus weiß. Das ist kein Farbfehler, sondern das Bild einer
    # stehenden Ereignisschleife – Windows zeichnet die Fläche eines Fensters
    # weiß, das seine Nachrichten nicht mehr verarbeitet. Die Ursache liegt
    # eine Ebene tiefer: In einer `.pyw` gibt es keine Konsole, `sys.stderr`
    # ist `None`, und Tkinters eingebauter Fehlerbericht schreibt genau
    # dorthin. Ein beliebiger Fehler in irgendeinem Callback erzeugt damit
    # einen zweiten Fehler in der Fehlerbehandlung.
    #
    # `_ensure_streams` nimmt dem Fall die Wirkung. Dieser Bericht gibt ihm
    # einen Ort: Jeder Fehler landet mit Zeitstempel, Version und vollem
    # Traceback in einer Datei neben den Daten. Beim ersten Mal in einer
    # Sitzung sagt Glide einmal Bescheid – danach nicht mehr, damit ein
    # wiederkehrender Fehler nicht selbst zur Unterbrechung wird.
    def install_error_reporting(self, root):
        """Hängt den eigenen Bericht vor den bereits vorhandenen.

        Ein vorhandener Bericht wird nicht ersetzt, sondern danach
        aufgerufen: Ein Prüflauf, der Callback-Fehler selbst mitschreibt,
        soll sie weiterhin sehen – und Tkinters eigener Bericht schadet
        nicht mehr, seit `_ensure_streams` für einen Strom sorgt.
        """
        self._error_notice_shown = False
        vorher = getattr(root, "report_callback_exception", None)
        self._previous_error_report = vorher if callable(vorher) else None
        try:
            root.report_callback_exception = self.report_callback_exception
        except (AttributeError, tk.TclError):
            pass

    def report_callback_exception(self, exc_type, exc_value, exc_tb):
        """Schreibt einen Fehler aus einem Tk-Callback ins Protokoll."""
        if isinstance(exc_value, glide_focus.PendingBookingError):
            self._register_after(self.root.after_idle(lambda: self.show_warning(
                "Zeitbuchung ausstehend", "Bitte zuerst die Zeitbuchung über die Zeiterfassung erneut speichern. "
                "Weitere Änderungen warten, bis diese Buchung abgeschlossen ist.")))
            return
        text = self.format_error_report(exc_type, exc_value, exc_tb)
        self.log_error(text)
        if getattr(self, "_error_notice_shown", False):
            return
        self._error_notice_shown = True
        # Der Hinweis darf die laufende Verarbeitung nicht unterbrechen: Ein
        # modaler Dialog aus einem gescheiterten Callback heraus wäre genau
        # die Blockade, die hier verhindert werden soll.
        try:
            self._register_after(root_after(self.root, 400, self._show_error_notice))
        except Exception:
            pass
        weiter = getattr(self, "_previous_error_report", None)
        if weiter is not None:
            try:
                weiter(exc_type, exc_value, exc_tb)
            except Exception:
                pass

    @staticmethod
    def format_error_report(exc_type, exc_value, exc_tb):
        """Fehlerbericht mit Ablaufspur – auch nach einem Rekursionsfehler.

        Bis 29.09.2026 scheiterte das Formatieren selbst an der ausgeschöpften
        Rekursionstiefe, und im Protokoll stand nur „RecursionError: maximum
        recursion depth exceeded“ ohne Ort (Befund R11). Jetzt bekommt das
        Formatieren Luft, und eine sich wiederholende Aufrufkette steht einmal
        mit ihrer Wiederholungszahl da.
        """
        alt = sys.getrecursionlimit()
        try:
            sys.setrecursionlimit(alt + 10000)
            rahmen = traceback.extract_tb(exc_tb)
            zeilen = [f"  {os.path.basename(f.filename)}:{f.lineno} in {f.name}" for f in rahmen]
            if len(zeilen) > 60:
                # Mitte kürzen: Anfang und jüngste Aufrufe zeigen die Kette.
                ende = zeilen[-40:]
                zeilen = zeilen[:15] + [f"  … {len(zeilen) - 55} weitere Aufrufe …"] + ende
            return ("Traceback (gekürzt, jüngster Aufruf zuletzt):\n" + "\n".join(zeilen)
                    + f"\n{getattr(exc_type, '__name__', exc_type)}: {exc_value}\n")
        except Exception:
            return f"{exc_type}: {exc_value}\n"
        finally:
            sys.setrecursionlimit(alt)

    def _show_error_notice(self):
        try:
            self.show_warning(
                "Es ist ein Fehler aufgetreten",
                "Glide läuft weiter. Der vollständige Fehlerbericht liegt im "
                "Fehlerprotokoll neben deinen Daten – über Hilfe › Fehlerprotokoll "
                "öffnen erreichbar. Weitere Fehler dieser Sitzung werden nur noch "
                "protokolliert.")
        except Exception:
            pass

    @staticmethod
    def log_error(text):
        """Hängt einen Eintrag an das Fehlerprotokoll; kürzt es bei Bedarf."""
        eintrag = (f"\n===== {datetime.now().strftime('%d.%m.%Y %H:%M:%S')} · "
                   f"{APP_PRODUCT_NAME} {APP_VERSION} =====\n{text}")
        try:
            with open(ERROR_LOG_FILE, "a", encoding="utf-8") as datei:
                datei.write(eintrag)
            if os.path.getsize(ERROR_LOG_FILE) > ERROR_LOG_MAX_BYTES:
                with open(ERROR_LOG_FILE, "r", encoding="utf-8", errors="replace") as datei:
                    inhalt = datei.read()
                with open(ERROR_LOG_FILE, "w", encoding="utf-8") as datei:
                    datei.write(inhalt[-ERROR_LOG_MAX_BYTES // 2:])
        except OSError:
            pass

    def open_error_log(self, event=None):
        """Öffnet das Fehlerprotokoll – oder sagt, dass es keines gibt."""
        if not os.path.isfile(ERROR_LOG_FILE):
            self.show_info("Fehlerprotokoll",
                           "Es ist noch kein Fehler aufgetreten – das Protokoll ist leer.")
            return "break"
        self.open_external_path(ERROR_LOG_FILE)
        return "break"

    def _register_after(self, after_id):
        if after_id is not None:
            self._after_ids.add(after_id)
        return after_id

    def schedule_scrollbar_refresh(self):
        if not hasattr(self, "root"):
            return
        # Mehrfachaufrufe innerhalb eines Leerlaufzyklus werden zusammengefasst;
        # ohne das sammelten sich pro Listenaufbau tote after-IDs an.
        if getattr(self, "_scrollbar_refresh_id", None) is not None:
            return

        def run():
            self._after_ids.discard(getattr(self, "_scrollbar_refresh_id", None))
            self._scrollbar_refresh_id = None
            self.refresh_scrollbar_state()

        try:
            self._scrollbar_refresh_id = self._register_after(self.root.after_idle(run))
        except tk.TclError:
            self._scrollbar_refresh_id = None

    def active_label_column_width(self):
        """Breite der Labelspalte.

        Sie erscheint nur dort, wo Labels tatsächlich dargestellt werden – in
        einer Liste, in „In Bearbeitung“ und in der Ordnerübersicht – und nur,
        wenn überhaupt Labels angelegt sind. Der Papierkorb behält dadurch die
        volle Textbreite.
        """
        if self.view_mode not in ("list", "folder") + self.DERIVED_ITEM_VIEWS:
            return 0
        if not self.has_visible_labels():
            return 0
        return self.fitted_column_width(self.label_column_width(), "_content_label_width")

    def active_due_column_width(self):
        """Breite der Fälligkeitsspalte für den aktuellen Inhalt."""
        return self.fitted_column_width(self.due_column_width(), "_content_due_width")

    def fitted_column_width(self, maximum, attribute):
        """Deckelt eine Musterbreite auf das, was der angezeigte Inhalt braucht.

        Ohne Messung gilt der Musterwert: Vor dem ersten Aufbau ist unbekannt,
        was in der Spalte stehen wird, und eine zu schmale Spalte schnitte ab.
        """
        measured = getattr(self, attribute, None)
        if measured is None:
            return maximum
        return min(maximum, max(0, int(measured)))

    def has_visible_labels(self):
        """Gibt es überhaupt etwas, das in der Labelspalte stehen könnte?

        Seit 3.0 zählen dafür nur selbst angelegte Labels. Die beiden festen
        Labels tragen die Art des Punkts und erscheinen in der Liste nicht mehr
        – sie dürfen deshalb auch keine Spalte öffnen, die dann leer bliebe.
        """
        return any(not self.is_system_label(label) for label in self.labels)

    def task_tree_column_widths(self, tree_width):
        """Breiten von Text-, Fälligkeits- und Labelspalte für eine Baumbreite.

        Wird das Fenster schmal, weichen zuerst die Labels und danach die
        Fälligkeit. Der Aufgabentext bekommt die frei werdende Breite; die
        Angaben bleiben in der großen Darstellung und im Kontextmenü erreichbar.
        Reine Rechenmethode, damit die Schwellen ohne Fenster prüfbar sind.
        """
        try:
            tree_width = int(tree_width)
        except (TypeError, ValueError):
            tree_width = 0
        # Vor dem ersten Layout meldet Tk eine Breite von 1. Das ist keine
        # schmale Ansicht, sondern eine fehlende Angabe – dann bleibt alles an.
        measured = tree_width if tree_width > 50 else 0
        label_width = self.active_label_column_width()
        if measured and measured < self.LABEL_COLUMN_MIN_TREE_WIDTH:
            label_width = 0
        due_width = self.active_due_column_width()
        if measured and measured < self.DUE_COLUMN_MIN_TREE_WIDTH:
            due_width = 0
        text_width = max(
            180,
            tree_width
            - due_width
            - label_width
            - (self.TASK_METADATA_GAP if due_width or label_width else 0)
            - self.DUE_RIGHT_PADDING_WIDTH
            - self.TASK_TREE_EDGE_PADDING,
        )
        return text_width, due_width, label_width

    def sync_task_tree_columns(self, event=None):
        """Hält Fälligkeits- und Labelspalte bei jeder Treeview-Breite sichtbar rechts."""
        if not hasattr(self, "tree"):
            return
        if self.is_library_view():
            # Die Bibliothek hat eigene Spalten; Titel und Beschreibung dehnen sich.
            return
        if self.view_mode == self.TABLE_VIEW:
            # Eine selbst gezogene Titelbreite bleibt stehen; sonst füllt der
            # Titel den Rest der Tabelle.
            if "title" in self.table_widths_for_list():
                return
            try:
                tree_width = int(getattr(event, "width", 0) or self.tree.winfo_width())
                columns = self.table_columns_for_list()
                fixed = sum(int(self.tree.column(key, "width")) for key in columns if key != "title")
                title_width = max(self.TABLE_COLUMN_MIN_WIDTH, tree_width - fixed - 8 * max(0, len(columns) - 1))
                self.tree.column("title", width=title_width)
            except (TypeError, ValueError, tk.TclError):
                pass
            return
        try:
            tree_width = int(getattr(event, "width", 0) or self.tree.winfo_width())
            text_width, due_width, label_width = self.task_tree_column_widths(tree_width)
            source_width = 0
            gap = self.TASK_METADATA_GAP if due_width or label_width else 0
            if self.view_mode == self.PLAN_DAY_VIEW:
                text_width, due_width, label_width, source_width, gap = glide_design.today_columns(tree_width, due_width, label_width)
            display = ("text_gap", "due", "labels", "source", "due_padding") if source_width else ("text_gap", "due", "labels", "due_padding")
            if tuple(self.tree.cget("displaycolumns")) != display:
                self.tree.configure(displaycolumns=display)
            self.tree.column("source", width=source_width, minwidth=0, stretch=False, anchor="e")
            self.tree.column("#0", width=text_width)
            self.fit_today_sources()
            # Mindestbreite bleibt 0: Nur so kann die Spalte im schmalen
            # Fenster vollständig weichen. Dass die Angabe vollständig in die
            # Zeile passt, sichert die Messung in content_column_widths.
            self.tree.column("due", width=due_width, minwidth=0)
            self.tree.column("labels", width=label_width, minwidth=0)
            self.tree.column("text_gap", minwidth=0,
                             width=gap)
            self.tree.column(
                "due_padding",
                width=self.DUE_RIGHT_PADDING_WIDTH,
                minwidth=self.DUE_RIGHT_PADDING_WIDTH,
            )
            self.update_hint_visibility(tree_width)
        except (TypeError, ValueError, tk.TclError):
            pass
        # Der Umbruch eines Langtexts hängt an der Textbreite. Ändert sie sich,
        # muss neu umbrochen werden – sonst bliebe der Text abgeschnitten oder
        # stünde unnötig eng.
        self.schedule_long_task_reflow()

    def fit_today_sources(self):
        """Quelle bei Breiten-/Schriftwechsel aus dem vollständigen Text kürzen."""
        if self.view_mode != self.PLAN_DAY_VIEW:
            return
        font = self.measurement_font(app_font(glide_design.FONT_SIZES["source"]))
        width = max(0, self.tree.column("source", "width") - 8)
        key = (width, str(font.actual()), self.root.tk.call("tk", "scaling"))
        if key == getattr(self, "_today_source_fit_key", None):
            return
        self._today_source_fit_key = key
        for row, source in getattr(self, "_today_source_titles", {}).items():
            if self.tree.exists(row):
                self.tree.set(row, "source", glide_design.fit_text(source, font.measure, width))

    def advanced_button_min_width(self):
        """Breite, ab der Schnelleingabe und beide Knöpfe nebeneinander passen.

        Gemessen statt geschätzt: Bei einer anderen Anzeigeskalierung sind die
        Knöpfe breiter, und eine feste Zahl griffe dann zu spät – der Knopf
        wäre schon gestaucht, bevor die Schwelle erreicht ist.
        """
        cached = getattr(self, "_advanced_min_width", None)
        if cached is not None:
            return cached
        width = self.ADVANCED_BUTTON_MIN_WIDTH
        try:
            width = (
                self.ENTRY_MIN_WIDTH
                + self.add_button.winfo_reqwidth()
                + self.advanced_add_button.winfo_reqwidth()
                + 2 * self.INPUT_ROW_GAP
            )
        except (AttributeError, tk.TclError):
            pass
        self._advanced_min_width = max(width, self.ADVANCED_BUTTON_MIN_WIDTH)
        return self._advanced_min_width

    def update_advanced_button_visibility(self, event=None):
        """Seit 3.33.20 (U04) bleibt „Erweitert“ ausgeblendet; Umschalt+Enter öffnet die Maske."""
        self._advanced_button_visible = False
        button = getattr(self, "advanced_add_button", None)
        try:
            if button is not None and button.winfo_manager():
                button.pack_forget()
        except tk.TclError:
            pass

    def update_hint_visibility(self, tree_width=None):
        """Merkt, ob die Liste breit genug für den Hinweis ist.

        Bis 29.09.2026 wich der Hinweis bei derselben Breite wie die
        Labelspalte, um unter der Liste Höhe freizugeben. Seit er im Kartenfuß
        fester Höhe steht, gibt sein Ausblenden keinen Platz mehr frei; er
        bleibt deshalb stehen und wird bei schmaler Liste nur stärker gekürzt.
        `_hint_visible` beschreibt weiter die Breitenstufe.
        """
        if getattr(self, "hint_label", None) is None:
            return
        if tree_width is None:
            try:
                tree_width = int(self.tree.winfo_width())
            except (AttributeError, tk.TclError):
                return
        # Vor dem ersten Layout meldet Tk eine Breite von 1 – das ist keine
        # schmale Ansicht, sondern eine fehlende Angabe.
        self._hint_visible = tree_width <= 50 or tree_width >= self.LABEL_COLUMN_MIN_TREE_WIDTH

    def cancel_pending_callbacks(self):
        if not hasattr(self, "root"):
            return
        self._destroy_item_context_menu()
        self._destroy_sidebar_context_menu()
        for after_id in list(getattr(self, "_after_ids", ()) or ()):
            try:
                self.root.after_cancel(after_id)
            except tk.TclError:
                pass
        self._after_ids = set()
        self._scrollbar_refresh_id = None
        self._autosave_id = None
        self._search_refresh_after = None

        self._sidebar_heights_after = None
        self._sidebar_heights_pending = False

    # -----------------------------
    # Datenmodell / Migration
    # -----------------------------
    def clamp_importance(self, value):
        try:
            value = int(value)
        except (TypeError, ValueError):
            return 0
        return max(0, min(3, value))

    def new_item(
        self,
        text,
        done=False,
        children=None,
        item_id=None,
        importance=0,
        due=None,
        description="",
        attachments=None,
        color=None,
        kind=ITEM_KIND_TASK,
        labels=None,
        due_time=None,
        repeat=None,
        reminder=None,
        planned_date=None,
        estimated_minutes=None,
        checklist=None,
        links=None,
        blocked_by=None,
        planned_time=None,
        time_spent_minutes=None,
        done_at=None,
        references=None,
    ):
        clean_kind = kind if kind in self.ITEM_KINDS else self.ITEM_KIND_TASK
        # Gruppe und Überschrift sind reine Gliederung: kein Erledigt-Zustand,
        # keine Fälligkeit, keine Wichtigkeit. So bleibt jede Auswertung
        # eindeutig. Aufgabe und Langtext verhalten sich identisch.
        structural = clean_kind in (self.ITEM_KIND_GROUP, self.ITEM_KIND_HEADING)
        normalized_due = None if structural else self.normalize_due(due)
        planning = self.normalize_planning(planned_date, estimated_minutes)
        item = {
            "id": item_id or uuid.uuid4().hex,
            # Zeilenumbrüche bleiben ausschließlich im Langtext erhalten.
            "text": self.normalize_item_text(text, clean_kind),
            "done": False if structural else bool(done),
            "importance": 0 if structural else self.clamp_importance(importance),
            "due": normalized_due,
            # Format 10: Die Uhrzeit ist freiwillig und hängt am Datum. Ohne
            # Datum gibt es keine Uhrzeit – sonst entstünde eine Frist ohne Tag.
            "due_time": self.normalize_due_time(due_time) if normalized_due else None,
            "description": str(description or ""),
            "attachments": self.normalize_attachments(attachments),
            "color": color if color in self.ITEM_COLOR_KEYS else None,
            "kind": clean_kind,
            # Format 7: Labelzuordnung als Liste von Label-IDs. Fehlt das Feld,
            # trägt der Punkt keine Labels; ältere Bestände bleiben gültig.
            "labels": self.normalize_item_labels(labels),
            # Format 11: Wiederholungsregel. Sie hängt an der Fälligkeit – ohne
            # Datum gibt es nichts zu wiederholen, und Gruppen und
            # Überschriften tragen ohnehin keine Fälligkeit.
            "repeat": self.normalize_repeat(repeat, default_start=normalized_due) if normalized_due else None,
            "reminder": None if structural else self.normalize_reminder(reminder),
            "planned_date": None if structural else planning["planned_date"],
            "estimated_minutes": None if structural else planning["estimated_minutes"],
            # Format 16: Gliederung führt keine Checkliste – eine Überschrift
            # hat nichts abzuhaken.
            "checklist": [] if structural else self.normalize_checklist(checklist),
            # Format 20: Verweise auf andere Punkte. Verknüpfen darf auch eine
            # Gliederung; warten kann nur, was sich erledigen lässt.
            "links": self.normalize_item_references(links),
            "blocked_by": [] if structural else self.normalize_item_references(blocked_by),
            "planned_time": (self.normalize_due_time(planned_time)
                             if not structural and planning["planned_date"] else None),
            "time_spent_minutes": None if structural else self.normalize_time_spent(time_spent_minutes),
            # Wann der Punkt erledigt wurde; Grundlage des Wochenrückblicks.
            "done_at": (self._list_timestamp(done_at, default_now=False) or None)
                       if not structural and bool(done) else None,
            "children": children if isinstance(children, list) else [],
        }
        if references is not None:
            item["references"] = glide_objects.normalize(references)
        # Art und festes Label bleiben von Anfang an deckungsgleich.
        self.sync_item_kind_label(item)
        return item

    @classmethod
    def normalize_item_references(cls, value):
        """Eindeutige Punktkennungen in ihrer Reihenfolge, höchstens 50."""
        if not isinstance(value, list):
            return []
        result = []
        for entry in value:
            if isinstance(entry, str) and 0 < len(entry) <= 64 and entry not in result:
                result.append(entry)
            if len(result) >= cls.MAX_ITEM_REFERENCES:
                break
        return result

    @classmethod
    def normalize_time_spent(cls, value):
        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
            return None
        return min(value, cls.MAX_TIME_SPENT_MINUTES)

    @classmethod
    def normalize_checklist(cls, value):
        """Prüft die Checkliste eines Punkts streng und gibt sie bereinigt zurück.

        Einträge ohne Text fallen weg, doppelte Kennungen werden neu vergeben.
        Ein unbrauchbarer Wert führt auf eine leere Checkliste zurück statt auf
        einen Fehler – ein beschädigtes Feld darf keine Datei unlesbar machen.
        """
        if not isinstance(value, list):
            return []
        bereinigt = []
        vergeben = set()
        for eintrag in value:
            if isinstance(eintrag, str):
                eintrag = {"text": eintrag}
            if not isinstance(eintrag, dict):
                continue
            text = " ".join(str(eintrag.get("text") or "").split())[:cls.MAX_CHECKLIST_TEXT]
            if not text:
                continue
            kennung = eintrag.get("id")
            if not isinstance(kennung, str) or not kennung or kennung in vergeben:
                kennung = uuid.uuid4().hex
            vergeben.add(kennung)
            bereinigt.append({"id": kennung, "text": text, "done": bool(eintrag.get("done"))})
            if len(bereinigt) >= cls.MAX_CHECKLIST_ENTRIES:
                break
        return bereinigt

    @classmethod
    def checklist_progress(cls, item):
        """Erledigte und vorhandene Schritte eines Punkts."""
        eintraege = item.get("checklist") if isinstance(item, dict) else None
        if not isinstance(eintraege, list):
            return {"done": 0, "total": 0}
        gesamt = [entry for entry in eintraege if isinstance(entry, dict)]
        return {"done": sum(1 for entry in gesamt if entry.get("done")), "total": len(gesamt)}

    @classmethod
    def format_checklist_progress(cls, item):
        """„3/5“ oder ein leerer Text, wenn es keine Checkliste gibt."""
        fortschritt = cls.checklist_progress(item)
        return f"{fortschritt['done']}/{fortschritt['total']}" if fortschritt["total"] else ""

    @classmethod
    def normalize_planning(cls, planned_date=None, estimated_minutes=None):
        """Optionale Planung streng prüfen; leere ältere Felder bleiben leer."""
        if planned_date in (None, ""):
            planned_date = None
        elif not isinstance(planned_date, str) or cls.normalize_due(planned_date) != planned_date:
            raise ValueError("Der Bearbeitungstag muss ein gültiges Datum im Format JJJJ-MM-TT sein.")
        if estimated_minutes in (None, ""):
            estimated_minutes = None
        elif type(estimated_minutes) is not int or not 1 <= estimated_minutes <= cls.MAX_ESTIMATED_MINUTES:
            raise ValueError(f"Der geschätzte Aufwand muss zwischen 1 und {cls.MAX_ESTIMATED_MINUTES} ganzen Minuten liegen.")
        return {"planned_date": planned_date, "estimated_minutes": estimated_minutes}

    @staticmethod
    def format_estimated_minutes(value):
        return glide_planning.duration(value)

    @classmethod
    def normalize_item_text(cls, value, kind=None):
        """Bereitet den Text eines Punkts auf.

        Einzeilig für jede Art außer dem Langtext – dort sind eigene
        Zeilenumbrüche ausdrücklich erlaubt, denn genau dafür ist er da.
        Leerraum am Rand, doppelte Leerzeilen und Wagenrückläufe verschwinden
        in jedem Fall, damit Darstellung und Export berechenbar bleiben.
        """
        raw = str(value or "").replace("\r\n", "\n").replace("\r", "\n")
        if kind != cls.ITEM_KIND_LONG:
            return " ".join(raw.split())
        # Leerzeilen entfallen vollständig: der Aufgabentext zeigt in der Liste
        # höchstens fünf Zeilen, eine gespeicherte Leerzeile wäre dort nicht
        # sichtbar und Datenstand und Darstellung liefen auseinander.
        lines = [" ".join(line.split()) for line in raw.split("\n")]
        cleaned = [line for line in lines if line]
        return "\n".join(cleaned[: cls.MAX_LONG_TASK_TEXT_LINES])

    @staticmethod
    def item_display_text(item):
        """Einzeilige Fassung eines Punkttexts für schmale Darstellungen.

        Ein Langtext kann Zeilenumbrüche tragen; überall dort, wo genau eine
        Zeile zur Verfügung steht – Kalender, Aufgabenübersichten, TXT-Kopfzeile –
        werden sie zu Leerzeichen.
        """
        return " ".join(str((item or {}).get("text", "")).split())

    @classmethod
    def item_kind(cls, item):
        """Liefert die Art eines Punkts; unbekannte Werte gelten als Aufgabe."""
        if not isinstance(item, dict):
            return cls.ITEM_KIND_TASK
        kind = item.get("kind")
        if kind in cls.ITEM_KINDS:
            return kind
        return cls.ITEM_KIND_TASK

    @classmethod
    def is_group_item(cls, item):
        return cls.item_kind(item) == cls.ITEM_KIND_GROUP

    @classmethod
    def is_long_item(cls, item):
        """Mehrzeiliger Punkt – inhaltlich eine gewöhnliche Aufgabe."""
        return cls.item_kind(item) == cls.ITEM_KIND_LONG

    @classmethod
    def is_heading_item(cls, item):
        """Zwischenüberschrift – gliedert, trägt aber selbst keine Aufgabe."""
        return cls.item_kind(item) == cls.ITEM_KIND_HEADING

    @classmethod
    def is_structural_item(cls, item):
        """Gruppe oder Überschrift: gliedernd, ohne eigenen Erledigt-Zustand."""
        return cls.item_kind(item) in (cls.ITEM_KIND_GROUP, cls.ITEM_KIND_HEADING)

    @classmethod
    def is_schedulable_item(cls, item):
        """Echte Aufgabe – einzeilig oder mehrzeilig. Zählt in jeder Auswertung."""
        return cls.item_kind(item) in (cls.ITEM_KIND_TASK, cls.ITEM_KIND_LONG)

    def set_item_kind(self, item, kind):
        """Wandelt zwischen den vier Arten und räumt die Statusfelder auf."""
        if not isinstance(item, dict):
            return False
        new_kind = kind if kind in self.ITEM_KINDS else self.ITEM_KIND_TASK
        if self.item_kind(item) == new_kind:
            return False
        regular = [value for value in item.get("labels", []) if not self.is_system_label(self.get_label(value))]
        if new_kind in (self.ITEM_KIND_LONG, self.ITEM_KIND_HEADING) and len(regular) >= self.MAX_LABELS_PER_ITEM:
            self.show_warning("Labels", "Für das Artlabel muss zuerst ein anderes Label abgewählt werden.")
            return False
        item["kind"] = new_kind
        # Nur ein Langtext darf Zeilenumbrüche tragen. Beim Zurückwandeln
        # werden sie zu Leerzeichen, statt still im Datensatz zu bleiben.
        item["text"] = self.normalize_item_text(item.get("text", ""), new_kind)
        if new_kind in (self.ITEM_KIND_GROUP, self.ITEM_KIND_HEADING):
            item["done"] = False
            item["due"] = None
            item["due_time"] = None
            item["reminder"] = None
            item["planned_date"] = None
            item["estimated_minutes"] = None
            item["importance"] = 0
        if new_kind == self.ITEM_KIND_HEADING:
            # Eine Überschrift steht für sich. Vorhandene Unterpunkte rücken
            # deshalb auf ihre Ebene nach – sie gehen nicht verloren.
            item["children"] = item.get("children") if isinstance(item.get("children"), list) else []
        self.sync_item_kind_label(item)
        return True

    def sync_item_kind_label(self, item):
        """Hält die festen Labels „Langtext“ und „Überschrift“ deckungsgleich zur Art.

        Label und Art sind zwei Sichten auf dieselbe Eigenschaft. Wer das Label
        vergibt, wandelt den Punkt um – und umgekehrt. Diese Methode ist die
        einzige Stelle, die beide Seiten aneinander angleicht.
        """
        if not isinstance(item, dict):
            return False
        kind = self.item_kind(item)
        assigned = list(item.get("labels") or [])
        changed = False
        for role, _name, _color, role_kind in self.SYSTEM_LABEL_DEFINITIONS:
            label = self.get_system_label(role)
            if label is None:
                continue
            label_id = label.get("id")
            should_have = kind == role_kind
            if should_have and label_id not in assigned:
                assigned.append(label_id)
                changed = True
            elif not should_have and label_id in assigned:
                assigned = [value for value in assigned if value != label_id]
                changed = True
        if changed:
            item["labels"] = assigned
        return changed

    @staticmethod
    def validate_attachment_storage(storage):
        """Erlaubt ausschließlich portable, flache Pfade unter attachments/."""
        if not isinstance(storage, str):
            raise ValueError("Ungültiger Anhangspfad.")
        storage = storage.strip()
        if not storage or "\\" in storage or "\x00" in storage:
            raise ValueError("Ungültiger Anhangspfad.")
        parts = storage.split("/")
        if len(parts) != 2 or parts[0] != "attachments":
            raise ValueError("Anhänge müssen direkt im Ordner attachments liegen.")
        filename = parts[1]
        if filename in ("", ".", "..") or filename.rstrip(" .") != filename:
            raise ValueError("Ungültiger Anhangsname.")
        if any(ord(char) < 32 or char in '<>:"/\\|?*' for char in filename):
            raise ValueError("Der Anhangsname enthält unzulässige Zeichen.")
        reserved = {"CON", "PRN", "AUX", "NUL"}
        reserved.update({f"COM{number}" for number in range(1, 10)})
        reserved.update({f"LPT{number}" for number in range(1, 10)})
        if filename.split(".", 1)[0].upper() in reserved:
            raise ValueError("Der Anhangsname ist unter Windows reserviert.")
        return storage

    def normalize_attachments(self, data):
        if not isinstance(data, list):
            return []
        normalized = []
        for entry in data:
            if not isinstance(entry, dict):
                continue
            storage = entry.get("storage")
            if not isinstance(storage, str):
                continue
            try:
                storage = self.validate_attachment_storage(storage)
            except ValueError:
                continue
            name = str(entry.get("name") or os.path.basename(storage)).strip() or "Anhang"
            try:
                size = max(0, int(entry.get("size", 0)))
            except (TypeError, ValueError):
                size = 0
            normalized.append(
                {
                    "id": entry.get("id") if isinstance(entry.get("id"), str) and entry.get("id") else uuid.uuid4().hex,
                    "name": name,
                    "storage": storage,
                    "size": size,
                    "mime": str(entry.get("mime") or "application/octet-stream"),
                    "added_at": str(entry.get("added_at") or ""),
                }
            )
            # Titel und Notiz eines Galeriebilds (27.09.2026, additiv).
            for feld, grenze in (("title", 200), ("note", 4000)):
                wert = entry.get(feld)
                if isinstance(wert, str) and wert.strip():
                    normalized[-1][feld] = wert.strip()[:grenze]
        return normalized

    def resolve_attachment_path(self, attachment):
        storage = attachment.get("storage") if isinstance(attachment, dict) else None
        if not isinstance(storage, str) or not storage:
            return None
        try:
            storage = self.validate_attachment_storage(storage)
        except ValueError:
            return None
        attachments_root = os.path.normcase(os.path.realpath(ATTACHMENTS_DIR))
        candidate = os.path.normcase(
            os.path.realpath(os.path.join(BASE_DIR, storage.replace("/", os.sep)))
        )
        try:
            if os.path.commonpath([candidate, attachments_root]) != attachments_root:
                return None
        except ValueError:
            return None
        return candidate

    def store_attachment(self, source_path):
        if not source_path or not os.path.isfile(source_path):
            raise OSError("Die ausgewählte Datei ist nicht mehr vorhanden.")
        source_size = os.path.getsize(source_path)
        if source_size > self.MAX_BACKUP_ATTACHMENT_BYTES:
            raise OSError(
                "Die Datei ist größer als 512 MB und kann deshalb nicht in ein "
                "vollständiges Glide-Backup aufgenommen werden."
            )
        original_name = os.path.basename(source_path)
        attachment_id = uuid.uuid4().hex
        # Gemeinsame, geprüfte Namensbildung mit dem Backup-Import. Der Pfad wird
        # vor dem Kopieren validiert, damit keine unauffindbare Datei entsteht.
        stored_name = self.safe_attachment_filename(original_name, attachment_id)
        storage = f"attachments/{stored_name}"
        self.validate_attachment_storage(storage)
        destination = os.path.join(ATTACHMENTS_DIR, stored_name)
        temp_path = None
        try:
            temp_handle, temp_path = tempfile.mkstemp(prefix=".attachment-", suffix=".tmp", dir=ATTACHMENTS_DIR)
            os.close(temp_handle)
            shutil.copy2(source_path, temp_path)
            copied_size = os.path.getsize(temp_path)
            if copied_size > self.MAX_BACKUP_ATTACHMENT_BYTES:
                raise OSError(
                    "Die Datei ist größer als 512 MB und kann deshalb nicht in ein "
                    "vollständiges Glide-Backup aufgenommen werden."
                )
            os.replace(temp_path, destination)
            temp_path = None
        finally:
            if temp_path:
                try:
                    os.remove(temp_path)
                except OSError:
                    pass
        mime, _encoding = mimetypes.guess_type(original_name)
        return {
            "id": attachment_id,
            "name": original_name,
            "storage": storage,
            "size": os.path.getsize(destination),
            "mime": mime or "application/octet-stream",
            "added_at": datetime.now().isoformat(timespec="seconds"),
        }

    @staticmethod
    def normalize_due(value):
        """Akzeptiert ein ISO-Datum (JJJJ-MM-TT) oder None und liefert ein sauberes ISO-Datum bzw. None."""
        if not value or not isinstance(value, str):
            return None
        return _parse_iso_date(value.strip())

    @staticmethod
    def normalize_due_time(value):
        """Akzeptiert eine Uhrzeit (HH:MM) oder None und liefert HH:MM bzw. None."""
        if not value or not isinstance(value, str):
            return None
        value = value.strip()
        for fmt in ("%H:%M", "%H.%M", "%H%M", "%H"):
            try:
                return datetime.strptime(value, fmt).strftime("%H:%M")
            except ValueError:
                continue
        return None

    @classmethod
    def parse_due_time_input(cls, text):
        """Wandelt eine Uhrzeit-Eingabe um.

        Rückgaben: HH:MM bei Erfolg, '' wenn die Uhrzeit entfernt werden soll
        (leere Eingabe), None bei ungültiger Eingabe. Dieselbe Aufteilung wie
        bei `parse_due_input`, damit beide Felder gleich behandelt werden.
        """
        if text is None:
            return None
        text = text.strip()
        if not text:
            return ""
        return cls.normalize_due_time(text)

    @classmethod
    def format_due_full(cls, iso_value, time_value=None):
        """Fälligkeit als Klartext: „30.09.2026“ oder „30.09.2026, 14:30“."""
        day = cls.format_due_display(iso_value)
        if not day:
            return ""
        clean_time = cls.normalize_due_time(time_value)
        return f"{day}, {clean_time}" if clean_time else day

    @staticmethod
    def parse_due_input(text):
        """Wandelt Nutzereingaben in ein ISO-Datum um.

        Rückgaben: ISO-String bei Erfolg, '' wenn das Datum entfernt werden soll
        (leere Eingabe), oder None bei ungültiger Eingabe.
        """
        if text is None:
            return None
        text = text.strip()
        if not text:
            return ""
        for fmt in ("%d.%m.%Y", "%d.%m.%y", "%Y-%m-%d", "%d-%m-%Y", "%d/%m/%Y"):
            try:
                return datetime.strptime(text, fmt).strftime("%Y-%m-%d")
            except ValueError:
                continue
        return None

    @staticmethod
    def format_due_display(iso_value):
        """Formatiert ein ISO-Datum als TT.MM.JJJJ für die Anzeige."""
        if not iso_value:
            return ""
        return glide_metrics.display_date(iso_value)

    @classmethod
    def format_due_column(cls, iso_value, time_value=None):
        """Fälligkeit für die Listenspalte: „15.09.26“ oder „15.09.26, 10:30“.

        Zweistellig, damit Datum und Uhrzeit vollständig in die Spalte passen.
        Ein abgeschnittenes Datum ist schlechter lesbar als ein kurzes Jahr –
        und die Jahrhundertangabe trägt in einer Aufgabenliste nichts bei.
        Klartext-Ausgaben (Dialoge, Export, Suche) benutzen weiter
        format_due_full mit vierstelligem Jahr.
        """
        day = cls.format_due_display(iso_value)
        if not day:
            return ""
        short_day = f"{day[:6]}{day[8:]}" if len(day) == 10 else day
        clean_time = cls.normalize_due_time(time_value)
        return f"{short_day}, {clean_time}" if clean_time else short_day

    def label_column_width(self):
        """Spaltenbreite, in die der längste Labeltext vollständig passt.

        Gemessen wie bei der Fälligkeit: mit der Schrift der Liste, nicht mit
        der Standardgröße. Der Musterwert ist der längste darstellbare Fall –
        Symbol, ein auf LABEL_COLUMN_NAME_MAX_CHARS gekürzter Name und ein
        zweistelliger Zähler.
        """
        cached = getattr(self, "_label_column_width", None)
        if cached is not None:
            return cached
        sample = f"{self.LABEL_COLUMN_ICON} {'M' * self.LABEL_COLUMN_NAME_MAX_CHARS}  +99"
        width = self.LABEL_COLUMN_WIDTH
        try:
            font = self.measurement_font(self.tree_font())
            width = font.measure(sample) + self.tree_cell_padding(font)
        except (tk.TclError, RuntimeError):
            pass
        self._label_column_width = width
        return width

    def tree_cell_padding(self, font):
        """Gesamter Zuschlag zwischen gemessenem Text und Spaltenbreite.

        Fester Anteil für den Zellenrand plus eine an der Schrift bemessene
        Reserve für Symbolzeichen aus einer Ersatzschrift. Ohne diese Reserve
        fiel die Spalte rund ein Zeichen zu schmal aus – sichtbar daran, dass
        die letzte Ziffer der Fälligkeit fehlte.
        """
        try:
            reserve = font.measure("0") * self.TREE_CELL_RESERVE_CHARS
        except (tk.TclError, RuntimeError):
            reserve = self.DUE_COLUMN_TEXT_PADDING
        return self.DUE_COLUMN_TEXT_PADDING + reserve

    def due_column_width(self):
        """Spaltenbreite, in die der längste Fälligkeitstext vollständig passt.

        Gemessen statt geschätzt: Schriftart und Skalierung unterscheiden sich
        zwischen Windows, macOS und Linux, eine feste Zahl schneidet auf einem
        der drei Systeme ab.
        """
        cached = getattr(self, "_due_column_width", None)
        if cached is not None:
            return cached
        sample = f"{self.DUE_COLUMN_ICON} 30.12.26, 22:30 · {self.ICONS['today']} 30.12.26"
        width = self.DUE_COLUMN_WIDTH
        try:
            font = self.measurement_font(self.tree_font())
            width = font.measure(sample) + self.tree_cell_padding(font)
        except (tk.TclError, RuntimeError):
            pass
        width = max(width, self.DUE_COLUMN_WIDTH)
        self._due_column_width = width
        return width

    def content_column_widths(self):
        """Breite, die Fälligkeit und Labels im angezeigten Inhalt wirklich brauchen.

        Die Musterwerte oben decken den längsten überhaupt möglichen Fall ab –
        Datum mit Uhrzeit, ein voll ausgereizter Labelname mit Zähler. Stehen in
        einer Ansicht nur kurze Angaben, bliebe daneben ein leerer Streifen, und
        Fälligkeit und Labels rückten sichtbar auseinander. Gemessen wird
        deshalb der tatsächliche Zelleninhalt; die Musterwerte bleiben die
        Obergrenze, damit nie abgeschnitten wird.
        """
        if self.view_mode == self.TABLE_VIEW or self.is_library_view():
            return None
        tree = getattr(self, "tree", None)
        if tree is None:
            return None
        try:
            font = self.measurement_font(self.tree_font())
        except (tk.TclError, RuntimeError):
            return None
        due_width = 0
        label_width = 0
        due_has_time = False
        # Die Messung lief über jede Zeile und rief für
        # jede `font.measure` auf – im Profilerlauf 164 ms je Aufbau und
        # damit der größte verbliebene Posten. Fälligkeiten und Labelspalten
        # wiederholen sich in einer Liste aber massiv: „18.09.26“ steht
        # zwanzigmal untereinander. Gemessen wird deshalb jeder Text nur
        # einmal. Der Speicher lebt nur innerhalb dieses Aufrufs, weil die
        # Schrift sich zwischen zwei Aufbauten geändert haben kann.
        gemessen = {}

        def breite(text):
            wert = gemessen.get(text)
            if wert is None:
                wert = gemessen[text] = font.measure(text)
            return wert

        stack = list(tree.get_children(""))
        while stack:
            row_id = stack.pop()
            try:
                stack.extend(tree.get_children(row_id))
                values = tree.item(row_id, "values")
            except tk.TclError:
                continue
            if len(values) > 0 and values[0]:
                due_text = str(values[0])
                due_width = max(due_width, breite(due_text))
                # Das Komma trennt Datum und Uhrzeit: „15.09.26, 10:30“.
                if "," in due_text:
                    due_has_time = True
            if len(values) > 1 and values[1]:
                label_width = max(label_width, breite(str(values[1])))
        padding = self.tree_cell_padding(font)
        due_total = due_width + padding if due_width else 0
        if due_has_time:
            # Sobald irgendwo eine Uhrzeit steht, muss die vollständige Angabe
            # in die Zeile passen – Datum und Uhrzeit, nie nur das Datum. Die
            # Musterbreite ist genau dafür bemessen und gilt hier als Untergrenze.
            due_total = max(due_total, self.due_column_width())
        return (
            due_total,
            label_width + padding if label_width else 0,
        )

    def fit_tree_columns_to_content(self):
        """Richtet die beiden rechten Spalten am fertig gefüllten Baum aus.

        Läuft nach jedem Aufbau. Ändert sich nichts an den gemessenen Breiten,
        bleibt auch die Spaltenbreite unangetastet – sonst geriete der Baum über
        den Umbruch der Langtexts in eine Schleife.
        """
        measured = self.content_column_widths()
        if measured is None:
            return
        previous = (
            getattr(self, "_content_due_width", None),
            getattr(self, "_content_label_width", None),
        )
        if measured == previous:
            return
        self._content_due_width, self._content_label_width = measured
        self.sync_task_tree_columns()

    def finish_tree_refresh(self):
        """Gemeinsamer Abschluss jedes Baumaufbaus.

        Erst die Spalten an den neuen Inhalt anpassen, dann die Bildlaufleiste
        prüfen: Die Spaltenbreite entscheidet mit, wie hoch die Zeilen umbrechen.
        """
        self.fit_tree_columns_to_content()
        self.schedule_scrollbar_refresh()
        self.sync_empty_state_action()
        if getattr(self, "_backdrop", None):
            self.schedule_backdrop_sync()

    # -----------------------------
    # Leerzustände mit nächstem Schritt (3.30, MO-050)
    # -----------------------------
    # Die Leerzeile nennt den Satz, darunter steht genau eine Hauptaktion.
    # Der Arbeitsbegleiter bleibt außen vor, bis über seine Stufe 3 entschieden ist.
    def entry_line_visible(self):
        """Hat die aktuelle Ansicht eine Eingabezeile über der Fläche?

        Entschieden nach der Ansicht wie in `sync_view_chrome`, nicht nach dem
        Zeichenstand: Beim Wechsel von der Startseite in eine Liste ist die
        Zeile im Moment des Leerzustands noch nicht wieder eingeblendet.
        """
        if self.view_mode == "folder":
            return True
        if self.view_mode not in ("list", self.TABLE_VIEW) or not self.lists:
            return False
        eintrag = self.current_list()
        return bool(eintrag) and not self.is_page_list(eintrag) and self.list_accepts_items(eintrag)

    def empty_state_action(self):
        """(Beschriftung, Befehl) der Hauptaktion des aktuellen Leerzustands – oder None.

        Seit 3.33.20 (U20) gibt es je Leerzustand genau einen Anlegeweg: Steht
        die Eingabezeile sichtbar darüber, entfällt der Anlegen-Knopf in der
        Fläche. Zurücksetzende Aktionen (Suche, Zeitraum) bleiben.
        """
        modus = self.view_mode
        anlegen_ueber_eingabe = self.entry_line_visible()
        if modus == "folder":
            ordner = self.get_folder(self.active_folder_id)
            if ordner is None:
                return None
            if ordner.get("folder_kind") == "journal" and any(self.journal_filter_range(ordner["id"])):
                return "Alle Tage zeigen", lambda: self.set_journal_filter(ordner["id"])
            if self.current_search_query():
                return "Suche zurücksetzen", self.reset_filters_for_empty_state
            if ordner.get("folder_kind") == "journal":
                # Ein Notizbucheintrag trägt seinen Tag; die Eingabezeile legt
                # dort nur eine gewöhnliche Liste an. Der Weg bleibt deshalb.
                return "Ersten Eintrag anlegen", lambda: self.create_journal_entry(ordner["id"])
            if anlegen_ueber_eingabe:
                return None
            return "Neue Liste anlegen", lambda: self.create_list_in_folder(ordner["id"])
        if modus == "trash":
            return "Zur Startseite", self.set_home_view
        if modus in ("list", self.TABLE_VIEW) or modus in self.TASK_OVERVIEW_VIEWS:
            if self.has_active_filter():
                return "Suche zurücksetzen", self.reset_filters_for_empty_state
            if modus in ("list", self.TABLE_VIEW):
                eintrag = self.current_list()
                if eintrag and self.list_accepts_items(eintrag) and not anlegen_ueber_eingabe:
                    return "Ersten Punkt anlegen", self.focus_new_item_entry
        return None

    def reset_filters_for_empty_state(self):
        self.search_placeholder_active = False
        self.search_var.set("")
        if getattr(self, "hide_done_var", None) is not None:
            self.hide_done_var.set(False)
        self.on_filter_changed()
        return "break"

    def focus_new_item_entry(self):
        eingabe = getattr(self, "entry", None)
        if eingabe is not None and eingabe.winfo_exists():
            eingabe.focus_set()
        return "break"

    EMPTY_STATE_MASCOT_SIZE = 56

    def empty_state_mascot(self, parent, existing=None, bg_key="card"):
        """Gismo klein und still neben einem Leerzustand – None, wenn „Spielereien“ aus sind.

        Stufe 2 der Begleiter-Entscheidung (docs/decisions/ARBEITSBEGLEITER.md):
        ein statischer Auftritt ohne Sprechblase, ohne Führung, ohne Blinzeln.
        Er erklärt nichts, was nicht auch ohne ihn dasteht.
        """
        if not self.settings.get("mascot_playful", True):
            return None
        if existing is None or not existing.winfo_exists() or existing.master is not parent \
                or existing.bg_key != bg_key:
            if existing is not None and existing.winfo_exists():
                existing.destroy()
            existing = MascotCanvas(parent, self, size=self.EMPTY_STATE_MASCOT_SIZE, bg_key=bg_key)
            existing.configure(takefocus=0, cursor="")
        existing.set_state("ruhig")
        return existing

    def sync_empty_state_action(self):
        """Zeigt die Hauptaktion unter der Leerzeile – nur, wenn der Baum leer ist."""
        baum = getattr(self, "tree", None)
        if baum is None:
            return
        knopf = getattr(self, "empty_action_button", None)
        figur = getattr(self, "empty_state_figure", None)
        try:
            leer = tuple(baum.get_children("")) == (self.EMPTY_ROW_ID,)
        except tk.TclError:
            return
        aktion = self.empty_state_action() if leer else None
        hinweis = getattr(self, "empty_text_label", None)
        if not leer:
            if hinweis is not None and hinweis.winfo_exists():
                hinweis.place_forget()
        else:
            hinweis = self.sync_empty_text(baum, hinweis)
        if aktion is None:
            if knopf is not None:
                knopf.place_forget()
            if not leer:
                if figur is not None and figur.winfo_exists():
                    figur.place_forget()
                return
            # Leer ohne eigene Aktion (U20: angelegt wird über die Eingabezeile):
            # Gismo steht still unter dem Leertext.
            oben = self.empty_state_top(baum, hinweis)
            neue_figur = self.empty_state_mascot(baum, figur)
            if neue_figur is None:
                if figur is not None and figur.winfo_exists():
                    figur.place_forget()
            else:
                neue_figur.place(x=24, y=oben)
                neue_figur.tk.call("raise", neue_figur._w)
            self.empty_state_figure = neue_figur
            return
        text, befehl = aktion
        if knopf is None:
            knopf = self.empty_action_button = self.make_button(
                baum, text, befehl, "accent", width=200, height=36, bg_key="card", font=app_font(10, "bold"))
        knopf.command = befehl
        knopf.set_text(text)
        knopf.configure(width=tkfont.Font(font=app_font(10, "bold")).measure(text) + 40)
        oben = self.empty_state_top(baum, hinweis)
        knopf.place(x=24, y=oben)
        # Canvas.lift hebt Zeichenelemente; das Widget selbst hebt „raise“.
        knopf.tk.call("raise", knopf._w)
        neue_figur = self.empty_state_mascot(baum, figur)
        if neue_figur is None:
            if figur is not None and figur.winfo_exists():
                figur.place_forget()
        else:
            neue_figur.place(x=24 + int(float(knopf.cget("width"))) + 16,
                             y=oben + 18 - self.EMPTY_STATE_MASCOT_SIZE // 2)
            neue_figur.tk.call("raise", neue_figur._w)
        self.empty_state_figure = neue_figur

    def empty_state_top(self, baum, hinweis):
        """Oberkante unter der Leerzeile bzw. dem umbrechenden Leertext."""
        box = None
        try:
            box = baum.bbox(self.EMPTY_ROW_ID)
        except tk.TclError:
            pass
        oben = (box[1] + box[3] + 12) if box else 44
        if hinweis is not None and hinweis.winfo_ismapped():
            oben = max(oben, int(float(hinweis.place_info().get("y", 0))) + hinweis.winfo_reqheight() + 12)
        return oben

    def sync_empty_text(self, baum, hinweis=None):
        """Der Leertext als umbrechende Beschriftung über der leeren Zeile.

        Eine Treeview-Zeile bricht nicht um; bei schmaler Karte stand vom
        Papierkorb-Hinweis nur „… und bleiben wiederherstel“ da (Rückmeldung
        26.09.2026). Die Zeile behält ihren Text; die Beschriftung liegt deckend
        über ihr.
        """
        try:
            text = str(baum.item(self.EMPTY_ROW_ID, "text") or "")
            stil = str(baum.cget("style")) or "Treeview"
            grund = self.style.lookup(stil, "background") or self.theme["card"]
            schrift = self.style.lookup(stil, "font") or app_font(11)
            farbe = baum.tag_configure("empty", "foreground") or self.theme["muted"]
            breite = max(160, baum.winfo_width())
            if hinweis is None or not hinweis.winfo_exists() or hinweis.master is not baum:
                hinweis = self.empty_text_label = tk.Label(baum, anchor="w", justify="left", bd=0, padx=24, pady=8)
            hinweis.configure(text=text, bg=grund, fg=farbe, font=schrift, wraplength=breite - 48)
            self._place_empty_text(baum, hinweis)
            # Die Zeile verschiebt sich, wenn die Liste ihre Höhe ändert (etwa
            # über der Notiz). Die Beschriftung folgt; vorher blieb sie stehen,
            # und der Leertext stand zweimal versetzt da (27.09.2026).
            if not getattr(baum, "_empty_text_bound", False):
                baum._empty_text_bound = True
                baum.bind("<Configure>", lambda _event, b=baum: self.root.after_idle(
                    lambda: self._place_empty_text(b, getattr(self, "empty_text_label", None), nur_nachziehen=True)),
                    add="+")
            self.root.after_idle(lambda: self._place_empty_text(baum, hinweis, nur_nachziehen=True))
        except tk.TclError:
            return None
        return hinweis

    def _place_empty_text(self, baum, hinweis, nur_nachziehen=False):
        """Legt die Leertext-Beschriftung deckend über die leere Zeile – oder nimmt sie weg.

        `nur_nachziehen` verschiebt nur eine gerade gezeigte Beschriftung. Eine
        absichtlich ausgeblendete (etwa in „Mein Tag“) bleibt ausgeblendet.
        """
        try:
            if hinweis is None or not hinweis.winfo_exists() or hinweis.master is not baum:
                return
            if nur_nachziehen and hinweis.winfo_manager() != "place":
                return
            if not baum.exists(self.EMPTY_ROW_ID):
                hinweis.place_forget()
                return
            box = baum.bbox(self.EMPTY_ROW_ID)
            breite = max(160, baum.winfo_width())
            hinweis.configure(wraplength=breite - 48)
            hinweis.place(x=0, y=box[1] if box else 4, width=breite)
            hinweis.tk.call("raise", hinweis._w)
        except tk.TclError:
            pass

    # -----------------------------
    # Wiederholungen (Format 11)
    # -----------------------------
    @classmethod
    def normalize_repeat(cls, value, default_start=None):
        """Prüft eine Wiederholungsregel und liefert sie in fester Form.

        Seit 3.33.20 im Tk-freien `repeat_rules.py` (D17); Verhalten unverändert.
        Alles Unbekannte fällt auf None zurück – eine kaputte Regel darf keine
        Termine erzeugen, die niemand gesetzt hat.
        """
        return glide_repeat.normalize(value, default_start)

    @classmethod
    def add_months(cls, start, months):
        """Verschiebt ein Datum um Monate und behält den Monatsletzten bei (`repeat_rules`)."""
        return glide_repeat.add_months(start, months)

    @classmethod
    def next_repeat_date(cls, regel, letzter, anker=None):
        """Nächster Termin einer Regel nach `letzter`; None, wenn die Reihe endet (`repeat_rules`)."""
        return glide_repeat.next_date(regel, letzter, anker)

    @classmethod
    def describe_repeat(cls, regel):
        """Wiederholungsregel als Klartext – für Maske, Liste und Export."""
        regel = cls.normalize_repeat(regel)
        if regel is None:
            return ""
        art = regel["art"]
        if art == cls.REPEAT_DAILY:
            text = "täglich"
        elif art == cls.REPEAT_EVERY_N_DAYS:
            abstand = regel["abstand"]
            text = "jeden zweiten Tag" if abstand == 2 else f"alle {abstand} Tage"
        elif art == cls.REPEAT_WEEKDAYS:
            namen = ", ".join(cls.REPEAT_WEEKDAY_NAMES[tag] for tag in regel["tage"])
            text = f"jeden {namen}"
        elif art == cls.REPEAT_WEEKLY:
            text = "wöchentlich"
        elif art == cls.REPEAT_MONTHLY:
            text = "monatlich"
        elif art == cls.REPEAT_YEARLY:
            text = "jährlich"
        else:
            return ""
        ende = regel.get("ende")
        if ende:
            text += f" bis {cls.format_due_display(ende)}"
        return text

    @classmethod
    def parse_repeat_text(cls, text):
        """Übersetzt den Klartext einer Wiederholung zurück in eine Regel.

        Gegenstück zu `describe_repeat`, gebraucht beim TXT-Import. Erkennt nur,
        was die eigene Ausgabe erzeugt; alles andere liefert None.
        """
        roh = " ".join(str(text or "").split())
        if not roh:
            return None
        ende = None
        if " bis " in roh:
            roh, rohes_ende = roh.rsplit(" bis ", 1)
            ende = cls.parse_due_input(rohes_ende.strip()) or None
            roh = roh.strip()
        regel = None
        if roh == "täglich":
            regel = {"art": cls.REPEAT_DAILY}
        elif roh == "wöchentlich":
            regel = {"art": cls.REPEAT_WEEKLY}
        elif roh == "monatlich":
            regel = {"art": cls.REPEAT_MONTHLY}
        elif roh == "jährlich":
            regel = {"art": cls.REPEAT_YEARLY}
        elif roh == "jeden zweiten Tag":
            regel = {"art": cls.REPEAT_EVERY_N_DAYS, "abstand": 2}
        elif roh.startswith("alle ") and roh.endswith(" Tage"):
            zahl = roh[5:-5].strip()
            if zahl.isdigit():
                regel = {"art": cls.REPEAT_EVERY_N_DAYS, "abstand": int(zahl)}
        elif roh.startswith("jeden "):
            tage = []
            for kuerzel in roh[6:].split(","):
                kuerzel = kuerzel.strip()
                if kuerzel in cls.REPEAT_WEEKDAY_NAMES:
                    tage.append(cls.REPEAT_WEEKDAY_NAMES.index(kuerzel))
            if tage:
                regel = {"art": cls.REPEAT_WEEKDAYS, "tage": tage}
        if regel is None:
            return None
        if ende:
            regel["ende"] = ende
        return regel

    def advance_repeating_items(self, item_ids):
        """Rückt abgehakte Wiederholungen auf ihren nächsten Termin vor.

        Der Punkt bleibt derselbe und steht danach wieder offen – er wandert
        nur auf die nächste Fälligkeit. Eine zweite, erledigte Kopie stehen zu
        lassen wäre die Alternative gewesen; eine tägliche Aufgabe hinterließe
        so aber in einem Jahr 365 abgehakte Zeilen in derselben Liste. Was
        geschafft wurde, hält stattdessen die Tageszahl fest, und der Verlauf
        der letzten Tage steht auf der Startseite.

        Endet die Reihe – Enddatum überschritten oder kein Termin mehr in
        Sicht –, bleibt der Punkt erledigt und verliert seine Regel. Er ist
        dann eine gewöhnliche, abgeschlossene Aufgabe.

        Rückgabe: Anzahl der vorgerückten Punkte. Läuft innerhalb eines
        `item_change`; der Aufrufer meldet die Änderung.
        """
        vorgerueckt = 0
        for item_id in item_ids or ():
            found = self.find_item_in_lists(item_id)
            if not found:
                continue
            item = found[0]
            regel = self.normalize_repeat(item.get("repeat"))
            if regel is None or not item.get("done") or not self.is_schedulable_item(item):
                continue
            aktuell = self.normalize_due(item.get("due"))
            if not aktuell:
                continue
            try:
                letzter = datetime.strptime(aktuell, "%Y-%m-%d").date()
            except ValueError:
                continue
            anker = self.repeat_anchor_date(item) or letzter
            naechster = self.next_repeat_date(regel, letzter, anker)
            if naechster is None:
                # Die Reihe ist zu Ende. Die Regel zu behalten hieße, den Punkt
                # bei jedem erneuten Abhaken wieder zu prüfen, ohne dass je
                # etwas geschieht.
                item["repeat"] = None
                continue
            item["due"] = naechster.isoformat()
            # Der Arbeitstag gehörte zum abgeschlossenen Vorkommen. Der
            # Aufwand bleibt als Schätzung für die nächste Ausführung erhalten.
            item["planned_date"] = None
            if (item.get("reminder") or {}).get("mode") == "fixed":
                item["reminder"] = None  # Feste Benachrichtigungen gelten nur für dieses Vorkommen.
            elif item.get("reminder"):
                item["reminder"] = self.reminder_config(item["reminder"])
            item["done"] = False
            vorgerueckt += 1
        return vorgerueckt

    @classmethod
    def repeat_anchor_date(cls, item):
        """Ursprungstermin einer Reihe, an dem Monats- und Jahresabstände hängen (`repeat_rules`).

        Der Anker wird beim ersten Vorrücken gesetzt und danach nicht mehr verändert.
        """
        return glide_repeat.anchor_date(item.get("repeat"))

    def due_status(self, item):
        """Liefert 'overdue', 'today', 'soon', 'future' oder '' (kein Datum)."""
        return glide_metrics.due_status(item, datetime.now().date())

    def normalize_items(self, data, seen_ids=None, depth=0, counter=None, known_label_ids=None):
        if not isinstance(data, list):
            return []
        if depth > self.MAX_ITEM_DEPTH:
            raise ValueError("Die Aufgabenstruktur ist zu tief verschachtelt.")
        if seen_ids is None:
            seen_ids = set()
        if counter is None:
            counter = [0]

        normalized = []
        for entry in data:
            counter[0] += 1
            if counter[0] > self.MAX_BACKUP_ITEMS:
                raise ValueError("Die Datei enthält zu viele Aufgaben.")
            if isinstance(entry, str):
                item_id = uuid.uuid4().hex
                seen_ids.add(item_id)
                normalized.append(self.new_item(entry, False, item_id=item_id))
                continue

            if isinstance(entry, dict):
                # Nur ein Langtext darf eigene Zeilenumbrüche tragen; jede
                # andere Art bleibt einzeilig, damit Listen-, TXT- und
                # Markdown-Darstellung zeilentreu bleiben.
                entry_kind = (
                    entry.get("kind") if entry.get("kind") in self.ITEM_KINDS else self.ITEM_KIND_TASK
                )
                text = self.normalize_item_text(entry.get("text", ""), entry_kind)
                if not text:
                    continue
                item_id = entry.get("id") if isinstance(entry.get("id"), str) and entry.get("id") else None
                while not item_id or item_id in seen_ids:
                    item_id = uuid.uuid4().hex
                seen_ids.add(item_id)
                children = self.normalize_items(
                    entry.get("children", []), seen_ids, depth + 1, counter, known_label_ids
                )
                importance = entry.get("importance", entry.get("priority", 0))
                due = entry.get("due")
                description = str(entry.get("description") or "")
                attachments = self.normalize_attachments(entry.get("attachments", []))
                color = entry.get("color") if entry.get("color") in self.ITEM_COLOR_KEYS else None
                # Migration auf Format 6 und 8: ein fehlendes oder unbekanntes
                # 'kind' bedeutet eine gewöhnliche Aufgabe. Bestehende Daten
                # bleiben dadurch unverändert gültig.
                kind = entry.get("kind") if entry.get("kind") in self.ITEM_KINDS else self.ITEM_KIND_TASK
                # Migration auf Format 7: fehlende Labels bedeuten „keine Labels“.
                # Unbekannte Label-IDs werden verworfen, damit keine Zeile auf ein
                # gelöschtes Label verweist.
                labels = self.normalize_item_labels(entry.get("labels"), known_label_ids)
                normalized.append(
                    self.new_item(
                        text,
                        entry.get("done", False),
                        children,
                        item_id,
                        importance,
                        due,
                        description,
                        attachments,
                        color,
                        kind,
                        labels,
                        # Migration auf Format 10: fehlende Uhrzeit heißt
                        # „ganztägig“. Bestehende Fälligkeiten bleiben damit
                        # unverändert gültig.
                        entry.get("due_time"),
                        # Migration auf Format 11: Ein fehlendes Feld heißt
                        # „wiederholt sich nicht". Format-10-Daten bleiben
                        # dadurch unverändert gültig.
                        entry.get("repeat"),
                        entry.get("reminder"),
                        entry.get("planned_date"),
                        entry.get("estimated_minutes"),
                        # Migration auf Format 16: Ein fehlendes Feld bedeutet
                        # „keine Checkliste". Format-15-Daten bleiben gültig.
                        entry.get("checklist"),
                        # Migration auf Format 20: fehlende Verweise, Uhrzeit
                        # und erfasste Zeit bedeuten „keine“.
                        entry.get("links"),
                        entry.get("blocked_by"),
                        entry.get("planned_time"),
                        entry.get("time_spent_minutes"),
                        entry.get("done_at"),
                        references=entry.get("references"),
                    )
                )
        return normalized

    def load_items(self):
        self._time_booking_checked = False
        self._saved_comparison_parts = None
        self._schema_backup_guard = SchemaBackups()
        self._schema12_backup_checked = False
        self._schema13_backup_checked = False
        self._schema14_backup_checked = False
        self._schema15_backup_checked = False
        self._schema16_backup_checked = False
        self._schema17_backup_checked = False
        self._schema18_backup_checked = False
        self._schema19_backup_checked = False
        self._schema20_backup_checked = False
        self._history_replacement = None
        if not os.path.exists(SAVE_FILE):
            self.start_with_empty_dataset()
            self.save_items()
            return
        self._clipped_titles = []
        self.remove_stale_temp_files()
        try:
            with open(SAVE_FILE, "r", encoding="utf-8") as file:
                data = json.load(file)
                self._schema_backup_guard.observe(SAVE_FILE, data, os.fstat(file.fileno()))
            self.lists, active_id_from_file = self.normalize_lists_data(data)
            self.back_up_before_title_clipping()
            self.history = list(getattr(self, "_loaded_history", []) or [])
            if not self.lists:
                self.lists = [self.new_list_object(self.app_title, [])]
            self.ensure_inbox_list()
            inbox_repaired = bool(getattr(self, "_last_inbox_repair", False))
            requested_system_view = (
                self.view_mode
                if self.view_mode in self.DERIVED_ITEM_VIEWS + ("trash", self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW, self.TABLE_VIEW)
                else None
            )
            requested_folder_id = self.active_folder_id
            if not requested_folder_id and isinstance(data, dict):
                saved_folder = data.get("active_folder_id")
                requested_folder_id = saved_folder if isinstance(saved_folder, str) else None
            preferred_active_id = self.active_list_id or active_id_from_file
            if preferred_active_id not in [entry.get("id") for entry in self.lists]:
                existing_ids = [entry.get("id") for entry in self.lists]
                fallback = next((entry.get("id") for entry in self.lists if not self.is_inbox_list(entry)), self.lists[0]["id"])
                preferred_active_id = active_id_from_file if active_id_from_file in existing_ids else fallback
            self.active_list_id = None
            self.active_folder_id = None
            self.view_mode = "list"
            self.set_active_list(preferred_active_id, refresh=False)
            if requested_system_view:
                self._activate_system_view(requested_system_view, refresh=False)
            elif requested_folder_id and self.get_folder(requested_folder_id):
                self.set_active_folder(requested_folder_id, refresh=False)
            self.update_sidebar_list()
            self.refresh_tree()
            self.warn_if_saved_by_older_version(data)
            if self.migrate_on_start(data):
                inbox_repaired = False
            if inbox_repaired:
                self.save_items()
        except NewerDataError as e:
            self.handle_unreadable_save_file(str(e), newer=True)
        except (json.JSONDecodeError, ValueError, RecursionError, tk.TclError) as e:
            self.handle_unreadable_save_file(f"Die Speicherdatei ist beschädigt oder ungültig:\n{e}")
        except OSError as e:
            self.handle_unreadable_save_file(f"Die Speicherdatei konnte nicht gelesen werden:\n{e}")

    def start_with_empty_dataset(self):
        """Grundbestand aus einer leeren Liste und dem Eingang."""
        self.folders = []
        self.labels = []
        self.trash = []
        self.history = []
        self.ensure_system_labels()
        default_list = self.new_list_object(self.app_title, [])
        self.lists = [default_list]
        self.ensure_inbox_list()
        self.active_list_id = default_list["id"]
        self.active_folder_id = None
        self.view_mode = "list"
        self.items = default_list["items"]
        self.update_entry_mode()
        self.update_page_note_preview()
        self.update_page_labels()
        self.update_sidebar_list()
        self.refresh_tree()

    def stored_data_version(self):
        """Datenformat der Speicherdatei, soweit sie sich lesen lässt – sonst None."""
        try:
            with open(SAVE_FILE, "r", encoding="utf-8") as file:
                data = json.load(file)
        except (OSError, ValueError, RecursionError):
            return None
        version = data.get("version") if isinstance(data, dict) else None
        return version if type(version) is int else None

    def handle_unreadable_save_file(self, message, newer=False):
        """Leerer Bestand statt Absturz – ohne die unlesbare Datei je zu überschreiben.

        Bis 3.30 begann Glide hier leer und schrieb beim ersten Speichern über
        die Datei. So ging ein Bestand verloren, den eine ältere Version nur
        nicht lesen konnte: Glide 3.29 hält Format 20 für beschädigt, und die
        erste Eingabe ersetzte ihn. Ein neueres Format öffnet deshalb nur noch
        schreibgeschützt; eine wirklich unlesbare Datei wird vorher kopiert.
        Seit 29.09.2026 gilt dasselbe für eine unbekannte Listenart (`newer`):
        Sie ist das Zeichen einer neueren Fassung, nicht einer kaputten Datei.
        """
        version = self.stored_data_version()
        if newer or (version is not None and version > self.DATA_SCHEMA_VERSION):
            self._data_read_only = True
            self._read_only_reason = "newer_format"
            grund = (f"Die Speicherdatei hat Datenformat {version}; Glide {APP_VERSION} kennt höchstens "
                     f"Format {self.DATA_SCHEMA_VERSION}." if not newer else
                     f"{message}\n\nGlide {APP_VERSION} kennt diesen Inhalt nicht.")
            self.show_error(
                "Bestand aus neuerer Glide-Version",
                grund + "\n\nDieser Start zeigt einen leeren Bestand und "
                "speichert nichts. Die Datei bleibt unverändert – bitte die neuere Glide-Version verwenden.")
        else:
            kopie = self.preserve_unreadable_save_file()
            if kopie:
                # Die Formatsicherungen lesen die Datei beim Speichern erneut und
                # ließen daran jedes Speichern scheitern; die Kopie ersetzt sie.
                for stufe in range(12, self.DATA_SCHEMA_VERSION + 1):
                    setattr(self, f"_schema{stufe}_backup_checked", True)
                message += (f"\n\nDie Datei ist unverändert gesichert:\n{kopie}\n\n"
                            "Ein früherer Stand lässt sich über Datei › Sicherung › "
                            "„Aufgabensicherung laden …“ aus dem Sicherungsordner zurückholen.")
            else:
                # Ohne Kopie darf nichts die Datei ersetzen.
                self._data_read_only = True
                self._read_only_reason = "unreadable"
                message += "\n\nDieser Start speichert nichts, damit die Datei unverändert bleibt."
            self.show_error("Fehler", message)
        self.start_with_empty_dataset()

    def migrate_on_start(self, data):
        """Stellt einen älteren Bestand gleich beim Start auf das aktuelle Format um.

        Bis 29.09.2026 geschah das erst bei der ersten Eingabe. Ein Bestand, der
        nur geöffnet und nicht bearbeitet wurde, blieb damit im alten Format
        liegen – auf dem Windows-PC etwa Format 17, obwohl Glide 3.30 schon
        lief (Prüfung vom 28.09.2026, Punkt 3). Jetzt prüft der Start: Ist die
        Datei älter, sichert `save_items` sie wie bisher bytegenau als
        `liste_vor_format<N>_*.json` und schreibt sie neu. Neuere und unlesbare
        Dateien erreichen diese Stelle nicht; sie behandelt
        `handle_unreadable_save_file`. Rückgabe: ob umgestellt wurde.
        """
        version = data.get("version") if isinstance(data, dict) else None
        if not isinstance(version, int) or isinstance(version, bool) or version >= self.DATA_SCHEMA_VERSION:
            return False
        if getattr(self, "_data_read_only", False):
            return False
        if not self.save_items(show_error=False, record_activity=False):
            return False
        sicherungen = []
        try:
            sicherungen = sorted(name for name in os.listdir(BACKUP_DIR)
                                 if name.startswith("liste_vor_format") and name.endswith(".json"))
        except OSError:
            pass
        self._format_migration_notice = (version, sicherungen[-1] if sicherungen else "")
        try:
            self.root.after(700, self.show_format_migration_notice)
        except tk.TclError:
            pass
        return True

    def show_format_migration_notice(self):
        hinweis = getattr(self, "_format_migration_notice", None)
        self._format_migration_notice = None
        if not hinweis:
            return
        alt, sicherung = hinweis
        text = (f"Der Bestand lag noch in Datenformat {alt} vor und ist jetzt auf Format "
                f"{self.DATA_SCHEMA_VERSION} umgestellt.")
        if sicherung:
            text += f"\n\nDie Datei im alten Format liegt unverändert im Sicherungsordner:\n{sicherung}"
        text += ("\n\nÄltere Glide-Fassungen können den umgestellten Bestand nicht mehr lesen. Nach der "
                 "Umstellung nur noch diese oder eine neuere Fassung starten.")
        self.show_info("Bestand umgestellt", text)

    # Zwischendateien von `write_json_atomic`, die ein abgebrochener Schreibvorgang
    # hinterlassen hat. Jünger als diese Frist könnte eine noch laufende Glide-
    # Instanz (etwa auf einem zweiten Gerät im selben Cloudordner) gerade schreiben.
    STALE_TEMP_MINUTES = 10

    def remove_stale_temp_files(self):
        """Räumt liegengebliebene `.glide-json-*.tmp` im Datenordner auf; Rückgabe: Anzahl."""
        grenze = time.time() - self.STALE_TEMP_MINUTES * 60
        anzahl = 0
        try:
            namen = os.listdir(BASE_DIR)
        except OSError:
            return 0
        for name in namen:
            if not (name.startswith(".glide-json-") and name.endswith(".tmp")):
                continue
            pfad = os.path.join(BASE_DIR, name)
            try:
                if os.path.isfile(pfad) and os.path.getmtime(pfad) < grenze:
                    os.remove(pfad)
                    anzahl += 1
            except OSError:
                continue
        return anzahl

    def preserve_unreadable_save_file(self):
        """Kopiert eine unlesbare Speicherdatei, bevor ein leerer Bestand sie ersetzen kann."""
        try:
            os.makedirs(BACKUP_DIR, exist_ok=True)
            stamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
            target = os.path.join(BACKUP_DIR, f"liste_unlesbar_{stamp}.json")
            shutil.copy2(SAVE_FILE, target)
            return target
        except OSError:
            return None

    def warn_if_saved_by_older_version(self, data):
        """Meldet, wenn eine ältere Glide-Version einen hier schon neueren Bestand überschrieben hat.

        Glide 3.29 hält Format 20 für beschädigt, beginnt leer und ersetzt die
        Datei bei der ersten Eingabe. Der nächste Start einer neueren Version
        findet dann ein älteres Format vor, als sie selbst schon geschrieben
        hatte (`data_format_written` in den Einstellungen).
        """
        version = data.get("version") if isinstance(data, dict) else None
        written = (getattr(self, "settings", None) or {}).get("data_format_written")
        if type(version) is not int or type(written) is not int or version >= written:
            return
        self.show_warning(
            "Bestand von älterer Glide-Version gespeichert",
            f"Die Speicherdatei hat Datenformat {version}, obwohl Glide hier schon Format {written} "
            "gespeichert hatte. Das passiert, wenn eine ältere Glide-Version den Bestand gespeichert "
            "oder jemand eine ältere Datei hineinkopiert hat.\n\nFehlen Einträge, liegen frühere Stände "
            "im Sicherungsordner (Datei › Sicherung › Sicherungsordner öffnen) und lassen sich über "
            "„Aufgabensicherung laden …“ zurückholen.")

    def remember_written_data_format(self):
        """Merkt in den Einstellungen, welches Datenformat hier zuletzt geschrieben wurde.

        Erst mit echtem Inhalt: Ein frisch angelegter, leerer Bestand hat nichts
        zu verlieren. Wer danach eine ältere Datei hineinkopiert, soll keine
        Warnung sehen.
        """
        settings = getattr(self, "settings", None)
        if not isinstance(settings, dict) or settings.get("data_format_written") == self.DATA_SCHEMA_VERSION:
            return
        if not (self.folders or self.trash or any(entry.get("items") for entry in self.lists)):
            return
        settings["data_format_written"] = self.DATA_SCHEMA_VERSION
        self.save_settings()

    def read_only_notice(self):
        """Warum dieser Start nichts speichert – für Hinweise und Statuszeilen."""
        reason = getattr(self, "_read_only_reason", "lock")
        if reason == "newer_format":
            return "Der Bestand stammt aus einer neueren Glide-Version und bleibt unverändert."
        if reason == "unreadable":
            return "Die Speicherdatei ist unlesbar und bleibt unverändert."
        return "Der Datenordner ist anderweitig geöffnet."

    def data_payload(self, lists=None, folders=None, active_list_id=None, active_folder_id=None,
                     labels=None, trash=None, history=None):
        return {
            "version": self.DATA_SCHEMA_VERSION,
            "active_list_id": self.active_list_id if active_list_id is None else active_list_id,
            "active_folder_id": (
                self.active_folder_id if self.view_mode == "folder" else None
            ) if active_folder_id is None else active_folder_id,
            "folders": self.folders if folders is None else folders,
            "labels": self.labels if labels is None else labels,
            "lists": self.lists if lists is None else lists,
            "trash": self.trash if trash is None else trash,
            # Format 15: Der Änderungsverlauf liegt neben den Aufgabenfeldern.
            "history": (getattr(self, "history", []) or []) if history is None else history,
        }

    # Unter Windows scheitert `os.replace` mit „Zugriff verweigert“, solange ein
    # anderer Prozess die Zieldatei gerade offen hält – Virenscanner, OneDrive
    # oder eine zweite lesende Glide-Instanz. Ein kurzes Warten genügt dann
    # (Belastungstest vom 29.09.2026). Andere Fehler gehen sofort weiter.
    REPLACE_RETRY_SECONDS = 1.5

    @staticmethod
    def replace_with_retry(quelle, ziel, frist=None):
        ende = time.monotonic() + (ListApp.REPLACE_RETRY_SECONDS if frist is None else frist)
        pause = 0.02
        while True:
            try:
                os.replace(quelle, ziel)
                return
            except PermissionError:
                # Unter macOS und Linux ist das ein fehlendes Schreibrecht und
                # bleibt es; Warten hilft nur gegen die Windows-Dateisperre.
                if not IS_WINDOWS or time.monotonic() >= ende:
                    raise
                time.sleep(pause)
                pause = min(0.2, pause * 2)

    @staticmethod
    def write_json_atomic(path, payload):
        """Schreibt JSON vollständig und ersetzt die Zieldatei erst am Ende."""
        directory = os.path.dirname(os.path.abspath(path))
        os.makedirs(directory, exist_ok=True)
        fd, temp_file = tempfile.mkstemp(prefix=".glide-json-", suffix=".tmp", dir=directory)
        try:
            # `dumps` in einem Stück statt `dump` in Häppchen: dieselben Bytes,
            # ab Python 3.14 der C-Kodierer statt der Python-Schleife – bei 2.000 Punkten
            # rund 110 statt 25 ms je Datei (Messung 27.09.2026).
            inhalt = ListApp.settings_json_text(payload)
            with os.fdopen(fd, "w", encoding="utf-8") as file:
                file.write(inhalt)
                file.flush()
                os.fsync(file.fileno())
            ListApp.replace_with_retry(temp_file, path)
            temp_file = None
        finally:
            if temp_file:
                try:
                    os.remove(temp_file)
                except OSError:
                    pass

    def save_items(self, *, show_error=True, force_backup=False, record_activity=True,
                   changed_list_ids=None):
        # Bestandsänderungen verwerfen auch Werte in einem noch offenen
        # Aufbau. Dessen Lebensdauer bleibt erhalten; außerhalb eines
        # render_pass werden keine Kennzahlen gehalten.
        self.clear_render_cache()
        self.refresh_data_lock()
        if getattr(self, "_data_read_only", False):
            if show_error:
                hinweis = self.read_only_notice()
                if getattr(self, "_read_only_reason", "lock") == "lock":
                    hinweis += " Bitte Glide nach dem Ordnerabgleich erneut starten."
                self.show_warning("Speichern gesperrt", hinweis)
            return False
        self.dirty = True
        backup_warning = None
        try:
            self.refresh_data_lock()
            self.sync_current_list_reference()
            self.ensure_schema12_backup()
            self.ensure_schema13_backup()
            self.ensure_schema14_backup()
            self.ensure_schema15_backup()
            self.ensure_schema16_backup()
            self.ensure_schema17_backup()
            self.ensure_schema18_backup()
            self.ensure_schema19_backup()
            self.ensure_schema20_backup()
            self.ensure_schema21_backup()
            self.ensure_schema_backup(22)
            self.ensure_schema_backup(23)
            # Der Verlauf entsteht vor dem Schreiben, damit die Datei den
            # Bestand und das dazu passende Protokoll gemeinsam enthält.
            # Nur geprüfte lokale Punktmutationen liefern eine ID-Menge.
            # Direkte Aufrufe, Struktur/Import/Undo und Autosave vergleichen voll.
            if changed_list_ids is not None:
                changed_list_ids = set(changed_list_ids) | {self.active_list_id}
            comparison = self.list_comparison(stamp_done=True, changed_list_ids=changed_list_ids)
            self.update_history(comparison=comparison)
            self.history = self.normalize_history_entries(self.history)
            backup_warning = self.write_backup_copy(force=force_backup)
            self.write_json_atomic(SAVE_FILE, self.data_payload())
            self.dirty = False
        except Exception as e:
            self._saved_comparison_parts = None
            if show_error:
                self.show_error("Fehler beim Speichern", str(e))
            return False

        self._saved_comparison_parts = comparison.parts
        self.remember_written_data_format()

        # Aktivität und „zuletzt bearbeitet“ in einem Schreibvorgang (P06r).
        with self.settings_write_batch():
            self.record_recent_list_edits(record=record_activity, comparison=comparison)
        self.refresh_reminder_status()
        try:
            self.update_sidebar_list()
        except tk.TclError:
            pass
        if backup_warning and show_error:
            self.show_warning(
                "Sicherung nicht möglich",
                "Die aktuellen Daten wurden gespeichert, aber die zusätzliche automatische Sicherung "
                f"konnte nicht erstellt werden:\n{backup_warning}",
            )
        return True

    def ensure_schema_backup(self, target):
        flag = f"_schema{target}_backup_checked"
        if getattr(self, flag, False):
            return
        guard = getattr(self, "_schema_backup_guard", None)
        if guard is None:
            guard = self._schema_backup_guard = SchemaBackups()
        guard.ensure(SAVE_FILE, BACKUP_DIR, target)
        setattr(self, flag, True)

    def ensure_schema12_backup(self):
        """Vor dem ersten Überschreiben alter Daten eine unrotierte Rückfallkopie."""
        self.ensure_schema_backup(12)

    def ensure_schema13_backup(self):
        """Die letzte Datei ohne Benachrichtigungsfelder unverändert und unrotiert sichern."""
        self.ensure_schema_backup(13)

    def ensure_schema15_backup(self):
        """Vor dem ersten Format-15-Speichern die Originaldatei unverändert sichern."""
        self.ensure_schema_backup(15)

    def ensure_schema17_backup(self):
        """Vor dem ersten Format-17-Speichern die Originaldatei unverändert sichern."""
        self.ensure_schema_backup(17)

    def ensure_schema18_backup(self):
        """Vor dem ersten Format-18-Speichern die Originaldatei unverändert sichern."""
        self.ensure_schema_backup(18)


    def ensure_schema19_backup(self):
        """Vor dem ersten Format-19-Speichern die Originaldatei unverändert sichern.

Scheitert die Sicherung, bricht `save_items` ab und die alte Datei
bleibt unverändert. Glide 3.28 und älter können Format 19 nicht lesen."""
        self.ensure_schema_backup(19)

    def back_up_before_title_clipping(self):
        """Zu lange Titel wurden beim Laden gekürzt: Original sichern, speichern, melden.

        Die Kürzung steht zu diesem Zeitpunkt nur im Arbeitsspeicher. Scheitert
        die Sicherung, bleiben Datei und Titel unverändert – gekürzt wird dann
        erst, wenn eine Sicherung gelingt.
        """
        gekuerzt = list(getattr(self, "_clipped_titles", None) or [])
        self._clipped_titles = None
        if not gekuerzt or getattr(self, "_data_read_only", False) or not os.path.isfile(SAVE_FILE):
            return False
        try:
            stamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
            os.makedirs(BACKUP_DIR, exist_ok=True)
            ziel = os.path.join(BACKUP_DIR, f"liste_vor_titelkuerzung_{stamp}.json")
            shutil.copy2(SAVE_FILE, ziel)
        except OSError:
            # Ohne Sicherung keine Kürzung: Die Titel bekommen ihren Wortlaut zurück.
            zurueck = {kurz: original for original, kurz in gekuerzt}
            for halter in list(self.lists) + list(getattr(self, "folders", []) or []):
                if halter.get("title") in zurueck:
                    halter["title"] = zurueck[halter["title"]]
            return False
        self._title_clip_notice = (gekuerzt, ziel)
        self.dirty = True
        self.root.after(600, self.show_title_clip_notice)
        return True

    def show_title_clip_notice(self):
        hinweis = getattr(self, "_title_clip_notice", None)
        self._title_clip_notice = None
        if not hinweis:
            return
        gekuerzt, ziel = hinweis
        self.save_items()
        zeilen = "\n".join(f"• {kurz}" for _original, kurz in gekuerzt[:12])
        rest = f"\n… und {len(gekuerzt) - 12} weitere" if len(gekuerzt) > 12 else ""
        self.show_info("Titel gekürzt",
                       f"{len(gekuerzt)} Titel waren länger als {self.CONTAINER_TITLE_MAX} Zeichen und sind jetzt "
                       f"gekürzt:\n\n{zeilen}{rest}\n\nDie vorherige Datei liegt unter:\n{ziel}")

    def ensure_schema21_backup(self):
        """Original vor dem ersten Schreiben mit Aufgaben-Textverweisen sichern."""
        self.ensure_schema_backup(21)

    def ensure_schema20_backup(self):
        """Vor dem ersten Format-20-Speichern die Originaldatei unverändert sichern.

Scheitert die Sicherung, bricht `save_items` ab und die alte Datei
bleibt unverändert. Glide 3.29 und älter können Format 20 nicht lesen."""
        self.ensure_schema_backup(20)

    def ensure_schema16_backup(self):
        """Vor dem ersten Format-16-Speichern die Originaldatei unverändert sichern."""
        self.ensure_schema_backup(16)

    # --- Änderungsverlauf ---------------------------------------------------

    @classmethod
    def normalize_history_entries(cls, raw):
        """Gespeicherten Verlauf streng prüfen; Unlesbares wird verworfen.

        Ein defektes Protokoll darf niemals einen Bestand blockieren: Im
        Zweifel entsteht eine leere Liste, die Aufgaben bleiben unberührt.
        """
        if not isinstance(raw, list):
            return []
        entries = []
        for value in raw:
            if not isinstance(value, dict):
                continue
            kind = value.get("kind")
            action = value.get("action")
            at = value.get("at")
            if kind not in cls.HISTORY_KINDS or action not in cls.HISTORY_ACTION_NAMES:
                continue
            if not isinstance(at, str) or not at.strip():
                continue
            try:
                age = datetime.now().timestamp() - datetime.fromisoformat(at).timestamp()
                if age > cls.HISTORY_RETENTION_DAYS * 86400:
                    continue
            except (ValueError, OverflowError, OSError):
                continue
            entry = {
                "id": value.get("id") if isinstance(value.get("id"), str) and value.get("id") else uuid.uuid4().hex,
                "at": at.strip()[:32],
                "kind": kind,
                "action": action,
                "target": str(value.get("target") or "")[:cls.HISTORY_TARGET_MAX_LENGTH],
                "list": str(value.get("list") or "")[:cls.HISTORY_TARGET_MAX_LENGTH],
            }
            fields = value.get("fields")
            if isinstance(fields, list):
                clean = [str(name)[:40] for name in fields if isinstance(name, str) and name]
                if clean:
                    entry["fields"] = clean[:12]
            count = value.get("count")
            if isinstance(count, int) and not isinstance(count, bool) and count > 1:
                entry["count"] = count
            entries.append(entry)
        entries.sort(key=lambda entry: datetime.fromisoformat(entry["at"]).timestamp())
        return entries[-cls.MAX_HISTORY_ENTRIES:]

    def history_enabled(self):
        value = self.settings.get("history_enabled", True) if isinstance(getattr(self, "settings", None), dict) else True
        return value if isinstance(value, bool) else True

    @classmethod
    def history_value(cls, item, field):
        """Vergleichswert eines Feldes – stabil sortiert und hashbar."""
        return glide_comparison.history_value(item, field)

    def list_comparison(self, *, stamp_done=False, include_edits=True, changed_list_ids=None):
        """P08a/P08b: vollständiger Vergleich oder explizit geänderte Listen."""
        options = dict(
            item_fields=self.HISTORY_ITEM_FIELDS,
            schedulable=self.is_schedulable_item, drawing_hash=self.drawing_history_hash,
            baseline=getattr(self, "_history_baseline", None),
            completed_at=datetime.now().astimezone().isoformat(timespec="seconds") if stamp_done else None,
            include_edits=include_edits,
        )
        if stamp_done and include_edits:
            return glide_comparison.prepare_comparison(
                getattr(self, "lists", []),
                previous_parts=getattr(self, "_saved_comparison_parts", None),
                changed_ids=changed_list_ids, **options)
        return glide_comparison.compare_lists(getattr(self, "lists", []), **options)

    def history_snapshot(self, comparison=None):
        """Kompakter Vergleichsstand: nur das, was der Verlauf beobachtet."""
        comparison = comparison if comparison is not None else self.list_comparison(include_edits=False)
        folders = {}
        for entry in getattr(self, "folders", []) or ():
            if not isinstance(entry, dict):
                continue
            folder_id = entry.get("id")
            if isinstance(folder_id, str) and folder_id:
                folders[folder_id] = {"title": str(entry.get("title") or ""),
                                      "parent": entry.get("parent_id")}
        labels = {}
        for entry in getattr(self, "labels", []) or ():
            if isinstance(entry, dict) and isinstance(entry.get("id"), str) and entry.get("id"):
                labels[entry["id"]] = str(entry.get("name") or "")
        trash = {}
        for entry in getattr(self, "trash", []) or ():
            if not isinstance(entry, dict):
                continue
            payload = self.trash_entry_payload(entry)
            if not isinstance(payload, dict):
                continue
            objekt_id = payload.get("id")
            if isinstance(objekt_id, str) and objekt_id:
                trash[objekt_id] = {"kind": entry.get("kind") or self.TRASH_KIND_LIST,
                                    "title": self.trash_entry_title(entry)}
        return {"items": comparison.items, "lists": comparison.lists,
                "folders": folders, "labels": labels, "trash": trash}

    @staticmethod
    def drawing_history_hash(entry):
        """SHA-256 des kanonischen Zellmodells oder None für andere Listenarten."""
        document = entry.get("drawing") if isinstance(entry, dict) else None
        if not isinstance(document, dict):
            return None
        return hashlib.sha256(glide_drawing.canonical_json(document).encode("utf-8")).hexdigest()

    def history_events(self, vorher, nachher):
        """Unterschiede zweier Vergleichsstände als Verlaufsereignisse."""
        if not isinstance(vorher, dict) or not isinstance(nachher, dict):
            return []
        ereignisse = []

        def ereignis(kind, action, target, liste="", fields=None):
            eintrag = {"kind": kind, "action": action, "target": target, "list": liste}
            if fields:
                eintrag["fields"] = fields
            ereignisse.append(eintrag)

        alte_punkte, neue_punkte = vorher["items"], nachher["items"]
        alte_listen, neue_listen = vorher["lists"], nachher["lists"]
        alte_ordner, neue_ordner = vorher["folders"], nachher["folders"]
        alter_korb, neuer_korb = vorher["trash"], nachher["trash"]

        def container_verschwunden(list_id):
            """Ist die Liste des Punkts im selben Vorgang selbst weggefallen?

            Dann trägt die Liste das Ereignis; fünfzig Einzelmeldungen für die
            Punkte einer gelöschten Liste wären nur Lärm.
            """
            return list_id in alte_listen and list_id not in neue_listen

        def container_zurueck(list_id):
            """Kam die Liste des Punkts im selben Vorgang aus dem Papierkorb?

            Dann meldet die Liste „wiederhergestellt"; ihre Punkte waren nie
            einzeln weg, sie lagen im Papierkorbeintrag. Eine neu angelegte
            Liste ist der umgekehrte Fall: Ihre Punkte sind neu im Bestand und
            erscheinen – bei Massen als Sammeleintrag.
            """
            return (list_id in neue_listen and list_id not in alte_listen
                    and list_id in alter_korb)

        for punkt_id, neu in neue_punkte.items():
            alt = alte_punkte.get(punkt_id)
            if alt is None:
                if punkt_id in alter_korb and punkt_id not in neuer_korb:
                    ereignis("item", "restored", neu["text"], neu["list_title"])
                elif not container_zurueck(neu["list"]):
                    ereignis("item", "created", neu["text"], neu["list_title"])
                continue
            if alt["list"] != neu["list"] or alt["parent"] != neu["parent"]:
                ereignis("item", "moved", neu["text"], neu["list_title"])
            felder = [feld for feld in self.HISTORY_ITEM_FIELDS
                      if alt["werte"].get(feld) != neu["werte"].get(feld)]
            if "done" in felder:
                felder.remove("done")
                ereignis("item", "done" if neu["werte"].get("done") else "reopened",
                         neu["text"], neu["list_title"])
            if felder:
                ereignis("item", "updated", neu["text"], neu["list_title"],
                         [self.HISTORY_FIELD_NAMES.get(feld, feld) for feld in felder])

        for punkt_id, alt in alte_punkte.items():
            if punkt_id in neue_punkte or container_verschwunden(alt["list"]):
                continue
            if punkt_id in neuer_korb and punkt_id not in alter_korb:
                ereignis("item", "trashed", alt["text"], alt["list_title"])
            elif punkt_id in alter_korb:
                continue  # Der Papierkorbzweig unten meldet das endgültige Entfernen.
            else:
                ereignis("item", "deleted", alt["text"], alt["list_title"])

        for behaelter, alte, neue, kind in (("lists", alte_listen, neue_listen, "list"),
                                            ("folders", alte_ordner, neue_ordner, "folder")):
            for objekt_id, neu in neue.items():
                alt = alte.get(objekt_id)
                if alt is None:
                    if objekt_id in alter_korb and objekt_id not in neuer_korb:
                        ereignis(kind, "restored", neu["title"])
                    elif kind == "list" and neu.get("folder") in alter_korb \
                            and neu.get("folder") in neue_ordner and neu.get("folder") not in alte_ordner:
                        # Der Ordner kam zurück und bringt seine Listen mit; er
                        # trägt das Ereignis.
                        pass
                    else:
                        ereignis(kind, "created", neu["title"])
                    continue
                if alt["title"] != neu["title"]:
                    ereignis(kind, "renamed", neu["title"])
                if kind == "list" and (alt.get("note") != neu.get("note") or alt.get("kind") != neu.get("kind") or alt.get("references") != neu.get("references") or alt.get("page_features") != neu.get("page_features")):
                    ereignis(kind, "updated", neu["title"])
                elif kind == "list" and alt.get("drawing") != neu.get("drawing"):
                    # Nur die Prüfsumme hat sich geändert: „Zeichnung geändert“.
                    ereignis("drawing", "updated", neu["title"])
                schluessel = "folder" if kind == "list" else "parent"
                if alt.get(schluessel) != neu.get(schluessel):
                    ereignis(kind, "moved", neu["title"])
            for objekt_id, alt in alte.items():
                if objekt_id in neue:
                    continue
                if objekt_id in neuer_korb and objekt_id not in alter_korb:
                    ereignis(kind, "trashed", alt["title"])
                elif objekt_id not in alter_korb:
                    ereignis(kind, "deleted", alt["title"])

        for objekt_id, name in nachher["labels"].items():
            if objekt_id not in vorher["labels"]:
                ereignis("label", "created", name)
        for objekt_id, name in vorher["labels"].items():
            if objekt_id not in nachher["labels"]:
                ereignis("label", "deleted", name)

        for objekt_id, alt in alter_korb.items():
            if objekt_id in neuer_korb or objekt_id in nachher["items"]:
                continue
            if objekt_id in nachher["lists"] or objekt_id in nachher["folders"]:
                continue
            kind = {self.TRASH_KIND_ITEM: "item", self.TRASH_KIND_FOLDER: "folder"}.get(
                alt.get("kind"), "list")
            ereignis(kind, "purged", alt.get("title", ""))
        return ereignisse

    def group_history_events(self, ereignisse):
        """Gleichartige Massenereignisse zu einem Sammeleintrag zusammenfassen."""
        gruppen = {}
        for eintrag in ereignisse:
            gruppen.setdefault((eintrag["kind"], eintrag["action"]), []).append(eintrag)
        ergebnis = []
        for eintrag in ereignisse:
            gruppe = gruppen[(eintrag["kind"], eintrag["action"])]
            if len(gruppe) < self.HISTORY_GROUP_THRESHOLD:
                ergebnis.append(eintrag)
                continue
            if gruppe[0] is not eintrag:
                continue
            listen = {teil.get("list") for teil in gruppe if teil.get("list")}
            ergebnis.append({
                "kind": eintrag["kind"],
                "action": eintrag["action"],
                "target": f"{len(gruppe)} × {self.HISTORY_KIND_NAMES.get(eintrag['kind'], 'Objekt')}",
                "list": listen.pop() if len(listen) == 1 else "",
                "count": len(gruppe),
            })
        return ergebnis

    def record_data_operation(self, action, path):
        saved = True
        if self.history_enabled():
            self.record_history_events([{"kind": "data", "action": action,
                                         "target": os.path.basename(str(path)), "list": ""}])
            saved = self.save_items(record_activity=False)
        self.feedback(action)
        return saved

    def record_history_events(self, ereignisse):
        """Ereignisse mit einem Zeitstempel anhängen und die Grenze halten."""
        if not ereignisse:
            return 0
        stempel = datetime.now().isoformat(timespec="seconds")
        if not isinstance(getattr(self, "history", None), list):
            self.history = []
        for eintrag in self.group_history_events(ereignisse):
            if self.coalesce_history_event(eintrag, stempel):
                continue
            neu = {"id": uuid.uuid4().hex, "at": stempel, "kind": eintrag["kind"],
                   "action": eintrag["action"],
                   "target": str(eintrag.get("target") or "")[:self.HISTORY_TARGET_MAX_LENGTH],
                   "list": str(eintrag.get("list") or "")[:self.HISTORY_TARGET_MAX_LENGTH]}
            if eintrag.get("fields"):
                neu["fields"] = list(eintrag["fields"])[:12]
            if eintrag.get("count"):
                neu["count"] = int(eintrag["count"])
            self.history.append(neu)
        self.history = self.normalize_history_entries(self.history)
        return len(ereignisse)

    def coalesce_history_event(self, eintrag, stempel):
        """Führt eine wiederholte Seitenänderung mit dem letzten Eintrag zusammen."""
        if eintrag.get("action") != "updated" or eintrag.get("kind") not in ("list", "drawing"):
            return False
        if eintrag.get("fields") or eintrag.get("count") or not self.history:
            return False
        letzter = self.history[-1]
        if (letzter.get("kind"), letzter.get("action"), letzter.get("target"), letzter.get("list")) != (
                eintrag.get("kind"), "updated",
                str(eintrag.get("target") or "")[:self.HISTORY_TARGET_MAX_LENGTH],
                str(eintrag.get("list") or "")[:self.HISTORY_TARGET_MAX_LENGTH]):
            return False
        try:
            abstand = (datetime.fromisoformat(stempel) - datetime.fromisoformat(str(letzter.get("at")))).total_seconds()
        except (TypeError, ValueError):
            return False
        if not 0 <= abstand <= self.HISTORY_COALESCE_SECONDS:
            return False
        letzter["at"] = stempel
        return True

    def update_history(self, comparison=None):
        """Vor dem Schreiben: Vergleichsstand auswerten und fortschreiben.

        Die eine Stelle, an der Verlaufseinträge entstehen. Sie läuft in jedem
        Speichervorgang – auch dann, wenn die Protokollierung abgeschaltet ist,
        denn der Vergleichsstand muss trotzdem nachgeführt werden.
        """
        comparison = comparison if comparison is not None else self.list_comparison(stamp_done=True)
        neuer_stand = self.history_snapshot(comparison=comparison)
        ersatz = getattr(self, "_history_replacement", None)
        if self.history_enabled():
            if ersatz:
                self.record_history_events([{"kind": "data", "action": "replaced",
                                             "target": str(ersatz), "list": ""}])
            elif isinstance(getattr(self, "_history_baseline", None), dict):
                self.record_history_events(self.history_events(self._history_baseline, neuer_stand))
        self._history_replacement = None
        self._history_baseline = neuer_stand

    def stamp_done_times(self, baseline):
        """Setzt `done_at` beim Erledigen und leert es beim Wiederöffnen.

        Eine Stelle für alle Wege zum Abhaken: Verglichen wird mit dem letzten
        gespeicherten Stand. Ein Punkt, der dort schon erledigt war, aber kein
        Datum trägt, stammt aus älteren Daten und bekommt keines erfunden.
        """
        before = baseline.get("items", {}) if isinstance(baseline, dict) else {}
        now = datetime.now().astimezone().isoformat(timespec="seconds")
        for entry in getattr(self, "lists", []) or ():
            for item in self.walk_items(entry.get("items", [])):
                glide_comparison.stamp_done_time(item, before, now, self.is_schedulable_item)

    def reset_history_baseline(self, replacement=None):
        """Vergleichsstand neu setzen – nach Laden, Import oder Wiederherstellung.

        `replacement` beschreibt die Quelle eines ersetzten Bestands; dann
        entsteht beim nächsten Speichern ein einzelner Eintrag statt eines
        Vergleichs über zwei fremde Stände.
        """
        self._saved_comparison_parts = None
        self._history_baseline = self.history_snapshot()
        self._history_replacement = str(replacement) if replacement else None

    def history_entry_line(self, entry):
        """Ein Verlaufseintrag als Textzeile für Ausgabe und Suche."""
        zeit = self.format_history_time(entry.get("at"))
        teile = [zeit, self.HISTORY_KIND_NAMES.get(entry.get("kind"), "Objekt"),
                 self.HISTORY_ACTION_NAMES.get(entry.get("action"), "geändert")]
        if entry.get("target"):
            teile.append(str(entry["target"]))
        if entry.get("list"):
            teile.append(f"in {entry['list']}")
        if entry.get("fields"):
            teile.append("(" + ", ".join(entry["fields"]) + ")")
        return " · ".join(teile)

    @staticmethod
    def format_history_time(value):
        try:
            return datetime.fromisoformat(str(value)).strftime("%d.%m.%Y %H:%M:%S")
        except (TypeError, ValueError):
            return str(value or "")

    def filtered_history(self, query="", zeitraum="all", art="all"):
        """Verlauf nach Suche, Zeitraum und Art – neueste Einträge zuerst."""
        begriff = str(query or "").strip().lower()
        grenze = None
        if zeitraum == "today":
            grenze = datetime.combine(date.today(), datetime.min.time())
        elif zeitraum in ("7", "30"):
            grenze = datetime.now() - timedelta(days=int(zeitraum))
        ergebnis = []
        for entry in reversed(self.normalize_history_entries(getattr(self, "history", []))):
            if art == "item" and entry.get("kind") != "item":
                continue
            if art == "container" and entry.get("kind") not in ("list", "folder"):
                continue
            if art == "trash" and entry.get("action") not in ("trashed", "restored", "purged", "deleted"):
                continue
            if grenze is not None:
                try:
                    if datetime.fromisoformat(str(entry.get("at"))) < grenze:
                        continue
                except (TypeError, ValueError):
                    continue
            if begriff and begriff not in self.history_entry_line(entry).lower():
                continue
            ergebnis.append(entry)
        return ergebnis

    def clear_history(self):
        """Protokoll leeren; der Bestand bleibt unberührt."""
        if not getattr(self, "history", None):
            return 0
        anzahl = len(self.history)
        self.history = []
        # Der Vergleichsstand bleibt gültig: Geleert wird das Protokoll, nicht
        # der Bestand. Das Leeren selbst ist kein Verlaufseintrag.
        self.save_items()
        return anzahl

    def ensure_schema14_backup(self):
        """Vor dem ersten Format-14-Speichern die Originaldatei unverändert sichern."""
        self.ensure_schema_backup(14)

    def write_backup_copy(self, force=False):
        """Legt eine automatische Sicherung des zuletzt gespeicherten Standes an.

        Ohne ``force`` greift eine Zeitsperre: bei jedem Tastendruck eine eigene
        Datei anzulegen würde den Ordner fluten und die tatsächlich nützlichen
        Rückfallstände verdrängen. Der zeitgesteuerte Sicherungspunkt des
        Autosave setzt die Sperre bewusst außer Kraft.

        Rückgabe: Fehlertext, falls die Sicherung nicht möglich war, sonst None.
        Ein defekter Sicherungsordner darf das Speichern der Nutzdaten nie
        verhindern.
        """
        if not os.path.exists(SAVE_FILE):
            return None
        now = self.monotonic_seconds()
        last = self._last_backup_monotonic
        if not force and last is not None and (now - last) < self.BACKUP_MIN_INTERVAL_SECONDS:
            return None
        try:
            # Nur bei geändertem Inhalt (29.09.2026). Bis dahin legte der
            # Fünf-Minuten-Takt auch ohne Änderung eine Kopie an: Nach 50
            # Minuten Ruhe waren alle zehn Sicherungen gleich, und die älteren
            # Stände waren gelöscht (Prüfung vom 28.09.2026, Punkt 1).
            with open(SAVE_FILE, "rb") as quelle:
                pruefsumme = hashlib.sha256(quelle.read()).hexdigest()
            if pruefsumme == self.latest_backup_digest():
                self._last_backup_monotonic = now
                return None
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
            backup_file = os.path.join(BACKUP_DIR, f"liste_backup_{timestamp}.json")
            os.makedirs(BACKUP_DIR, exist_ok=True)
            shutil.copy2(SAVE_FILE, backup_file)
            self._latest_backup = (backup_file, pruefsumme)
            self._last_backup_monotonic = now
            self.prune_backups()
            return None
        except OSError as exc:
            return str(exc)

    def latest_backup_digest(self):
        """SHA-256 der neuesten automatischen Sicherung – gemerkt, solange die Datei noch da ist.

        Wurde sie gelöscht (von Hand oder beim Aufräumen), wird neu gelesen.
        """
        gemerkt = getattr(self, "_latest_backup", None)
        if gemerkt and os.path.isfile(gemerkt[0]):
            return gemerkt[1]
        pfad, pruefsumme = "", ""
        try:
            kandidaten = [os.path.join(BACKUP_DIR, name) for name in os.listdir(BACKUP_DIR)
                          if name.startswith("liste_backup_") and name.endswith(".json")]
            if kandidaten:
                pfad = max(kandidaten, key=os.path.getmtime)
                with open(pfad, "rb") as quelle:
                    pruefsumme = hashlib.sha256(quelle.read()).hexdigest()
        except OSError:
            pfad, pruefsumme = "", ""
        self._latest_backup = (pfad, pruefsumme) if pfad else None
        return pruefsumme

    @staticmethod
    def monotonic_seconds():
        """Monotone Zeitbasis – unabhängig von Zeitzonen- und Uhrzeitkorrekturen."""
        return time.monotonic()

    def prune_backups(self):
        """Rotiert automatische Sicherungen nach Mindestbestand, Alter, Obergrenze und Tagesstand.

        Reihenfolge und Begründung:
        1. Die neuesten MIN_BACKUPS Sicherungen bleiben immer erhalten – auch
           wenn sie älter als das Höchstalter sind. Sonst stünde nach einer
           längeren Pause keine Rückfallebene mehr bereit. Seit 29.09.2026
           sind das zehn verschiedene Stände, weil nur bei Änderung gesichert
           wird.
        2. Aus dem Rest verschwinden alle, die älter als BACKUP_MAX_AGE_MINUTES
           sind.
        3. Zuletzt begrenzt MAX_BACKUPS die verbleibende Menge.
        4. Unabhängig davon bleibt je Kalendertag der letzte Stand der letzten
           BACKUP_DAILY_DAYS Tage (29.09.2026).

        Portable Sicherungen (`vor_import_*.glidebackup`) fallen bewusst nicht
        unter diese Rotation: sie sind die Rückfallebene eines Imports.
        """
        try:
            backups = [
                os.path.join(BACKUP_DIR, name)
                for name in os.listdir(BACKUP_DIR)
                if name.startswith("liste_backup_") and name.endswith(".json")
            ]
        except OSError:
            return
        if not backups:
            return

        def mtime(path):
            try:
                return os.path.getmtime(path)
            except OSError:
                return 0.0

        backups.sort(key=mtime, reverse=True)  # neueste zuerst
        # Tagesstände: je Kalendertag der neueste, für die letzten Tage.
        heute = date.today()
        tagesstaende = {}
        for path in backups:
            try:
                tag = date.fromtimestamp(mtime(path))
            except (OverflowError, OSError, ValueError):
                continue
            if 0 <= (heute - tag).days < self.BACKUP_DAILY_DAYS and tag not in tagesstaende:
                tagesstaende[tag] = path
        taeglich = set(tagesstaende.values())
        protected = backups[: self.MIN_BACKUPS]
        candidates = backups[self.MIN_BACKUPS:]
        max_age_seconds = self.BACKUP_MAX_AGE_MINUTES * 60
        now = datetime.now().timestamp()
        survivors = []
        for path in candidates:
            if now - mtime(path) > max_age_seconds:
                if path not in taeglich:
                    try:
                        os.remove(path)
                    except OSError:
                        survivors.append(path)
                continue
            survivors.append(path)
        remaining = protected + survivors
        if len(remaining) > self.MAX_BACKUPS:
            for path in remaining[self.MAX_BACKUPS:]:
                if path in taeglich:
                    continue
                try:
                    os.remove(path)
                except OSError:
                    pass

    # -----------------------------
    # Automatisches Speichern
    # -----------------------------
    def schedule_autosave(self):
        """Startet den zeitgesteuerten Speicher- und Sicherungszyklus."""
        if not hasattr(self, "root"):
            return
        interval_ms = max(1, int(self.AUTOSAVE_INTERVAL_MINUTES * 60 * 1000))
        try:
            self._autosave_id = self._register_after(self.root.after(interval_ms, self.autosave_tick))
        except tk.TclError:
            self._autosave_id = None

    def autosave_tick(self):
        """Sichert regelmäßig, ohne den Nutzer mit Dialogen zu unterbrechen.

        Ein noch nicht gespeicherter Stand wird erneut geschrieben; andernfalls
        entsteht ein garantierter Sicherungspunkt. Fehler bleiben still, weil
        ein modaler Dialog im Hintergrund die Arbeit unterbrechen würde – der
        nächste manuelle Speichervorgang meldet das Problem sichtbar.
        """
        self._after_ids.discard(self._autosave_id)
        self._autosave_id = None
        try:
            self.refresh_data_lock()
            # Vollvergleich auch bei dirty=False: Sicherheitsnetz für einen
            # noch nicht deklarierten Änderungsweg. Schreiben bleibt atomar.
            self.save_items(show_error=False, force_backup=True)
        except Exception:
            pass
        finally:
            self.schedule_autosave()

    # -----------------------------
    # Lokale Benachrichtigungen (Format 13)
    # -----------------------------
    @staticmethod
    def reminder_utc(value):
        """Nur eindeutige Zeitpunkte mit Offset akzeptieren; gespeichert wird UTC."""
        if not isinstance(value, str):
            return None
        try:
            parsed = datetime.fromisoformat(value)
            if parsed.tzinfo is None:
                return None
            return parsed.astimezone(timezone.utc).isoformat(timespec="seconds")
        except (ValueError, OverflowError):
            return None

    @classmethod
    def local_reminder_time(cls, day, clock, *, strict=True):
        """Lokale Kalenderzeit; bei doppelter Herbststunde gilt der erste Zeitpunkt."""
        if not cls.normalize_due(day) or not cls.normalize_due_time(clock):
            raise ValueError("Bitte Datum und Uhrzeit für die Benachrichtigung angeben.")
        local = datetime.fromisoformat(f"{day}T{clock}")
        choices = [local.replace(fold=fold).astimezone(timezone.utc) for fold in (0, 1)]
        valid = [value for value in choices
                 if value.astimezone().replace(tzinfo=None) == local]
        if not valid and strict:
            raise ValueError("Diese Ortszeit gibt es wegen der Zeitumstellung nicht. Bitte eine andere Uhrzeit wählen.")
        # Relative Fristen in einer ausgelassenen Stunde werden um die Lücke
        # nach vorn verschoben; feste Eingaben werden dagegen zurückgewiesen.
        return (min(valid) if valid else max(choices)).isoformat(timespec="seconds")

    @classmethod
    def normalize_reminder(cls, value):
        if value is None:
            return None
        if not isinstance(value, dict) or value.get("mode") not in ("fixed", "relative"):
            raise ValueError("Die Benachrichtigung enthält eine unbekannte Einstellung.")
        result = {"mode": value["mode"]}
        if value["mode"] == "fixed":
            result["at"] = cls.reminder_utc(value.get("at"))
            if not result["at"]:
                raise ValueError("Die feste Benachrichtigung benötigt einen eindeutigen Zeitpunkt mit Zeitzone.")
        else:
            minutes = value.get("minutes")
            if type(minutes) is not int or not 0 <= minutes <= 525600:
                raise ValueError("Der Benachrichtigungsabstand muss zwischen 0 und 525600 Minuten liegen.")
            result["minutes"] = minutes
        for key in ("snoozed_until", "delivered_at"):
            if value.get(key) is not None:
                result[key] = cls.reminder_utc(value[key])
                if not result[key]:
                    raise ValueError("Ein gespeicherter Benachrichtigungszeitpunkt ist ungültig.")
        for key in ("snoozed_for", "delivered_key", "acknowledged_key"):
            if value.get(key) is not None:
                if not isinstance(value[key], str) or len(value[key]) > 160:
                    raise ValueError("Der gespeicherte Benachrichtigungsstatus ist ungültig.")
                result[key] = value[key]
        return result

    @classmethod
    def reminder_config(cls, value):
        reminder = cls.normalize_reminder(value)
        return {key: reminder[key] for key in ("mode", "at", "minutes") if key in reminder} if reminder else None

    @classmethod
    def reminder_event(cls, item):
        """Zeitpunkt und stabile Identität des aktuellen Vorkommens, ohne Mutation."""
        if item.get("done") or not cls.is_schedulable_item(item):
            return None
        reminder = cls.normalize_reminder(item.get("reminder"))
        if not reminder:
            return None
        config = cls.reminder_config(reminder)
        if reminder["mode"] == "relative":
            due = cls.normalize_due(item.get("due"))
            if not due:
                return None
            clock = cls.normalize_due_time(item.get("due_time")) or "09:00"
            config.update(due=due, due_time=clock)
            try:
                due_at = cls.local_reminder_time(due, clock, strict=False)
                at = (datetime.fromisoformat(due_at) - timedelta(minutes=reminder["minutes"])).isoformat(timespec="seconds")
            except (ValueError, OverflowError, OSError):
                return None
        else:
            at = reminder["at"]
        base = hashlib.sha256(json.dumps(config, sort_keys=True).encode("utf-8")).hexdigest()
        key = base
        if reminder.get("snoozed_for") == base and reminder.get("snoozed_until"):
            at = reminder["snoozed_until"]
            key += ":" + at
        return {"at": at, "key": key, "base": base}

    def reminder_rows(self, now=None):
        now = now or datetime.now(timezone.utc)
        rows = []
        for source in self.planning_lists():
            for item in self.walk_items(source.get("items", [])):
                event = self.reminder_event(item)
                if not event:
                    continue
                reminder = item["reminder"]
                if reminder.get("acknowledged_key") == event["key"]:
                    state = "Bestätigt"
                elif (reminder.get("delivered_key") == event["key"]
                      or datetime.fromisoformat(event["at"]) <= now):
                    state = "Offen / verpasst"
                elif reminder.get("snoozed_for") == event["base"]:
                    state = "Verschoben"
                else:
                    state = "Geplant"
                rows.append({**event, "item": item, "source": source, "state": state})
        return sorted(rows, key=lambda row: (row["state"] != "Offen / verpasst", row["at"], row["item"]["id"]))

    def process_reminders(self, now=None):
        """Eine Sammelanzeige erst nach dauerhaft gespeichertem Zustellstatus."""
        now = now or datetime.now(timezone.utc)
        self.refresh_data_lock()
        if getattr(self, "_data_read_only", False):
            self._reminder_error = "Benachrichtigungen pausiert: " + self.read_only_notice()
            return 0
        due = [row for row in self.reminder_rows(now)
               if row["state"] == "Offen / verpasst"
               and row["item"]["reminder"].get("delivered_key") != row["key"]]
        if not due:
            self._reminder_error = None
            return 0
        before = [(row["item"], copy.deepcopy(row["item"]["reminder"])) for row in due]
        with self.item_change((), restore=False, background=True) as change:
            for row in due:
                row["item"]["reminder"].update(
                    delivered_key=row["key"], delivered_at=now.isoformat(timespec="seconds"))
            change.mark()
        if not change.saved:
            for item, reminder in before:
                item["reminder"] = reminder
            self._reminder_error = "Benachrichtigungen konnten nicht gespeichert werden. Bitte Datenordner prüfen."
            return 0
        self._reminder_error = None
        self._delivered_titles = [str(row["item"].get("text") or "").strip() for row in due]
        # Rückgängig darf einen bereits angezeigten Hinweis nicht erneut auslösen.
        # Nur Zustellbelege ergänzen; Konfiguration und Aufschub bleiben rücknehmbar.
        delivered = {(row["item"]["id"], row["key"]) for row in due}
        for snapshot in self.undo_stack:
            listen = unpack_state(snapshot.get("lists"))
            geaendert = False
            for source in listen:
                for item in self.walk_items(source.get("items", [])):
                    event = self.reminder_event(item)
                    if event and (item.get("id"), event["key"]) in delivered:
                        item["reminder"].update(delivered_key=event["key"], delivered_at=now.isoformat(timespec="seconds"))
                        geaendert = True
            if geaendert:
                snapshot["lists"] = PackedState(listen)
        return len(due)

    def reminder_attention_backend(self):
        """Plattformaufruf, der den eigenen Eintrag hervorhebt, oder None.

        Eine echte Systembenachrichtigung mit Glide-Namen setzt eine
        installierte, beim Betriebssystem registrierte Anwendung voraus und
        gehört damit zur Paketierung; siehe
        docs/decisions/SYSTEMBENACHRICHTIGUNGEN.md. Bis dahin wird nur der
        vorhandene Eintrag in Taskleiste oder Dock hervorgehoben. Beide
        Plattformaufrufe bleiben wirkungslos, solange das Fenster vorne ist,
        und nehmen den Fokus nicht weg. Die Einrichtung läuft einmal; ein
        nicht tragfähiger Weg wird als None gemerkt und nicht erneut versucht.
        """
        if hasattr(self, "_attention_backend"):
            return self._attention_backend
        self._attention_backend = None
        try:
            if IS_WINDOWS:
                class FLASHWINFO(ctypes.Structure):
                    _fields_ = [("cbSize", ctypes.c_uint), ("hwnd", ctypes.c_void_p),
                                ("dwFlags", ctypes.c_uint), ("uCount", ctypes.c_uint),
                                ("dwTimeout", ctypes.c_uint)]

                user32 = ctypes.WinDLL("user32", use_last_error=True)
                user32.GetParent.argtypes = [ctypes.c_void_p]
                user32.GetParent.restype = ctypes.c_void_p
                user32.FlashWindowEx.argtypes = [ctypes.POINTER(FLASHWINFO)]
                user32.FlashWindowEx.restype = ctypes.c_bool

                def hervorheben():
                    inner = ctypes.c_void_p(self.root.winfo_id())
                    hwnd = user32.GetParent(inner) or inner.value
                    # FLASHW_ALL blinkt Titel und Taskleiste, FLASHW_TIMERNOFG
                    # endet von selbst, sobald das Fenster nach vorn kommt.
                    info = FLASHWINFO(ctypes.sizeof(FLASHWINFO), ctypes.c_void_p(hwnd),
                                      0x00000003 | 0x0000000C, 0, 0)
                    user32.FlashWindowEx(ctypes.byref(info))

                self._attention_backend = hervorheben
            elif IS_MACOS:
                objc = ctypes.cdll.LoadLibrary("/usr/lib/libobjc.dylib")
                ctypes.cdll.LoadLibrary("/System/Library/Frameworks/AppKit.framework/AppKit")
                # Ohne gesetzte restype liefert ctypes einen 32-Bit-Int und
                # verstümmelt jeden Zeiger auf 64-Bit-Systemen.
                objc.objc_getClass.argtypes = [ctypes.c_char_p]
                objc.objc_getClass.restype = ctypes.c_void_p
                objc.sel_registerName.argtypes = [ctypes.c_char_p]
                objc.sel_registerName.restype = ctypes.c_void_p
                # objc_msgSend ist variadisch; je Aufrufform ein eigener
                # typisierter Zeiger, statt globale argtypes umzuschreiben.
                hole_app = ctypes.CFUNCTYPE(ctypes.c_void_p, ctypes.c_void_p,
                                            ctypes.c_void_p)(("objc_msgSend", objc))
                bitte_um_aufmerksamkeit = ctypes.CFUNCTYPE(
                    ctypes.c_long, ctypes.c_void_p, ctypes.c_void_p,
                    ctypes.c_ulong)(("objc_msgSend", objc))
                klasse = objc.objc_getClass(b"NSApplication")
                shared = objc.sel_registerName(b"sharedApplication")
                request = objc.sel_registerName(b"requestUserAttention:")
                if not (klasse and shared and request):
                    return None

                def hervorheben():
                    # Ein nil-Empfänger ist in Objective-C gefahrlos.
                    # NSInformationalRequest (10) lässt das Dock-Symbol einmal
                    # hüpfen; NSCriticalRequest bliebe bis zur Aktivierung.
                    anwendung = hole_app(klasse, shared)
                    bitte_um_aufmerksamkeit(anwendung, request, 10)

                self._attention_backend = hervorheben
        except Exception:
            self._attention_backend = None
        return self._attention_backend

    def request_reminder_attention(self):
        """Einmaliger Anstoß je Prüflauf, nie einer je Aufgabe."""
        if not self.settings.get("reminder_attention", True):
            return False
        backend = self.reminder_attention_backend()
        if backend is None:
            return False
        try:
            backend()
        except Exception:
            # Aufmerksamkeit ist Beiwerk: Der Hinweis bleibt in der Übersicht
            # offen, auch wenn die Plattform ihn nicht hervorheben kann.
            self._attention_backend = None
            return False
        return True

    # --- Systemmitteilung (Stufe B, 27.09.2026) -------------------------
    def system_notification_backend(self):
        """`tk sysnotify` aus Tk 9, oder None mit Grund in `_system_notification_error`.

        Tk 9 bringt Systemmitteilungen ohne Zusatzpaket mit: unter macOS über
        die Mitteilungszentrale, unter Windows über den Infobereich, unter
        Linux über libnotify mit eigenem Rückfallfenster. Windows verlangt
        dafür ein Symbol im Infobereich; es wird erst angelegt, wenn eine
        Mitteilung gesendet wird, und ein Klick darauf holt Glide nach vorn.
        Unter Tk 8.6 gibt es den Befehl nicht – dann bleibt es beim
        Hervorheben in Dock bzw. Taskleiste.
        """
        if hasattr(self, "_system_notification_backend"):
            return self._system_notification_backend
        self._system_notification_backend = None
        self._system_notification_error = ""
        if not self.tk_has_sysnotify(self.root):
            self._system_notification_error = ("Diese Tk-Version kennt keine Systemmitteilungen "
                                               f"(Tk {self.root.tk.call('info', 'patchlevel')}; nötig ist Tk 9).")
            return None
        system = self.root.tk.call("tk", "windowingsystem")

        def senden(titel, text):
            if system == "win32" and not self.root.tk.call("set", "::tk::systray::_created"):
                symbol = getattr(self, "_tray_image", None)
                if symbol is None:
                    symbol = self._tray_image = self.app_icon_photo(16)
                self.root.tk.call("tk", "systray", "create", "-image", symbol, "-text", APP_NAME,
                                  "-button1", self.root.register(self.bring_to_front))
            self.root.tk.call("tk", "sysnotify", titel, text)

        self._system_notification_backend = senden
        return senden

    @staticmethod
    def tk_has_sysnotify(root):
        """Kennt dieses Tk `tk sysnotify`? Ohne Argumente antwortet Tk 9 mit einem Aufruffehler."""
        try:
            root.tk.call("tk", "sysnotify")
        except tk.TclError as exc:
            return "wrong # args" in str(exc)
        return True

    def app_icon_photo(self, size=16):
        """Kleines App-Symbol für den Infobereich – aus dem App-Symbol (seit 29.09.2026).

        Fehlt die Ressource, bleibt es bei einer Fläche in der Akzentfarbe.
        """
        try:
            fotos = glide_logo.icon_photos(self.root, (size,))
            if fotos:
                return fotos[0]
        except (tk.TclError, ValueError, OSError):
            pass
        bild = tk.PhotoImage(master=self.root, width=size, height=size)
        farbe = self.theme.get("ui_accent", "#4F7CFF")
        bild.put(farbe, to=(0, 0, size, size))
        return bild

    def bring_to_front(self):
        try:
            self.root.deiconify()
            self.root.lift()
            self.root.focus_force()
        except tk.TclError:
            pass

    def send_system_notification(self, titel, text):
        """Sendet eine Systemmitteilung; False mit Grund, wenn es nicht geht."""
        backend = self.system_notification_backend()
        if backend is None:
            return False
        try:
            backend(titel[:120], text[:400])
        except Exception as exc:
            # Mitteilungen sind Beiwerk: der Hinweis bleibt in der Übersicht.
            self._system_notification_error = f"Systemmitteilung nicht möglich: {exc}"
            self.log_error(f"Systemmitteilung: {exc!r}")
            return False
        self._system_notification_error = ""
        return True

    @staticmethod
    def reminder_notification_text(titles):
        """Eine Sammelmitteilung je Prüflauf: Titel bei einem Punkt, sonst Anzahl und die ersten drei."""
        titles = [t for t in (titles or []) if t] or ["Erinnerung"]
        if len(titles) == 1:
            return "Glide – Erinnerung", titles[0]
        erste = " · ".join(titles[:3])
        rest = len(titles) - 3
        return (f"Glide – {len(titles)} Erinnerungen fällig",
                erste + (f" · und {rest} weitere" if rest > 0 else ""))

    def send_reminder_notification(self, titles):
        if not self.settings.get("system_notifications", False):
            return False
        return self.send_system_notification(*self.reminder_notification_text(titles))

    def test_system_notification(self):
        """Probe aus dem Menü: zeigt, ob und warum Mitteilungen ankommen."""
        if self.send_system_notification("Glide – Probe", "So sehen Benachrichtigungen von Glide aus."):
            hinweis = ("Die Probe wurde an das System übergeben. Erscheint sie nicht, "
                       "Mitteilungen für Glide bzw. Python in den Systemeinstellungen erlauben.")
            if not self.settings.get("system_notifications", False):
                hinweis += " Eingeschaltet wird die Funktion unter Einstellungen › Persönlich."
            self.show_info("Systemmitteilung", hinweis)
            return True
        self.show_warning("Systemmitteilung", getattr(self, "_system_notification_error", "")
                          or "Systemmitteilungen sind auf diesem System nicht verfügbar.")
        return False

    def schedule_reminder_check(self, delay=15000):
        self._reminder_tick_id = self._register_after(self.root.after(delay, self.reminder_tick))

    def reminder_tick(self):
        self._after_ids.discard(getattr(self, "_reminder_tick_id", None))
        self._reminder_tick_id = None
        try:
            # Keine Zustellung in einem offenen Bearbeitungsdialog: dessen
            # Entwurf könnte sonst gerade überholte Termine zurückschreiben.
            if not self.root.grab_current():
                # Erst der gespeicherte Zustellbeleg, dann der Anstoß: ein
                # Speicherfehler liefert 0 und hebt nichts hervor.
                if self.process_reminders():
                    self.request_reminder_attention()
                    self.send_reminder_notification(getattr(self, "_delivered_titles", []))
            self.refresh_reminder_status()
        finally:
            self.schedule_reminder_check()

    def refresh_reminder_status(self):
        label = getattr(self, "reminder_status", None)
        if label is None:
            return
        pending = sum(row["state"] == "Offen / verpasst" for row in self.reminder_rows())
        message = getattr(self, "_reminder_error", "")
        label.configure(text=message, fg=self.theme["delete"])
        if message:
            label.pack(fill="x", pady=(4, 6), before=self.main_area)
        else:
            label.pack_forget()
        self.apply_reminder_badge(pending)

    def apply_reminder_badge(self, pending=None):
        """Glocke mit der Zahl offener Hinweise; das Wort steht im Tooltip.

        Bis 27.09.2026 stand bei breitem Fenster „Benachrichtigungen (1)“ als
        breitester Knopf zwischen lauter Symbolen. Die Zahl ist die eigentliche
        Auskunft und bleibt deshalb in jeder Breite neben der Glocke.
        """
        button = getattr(self, "notifications_button", None)
        if button is None:
            return
        if pending is None:
            pending = sum(row["state"] == "Offen / verpasst" for row in self.reminder_rows())
        self._pending_reminder_count = pending
        self.pack_header_controls()
        button.set_text(f"{self.ICONS['notifications']} {pending}" if pending else self.ICONS["notifications"])
        button.configure(width=72 if pending else 42)
        self.add_tooltip(button, "Benachrichtigungen"
                         + (f" · {pending} offen" if pending else " · keine offenen Hinweise"))

    def update_reminder_badge(self):
        """Nur die Beschriftung nachziehen, ohne den Bestand erneut zu prüfen."""
        self.apply_reminder_badge()

    def change_reminder(self, item_id, action, until=None):
        found = self.find_item_in_lists(item_id)
        if not found or not self.reminder_event(found[0]):
            return False
        self.refresh_data_lock()
        if getattr(self, "_data_read_only", False):
            self.show_warning("Benachrichtigungen", self.read_only_notice())
            return False
        item = found[0]
        event = self.reminder_event(item)
        if action == "snooze":
            until = self.reminder_utc(until)
            if not until or datetime.fromisoformat(until) <= datetime.now(timezone.utc):
                self.show_warning("Benachrichtigung verschieben", "Bitte einen Zeitpunkt in der Zukunft wählen.")
                return False
        elif action not in ("acknowledge", "complete"):
            return False
        before = copy.deepcopy(item)
        undo_size = len(self.undo_stack)
        with self.item_change((), restore=False) as change:
            if action == "snooze":
                item["reminder"]["snoozed_for"] = event["base"]
                item["reminder"]["snoozed_until"] = until
            elif action == "acknowledge":
                item["reminder"]["acknowledged_key"] = event["key"]
            else:
                item["done"] = True
                self.advance_repeating_items([item_id])
            change.mark()
        if not change.saved:
            item.clear()
            item.update(before)
            del self.undo_stack[undo_size:]
            self.refresh_tree()
        elif action == "complete":
            self.book_completions(1)
        self.refresh_reminder_status()
        return bool(change.saved)

    def open_reminders(self):
        self.process_reminders()
        dialog = tk.Toplevel(self.root)
        dialog.title("Benachrichtigungen")
        dialog.configure(bg=self.theme["bg"])
        dialog.transient(self.root)
        dialog.minsize(700, 480)
        outer = tk.Frame(dialog, bg=self.theme["bg"])
        outer.pack(fill="both", expand=True, padx=self.DIALOG_PAD_X, pady=self.DIALOG_PAD_Y)
        tk.Label(outer, text="Benachrichtigungen", font=app_font(16, "bold"),
                 bg=self.theme["bg"], fg=self.theme["text"]).pack(anchor="w")
        tk.Label(outer, text="Hinweise erscheinen in Glide bei laufender App. Nach einer Pause stehen verpasste Termine gesammelt hier.\n"
                 "Bei beendetem Programm gibt es noch keine Systembenachrichtigung. Verschieben ändert nur die Benachrichtigung.",
                 font=app_font(10), bg=self.theme["bg"], fg=self.theme["muted"], justify="left",
                 wraplength=660, anchor="w").pack(fill="x", pady=(8, 16))
        footer = tk.Frame(outer, bg=self.theme["bg"])
        footer.pack(side="bottom", fill="x", pady=(12, 0))
        message = tk.Label(outer, text="", bg=self.theme["bg"], fg=self.theme["text"],
                           anchor="w", justify="left", font=app_font(10), wraplength=660)
        message.pack(side="bottom", fill="x", pady=(10, 0))
        frame = tk.Frame(outer, bg=self.theme["card"])
        frame.pack(fill="both", expand=True)
        tree = ttk.Treeview(frame, name="reminders_tree", columns=("at", "state"), selectmode="browse",
                            style="Dialog.Treeview", height=9)
        # „Zeitpunkt (Ortszeit)" brauchte mehr als die
        # festgesetzten 150 Pixel und war deshalb angeschnitten. Die
        # Mindestbreite folgt jetzt der gemessenen Überschrift, und alle drei
        # Spalten lassen sich ziehen.
        self.prepare_table(tree, (("#0", "Aufgabe", 280), ("at", "Zeitpunkt (Ortszeit)", 170),
                                  ("state", "Status", 140)), stretch="#0")
        scroll = ThemedAutoScrollbar(frame, bg_color=self.theme["card"], track_color=self.theme["card"],
            thumb_color=self.theme["input_border"], active_thumb_color=self.theme["muted"], width=10, radius=5)
        scroll.pack(side="right", fill="y")
        scroll.set_command(tree.yview)
        tree.configure(yscrollcommand=scroll.set)
        tree.pack(fill="both", expand=True)
        rows_by_id = {}

        def selected():
            ids = tree.selection()
            return rows_by_id.get(ids[0]) if ids else None

        def details(_event=None):
            row = selected()
            message.configure(text=(self.list_path_title(row["source"]) + "\n" + row["item"]["text"]
                                    if row else "Keine Benachrichtigungen. Eine Benachrichtigung lässt sich in den Punktdetails einstellen."))

        def refresh():
            old = tree.selection()
            rows_by_id.clear()
            rows = self.reminder_rows()
            tree.delete(*tree.get_children())
            for row in rows:
                item_id = row["item"]["id"]
                rows_by_id[item_id] = row
                when = datetime.fromisoformat(row["at"]).astimezone().strftime("%d.%m.%Y %H:%M")
                tree.insert("", "end", iid=item_id, text=self.item_display_text(row["item"]), values=(when, row["state"]))
            target = old[0] if old and old[0] in rows_by_id else next(iter(rows_by_id), None)
            if target:
                tree.selection_set(target)
                tree.focus(target)
                tree.see(target)
            details()
            self.refresh_reminder_status()

        def open_task(_event=None):
            row = selected()
            if row:
                dialog.destroy()
                self.clear_search()
                self.open_task_in_source_list(row["source"]["id"], row["item"]["id"])
            return "break"

        def change(action):
            row = selected()
            if row:
                self.change_reminder(row["item"]["id"], action)
                refresh()

        def snooze():
            row = selected()
            if not row:
                return
            default = (datetime.now().astimezone() + timedelta(minutes=10)).replace(second=0, microsecond=0)
            chosen = self.themed_due_dialog(default.date().isoformat(), default.strftime("%H:%M"),
                                           parent=dialog, title="Benachrichtigung verschieben")
            if chosen:
                try:
                    until = self.local_reminder_time(chosen[0], chosen[1])
                except (ValueError, OverflowError, OSError) as exc:
                    self.show_warning("Benachrichtigung verschieben", str(exc), parent=dialog)
                    return
                self.change_reminder(row["item"]["id"], "snooze", until)
                refresh()

        actions = ButtonFlow(footer, bg=self.theme["bg"], gap=8)
        actions.pack(fill="x")
        for text, command, color in (("Aufgabe öffnen", open_task, "accent"),
                ("Verschieben …", snooze, "due_action"), ("Aufgabe erledigen", lambda: change("complete"), "confirm"),
                ("Hinweis bestätigen", lambda: change("acknowledge"), "muted"),
                ("Schließen", dialog.destroy, "muted")):
            width = max(124, tkfont.Font(font=app_font(10, "bold")).measure(text) + 32)
            actions.add(self._make_dialog_button(actions, text, command, color, width=width))
        tree.bind("<<TreeviewSelect>>", details)
        tree.bind("<Double-Button-1>", open_task)
        tree.bind("<Return>", open_task)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        refresh()
        self._center_dialog(dialog, min_width=780, min_height=520)
        self._schedule_windows_chrome_theme(dialog)
        tree.focus_set()
        refresh_id = None

        def tick():
            nonlocal refresh_id
            self._after_ids.discard(refresh_id)
            if self.root.grab_current() is dialog:
                self.process_reminders()
                refresh()
            refresh_id = self._register_after(dialog.after(15000, tick))

        refresh_id = self._register_after(dialog.after(15000, tick))
        try:
            self.run_modal(dialog)
        finally:
            if refresh_id:
                self.root.after_cancel(refresh_id)
                self._after_ids.discard(refresh_id)
        self.refresh_reminder_status()


    def walk_items(self, items=None):
        if items is None:
            items = self.items
        for item in items:
            yield item
            yield from self.walk_items(item.get("children", []))

    def find_item(self, item_id, items=None, parent_list=None, parent_item=None):
        if items is None:
            items = self.items
            parent_item = None

        for index, item in enumerate(items):
            if item.get("id") == item_id:
                return item, items, index, parent_item
            found = self.find_item(item_id, item.get("children", []), item.get("children", []), item)
            if found:
                return found
        return None

    def find_item_in_lists(self, item_id):
        """Sucht einen Punkt über alle Listen hinweg.

        Wird von der abgeleiteten Ansicht „In Bearbeitung“ benötigt, deren
        Zeilen auf Aufgaben fremder Listen verweisen.
        """
        if not item_id:
            return None
        for entry in self.lists:
            found = self.find_item(item_id, entry.get("items", []), entry.get("items", []), None)
            if found:
                return found[0], found[1], found[2], entry
        return None

    def update_in_progress_item(self, item_id, field, value):
        """Ändert eine Aufgabe direkt aus einer Übersicht wie „Heute“ oder „Demnächst“ heraus."""
        found = self.find_item_in_lists(item_id)
        if not found:
            return "break"
        item = found[0]
        if field == "due":
            new_value = self.normalize_due(value) if value else None
            if value and new_value is None:
                self.show_warning("Fälligkeit", "Das Fälligkeitsdatum ist ungültig.")
                return "break"
        elif field == "planned_date":
            # Der Bearbeitungstag ist freiwillig und unabhängig von der
            # Fälligkeit; ein leerer Wert entfernt ihn.
            new_value = self.normalize_due(value) if value else None
            if value and new_value is None:
                self.show_warning("Bearbeitungstag", "Der Bearbeitungstag ist ungültig.")
                return "break"
            if not self.is_schedulable_item(item):
                return "break"
        elif field == "importance":
            new_value = self.clamp_importance(value)
        elif field == "color":
            new_value = value if value in self.ITEM_COLOR_KEYS else None
        elif field == "done":
            # Seit 3.33.20 derselbe Weg wie Abhaken in der Liste: Wiederholungen
            # rücken vor, die Tageszahl zählt, eine wiederkehrende Checkliste
            # öffnet sich wieder. Bis dahin setzte die Übersicht nur das Feld.
            if bool(item.get("done")) != bool(value):
                self.toggle_item_done_anywhere(item_id)  # zeichnet über item_change neu
            return "break"
        else:
            return "break"
        if item.get(field) == new_value:
            return "break"
        self.snapshot_undo()
        item[field] = new_value
        self.save_items()
        self.refresh_tree()
        return "break"

    def edit_in_progress_item(self, item_id):
        """Öffnet den Detaildialog für eine Aufgabe aus einer fremden Liste."""
        found = self.find_item_in_lists(item_id)
        if not found:
            return "break"
        item = found[0]
        details = self.themed_item_details_dialog(item)
        if details is None:
            return "break"
        # Der Punkt gehört einer fremden Liste: Es gibt hier keine Auswahl im
        # Baum, die danach wiederhergestellt werden könnte.
        with self.item_change((), restore=False) as change:
            if self.apply_item_details(item, details):
                change.mark()
        return "break"

    def item_contains_id(self, item, target_id):
        for child in item.get("children", []):
            if child.get("id") == target_id or self.item_contains_id(child, target_id):
                return True
        return False

    def remove_item_by_id(self, item_id):
        found = self.find_item(item_id)
        if not found:
            return None
        item, siblings, index, _parent_item = found
        return siblings.pop(index)

    def is_mouse_event(self, event):
        """True nur bei echten Maus-/Touchpad-Klicks, nicht bei Tastatur-Events."""
        try:
            return isinstance(getattr(event, "num", None), int) and getattr(event, "num", None) in (1, 2, 3)
        except Exception:
            return False

    def get_item_number_path(self, item_id, items=None, prefix=None):
        """Ermittelt die sichtunabhängige hierarchische Nummerierung eines Punkts."""
        if items is None:
            items = self.items
        if prefix is None:
            prefix = []
        for index, item in enumerate(items, start=1):
            current = prefix + [index]
            if item.get("id") == item_id:
                return current
            child_result = self.get_item_number_path(item_id, item.get("children", []), current)
            if child_result:
                return child_result
        return None

    # -----------------------------
    # Treeview Darstellung
    # -----------------------------
    def on_tree_scroll(self, first, last):
        self.hide_quick_plan_row()
        """Blendet die Scrollbar nur dann ein, wenn der Listeninhalt wirklich scrollbar ist."""
        if not hasattr(self, "scrollbar"):
            return
        try:
            first_f = float(first)
            last_f = float(last)
        except (TypeError, ValueError):
            self.scrollbar.set(first, last)
            return

        self.scrollbar.set(first, last)
        needs_scrollbar = not (first_f <= 0.0 and last_f >= 1.0)

        if needs_scrollbar and not getattr(self, "scrollbar_visible", False):
            self.scrollbar.pack(side="right", fill="y", padx=(0, 10), pady=14)
            self.scrollbar_visible = True
        elif not needs_scrollbar and getattr(self, "scrollbar_visible", False):
            self.scrollbar.pack_forget()
            self.scrollbar_visible = False

    def refresh_scrollbar_state(self):
        if hasattr(self, "tree"):
            self.tree.yview_moveto(self.tree.yview()[0])

    def remember_expanded_state(self):
        if not hasattr(self, "tree"):
            return
        expanded = set(self.expanded_ids)
        collapsed = set(self.collapsed_item_ids)
        for item in self.walk_items():
            item_id = item.get("id")
            try:
                if not item_id or not self.tree.exists(item_id) or not item.get("children"):
                    continue
                if self.tree.item(item_id, "open"):
                    expanded.add(item_id)
                    collapsed.discard(item_id)
                else:
                    collapsed.add(item_id)
                    expanded.discard(item_id)
            except tk.TclError:
                pass
        self.expanded_ids = expanded
        self.collapsed_item_ids = collapsed

    # -----------------------------
    # Platzhalter / responsive Filterleiste
    # -----------------------------
    def set_entry_placeholder(self, event=None):
        if not hasattr(self, "entry"):
            return
        if not self.entry.get().strip():
            self.entry_placeholder_active = True
            self.entry.configure(fg=self.theme["placeholder"])
            self.entry.delete(0, tk.END)
            self.entry.insert(0, self.entry_placeholder_text)

    def clear_entry_placeholder(self, event=None):
        if not hasattr(self, "entry"):
            return
        if self.entry_placeholder_active:
            self.entry_placeholder_active = False
            self.entry.configure(fg=self.theme["text"])
            self.entry.delete(0, tk.END)

    def get_entry_text(self):
        if not hasattr(self, "entry"):
            return ""
        raw_text = self.entry.get().strip()
        if getattr(self, "entry_placeholder_active", False):
            if raw_text == self.entry_placeholder_text:
                return ""
            # Robuste Absicherung: Falls Text per Zwischenablage oder Skript eingefügt wurde,
            # während der Platzhalterstatus noch aktiv war, wird der echte Text trotzdem übernommen.
            self.entry_placeholder_active = False
            self.entry.configure(fg=self.theme["text"])
        return raw_text

    def set_search_placeholder(self, event=None):
        if not hasattr(self, "search_entry"):
            return
        if not self.search_var.get().strip():
            self.search_placeholder_active = True
            self.search_entry.configure(fg=self.theme["placeholder"])
            self.search_var.set(self.search_placeholder_text)

    def clear_search_placeholder(self, event=None):
        if not hasattr(self, "search_entry"):
            return
        if self.search_placeholder_active:
            self.search_placeholder_active = False
            self.search_entry.configure(fg=self.theme["text"])
            self.search_var.set("")

    def update_responsive_filter_visibility(self, event=None):
        """Verdichtet die Suchzeile; der frühere Offen-Filter ist entfernt."""
        width = event.width if event is not None else self.search_frame.winfo_width()
        breit = width >= self.FILTER_VISIBILITY_MIN_WIDTH
        self.filters_visible = breit
        # Die alte Checkbox bleibt absichtlich unsichtbar, auch wenn eine alte
        # Einstellungsdatei noch den früheren Filterzustand enthält.
        box = getattr(self, "hide_done_box_border", None)
        if box is not None:
            try:
                box.pack_forget()
            except tk.TclError:
                pass
        knopf = getattr(self, "detail_button", None)
        if knopf is not None:
            try:
                if breit:
                    knopf.set_text(f"Anzeige: {self.detail_mode_name()}")
                    knopf.configure(width=176)
                else:
                    knopf.set_text(self.ICONS["details"])
                    knopf.configure(width=44)
                    self.add_tooltip(knopf, f"Anzeige: {self.detail_mode_name()}")
            except tk.TclError:
                pass
        self.sync_clear_search_visibility()

    @staticmethod
    def pack_relative(widget, before=None, **optionen):
        """Packt ein Widget vor ein anderes – auch wenn dieses gerade fehlt.

        Seit „Suche löschen“ bei schmalem Fenster
        verschwindet, kann das Bezugswidget eines `before=` fehlen. Tk wirft
        dann einen Fehler und bricht den ganzen Zeilenaufbau ab. Fehlt der
        Bezug, wird ohne ihn gepackt: Die Schaltfläche rutscht dann an die
        Stelle, an der ohnehin Platz geworden ist.
        """
        try:
            if before is not None and before.winfo_manager() == "pack":
                widget.pack(before=before, **optionen)
                return
        except tk.TclError:
            pass
        widget.pack(**optionen)

    def search_row_anchor(self):
        """Wovor die rechten Knöpfe der Suchzeile gepackt werden.

        Ohne „Suche löschen“ landeten sie hinter dem dehnbaren Suchfeld in der
        Packreihenfolge und bekamen nur den Rest: „Pinnwand“ schrumpfte in
        der Tabelle zu „ınwa“, „Liste“ auf der Pinnwand zu „Liste“ ohne Rand.
        """
        knopf = getattr(self, "clear_search_button", None)
        try:
            if knopf is not None and knopf.winfo_manager() == "pack":
                return knopf
        except tk.TclError:
            pass
        return getattr(self, "search_border", None)

    def sync_clear_search_visibility(self, event=None):
        """U03: Löschkreuz nur bei einer wirklichen Suchanfrage."""
        knopf = getattr(self, "clear_search_button", None)
        if knopf is None:
            return
        gesucht = bool(self.current_search_query())
        sichtbar = gesucht
        if sichtbar == getattr(self, "_clear_search_visible", None):
            return
        self._clear_search_visible = sichtbar
        try:
            if sichtbar:
                # Vor den übrigen rechten Knöpfen und vor dem Suchfeld – so
                # bleibt es ganz außen und wird nie gequetscht.
                vorne = next((kind for kind in self.search_frame.pack_slaves() if kind is not knopf), None)
                self.pack_relative(knopf, vorne, side="right")
            else:
                knopf.pack_forget()
        except tk.TclError:
            pass

    def current_search_query(self):
        if not hasattr(self, "search_var"):
            return ""
        raw_text = self.search_var.get().strip()
        if getattr(self, "search_placeholder_active", False):
            if raw_text == self.search_placeholder_text:
                return ""
            # Robuste Absicherung: Falls Text per Zwischenablage oder Skript eingefügt wurde,
            # während der Platzhalterstatus noch aktiv war, wird der echte Text trotzdem als Suche genutzt.
            self.search_placeholder_active = False
            if hasattr(self, "search_entry"):
                self.search_entry.configure(fg=self.theme["text"])
        return raw_text.lower()

    def item_text_matches_query(self, item, query):
        if not query:
            return True
        if self.view_mode == "list" and self.list_text_matches_query(self.current_list(), query):
            return True
        attachment_names = " ".join(
            str(attachment.get("name", ""))
            for attachment in item.get("attachments", [])
            if isinstance(attachment, dict)
        )
        haystack = " ".join([
            str(item.get("text", "")),
            str(item.get("description", "")),
            attachment_names,
            self.IMPORTANCE_NAMES.get(self.clamp_importance(item.get("importance", 0)), ""),
            "erledigt" if item.get("done") else "offen",
            self.format_due_full(item.get("due"), item.get("due_time")),
            self.describe_repeat(item.get("repeat")),
        ]).lower()
        return query in haystack

    @staticmethod
    def list_text_matches_query(entry, query):
        """Nur Inhalte durchsuchen; Formatnamen und Linkkennungen sind keine Treffer."""
        if not entry or not query:
            return False
        text = " ".join((str(entry.get("title") or ""), str(entry.get("note") or ""),
                         str(entry.get("rich_note", {}).get("text") or "")))
        return query.lower() in text.lower()

    def get_filter_mode(self):
        """Der frühere Schalter „Nur offene Punkte“ ist seit 3.27 entfernt."""
        return "all"

    def item_matches_status_filter(self, item):
        mode = self.get_filter_mode()
        if self.is_structural_item(item):
            # Gruppe und Überschrift haben keinen eigenen Erledigt-Zustand. Bei
            # aktivem Statusfilter bleiben sie nur sichtbar, wenn ein Unterpunkt
            # passt – das übernimmt item_visible_by_filter.
            return mode == "all"
        if mode == "open":
            return not item.get("done", False)
        return True

    def item_visible_by_filter(self, item):
        query = self.current_search_query()
        self_matches = self.item_text_matches_query(item, query) and self.item_matches_status_filter(item)
        child_matches = any(self.item_visible_by_filter(child) for child in item.get("children", []))
        return self_matches or child_matches

    def has_active_filter(self):
        return bool(self.current_search_query()) or self.get_filter_mode() != "all"

    def on_open_only_changed(self):
        self.on_filter_changed()

    def on_filter_changed(self):
        self.save_settings()
        self.refresh_tree()

    def clear_search(self):
        self.search_placeholder_active = False
        self.search_var.set("")
        if hasattr(self, "search_entry"):
            self.search_entry.configure(fg=self.theme["text"])
            if self.current_focus_widget() != self.search_entry:
                self.set_search_placeholder()

    def focus_search(self, event=None):
        if self.view_mode == self.HOME_VIEW:
            self.set_active_list(self.ensure_inbox_list()["id"])
        if hasattr(self, "search_entry"):
            self.search_entry.focus_set()
            self.clear_search_placeholder()
            self.search_entry.select_range(0, tk.END)
        return "break"

    def focus_entry(self, event=None):
        if self.view_mode in (self.HOME_VIEW, self.HISTORY_VIEW, self.PAGES_VIEW, self.NOTES_VIEW, self.DRAWINGS_VIEW, self.TEMPLATE_VIEW, self.LIBRARY_VIEW):
            self.set_active_list(self.ensure_inbox_list()["id"])
        if hasattr(self, "entry"):
            self.entry.focus_set()
            self.clear_entry_placeholder()
        return "break"

    def handle_control_n(self, event=None):
        """Unterscheidet Strg+N und Strg+Shift+N anhand der echten Shift-Taste.

        Dadurch löst aktiviertes CapsLock nicht versehentlich „Neue Liste“ aus.
        """
        if event is not None and bool(event.state & 0x0001):
            return self.create_new_list(event)
        return self.focus_entry(event)

    def handle_control_f(self, event=None):
        """Unterscheidet Suche und Wichtigkeit ohne CapsLock-Nebenwirkung."""
        if event is not None and bool(event.state & 0x0001):
            return self.cycle_importance_selected(event)
        return self.focus_search(event)

    def handle_escape(self, event=None):
        focus = self.current_focus_widget()
        if focus == getattr(self, "search_entry", None) and self.search_var.get():
            self.clear_search()
        elif focus == getattr(self, "entry", None):
            if not getattr(self, "entry_placeholder_active", False):
                self.entry.delete(0, tk.END)
        else:
            self.clear_tree_selection()
        return "break"

    def compute_stats(self, items):
        """Fortschritt über echte Aufgaben; Gruppen sind reine Behälter."""
        return glide_metrics.summarize(items, walk=self.walk_items,
                                       schedulable=self.is_schedulable_item,
                                       normalize_due=self.normalize_due,
                                       today=datetime.now().date(), include_details=False).stats

    def _set_stats_text(self, text):
        """Zeigt Fortschrittszahlen nur, wenn die Kopfzeile wirklich Platz hat."""
        self._stats_full_text = text
        self.fit_stats_text()
        self.update_header_title()

    def fit_stats_text(self, event=None):
        """Kennzahlen bleiben einzeilig unter dem Titel; Volltext im Tooltip."""
        label = getattr(self, "stats_label", None)
        row = getattr(self, "subtitle_row", None)
        if label is None or row is None:
            return
        try:
            text = getattr(self, "_stats_full_text", "")
            width = int(getattr(event, "width", 0) or row.winfo_width())
            labels = getattr(self, "page_labels_frame", None)
            reserve = self.packed_width(labels) if labels is not None else 0
            hints = getattr(self, "hints_button", None)
            if hints is not None and hints.winfo_manager():
                reserve += hints.winfo_reqwidth() + 8
            font = self.measurement_font(label.cget("font"))
            inset = max(0, label.text_size()[0] - font.measure(label.cget("text")))
            shown = glide_design.fit_text(text, font.measure, max(0, width - reserve - inset - 6)) if width > 1 else text
            if label.cget("text") != shown:
                label.configure(text=shown)
            if int(float(label.cget("wraplength"))) != 0:
                label.configure(wraplength=0)
            if text:
                self.add_tooltip(label, text)
        except (tk.TclError, ValueError):
            return

    def update_stats_label(self):
        if not hasattr(self, "stats_label"):
            return
        if self.view_mode == self.HISTORY_VIEW:
            count = len(getattr(self, "history", []) or [])
            self._set_stats_text(f"{count} Änderung" if count == 1 else f"{count} Änderungen")
            return
        if self.view_mode == self.PAGES_VIEW:
            count = len(self.page_entries())
            self._set_stats_text("1 Seite" if count == 1 else f"{count} Seiten")
            return
        if self.view_mode == self.DRAWINGS_VIEW:
            count = sum(1 for entry in self.lists if self.is_drawing_list(entry) and not self.is_archived_entry(entry))
            self._set_stats_text("1 Zeichnung" if count == 1 else f"{count} Zeichnungen")
            return
        if self.view_mode == self.NOTES_VIEW:
            count = len(self.note_entries())
            self._set_stats_text("1 Notiz" if count == 1 else f"{count} Notizen")
            return
        if self.view_mode == self.GLOBAL_BOARD_VIEW:
            werkstatt = getattr(self, "workspace", None)
            board = werkstatt.board(werkstatt.GLOBAL_SCOPE) if werkstatt is not None else {"cards": [], "connections": []}
            self._set_stats_text(
                f"{len(board.get('cards', []))} Karte(n) · "
                f"{len(board.get('connections', []))} Verbindung(en)")
            return
        if self.view_mode == self.HOME_VIEW:
            self._set_stats_text(date.today().strftime("%d.%m.%Y"))
            return
        if self.view_mode == "trash":
            folders = sum(1 for entry in self.trash if entry.get("kind") == self.TRASH_KIND_FOLDER)
            items = sum(1 for entry in self.trash if entry.get("kind") == self.TRASH_KIND_ITEM)
            lists = len(self.trash) - folders - items
            if not self.trash:
                self._set_stats_text("Papierkorb ist leer")
            else:
                self._set_stats_text(
                    f"{items} Punkt(e) · {lists} Liste(n) · {folders} Ordner im Papierkorb"
                )
            return
        if self.view_mode == self.LABELS_VIEW:
            gruppen = self.label_view_groups(apply_filters=False)
            # Ein Punkt mit drei Labels steht in drei Gruppen, bleibt aber ein
            # Punkt: gezählt wird über die Kennung, nicht über die Zeilen.
            punkte = {}
            for _key, _label, eintraege in gruppen:
                for _source, item in eintraege:
                    punkte[item.get("id")] = item
            offen = sum(1 for item in punkte.values() if not item.get("done"))
            benannte = [eintrag for eintrag in gruppen if eintrag[0] != self.UNLABELLED_GROUP_KEY]
            text_teile = [f"{len(benannte)} Labelgruppen", f"{len(punkte)} Punkte"]
            if punkte:
                text_teile.append(f"{offen} offen")
            self._set_stats_text(" · ".join(text_teile))
            return
        if self.view_mode == "saved_filter":
            entries = self.saved_filters.entries(apply_filters=True)
            _passend, ausgeblendet, _gruende = self.saved_filters.hidden_reasons()
            text = f"{len(entries)} passende Aufgaben"
            if ausgeblendet:
                text += f" · Ausgeblendet: {ausgeblendet} (Ansicht › Oberfläche › Filter erklären)"
            self._set_stats_text(text)
            return
        if self.view_mode == self.TABLE_VIEW:
            entries = self.table_entries(apply_filters=False)
            done = sum(1 for _order, item in entries if item.get("done"))
            overdue = sum(1 for _order, item in entries if self.due_status(item) == "overdue")
            text = f"{len(entries)} Aufgaben in der Tabelle"
            if entries:
                text += f" · {len(entries) - done} offen"
            if overdue:
                text += f" · {overdue} überfällig"
            # Die Tabellensumme folgt Suche und Offenfilter: Sie beschreibt die
            # sichtbaren Zeilen, nicht den Tag.
            planung = self.format_planning_summary(
                self.planning_summary([item for _order, item in entries])
            )
            if planung:
                text += f" · {planung}"
            self._set_stats_text(text)
            return
        if self.view_mode in self.TASK_OVERVIEW_VIEWS:
            due_entries = self.current_task_overview_items(apply_filters=False)
            done = sum(1 for _due, _list_index, _item_index, _entry, item in due_entries if item.get("done"))
            overdue = sum(1 for _due, _list_index, _item_index, _entry, item in due_entries if self.due_status(item) == "overdue")
            if self.view_mode == "overdue":
                text = f"{len(due_entries)} überfällige Aufgaben"
            elif self.view_mode == self.PLAN_DAY_VIEW:
                text = f"{len(due_entries)} Aufgaben am {self.format_plan_day()}"
                offen_im_eingang = len(self.plan_inbox_items(apply_filters=False))
                if offen_im_eingang:
                    text += f" · {offen_im_eingang} im Eingang ohne Tag"
            else:
                text = f"{len(due_entries)} Aufgaben mit Fälligkeit"
            if due_entries:
                text += f" · {len(due_entries) - done} offen"
            if overdue:
                text += f" · {overdue} überfällig"
            if self.view_mode == self.PLAN_DAY_VIEW:
                text = self.planning_available_text(self.plan_day()) + " · " + text
            self._set_stats_text(text)
            return
        if self.page_chips():
            # Liste, Seite, Zeichnung und Ordner zeigen ihre Kennzahlen unter
            # dem Titel. Bis 27.09.2026 standen sie rechts daneben ein zweites
            # Mal – bei einer Zeichnung sogar als „Noch keine Aufgaben in
            # dieser Liste.“ (Aufräumen, Form folgt Funktion).
            self._set_stats_text("")
            return
        if self.view_mode == "folder" and self.active_folder_id:
            folder_lists = self.get_folder_lists_recursive(self.active_folder_id)
            total = done = overdue = 0
            for entry in folder_lists:
                list_total, list_done, list_overdue = self.list_metrics(entry["id"]).stats
                total += list_total
                done += list_done
                overdue += list_overdue
            list_word = "Liste" if len(folder_lists) == 1 else "Listen"
            text = f"{len(folder_lists)} {list_word} · {total} Punkte"
            if total:
                text += f" · {total - done} offen"
            if overdue:
                text += f" · {overdue} überfällig"
            self._set_stats_text(text)
            return
        total, done, overdue = self.compute_stats(self.items)
        if total == 0:
            text = "Noch keine Aufgaben in dieser Liste."
        else:
            percent = round(done / total * 100)
            open_count = total - done
            text = f"{done} von {total} erledigt \u00b7 {percent}\u00a0%"
            if open_count:
                text += f" \u00b7 {open_count} offen"
            if overdue:
                text += f" \u00b7 {overdue} \u00fcberf\u00e4llig"
        self._set_stats_text(text)

    def schedule_search_refresh(self):
        """Mehrere Änderungen innerhalb eines Ereignisdurchlaufs gemeinsam zeichnen."""
        self.sync_clear_search_visibility()
        if getattr(self, "_search_refresh_after", None) is None:
            self._search_refresh_after = self._register_after(self.root.after_idle(self._flush_search_refresh))

    def _flush_search_refresh(self):
        self._after_ids.discard(getattr(self, "_search_refresh_after", None))
        self._search_refresh_after = None
        self.refresh_tree()

    def refresh_tree(self, selected_id=None):
        self.hide_quick_plan_row()
        pending = getattr(self, "_search_refresh_after", None)
        if pending is not None:
            self.root.after_cancel(pending)
            self._after_ids.discard(pending)
            self._search_refresh_after = None
        with self.render_pass():
            return self._refresh_tree(selected_id=selected_id)

    def flush_rich_note(self):
        """Offene Notiz- und Zeichnungsänderungen vor Navigation, Export und Ende sichern."""
        editor = getattr(self, "rich_note_editor", None)
        if editor is not None and editor.winfo_exists():
            editor.flush()
        self.flush_drawing_editor()

    def store_rich_note(self, list_id, document):
        entry = next((entry for entry in self.lists if entry.get("id") == list_id), None)
        if entry is None:
            return False
        if getattr(self, '_data_read_only', False):
            return False
        editor_change = getattr(self, '_task_editor_change', None)
        if editor_change is not None:
            if entry.get('rich_note') != document:
                entry['rich_note'] = copy.deepcopy(document)
                entry['updated_at'] = datetime.now().astimezone().isoformat(timespec='seconds')
                editor_change.mark()
            return True
        if entry.get("rich_note") != document:
            with self.sidebar_change(feedback=False) as change:
                entry["rich_note"] = copy.deepcopy(document)
                entry["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
                change.mark()
        elif self.dirty:
            self.save_items()
        return not self.dirty

