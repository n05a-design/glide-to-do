    # -----------------------------
    # Einstellungen / Basis
    # -----------------------------
    # -----------------------------
    # Hintergrundverlauf (26.09.2026)
    # -----------------------------
    # Tk kennt keine Transparenz. Der Verlauf erscheint deshalb nur dort, wo
    # eine Fläche ihn selbst zeichnet: Rahmen in der Grundfarbe bekommen einen
    # passgenauen Bildausschnitt als unterstes Kind, Canvas-Flächen (Knöpfe,
    # Karten, Scrollleisten, Startseite, Beschriftungen) das gemeinsame Bild als
    # unterstes Element. Karten und Listen bleiben deckend – der Verlauf ist
    # Atmosphäre, nicht Arbeitsfläche.
    BACKDROP_ZONE_PAD = 24
    BACKDROP_ZONE_FADE = 0.10
    BACKDROP_CACHE_FILES = 6

    def backdrop_choice(self, design=None):
        design = design or self.design_name()
        wert = (self.settings.get("backdrops") or {}).get(design)
        return wert if glide_backdrop.find_preset(design, wert) else glide_backdrop.NONE_KEY

    def set_backdrop_choice(self, key, design=None):
        design = design or self.design_name()
        werte = dict(self.settings.get("backdrops") or {})
        if key and glide_backdrop.find_preset(design, key):
            werte[design] = key
        else:
            werte.pop(design, None)
        self.settings["backdrops"] = werte
        self.save_settings()
        self.refresh_backdrop()
        self.rebuild_backdrop_menu()
        return "break"

    @staticmethod
    def backdrop_cache_dir():
        """Zwischenspeicher der gerechneten Bilder – nicht im (oft synchronisierten) Datenordner."""
        if os.environ.get("GLIDE_DATA_DIR"):
            basis = os.path.join(BASE_DIR, "cache")
        elif IS_MACOS:
            basis = os.path.join(os.path.expanduser("~/Library/Caches"), APP_NAME)
        elif IS_WINDOWS:
            basis = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"), APP_NAME, "Cache")
        else:
            basis = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), APP_NAME.lower())
        return os.path.join(basis, "hintergrund")

    def backdrop_request(self):
        """Alles, was das Bild bestimmt – oder None, wenn kein Verlauf gilt."""
        design = self.design_name()
        preset = glide_backdrop.find_preset(design, self.backdrop_choice(design))
        if preset is None:
            return None
        grund = self._compose_theme()
        roh = self.legible_text_roles(dict(grund))
        try:
            breite = max(self.root.winfo_screenwidth(), self.root.winfo_width())
            hoehe = max(self.root.winfo_screenheight(), self.root.winfo_height())
            kopf = getattr(self, "header_frame", None)
            unterkante = (kopf.winfo_rooty() + kopf.winfo_height() - self.root.winfo_rooty()) if kopf is not None else 0
        except tk.TclError:
            breite, hoehe, unterkante = 1600, 1000, 0
        if unterkante <= 1:
            unterkante = 130
        zone = round(min(0.6, (unterkante + self.BACKDROP_ZONE_PAD) / max(1, hoehe)), 2)
        return {"design": design, "preset": preset, "base": grund["bg"], "text": roh["text"],
                "muted": roh["muted"], "width": int(breite), "height": int(hoehe), "zone": zone}

    @staticmethod
    def backdrop_signature(anfrage):
        teile = (glide_backdrop.ENGINE_VERSION, anfrage["design"], anfrage["preset"].key, anfrage["base"],
                 anfrage["text"], anfrage["muted"], anfrage["width"], anfrage["height"], anfrage["zone"])
        return hashlib.sha1(repr(teile).encode("utf-8")).hexdigest()[:20]

    @staticmethod
    def compute_backdrop(anfrage):
        """Rechnet das Bild (ohne Tk – läuft im Hintergrund-Thread)."""
        preset = anfrage["preset"]
        zonenstaerke = glide_backdrop.fit_intensity(
            preset, anfrage["base"], [anfrage["text"], anfrage["muted"]], rows=(0.0, anfrage["zone"]))
        zone = (anfrage["zone"], zonenstaerke, ListApp.BACKDROP_ZONE_FADE)
        rgb, breite, hoehe, faktor = glide_backdrop.render_scaled(
            preset, anfrage["width"], anfrage["height"], anfrage["base"], zone=zone)
        return {"rgb": rgb, "w": breite, "h": hoehe, "factor": faktor,
                "png": glide_backdrop.encode_png(rgb, breite, hoehe)}

    def refresh_backdrop(self):
        """Holt den Verlauf des aktiven Designs: aus dem Speicher, dem Zwischenspeicher oder neu gerechnet."""
        anfrage = self.backdrop_request()
        if anfrage is None:
            self._backdrop_key = None
            if getattr(self, "_backdrop", None):
                self._backdrop = None
                self.apply_theme()
            self.schedule_backdrop_sync()
            return
        schluessel = self.backdrop_signature(anfrage)
        if schluessel == getattr(self, "_backdrop_key", None):
            self.schedule_backdrop_sync()
            return
        self._backdrop_key = schluessel
        pfad = os.path.join(self.backdrop_cache_dir(), f"{schluessel}.png")
        try:
            with open(pfad, "rb") as datei:
                png = datei.read()
            rgb, breite, hoehe = glide_backdrop.decode_png(png)
            faktor = max(1, round(anfrage["width"] / max(1, breite)))
            self._install_backdrop(anfrage, schluessel, {"rgb": rgb, "w": breite, "h": hoehe,
                                                         "factor": faktor, "png": png})
            return
        except (OSError, ValueError, zlib.error):
            pass
        ergebnis = {}

        def rechnen():
            try:
                ergebnis["daten"] = self.compute_backdrop(anfrage)
            except Exception as fehler:  # pragma: no cover – landet im Fehlerprotokoll
                ergebnis["fehler"] = fehler

        faden = threading.Thread(target=rechnen, name="glide-hintergrund", daemon=True)
        faden.start()

        def abholen():
            if faden.is_alive():
                self.root.after(60, abholen)
                return
            if schluessel != getattr(self, "_backdrop_key", None):
                return
            if "fehler" in ergebnis:
                self.log_error(f"Hintergrundverlauf: {ergebnis['fehler']}\n")
                return
            daten = ergebnis["daten"]
            self._store_backdrop_cache(pfad, daten["png"])
            self._install_backdrop(anfrage, schluessel, daten)

        self.root.after(60, abholen)

    def wait_for_backdrop(self, timeout=30.0):
        """Für Prüfläufe: wartet, bis ein angeforderter Verlauf angelegt ist."""
        ende = time.monotonic() + timeout
        while time.monotonic() < ende:
            verlauf = getattr(self, "_backdrop", None)
            if not getattr(self, "_backdrop_key", None) or (verlauf and verlauf.get("key") == self._backdrop_key):
                break
            self.root.update()
            time.sleep(0.02)
        self.root.update()
        return getattr(self, "_backdrop", None)

    def _store_backdrop_cache(self, pfad, png):
        try:
            ordner = os.path.dirname(pfad)
            os.makedirs(ordner, exist_ok=True)
            with open(pfad + ".tmp", "wb") as datei:
                datei.write(png)
            os.replace(pfad + ".tmp", pfad)
            dateien = sorted((os.path.join(ordner, name) for name in os.listdir(ordner) if name.endswith(".png")),
                             key=os.path.getmtime, reverse=True)
            for alt in dateien[self.BACKDROP_CACHE_FILES:]:
                os.remove(alt)
        except OSError:
            pass

    def _install_backdrop(self, anfrage, schluessel, daten):
        # Das Bild bleibt in Rechenauflösung (halbe Bildschirmgröße, bei den
        # Pixelverläufen ein Punkt je Block). Vergrößert wird erst beim Kopieren
        # der sichtbaren Ausschnitte (`_backdrop_pieces`). Vorher lag es zusätzlich
        # vergrößert im Speicher – bei 2560 × 1720 rund 17 MB.
        bild = tk.PhotoImage(master=self.root, data=base64.b64encode(daten["png"]))
        self._backdrop = {"key": schluessel, "design": anfrage["design"], "image": bild, "rgb": daten["rgb"],
                          "w": daten["w"], "h": daten["h"], "factor": daten["factor"],
                          "avg": glide_backdrop.average(daten["rgb"]), "grain": anfrage["preset"].grain}
        # Grund und Karten folgen dem Verlauf (`glass_backdrop_tint`).
        self.apply_theme()
        self.schedule_backdrop_sync()

    def schedule_backdrop_sync(self, _event=None):
        if getattr(self, "_backdrop_sync_pending", False):
            return
        self._backdrop_sync_pending = True
        try:
            self.root.after_idle(self.sync_backdrop_surfaces)
        except tk.TclError:
            self._backdrop_sync_pending = False

    # Beim Scrollen und Ziehen am Fensterrand melden Rahmen ihre neue Lage bei
    # jedem Schritt. Der Abgleich läuft dann höchstens alle 80 ms statt nach
    # jedem Schritt (Messung 26.09.2026: 20 Scrollschritte 10,5 s).
    #
    # Seit 29.09.2026 (R6) wartet der Abgleich, bis die Bewegung ruht: Jeder
    # Abgleich zeichnet alle Kacheln neu. Mit Verlauf kostete eine
    # Trackpad-Geste auf der Startseite so 131 statt 74 ms, in „Listen und
    # Ordner“ 255 statt 118 ms. Während des Scrollens wandern die Ausschnitte
    # mit ihren Kacheln; 150 ms nach dem letzten Schritt sitzen sie wieder.
    BACKDROP_THROTTLE_MS = 150

    def schedule_backdrop_sync_soon(self, _event=None):
        job = getattr(self, "_backdrop_settle_job", None)
        if job is not None:
            try:
                self.root.after_cancel(job)
            except tk.TclError:
                pass
        try:
            self._backdrop_settle_job = self.root.after(self.BACKDROP_THROTTLE_MS, self._backdrop_settled)
        except tk.TclError:
            self._backdrop_settle_job = None

    def _backdrop_settled(self):
        self._backdrop_settle_job = None
        # Solange noch gescrollt wird, weiter warten – auch wenn ein Bild länger
        # dauert als die Wartezeit. Sonst zöge jedes Bild den Abgleich nach.
        rest = getattr(self, "_scrolling_until", 0) - time.monotonic()
        if rest > 0:
            try:
                self._backdrop_settle_job = self.root.after(int(rest * 1000) + 20, self._backdrop_settled)
            except tk.TclError:
                pass
            return
        if not getattr(self, "_backdrop_sync_pending", False):
            self.sync_backdrop_surfaces()

    def note_scrolling(self):
        """Merkt, dass gerade gescrollt wird (für den Verlaufsabgleich)."""
        self._scrolling_until = time.monotonic() + self.BACKDROP_THROTTLE_MS / 1000

    def backdrop_excluded(self, widget):
        """Flächen, die ihren Inhalt ständig neu zeichnen, bleiben außen vor."""
        if getattr(widget, "_no_backdrop", False):
            return True
        werkstatt = getattr(self, "workspace", None)
        return werkstatt is not None and widget is getattr(werkstatt, "canvas", None)

    def sync_backdrop_surfaces(self):
        """Verteilt den Verlauf auf alle Flächen des Hauptfensters in der Grundfarbe."""
        self._backdrop_sync_pending = False
        verlauf = getattr(self, "_backdrop", None)
        if verlauf and verlauf.get("key") != getattr(self, "_backdrop_key", None):
            verlauf = None
        vorher = getattr(self, "_backdrop_surfaces", set())
        aktiv = set()
        try:
            rx, ry = self.root.winfo_rootx(), self.root.winfo_rooty()
        except tk.TclError:
            return
        grundfarbe = str(self.theme.get("bg", "")).lower()
        if verlauf:
            # Der äußere Rand gehört zum Hauptfenster selbst.
            self._frame_backdrop(self.root, 0, 0, verlauf)
            aktiv.add(self.root)
        karten = []
        stapel = [self.root]
        while stapel and verlauf:
            eltern = stapel.pop()
            try:
                kinder = eltern.winfo_children()
            except tk.TclError:
                continue
            for kind in kinder:
                if isinstance(kind, (tk.Toplevel, tk.Menu)) or getattr(kind, "_is_backdrop", False):
                    continue
                stapel.append(kind)
                if isinstance(kind, RoundedContainer):
                    karten.append(kind)
                try:
                    if not kind.winfo_ismapped() or str(kind.cget("bg")).lower() != grundfarbe:
                        continue
                    x, y = kind.winfo_rootx() - rx, kind.winfo_rooty() - ry
                except (tk.TclError, AttributeError):
                    continue
                if isinstance(kind, tk.Canvas):
                    if self.backdrop_excluded(kind):
                        continue
                    # Jede Fläche zeichnet nur ihre sichtbaren Teile als eigene
                    # kleine Ausschnitte. Mit dem ganzen, bildschirmgroßen Bild
                    # wandelte Tk unter macOS bei jedem Neuzeichnen eines Knopfs
                    # das ganze Bild um.
                    stuecke = self._backdrop_pieces(kind, self._exposed_rects(kind, x, y), verlauf)
                    try:
                        ziel = tuple((foto, kind.canvasx(0) + sx - x, kind.canvasy(0) + sy - y)
                                     for foto, sx, sy in stuecke)
                    except tk.TclError:
                        continue
                    if getattr(kind, "_backdrop", None) != ziel or (ziel and not kind.find_withtag("backdrop")):
                        kind._backdrop = ziel
                        paint_canvas_backdrop(kind)
                        if isinstance(kind, RoundedContainer) and kind.find_withtag("surface"):
                            kind.tag_lower("backdrop")
                    aktiv.add(kind)
                    if isinstance(kind, CanvasLabel):
                        lage = (verlauf["key"], x, y, kind.winfo_width(), kind.winfo_height(), kind.cget("fg"))
                        if getattr(kind, "_fit_sig", None) != lage:
                            kind._fit_sig = lage
                            self.fit_label_to_backdrop(kind, x, y, verlauf)
                elif isinstance(kind, tk.Frame):
                    self._frame_backdrop(kind, x, y, verlauf)
                    aktiv.add(kind)
        for alt in vorher - aktiv:
            self._clear_backdrop_surface(alt)
        self._backdrop_surfaces = aktiv
        self.sync_frosted_cards(karten, verlauf)

    def _clear_backdrop_surface(self, widget):
        try:
            if not widget.winfo_exists():
                return
            widget._backdrop_photos = []
            if isinstance(widget, tk.Canvas):
                widget._backdrop = None
                widget.delete("backdrop")
                if isinstance(widget, CanvasLabel):
                    widget._fit_sig = None
                    widget.set_halo(None)
                    widget.set_contrast_fg(None)
            else:
                for etikett in getattr(widget, "_backdrop_labels", None) or []:
                    if etikett.winfo_exists():
                        etikett.destroy()
                widget._backdrop_labels = []
                widget._backdrop_sig = None
        except tk.TclError:
            pass

    def _frame_backdrop(self, rahmen, x, y, verlauf):
        """Legt den Verlauf in die sichtbaren Teile eines Rahmens – je Teil ein Bild-Label."""
        rechtecke = self._exposed_rects(rahmen, x, y)
        signatur = (verlauf["key"], x, y, tuple(rechtecke))
        etiketten = [etikett for etikett in (getattr(rahmen, "_backdrop_labels", None) or [])
                     if etikett.winfo_exists()]
        if getattr(rahmen, "_backdrop_sig", None) == signatur and len(etiketten) >= len(rechtecke):
            for etikett in etiketten[:len(rechtecke)]:
                etikett.lower()
            return
        stuecke = self._backdrop_pieces(rahmen, rechtecke, verlauf)
        if not getattr(rahmen, "_backdrop_bound", False) and rahmen is not self.root:
            # Das Hauptfenster hat seine eigene, gefilterte Bindung.
            rahmen.bind("<Configure>", self.schedule_backdrop_sync_soon, add="+")
            rahmen._backdrop_bound = True
        for index, (foto, sx, sy) in enumerate(stuecke):
            if index >= len(etiketten):
                etikett = tk.Label(rahmen, bd=0, highlightthickness=0, padx=0, pady=0)
                etikett._is_backdrop = True
                # Mausereignisse auf dem Hintergrund gehen weiter an den Rahmen –
                # nur diese. Mit dem Bindtag des Rahmens bekam der Rahmen früher
                # auch die <Configure>-Meldungen des Bildes und rechnete sein
                # Layout mit dessen Maßen neu; auf der schmalen Startseite
                # schaukelte sich das bis zu einem Tk-Absturz auf (26.09.2026).
                etikett.bindtags((self.install_backdrop_forwarding(),))
                etiketten.append(etikett)
            etikett = etiketten[index]
            if str(etikett.cget("image")) != str(foto):
                etikett.configure(image=foto)
            etikett.place(x=sx - x, y=sy - y)
            etikett.lower()
        for etikett in etiketten[len(stuecke):]:
            etikett.place_forget()
        rahmen._backdrop_labels = etiketten
        rahmen._backdrop_sig = signatur

    @staticmethod
    def _rect_minus(rechteck, loch):
        """Rechteck ohne ein zweites – als höchstens vier Rechtecke (x0, y0, x1, y1)."""
        ax0, ay0, ax1, ay1 = rechteck
        bx0, by0, bx1, by1 = loch
        if bx1 <= ax0 or bx0 >= ax1 or by1 <= ay0 or by0 >= ay1:
            return [rechteck]
        teile = []
        if by0 > ay0:
            teile.append((ax0, ay0, ax1, by0))
        if by1 < ay1:
            teile.append((ax0, by1, ax1, ay1))
        mitte0, mitte1 = max(ay0, by0), min(ay1, by1)
        if bx0 > ax0:
            teile.append((ax0, mitte0, bx0, mitte1))
        if bx1 < ax1:
            teile.append((bx1, mitte0, ax1, mitte1))
        return teile

    BACKDROP_MIN_PIECE = 1

    def _exposed_rects(self, widget, x, y):
        """Die sichtbaren Teile einer Fläche in Fensterkoordinaten.

        Sichtbar ist, was im Ausschnitt aller Eltern liegt (die Startseite reicht
        beim Scrollen weit über das Fenster hinaus) und von keinem Kind verdeckt
        wird. Karten sind bis auf ihre gerundeten Ecken selbst deckend. Bis
        26.09.2026 zeichnete jede Fläche ihren ganzen Ausschnitt – auf der
        Startseite rund siebenmal die Fensterfläche übereinander.
        """
        try:
            breite, hoehe = widget.winfo_width(), widget.winfo_height()
            x0, y0, x1, y1 = x, y, x + breite, y + hoehe
            rx, ry = self.root.winfo_rootx(), self.root.winfo_rooty()
            eltern = widget.master
            while eltern is not None and widget is not self.root:
                ex, ey = eltern.winfo_rootx() - rx, eltern.winfo_rooty() - ry
                x0, y0 = max(x0, ex), max(y0, ey)
                x1, y1 = min(x1, ex + eltern.winfo_width()), min(y1, ey + eltern.winfo_height())
                eltern = eltern.master
            if x1 <= x0 or y1 <= y0:
                return []
            rechtecke = [(x0, y0, x1, y1)]
            loecher = []
            if isinstance(widget, RoundedContainer) and widget.find_withtag("surface"):
                # Die Form beginnt einen Pixel innerhalb der Fläche (Rand der
                # Kontur); dieser Streifen bleibt sichtbar.
                r, rand = widget.radius + 1, 2
                loecher.append((x + r, y + rand, x + breite - r, y + hoehe - rand))
                loecher.append((x + rand, y + r, x + breite - rand, y + hoehe - r))
            for kind in widget.winfo_children():
                if getattr(kind, "_is_backdrop", False) or isinstance(kind, (tk.Toplevel, tk.Menu)):
                    continue
                if not kind.winfo_ismapped():
                    continue
                kx, ky = kind.winfo_rootx() - rx, kind.winfo_rooty() - ry
                loecher.append((kx, ky, kx + kind.winfo_width(), ky + kind.winfo_height()))
        except tk.TclError:
            return []
        for loch in loecher:
            neu = []
            for rechteck in rechtecke:
                neu.extend(self._rect_minus(rechteck, loch))
            rechtecke = neu
            if not rechtecke:
                break
        grenze = self.BACKDROP_MIN_PIECE
        return [teil for teil in rechtecke if teil[2] - teil[0] >= grenze and teil[3] - teil[1] >= grenze]

    def _backdrop_pieces(self, widget, rechtecke, verlauf):
        """Ausschnitte des Verlaufs für Rechtecke in Fensterkoordinaten – [(Bild, x, y)].

        Die Bilder gehören dem Widget und werden nur neu kopiert, wenn sich ein
        Rechteck geändert hat; Tk aktualisiert die Anzeige dann von selbst.
        """
        klein, faktor = verlauf["image"], max(1, int(verlauf["factor"]))
        fotos = getattr(widget, "_backdrop_photos", None)
        if fotos is None:
            fotos = widget._backdrop_photos = []
        stuecke = []
        for rechteck in rechtecke:
            # In Bildpunkten der Rechenauflösung, auf ganze Punkte erweitert: Das
            # Stück beginnt deshalb bis zu `faktor - 1` Pixel vor dem Rechteck.
            # Es liegt unter den Kindern und zeigt dort denselben Verlauf.
            sx0, sy0 = max(0, rechteck[0] // faktor), max(0, rechteck[1] // faktor)
            sx1 = min(klein.width(), -(-rechteck[2] // faktor))
            sy1 = min(klein.height(), -(-rechteck[3] // faktor))
            if sx1 <= sx0 or sy1 <= sy0:
                continue
            index = len(stuecke)
            signatur = (verlauf["key"], sx0, sy0, sx1, sy1)
            if index >= len(fotos):
                fotos.append([tk.PhotoImage(master=self.root), None])
            foto, alt = fotos[index]
            if alt != signatur:
                foto.blank()
                self.root.tk.call(str(foto), "copy", str(klein), "-from", sx0, sy0, sx1, sy1,
                                  "-zoom", faktor, faktor, "-shrink")
                fotos[index][1] = signatur
            stuecke.append((foto, sx0 * faktor, sy0 * faktor))
        # Überzählige Bilder freigeben – der Speicher folgt der sichtbaren Fläche.
        del fotos[len(stuecke):]
        return stuecke

    # -----------------------------
    # Milchglas je Kachel (26.09.2026)
    # -----------------------------
    # Tk kann Flächen nicht durchscheinen lassen. Stark weichgezeichnetes
    # Milchglas zeigt vom Untergrund aber ohnehin nur dessen Farbe – und genau
    # die übernimmt jede Kachel: den Mittelwert des Verlaufs hinter ihr, mit
    # der Kartenfarbe gemischt. Beschriftungen, Knöpfe, Scrollleisten und
    # Listen der Kachel nehmen dieselbe Farbe an; dadurch gibt es keine Kästen.
    # Fenster (Dialoge) haben einen ruhigen, zum Verlauf passenden Grund aus
    # dem Design (`glass_backdrop_tint`). Die Kontrastdesigns bleiben deckend.
    FROST_STRENGTH = 0.22
    FROST_STRENGTH_GLASS = 0.38
    FROST_TEXT_ROLES = ("text", "muted", "ui_accent", "accent")

    def active_backdrop(self):
        """Der angelegte Verlauf des aktiven Designs – oder None."""
        verlauf = getattr(self, "_backdrop", None)
        if not verlauf or verlauf.get("key") != getattr(self, "_backdrop_key", None):
            return None
        if verlauf.get("design") != self.design_name():
            return None
        return verlauf

    def frost_strength(self):
        if self.active_backdrop() is None or self.design_info()["layer"] == "contrast":
            return 0.0
        return self.FROST_STRENGTH_GLASS if self.glass_enabled() else self.FROST_STRENGTH

    def backdrop_area_average(self, x, y, breite, hoehe, verlauf):
        """Mittlere Verlaufsfarbe einer Fläche in Fensterkoordinaten (höchstens 12 × 12 Proben)."""
        faktor, rgb, bw, bh = verlauf["factor"], verlauf["rgb"], verlauf["w"], verlauf["h"]
        x0, y0 = max(0, int(x) // faktor), max(0, int(y) // faktor)
        x1, y1 = min(bw, int(x + breite) // faktor + 1), min(bh, int(y + hoehe) // faktor + 1)
        if x1 <= x0 or y1 <= y0:
            return verlauf["avg"]
        sx, sy = max(1, (x1 - x0) // 12), max(1, (y1 - y0) // 12)
        summe, anzahl = [0, 0, 0], 0
        for py in range(y0, y1, sy):
            for px in range(x0, x1, sx):
                index = (py * bw + px) * 3
                for kanal in range(3):
                    summe[kanal] += rgb[index + kanal]
                anzahl += 1
        return glide_backdrop.rgb_hex(tuple(round(wert / anzahl) for wert in summe))

    def frosted_color(self, grund, mittel, staerke):
        """Grundfarbe mit einem Anteil Verlauf – so viel, wie die Schrift erlaubt (4,5:1)."""
        schriften = [self.theme[name] for name in self.FROST_TEXT_ROLES if self.theme.get(name)]
        anteil = staerke
        for _versuch in range(8):
            gemischt = glide_backdrop.hex_rgb(mix_hex_colors(grund, mittel, anteil))
            # Auf Dreierstufen gerundet: Beim Scrollen wechselt die Farbe nur,
            # wenn man es auch sehen könnte.
            kandidat = glide_backdrop.rgb_hex(tuple(min(255, round(kanal / 3) * 3) for kanal in gemischt))
            if all(contrast_ratio(schrift, kandidat) >= 4.5 for schrift in schriften):
                return kandidat
            anteil *= 0.7
        return grund

    def _recolor_tree(self, wurzel, zuordnung, karten_mit=False):
        """Tauscht Hintergrundfarben im Teilbaum nach `zuordnung` (Kleinbuchstaben-Hex)."""
        stapel = list(wurzel.winfo_children())
        while stapel:
            kind = stapel.pop()
            if getattr(kind, "_is_backdrop", False) or isinstance(kind, (tk.Toplevel, tk.Menu)):
                continue
            try:
                if isinstance(kind, RoundedContainer):
                    neu_bg = zuordnung.get(str(kind.bg_color).lower())
                    neu_fill = zuordnung.get(str(kind.fill_color).lower()) if karten_mit else None
                    if neu_bg or neu_fill:
                        kind.set_theme(neu_bg or kind.bg_color, neu_fill or kind.fill_color, kind.outline_color)
                    if karten_mit:
                        stapel.extend(kind.inner.winfo_children())
                    continue
                if isinstance(kind, RoundedButton):
                    neu = zuordnung.get(str(kind.bg_color).lower())
                    if neu:
                        kind.set_theme(neu, kind.text_color)
                    continue
                if isinstance(kind, ThemedAutoScrollbar):
                    neu = zuordnung.get(str(kind.bg_color).lower())
                    if neu:
                        kind.set_theme(neu, zuordnung.get(str(kind.track_color).lower(), kind.track_color),
                                       kind.thumb_color, kind.active_thumb_color)
                    continue
                if isinstance(kind, ttk.Treeview):
                    # Über der Liste liegen eigene Knöpfe (Zeilenaktionen); sie
                    # gehören zur selben Fläche.
                    self._frost_tree(kind, zuordnung)
                    stapel.extend(kind.winfo_children())
                    continue
                if isinstance(kind, ttk.Widget):
                    continue
                for option in ("bg", "highlightbackground"):
                    try:
                        neu = zuordnung.get(str(kind.cget(option)).lower())
                    except tk.TclError:
                        continue
                    if neu:
                        kind.configure(**{option: neu})
            except (tk.TclError, AttributeError):
                continue
            stapel.extend(kind.winfo_children())

    def _frost_tree(self, baum, zuordnung):
        """Listen tönen sich über einen abgeleiteten Stil – der Grundstil bleibt unberührt."""
        basis = getattr(baum, "_frost_base_style", None) or str(baum.cget("style")) or "Treeview"
        baum._frost_base_style = basis
        try:
            aktuell = str(self.style.lookup(str(baum.cget("style")) or basis, "background") or "").lower()
        except tk.TclError:
            return
        neu = zuordnung.get(aktuell)
        if not neu:
            return
        if neu.lower() == str(self.style.lookup(basis, "background") or "").lower():
            baum.configure(style=basis)
            if callable(getattr(baum, "draw_icons", None)):
                baum.draw_icons()
            return
        name = f"Frost{neu.lstrip('#').upper()}.{basis}"
        self.style.configure(name, background=neu, fieldbackground=neu)
        baum.configure(style=name)
        if callable(getattr(baum, "draw_icons", None)):
            baum.draw_icons()

    def sync_frosted_cards(self, karten, verlauf):
        """Tönt jede Kachel des Hauptfensters nach dem Verlauf hinter ihr."""
        staerke = self.frost_strength() if verlauf else 0.0
        karte = str(self.theme.get("card", "")).lower()
        bisher = getattr(self, "_frosted_cards", set())
        jetzt = set()
        if staerke:
            try:
                rx, ry = self.root.winfo_rootx(), self.root.winfo_rooty()
            except tk.TclError:
                return
            # Außen vor innen: Eine innere Kachel übernimmt die Ecken der äußeren.
            for kachel in sorted(karten, key=lambda widget: str(widget).count(".")):
                try:
                    if not kachel.winfo_ismapped() or getattr(kachel, "fill_key", "card") != "card":
                        continue
                    alt = str(getattr(kachel, "_frost", "") or "").lower()
                    if str(kachel.fill_color).lower() not in (karte, alt):
                        continue
                    x, y = kachel.winfo_rootx() - rx, kachel.winfo_rooty() - ry
                    mittel = self.backdrop_area_average(x, y, kachel.winfo_width(), kachel.winfo_height(), verlauf)
                    farbe = self.frosted_color(self.theme["card"], mittel, staerke)
                except tk.TclError:
                    continue
                zuordnung = {karte: farbe}
                if alt:
                    zuordnung[alt] = farbe
                geaendert = str(kachel.fill_color).lower() != farbe.lower()
                if geaendert:
                    kachel.set_theme(kachel.bg_color, farbe, kachel.outline_color)
                kachel._frost = farbe
                # Nachgefärbt wird bei jedem Abgleich: Manche Bereiche setzen
                # beim Aktualisieren ihre Kartenfarbe neu (die Seitenleiste), ohne
                # dass ein Widget neu erscheint. Der Durchgang kostet wenige ms.
                self._recolor_tree(kachel.inner, zuordnung)
                jetzt.add(kachel)
        for kachel in bisher - jetzt:
            try:
                if not kachel.winfo_exists():
                    continue
                alt = str(getattr(kachel, "_frost", "") or "").lower()
                kachel._frost = None
                if alt:
                    kachel.set_theme(kachel.bg_color, self.theme["card"], kachel.outline_color)
                    self._recolor_tree(kachel.inner, {alt: self.theme["card"]})
            except tk.TclError:
                continue
        self._frosted_cards = jetzt

    def _on_widget_map(self, event):
        """Neu gezeigte Widgets bekommen Verlauf und Tönung – gebündelt im nächsten Leerlauf."""
        if not getattr(self, "_backdrop", None) and not getattr(self, "_frosted_cards", None):
            return
        widget = event.widget
        if not hasattr(widget, "winfo_toplevel") or getattr(widget, "_is_backdrop", False):
            return
        try:
            fenster = widget.winfo_toplevel()
        except (tk.TclError, KeyError):
            return
        # Dialoge färbt nichts nach: Sie entstehen gleich in den Farben des
        # Designs, die bei aktivem Verlauf schon zu ihm passen
        # (`glass_backdrop_tint`). Das nachträgliche Umfärben ließ Tk im
        # Punktdialog endlos neu anordnen (26.09.2026).
        if fenster is self.root:
            kachel = widget
            while kachel is not None and not isinstance(kachel, RoundedContainer):
                kachel = getattr(kachel, "master", None)
            if kachel is not None:
                kachel._frost_dirty = True
            # Beim Scrollen tauchen Kacheln laufend auf; der Abgleich wartet
            # dann, bis die Bewegung ruht (R6, 29.09.2026).
            if getattr(self, "_scrolling_until", 0) > time.monotonic():
                self.schedule_backdrop_sync_soon()
            else:
                self.schedule_backdrop_sync()

    BACKDROP_BINDTAG = "GlideBackdrop"

    def install_backdrop_forwarding(self):
        """Bindtag der Hintergrundbilder: reicht Mausereignisse an den Rahmen darunter weiter."""
        if getattr(self, "_backdrop_forwarding", False):
            return self.BACKDROP_BINDTAG

        def weiter(event, art):
            etikett = event.widget
            try:
                rahmen = etikett.master
                werte = {"x": event.x + etikett.winfo_x(), "y": event.y + etikett.winfo_y(),
                         "rootx": event.x_root, "rooty": event.y_root}
                if isinstance(event.state, int):
                    werte["state"] = event.state
                if art in ("ButtonPress", "ButtonRelease"):
                    rahmen.event_generate(f"<{art}-{event.num}>", **werte)
                elif art == "MouseWheel":
                    rahmen.event_generate("<MouseWheel>", delta=event.delta, **werte)
                else:
                    rahmen.event_generate(f"<{art}>", **werte)
            except (tk.TclError, AttributeError):
                pass
            return "break"

        for art in ("ButtonPress", "ButtonRelease", "Motion", "MouseWheel", "Enter", "Leave"):
            self.root.bind_class(self.BACKDROP_BINDTAG, f"<{art}>", lambda event, art=art: weiter(event, art))
        self._backdrop_forwarding = True
        return self.BACKDROP_BINDTAG

    def backdrop_pill_color(self, beschriftung):
        """Milchglas: Grundfarbe mit einem Hauch Verlauf – aber immer mit 4,5:1 zur Schrift."""
        grund = self.theme["bg"]
        try:
            schrift = beschriftung.cget("fg")
            kandidat = mix_hex_colors(grund, self._backdrop["avg"], 0.22)
            return kandidat if contrast_ratio(schrift, kandidat) >= 4.5 else grund
        except (tk.TclError, KeyError, TypeError, ValueError):
            return grund

    def backdrop_extremes(self, widget, x, y, verlauf):
        """Hellster und dunkelster Punkt des Verlaufs unter einem Widget (samt Körnung)."""
        try:
            breite, hoehe = widget.winfo_width(), widget.winfo_height()
        except tk.TclError:
            return []
        faktor, rgb, bw, bh = verlauf["factor"], verlauf["rgb"], verlauf["w"], verlauf["h"]
        spiel = int(verlauf.get("grain", 0.0))
        dunkel = hell = None
        for py in range(max(0, y // faktor), min(bh, (y + hoehe) // faktor + 1), 2):
            for px in range(max(0, x // faktor), min(bw, (x + breite) // faktor + 1), 3):
                index = (py * bw + px) * 3
                punkt = tuple(rgb[index:index + 3])
                wert = glide_backdrop.luminance(punkt)
                if dunkel is None or wert < dunkel[0]:
                    dunkel = (wert, punkt)
                if hell is None or wert > hell[0]:
                    hell = (wert, punkt)
        if dunkel is None:
            return []
        return [glide_backdrop.rgb_hex(tuple(max(0, kanal - spiel) for kanal in dunkel[1])),
                glide_backdrop.rgb_hex(tuple(min(255, kanal + spiel) for kanal in hell[1]))]

    def backdrop_needs_halo(self, beschriftung, x, y, verlauf):
        """Reicht der Kontrast der Designschrift auf dem Verlauf unter ihr nicht?"""
        try:
            schrift = beschriftung.cget("fg")
        except tk.TclError:
            return False
        return any(contrast_ratio(schrift, punkt) < 4.5
                   for punkt in self.backdrop_extremes(beschriftung, x, y, verlauf))

    def fit_label_to_backdrop(self, beschriftung, x, y, verlauf):
        """Schrift auf dem Verlauf lesbar halten – ohne Kasten, wo es geht.

        Seit dem 26.09.2026 weicht zuerst die Schrift im eigenen Farbton aus
        (etwas heller oder dunkler, wie `legible_on` es für die Grundflächen
        tut). Die Milchglas-Pille bleibt der letzte Ausweg für Stellen, an
        denen der Verlauf zugleich sehr hell und sehr dunkel ist. Vorher stand
        jeder Hinweis über der Knopfleiste als dunkler Kasten auf dem Verlauf.
        """
        try:
            schrift = beschriftung.cget("fg")
        except tk.TclError:
            return
        punkte = self.backdrop_extremes(beschriftung, x, y, verlauf)
        if not punkte or min(contrast_ratio(schrift, punkt) for punkt in punkte) >= 4.5:
            beschriftung.set_contrast_fg(None)
            beschriftung.set_halo(None)
            return
        kandidat = legible_on(schrift, punkte)
        if min(contrast_ratio(kandidat, punkt) for punkt in punkte) >= 4.5:
            beschriftung.set_contrast_fg(kandidat)
            beschriftung.set_halo(None)
        else:
            beschriftung.set_contrast_fg(None)
            beschriftung.set_halo(self.backdrop_pill_color(beschriftung))

    def rebuild_backdrop_menu(self):
        """Ansicht › Hintergrund: „Aus“ und die fünf Verläufe des aktiven Designs."""
        menu = getattr(self, "backdrop_menu", None)
        if menu is None:
            return
        try:
            menu.delete(0, "end")
        except tk.TclError:
            return
        design = self.design_name()
        gewaehlt = self.backdrop_choice(design)
        menu._glide_action_ids = {}
        # Befehle statt Optionsfelder: Nur Befehle erscheinen in der Aktionssuche.
        # Der gewählte Eintrag trägt ein Häkchen in der Kürzelspalte.
        menu.add_command(label="Hintergrund: aus", accelerator="✓" if gewaehlt == glide_backdrop.NONE_KEY else "",
                         command=lambda: self.set_backdrop_choice(glide_backdrop.NONE_KEY))
        menu._glide_action_ids[menu.index("end")] = "backdrop." + glide_backdrop.NONE_KEY
        for preset in glide_backdrop.presets_for(design):
            menu.add_command(label=f"Hintergrund: {preset.name}", accelerator="✓" if gewaehlt == preset.key else "",
                             command=lambda key=preset.key: self.set_backdrop_choice(key))
            menu._glide_action_ids[menu.index("end")] = "backdrop." + preset.key

    # Rollen, die als Schrift auf den Grundflächen stehen. Sie müssen dort
    # WCAG AA erreichen (4,5:1); `legible_text_roles` zieht sie im eigenen
    # Farbton nach, wo ein Design das nicht schafft.
    ADD_COLORS = {"light": "#7B3FC4", "dark": "#B794F6"}
    TEXT_ROLE_KEYS = ("text", "muted", "placeholder", "accent", "ui_accent", "add", "delete", "export", "import",
                      "clear", "flag", "priority_low", "priority_medium", "priority_high", "overdue",
                      "due_today", "due_action", "confirm")

    def legible_text_roles(self, theme):
        """Jede Schriftrolle erreicht auf Hintergrund, Karte und Eingabefeld mindestens 4,5:1.

        Gemessen an den dargestellten Elementen lagen im hellen Design Grün,
        Orange und Türkis bei 2,0 bis 2,6:1, im Glasdesign Blau und Lila knapp
        unter der Grenze und die Platzhalter aller Designs bei 2,4 bis 4,4:1.
        Die Farben bleiben erkennbar dieselben, nur tiefer beziehungsweise
        heller; Designs, die schon bestehen, bleiben unverändert.
        """
        flaechen = [theme.get(name) for name in ("bg", "card", "input")]
        for name in self.TEXT_ROLE_KEYS:
            if name in theme:
                theme[name] = legible_on(theme[name], flaechen)
        return theme

    def active_theme(self):
        """Liefert die aktuell gewählte Oberfläche – mit lesbaren Schriftrollen."""
        return self.legible_text_roles(self.glass_backdrop_tint(self._compose_theme()))

    # Mit Verlauf passt das ganze Design zu ihm: Grund und Karten nehmen seine
    # mittlere Farbe auf. Im Hauptfenster liegt über dem Grund ohnehin der
    # Verlauf; sichtbar wird der Grund in den Dialogen – als ruhiger, statischer
    # Hintergrund statt eines Verlaufs. Im Glasdesign spiegelt der obere
    # Lichtverlauf der Karten die Farbe zusätzlich.
    GLASS_BACKDROP_TINT = 0.16
    GLASS_BACKDROP_SHEEN = 0.45
    BACKDROP_BG_TINT = 0.22
    BACKDROP_CARD_TINT = 0.10

    def glass_backdrop_tint(self, theme):
        verlauf = getattr(self, "_backdrop", None)
        if (not verlauf or verlauf.get("design") != self.design_name()
                or self.design_info()["layer"] == "contrast"):
            return theme
        mittel = verlauf["avg"]
        theme["bg"] = mix_hex_colors(theme["bg"], mittel, self.BACKDROP_BG_TINT)
        if not self.glass_enabled():
            theme["card"] = mix_hex_colors(theme["card"], mittel, self.BACKDROP_CARD_TINT)
            return theme
        theme["card"] = mix_hex_colors(theme["card"], mittel, self.GLASS_BACKDROP_TINT)
        theme["glass_gradient"] = mix_hex_colors(theme["card"], mittel, self.GLASS_BACKDROP_SHEEN)
        theme["glass_highlight"] = mix_hex_colors(theme.get("glass_highlight", theme["line"]), "#FFFFFF", 0.18)
        return theme

    def _compose_theme(self):
        """Liefert die aktuell gewählte Oberfläche einschließlich Glasmaterial.

        Tk zeichnet keine echten, pro Widget weichgezeichneten Flächen. Der
        Glasmodus nutzt deshalb eine ruhige, lichtdurchlässige Anmutung aus
        gemischten Oberflächenfarben und einer hellen Innenkante. Unter
        Windows ergänzt Glide diese Ebene, wenn möglich, um den nativen DWM-
        SystemBackdrop. Fällt die Plattform zurück, bleibt die Oberfläche als
        lesbare Farbvariante vollständig funktionsfähig.
        """
        info = self.design_info()
        self.theme_name = info["base"]
        base = dict(self.THEMES.get(info["base"], self.THEMES["light"]))
        if info["layer"] == "contrast":
            base.update(self.CONTRAST_THEMES[info["base"]])
        elif info["layer"] == "dopamine":
            base.update(self.DOPAMINE_THEME)
        elif info["layer"] == "pixel":
            base.update(self.PIXEL_THEME)
        elif info["layer"] == "minimal":
            base.update(self.MINIMAL_THEMES[info["base"]])
        accent_key = self.settings.get("accent_color", "accent")
        base["ui_accent"] = base.get(accent_key, base["accent"])
        # „Hinzufügen“ ist in jedem Design dasselbe Lila – unabhängig von der
        # gewählten Akzentfarbe (Entscheidung Q1 vom 29.09.2026). Lesbar macht
        # es `legible_text_roles` wie jede Schriftrolle.
        # Ausnahme: Die Minimaldesigns bleiben farblos; dort kommt „add“ aus
        # MINIMAL_THEMES (grau wie Bestätigen und Löschen).
        if info["layer"] != "minimal":
            base["add"] = self.ADD_COLORS["dark" if info["base"] == "dark" else "light"]
        if info["layer"] == "minimal":
            base["ui_accent"] = base["text"] if accent_key == "muted" else self.THEMES[info["base"]].get(accent_key, base["accent"])
        # Die Auswahl trägt weiße Schrift – so kennt man
        # sie aus beiden Betriebssystemen, und so war sie in Glide immer.
        # Gemessen erreichte Weiß auf dem Lila der Standardpalette aber nur
        # 3,5:1 und lag damit unter dem, was normaler Text braucht. Statt die
        # Schrift zu wechseln, wird die Fläche so weit nachgezogen, bis Weiß
        # trägt: Das Lila bleibt Lila, wird nur eine Spur tiefer.
        #
        # Nur wo Weiß von vornherein aussichtslos ist – auf dem hellen Blau
        # des Kontrastdesigns etwa –, entscheidet der gemessene Kontrast, und
        # die Schrift wird dunkel. Die Schwelle 3,0 trennt „eine Spur tiefer“
        # von „bis zur Unkenntlichkeit abgedunkelt“.
        akzent = base["ui_accent"]
        # Welche dunkle Schrift auf der Auswahlfläche steht,
        # darf ein Design selbst bestimmen. Die Voreinstellung ist das
        # blaugraue #15171C der Standardschrift – in einem Design ohne Farbton
        # wäre das der einzige farbige Ton im ganzen Fenster.
        dunkle_schrift = info.get("text_on_accent") or "#15171C"
        if contrast_ratio("#FFFFFF", akzent) >= 3.0:
            base["selection_text"] = "#FFFFFF"
        else:
            base["selection_text"] = readable_text_color(akzent, dark=dunkle_schrift)
        base["selection"] = ensure_contrast(akzent, base["selection_text"])
        # Die Glasoptik gehört zum Design, nicht zu einem eigenen Häkchen:
        # Sie mischt Flächen ineinander und nähme damit genau den Kontrast
        # weg, für den der Kontrastmodus da ist, und verwüsche die gesättigten
        # Töne des Dopamin-Designs. Beide Designs führen sie deshalb gar nicht.
        if not info["glass"]:
            base["glass_highlight"] = base["line"]
            base["glass_shadow"] = base["bg"]
            base["glass_gradient"] = ""
            return self.with_active_role(base)
        # Hell und Dunkel mischten dieselben
        # sechs Flächen mit denselben Rechenschritten und unterschieden sich
        # nur in den Zahlen. Als zwei ausgeschriebene Zweige hieß das: Wer eine
        # Fläche ergänzt, ergänzt sie zweimal – oder das Glasdesign sieht in
        # einer der beiden Richtungen anders aus, als es sollte. Jetzt steht
        # die Rechnung einmal da und die Zahlen in einer Tabelle.
        schicht = self.GLASS_LAYERS["dark" if info["base"] == "dark" else "light"]
        base.update({name: mix_hex_colors(base[name], farbe, anteil)
                     for name, farbe, anteil in schicht["mix"]})
        base["glass_highlight"] = schicht["highlight"]
        base["glass_shadow"] = schicht["shadow"]
        # Tk kann keine Fläche weichzeichnen. Tiefe entsteht
        # deshalb aus dem, was Tk kann: ein senkrechter Verlauf über der Karte,
        # oben heller als unten. Das ist derselbe Reiz, den eine gewölbte
        # Glasfläche im Licht erzeugt, und er kostet weder eine Abhängigkeit
        # noch Rechenzeit beim Scrollen.
        base["glass_gradient"] = mix_hex_colors(base["card"], *schicht["gradient"])
        return self.with_active_role(base)

    # Anteil der Schrift in der Fläche eines eingeschalteten Zustands (U15).
    ACTIVE_SHARE = 0.18

    @classmethod
    def with_active_role(cls, base):
        """Neutrale Rolle für aktive Zustände (U15 seit 3.33.21).

        Ein eingeschalteter Umschalter, ein gewähltes Werkzeug oder eine
        gewählte Option ist weder „Hinzufügen“ noch eine Auswahl von Inhalten.
        Bis 3.33.20 trugen sie die Auswahlfarbe – in der Vorgabe dasselbe Lila
        wie Hinzufügen. Jetzt eine Fläche aus Karte und Schrift: keine neue
        Farbe, in jedem Design lesbar, und Lila bleibt beim Anlegen.
        """
        base["active_text"] = base["text"]
        base["active"] = ensure_contrast(mix_hex_colors(base["card"], base["text"], cls.ACTIVE_SHARE),
                                         base["active_text"])
        return base

    def design_name(self):
        """Der gewählte Designschlüssel, immer einer aus DESIGNS.

        . Einzige Quelle der Erscheinung. `theme_name`,
        `color_mode()` und die Glasoptik leiten sich daraus ab und werden
        nirgends mehr unabhängig gesetzt.
        """
        value = getattr(self, "settings", {}).get("design", self.DESIGN_DEFAULT)
        return value if value in self.DESIGNS else self.DESIGN_DEFAULT

    def design_info(self, key=None):
        """Die Beschreibung eines Designs; ohne Argument die des aktiven."""
        return self.DESIGNS.get(key or self.design_name(), self.DESIGNS[self.DESIGN_DEFAULT])

    def set_design(self, key, apply_now=True):
        """Wechselt das Design und hält die abgeleiteten Werte nach.

        Die drei Spiegelwerte `theme`, `color_mode` und `glass_mode` bleiben in
        den Einstellungen stehen: Eine ältere Glide-Fassung, die dieselbe Datei
        liest, findet dort weiterhin das, was sie erwartet, statt auf ihre
        Vorgaben zurückzufallen. Geschrieben werden sie nur hier.
        """
        if key not in self.DESIGNS:
            key = self.DESIGN_DEFAULT
        info = self.DESIGNS[key]
        # Ein Design kann gesetzt werden, bevor die Einstellungen geladen sind
        # – etwa beim Aufbau eines Vorlagenentwurfs oder in einem Prüflauf.
        if not isinstance(getattr(self, "settings", None), dict):
            self.settings = {}
        self.settings["design"] = key
        self.settings["theme"] = info["base"]
        self.settings["color_mode"] = info["layer"] or "standard"
        self.settings["glass_mode"] = bool(info["glass"])
        self.theme_name = info["base"]
        if apply_now:
            self.save_settings()
            self.apply_theme()
        return key

    APPEARANCE_CHECK_MS = 60000

    def system_is_dark(self):
        """Dunkler Systemmodus? True/False, oder None, wenn er sich nicht bestimmen lässt (N01)."""
        try:
            if IS_MACOS:
                try:
                    return glide_appearance.tk_is_dark(self.root.tk.call("winfo", "isdark", self.root._w))
                except tk.TclError:
                    return glide_appearance.tk_is_dark(
                        self.root.tk.call("tk::unsupported::MacWindowStyle", "isdark", self.root._w))
            if IS_WINDOWS:
                import winreg

                def lesen():
                    with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                                        r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize") as key:
                        return winreg.QueryValueEx(key, "AppsUseLightTheme")[0]
                return glide_appearance.windows_is_dark(lesen)

            def gsettings(schluessel):
                try:
                    ergebnis = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", schluessel],
                                              capture_output=True, text=True, timeout=1)
                except (OSError, subprocess.SubprocessError):
                    return None
                return ergebnis.stdout if ergebnis.returncode == 0 else None
            schema = gsettings("color-scheme")
            return glide_appearance.linux_is_dark(schema, None if schema and "dark" in schema else gsettings("gtk-theme"))
        except (tk.TclError, OSError, ImportError, AttributeError):
            return None

    def schedule_appearance_check(self, delay=None):
        self._appearance_tick_id = self._register_after(
            self.root.after(delay or self.APPEARANCE_CHECK_MS, self._appearance_tick))

    def _appearance_tick(self):
        self._after_ids.discard(getattr(self, "_appearance_tick_id", None))
        try:
            self.sync_system_appearance()
        finally:
            self.schedule_appearance_check()

    def sync_system_appearance(self):
        """Wendet das Design des Paars an, wenn sich der Systemmodus geändert hat (N01)."""
        paar = glide_appearance.normalize_auto(self.settings.get("design_auto"), self.DESIGNS)
        if paar is None or self.root.grab_current():
            return False
        ziel = glide_appearance.resolve(paar, self.system_is_dark(), self.design_name())
        if ziel == self.design_name():
            return False
        self.set_design(ziel)
        return True

    def color_mode(self):
        """Die Farbschicht des aktiven Designs: standard, contrast oder dopamine.

        Bleibt als Name erhalten, weil Kartenzeichnung, Label-Chips und die
        Feierrückmeldung danach fragen. Gelesen wird seit 3.23 das Design.
        """
        return self.design_info()["layer"] or "standard"

    def glass_enabled(self):
        """Ob das aktive Design die Materialoptik verwendet."""
        return bool(self.design_info()["glass"])

    def animations_enabled(self):
        """Ob bewegte Rückmeldungen gezeigt werden.

        Bis 3.23 hing das allein am Dopamin-Design – jedes
        andere Design blieb still, auch für jemanden, der die Rückmeldung
        mochte. Sie ist jetzt eine eigene Einstellung und in jedem Design
        verfügbar; das Dopamin-Design steigert sie, statt sie zu besitzen.
        """
        return bool(self.settings.get("animations_enabled", True))

    def arcade_mode(self):
        """Ob die Rückmeldung übertreiben darf – das ist der Dopamin-Modus."""
        return self.color_mode() == "dopamine"

    def is_pixel_design(self):
        """Das Pixel-Design (3.30): Blockfarben, blockige Balken, Pixelrahmen."""
        return self.color_mode() == "pixel"

    def thumbnail_frame_options(self):
        """Rahmen einer Miniatur – im Pixel-Design eine harte, dicke Kante."""
        if self.is_pixel_design():
            return {"bg": "#FFFFFF", "bd": 0, "relief": "flat", "highlightthickness": 3,
                    "highlightbackground": self.theme["text"], "highlightcolor": self.theme["text"]}
        return {"bg": "#FFFFFF", "bd": 1, "relief": "solid", "highlightthickness": 0}

    # Rückmeldung nicht nur beim Abhaken. Eine Fahne beim
    # Erledigen und Schweigen bei allem anderen sagt: Nur das eine zählt.
    # Gemeint war das Gegenteil – das Benutzen selbst soll sich gut anfühlen,
    # vom Anlegen einer Liste bis zum Verbinden zweier Karten.
    #
    # Wann eine Fahne kommt, entscheidet die Stufe, nicht der Aufrufer: „auto“
    # heißt im Dopamin-Design jede Aktion und sonst nur die Meilensteine. Wer
    # es anders will, stellt es um, statt das Design wechseln zu müssen.
    ACTION_FEEDBACK_CHOICES = (
        ("auto", "Automatisch · im Dopamin-Design zu jeder Aktion"),
        ("milestones", "Nur bei Erledigtem und erreichten Zielen"),
        ("all", "Bei jeder Aktion"),
    )
    ACTION_FEEDBACK_KEYS = tuple(schluessel for schluessel, _name in ACTION_FEEDBACK_CHOICES)
    ACTION_FEEDBACK_DEFAULT = "auto"
    # Ein Eintrag je Vorgang: Symbol, Einzahl, Mehrzahl mit Platzhalter. Die
    # Texte stehen an einer Stelle, damit dieselbe Aktion überall dieselbe
    # Rückmeldung gibt – und damit eine Prüfung sie vollständig durchgehen
    # kann.
    ACTION_FEEDBACK_TEXTS = {
        "edited": ("check", "Änderung gespeichert", "{n} Änderungen gespeichert"),
        "reopened": ("task_open", "Wieder geöffnet", "{n} wieder geöffnet"),
        "backup": ("attachment", "Backup erstellt", "Backup erstellt"),
        "item_created": ("check", "Punkt angelegt", "{n} Punkte angelegt"),
